{
  "name": "cnocept-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "typecheck": "pnpm --filter @cnocept/concept-runtime build && pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "pnpm --filter @cnocept/concept-runtime test",
    "start": "pnpm --filter @cnocept/studio-server start",
    "serve": "pnpm build && pnpm start",
    "demo": "pnpm --filter @cnocept/concept-runtime demo",
    "chat": "pnpm --filter @cnocept/concept-runtime chat",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,tsx,json,md}\" \"scripts/**/*.mjs\" \"*.{json,yaml,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,tsx,json,md}\" \"scripts/**/*.mjs\" \"*.{json,yaml,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
