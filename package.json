{
  "name": "napkin-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @napkin/concept-runtime test",
    "studio": "pnpm -r build && pnpm --filter @napkin/studio-server start",
    "napkin": "node packages/concept-runtime/dist/cli.js",
    "eval:ears": "pnpm --filter @napkin/concept-runtime eval:ears"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
