{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "N-Con",
  "scopeName": "source.ncon",
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#embedded-source"
        },
        {
          "include": "#raw-string"
        },
        {
          "include": "#string"
        },
        {
          "include": "#form"
        },
        {
          "include": "#head"
        },
        {
          "include": "#named-argument"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#number"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comment": {
      "name": "comment.line.double-slash.ncon",
      "begin": "//",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.ncon"
        }
      },
      "end": "$"
    },
    "embedded-source": {
      "comment": "A Code(...) body, and a Prelude: JavaScript held as raw text, highlighted as JavaScript.",
      "begin": "(?:\\b(source)\\s*(=)\\s*|(?<=Prelude\\()\\s*)(\"\"\")",
      "beginCaptures": {
        "1": {
          "name": "variable.parameter.named.ncon"
        },
        "2": {
          "name": "keyword.operator.assignment.ncon"
        },
        "3": {
          "name": "punctuation.definition.string.begin.ncon"
        }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.ncon"
        }
      },
      "contentName": "meta.embedded.block.javascript",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "raw-string": {
      "name": "string.quoted.triple.ncon",
      "begin": "\"\"\"",
      "end": "\"\"\""
    },
    "string": {
      "name": "string.quoted.double.ncon",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.ncon",
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})"
        },
        {
          "name": "variable.other.template.ncon",
          "match": "\\$[a-z][A-Za-z0-9]*"
        }
      ]
    },
    "form": {
      "comment": "The forms a pack is made of, at the start of a line.",
      "match": "^(Requires|Language|Concept|Realization|Compiled|Prelude|From|To|Relation)(?=\\s*\\()",
      "name": "keyword.control.form.ncon"
    },
    "head": {
      "match": "\\b(?:(Js)([A-Z][A-Za-z0-9_]*)|([A-Z][A-Za-z0-9_]*))(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.tag.syntax-prefix.ncon"
        },
        "2": {
          "name": "entity.name.tag.syntax.ncon"
        },
        "3": {
          "name": "entity.name.function.concept.ncon"
        }
      }
    },
    "named-argument": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)(?!=)",
      "captures": {
        "1": {
          "name": "variable.parameter.named.ncon"
        },
        "2": {
          "name": "keyword.operator.assignment.ncon"
        }
      }
    },
    "variable": {
      "patterns": [
        {
          "name": "variable.language.anonymous.ncon",
          "match": "\\$_\\b"
        },
        {
          "name": "variable.other.ncon",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "constant": {
      "name": "constant.language.ncon",
      "match": "\\b(true|false|null)\\b"
    },
    "number": {
      "name": "constant.numeric.ncon",
      "match": "-?\\b(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.ncon",
          "match": ","
        },
        {
          "name": "punctuation.section.parens.ncon",
          "match": "[()]"
        }
      ]
    }
  }
}
