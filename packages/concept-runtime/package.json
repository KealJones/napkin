{
  "name": "@napkin/concept-runtime",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#platform": {
      "types": "./dist/platform/node.d.ts",
      "browser": "./dist/platform/browser.js",
      "default": "./dist/platform/node.js"
    }
  },
  "scripts": {
    "build": "node scripts/version.mjs && tsc -p tsconfig.json && node scripts/prune-dist.mjs",
    "typecheck": "node scripts/version.mjs && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'dist/**/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./expression": {
      "types": "./dist/concept/compat.d.ts",
      "import": "./dist/concept/compat.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js"
    },
    "./platform/browser": {
      "types": "./dist/platform/browser.d.ts",
      "import": "./dist/platform/browser.js"
    }
  },
  "dependencies": {
    "an-array-of-english-words": "^2.0.0",
    "compromise": "^14.17.0",
    "node-symspell": "^0.1.0",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "^5.6.0",
    "web-tree-sitter": "0.22.6"
  }
}
