Concept(Thousand(), SynonymOf(Number(1000)))

// A share or a multiple said as a word is what it does to what it is said of: "a third of 9" is
// Divide(9, 3), as Half and Double are (everyday.ncon). Read by situations for the factor, and by
// the arithmetic like any definition.
Concept(Third(),
  Realization(Third($x),
    context = Execution(),
    body = Divide($x, 3)
  )
)

Concept(Quarter(),
  Realization(Quarter($x),
    context = Execution(),
    body = Divide($x, 4)
  )
)

Concept(Fourth(),
  Realization(Fourth($x),
    context = Execution(),
    body = Divide($x, 4)
  )
)

Concept(Fifth(),
  Realization(Fifth($x),
    context = Execution(),
    body = Divide($x, 5)
  )
)

Concept(Sixth(),
  Realization(Sixth($x),
    context = Execution(),
    body = Divide($x, 6)
  )
)

Concept(Seventh(),
  Realization(Seventh($x),
    context = Execution(),
    body = Divide($x, 7)
  )
)

Concept(Eighth(),
  Realization(Eighth($x),
    context = Execution(),
    body = Divide($x, 8)
  )
)

Concept(Ninth(),
  Realization(Ninth($x),
    context = Execution(),
    body = Divide($x, 9)
  )
)

Concept(Tenth(),
  Realization(Tenth($x),
    context = Execution(),
    body = Divide($x, 10)
  )
)

Concept(Triple(),
  Realization(Triple($x),
    context = Execution(),
    body = Multiply($x, 3)
  )
)

Concept(Thrice(),
  Realization(Thrice($x),
    context = Execution(),
    body = Multiply($x, 3)
  )
)

Concept(Halves(), SynonymOf(Half()))

// What a unit measures. (Not Measures(Time()), as Wikidata would say it: read as a kind, it makes
// "times" a time to the frames hearing; see tasks/todo.md.)
Concept(Measures(), IsA(Relation()))
