Concept(Regular(), Marks(Before()))

Concept(Usual(), Marks(Before()))

Concept(Normal(), Marks(Before()))

Concept(Full(), Marks(Before()))

Concept(Old(), Marks(Before()))

Concept(Initial(), Marks(Before()))

Concept(Starting(), Marks(Before()))

Concept(Left(), Marks(Remaining()))

Concept(Rest(), Marks(Remaining()))

Concept(Remaining(), Marks(Remaining()))

Concept(Remainder(), Marks(Remaining()))

Concept(Price(), Marks(Money()))

Concept(Cost(), Marks(Money()))

Concept(Rate(), Marks(Money()))

Concept(Pay(), Marks(Money()))

Concept(Salary(), Marks(Money()))

Concept(Wage(), Marks(Money()))

Concept(Amount(), Marks(Money()))

Concept(Fee(), Marks(Money()))

