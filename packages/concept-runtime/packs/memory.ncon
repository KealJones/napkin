Concept(Focus(),
  Realization(Focus($conversation), evaluateArguments=false,
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $isCall,
            Lambda(
              List($e),
              And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
          Let(
            $positional,
            Lambda(
              List($e),
