                                Or(
                                  GreaterThan(Length(Member($v, "args")), 0),
                                  NotEquals(Member($v, "head"), "Is")),
                                Equals(Member($v, "head"), $form)))))),
                      If(Not($clause), Return(), Undefined()),
                      Let($text, Call(Member($api, "format"), $clause)),
                      If(
