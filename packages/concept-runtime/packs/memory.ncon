// ================================================================
// From src/seed/memory-recall.ts
//
// Recall: answering from what was believed and from what was said (memory-spec Part 9).
//
// An object question ("what does greg like") is a hole where the object goes. It is looked
// up first among lasting beliefs, the relations on the subject. A happening was never
// believed (memory-spec Part 5.3), so "what did i eat" is answered from the `Said` that
// holds it, found through the mention index instead of by scanning conversations
// (Part 9.1). Reading never mints and never teaches: nothing found is an honest unknown.

// Past tenses no rule derives. Graph data rather than a table in code, so the Teacher can
// add one the same way (reading-spec Part 5.7, `PastOf`). A regular verb needs none.
// `WhatDo(Me(), Like())`: the object of a relation on the subject. Beliefs first, in the
// form a relation is stored under; then happenings said, in the past tense for `Did`.
// "where does greg work" asks for the place, so `Works` also finds `WorksAt` and `WorksIn`.
// `Who(Likes(Cats()))`: a hole where the subject goes. "find the units holding Likes(Cats())"
// is one lookup on the relation index (reading-spec P3), then happenings said, whose subject
// heads the clause. "works at google" is the phrasal relation WorksAt, as it was believed.
// Anything else is the ordinary question: "who is greg" still describes Greg.
Concept(Who(),
  Realization(Who($claim), context=Context(Execution(), Interrogative()), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Let(
              $positional,
              Lambda(
                List($e),
                If(
                  Call($isCall, $e),
                  Map(
                    Filter(
                      Member($e, "args"),
                      Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                    Lambda(List($a), Member($a, "value"))),
                  List()))),
            Let(
              $named,
              Lambda(
                List($e, $n),
                If(
                  Call($isCall, $e),
                  OptionalMember(
                    Call(
                      Member(Member($e, "args"), "find"),
                      Lambda(List($a), Equals(Member($a, "name"), $n))),
                    "value"),
                  Undefined()))),
            Let(
              $user,
              Lambda(
                List(),
                OptionalMember(
                  Call(
                    Member(Call(Member(Member($api, "store"), "asObject"), "User"), "find"),
                    Lambda(List($t), Equals(Member($t, "predicate"), "IsA"))),
                  "subject"))),
            Let(
              $about,
              Lambda(
                List($subject),
                Sequence(
                  If(Not(Call($isCall, $subject)), Return(Undefined()), Undefined()),
                  Let($resolved, Call($named, $subject, "resolvedTo")),
                  If(Call($isCall, $resolved), Return(Member($resolved, "head")), Undefined()),
                  If(Equals(Member($subject, "head"), "Me"), Return(Call($user)), Undefined()),
                  If(Equals(Member($subject, "head"), "You"), Return("Self"), Undefined()),
                  Return(Member($subject, "head"))))),
            Let(
              $thirdPerson,
              Lambda(
                List($head),
                Call(
                  Member($head, "replace"),
                  Regex("^([A-Z][a-z]*?)(s?)(?=[A-Z]|$)", ""),
                  Lambda(
                    List($m, $w, $s),
                    If(Or($s, Call(Member(Regex("s$", ""), "test"), $w)), $m, Add($w, "s")))))),
            Let(
              $past,
              Lambda(
                List($head),
                Sequence(
                  Let(
                    $held,
                    Call(
                      Member(Call(Member(Member($api, "store"), "asObject"), $head), "find"),
                      Lambda(List($t), Equals(Member($t, "predicate"), "PastOf")))),
                  If($held, Return(Member($held, "subject")), Undefined()),
                  Let(
                    List(Hole(), $w, $rest),
                    Otherwise(
                      Call(Member(Regex("^([A-Z][a-z]*)(.*)$", ""), "exec"), $head),
                      List(Hole(), $head, ""))),
                  Return(
                    Add(
                      If(Call(Member(Regex("e$", ""), "test"), $w), Add($w, "d"), Add($w, "ed")),
                      $rest))))),
            Let(
              $saidByUser,
              Lambda(
                List($mention),
                Call(
                  Member(
                    FlatMap(
                      Filter(
                        Map(
                          Call(Member(Member($api, "store"), "mentioning"), $mention),
                          Lambda(List($m), Member($m, "relation"))),
                        Lambda(
                          List($r),
                          And(
                            And(
                              And(
                                Call($isCall, Member($r, "claim")),
                                Equals(Member(Member($r, "claim"), "head"), "Said")),
                              Call($isCall, Index(Call($positional, Member($r, "claim")), 0))),
                            Equals(
                              Member(Index(Call($positional, Member($r, "claim")), 0), "head"),
                              "Me")))),
                      Lambda(
                        List($r),
                        Map(
                          Otherwise(Member($r, "stamps"), List()),
                          Lambda(
                            List($st),
                            Object(
                              content=Index(Call($positional, Member($r, "claim")), 1),
                              seq=Member($st, "seq"),
                              at=Member($st, "recordedAt")))))),
                    "sort"),
                  Lambda(List($a, $b), Subtract(Member($b, "seq"), Member($a, "seq")))))),
            Let($DAY, 86400000),
            Let(
              $midnight,
              Lambda(
                List($d),
                Call(
                  Member(
                    New(
                      $Date,
                      Call(Member($d, "getFullYear")),
                      Call(Member($d, "getMonth")),
                      Call(Member($d, "getDate"))),
                    "getTime")))),
            Let(
              $offset,
              Lambda(
                List($e),
                Sequence(
                  Var($found, Undefined()),
                  Call(
                    $walk,
                    $e,
                    Lambda(
                      List($n),
                      Sequence(
                        If(NotEquals($found, Undefined()), Return(), Undefined()),
                        If(
                          And(Equals(Member($n, "head"), "Today"), Not(Length(Member($n, "args")))),
                          Assign($found, 0),
                          If(
                            And(
                              Equals(Member($n, "head"), "Yesterday"),
                              Not(Length(Member($n, "args")))),
                            Assign($found, Negate(1)),
                            If(
                              And(
                                Equals(Member($n, "head"), "Tomorrow"),
                                Not(Length(Member($n, "args")))),
                              Assign($found, 1),
                              If(
                                And(
                                  And(
                                    And(
                                      Equals(Member($n, "head"), "Ago"),
                                      Call(
                                        $isCall,
                                        OptionalMember(Index(Member($n, "args"), 0), "value"))),
                                    Equals(
                                      Member(Member(Index(Member($n, "args"), 0), "value"), "head"),
                                      "Days")),
                                  Equals(
                                    TypeOf(
                                      OptionalMember(
                                        Index(
                                          Member(
                                            Member(Index(Member($n, "args"), 0), "value"),
                                            "args"),
                                          0),
                                        "value")),
                                    "number")),
                                Assign(
                                  $found,
                                  Negate(
                                    Member(
                                      Index(
                                        Member(
                                          Member(Index(Member($n, "args"), 0), "value"),
                                          "args"),
                                        0),
                                      "value"))),
                                Undefined()))))))),
                  Return($found)))),
            Let($RELATIVE, List("Today", "Yesterday", "Tomorrow", "Ago")),
            Let(
              $eventDay,
              Lambda(
                List($e, $at),
                Add(
                  Call($midnight, New($Date, $at)),
                  Multiply(Otherwise(Call($offset, $e), 0), $DAY)))),
            Let(
              $MONTH,
              List(
                "January",
                "February",
                "March",
                "April",
                "May",
                "June",
                "July",
                "August",
                "September",
                "October",
                "November",
                "December")),
            Let(
              $dateIn,
              Lambda(
                List($e),
                Sequence(
                  Var($found, Undefined()),
                  Call(
                    $walk,
                    $e,
                    Lambda(
                      List($n),
                      Sequence(
                        If(Or($found, NotEquals(Member($n, "head"), "Date")), Return(), Undefined()),
                        Let(
                          $f,
                          Lambda(
                            List($k),
                            OptionalMember(
                              Call(
                                Member(Member($n, "args"), "find"),
                                Lambda(List($a), Equals(Member($a, "name"), $k))),
                              "value"))),
                        Let($m, Call($f, "month")),
                        Let(
                          $month,
                          If(
                            Equals(TypeOf($m), "number"),
                            $m,
                            If(
                              Call($isCall, $m),
                              Add(Call(Member($MONTH, "indexOf"), Member($m, "head")), 1),
                              0))),
                        If(
                          GreaterThan($month, 0),
                          Assign(
                            $found,
                            Object(year=Call($f, "year"), month=$month, day=Call($f, "day"))),
                          Undefined())))),
                  Return($found)))),
            Let(
              $happened,
              Lambda(
                List($e, $at),
                Sequence(
                  Let($explicit, Call($dateIn, $e)),
                  If(
                    $explicit,
                    Return(
                      Object(
                        year=Otherwise(
                          Member($explicit, "year"),
                          Call(Member(New($Date, $at), "getFullYear"))),
                        month=Member($explicit, "month"),
                        day=Member($explicit, "day"))),
                    Undefined()),
                  Let($d, New($Date, Call($eventDay, $e, $at))),
                  Return(
                    Object(
                      year=Call(Member($d, "getFullYear")),
                      month=Add(Call(Member($d, "getMonth")), 1),
                      day=Call(Member($d, "getDate"))))))),
            Let(
              $askedFor,
              Lambda(
                List($e),
                Sequence(
                  Let($explicit, Call($dateIn, $e)),
                  If($explicit, Return($explicit), Undefined()),
                  Let($o, Call($offset, $e)),
                  If(Equals($o, Undefined()), Return(Undefined()), Undefined()),
                  Let($d, New($Date, Add(Call($midnight, New($Date)), Multiply($o, $DAY)))),
                  Return(
                    Object(
                      year=Call(Member($d, "getFullYear")),
                      month=Add(Call(Member($d, "getMonth")), 1),
                      day=Call(Member($d, "getDate"))))))),
            Let(
              $within,
              Lambda(
                List($event, $asked),
                Call(
                  Member(List("year", "month", "day"), "every"),
                  Lambda(
                    List($k),
                    Or(
                      Equals(Index($asked, $k), Undefined()),
                      Equals(Index($asked, $k), Index($event, $k))))))),
            Let(
              $anchored,
              Lambda(
                List($e, $day),
                Sequence(
                  If(Not(Call($isCall, $e)), Return($e), Undefined()),
                  If(
                    Includes($RELATIVE, Member($e, "head")),
                    Sequence(
                      Let(
                        $diff,
                        Call(
                          Member($Math, "round"),
                          Divide(Subtract($day, Call($midnight, New($Date))), $DAY))),
                      If(Equals($diff, 0), Return(Call(Member($api, "call"), "Today")), Undefined()),
                      If(
                        Equals($diff, Negate(1)),
                        Return(Call(Member($api, "call"), "Yesterday")),
                        Undefined()),
                      If(
                        Equals($diff, 1),
                        Return(Call(Member($api, "call"), "Tomorrow")),
                        Undefined()),
                      Let($d, New($Date, $day)),
                      Return(
                        Call(
                          Member($api, "call"),
                          "On",
                          Object(
                            head="Date",
                            args=List(
                              Object(name="year", value=Call(Member($d, "getFullYear"))),
                              Object(name="month", value=Add(Call(Member($d, "getMonth")), 1)),
                              Object(name="day", value=Call(Member($d, "getDate")))))))),
                    Undefined()),
                  Return(
                    Object(
                      head=Member($e, "head"),
                      args=Map(
                        Member($e, "args"),
                        Lambda(
                          List($a),
                          Object(Spread($a), value=Call($anchored, Member($a, "value"), $day))))))))),
            Let(
              $told,
              Lambda(
                List($content),
                Or(
                  Not(And(Call($isCall, $content), Equals(Member($content, "head"), "Mood"))),
                  And(
                    Call($isCall, Index(Call($positional, $content), 0)),
                    Equals(Member(Index(Call($positional, $content), 0), "head"), "Declarative"))))),
            Let(
              $walk,
              Lambda(
                List($e, $visit),
                Sequence(
                  If(Not(Call($isCall, $e)), Return(), Undefined()),
                  Call($visit, $e),
                  ForOf($a, Member($e, "args"), Call($walk, Member($a, "value"), $visit))))),
            Let($claim, Member(Index($args, 0), "value")),
            Let(
              $ask,
              Lambda(
                List(),
                Call(Member($api, "evaluate"), Call(Member($api, "call"), "Interrogative", $claim)))),
            Let($said, Call($positional, $claim)),
            If(
              Or(
                Or(
                  Or(Not(Call($isCall, $claim)), Not(Length($said))),
                  Equals(Member($claim, "head"), "Is")),
                Call($named, $claim, "resolvedTo")),
              Return(Await(Call($ask))),
              Undefined()),
            If(
              GreaterThan(
                Otherwise(
                  Length(
                    OptionalMember(
                      Call(Member(Member($api, "store"), "get"), Member($claim, "head")),
                      "realizations")),
                  0),
                0),
              Return(Await(Call($ask))),
              Undefined()),
            If(
              Not(
                Call(
                  Member($said, "some"),
                  Lambda(List($v), Or(Call($isCall, $v), NotEquals(TypeOf($v), "object"))))),
              Return(Await(Call($ask))),
              Undefined()),
            Let($PREPOSITIONS, List("At", "In", "For", "With", "On", "From", "To")),
            Var($predicate, Call($thirdPerson, Member($claim, "head"))),
            Var($objects, $said),
            If(
              And(
                And(Equals(Length($said), 1), Call($isCall, Index($said, 0))),
                Includes($PREPOSITIONS, Member(Index($said, 0), "head"))),
              Sequence(
                Assign($predicate, Add($predicate, Member(Index($said, 0), "head"))),
                Assign($objects, Call($positional, Index($said, 0)))),
              Undefined()),
            Let(
              $wanted,
              Call(
                Member(Map($objects, Lambda(List($v), Call(Member($api, "format"), $v))), "join"),
                ",")),
            Let($first, Index($objects, 0)),
            Let($key, If(Call($isCall, $first), Member($first, "head"), $first)),
            Let(
              $holders,
              If(
                Equals($key, Undefined()),
                List(),
                Map(
                  Filter(
                    Call(
                      Member(Member($api, "store"), "asObject"),
                      If(
                        And(Call($isCall, $first), Equals(Length(Member($first, "args")), 0)),
                        Member($first, "head"),
                        Call(Member($api, "format"), $first))),
                    Lambda(
                      List($t),
                      And(
                        Equals(Member($t, "predicate"), $predicate),
                        Equals(
                          Call(
                            Member(
                              Map(
                                Call($positional, Member($t, "expr")),
                                Lambda(List($v), Call(Member($api, "format"), $v))),
                              "join"),
                            ","),
                          $wanted)))),
                  Lambda(List($t), Call(Member($api, "call"), Member($t, "subject")))))),
            If(
              Length($holders),
              Return(
                Call(
                  Member($api, "call"),
                  "Answer",
                  If(
                    Equals(Length($holders), 1),
                    Index($holders, 0),
                    Call(Member($api, "call"), "List", Spread($holders))))),
              Undefined()),
            Let($found, List()),
            ForOf(
              $s,
              Call($saidByUser, Call(Member($api, "call"), Member($claim, "head"))),
              Sequence(
                If(Not(Call($told, Member($s, "content"))), Continue(), Undefined()),
                Call(
                  $walk,
                  Member($s, "content"),
                  Lambda(
                    List($node),
                    Sequence(
                      Let(
                        $clause,
                        Call(
                          Member(Call($positional, $node), "find"),
                          Lambda(
                            List($v),
                            And(
                              Call($isCall, $v),
                              Equals(Member($v, "head"), Member($claim, "head")))))),
                      If(Not($clause), Return(), Undefined()),
                      Let($text, Call(Member($api, "format"), $clause)),
                      If(
                        Call(
                          Member($said, "every"),
                          Lambda(
                            List($v),
                            Includes(
                              $text,
                              Call(
                                Member(Call(Member($api, "format"), $v), "replace"),
                                Regex("\\)$", ""),
                                "")))),
                        Call(Member($found, "push"), $node),
                        Undefined())))))),
            If(
              Length($found),
              Return(
                Call(
                  Member($api, "call"),
                  "Answer",
                  If(
                    Equals(Length($found), 1),
                    Index($found, 0),
                    Call(Member($api, "call"), "List", Spread($found))))),
              Undefined()),
            Return(Await(Call($ask)))))))))

