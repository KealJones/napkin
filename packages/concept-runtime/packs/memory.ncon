                Member($api, "call"),
                "Answer",
                If(
                  Equals(Length($found), 1),
                  Index($found, 0),
                  Call(Member($api, "call"), "List", Spread($found)))))))))))

// "tell me about greg", "what do you know about greg": what is held about it, the same
