Requires(Basic())

// ================================================================
// From src/seed/memory-individuals.ts
//
// memory-spec build step 3: the machinery an individual is minted through
// (design/memory-spec.md Part 3.2, Part 6.1, Part 13, Part 18 step 3).
//
// Kept out of `seed.ts`'s own list so this lane and a sibling lane (the indexes, memory-spec
// Part 9.1) can both add seed Concepts without touching the same array.
//
// Only the machinery. Nothing here decides WHEN something earns an identity (Part 6.2) --
// that policy is the next wave, a realization on `Believe` this file does not add.

// `Mint(base)`, exactly as unprivileged as `Cell` (memory-spec Part 3.2): its body
// reaches the host allocator through `api` and returns the fresh identity, nothing
// more. It does not assert `IsA` or `Named` on what it minted -- the caller does that
// with `api.store.addRelation(...)`, sourced from `api.trace.cause`, the same way a
// declared game's realization would add `IsA(Chess())` and `Players(...)` as two
// separate relations after minting `Game_7` (Part 7.1). Keeping Mint to allocation
// alone means it needs no opinion about what an individual's first relations should be,
// which is exactly the opinion this build step is not supposed to have yet.
//
// `base` is either a bare string (the name, when one is already known) or a nullary
// Concept (its kind, when it is not) -- the same choice memory-spec Part 3.2 leaves to
// whoever mints.
Concept(Mint(),
  Realization(Mint($base), properties=List(Effectful(), Program()),
    body=Bind(
      $base2,
      $base,
      Bind(
        $name,
        If(
          Identical(TypeOf($base2), "string"),
          $base2,
          Bind(
            $t1,
            Bind($t0, $base2, If(Truthy($t0), Head($base2), $t0)),
            If(Truthy($t1), $t1, "Thing"))),
        MakeCall(MintIdentity($name), List())))))

// A wrong merge is repaired without deleting anything (Part 6.5): `Greg_2` is minted,
// `DistinctFrom(Greg_1())` is asserted on it, and the misattributed relations move.
// Seeded here so the relation exists to assert; the repair itself -- finding what was
// misattributed and moving it -- is the merge-repair automation this build step
// explicitly leaves undone.
//
// `Symmetric()` because two things distinct from one another is one fact, not two: the
// existing symmetric-relation derivation (`store/relations.ts`) gives `Greg_1` the
// inverse for free the same way it does for any other symmetric relation.
Concept(DistinctFrom(), Symmetric())

// ================================================================
// From src/seed/memory-believe.ts
//
// memory-spec build step 4: believing what was said (design/memory-spec.md Parts 5.3, 5.4,
// 6.2; design/reading-spec.md Part 5.2).
//
// Under `Declarative()` the mood realization does not evaluate a claim-shaped line, it
// hands it here. `Believe` finds what the line is about and decides whether the claim is
// lasting. A lasting claim is asserted on its subject, stamped with the `Said` it came
// from as its source. Anything else stays where it already is, inside the `Said`.
//
// Every policy in this file is a realization, so changing what is believed, where it
// lands, or when something earns an identity is editing Concepts, not host code.

// Shared by the realizations below: reading a line's parts, and finding the user.
//
// The user is an individual like any other (memory-spec Part 3.2), minted once and found
// by `IsA(User())`, never by identity. `Me()` in what the user says is resolved against it
// on read; the words themselves keep `Me()` (Part 5.2).
Concept(User(), IsA(Category()))

Concept(Believed(), IsA(Result()))

Concept(Noted(), IsA(Result()))

// Lasting by nature. Anything not declared is occurrent: a lasting fact filed as a
// happening stays findable in its Said, and a happening filed as lasting bloats its
// subject with nothing ever noticing (Part 5.3).
Concept(IsA(), Enduring())

Concept(Named(), Enduring())

Concept(Likes(), Enduring())

Concept(Loves(), Enduring())

Concept(Hates(), Enduring())

Concept(Prefers(), Enduring())

Concept(Owns(), Enduring())

// One at a time: someone lives in one place, so a second is a change or a mistake.
Concept(LivesIn(), Enduring(), Functional())

Concept(WorksAt(), Enduring(), Functional())

Concept(SharesMemesWith(), Enduring())

Concept(Conflict(), IsA(Result()))

// `Believe(line)`: what a claim is about, and whether it lasts (Part 5.4).
//
// - The subject is found by descending through possessives to the first head whose
//   argument is the claim: `My(Dad(IsA(Doctor())))` is `IsA(Doctor())` about "my dad"
//   (reading-spec Part 5.2). A verb-first claim, `Is(7, Prime())`, is the same claim
//   with the subject inside (reading-spec P3).
// - "my X is Y": a role. "greg is my coworker" is `CoworkerOf(<user>)` on Greg, and
//   "my name is keal" is `Named("Keal")` on the user.
// - A category keeps its describing words as properties: "a small dog" is `IsA(Dog())`
//   and `Small()`, so inheritance runs through Dog, not through Small.
// - Where it lands: `Me()` is the user; a name already `Named` is that individual; a
//   name nothing holds earns an individual only by a lasting claim (Part 6.2); a kind
//   said with an article ("a blorp") or in the plural is the kind itself.
// - `IsA` on a kind that already realizes something is held as said, not asserted,
//   because `IsA` orders its selection (reading-spec Part 5.2).
//
// A line that is not claim-shaped is evaluated as it always was, so a declarative
// request or a follow-up phrase still works. `Effectful()`, so under `Hypothetical()`
// nothing is believed (Part 5.4).
Concept(Believe(),
  Realization(Believe($line), evaluateArguments=false, properties=List(Effectful()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(
              $positional,
              Lambda(
                List($e),
                If(
                  Call($isCall, $e),
                  Map(
                    Filter(
                      Member($e, "args"),
                      Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                    Lambda(List($a), Member($a, "value"))),
                  List()))),
            Bind(
              $named,
              Lambda(
                List($e, $n),
                If(
                  Call($isCall, $e),
                  OptionalMember(
                    Call(
                      Member(Member($e, "args"), "find"),
                      Lambda(List($a), Equals(Member($a, "name"), $n))),
                    "value"),
                  Undefined()))),
            Bind($OWNER, Object(My="Me", Your="You", Our="We")),
            Bind(
              $user,
              Lambda(
                List($create),
                Sequence(
                  Bind(
                    $held,
                    Call(
                      Member(Call(Member(Member($api, "store"), "asObject"), "User"), "find"),
                      Lambda(List($t), Equals(Member($t, "predicate"), "IsA")))),
                  If($held, Return(Member($held, "subject")), Undefined()),
                  If(Not($create), Return(Undefined()), Undefined()),
                  Bind($id, Call(Member(Member($api, "store"), "mint"), "User")),
                  Call(
                    Member(Member($api, "store"), "addRelation"),
                    $id,
                    Call(Member($api, "call"), "IsA", Call(Member($api, "call"), "User")),
                    Undefined(),
                    Member(Member($api, "trace"), "cause")),
                  Return($id)))),
            Bind(
              $who,
              Lambda(
                List($deictic, $create),
                If(
                  Equals($deictic, "Me"),
                  Call($user, $create),
                  If(Equals($deictic, "You"), "Self", Undefined())))),
            Bind(
              $thirdPerson,
              Lambda(
                List($head),
                Call(
                  Member($head, "replace"),
                  Regex("^([A-Z][a-z]*?)(s?)(?=[A-Z]|$)", ""),
                  Lambda(
                    List($m, $w, $s),
                    If(Or($s, Call(Member(Regex("s$", ""), "test"), $w)), $m, Add($w, "s")))))),
            Bind(
              $functional,
              Lambda(
                List($head),
                Call(
                  Member(
                    Otherwise(
                      OptionalMember(Call(Member(Member($api, "store"), "get"), $head), "relations"),
                      List()),
                    "some"),
                  Lambda(
                    List($r),
                    And(
                      Call($isCall, Member($r, "claim")),
                      Equals(Member(Member($r, "claim"), "head"), "Functional")))))),
            Bind(
              $clashes,
              Lambda(
                List($target, $claim, $single),
                Filter(
                  Call(Member(Member($api, "relations"), "of"), $target),
                  Lambda(
                    List($t),
                    And(
                      And(
                        Equals(Member($t, "predicate"), Member($claim, "head")),
                        Or($single, Call($functional, Member($claim, "head")))),
                      NotEquals(
                        Call(Member($api, "format"), Member($t, "expr")),
                        Call(Member($api, "format"), $claim))))))),
            Bind(
              $retract,
              Lambda(
                List($target, $old),
                Sequence(
                  Bind($unit, Call(Member(Member($api, "store"), "get"), $target)),
                  Bind(
                    $relation,
                    And(
                      $unit,
                      Call(
                        Member(Member($unit, "relations"), "find"),
                        Lambda(
                          List($r),
                          Equals(
                            Call(Member($api, "format"), Member($r, "claim")),
                            Call(Member($api, "format"), Member($old, "expr"))))))),
                  ForOf(
                    $st,
                    Otherwise(OptionalMember($relation, "stamps"), List()),
                    Call(
                      Member(Member($api, "store"), "addRelation"),
                      $target,
                      Call(Member($api, "call"), "Retracts", Member($st, "seq")),
                      Undefined(),
                      Member(Member($api, "trace"), "cause"))),
                  Undefined()))),
            Bind(
              $settle,
              Lambda(
                List($target, $claims, $display, $single),
                Sequence(
                  Bind($replacing, Equals(Call(Member($api, "ambient"), "replace"), "1")),
                  Bind(
                    $old,
                    FlatMap($claims, Lambda(List($k), Call($clashes, $target, $k, $single)))),
                  If(Not(Length($old)), Return(Undefined()), Undefined()),
                  If(
                    Not($replacing),
                    Return(
                      Object(
                        head="Conflict",
                        args=List(
                          Object(value=$display),
                          Object(
                            value=Call(
                              Member($api, "call"),
                              "List",
                              Spread(Map($old, Lambda(List($t), Member($t, "expr")))))),
                          Object(value=Call(Member($api, "call"), "List", Spread($claims))),
                          Object(
                            name="said",
                            value=Call($String, Otherwise(Call(Member($api, "ambient"), "message"), "")))))),
                    Undefined()),
                  ForOf($t, $old, Call($retract, $target, $t)),
                  Return(Undefined())))),
            Bind(
              $holderOf,
              Lambda(
                List($role, $owner),
                OptionalMember(
                  Call(
                    Member(Call(Member(Member($api, "store"), "asObject"), $owner), "find"),
                    Lambda(List($t), Equals(Member($t, "predicate"), Add($role, "Of")))),
                  "subject"))),
            Bind($line, Member(Index($args, 0), "value")),
            Bind($cause, Member(Member($api, "trace"), "cause")),
            Bind(
              $message,
              Call(
                Member(
                  Call($String, Otherwise(Call(Member($api, "ambient"), "message"), "")),
                  "toLowerCase"))),
            Bind(
              $spoken,
              Lambda(
                List($head),
                Call(
                  Member(
                    Call(Member($head, "replace"), Regex("([a-z0-9])([A-Z])", "g"), "$1 $2"),
                    "toLowerCase")))),
            Bind(
              $realizes,
              Lambda(
                List($head),
                GreaterThan(
                  Otherwise(
                    Length(
                      OptionalMember(
                        Call(Member(Member($api, "store"), "get"), $head),
                        "realizations")),
                    0),
                  0))),
            Bind(
              $enduring,
              Lambda(
                List($head),
                Call(
                  Member(
                    Otherwise(
                      OptionalMember(Call(Member(Member($api, "store"), "get"), $head), "relations"),
                      List()),
                    "some"),
                  Lambda(
                    List($r),
                    And(
                      Call($isCall, Member($r, "claim")),
                      Equals(Member(Member($r, "claim"), "head"), "Enduring")))))),
            Bind($evaluateAsSaid, Lambda(List(), Call(Member($api, "evaluate"), $line))),
            Var($subject, Undefined()),
            Var($claim, Undefined()),
            Var($owner, Undefined()),
            Var($appositive, Undefined()),
            If(
              And(
                And(Call($isCall, $line), AtLeast(Length(Call($positional, $line)), 2)),
                Not(Call($realizes, Member($line, "head")))),
              Sequence(
                Bind(List($first, Spread($rest)), Call($positional, $line)),
                Assign($subject, $first),
                Assign($claim, Call(Member($api, "call"), Member($line, "head"), Spread($rest)))),
              Sequence(
                Var($node, $line),
                While(
                  And(
                    And(
                      And(Call($isCall, $node), Index($OWNER, Member($node, "head"))),
                      Equals(Length(Call($positional, $node)), 1)),
                    Call($isCall, Index(Call($positional, $node), 0))),
                  Sequence(
                    Assign($owner, Index($OWNER, Member($node, "head"))),
                    Assign($node, Index(Call($positional, $node), 0)))),
                Bind($COPULA, List("Is", "IsA", "Are", "Was", "Were")),
                Bind($describers, List()),
                While(
                  And(
                    And(
                      And(
                        And(
                          And(Call($isCall, $node), Equals(Length(Call($positional, $node)), 1)),
                          Call($isCall, Index(Call($positional, $node), 0))),
                        Equals(Length(Call($positional, Index(Call($positional, $node), 0))), 1)),
                      Call($isCall, Index(Call($positional, Index(Call($positional, $node), 0)), 0))),
                    Includes(
                      $COPULA,
                      Member(
                        Index(Call($positional, Index(Call($positional, $node), 0)), 0),
                        "head"))),
                  Sequence(
                    Call(Member($describers, "push"), Member($node, "head")),
                    Assign($node, Index(Call($positional, $node), 0)))),
                Bind($inner, Call($positional, $node)),
                If(
                  And(
                    And(
                      And(
                        And(And($owner, Call($isCall, $node)), Equals(Length($inner), 2)),
                        Call($isCall, Index($inner, 0))),
                      Equals(Length(Member(Index($inner, 0), "args")), 0)),
                    Call($isCall, Index($inner, 1))),
                  Sequence(
                    Assign($appositive, Member(Index($inner, 0), "head")),
                    Assign($subject, $node),
                    Assign($claim, Index($inner, 1))),
                  Sequence(
                    If(
                      Or(
                        Or(
                          Or(Not(Call($isCall, $node)), NotEquals(Length($inner), 1)),
                          Not(Call($isCall, Index($inner, 0)))),
                        And(
                          Call($realizes, Member($node, "head")),
                          Not(Index($OWNER, Member($node, "head"))))),
                      Return(Await(Call($evaluateAsSaid))),
                      Undefined()),
                    Assign(
                      $subject,
                      If(
                        Or($owner, Length($describers)),
                        Call(
                          Member($api, "call"),
                          Add(Call(Member($describers, "join"), ""), Member($node, "head"))),
                        $node)),
                    Assign($claim, Index($inner, 0)))))),
            If(
              Or(Not(Call($isCall, $claim)), Not(Call($isCall, $subject))),
              Return(Await(Call($evaluateAsSaid))),
              Undefined()),
            Bind($PREPOSITIONS, List("At", "In", "For", "With", "On", "From", "To")),
            Bind($only, Call($positional, $claim)),
            If(
              And(
                And(
                  And(Equals(Length($only), 1), Call($isCall, Index($only, 0))),
                  Includes($PREPOSITIONS, Member(Index($only, 0), "head"))),
                Equals(Length(Call($positional, Index($only, 0))), 1)),
              Assign(
                $claim,
                Call(
                  Member($api, "call"),
                  Add(Member($claim, "head"), Member(Index($only, 0), "head")),
                  Index(Call($positional, Index($only, 0)), 0))),
              Undefined()),
            Bind($kept, List()),
            Bind(
              $role,
              If(
                And(
                  Equals(Member($claim, "head"), "Is"),
                  Equals(Length(Call($positional, $claim)), 1)),
                Index(Call($positional, $claim), 0),
                Undefined())),
            If(
              And(
                And(
                  And(
                    And(And($owner, Not($appositive)), Equals(Member($subject, "head"), "Name")),
                    Equals(Member($claim, "head"), "Is")),
                  Equals(Length(Call($positional, $claim)), 1)),
                NotEquals($role, Undefined())),
              Sequence(
                Bind(
                  $text,
                  If(
                    Equals(TypeOf($role), "string"),
                    $role,
                    If(
                      Call($isCall, $role),
                      Call($spoken, Member($role, "head")),
                      Call($String, $role)))),
                Bind($target, Call($who, $owner, true)),
                If(Not($target), Return(Call(Member($api, "call"), "Noted", $line)), Undefined()),
                Bind(
                  $name,
                  Call(
                    Member($text, "replace"),
                    Regex("\\b\\w", "g"),
                    Lambda(List($ch), Call(Member($ch, "toUpperCase"))))),
                Call(
                  Member(Member($api, "store"), "addRelation"),
                  $target,
                  Call(Member($api, "call"), "Named", $name),
                  Undefined(),
                  $cause),
                Return(
                  Call(
                    Member($api, "call"),
                    "Believed",
                    Call(Member($api, "call"), "Me"),
                    Call(Member($api, "call"), "List", Call(Member($api, "call"), "Named", $name))))),
              Undefined()),
            If(
              And(
                And(
                  And(And($owner, Not($appositive)), Equals(Member($claim, "head"), "Is")),
                  GreaterThan(Length(Call($positional, $claim)), 1)),
                Equals(Member($subject, "head"), "Name")),
              Return(Call(Member($api, "call"), "Noted", $line)),
              Undefined()),
            If(
              And(
                And(
                  And(And($owner, Not($appositive)), Equals(Member($claim, "head"), "Is")),
                  AtLeast(Length(Call($positional, $claim)), 1)),
                Not(And(Call($isCall, $role), Index($OWNER, Member($role, "head"))))),
              Sequence(
                Bind($ownerId, Call($who, $owner, true)),
                If(
                  Or(Not($ownerId), Call($holderOf, Member($subject, "head"), $ownerId)),
                  Return(Call(Member($api, "call"), "Noted", $line)),
                  Undefined()),
                Bind(
                  $attribute,
                  Call(
                    Member($api, "call"),
                    Member($subject, "head"),
                    Spread(Call($positional, $claim)))),
                Bind(
                  $possessive,
                  Call(
                    Member(Call(Member($Object, "keys"), $OWNER), "find"),
                    Lambda(List($k), Equals(Index($OWNER, $k), $owner)))),
                Bind(
                  $asked,
                  Call(
                    $settle,
                    $ownerId,
                    List($attribute),
                    Call(
                      Member($api, "call"),
                      $possessive,
                      Call(Member($api, "call"), Member($subject, "head"))),
                    true)),
                If($asked, Return($asked), Undefined()),
                Call(
                  Member(Member($api, "store"), "addRelation"),
                  $ownerId,
                  $attribute,
                  Undefined(),
                  $cause),
                Return(
                  Call(
                    Member($api, "call"),
                    "Believed",
                    Call(
                      Member($api, "call"),
                      $possessive,
                      Call(Member($api, "call"), Member($subject, "head"))),
                    Call(Member($api, "call"), "List", $attribute)))),
              Undefined()),
            If(
              And(
                And(
                  And(Call($isCall, $role), Index($OWNER, Member($role, "head"))),
                  Equals(Length(Call($positional, $role)), 1)),
                Call($isCall, Index(Call($positional, $role), 0))),
              Sequence(
                Bind($holder, Call($who, Index($OWNER, Member($role, "head")), true)),
                If(
                  $holder,
                  Call(
                    Member($kept, "push"),
                    Call(
                      Member($api, "call"),
                      Add(Member(Index(Call($positional, $role), 0), "head"), "Of"),
                      Call(Member($api, "call"), $holder))),
                  Undefined())),
              If(
                And(
                  Equals(Member($claim, "head"), "IsA"),
                  Call($isCall, Index(Call($positional, $claim), 0))),
                Sequence(
                  Var($kind, Index(Call($positional, $claim), 0)),
                  While(
                    And(
                      And(Call($isCall, $kind), Equals(Length(Call($positional, $kind)), 1)),
                      Call($isCall, Index(Call($positional, $kind), 0))),
                    Sequence(
                      Call(Member($kept, "push"), Call(Member($api, "call"), Member($kind, "head"))),
                      Assign($kind, Index(Call($positional, $kind), 0)))),
                  Call(
                    Member($kept, "unshift"),
                    Call(
                      Member($api, "call"),
                      "IsA",
                      Call(Member($api, "call"), Member($kind, "head"))))),
                If(
                  Call($enduring, Member($claim, "head")),
                  Call(Member($kept, "push"), $claim),
                  If(
                    Call($enduring, Call($thirdPerson, Member($claim, "head"))),
                    Call(
                      Member($kept, "push"),
                      Call(
                        Member($api, "call"),
                        Call($thirdPerson, Member($claim, "head")),
                        Spread(Call($positional, $claim)))),
                    Undefined())))),
            Bind($ownerOfRole, If($appositive, Call($who, $owner, true), Undefined())),
            If(
              And($appositive, $ownerOfRole),
              Call(
                Member($kept, "unshift"),
                Call(
                  Member($api, "call"),
                  Add($appositive, "Of"),
                  Call(Member($api, "call"), $ownerOfRole))),
              Undefined()),
            If(Not(Length($kept)), Return(Call(Member($api, "call"), "Noted", $line)), Undefined()),
            Var($target, Undefined()),
            Var($display, Call(Member($api, "call"), Member($subject, "head"))),
            Bind($resolved, Call($named, $subject, "resolvedTo")),
            Bind(
              $person,
              Lambda(
                List($name),
                Sequence(
                  Bind(
                    $held,
                    Call(
                      Member(
                        Call(
                          Member(Member($api, "store"), "asObject"),
                          Call(Member($api, "format"), $name)),
                        "find"),
                      Lambda(List($t), Equals(Member($t, "predicate"), "Named")))),
                  If($held, Return(Member($held, "subject")), Undefined()),
                  Bind($id, Call(Member(Member($api, "store"), "mint"), $name)),
                  Call(
                    Member(Member($api, "store"), "addRelation"),
                    $id,
                    Call(Member($api, "call"), "Named", $name),
                    Undefined(),
                    $cause),
                  Return($id)))),
            Bind(
              $NAMEISH,
              List(
                "GivenName",
                "FirstName",
                "MaleName",
                "FemaleName",
                "Surname",
                "FamilyName",
                "HumanName",
                "Name")),
            Bind(
              $isName,
              Lambda(
                List($head),
                Call(
                  Member(
                    Otherwise(
                      OptionalMember(Call(Member(Member($api, "store"), "get"), $head), "relations"),
                      List()),
                    "some"),
                  Lambda(
                    List($r),
                    And(
                      And(
                        And(
                          Call($isCall, Member($r, "claim")),
                          Equals(Member(Member($r, "claim"), "head"), "IsA")),
                        Call($isCall, Index(Call($positional, Member($r, "claim")), 0))),
                      Includes(
                        $NAMEISH,
                        Member(Index(Call($positional, Member($r, "claim")), 0), "head"))))))),
            If(
              $appositive,
              Assign(
                $target,
                If(
                  Call($isCall, $resolved),
                  Member($resolved, "head"),
                  Call($person, Member($subject, "head")))),
              If(
                $owner,
                Sequence(
                  Bind($ownerId, Call($who, $owner, true)),
                  Assign(
                    $target,
                    And($ownerId, Call($holderOf, Member($subject, "head"), $ownerId))),
                  If(
                    And(Not($target), $ownerId),
                    Sequence(
                      Assign(
                        $target,
                        Call(Member(Member($api, "store"), "mint"), Member($subject, "head"))),
                      Call(
                        Member(Member($api, "store"), "addRelation"),
                        $target,
                        Call(
                          Member($api, "call"),
                          "IsA",
                          Call(Member($api, "call"), Member($subject, "head"))),
                        Undefined(),
                        $cause),
                      Call(
                        Member(Member($api, "store"), "addRelation"),
                        $target,
                        Call(
                          Member($api, "call"),
                          Add(Member($subject, "head"), "Of"),
                          Call(Member($api, "call"), $ownerId)),
                        Undefined(),
                        $cause)),
                    Undefined()),
                  Assign(
                    $display,
                    Call(
                      Member($api, "call"),
                      Call(
                        Member(Call(Member($Object, "keys"), $OWNER), "find"),
                        Lambda(List($k), Equals(Index($OWNER, $k), $owner))),
                      Call(Member($api, "call"), Member($subject, "head"))))),
                If(
                  Or(
                    NotEquals(Call($who, Member($subject, "head"), false), Undefined()),
                    Equals(Member($subject, "head"), "Me")),
                  Assign($target, Call($who, Member($subject, "head"), true)),
                  If(
                    Call($isCall, $resolved),
                    Assign($target, Member($resolved, "head")),
                    Sequence(
                      Bind($word, Call($spoken, Member($subject, "head"))),
                      Bind(
