                          Call(Member($tried, "push"), Object(game=$game, result=$result)),
                          Undefined()))),
                    Let(
                      $legal,
                      Filter(
                        $tried,
                        Lambda(
                          List($t),
                          Not(
                            And(
                              Call($isCall, Member($t, "result")),
                              Equals(Member(Member($t, "result"), "head"), "Illegal")))))),
                    If(Equals(Length($legal), 1), Return(Index($legal, 0)), Undefined()),
                    If(Not(Length($legal)), Return(Index($tried, 0)), Undefined()),
                    If(
                      Includes($ranked, Member(Index($legal, 0), "game")),
                      Return(Index($legal, 0)),
                      Undefined()),
                    Return(
                      Object(
                        ask=Call(
                          Member($api, "call"),
                          "Which",
                          $request,
                          Call(
                            Member($api, "call"),
                            "List",
                            Spread(Map($legal, Lambda(List($t), Call($echo, Member($t, "game"))))))))))))),
            Let($game, Member(Call(Member($bindings, "get"), "game"), "head")),
            Return(Call($inGame, $game, Await(Call($fold, $game))))))))))

