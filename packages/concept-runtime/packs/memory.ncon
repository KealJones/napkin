// ================================================================
// From src/seed/memory-consolidate.ts
//
// memory-spec build step 8: consolidation (design/memory-spec.md Part 11;
// emergent-judgment-plan.md Part 3.4, Part 3.5).
//
// Repeated happenings inside `Said` become a lasting fact on their subject, sourced from
// one consolidation stamp that carries the evidence count and span rather than a relation
// pointing at every occurrence. That is what lets the occurrences themselves be collected
// later (`store/collect.ts`) without dangling the fact they produced (safety property 3,
// Part 10.4).
//
// What relation the consolidated fact gets is a naming problem this build step does not
// solve mechanically. `Ate(GrannySmith())` repeated has an obvious target, `Likes(...)`,
// because a single-argument occurrent claim's own argument IS the thing repeatedly done to
// or with, so `Likes` is a safe generic name for it. `Sent(Me(), Meme())` does not: naming
// it `SharesMemesWith` requires knowing which argument is the recipient and turning a verb
// into a noun, which is exactly the generalisation problem `emergent-judgment-plan.md`
// Part 3.4 solves by anti-unifying several *different* claims, not one repeated one. Rather
// than guess, anything with more than one argument consolidates to the generic
// `Often(claim)` — true, deterministic, and honest about not having named it.
//
// The thresholds are relations on `Consolidate` itself, not scattered constants, so
// changing how much evidence is enough is editing an ordinary Concept (concept-spec
// Part 2.1's privilege test), the same way `Believe`'s occurrent default is.

Concept(Consolidated(), IsA(Result()))

// A lasting "usually true" fact, for whatever a specific relation cannot be named
// mechanically (see the module doc). Enduring like any other lasting fact.
Concept(Often(), Enduring())

// `Consolidate()`: scan every conversation's `Said` for a happening repeated enough to
// distill, and assert it (Part 11). Idempotent — a wording already consolidated is
// skipped — so running it twice, or from `Exist`'s agenda alongside a CLI `--commit`,
// adds nothing the second time.
//
// `dryRun` is read the same way `Believe` reads `message`: an ambient fact for this
// turn, not an argument, since nothing about consolidating a specific Concept differs
// between a report and a commit.
Concept(Consolidate(),
  MinOccurrences(3),
  MinConversations(2),
  MinDays(2),
  Realization(Consolidate(), context=Execution(), properties=List(Effectful()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Let(
              $positional,
              Lambda(
                List($e),
                If(
                  Call($isCall, $e),
                  Map(
                    Filter(
                      Member($e, "args"),
                      Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                    Lambda(List($a), Member($a, "value"))),
                  List()))),
            Let(
              $unmood,
              Lambda(
                List($e),
                If(
                  And(
                    And(Call($isCall, $e), Equals(Member($e, "head"), "Mood")),
                    Equals(Length(Member($e, "args")), 2)),
                  Member(Index(Member($e, "args"), 1), "value"),
                  $e))),
            Let($dryRun, Equals(Call(Member($api, "ambient"), "dryRun"), "true")),
            Let($cause, Member(Member($api, "trace"), "cause")),
            Let(
              $thresholds,
              Member(Call(Member(Member($api, "store"), "get"), "Consolidate"), "relations")),
            Let(
              $threshold,
              Lambda(
                List($name, $fallback),
                Sequence(
                  Let(
                    $held,
                    Call(
                      Member($thresholds, "find"),
                      Lambda(
                        List($r),
                        And(
                          Call($isCall, Member($r, "claim")),
                          Equals(Member(Member($r, "claim"), "head"), $name))))),
                  Let($v, And($held, Index(Call($positional, Member($held, "claim")), 0))),
                  Return(If(Equals(TypeOf($v), "number"), $v, $fallback))))),
            Let($minOccurrences, Call($threshold, "MinOccurrences", 3)),
            Let($minConversations, Call($threshold, "MinConversations", 2)),
            Let($minDays, Call($threshold, "MinDays", 2)),
            Let($said, List()),
            ForOf(
              $unit,
              Call(Member(Member($api, "store"), "all")),
              Sequence(
                If(
                  Not(
                    Call(
                      Member(Regex("^(Conversation_|IsolatedConversation_)", ""), "test"),
                      Member($unit, "identity"))),
                  Continue(),
                  Undefined()),
                ForOf(
                  $r,
                  Member($unit, "relations"),
                  Sequence(
                    If(
                      Or(
                        Not(Call($isCall, Member($r, "claim"))),
                        NotEquals(Member(Member($r, "claim"), "head"), "Said")),
                      Continue(),
                      Undefined()),
                    Let(List($speaker, $rawContent), Call($positional, Member($r, "claim"))),
                    Let($content, Call($unmood, $rawContent)),
                    If(
                      Or(
                        Or(Not(Call($isCall, $speaker)), NotEquals(Member($speaker, "head"), "Me")),
                        Not(Call($isCall, $content))),
                      Continue(),
                      Undefined()),
                    ForOf(
                      $stamp,
                      Otherwise(Member($r, "stamps"), List()),
                      Call(
                        Member($said, "push"),
                        Object(
                          content=$content,
                          conversation=Member($unit, "identity"),
                          day=Call(Member(Member($stamp, "recordedAt"), "slice"), 0, 10),
                          seq=Member($stamp, "seq")))))))),
            Let($groups, New($Map)),
            ForOf(
              $entry,
              $said,
              Sequence(
                Let($key, Call(Member($api, "format"), Member($entry, "content"))),
                Let($list, Call(Member($groups, "get"), $key)),
                If(
                  $list,
                  Call(Member($list, "push"), $entry),
                  Call(Member($groups, "set"), $key, List($entry))))),
            Let($done, List()),
            ForOf(
              $entries,
              Call(Member($groups, "values")),
              Sequence(
                Let(
                  $conversations,
                  New($Set, Map($entries, Lambda(List($e), Member($e, "conversation"))))),
                Let($days, New($Set, Map($entries, Lambda(List($e), Member($e, "day"))))),
                If(
                  Or(
                    Or(
                      LessThan(Length($entries), $minOccurrences),
                      LessThan(Member($conversations, "size"), $minConversations)),
                    LessThan(Member($days, "size"), $minDays)),
                  Continue(),
                  Undefined()),
                Let($content, Member(Index($entries, 0), "content")),
                Let($inner, Call($positional, $content)),
                If(
                  Or(NotEquals(Length($inner), 1), Not(Call($isCall, Index($inner, 0)))),
                  Continue(),
                  Undefined()),
                Let($claim, Index($inner, 0)),
                Var($target, Undefined()),
                If(
                  Equals(Member($content, "head"), "Me"),
                  Sequence(
                    Let(
                      $held,
                      Call(
                        Member(Call(Member(Member($api, "store"), "asObject"), "User"), "find"),
                        Lambda(List($t), Equals(Member($t, "predicate"), "IsA")))),
                    If(
                      $held,
                      Assign($target, Member($held, "subject")),
                      If(
                        Not($dryRun),
                        Sequence(
                          Assign($target, Call(Member(Member($api, "store"), "mint"), "User")),
                          Call(
                            Member(Member($api, "store"), "addRelation"),
                            $target,
                            Call(Member($api, "call"), "IsA", Call(Member($api, "call"), "User")),
                            Undefined(),
                            $cause)),
                        Assign($target, "User")))),
                  If(
                    Call(Member(Member($api, "store"), "has"), Member($content, "head")),
                    Assign($target, Member($content, "head")),
                    Undefined())),
                If(Not($target), Continue(), Undefined()),
                Let($claimArgs, Call($positional, $claim)),
                Let(
                  $fact,
                  If(
                    Equals(Length($claimArgs), 1),
                    Call(Member($api, "call"), "Likes", Index($claimArgs, 0)),
                    Call(Member($api, "call"), "Often", $claim))),
                Let(
                  $already,
                  Call(
                    Member(
                      Otherwise(
                        Member(Call(Member(Member($api, "store"), "get"), $target), "relations"),
                        List()),
                      "some"),
                    Lambda(
                      List($r),
                      And(
                        And(
                          Call($isCall, Member($r, "claim")),
                          Equals(Member(Member($r, "claim"), "head"), "Consolidation")),
                        Equals(
                          Call(
                            Member($api, "format"),
                            Member(Index(Member(Member($r, "claim"), "args"), 0), "value")),
                          Call(Member($api, "format"), $content)))))),
                If($already, Continue(), Undefined()),
                Let(
                  $from,
                  Member(
                    Call(
                      Member($entries, "reduce"),
                      Lambda(
                        List($a, $b),
                        If(LessThan(Member($a, "day"), Member($b, "day")), $a, $b))),
                    "day")),
                Let(
                  $to,
                  Member(
                    Call(
                      Member($entries, "reduce"),
                      Lambda(
                        List($a, $b),
                        If(GreaterThan(Member($a, "day"), Member($b, "day")), $a, $b))),
                    "day")),
                If(
                  Not($dryRun),
                  Sequence(
                    Let(
                      $mark,
                      Call(
                        Member(Member($api, "store"), "addRelation"),
                        $target,
                        Call(
                          Member($api, "call"),
                          "Consolidation",
                          $content,
                          Length($entries),
                          $from,
                          $to))),
                    Call(
                      Member(Member($api, "store"), "addRelation"),
                      $target,
                      $fact,
                      Undefined(),
                      Member($mark, "seq"))),
                  Undefined()),
                Call(Member($done, "push"), Call(Member($api, "call"), $target, $fact)))),
            Return(
              Call(
                Member($api, "call"),
                "Consolidated",
                Call(Member($api, "call"), "List", Spread($done))))))))))

// ================================================================
// From src/seed/memory-activation.ts
//
// memory-spec build step 7: the `Activation` Concept (design/memory-spec.md Part 10.1,
// Part 10.2; emergent-judgment-plan.md Part 3.3, section 7).
//
// One Concept, two terms: the formula is computed generically in `runtime/activation.ts`,
// and what it is tuned by lives here, as relations, so how fast things fade and when they go
// dormant is edited in the graph rather than in host code (Part 13, the privilege test). A
// later assertion of the same parameter shadows the seeded one, the way a newer realization
// shadows an older one, since seeding is additive and never overwrites an edit.

Concept(Activation(), Decay(0.5), Strength(2), DormantBelow(-7), Budget(64))
