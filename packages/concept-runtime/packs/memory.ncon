// ================================================================
// From src/seed/memory-forget.ts
//
// Explicit forgetting (memory-spec Part 10.5): "forget what i said about money".
//
// Not dormancy. It is a request, it overrides every threshold, and there is usually a
// privacy reason behind it. Provenance makes it exact: the `Said` stamps that mention the
// thing go, and so does every stamp whose source chain leads to them, the beliefs and
// replies they caused. A belief that also has another source keeps it and loses only the
// forgotten one. The trace of those turns goes too, since it holds their parse.

Concept(Forgotten(), IsA(Result()))

Concept(Forget(),
  Realization(Forget($what), context=Execution(), evaluateArguments=false, properties=List(Effectful()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Let(
              $positional,
              Lambda(
                List($e),
                If(
                  Call($isCall, $e),
                  Map(
                    Filter(
                      Member($e, "args"),
                      Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                    Lambda(List($a), Member($a, "value"))),
                  List()))),
            Let(
              $find,
              Lambda(
                List($e),
                Sequence(
                  If(Not(Call($isCall, $e)), Return(Undefined()), Undefined()),
                  If(
                    Equals(Member($e, "head"), "About"),
                    Return(Index(Call($positional, $e), 0)),
                    Undefined()),
                  ForOf(
                    $v,
                    Call($positional, $e),
                    Sequence(Let($inner, Call($find, $v)), If($inner, Return($inner), Undefined()))),
                  Return(Undefined())))),
            Let($said, Member(Index($args, 0), "value")),
            Let($topic, Otherwise(Call($find, $said), $said)),
            If(
              Or(Not(Call($isCall, $topic)), Equals(Member($topic, "head"), "Ref")),
              Return(Call(Member($api, "call"), "Answer", Call(Member($api, "call"), "Unknown"))),
              Undefined()),
            Let(
              $resolved,
              OptionalMember(
                Call(
                  Member(Member($topic, "args"), "find"),
                  Lambda(List($a), Equals(Member($a, "name"), "resolvedTo"))),
                "value")),
            Let(
              $keys,
              Concat(
                List(Member($topic, "head")),
                If(Call($isCall, $resolved), List(Member($resolved, "head")), List()))),
            Let($forgotten, New($Set)),
            Let($turns, List()),
            ForOf(
              $key,
              $keys,
              ForOf(
                $m,
                Call(Member(Member($api, "store"), "mentioning"), Call(Member($api, "call"), $key)),
                Sequence(
                  Let($claim, Member(Member($m, "relation"), "claim")),
                  If(
                    Or(Not(Call($isCall, $claim)), NotEquals(Member($claim, "head"), "Said")),
                    Continue(),
                    Undefined()),
                  Let($speaker, Index(Call($positional, $claim), 0)),
                  If(
                    Or(Not(Call($isCall, $speaker)), NotEquals(Member($speaker, "head"), "Me")),
                    Continue(),
                    Undefined()),
                  ForOf(
                    $s,
                    Otherwise(Member(Member($m, "relation"), "stamps"), List()),
                    Sequence(
                      Call(Member($forgotten, "add"), Member($s, "seq")),
                      Call(Member($turns, "push"), Member($s, "seq"))))))),
            Let(
              $asSaid,
              OptionalIndex(
                Call(
                  Member(Regex("\\babout (.+?)[.!?]*$", "i"), "exec"),
                  Call($String, Otherwise(Call(Member($api, "ambient"), "message"), ""))),
