Concept(About(),
  Realization(About($thing), context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Let(
              $positional,
              Lambda(
                List($e),
                If(
                  Call($isCall, $e),
                  Map(
                    Filter(
                      Member($e, "args"),
                      Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                    Lambda(List($a), Member($a, "value"))),
