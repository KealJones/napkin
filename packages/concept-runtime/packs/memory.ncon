// "does greg like cats", "do i like cats": a yes/no question with do-support, looked up
// as the relation it asks about, in the form it is stored under. A lookup, never a
// lesson: not holding it is unknown, not false (concept-spec Part 5.2).
Concept(Do(),
  Realization(Do($subject, $claim), context=Context(Execution(), Interrogative()), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Let(
              $positional,
              Lambda(
                List($e),
                If(
                  Call($isCall, $e),
                  Map(
                    Filter(
                      Member($e, "args"),
                      Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                    Lambda(List($a), Member($a, "value"))),
                  List()))),
            Let(
              $named,
              Lambda(
                List($e, $n),
                If(
                  Call($isCall, $e),
                  OptionalMember(
                    Call(
                      Member(Member($e, "args"), "find"),
                      Lambda(List($a), Equals(Member($a, "name"), $n))),
                    "value"),
                  Undefined()))),
            Let($OWNER, Object(My="Me", Your="You", Our="We")),
            Let(
              $user,
              Lambda(
                List($create),
                Sequence(
                  Let(
                    $held,
                    Call(
                      Member(Call(Member(Member($api, "store"), "asObject"), "User"), "find"),
                      Lambda(List($t), Equals(Member($t, "predicate"), "IsA")))),
                  If($held, Return(Member($held, "subject")), Undefined()),
                  If(Not($create), Return(Undefined()), Undefined()),
                  Let($id, Call(Member(Member($api, "store"), "mint"), "User")),
                  Call(
                    Member(Member($api, "store"), "addRelation"),
                    $id,
                    Call(Member($api, "call"), "IsA", Call(Member($api, "call"), "User")),
                    Undefined(),
                    Member(Member($api, "trace"), "cause")),
                  Return($id)))),
            Let(
              $who,
              Lambda(
                List($deictic, $create),
                If(
                  Equals($deictic, "Me"),
                  Call($user, $create),
                  If(Equals($deictic, "You"), "Self", Undefined())))),
            Let(
              $thirdPerson,
              Lambda(
                List($head),
                Call(
                  Member($head, "replace"),
                  Regex("^([A-Z][a-z]*?)(s?)(?=[A-Z]|$)", ""),
                  Lambda(
                    List($m, $w, $s),
                    If(Or($s, Call(Member(Regex("s$", ""), "test"), $w)), $m, Add($w, "s")))))),
            Let(
              $functional,
              Lambda(
                List($head),
                Call(
                  Member(
                    Otherwise(
                      OptionalMember(Call(Member(Member($api, "store"), "get"), $head), "relations"),
                      List()),
                    "some"),
                  Lambda(
                    List($r),
                    And(
                      Call($isCall, Member($r, "claim")),
                      Equals(Member(Member($r, "claim"), "head"), "Functional")))))),
            Let(
              $clashes,
              Lambda(
                List($target, $claim, $single),
                Filter(
                  Call(Member(Member($api, "relations"), "of"), $target),
                  Lambda(
                    List($t),
                    And(
                      And(
                        Equals(Member($t, "predicate"), Member($claim, "head")),
                        Or($single, Call($functional, Member($claim, "head")))),
                      NotEquals(
                        Call(Member($api, "format"), Member($t, "expr")),
                        Call(Member($api, "format"), $claim))))))),
            Let(
              $retract,
              Lambda(
                List($target, $old),
                Sequence(
                  Let($unit, Call(Member(Member($api, "store"), "get"), $target)),
                  Let(
                    $relation,
                    And(
                      $unit,
                      Call(
                        Member(Member($unit, "relations"), "find"),
                        Lambda(
                          List($r),
                          Equals(
                            Call(Member($api, "format"), Member($r, "claim")),
                            Call(Member($api, "format"), Member($old, "expr"))))))),
                  ForOf(
                    $st,
                    Otherwise(OptionalMember($relation, "stamps"), List()),
                    Call(
                      Member(Member($api, "store"), "addRelation"),
                      $target,
                      Call(Member($api, "call"), "Retracts", Member($st, "seq")),
                      Undefined(),
                      Member(Member($api, "trace"), "cause")))))),
            Let(
              $settle,
              Lambda(
                List($target, $claims, $display, $single),
                Sequence(
                  Let($replacing, Equals(Call(Member($api, "ambient"), "replace"), "1")),
                  Let(
                    $old,
                    FlatMap($claims, Lambda(List($k), Call($clashes, $target, $k, $single)))),
                  If(Not(Length($old)), Return(Undefined()), Undefined()),
                  If(
                    Not($replacing),
                    Return(
                      Object(
                        head="Conflict",
                        args=List(
                          Object(value=$display),
                          Object(
                            value=Call(
                              Member($api, "call"),
                              "List",
                              Spread(Map($old, Lambda(List($t), Member($t, "expr")))))),
                          Object(value=Call(Member($api, "call"), "List", Spread($claims))),
                          Object(
                            name="said",
                            value=Call($String, Otherwise(Call(Member($api, "ambient"), "message"), "")))))),
                    Undefined()),
                  ForOf($t, $old, Call($retract, $target, $t)),
                  Return(Undefined())))),
            Let(
              $holderOf,
              Lambda(
                List($role, $owner),
                OptionalMember(
                  Call(
                    Member(Call(Member(Member($api, "store"), "asObject"), $owner), "find"),
                    Lambda(List($t), Equals(Member($t, "predicate"), Add($role, "Of")))),
                  "subject"))),
            Let(
              $answer,
              Lambda(List($v), Call(Member($api, "call"), "Answer", Call(Member($api, "call"), $v)))),
            Let(
              List($subject, $claim),
              List(Member(Index($args, 0), "value"), Member(Index($args, 1), "value"))),
            If(
              Or(Not(Call($isCall, $subject)), Not(Call($isCall, $claim))),
              Return(Call($answer, "UnknownTruth")),
              Undefined()),
            If(
              And(
                And(Equals(Member($subject, "head"), "You"), Equals(Member($claim, "head"), "Know")),
                Equals(Length(Call($positional, $claim)), 1)),
              Sequence(
                Let(
                  $found,
                  Await(Call(Member($api, "evaluate"), Index(Call($positional, $claim), 0)))),
                Let(
                  $unwrapped,
                  If(
                    And(Call($isCall, $found), Equals(Member($found, "head"), "Answer")),
                    Index(Call($positional, $found), 0),
                    $found)),
                If(
                  And(Call($isCall, $unwrapped), Equals(Member($unwrapped, "head"), "List")),
                  Return(
                    If(
                      Length(Member($unwrapped, "args")),
                      Call(Member($api, "call"), "Answer", $unwrapped),
                      Call($answer, "UnknownTruth"))),
                  Undefined()),
                If(
                  And(
                    NotEquals($unwrapped, Undefined()),
                    NotEquals(
                      Call(Member($api, "format"), $unwrapped),
                      Call(Member($api, "format"), Index(Call($positional, $claim), 0)))),
                  Return(Call(Member($api, "call"), "Answer", $unwrapped)),
                  Undefined()),
                Return(Call($answer, "UnknownTruth"))),
              Undefined()),
            Let($resolved, Call($named, $subject, "resolvedTo")),
            Let(
              $about,
              If(
                Call($isCall, $resolved),
                Member($resolved, "head"),
                Otherwise(Call($who, Member($subject, "head"), false), Member($subject, "head")))),
            Let($predicate, Call($thirdPerson, Member($claim, "head"))),
            Let(
              $wanted,
              Call(
                Member(
                  Map(Call($positional, $claim), Lambda(List($v), Call(Member($api, "format"), $v))),
                  "join"),
                ",")),
            Let(
              $holds,
              Call(
                Member(Call(Member(Member($api, "relations"), "of"), $about), "some"),
                Lambda(
                  List($t),
                  And(
                    Equals(Member($t, "predicate"), $predicate),
                    Equals(
                      Call(
                        Member(
                          Map(
                            Call($positional, Member($t, "expr")),
                            Lambda(List($v), Call(Member($api, "format"), $v))),
                          "join"),
                        ","),
                      $wanted))))),
            Return(Call($answer, If($holds, "True", "UnknownTruth")))))))))

