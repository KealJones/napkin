// ------------------------------------------------------------------ *
// Program operations (ir-spec Part 10.8).
//
// What bodies lowered from a program are composed of, named by what they mean. Each is this
// host's implementation; a Rust host implements the same list.
// ------------------------------------------------------------------

Concept(Undefined(), IsA(CodePrimitive()))

Concept(Cell(), IsA(CodePrimitive()))

Concept(Get(), IsA(CodePrimitive()))

Concept(Set(), IsA(CodePrimitive()))

Concept(Try(), IsA(CodePrimitive()))

// Nothing there: null or Undefined().
Concept(IsNothing(),
  IsA(CodePrimitive()),
  Realization(IsNothing($x), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(
              Or(
                Equals(Index($v, 0), null),
                And(
                  And(
                    Equals(TypeOf(Index($v, 0)), "object"),
                    Equals(Member(Index($v, 0), "head"), "Undefined")),
                  Equals(Length(Member(Index($v, 0), "args")), 0))))))))))

// Whether x counts as true: all but false, False(), null, Undefined(), 0, NaN and empty text.
Concept(Truthy(),
  IsA(CodePrimitive()),
  Realization(Truthy($x), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $truthy,
              Lambda(
                List($v),
                Not(
                  Or(
                    Or(
                      Or(Or(Or(Equals($v, false), Equals($v, null)), Equals($v, 0)), Equals($v, "")),
                      Call(Member($Number, "isNaN"), $v)),
                    And(
                      And(
                        And(Equals(TypeOf($v), "object"), NotEquals($v, null)),
                        Or(
                          Equals(Member($v, "head"), "Undefined"),
                          Equals(Member($v, "head"), "False"))),
                      Equals(Length(Member($v, "args")), 0)))))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(Call($truthy, Index($v, 0)))))))))

// Whether x counts as false.
Concept(Falsy(),
