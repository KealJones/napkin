// x[key]: a List's or text's element by position, a record's field by name, or Undefined().
Concept(Element(),
  IsA(CodePrimitive()),
  Realization(Element($x, $key), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($U, Call(Member($api, "call"), "Undefined")),
            Bind($list, Lambda(List($xs), Call(Member($api, "call"), "List", Spread($xs)))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Bind(List($x, $k), $v),
            If(
              Equals(TypeOf($x), "string"),
              Return(
                If(
                  And(And(Equals(TypeOf($k), "number"), AtLeast($k, 0)), LessThan($k, Length($x))),
                  Index($x, $k),
                  $U)),
              Undefined()),
            If(Or(NotEquals(TypeOf($x), "object"), Equals($x, null)), Return($U), Undefined()),
            If(
              Equals(Member($x, "head"), "List"),
              Sequence(
                Bind(
                  $found,
                  If(Equals(TypeOf($k), "number"), Index(Member($x, "args"), $k), Undefined())),
                Return(If(Equals($found, Undefined()), $U, Member($found, "value")))),
              Undefined()),
            If(
              And(NotEquals(Member($x, "head"), "Record"), Equals($k, "head")),
              Return(Member($x, "head")),
              Undefined()),
            If(
              And(NotEquals(Member($x, "head"), "Record"), Equals($k, "args")),
              Return(
                Call(
                  $list,
                  Map(
                    Member($x, "args"),
                    Lambda(
                      List($a),
                      If(
                        Equals(Member($a, "name"), Undefined()),
                        Object(
                          head="Argument",
                          args=List(Object(name="value", value=Member($a, "value")))),
                        Object(
                          head="Argument",
                          args=List(
                            Object(name="name", value=Member($a, "name")),
                            Object(name="value", value=Member($a, "value"))))))))),
              Undefined()),
            Bind(
              $found,
              Call(
                Member(Member($x, "args"), "find"),
                Lambda(List($a), Equals(Member($a, "name"), $k)))),
            Return(If(Equals($found, Undefined()), $U, Member($found, "value")))))))))

