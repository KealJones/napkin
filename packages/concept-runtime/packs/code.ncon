Concept(Not(),
  IsA(CodePrimitive()),
  Realization(Not($x), context=Context(JavaScript(), Compiled()),
    body=Text(
      "((x) => (T(x) || (isCall(x) && x.head === \"False\")) ? B(!T(x)) : E(\"Not\", x))(",
      $x,
      ")")),
  Realization(Not($x), context=Execution(),
    body=Code(
      source="""async (args, bindings, api) => {
          
  const isCall = (e) => e !== null && typeof e === "object" && "head" in e;
  const truthy = (v) => v === true || (isCall(v) && v.head === "True");
  const isTruth = (v) => typeof v === "boolean" || (isCall(v) && (v.head === "True" || v.head === "False") && !v.args.length);
  const bool = (b) => api.call(b ? "True" : "False");
  const items = (v) => (isCall(v) && v.head === "List" ? v.args.map((a) => a.value) : []);
  const list = (xs) => ({ head: "List", args: xs.map((value) => ({ value })) });
  // Calling a Lambda: its parameters replaced by the values, then its body evaluated.
  const apply = async (f, values) => {
    if (!isCall(f) || f.head !== "Lambda") return api.call("Call", f, ...values);
    const params = items(f.args[0]?.value).map((p) => p && p.variable);
    const bound = new Map(params.map((p, i) => [p, values[i]]));
    return await api.evaluate(api.substitute(f.args[1].value, bound));
  };

          const v = (i) => args[i]?.value;
          const x = v(0); if (!isTruth(x)) return api.call("Not", x); return truthy(x) ? api.call("False") : api.call("True");
        }""")))

Concept(And(),
  IsA(CodePrimitive()),
  Realization(And($a, $b), context=Context(JavaScript(), Compiled()),
    body=Text("B(T(", $a, ") && T(", $b, "))")),
  Realization(And(Rest($xs)), context=Execution(), evaluateArguments=false,
    body=Code(
      source="""async (args, bindings, api) => {
          
  const isCall = (e) => e !== null && typeof e === "object" && "head" in e;
  const truthy = (v) => v === true || (isCall(v) && v.head === "True");
  const isTruth = (v) => typeof v === "boolean" || (isCall(v) && (v.head === "True" || v.head === "False") && !v.args.length);
  const bool = (b) => api.call(b ? "True" : "False");
  const items = (v) => (isCall(v) && v.head === "List" ? v.args.map((a) => a.value) : []);
  const list = (xs) => ({ head: "List", args: xs.map((value) => ({ value })) });
  // Calling a Lambda: its parameters replaced by the values, then its body evaluated.
  const apply = async (f, values) => {
    if (!isCall(f) || f.head !== "Lambda") return api.call("Call", f, ...values);
    const params = items(f.args[0]?.value).map((p) => p && p.variable);
    const bound = new Map(params.map((p, i) => [p, values[i]]));
    return await api.evaluate(api.substitute(f.args[1].value, bound));
  };

          const v = (i) => args[i]?.value;
          for (const a of args) { const x = await api.evaluate(a.value); if (!isTruth(x)) return api.call("And", ...args.map((b) => b.value)); if (!truthy(x)) return api.call("False"); } return api.call("True");
        }""")))

