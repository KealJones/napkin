// The IR's structure, the operations of any program that uses it.
Concept(If(), IsA(CodePrimitive()))

Concept(Sequence(), IsA(CodePrimitive()))

Concept(Bind(), IsA(CodePrimitive()))

Concept(Add())

Concept(Subtract())

Concept(Multiply())

Concept(Divide())

Concept(GreaterThan())

Concept(LessThan())

Concept(Compiled(), IsA(ContextFacet()))

// A function value: stays as it is until called.
Concept(Lambda(), IsA(Marker()))

// ================================================================
// Sameness, fields and failure, for bodies lowered from a program (ir-spec Part 10.8).

// a === b, answering true or false. Two Concepts are identical when they are the same expression.
Concept(Identical(),
  IsA(CodePrimitive()),
  Realization(Identical($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind($obj, Lambda(List($v), And(Equals(TypeOf($v), "object"), NotEquals($v, null)))),
          Bind(List($a, $b), Map($args, Lambda(List($x), Member($x, "value")))),
          Return(
            If(
              And(Call($obj, $a), Call($obj, $b)),
              Equals(Call(Member($api, "format"), $a), Call(Member($api, "format"), $b)),
              Equals($a, $b))))))))

// a !== b.
Concept(NotIdentical(),
  IsA(CodePrimitive()),
  Realization(NotIdentical($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind($obj, Lambda(List($v), And(Equals(TypeOf($v), "object"), NotEquals($v, null)))),
          Bind(List($a, $b), Map($args, Lambda(List($x), Member($x, "value")))),
          Return(
            If(
              And(Call($obj, $a), Call($obj, $b)),
              NotEquals(Call(Member($api, "format"), $a), Call(Member($api, "format"), $b)),
              NotEquals($a, $b))))))))

// typeof x, with Undefined() as undefined.
Concept(TypeOf(),
  IsA(CodePrimitive()),
  Realization(TypeOf($x), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($v, Member(Index($args, 0), "value")),
          If(
            And(
              And(
                And(Equals(TypeOf($v), "object"), NotEquals($v, null)),
                Equals(Member($v, "head"), "Undefined")),
              Equals(Length(Member($v, "args")), 0)),
            Return("undefined"),
            Undefined()),
          Return(TypeOf($v)))))))

// key in x. A record answers for its fields; any other Concept for head and args, which is what it is made of.
Concept(HasField(),
  IsA(CodePrimitive()),
  Realization(HasField($key, $x), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($records, New($Set, List("Argument", "Triple", "Stamp", "Mention", "Record"))),
          Bind(List($k, $v), Map($args, Lambda(List($x), Member($x, "value")))),
          If(Or(NotEquals(TypeOf($v), "object"), Equals($v, null)), Return(false), Undefined()),
          If(In("variable", $v), Return(Equals($k, "variable")), Undefined()),
          If(
            Call(Member($records, "has"), Member($v, "head")),
            Return(
              Call(
                Member(Member($v, "args"), "some"),
                Lambda(List($a), Equals(Member($a, "name"), $k)))),
            Undefined()),
          Return(Or(Equals($k, "head"), Equals($k, "args"))))))))

// record.key: the named field, or Undefined() when it has none.
Concept(FieldOf(),
  IsA(CodePrimitive()),
  Realization(FieldOf($record, $key), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind(List($r, $k), Map($args, Lambda(List($x), Member($x, "value")))),
          If(
            Or(Or(NotEquals(TypeOf($r), "object"), Equals($r, null)), Not(In("head", $r))),
            Return(Call(Member($api, "call"), "Undefined")),
            Undefined()),
          Bind(
            $found,
            Call(
              Member(Member($r, "args"), "find"),
              Lambda(List($a), Equals(Member($a, "name"), $k)))),
          Return(
            If(
              Equals($found, Undefined()),
              Call(Member($api, "call"), "Undefined"),
              Member($found, "value"))))))))

// e.args: an Argument(name=..., value=...) record for each argument.
Concept(Arguments(),
  IsA(CodePrimitive()),
  Realization(Arguments($e), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind($e, Member(Index($args, 0), "value")),
          If(
            Or(Or(NotEquals(TypeOf($e), "object"), Equals($e, null)), Not(In("head", $e))),
            Return(Call(Member($api, "call"), "Undefined")),
            Undefined()),
          Return(
            Call(
              Member($api, "call"),
              "List",
              Spread(
                Map(
                  Member($e, "args"),
                  Lambda(
                    List($a),
                    If(
                      Equals(Member($a, "name"), Undefined()),
                      Object(
                        head="Argument",
                        args=List(Object(name="value", value=Member($a, "value")))),
                      Object(
                        head="Argument",
                        args=List(
                          Object(name="name", value=Member($a, "name")),
                          Object(name="value", value=Member($a, "value")))))))))))))))

// throw x.
Concept(Throw(),
  IsA(CodePrimitive()),
  Realization(Throw($x), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($v, Member(Index($args, 0), "value")),
          Throw(
            If(
              InstanceOf($v, $Error),
              $v,
              New(
                $Error,
                If(Equals(TypeOf($v), "string"), $v, Call(Member($JSON, "stringify"), $v))))))))))

