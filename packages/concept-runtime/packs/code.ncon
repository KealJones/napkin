          List($args, $bindings, $api),
          Sequence(
            Bind($list, Lambda(List($xs), Call(Member($api, "call"), "List", Spread($xs)))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(
              Call(
                Member($api, "call"),
                "MutableMap",
                Call(Member(Member($api, "cells"), "allocate"), Call($list, List()))))))))),
  Realization(NewMap($pairs), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $items,
              Lambda(
                List($x),
                Sequence(
                  If(
                    And(
                      And(Equals(TypeOf($x), "object"), NotEquals($x, null)),
                      Equals(Member($x, "head"), "List")),
                    Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value")))),
                    Undefined()),
                  Bind($h, Call(Member($api, "toHost"), $x)),
                  If(
                    And(Not(Call(Member($Array, "isArray"), $h)), Not(InstanceOf($h, $Set))),
                    Throw(New($Error, "Expected a List")),
                    Undefined()),
                  Return(Map(Concat($h), Lambda(List($v), Call(Member($api, "fromHost"), $v))))))),
            Bind($host, Lambda(List($x), Call(Member($api, "toHost"), $x))),
            Bind($back, Lambda(List($x), Call(Member($api, "fromHost"), $x))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(
              Call(
                Member($api, "call"),
                "MutableMap",
                Call(
                  Member(Member($api, "cells"), "allocate"),
                  Call(
                    $back,
                    New(
                      $Map,
                      Map(
                        Call($items, Index($v, 0)),
                        Lambda(
                          List($p),
                          Sequence(
                            Bind($h, Call($host, $p)),
                            Return(
                              If(
                                Call(Member($Array, "isArray"), $h),
                                $h,
                                List(
                                  Call($host, Member(Index(Member($p, "args"), 0), "value")),
                                  Call($host, Member(Index(Member($p, "args"), 1), "value")))))))))))))))))))

// The set with x among its members.
Concept(SetAdd(),
  IsA(CodePrimitive()),
  Realization(SetAdd($s, $x), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($host, Lambda(List($x), Call(Member($api, "toHost"), $x))),
            Bind($back, Lambda(List($x), Call(Member($api, "fromHost"), $x))),
            Bind(
              $cell,
              Lambda(
                List($x),
                Sequence(
                  If(
                    Or(
                      Or(NotEquals(TypeOf($x), "object"), Equals($x, null)),
                      Not(Includes(List("MutableSet", "MutableMap"), Member($x, "head")))),
                    Throw(New($Error, "Expected a MutableSet or MutableMap")),
                    Undefined()),
                  Return(Member(Index(Member($x, "args"), 0), "value"))))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($s, Call($host, Index($v, 0))),
            Call(Member($s, "add"), Call($host, Index($v, 1))),
            Call(Member(Member($api, "cells"), "write"), Call($cell, Index($v, 0)), Call($back, $s)),
            Return(Index($v, 0))))))))

