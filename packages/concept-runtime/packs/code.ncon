Concept(Includes(),
  IsA(CodePrimitive()),
  Realization(Includes($xs, $x), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $isCall,
