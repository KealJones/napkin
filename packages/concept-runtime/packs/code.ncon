      $predicate,
      ")")),
  Realization(Holds($subject, $predicate), context=Execution(),
    body=Code(
      source="""async (args, bindings, api) => {
          
  const isCall = (e) => e !== null && typeof e === "object" && "head" in e;
  const truthy = (v) => v === true || (isCall(v) && v.head === "True");
  const isTruth = (v) => typeof v === "boolean" || (isCall(v) && (v.head === "True" || v.head === "False") && !v.args.length);
  const bool = (b) => api.call(b ? "True" : "False");
  const items = (v) => (isCall(v) && v.head === "List" ? v.args.map((a) => a.value) : []);
  const list = (xs) => ({ head: "List", args: xs.map((value) => ({ value })) });
  // Calling a Lambda: its parameters replaced by the values, then its body evaluated.
  const apply = async (f, values) => {
    if (!isCall(f) || f.head !== "Lambda") return api.call("Call", f, ...values);
    const params = items(f.args[0]?.value).map((p) => p && p.variable);
    const bound = new Map(params.map((p, i) => [p, values[i]]));
    return await api.evaluate(api.substitute(f.args[1].value, bound));
  };

          const v = (i) => args[i]?.value;
          const s = isCall(v(0)) ? v(0).head : String(v(0));
      return list(api.relations.of(s, { transitive: false }).filter((t) => t.predicate === String(v(1)) && !t.context).map((t) => t.object));
        }""")))

Concept(If(),
  Realization(If($condition, $then, $otherwise), context=Context(JavaScript(), Compiled()),
    body=Text("(T(", $condition, ") ? ", $then, " : ", $otherwise, ")")))

Concept(Add(),
  Realization(Add($a, $b), context=Context(JavaScript(), Compiled()),
    body=Text("(await N(\"Add\", ", $a, ", ", $b, ", (x, y) => x + y))")))

Concept(Subtract(),
  Realization(Subtract($a, $b), context=Context(JavaScript(), Compiled()),
    body=Text("(await N(\"Subtract\", ", $a, ", ", $b, ", (x, y) => x - y))")))

Concept(Multiply(),
  Realization(Multiply($a, $b), context=Context(JavaScript(), Compiled()),
    body=Text("(await N(\"Multiply\", ", $a, ", ", $b, ", (x, y) => x * y))")))

Concept(Divide(),
  Realization(Divide($a, $b), context=Context(JavaScript(), Compiled()),
    body=Text(
      "(await N(\"Divide\", ",
      $a,
      ", ",
      $b,
      ", (x, y) => (y === 0 ? api.call(\"Undefined\") : x / y)))")))

Concept(GreaterThan(),
  Realization(GreaterThan($a, $b), context=Context(JavaScript(), Compiled()),
    body=Text("(await N(\"GreaterThan\", ", $a, ", ", $b, ", (x, y) => B(x > y)))")))

Concept(LessThan(),
  Realization(LessThan($a, $b), context=Context(JavaScript(), Compiled()),
    body=Text("(await N(\"LessThan\", ", $a, ", ", $b, ", (x, y) => B(x < y)))")))

Concept(Compiled(), IsA(ContextFacet()))

Concept(Compile(), IsA(RealizationProperty()))

Concept(CodePrimitive(), IsA(Category()))

// A function value: stays as it is until called.
Concept(Lambda(), IsA(Marker()))
