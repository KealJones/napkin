// The List's elements as text, the separator between them.
Concept(Join(),
  IsA(CodePrimitive()),
  Realization(Join($xs, $separator), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $items,
              Lambda(
                List($x),
                Sequence(
                  If(
                    And(
                      And(Equals(TypeOf($x), "object"), NotEquals($x, null)),
                      Equals(Member($x, "head"), "List")),
                    Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value")))),
                    Undefined()),
                  Bind($h, Call(Member($api, "toHost"), $x)),
                  If(
                    And(Not(Call(Member($Array, "isArray"), $h)), Not(InstanceOf($h, $Set))),
                    Throw(New($Error, "Expected a List")),
                    Undefined()),
                  Return(Map(Concat($h), Lambda(List($v), Call(Member($api, "fromHost"), $v))))))),
            Bind($host, Lambda(List($x), Call(Member($api, "toHost"), $x))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(
              Call(
                Member(
                  Map(
                    Call($items, Index($v, 0)),
                    Lambda(
                      List($x),
                      If(
                        Or(
                          Equals($x, null),
                          And(Equals(TypeOf($x), "object"), Equals(Member($x, "head"), "Undefined"))),
                        "",
                        If(
                          And(
                            Equals(TypeOf($x), "object"),
                            Not(Includes(List("List", "Record", "Instant"), Member($x, "head")))),
                          Call(Member($api, "format"), $x),
                          Call($String, Call($host, $x)))))),
                  "join"),
                If(Equals(Index($v, 1), Undefined()), ",", Call($String, Index($v, 1)))))))))))

