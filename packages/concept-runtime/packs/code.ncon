              Lambda(
                List($v),
                Not(
                  Or(
                    Or(
                      Or(Or(Or(Equals($v, false), Equals($v, null)), Equals($v, 0)), Equals($v, "")),
                      Call(Member($Number, "isNaN"), $v)),
                    And(
                      And(
                        And(Equals(TypeOf($v), "object"), NotEquals($v, null)),
                        Or(
                          Equals(Member($v, "head"), "Undefined"),
                          Equals(Member($v, "head"), "False"))),
                      Equals(Length(Member($v, "args")), 0)))))),
            Bind($apply, Lambda(List($f, Spread($xs)), Call(Member($api, "applyLambda"), $f, $xs))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            For(
              Var($n, 0),
              Call($truthy, Await(Call($apply, Index($v, 0)))),
              Sequence(Await(Call($apply, Index($v, 2))), PostIncrement($n)),
              Sequence(
                If(
                  GreaterThan($n, 1000000),
                  Throw(New($Error, "A loop ran a million turns")),
                  Undefined()),
                Bind($r, Await(Call($apply, Index($v, 1)))),
                If(
                  And(Equals(TypeOf($r), "object"), NotEquals($r, null)),
                  Sequence(
                    If(Equals(Member($r, "head"), "LoopStop"), Break(), Undefined()),
                    If(Equals(Member($r, "head"), "LoopReturn"), Return($r), Undefined())),
                  Undefined()))),
            Return($U)))))))

