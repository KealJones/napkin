            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($s, Call(Member(Member($api, "store"), "findStamp"), Index($v, 0))),
            Return(If(Equals($s, Undefined()), $U, Call($back, $s)))))))))

// The stamps recorded between two times.
Concept(StampsBetween(),
  IsA(CodePrimitive()),
  Realization(StampsBetween($from, $to), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($back, Lambda(List($x), Call(Member($api, "fromHost"), $x))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
