          const v = (i) => args[i]?.value;
          for (const a of args) { const x = await api.evaluate(a.value); if (!isTruth(x)) return api.call("Or", ...args.map((b) => b.value)); if (truthy(x)) return api.call("True"); } return api.call("False");
        }""")))

// Lists, and text where JavaScript's own length and includes read text too.
Concept(Length(),
  IsA(CodePrimitive()),
  Realization(Length($xs), context=Context(JavaScript(), Compiled()),
    body=Text("((xs) => (typeof xs === \"string\" ? xs.length : I(xs).length))(", $xs, ")")),
