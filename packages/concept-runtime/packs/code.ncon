// A function applied to arguments. What is not a function stays the call it is.
Concept(Call(),
  IsA(CodePrimitive()),
  Realization(Call($f, Rest($args)), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($apply, Lambda(List($f, Spread($xs)), Call(Member($api, "applyLambda"), $f, $xs))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(Call($apply, Index($v, 0), Spread(Call(Member($v, "slice"), 1))))))))))

// What the Lambda answers of each element, and its position.
Concept(Map(),
  IsA(CodePrimitive()),
  Realization(Map($xs, $f), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($list, Lambda(List($xs), Call(Member($api, "call"), "List", Spread($xs)))),
            Bind($apply, Lambda(List($f, Spread($xs)), Call(Member($api, "applyLambda"), $f, $xs))),
            Bind(
              $seq,
              Lambda(
                List($x),
                Sequence(
                  If(
                    And(
                      And(Equals(TypeOf($x), "object"), NotEquals($x, null)),
                      Equals(Member($x, "head"), "List")),
                    Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value")))),
                    Undefined()),
                  Bind($h, Call(Member($api, "toHost"), $x)),
                  Return(
                    If(
                      InstanceOf($h, $Set),
                      Map(Concat($h), Lambda(List($y), Call(Member($api, "fromHost"), $y))),
                      List()))))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($xs, Call($seq, Index($v, 0))),
            Bind($out, List()),
            For(
              Var($i, 0),
              LessThan($i, Length($xs)),
              PostIncrement($i),
              Call(Member($out, "push"), Await(Call($apply, Index($v, 1), Index($xs, $i), $i)))),
            Return(Call($list, $out))))))))

// What the Lambda answers of each element, Lists joined.
Concept(FlatMap(),
  IsA(CodePrimitive()),
  Realization(FlatMap($xs, $f), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($list, Lambda(List($xs), Call(Member($api, "call"), "List", Spread($xs)))),
            Bind($apply, Lambda(List($f, Spread($xs)), Call(Member($api, "applyLambda"), $f, $xs))),
            Bind(
              $seq,
              Lambda(
                List($x),
                Sequence(
                  If(
                    And(
                      And(Equals(TypeOf($x), "object"), NotEquals($x, null)),
                      Equals(Member($x, "head"), "List")),
                    Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value")))),
                    Undefined()),
                  Bind($h, Call(Member($api, "toHost"), $x)),
                  Return(
                    If(
                      InstanceOf($h, $Set),
                      Map(Concat($h), Lambda(List($y), Call(Member($api, "fromHost"), $y))),
                      List()))))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($xs, Call($seq, Index($v, 0))),
            Bind($out, List()),
            For(
              Var($i, 0),
              LessThan($i, Length($xs)),
              PostIncrement($i),
              Sequence(
                Bind($r, Await(Call($apply, Index($v, 1), Index($xs, $i), $i))),
                If(
                  And(
                    And(Equals(TypeOf($r), "object"), NotEquals($r, null)),
                    Equals(Member($r, "head"), "List")),
                  Call(
                    Member($out, "push"),
                    Spread(Map(Member($r, "args"), Lambda(List($a), Member($a, "value"))))),
                  Call(Member($out, "push"), $r)))),
            Return(Call($list, $out))))))))

// The elements the Lambda holds of.
Concept(Filter(),
  IsA(CodePrimitive()),
  Realization(Filter($xs, $f), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $truthy,
              Lambda(
                List($v),
                Not(
                  Or(
                    Or(
                      Or(Or(Or(Equals($v, false), Equals($v, null)), Equals($v, 0)), Equals($v, "")),
                      Call(Member($Number, "isNaN"), $v)),
                    And(
                      And(
                        And(Equals(TypeOf($v), "object"), NotEquals($v, null)),
                        Or(
                          Equals(Member($v, "head"), "Undefined"),
                          Equals(Member($v, "head"), "False"))),
                      Equals(Length(Member($v, "args")), 0)))))),
            Bind($list, Lambda(List($xs), Call(Member($api, "call"), "List", Spread($xs)))),
            Bind($apply, Lambda(List($f, Spread($xs)), Call(Member($api, "applyLambda"), $f, $xs))),
            Bind(
              $seq,
              Lambda(
                List($x),
                Sequence(
                  If(
                    And(
                      And(Equals(TypeOf($x), "object"), NotEquals($x, null)),
                      Equals(Member($x, "head"), "List")),
                    Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value")))),
                    Undefined()),
                  Bind($h, Call(Member($api, "toHost"), $x)),
                  Return(
                    If(
                      InstanceOf($h, $Set),
                      Map(Concat($h), Lambda(List($y), Call(Member($api, "fromHost"), $y))),
                      List()))))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($xs, Call($seq, Index($v, 0))),
            Bind($out, List()),
            For(
              Var($i, 0),
              LessThan($i, Length($xs)),
              PostIncrement($i),
              If(
                Call($truthy, Await(Call($apply, Index($v, 1), Index($xs, $i), $i))),
                Call(Member($out, "push"), Index($xs, $i)),
                Undefined())),
            Return(Call($list, $out))))))))

