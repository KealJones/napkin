// The Lambda once for each element, until a turn stops the loop or returns.
Concept(LoopOver(),
  IsA(CodePrimitive()),
  Realization(LoopOver($xs, $turn), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($U, Call(Member($api, "call"), "Undefined")),
            Bind(
              $items,
              Lambda(
                List($x),
                Sequence(
                  If(
                    And(
                      And(Equals(TypeOf($x), "object"), NotEquals($x, null)),
                      Equals(Member($x, "head"), "List")),
                    Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value")))),
                    Undefined()),
                  Bind($h, Call(Member($api, "toHost"), $x)),
                  If(
                    And(Not(Call(Member($Array, "isArray"), $h)), Not(InstanceOf($h, $Set))),
                    Throw(New($Error, "Expected a List")),
                    Undefined()),
                  Return(Map(Concat($h), Lambda(List($v), Call(Member($api, "fromHost"), $v))))))),
            Bind($apply, Lambda(List($f, Spread($xs)), Call(Member($api, "applyLambda"), $f, $xs))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($xs, Call($items, Index($v, 0))),
            For(
              Var($i, 0),
              LessThan($i, Length($xs)),
              PostIncrement($i),
              Sequence(
                Bind($r, Await(Call($apply, Index($v, 1), Index($xs, $i), $i))),
                If(
                  And(Equals(TypeOf($r), "object"), NotEquals($r, null)),
                  Sequence(
                    If(Equals(Member($r, "head"), "LoopStop"), Break(), Undefined()),
                    If(Equals(Member($r, "head"), "LoopReturn"), Return($r), Undefined())),
                  Undefined()))),
            Return($U)))))))

// The turn Lambda while the test Lambda holds.
Concept(LoopWhile(),
  IsA(CodePrimitive()),
  Realization(LoopWhile($test, $turn), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($U, Call(Member($api, "call"), "Undefined")),
            Bind(
              $truthy,
              Lambda(
                List($v),
                Not(
                  Or(
                    Or(
                      Or(Or(Or(Equals($v, false), Equals($v, null)), Equals($v, 0)), Equals($v, "")),
                      Call(Member($Number, "isNaN"), $v)),
                    And(
                      And(
                        And(Equals(TypeOf($v), "object"), NotEquals($v, null)),
                        Or(
                          Equals(Member($v, "head"), "Undefined"),
                          Equals(Member($v, "head"), "False"))),
                      Equals(Length(Member($v, "args")), 0)))))),
            Bind($apply, Lambda(List($f, Spread($xs)), Call(Member($api, "applyLambda"), $f, $xs))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            For(
              Var($n, 0),
              Call($truthy, Await(Call($apply, Index($v, 0)))),
              PostIncrement($n),
              Sequence(
                If(
                  GreaterThan($n, 1000000),
                  Throw(New($Error, "A loop ran a million turns")),
                  Undefined()),
                Bind($r, Await(Call($apply, Index($v, 1)))),
                If(
                  And(Equals(TypeOf($r), "object"), NotEquals($r, null)),
                  Sequence(
                    If(Equals(Member($r, "head"), "LoopStop"), Break(), Undefined()),
                    If(Equals(Member($r, "head"), "LoopReturn"), Return($r), Undefined())),
                  Undefined()))),
            Return($U)))))))

// The turn Lambda, then again while the test Lambda holds.
Concept(LoopDoWhile(),
  IsA(CodePrimitive()),
  Realization(LoopDoWhile($turn, $test), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($U, Call(Member($api, "call"), "Undefined")),
            Bind(
              $truthy,
              Lambda(
                List($v),
                Not(
                  Or(
                    Or(
                      Or(Or(Or(Equals($v, false), Equals($v, null)), Equals($v, 0)), Equals($v, "")),
                      Call(Member($Number, "isNaN"), $v)),
                    And(
                      And(
                        And(Equals(TypeOf($v), "object"), NotEquals($v, null)),
                        Or(
                          Equals(Member($v, "head"), "Undefined"),
                          Equals(Member($v, "head"), "False"))),
                      Equals(Length(Member($v, "args")), 0)))))),
            Bind($apply, Lambda(List($f, Spread($xs)), Call(Member($api, "applyLambda"), $f, $xs))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Var($n, 0),
            DoWhile(
              Sequence(
                If(
                  GreaterThan(PostIncrement($n), 1000000),
                  Throw(New($Error, "A loop ran a million turns")),
                  Undefined()),
                Bind($r, Await(Call($apply, Index($v, 0)))),
                If(
                  And(Equals(TypeOf($r), "object"), NotEquals($r, null)),
                  Sequence(
                    If(Equals(Member($r, "head"), "LoopStop"), Break(), Undefined()),
                    If(Equals(Member($r, "head"), "LoopReturn"), Return($r), Undefined())),
                  Undefined())),
              Call($truthy, Await(Call($apply, Index($v, 1))))),
            Return($U)))))))

// The turn Lambda while the test holds, the step after each turn.
Concept(LoopFor(),
  IsA(CodePrimitive()),
  Realization(LoopFor($test, $turn, $step), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
