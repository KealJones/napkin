// Every unit the graph holds.
Concept(AllUnits(),
  IsA(CodePrimitive()),
  Realization(AllUnits(), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($back, Lambda(List($x), Call(Member($api, "fromHost"), $x))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(Call($back, Call(Member(Member($api, "store"), "all"))))))))))

// A relation added to the graph, stamped; the stamp is the answer.
Concept(Assert(),
  IsA(CodePrimitive()),
  Realization(Assert($id, $claim, $context, $cause), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($host, Lambda(List($x), Call(Member($api, "toHost"), $x))),
            Bind($back, Lambda(List($x), Call(Member($api, "fromHost"), $x))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(
              Call(
                $back,
                Call(
                  Member(Member($api, "store"), "addRelation"),
                  Call($String, Index($v, 0)),
                  Index($v, 1),
                  If(
                    Or(
                      Equals(Index($v, 2), Undefined()),
                      And(
                        And(Equals(TypeOf(Index($v, 2)), "object"), NotEquals(Index($v, 2), null)),
                        Equals(Member(Index($v, 2), "head"), "Undefined"))),
                    Undefined(),
                    Index($v, 2)),
                  Call($host, Index($v, 3)))))))))),
  Realization(Assert($id, $claim, $context), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($back, Lambda(List($x), Call(Member($api, "fromHost"), $x))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(
              Call(
                $back,
                Call(
                  Member(Member($api, "store"), "addRelation"),
                  Call($String, Index($v, 0)),
                  Index($v, 1),
                  If(
                    And(
                      And(Equals(TypeOf(Index($v, 2)), "object"), NotEquals(Index($v, 2), null)),
                      Equals(Member(Index($v, 2), "head"), "Undefined")),
                    Undefined(),
                    Index($v, 2)))))))))),
  Realization(Assert($id, $claim), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($back, Lambda(List($x), Call(Member($api, "fromHost"), $x))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(
              Call(
                $back,
                Call(
                  Member(Member($api, "store"), "addRelation"),
                  Call($String, Index($v, 0)),
                  Index($v, 1))))))))))

// Where the graph mentions a value: each relation that holds it.
Concept(MentionsOf(),
