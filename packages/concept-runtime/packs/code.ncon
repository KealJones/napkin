            Bind($list, Lambda(List($xs), Call(Member($api, "call"), "List", Spread($xs)))),
            Bind($host, Lambda(List($x), Call(Member($api, "toHost"), $x))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($m, Call(Member(Call($host, Index($v, 0)), "exec"), Call($String, Index($v, 1)))),
            Return(
              If(
                Equals($m, null),
                null,
                Call($list, Map(Concat($m), Lambda(List($x), If(Equals($x, Undefined()), $U, $x))))))))))))

// The text with the pattern (text or Regex) replaced, by text or by what a Lambda of the match answers.
Concept(Replace(),
  IsA(CodePrimitive()),
  Realization(Replace($t, $pattern, $with), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($U, Call(Member($api, "call"), "Undefined")),
            Bind($host, Lambda(List($x), Call(Member($api, "toHost"), $x))),
            Bind($apply, Lambda(List($f, Spread($xs)), Call(Member($api, "applyLambda"), $f, $xs))),
            Bind(
              $text,
              Lambda(
                List($x),
                Sequence(
                  If(
                    NotEquals(TypeOf($x), "string"),
                    Throw(New($Error, "Expected text")),
                    Undefined()),
                  Return($x)))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($t, Call($text, Index($v, 0))),
            Bind($p, Call($host, Index($v, 1))),
            Bind($w, Index($v, 2)),
            If(
              And(
                And(Equals(TypeOf($w), "object"), NotEquals($w, null)),
                Or(Equals(Member($w, "head"), "Lambda"), Equals(Member($w, "head"), "Recursive"))),
              Sequence(
                Bind(
                  $re,
                  If(
                    InstanceOf($p, $RegExp),
                    New(
                      $RegExp,
                      Member($p, "source"),
                      If(
                        Includes(Member($p, "flags"), "g"),
                        Member($p, "flags"),
                        Member($p, "flags"))),
                    null)),
                Var($out, ""),
                Var($at, 0),
                Bind(
                  $all,
                  If(
                    $re,
                    If(
                      Includes(Member($re, "flags"), "g"),
                      Concat(Call(Member($t, "matchAll"), $re)),
                      Filter(List(Call(Member($re, "exec"), $t)), $Boolean)),
                    Filter(
                      List(
                        If(
                          AtLeast(Call(Member($t, "indexOf"), $p), 0),
                          Call(
                            Member($Object, "assign"),
                            List($p),
                            Object(index=Call(Member($t, "indexOf"), $p))),
                          null)),
                      $Boolean))),
                ForOf(
                  $m,
                  $all,
                  Sequence(
                    Assign(
                      $out,
                      Add(
                        $out,
                        Add(
                          Call(Member($t, "slice"), $at, Member($m, "index")),
                          Call(
                            $String,
                            Call(
                              $host,
                              Await(
                                Call(
                                  $apply,
                                  $w,
                                  Spread(
                                    Map(
                                      Concat($m),
                                      Lambda(List($x), If(Equals($x, Undefined()), $U, $x))))))))))),
                    Assign($at, Add(Member($m, "index"), Length(Index($m, 0)))))),
                Return(Add($out, Call(Member($t, "slice"), $at)))),
              Undefined()),
            Return(Call(Member($t, "replace"), $p, Call($String, Call($host, $w))))))))))

