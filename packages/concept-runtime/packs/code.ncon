  IsA(CodePrimitive()),
  Realization(IsoText($i), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($host, Lambda(List($x), Call(Member($api, "toHost"), $x))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(Call(Member(Call($host, Index($v, 0)), "toISOString")))))))))

// A set that can change, of the List's distinct elements.
Concept(NewSet(),
  IsA(CodePrimitive()),
  Realization(NewSet($xs), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $items,
              Lambda(
                List($x),
                Sequence(
                  If(
                    And(
                      And(Equals(TypeOf($x), "object"), NotEquals($x, null)),
                      Equals(Member($x, "head"), "List")),
                    Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value")))),
                    Undefined()),
                  Bind($h, Call(Member($api, "toHost"), $x)),
                  If(
                    And(Not(Call(Member($Array, "isArray"), $h)), Not(InstanceOf($h, $Set))),
                    Throw(New($Error, "Expected a List")),
                    Undefined()),
                  Return(Map(Concat($h), Lambda(List($v), Call(Member($api, "fromHost"), $v))))))),
            Bind($list, Lambda(List($xs), Call(Member($api, "call"), "List", Spread($xs)))),
            Bind($host, Lambda(List($x), Call(Member($api, "toHost"), $x))),
            Bind($back, Lambda(List($x), Call(Member($api, "fromHost"), $x))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(
              Call(
                Member($api, "call"),
                "MutableSet",
                Call(
                  Member(Member($api, "cells"), "allocate"),
                  Call($list, Map(Concat(New($Set, Map(Call($items, Index($v, 0)), $host))), $back)))))))))),
  Realization(NewSet(), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($list, Lambda(List($xs), Call(Member($api, "call"), "List", Spread($xs)))),
            Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
            Return(
              Call(
                Member($api, "call"),
                "MutableSet",
                Call(Member(Member($api, "cells"), "allocate"), Call($list, List()))))))))))

// An empty map that can change, from keys to values.
Concept(NewMap(),
