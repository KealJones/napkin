Requires(Core())

// ================================================================
// From src/seed/code-ir.ts
//
// The code IR as Concepts that run (ir-spec Part 10.2), so a realization can be written in
// Concepts instead of as a JavaScript string.
//
// Each primitive is one small `Code(...)` body: the only JavaScript left is here, and a
// realization composed from these is data the graph can read, compare, and one day have a
// Rust host run with nothing but these primitives rewritten. Substitution is the binding
// rule, as `Bind` already does: a `Lambda`'s parameters are replaced by the values it is
// called with, then the body is evaluated.

// One primitive: a pattern, a body, and whether its arguments are evaluated first.
// A list literal is its elements' values, as an array literal is: List(Arg(e, 0)) is the
// argument, not the expression that would find it.
Concept(List(),
  Realization(List(Rest($xs)), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Object(head="List", args=Map($args, Lambda(List($a), Object(value=Member($a, "value")))))))))

Concept(Call(),
  IsA(CodePrimitive()),
  Realization(Call($f, Rest($args)), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(
              $truthy,
              Lambda(
                List($v),
                Or(Equals($v, true), And(Call($isCall, $v), Equals(Member($v, "head"), "True"))))),
            Bind(
              $isTruth,
              Lambda(
                List($v),
                Or(
                  Equals(TypeOf($v), "boolean"),
                  And(
                    And(
                      Call($isCall, $v),
                      Or(Equals(Member($v, "head"), "True"), Equals(Member($v, "head"), "False"))),
                    Not(Length(Member($v, "args"))))))),
            Bind($bool, Lambda(List($b), Call(Member($api, "call"), If($b, "True", "False")))),
            Bind(
              $items,
              Lambda(
                List($v),
                If(
                  And(Call($isCall, $v), Equals(Member($v, "head"), "List")),
                  Map(Member($v, "args"), Lambda(List($a), Member($a, "value"))),
                  List()))),
            Bind(
              $list,
              Lambda(
                List($xs),
                Object(head="List", args=Map($xs, Lambda(List($value), Object(value=$value)))))),
            Bind(
              $apply,
              Async(
                Lambda(
                  List($f, $values),
                  Sequence(
                    If(
                      Or(Not(Call($isCall, $f)), NotEquals(Member($f, "head"), "Lambda")),
                      Return(Call(Member($api, "call"), "Call", $f, Spread($values))),
                      Undefined()),
                    Bind(
                      $params,
                      Map(
                        Call($items, OptionalMember(Index(Member($f, "args"), 0), "value")),
                        Lambda(List($p), And($p, Member($p, "variable"))))),
                    Bind(
                      $bound,
                      New(
                        $Map,
                        Call(
                          Member($params, "map"),
                          Lambda(List($p, $i), List($p, Index($values, $i)))))),
                    Return(
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "substitute"),
                            Member(Index(Member($f, "args"), 1), "value"),
                            $bound)))))))),
            Bind($v, Lambda(List($i), OptionalMember(Index($args, $i), "value"))),
            Return(
              Await(
                Call(
                  $apply,
                  Call($v, 0),
                  Map(Call(Member($args, "slice"), 1), Lambda(List($a), Member($a, "value"))))))))))))

// Logic. Not, And and Or are words a message says too ("don't", "apples and pears"),
// so they only compute over truth values and otherwise stay as said. And and Or stop at
// the first answer, so their arguments are not evaluated first.
Concept(Equals(),
  IsA(CodePrimitive()),
  Realization(Equals($a, $b), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(
              $truthy,
              Lambda(
                List($v),
                Or(Equals($v, true), And(Call($isCall, $v), Equals(Member($v, "head"), "True"))))),
            Bind(
              $isTruth,
              Lambda(
                List($v),
                Or(
                  Equals(TypeOf($v), "boolean"),
                  And(
                    And(
                      Call($isCall, $v),
                      Or(Equals(Member($v, "head"), "True"), Equals(Member($v, "head"), "False"))),
                    Not(Length(Member($v, "args"))))))),
            Bind($bool, Lambda(List($b), Call(Member($api, "call"), If($b, "True", "False")))),
            Bind(
              $items,
              Lambda(
                List($v),
                If(
                  And(Call($isCall, $v), Equals(Member($v, "head"), "List")),
                  Map(Member($v, "args"), Lambda(List($a), Member($a, "value"))),
                  List()))),
            Bind(
              $list,
              Lambda(
                List($xs),
                Object(head="List", args=Map($xs, Lambda(List($value), Object(value=$value)))))),
            Bind(
              $apply,
              Async(
                Lambda(
                  List($f, $values),
                  Sequence(
                    If(
                      Or(Not(Call($isCall, $f)), NotEquals(Member($f, "head"), "Lambda")),
                      Return(Call(Member($api, "call"), "Call", $f, Spread($values))),
                      Undefined()),
                    Bind(
                      $params,
                      Map(
                        Call($items, OptionalMember(Index(Member($f, "args"), 0), "value")),
                        Lambda(List($p), And($p, Member($p, "variable"))))),
                    Bind(
                      $bound,
                      New(
                        $Map,
                        Call(
                          Member($params, "map"),
                          Lambda(List($p, $i), List($p, Index($values, $i)))))),
                    Return(
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "substitute"),
                            Member(Index(Member($f, "args"), 1), "value"),
                            $bound)))))))),
            Bind($v, Lambda(List($i), OptionalMember(Index($args, $i), "value"))),
            Return(
              Call(
                $bool,
                Equals(
                  Call(Member($api, "format"), Call($v, 0)),
                  Call(Member($api, "format"), Call($v, 1)))))))))))

