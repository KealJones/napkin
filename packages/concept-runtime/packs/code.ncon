Concept(Compiled(), IsA(ContextFacet()))

Concept(CodePrimitive(), IsA(Category()))

// A function value: stays as it is until called.
Concept(Lambda(), IsA(Marker()))

// ================================================================
// JavaScript's own meaning, for bodies lowered from it (code/lower.ts, ir-spec Part 10.8).
// A lowered body keeps what its JavaScript meant: truthiness where every object is true,
// === and + as JavaScript has them, comparisons that answer true and false, and Undefined()
// wherever JavaScript would have undefined. The IR's own Equals and GreaterThan answer
// True() and False(), which is right for an answer and wrong for a condition.

// JavaScript's truthiness: false, null, undefined, 0, NaN and the empty string are false, and every object is true, False() included.
Concept(Truthy(),
  IsA(CodePrimitive()),
  Realization(Truthy($x), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($v, Member(Index($args, 0), "value")),
          If(
            Or(
              Or(Or(Or(Equals($v, false), Equals($v, null)), Equals($v, 0)), Equals($v, "")),
              Call(Member($Number, "isNaN"), $v)),
            Return(false),
            Undefined()),
          Return(
            Not(
              And(
                And(Equals(TypeOf($v), "object"), Equals(Member($v, "head"), "Undefined")),
                Equals(Length(Member($v, "args")), 0)))))))))

// !x.
Concept(Falsy(),
  IsA(CodePrimitive()),
  Realization(Falsy($x), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($v, Member(Index($args, 0), "value")),
          If(
            Or(
              Or(Or(Or(Equals($v, false), Equals($v, null)), Equals($v, 0)), Equals($v, "")),
              Call(Member($Number, "isNaN"), $v)),
            Return(true),
            Undefined()),
          Return(
            And(
              And(Equals(TypeOf($v), "object"), Equals(Member($v, "head"), "Undefined")),
              Equals(Length(Member($v, "args")), 0))))))))

// a === b, answering true or false. Two Concepts are identical when they are the same expression.
Concept(Identical(),
  IsA(CodePrimitive()),
  Realization(Identical($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind($obj, Lambda(List($v), And(Equals(TypeOf($v), "object"), NotEquals($v, null)))),
          Bind(List($a, $b), Map($args, Lambda(List($x), Member($x, "value")))),
          Return(
            If(
              And(Call($obj, $a), Call($obj, $b)),
              Equals(Call(Member($api, "format"), $a), Call(Member($api, "format"), $b)),
              Equals($a, $b))))))))

// a !== b.
Concept(NotIdentical(),
  IsA(CodePrimitive()),
  Realization(NotIdentical($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind($obj, Lambda(List($v), And(Equals(TypeOf($v), "object"), NotEquals($v, null)))),
          Bind(List($a, $b), Map($args, Lambda(List($x), Member($x, "value")))),
          Return(
            If(
              And(Call($obj, $a), Call($obj, $b)),
              NotEquals(Call(Member($api, "format"), $a), Call(Member($api, "format"), $b)),
              NotEquals($a, $b))))))))

// a == b: null and undefined are loosely equal to each other and nothing else.
Concept(LooseEquals(),
  IsA(CodePrimitive()),
  Realization(LooseEquals($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind(
            $nullish,
            Lambda(
              List($v),
              Or(
                Or(Equals($v, null), Equals($v, Undefined())),
                And(
                  And(Equals(TypeOf($v), "object"), Equals(Member($v, "head"), "Undefined")),
                  Equals(Length(Member($v, "args")), 0))))),
          Bind($obj, Lambda(List($v), And(Equals(TypeOf($v), "object"), NotEquals($v, null)))),
          Bind(List($a, $b), Map($args, Lambda(List($x), Member($x, "value")))),
          If(
            Or(Call($nullish, $a), Call($nullish, $b)),
            Return(And(Call($nullish, $a), Call($nullish, $b))),
            Undefined()),
          Return(
            If(
              And(Call($obj, $a), Call($obj, $b)),
              Equals(Call(Member($api, "format"), $a), Call(Member($api, "format"), $b)),
              LooseEquals($a, $b))))))))

// a != b.
Concept(LooseNotEquals(),
  IsA(CodePrimitive()),
  Realization(LooseNotEquals($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind(
            $nullish,
            Lambda(
              List($v),
              Or(
                Or(Equals($v, null), Equals($v, Undefined())),
                And(
                  And(Equals(TypeOf($v), "object"), Equals(Member($v, "head"), "Undefined")),
                  Equals(Length(Member($v, "args")), 0))))),
          Bind($obj, Lambda(List($v), And(Equals(TypeOf($v), "object"), NotEquals($v, null)))),
          Bind(List($a, $b), Map($args, Lambda(List($x), Member($x, "value")))),
          If(
            Or(Call($nullish, $a), Call($nullish, $b)),
            Return(Not(And(Call($nullish, $a), Call($nullish, $b)))),
            Undefined()),
          Return(
            If(
              And(Call($obj, $a), Call($obj, $b)),
              NotEquals(Call(Member($api, "format"), $a), Call(Member($api, "format"), $b)),
              LooseNotEquals($a, $b))))))))

// a + b: numbers add, and text joins.
Concept(JsPlus(),
  IsA(CodePrimitive()),
  Realization(JsPlus($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind(List($a, $b), Map($args, Lambda(List($x), Member($x, "value")))),
          Return(
            If(
              Or(Equals(TypeOf($a), "string"), Equals(TypeOf($b), "string")),
              Add(Call($String, $a), Call($String, $b)),
              Add($a, $b))))))))

// a - b.
Concept(JsMinus(),
  IsA(CodePrimitive()),
  Realization(JsMinus($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Subtract(Member(Index($args, 0), "value"), Member(Index($args, 1), "value"))))))

// a * b.
Concept(JsTimes(),
  IsA(CodePrimitive()),
  Realization(JsTimes($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Multiply(Member(Index($args, 0), "value"), Member(Index($args, 1), "value"))))))

// a / b.
Concept(JsDivide(),
  IsA(CodePrimitive()),
  Realization(JsDivide($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Divide(Member(Index($args, 0), "value"), Member(Index($args, 1), "value"))))))

// a % b, whose sign follows a.
Concept(JsRemainder(),
  IsA(CodePrimitive()),
  Realization(JsRemainder($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Modulo(Member(Index($args, 0), "value"), Member(Index($args, 1), "value"))))))

// -x.
Concept(JsNegate(),
  IsA(CodePrimitive()),
  Realization(JsNegate($x), context=Execution(),
    body=Code(ir=Lambda(List($args), Negate(Member(Index($args, 0), "value"))))))

// a < b, answering true or false.
Concept(Below(),
  IsA(CodePrimitive()),
  Realization(Below($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        LessThan(Member(Index($args, 0), "value"), Member(Index($args, 1), "value"))))))

// a > b.
Concept(Above(),
  IsA(CodePrimitive()),
  Realization(Above($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        GreaterThan(Member(Index($args, 0), "value"), Member(Index($args, 1), "value"))))))

// a <= b.
Concept(NotAbove(),
  IsA(CodePrimitive()),
  Realization(NotAbove($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        AtMost(Member(Index($args, 0), "value"), Member(Index($args, 1), "value"))))))

// a >= b.
Concept(NotBelow(),
  IsA(CodePrimitive()),
  Realization(NotBelow($a, $b), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        AtLeast(Member(Index($args, 0), "value"), Member(Index($args, 1), "value"))))))

// typeof x, with Undefined() as undefined.
Concept(TypeOf(),
  IsA(CodePrimitive()),
  Realization(TypeOf($x), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($v, Member(Index($args, 0), "value")),
          If(
            And(
              And(
                And(Equals(TypeOf($v), "object"), NotEquals($v, null)),
                Equals(Member($v, "head"), "Undefined")),
              Equals(Length(Member($v, "args")), 0)),
            Return("undefined"),
            Undefined()),
          Return(TypeOf($v)))))))

// key in x. A record answers for its fields; any other Concept for head and args, which is what it is made of.
Concept(HasField(),
  IsA(CodePrimitive()),
  Realization(HasField($key, $x), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($records, New($Set, List("Argument", "Triple", "Stamp", "Mention", "Record"))),
          Bind(List($k, $v), Map($args, Lambda(List($x), Member($x, "value")))),
          If(Or(NotEquals(TypeOf($v), "object"), Equals($v, null)), Return(false), Undefined()),
          If(In("variable", $v), Return(Equals($k, "variable")), Undefined()),
          If(
            Call(Member($records, "has"), Member($v, "head")),
            Return(
              Call(
                Member(Member($v, "args"), "some"),
                Lambda(List($a), Equals(Member($a, "name"), $k)))),
            Undefined()),
          Return(Or(Equals($k, "head"), Equals($k, "args"))))))))

// record.key: the named field, or Undefined() when it has none.
Concept(FieldOf(),
  IsA(CodePrimitive()),
  Realization(FieldOf($record, $key), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind(List($r, $k), Map($args, Lambda(List($x), Member($x, "value")))),
          If(
            Or(Or(NotEquals(TypeOf($r), "object"), Equals($r, null)), Not(In("head", $r))),
            Return(Call(Member($api, "call"), "Undefined")),
            Undefined()),
          Bind(
            $found,
            Call(
              Member(Member($r, "args"), "find"),
              Lambda(List($a), Equals(Member($a, "name"), $k)))),
          Return(
            If(
              Equals($found, Undefined()),
              Call(Member($api, "call"), "Undefined"),
              Member($found, "value"))))))))

// xs[i]: the element, or Undefined() past the end.
Concept(Element(),
  IsA(CodePrimitive()),
  Realization(Element($xs, $i), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind(List($xs, $i), Map($args, Lambda(List($x), Member($x, "value")))),
          If(
            Equals(TypeOf($xs), "string"),
            Return(
              If(
                And(AtLeast($i, 0), LessThan($i, Length($xs))),
                Index($xs, $i),
                Call(Member($api, "call"), "Undefined"))),
            Undefined()),
          If(
            Or(
              Or(NotEquals(TypeOf($xs), "object"), Equals($xs, null)),
              NotEquals(Member($xs, "head"), "List")),
            Return(Call(Member($api, "call"), "Undefined")),
            Undefined()),
          Bind($found, Index(Member($xs, "args"), $i)),
          Return(
            If(
              Equals($found, Undefined()),
              Call(Member($api, "call"), "Undefined"),
              Member($found, "value"))))))))

// e.args: an Argument(name=..., value=...) record for each argument.
Concept(Arguments(),
  IsA(CodePrimitive()),
  Realization(Arguments($e), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind($e, Member(Index($args, 0), "value")),
          If(
            Or(Or(NotEquals(TypeOf($e), "object"), Equals($e, null)), Not(In("head", $e))),
            Return(Call(Member($api, "call"), "Undefined")),
            Undefined()),
          Return(
            Call(
              Member($api, "call"),
              "List",
              Spread(
                Map(
                  Member($e, "args"),
                  Lambda(
                    List($a),
                    If(
                      Equals(Member($a, "name"), Undefined()),
                      Object(
                        head="Argument",
                        args=List(Object(name="value", value=Member($a, "value")))),
                      Object(
                        head="Argument",
                        args=List(
                          Object(name="name", value=Member($a, "name")),
                          Object(name="value", value=Member($a, "value")))))))))))))))

// throw x.
Concept(Throw(),
  IsA(CodePrimitive()),
  Realization(Throw($x), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($v, Member(Index($args, 0), "value")),
          Throw(
            If(
              InstanceOf($v, $Error),
              $v,
              New(
                $Error,
                If(Equals(TypeOf($v), "string"), $v, Call(Member($JSON, "stringify"), $v))))))))))

// ================================================================
// From src/seed/game-primitives.ts
//
// Reusable value operations. None of these primitives knows the rules of a game.

Concept(Quote(),
  IsA(CodePrimitive()),
  Realization(Quote($value), context=Execution(), evaluateArguments=false,
    body=Code(ir=Lambda(List($args), Member(Index($args, 0), "value")))))

Concept(FormatExpression(),
  IsA(CodePrimitive()),
  Realization(FormatExpression($value), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Call(Member($api, "format"), Member(Index($args, 0), "value"))))))
