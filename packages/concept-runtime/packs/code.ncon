        }""")))

Concept(Includes(),
  IsA(CodePrimitive()),
  Realization(Includes($xs, $x), context=Context(JavaScript(), Compiled()),
    body=Text(
      "((xs, x) => B(typeof xs === \"string\" ? typeof x === \"string\" && xs.includes(x) : I(xs).some((i) => F(i) === F(x))))(",
