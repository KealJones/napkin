            Let(
              $apply,
              Async(
                Lambda(
                  List($f, $values),
                  Sequence(
                    If(
                      Or(Not(Call($isCall, $f)), NotEquals(Member($f, "head"), "Lambda")),
                      Return(Call(Member($api, "call"), "Call", $f, Spread($values))),
                      Undefined()),
                    Let(
                      $params,
                      Map(
                        Call($items, OptionalMember(Index(Member($f, "args"), 0), "value")),
                        Lambda(List($p), And($p, Member($p, "variable"))))),
                    Let(
                      $bound,
                      New(
                        $Map,
                        Call(
                          Member($params, "map"),
                          Lambda(List($p, $i), List($p, Index($values, $i)))))),
                    Return(
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "substitute"),
                            Member(Index(Member($f, "args"), 1), "value"),
                            $bound)))))))),
            Let($v, Lambda(List($i), OptionalMember(Index($args, $i), "value"))),
            ForOf(
              $a,
              $args,
              Sequence(
                Let($x, Await(Call(Member($api, "evaluate"), Member($a, "value")))),
                If(
                  Not(Call($isTruth, $x)),
                  Return(
                    Call(
                      Member($api, "call"),
                      "Or",
                      Spread(Map($args, Lambda(List($b), Member($b, "value")))))),
                  Undefined()),
                If(Call($truthy, $x), Return(Call(Member($api, "call"), "True")), Undefined()))),
            Return(Call(Member($api, "call"), "False"))))))))

// Lists, and text where JavaScript's own length and includes read text too.
