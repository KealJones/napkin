                  Call(Member($api, "format"), Call($v, 1)))))))))))

Concept(Not(),
  IsA(CodePrimitive()),
  Realization(Not($x), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(
              $truthy,
              Lambda(
                List($v),
                Or(Equals($v, true), And(Call($isCall, $v), Equals(Member($v, "head"), "True"))))),
            Bind(
              $isTruth,
              Lambda(
                List($v),
                Or(
                  Equals(TypeOf($v), "boolean"),
                  And(
                    And(
                      Call($isCall, $v),
                      Or(Equals(Member($v, "head"), "True"), Equals(Member($v, "head"), "False"))),
                    Not(Length(Member($v, "args"))))))),
            Bind($bool, Lambda(List($b), Call(Member($api, "call"), If($b, "True", "False")))),
            Bind(
              $items,
              Lambda(
                List($v),
                If(
                  And(Call($isCall, $v), Equals(Member($v, "head"), "List")),
                  Map(Member($v, "args"), Lambda(List($a), Member($a, "value"))),
                  List()))),
            Bind(
              $list,
              Lambda(
                List($xs),
                Object(head="List", args=Map($xs, Lambda(List($value), Object(value=$value)))))),
            Bind(
              $apply,
              Async(
                Lambda(
                  List($f, $values),
                  Sequence(
                    If(
                      Or(Not(Call($isCall, $f)), NotEquals(Member($f, "head"), "Lambda")),
                      Return(Call(Member($api, "call"), "Call", $f, Spread($values))),
                      Undefined()),
                    Bind(
                      $params,
                      Map(
                        Call($items, OptionalMember(Index(Member($f, "args"), 0), "value")),
                        Lambda(List($p), And($p, Member($p, "variable"))))),
                    Bind(
                      $bound,
                      New(
                        $Map,
                        Call(
                          Member($params, "map"),
                          Lambda(List($p, $i), List($p, Index($values, $i)))))),
                    Return(
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "substitute"),
                            Member(Index(Member($f, "args"), 1), "value"),
                            $bound)))))))),
            Bind($v, Lambda(List($i), OptionalMember(Index($args, $i), "value"))),
            Bind($x, Call($v, 0)),
            If(Not(Call($isTruth, $x)), Return(Call(Member($api, "call"), "Not", $x)), Undefined()),
            Return(
              If(
                Call($truthy, $x),
                Call(Member($api, "call"), "False"),
                Call(Member($api, "call"), "True")))))))))

Concept(And(),
  IsA(CodePrimitive()),
  Realization(And(Rest($xs)), context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(
              $truthy,
              Lambda(
                List($v),
                Or(Equals($v, true), And(Call($isCall, $v), Equals(Member($v, "head"), "True"))))),
            Bind(
              $isTruth,
              Lambda(
                List($v),
                Or(
                  Equals(TypeOf($v), "boolean"),
                  And(
                    And(
                      Call($isCall, $v),
                      Or(Equals(Member($v, "head"), "True"), Equals(Member($v, "head"), "False"))),
                    Not(Length(Member($v, "args"))))))),
            Bind($bool, Lambda(List($b), Call(Member($api, "call"), If($b, "True", "False")))),
            Bind(
              $items,
              Lambda(
                List($v),
                If(
                  And(Call($isCall, $v), Equals(Member($v, "head"), "List")),
                  Map(Member($v, "args"), Lambda(List($a), Member($a, "value"))),
                  List()))),
            Bind(
              $list,
              Lambda(
                List($xs),
                Object(head="List", args=Map($xs, Lambda(List($value), Object(value=$value)))))),
            Bind(
              $apply,
              Async(
                Lambda(
                  List($f, $values),
                  Sequence(
                    If(
                      Or(Not(Call($isCall, $f)), NotEquals(Member($f, "head"), "Lambda")),
                      Return(Call(Member($api, "call"), "Call", $f, Spread($values))),
                      Undefined()),
                    Bind(
                      $params,
                      Map(
                        Call($items, OptionalMember(Index(Member($f, "args"), 0), "value")),
                        Lambda(List($p), And($p, Member($p, "variable"))))),
                    Bind(
                      $bound,
                      New(
                        $Map,
                        Call(
                          Member($params, "map"),
                          Lambda(List($p, $i), List($p, Index($values, $i)))))),
                    Return(
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "substitute"),
                            Member(Index(Member($f, "args"), 1), "value"),
                            $bound)))))))),
            Bind($v, Lambda(List($i), OptionalMember(Index($args, $i), "value"))),
            ForOf(
              $a,
              $args,
              Sequence(
                Bind($x, Await(Call(Member($api, "evaluate"), Member($a, "value")))),
                If(
                  Not(Call($isTruth, $x)),
                  Return(
                    Call(
                      Member($api, "call"),
                      "And",
                      Spread(Map($args, Lambda(List($b), Member($b, "value")))))),
                  Undefined()),
                If(Not(Call($truthy, $x)), Return(Call(Member($api, "call"), "False")), Undefined()))),
            Return(Call(Member($api, "call"), "True"))))))))

