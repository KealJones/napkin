                  And(Call($isCall, $v), Equals(Member($v, "head"), "List")),
                  Map(Member($v, "args"), Lambda(List($a), Member($a, "value"))),
                  List()))),
            Bind(
              $list,
              Lambda(
                List($xs),
                Object(head="List", args=Map($xs, Lambda(List($value), Object(value=$value)))))),
            Bind(
              $apply,
              Async(
                Lambda(
                  List($f, $values),
                  Sequence(
                    If(
                      Or(Not(Call($isCall, $f)), NotEquals(Member($f, "head"), "Lambda")),
                      Return(Call(Member($api, "call"), "Call", $f, Spread($values))),
                      Undefined()),
                    Bind(
                      $params,
                      Map(
                        Call($items, OptionalMember(Index(Member($f, "args"), 0), "value")),
                        Lambda(List($p), And($p, Member($p, "variable"))))),
                    Bind(
                      $bound,
                      New(
                        $Map,
                        Call(
                          Member($params, "map"),
                          Lambda(List($p, $i), List($p, Index($values, $i)))))),
                    Return(
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "substitute"),
                            Member(Index(Member($f, "args"), 1), "value"),
                            $bound)))))))),
            Bind($v, Lambda(List($i), OptionalMember(Index($args, $i), "value"))),
            Return(
              Object(
                head=Call($String, Call($v, 0)),
                args=Map(Call($items, Call($v, 1)), Lambda(List($value), Object(value=$value)))))))))))

// The store, read. What holds in any context and was not retracted.
Concept(Subjects(),
  IsA(CodePrimitive()),
  Realization(Subjects($predicate, $object), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(
              $truthy,
              Lambda(
                List($v),
                Or(Equals($v, true), And(Call($isCall, $v), Equals(Member($v, "head"), "True"))))),
            Bind(
              $isTruth,
              Lambda(
                List($v),
                Or(
                  Equals(TypeOf($v), "boolean"),
                  And(
                    And(
                      Call($isCall, $v),
                      Or(Equals(Member($v, "head"), "True"), Equals(Member($v, "head"), "False"))),
                    Not(Length(Member($v, "args"))))))),
            Bind($bool, Lambda(List($b), Call(Member($api, "call"), If($b, "True", "False")))),
            Bind(
              $items,
              Lambda(
                List($v),
                If(
                  And(Call($isCall, $v), Equals(Member($v, "head"), "List")),
                  Map(Member($v, "args"), Lambda(List($a), Member($a, "value"))),
                  List()))),
            Bind(
              $list,
              Lambda(
                List($xs),
                Object(head="List", args=Map($xs, Lambda(List($value), Object(value=$value)))))),
            Bind(
              $apply,
              Async(
                Lambda(
                  List($f, $values),
                  Sequence(
                    If(
                      Or(Not(Call($isCall, $f)), NotEquals(Member($f, "head"), "Lambda")),
                      Return(Call(Member($api, "call"), "Call", $f, Spread($values))),
                      Undefined()),
                    Bind(
                      $params,
                      Map(
                        Call($items, OptionalMember(Index(Member($f, "args"), 0), "value")),
                        Lambda(List($p), And($p, Member($p, "variable"))))),
                    Bind(
                      $bound,
                      New(
                        $Map,
                        Call(
                          Member($params, "map"),
                          Lambda(List($p, $i), List($p, Index($values, $i)))))),
                    Return(
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "substitute"),
                            Member(Index(Member($f, "args"), 1), "value"),
                            $bound)))))))),
            Bind($v, Lambda(List($i), OptionalMember(Index($args, $i), "value"))),
            Bind(
              $o,
              If(
                Call($isCall, Call($v, 1)),
                Member(Call($v, 1), "head"),
                Call($String, Call($v, 1)))),
            Return(
              Call(
                $list,
                Map(
                  Filter(
                    Call(Member(Member($api, "store"), "asObject"), $o),
                    Lambda(
                      List($t),
                      And(
                        And(
                          Equals(Member($t, "predicate"), Call($String, Call($v, 0))),
                          Equals(Member($t, "context"), Undefined())),
                        Not(
                          Call(
                            Member(Member($api, "store"), "retracted"),
                            Member($t, "subject"),
                            Member($t, "expr")))))),
                  Lambda(List($t), Call(Member($api, "call"), Member($t, "subject"))))))))))))

Concept(Holds(),
