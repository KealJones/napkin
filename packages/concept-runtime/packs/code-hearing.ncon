)

Concept(Opener(),
  IsA(CodeWord()),
  Realization($word,
    context = Hearing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("A bracket groups what it holds. After a name, the group is what the name takes"),
            Comment("(\"print(x)\", \"for (...)\"); a block belongs to the word that leads what is said before it"),
            Comment("(\"for ... { }\", \"if ...:\" and its indented lines). A group nobody takes is its one thing"),
            Comment("(\"(a + b)\"). The brackets and separators are part of how it is said: absorbed."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member(Member($a, "value"), "args"))
            ),
            Bind($v,
              Lambda(List($k, $i),
                If(
                  And(AtLeast($i, 0), LessThan($i, Length(Index($field, $k)))),
                  Member(Index(Index($field, $k), $i), "value"),
                  Undefined()
                )
              )
            ),
            Bind($is,
              Lambda(List($i, $k),
                And(
                  And(AtLeast($i, 0), LessThan($i, Length(Member($field, "kinds")))),
                  Call(
                    Member(Member(Call($v, "kinds", $i), "args"), "some"),
                    Lambda(List($a), Equals(Member($a, "value"), $k))
                  )
                )
              )
            ),
            Bind($close, Call($v, "pair", $at)),
            If(
              LessThan($close, 0),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($named,
              And(
                And(GreaterThan($at, 0), Call($is, Subtract($at, 1), "Name")),
                Not(Call($v, "infix", Subtract($at, 1)))
              )
            ),
            Bind($owner,
              If(
                Call($v, "block", $at),
                Call($v, "leader", $at),
                If($named, Subtract($at, 1), Negate(1))
              )
            ),
            Comment("The parts between separators; a comment is a part of its own. A separator that"),
            Comment("introduces a block (Python's \":\") is inside a part, not between two."),
            Bind($parts, List()),
            Bind($separators, List()),
            Var($a, Add($at, 1)),
            For(
              Var($k, Add($at, 1)),
              AtMost($k, $close),
              PostIncrement($k),
              Sequence(
                Bind($own, Equals(Call($v, "inside", $k), $at)),
                Bind($comment, And($own, Call($is, $k, "Comment"))),
                Bind($separates, And(And($own, Call($is, $k, "Separator")), Not(Call($v, "block", Add($k, 1))))),
                If(
                  Or(Or(Equals($k, $close), $separates), $comment),
                  Sequence(
                    If(
                      GreaterThan($k, $a),
                      Call(Member($parts, "push"), List($a, $k)),
                      Undefined()
                    ),
                    If(
                      $comment,
                      Call(Member($parts, "push"), List($k, Add($k, 1))),
                      If(
                        LessThan($k, $close),
                        Call(Member($separators, "push"), $k),
                        Undefined()
                      )
                    ),
                    Assign($a, Add($k, 1))
                  ),
                  Undefined()
                ),
                Comment("What another bracket holds is its business: step over it."),
                If(
                  And(
                    And(And(GreaterThan($k, $at), LessThan($k, $close)), GreaterThan(Call($v, "pair", $k), $k)),
                    Equals(Call($v, "inside", $k), $at)
                  ),
                  Assign($k, Subtract(Call($v, "pair", $k), 1)),
                  Undefined()
                )
              )
            ),
            Bind($tops,
              Map(
                $parts,
                Lambda(List(List($x, $y)),
                  Sequence(
                    Bind($found, New($Set)),
                    For(
                      Var($k, $x),
                      LessThan($k, $y),
                      PostIncrement($k),
                      Sequence(
                        If(
                          And(Call($is, $k, "Separator"), LessThan(Call($v, "parent", $k), 0)),
                          Continue(),
                          Undefined()
                        ),
                        Var($t, $k),
                        While(
                          And(AtLeast(Call($v, "parent", $t), $x), LessThan(Call($v, "parent", $t), $y)),
                          Assign($t, Call($v, "parent", $t))
                        ),
                        Call(Member($found, "add"), $t),
                        If(
                          GreaterThan(Member($found, "size"), 1),
                          Break(),
                          Undefined()
                        )
                      )
                    ),
                    Return(Concat($found))
                  )
                )
              )
            ),
            Bind($out, List()),
            Bind($link,
              Lambda(List($from, $to, $role),
                Sequence(
                  If(
                    LessThan(Call($v, "parent", $from), 0),
                    Call(
                      Member($out, "push"),
                      Call(
                        Member($api, "call"),
                        "Link",
                        $from,
                        $to,
                        Call(Member($api, "call"), $role)
                      )
                    ),
                    Undefined()
                  ),
                  Undefined()
                )
              )
            ),
            If(
              AtLeast($owner, 0),
              Sequence(
                Call($link, $at, $owner, "Absorbs"),
                Call($link, $close, $owner, "Absorbs"),
                ForOf($s, $separators, Call($link, $s, $owner, "Absorbs")),
                If(
                  Call(Member($tops, "every"), Lambda(List($t), Equals(Length($t), 1))),
                  ForOf($t, $tops, Call($link, Index($t, 0), $owner, "Takes")),
                  Undefined()
                )
              ),
              If(
                And(And(Not(Call($v, "block", $at)), Equals(Length($tops), 1)), Equals(Length(Index($tops, 0)), 1)),
                Sequence(
                  Call($link, $at, Index(Index($tops, 0), 0), "Absorbs"),
                  Call($link, $close, Index(Index($tops, 0), 0), "Absorbs")
                ),
                Undefined()
              )
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

Concept(Block(), IsA(Opener()), IsA(CodeWord()))

Concept(Closer(), IsA(CodeWord()))

Concept(Separator(), IsA(CodeWord()))

Concept(Else(),
  Realization($word,
    context = Hearing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"else\" goes on from the block before it: it belongs to the word that block belongs to."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member(Member($a, "value"), "args"))
            ),
            Bind($v,
              Lambda(List($k, $i),
                If(
                  And(AtLeast($i, 0), LessThan($i, Length(Index($field, $k)))),
                  Member(Index(Index($field, $k), $i), "value"),
                  Undefined()
                )
              )
            ),
            Bind($is,
              Lambda(List($i, $k),
                And(
                  And(AtLeast($i, 0), LessThan($i, Length(Member($field, "kinds")))),
                  Call(
                    Member(Member(Call($v, "kinds", $i), "args"), "some"),
                    Lambda(List($a), Equals(Member($a, "value"), $k))
                  )
                )
              )
            ),
            Var($p, Subtract($at, 1)),
            While(And(AtLeast($p, 0), Call($is, $p, "Separator")), PostDecrement($p)),
            Bind($opened, If(Call($is, $p, "Closer"), Call($v, "pair", $p), Negate(1))),
            If(
              Or(Or(LessThan($opened, 0), Not(Call($v, "block", $opened))), LessThan(Call($v, "leader", $opened), 0)),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Return(
              Call(
                Member($api, "call"),
                "List",
                Call(
                  Member($api, "call"),
                  "Link",
                  $at,
                  Call($v, "leader", $opened),
                  Call(Member($api, "call"), "Takes")
                )
              )
            )
          )
        )
      )
    )
  ),
  Realization(Else(Rest($xs)),
    context = Context(Code($language), Reading()),
    resultContext = Code(),
    body = Else(Rest($xs))
  )
)

// Operators: symbols spell words, and each binds as tightly as its Binds says.
Concept(Dot(),
  IsA(Infix()),
  Spelled("."),
  Binds(20),
  Realization($word,
    context = Context(Code($language), Reading()),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"a.name\": the member of a by that name; \"a.b(c)\": that member called."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind(List($owner, $member),
              Map(
                Filter(Member($self, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                Lambda(List($a), Member($a, "value"))
              )
            ),
            Bind($of,
              Await(
                Call(
                  Member($api, "evaluate"),
                  $owner,
                  Member($api, "context")
                )
              )
            ),
            If(
              Not(Call($isCall, $member)),
              Return(Call(Member($api, "call"), "Member", $of, $member)),
              Undefined()
            ),
            Bind($said,
              Call(Member(Member($member, "args"), "find"), Lambda(List($a), Equals(Member($a, "name"), "said")))
            ),
            Bind($name,
              If(
                $said,
                Member($said, "value"),
                Add(
                  Call(Member(Index(Member($member, "head"), 0), "toLowerCase")),
                  Call(Member(Member($member, "head"), "slice"), 1)
                )
              )
            ),
            Bind($got, Call(Member($api, "call"), "Member", $of, $name)),
            Bind($values, List()),
            ForOf(
              $a,
              Member($member, "args"),
              If(
                Equals(Member($a, "name"), Undefined()),
                Call(
                  Member($values, "push"),
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Member($a, "value"),
                      Member($api, "context")
                    )
                  )
                ),
                Undefined()
              )
            ),
            Return(
              If(
                Length($values),
                Call(Member($api, "call"), "Call", $got, Spread($values)),
                $got
              )
            )
          )
        )
      )
    )
  )
)

