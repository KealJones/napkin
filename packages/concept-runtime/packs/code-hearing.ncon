// SPIKE (spike/hear-code-words): code heard the way a message is. Each word of the code is
// its own Concept (packs/codewords.ncon). Before the links, each says what it is here under
// Sensing(Code(<language>)); then each hears under Hearing(Code(<language>)): an operator takes
// the things either side of it, a leading word takes what follows, a bracket groups, a block
// belongs to the word that leads it. The heard words then realize, under
// Context(Code(<language>), Reading()), as the code IR (ForOf, Func, If, Call ...), which the
// language packs write out. Bodies written from the JavaScript in scratch/code-hearing by gen.mjs.
Requires(
  Hearing(),
  Code(),
  Python(),
  TypeScript(),
  CodeWords(),
  CodeBinds(),
  CodeReadings()
)

// What a word says about itself, here: Sense(position, Concept).
Concept(Sense(), IsA(Data()))

// "}" closes "{": a bracket and its end.
Concept(Closes(), IsA(LinkRole()))

// Before the links, what each word is here: a word says it under Sensing(), and nothing it does
// elsewhere runs. Quiet, as hearing is.
Concept(Sensing(),
  IsA(ContextFacet()),
  Exclusive(),
  Quiet()
)

// Code heard: what each word is, the links they find in rounds, each word written as its Concept.
Concept(Hear(),
  Realization(Hear($text),
    context = Context(Execution(), Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("Code heard as a message is: each word is its own Concept, and the words find each other in"),
            Comment("rounds. The language is the context (Code(Python())), so a word hears as it does there."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($text, Call($String, Call(Member($api, "toHost"), Member(Index($args, 0), "value")))),
            Bind($facets,
              If(
                And(Call($isCall, Member($api, "context")), Equals(Member(Member($api, "context"), "head"), "Context")),
                Map(Member(Member($api, "context"), "args"), Lambda(List($a), Member($a, "value"))),
                List(Member($api, "context"))
              )
            ),
            Bind($code,
              Call(
                Member($facets, "find"),
                Lambda(List($f), And(Call($isCall, $f), Equals(Member($f, "head"), "Code")))
              )
            ),
            Bind($language, Member(Index(Member($code, "args"), 0), "value")),
            Bind($hearing, Call(Member($api, "call"), "Hearing", $code)),
            Bind($same,
              Lambda(List($a, $b), Equals(Call(Member($api, "format"), $a), Call(Member($api, "format"), $b)))
            ),
            Comment("A relation holds here when it holds everywhere or in this language; this language's wins."),
            Bind($holds,
              Lambda(List($r),
                Or(Equals(Member($r, "context"), Undefined()), Call($same, Member($r, "context"), $code))
              )
            ),
            Bind($claims,
              Lambda(List($identity, $head),
                Sequence(
                  Bind($unit, Call(Member(Member($api, "store"), "get"), $identity)),
                  Bind($found,
                    If(
                      $unit,
                      Filter(
                        Member($unit, "relations"),
                        Lambda(List($r),
                          And(
                            And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), $head)),
                            Call($holds, $r)
                          )
                        )
                      ),
                      List()
                    )
                  ),
                  Return(
                    Map(
                      Concat(
                        Filter($found, Lambda(List($r), NotEquals(Member($r, "context"), Undefined()))),
                        Filter($found, Lambda(List($r), Equals(Member($r, "context"), Undefined())))
                      ),
                      Lambda(List($r), Member($r, "claim"))
                    )
                  )
                )
              )
            ),
            Bind($first,
              Lambda(List($identity, $head),
                Sequence(
                  Bind($c, Index(Call($claims, $identity, $head), 0)),
                  Return(
                    If(
                      And($c, Length(Member($c, "args"))),
                      Member(Index(Member($c, "args"), 0), "value"),
                      If($c, true, Undefined())
                    )
                  )
                )
              )
            ),
            Comment("How the language lays its text out: comments, indentation, templates, regular expressions."),
            Bind($comments,
              FlatMap(
                Call($claims, Member($language, "head"), "Comments"),
                Lambda(List($c), Map(Member($c, "args"), Lambda(List($a), Member($a, "value"))))
              )
            ),
            Bind($offside, GreaterThan(Length(Call($claims, Member($language, "head"), "Offside")), 0)),
            Bind($templates, Call($first, Member($language, "head"), "Templates")),
            Bind($regex, GreaterThan(Length(Call($claims, Member($language, "head"), "RegexLiterals")), 0)),
            Bind($stringPrefixes, GreaterThan(Length(Call($claims, Member($language, "head"), "StringPrefixes")), 0)),
            Comment("A symbol is the word the graph says it spells: \"+\" is Plus."),
            Bind($spelled, New($Map)),
            ForOf(
              $unit,
              Call(Member(Member($api, "store"), "all")),
              ForOf(
                $r,
                Member($unit, "relations"),
                Sequence(
                  If(
                    Or(
                      Or(
                        Not(Call($isCall, Member($r, "claim"))),
                        NotEquals(Member(Member($r, "claim"), "head"), "Spelled")
                      ),
                      Not(Call($holds, $r))
                    ),
                    Continue(),
                    Undefined()
                  ),
                  Bind($s, Member(Index(Member(Member($r, "claim"), "args"), 0), "value")),
                  If(
                    Or(Not(Call(Member($spelled, "has"), $s)), NotEquals(Member($r, "context"), Undefined())),
                    Call(Member($spelled, "set"), $s, Member($unit, "identity")),
                    Undefined()
                  )
                )
              )
            ),
            Comment("Where a \"/\" may begin a regular expression after a name: after the language's words that"),
            Comment("lead or join (\"return /x/\")."),
            Bind($leading, List()),
            ForOf(
              $unit,
              Call(Member(Member($api, "store"), "all")),
              If(
                Call(
                  Member(Member($unit, "relations"), "some"),
                  Lambda(List($r),
                    And(
                      And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), "Keyword")),
                      Call($holds, $r)
                    )
                  )
                ),
                Call(
                  Member($leading, "push"),
                  Add(
                    Call(Member(Index(Member($unit, "identity"), 0), "toLowerCase")),
                    Call(Member(Member($unit, "identity"), "slice"), 1)
                  )
                ),
                Undefined()
              )
            ),
            Bind($said,
              Call(
                Member($api, "codeWords"),
                $text,
                Object(
                  spellings = Concat(Call(Member($spelled, "keys"))),
                  comments = $comments,
                  offside = $offside,
                  templates = $templates,
                  regex = $regex,
                  regexAfter = $leading,
                  stringPrefixes = $stringPrefixes
                )
              )
            ),
            Bind($n, Length($said)),
            Comment("A name is its Concept (\"print\" is Print); layout is a word too (Newline, Indent, Dedent)."),
            Bind($upper, Lambda(List($t), Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1)))),
            Bind($LAYOUT,
              Object(
                newline = "Newline",
                indent = "Indent",
                dedent = "Dedent",
                template = "Template",
                Pair("template-end", "TemplateEnd")
              )
            ),
            Bind($heads,
              Map(
                $said,
                Lambda(List($w),
                  If(
                    Equals(Member($w, "kind"), "name"),
                    Call($upper, Member($w, "text")),
                    If(
                      Equals(Member($w, "kind"), "symbol"),
                      Call(Member($spelled, "get"), Member($w, "text")),
                      Index($LAYOUT, Member($w, "kind"))
                    )
                  )
                )
              )
            ),
            Comment("What the graph knows a word is, as code, here: its kinds."),
            Bind($known, New($Map)),
            Bind($kindsOf,
              Lambda(List($head),
                Sequence(
                  If(
                    Call(Member($known, "has"), $head),
                    Return(Call(Member($known, "get"), $head)),
                    Undefined()
                  ),
                  Bind($out, List()),
                  Bind($seen, New($Set)),
                  Var($frontier, If($head, List($head), List())),
                  While(
                    And(Length($frontier), LessThan(Member($seen, "size"), 32)),
                    Sequence(
                      Bind($next, List()),
                      ForOf(
                        $id,
                        $frontier,
                        Sequence(
                          If(Call(Member($seen, "has"), $id), Continue(), Undefined()),
                          Call(Member($seen, "add"), $id),
                          ForOf(
                            $k,
                            Map(
                              Call($claims, $id, "IsA"),
                              Lambda(List($c), Member(Index(Member($c, "args"), 0), "value"))
                            ),
                            Sequence(
                              If(Not(Call($isCall, $k)), Continue(), Undefined()),
                              If(
                                Call(
                                  Member(Call($claims, Member($k, "head"), "IsA"), "some"),
                                  Lambda(List($x),
                                    And(
                                      Call($isCall, Member(Index(Member($x, "args"), 0), "value")),
                                      Equals(Member(Member(Index(Member($x, "args"), 0), "value"), "head"), "CodeWord")
                                    )
                                  )
                                ),
                                Call(Member($out, "push"), Member($k, "head")),
                                Undefined()
                              ),
                              Call(Member($next, "push"), Member($k, "head"))
                            )
                          )
                        )
                      ),
                      Assign($frontier, $next)
                    )
                  ),
                  Call(Member($known, "set"), $head, $out),
                  Return($out)
                )
              )
            ),
            Bind($SHAPE,
              Object(
                name = "Name",
                number = "Number",
                text = "Text",
                comment = "Comment",
                regex = "Regex"
              )
            ),
            Comment("A name is a word of the language only where the language says it is one (Keyword):"),
            Comment("\"comma\" and \"not\" are names in TypeScript, \"not\" a word in Python."),
            Bind($keyword, Lambda(List($head), GreaterThan(Length(Call($claims, Or($head, ""), "Keyword")), 0))),
            Bind($kinds,
              Call(
                Member($said, "map"),
                Lambda(List($w, $i),
                  Concat(
                    List(Otherwise(Index($SHAPE, Member($w, "kind")), "Symbol")),
                    If(
                      Or(NotEquals(Member($w, "kind"), "name"), Call($keyword, Index($heads, $i))),
                      Call($kindsOf, Index($heads, $i)),
                      List()
                    )
                  )
                )
              )
            ),
            Bind($is, Lambda(List($i, $k), And(And(AtLeast($i, 0), LessThan($i, $n)), Includes(Index($kinds, $i), $k)))),
            Comment("What a word says it is here (Sense): \"<\" after a name is its angles, \"{\" after a signature"),
            Comment("is a block, \"get\" in \"x.get\" is only a name. Its Concept, with only the kinds it has."),
            Bind($saying, New($Set)),
            Comment("Words of the language said only as names here (\"x.get\", \"{ default: 1 }\")."),
            Bind($namedHere, New($Set)),
            Bind($become,
              Lambda(List($i, $head),
                Sequence(
                  Call(Member($saying, "add"), $i),
                  If(
                    Equals($head, "Name"),
                    Sequence(Assign(Index($kinds, $i), List("Name")), Call(Member($namedHere, "add"), $i)),
                    Sequence(
                      Assign(Index($heads, $i), $head),
                      Assign(
                        Index($kinds, $i),
                        Concat(
                          List(Otherwise(Index($SHAPE, Member(Index($said, $i), "kind")), "Symbol")),
                          Call($kindsOf, $head)
                        )
                      )
                    )
                  ),
                  Undefined()
                )
              )
            ),
            Comment("Which brackets pair and which bracket each word is inside, from the links that say what"),
            Comment("closes what (Closes)."),
            Bind($pair, Map($said, Lambda(List(), Negate(1)))),
            Bind($inside, Map($said, Lambda(List(), Negate(1)))),
            Var($links, List()),
            Comment("What closes what is a pairing, not a link: who the closer belongs to is the bracket's to say."),
            Bind($closed, List()),
            Bind($structure,
              Lambda(List(),
                Sequence(
                  Call(Member($pair, "fill"), Negate(1)),
                  Call(Member($inside, "fill"), Negate(1)),
                  ForOf(
                    $l,
                    $closed,
                    Sequence(
                      Assign(Index($pair, Member($l, "from")), Member($l, "to")),
                      Assign(Index($pair, Member($l, "to")), Member($l, "from"))
                    )
                  ),
                  Bind($open, List()),
                  For(
                    Var($i, 0),
                    LessThan($i, $n),
                    PostIncrement($i),
                    Sequence(
                      If(
                        And(AtLeast(Index($pair, $i), 0), LessThan(Index($pair, $i), $i)),
                        Sequence(
                          While(
                            And(Length($open), NotEquals(Index($open, Subtract(Length($open), 1)), Index($pair, $i))),
                            Call(Member($open, "pop"))
                          ),
                          Call(Member($open, "pop")),
                          Assign(
                            Index($inside, $i),
                            If(
                              Length($open),
                              Index($open, Subtract(Length($open), 1)),
                              Negate(1)
                            )
                          ),
                          Continue()
                        ),
                        Undefined()
                      ),
                      Assign(
                        Index($inside, $i),
                        If(
                          Length($open),
                          Index($open, Subtract(Length($open), 1)),
                          Negate(1)
                        )
                      ),
                      If(
                        GreaterThan(Index($pair, $i), $i),
                        Call(Member($open, "push"), $i),
                        Undefined()
                      )
                    )
                  ),
                  Undefined()
                )
              )
            ),
            Comment("What each word sees while hearing, as Concepts. The words as said, once (Prompt). What each"),
            Comment("is, how tightly it holds and what pairs it, as the view's lists, changed where a word says"),
            Comment("what it is in the few sensing rounds; CodeView adds what that makes of the words around"),
            Comment("each. Who took whom changes every linking round: each word's parent, role and the edges of"),
            Comment("the group it heads are lists too, a new one each round with only what moved changed."),
            Bind($bindsOf, New($Map)),
            Bind($tight,
              Lambda(List($head, $which),
                Sequence(
                  If(
                    Not(Call(Member($bindsOf, "has"), $head)),
                    Call(
                      Member($bindsOf, "set"),
                      $head,
                      List(
                        Index(Call($claims, Or($head, ""), "Binds"), 0),
                        Index(Call($claims, Or($head, ""), "BindsAfter"), 0)
                      )
                    ),
                    Undefined()
                  ),
                  Return(Index(Call(Member($bindsOf, "get"), $head), $which))
                )
              )
            ),
            Bind($promptCell,
              Call(
                Member(Member($api, "cells"), "allocate"),
                Call(
                  Member($api, "call"),
                  "Prompt",
                  Spread(
                    Call(
                      Member($said, "map"),
                      Lambda(List($w, $i),
                        Call(
                          Member($api, "call"),
                          "Word",
                          Member($w, "text"),
                          $i,
                          Call(Member($api, "call"), "List")
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($linksCell, Call(Member(Member($api, "cells"), "allocate"), Call(Member($api, "call"), "List"))),
            Bind($viewCell, Call(Member(Member($api, "cells"), "allocate"), Call(Member($api, "call"), "List"))),
            Bind($parent, Call(Member(New($Array, $n), "fill"), Negate(1))),
            Bind($lo, Concat(Call(Member(Call($Array, $n), "keys")))),
            Bind($hi, Concat(Call(Member(Call($Array, $n), "keys")))),
            Bind($b, Lambda(List($h), Call($tight, $h, 0))),
            Bind($a, Lambda(List($h), Call($tight, $h, 1))),
            Bind($entry,
              Object(
                kinds = Lambda(List($i),
                  Call(
                    Member($api, "call"),
                    "List",
                    Spread(Index($kinds, $i))
                  )
                ),
                heads = Lambda(List($i), Otherwise(Index($heads, $i), null)),
                binds = Lambda(List($i),
                  If(
                    Call($b, Index($heads, $i)),
                    Member(Index(Member(Call($b, Index($heads, $i)), "args"), 0), "value"),
                    null
                  )
                ),
                after = Lambda(List($i),
                  If(
                    Call($a, Index($heads, $i)),
                    Member(Index(Member(Call($a, Index($heads, $i)), "args"), 0), "value"),
                    If(
                      Call($b, Index($heads, $i)),
                      Member(Index(Member(Call($b, Index($heads, $i)), "args"), 0), "value"),
                      null
                    )
                  )
                ),
                right = Lambda(List($i),
                  If(
                    Call($b, Index($heads, $i)),
                    GreaterThan(Length(Member(Call($b, Index($heads, $i)), "args")), 1),
                    false
                  )
                ),
                pair = Lambda(List($i), Index($pair, $i)),
                inside = Lambda(List($i), Index($inside, $i))
              )
            ),
            Bind($lists,
              Object(
                parent = Call(Member(Member($api, "lists"), "of"), $parent),
                role = Call(Member(Member($api, "lists"), "of"), Map($said, Lambda(List(), ""))),
                lo = Call(Member(Member($api, "lists"), "of"), $lo),
                hi = Call(Member(Member($api, "lists"), "of"), $hi)
              )
            ),
            Var($seen, Undefined()),
            Comment("The view with these of its lists as they are now."),
            Bind($show,
              Lambda(List($view, $names),
                Call(
                  Member(Member($api, "cells"), "write"),
                  $viewCell,
                  Object(
                    head = "Record",
                    args = Map(
                      Member($view, "args"),
                      Lambda(List($x),
                        If(
                          Includes($names, Member($x, "name")),
                          Object(name = Member($x, "name"), value = Index($lists, Member($x, "name"))),
                          $x
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($refresh,
              Async(
                Lambda(List(),
                  Sequence(
                    Call($structure),
                    ForOf(
                      List($k, $f),
                      Call(Member($Object, "entries"), $entry),
                      If(
                        Not($seen),
                        Assign(
                          Index($lists, $k),
                          Call(
                            Member(Member($api, "lists"), "of"),
                            Call(Member($said, "map"), Lambda(List($_, $i), Call($f, $i)))
                          )
                        ),
                        Sequence(
                          Bind($moved,
                            If(
                              Or(Equals($k, "pair"), Equals($k, "inside")),
                              Filter(
                                Call(Member($said, "map"), Lambda(List($_, $i), $i)),
                                Lambda(List($i),
                                  NotEquals(
                                    Call(
                                      Member(Member($api, "lists"), "at"),
                                      Index($lists, $k),
                                      $i
                                    ),
                                    Call($f, $i)
                                  )
                                )
                              ),
                              Concat($saying)
                            )
                          ),
                          Assign(
                            Index($lists, $k),
                            Call(
                              Member(Member($api, "lists"), "with"),
                              Index($lists, $k),
                              Map($moved, Lambda(List($i), List($i, Call($f, $i))))
                            )
                          )
                        )
                      )
                    ),
                    Call(Member($saying, "clear")),
                    Assign($seen, true),
                    Call(
                      Member(Member($api, "cells"), "write"),
                      $viewCell,
                      Object(
                        head = "Record",
                        args = Map(
                          Call(Member($Object, "keys"), $lists),
                          Lambda(List($name), Object(name = $name, value = Index($lists, $name)))
                        )
                      )
                    ),
                    Comment(
                      "What CodeView makes of the words is its own lists; the view keeps them until it is asked again."
                    ),
                    Call(
                      Member(Member($api, "cells"), "write"),
                      $viewCell,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "CodeView", $viewCell),
                          $hearing
                        )
                      )
                    ),
                    Undefined()
                  )
                )
              )
            ),
            Comment("First, what each word is here. A word says it (Sense, about itself only: \"<\" after a name"),
            Comment("is its angles, \"{\" after a signature a block, \"x.get\"'s \"get\" only a name), and a bracket"),
            Comment("finds what closes it (Closes), each as its Concept does under Sensing(Code(<language>))."),
            Comment("A word says what it can at once; one that will know more once more brackets have closed"),
            Comment("says it waits (Waits) and is asked again. Rounds until no word says anything new."),
            Bind($sensing, Call(Member($api, "call"), "Sensing", $code)),
            Bind($onlyName,
              Lambda(List($i), And(Equals(Length(Index($kinds, $i)), 1), Equals(Index(Index($kinds, $i), 0), "Name")))
            ),
            Var(
              $asking,
              Filter(
                Call(Member($said, "map"), Lambda(List($_, $i), $i)),
                Lambda(List($i), And(Index($heads, $i), Not(Call($onlyName, $i))))
              )
            ),
            Var($rounds, 0),
            For(
              Var($round, 0),
              And(LessThan($round, 12), Length($asking)),
              PostIncrement($round),
              Sequence(
                PostIncrement($rounds),
                Await(Call($refresh)),
                Bind($still, List()),
                Var($news, 0),
                Bind($closes, List()),
                ForOf(
                  $i,
                  $asking,
                  Sequence(
                    If(
                      And(AtLeast(Index($pair, $i), 0), LessThan(Index($pair, $i), $i)),
                      Continue(),
                      Undefined()
                    ),
                    Bind($said2,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "call"),
                            Index($heads, $i),
                            $promptCell,
                            $i,
                            $linksCell,
                            $viewCell
                          ),
                          $sensing
                        )
                      )
                    ),
                    If(
                      Or(Not(Call($isCall, $said2)), NotEquals(Member($said2, "head"), "List")),
                      Continue(),
                      Undefined()
                    ),
                    ForOf(
                      $a,
                      Member($said2, "args"),
                      Sequence(
                        Bind($p, Member($a, "value")),
                        Comment("It will know more once more brackets have closed: ask it again."),
                        If(
                          And(Call($isCall, $p), Equals(Member($p, "head"), "Waits")),
                          Call(Member($still, "push"), $i),
                          Undefined()
                        ),
                        If(
                          And(
                            And(Call($isCall, $p), Equals(Member($p, "head"), "Link")),
                            Equals(Member(Member(Index(Member($p, "args"), 2), "value"), "head"), "Closes")
                          ),
                          Call(
                            Member($closes, "push"),
                            Object(
                              from = Member(Index(Member($p, "args"), 0), "value"),
                              to = Member(Index(Member($p, "args"), 1), "value"),
                              role = "Closes"
                            )
                          ),
                          If(
                            And(
                              And(
                                And(Call($isCall, $p), Equals(Member($p, "head"), "Sense")),
                                Equals(Member(Index(Member($p, "args"), 0), "value"), $i)
                              ),
                              Call($isCall, Member(Index(Member($p, "args"), 1), "value"))
                            ),
                            Sequence(
                              Bind($h2, Member(Member(Index(Member($p, "args"), 1), "value"), "head")),
                              If(
                                If(
                                  Equals($h2, "Name"),
                                  Call($onlyName, $i),
                                  Equals(Index($heads, $i), $h2)
                                ),
                                Continue(),
                                Undefined()
                              ),
                              Call($become, $i, $h2),
                              PostIncrement($news)
                            ),
                            Undefined()
                          )
                        )
                      )
                    )
                  )
                ),
                ForOf(
                  $c,
                  $closes,
                  Sequence(
                    If(
                      Or(
                        Or(AtLeast(Index($pair, Member($c, "from")), 0), AtLeast(Index($pair, Member($c, "to")), 0)),
                        Equals(Member($c, "from"), Member($c, "to"))
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Assign(Index($pair, Member($c, "to")), Member($c, "from")),
                    Assign(Index($pair, Member($c, "from")), Member($c, "to")),
                    Call(Member($closed, "push"), $c),
                    PostIncrement($news)
                  )
                ),
                If(Not($news), Break(), Undefined()),
                Assign($asking, Filter($still, Lambda(List($i), Not(Call($onlyName, $i)))))
              )
            ),
            Comment("Then the links: rounds until nothing changes. Each word hears as its Concept does under"),
            Comment("Hearing(Code(<language>)) and answers with the links it proposes, seeing the words through"),
            Comment("the view, handed over by reference, so a word's hearing costs what it looks at, not the"),
            Comment("length of the code. What the words are no longer changes; who took whom is written into"),
            Comment("the cells as links are made. A word with no hearing of its own (it answered with itself)"),
            Comment("is not asked again, and a word is asked again only where a link was just made: beside a"),
            Comment("group whose edges moved, or in a bracket that just gained one."),
            Await(Call($refresh)),
            Bind($RANK, Object(Absorbs = 1, Takes = 2)),
            Bind($deaf, New($Set)),
            Var($dirty, New($Set, Call(Member($said, "map"), Lambda(List($_, $i), $i)))),
            For(
              Var($round, 0),
              And(LessThan($round, Add($n, 2)), Member($dirty, "size")),
              PostIncrement($round),
              Sequence(
                PostIncrement($rounds),
                Bind($proposals, List()),
                ForOf(
                  $i,
                  Call(Member(Concat($dirty), "sort"), Lambda(List($a, $b), Subtract($a, $b))),
                  Sequence(
                    Comment("A word that closes a bracket is part of how the bracket is said."),
                    If(
                      Or(
                        Or(Or(Not(Index($heads, $i)), Call(Member($deaf, "has"), $i)), Call($onlyName, $i)),
                        And(AtLeast(Index($pair, $i), 0), LessThan(Index($pair, $i), $i))
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Bind($proposed,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "call"),
                            Index($heads, $i),
                            $promptCell,
                            $i,
                            $linksCell,
                            $viewCell
                          ),
                          $hearing
                        )
                      )
                    ),
                    If(
                      Or(Not(Call($isCall, $proposed)), NotEquals(Member($proposed, "head"), "List")),
                      Sequence(Call(Member($deaf, "add"), $i), Continue()),
                      Undefined()
                    ),
                    ForOf(
                      $a,
                      Member($proposed, "args"),
                      Sequence(
                        Bind($p, Member($a, "value")),
                        If(
                          Or(Not(Call($isCall, $p)), NotEquals(Member($p, "head"), "Link")),
                          Continue(),
                          Undefined()
                        ),
                        Call(
                          Member($proposals, "push"),
                          Object(
                            from = Member(Index(Member($p, "args"), 0), "value"),
                            to = Member(Index(Member($p, "args"), 1), "value"),
                            role = Member(Member(Index(Member($p, "args"), 2), "value"), "head")
                          )
                        )
                      )
                    )
                  )
                ),
                Call(
                  Member($proposals, "sort"),
                  Lambda(List($a, $b),
                    Subtract(
                      Otherwise(Index($RANK, Member($a, "role")), 3),
                      Otherwise(Index($RANK, Member($b, "role")), 3)
                    )
                  )
                ),
                Bind($above,
                  Lambda(List($i, $j),
                    Sequence(
                      For(
                        Sequence(Var($k, $i), Var($g, 0)),
                        And(AtLeast($k, 0), LessThan($g, $n)),
                        Sequence(Assign($k, Index($parent, $k)), PostIncrement($g)),
                        If(Equals($k, $j), Return(true), Undefined())
                      ),
                      Return(false)
                    )
                  )
                ),
                Bind($accepted, List()),
                Bind($moved,
                  Object(
                    parent = New($Map),
                    role = New($Map),
                    lo = New($Map),
                    hi = New($Map)
                  )
                ),
                ForOf(
                  $p,
                  $proposals,
                  Sequence(
                    If(
                      Or(
                        Or(AtLeast(Index($parent, Member($p, "from")), 0), Equals(Member($p, "from"), Member($p, "to"))),
                        Call($above, Member($p, "to"), Member($p, "from"))
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Call(Member($accepted, "push"), $p),
                    Assign(Index($parent, Member($p, "from")), Member($p, "to")),
                    Call(
                      Member(Member($moved, "parent"), "set"),
                      Member($p, "from"),
                      Member($p, "to")
                    ),
                    Call(
                      Member(Member($moved, "role"), "set"),
                      Member($p, "from"),
                      Member($p, "role")
                    )
                  )
                ),
                Comment("A waiting word waits on the edges of the groups beside it, or on its bracket's parts."),
                Bind($next, New($Set)),
                Bind($touch,
                  Lambda(List($i),
                    Sequence(
                      If(
                        And(AtLeast($i, 0), LessThan($i, $n)),
                        Call(Member($next, "add"), $i),
                        Undefined()
                      ),
                      Undefined()
                    )
                  )
                ),
                ForOf(
                  $p,
                  $accepted,
                  Sequence(
                    Call($touch, Member($p, "from")),
                    Call($touch, Index($inside, Member($p, "from"))),
                    For(
                      Sequence(Var($k, Member($p, "to")), Var($g, 0)),
                      And(AtLeast($k, 0), LessThan($g, $n)),
                      Sequence(Assign($k, Index($parent, $k)), PostIncrement($g)),
                      Sequence(
                        Assign(
                          Index($lo, $k),
                          Call(
                            Member($Math, "min"),
                            Index($lo, $k),
                            Index($lo, Member($p, "from"))
                          )
                        ),
                        Assign(
                          Index($hi, $k),
                          Call(
                            Member($Math, "max"),
                            Index($hi, $k),
                            Index($hi, Member($p, "from"))
                          )
                        ),
                        Call(
                          Member(Member($moved, "lo"), "set"),
                          $k,
                          Index($lo, $k)
                        ),
                        Call(
                          Member(Member($moved, "hi"), "set"),
                          $k,
                          Index($hi, $k)
                        ),
                        Call($touch, $k),
                        Call($touch, Subtract(Index($lo, $k), 1)),
                        Call($touch, Add(Index($hi, $k), 1)),
                        Call($touch, Index($inside, $k)),
                        If(
                          AtLeast(Index($pair, Add(Index($hi, $k), 1)), 0),
                          Call($touch, Index($pair, Add(Index($hi, $k), 1))),
                          Undefined()
                        ),
                        If(
                          And(GreaterThan(Index($lo, $k), 0), AtLeast(Index($pair, Subtract(Index($lo, $k), 1)), 0)),
                          Call($touch, Index($pair, Subtract(Index($lo, $k), 1))),
                          Undefined()
                        ),
                        If(
                          And(GreaterThan(Index($lo, $k), 0), AtLeast(Index($parent, Subtract(Index($lo, $k), 1)), 0)),
                          Call($touch, Index($parent, Subtract(Index($lo, $k), 1))),
                          Undefined()
                        ),
                        Comment("What goes on from it past a separator (\"...; else\")."),
                        For(
                          Var($j, Add(Index($hi, $k), 1)),
                          And(LessThan($j, $n), AtMost($j, Add(Index($hi, $k), 3))),
                          PostIncrement($j),
                          Sequence(
                            Call($touch, $j),
                            If(
                              Not(Includes(Index($kinds, $j), "Separator")),
                              Break(),
                              Undefined()
                            )
                          )
                        )
                      )
                    )
                  )
                ),
                ForOf(
                  $k,
                  Call(Member($Object, "keys"), $moved),
                  Assign(
                    Index($lists, $k),
                    Call(
                      Member(Member($api, "lists"), "with"),
                      Index($lists, $k),
                      Index($moved, $k)
                    )
                  )
                ),
                Call(
                  $show,
                  Call(Member(Member($api, "cells"), "read"), $viewCell),
                  Call(Member($Object, "keys"), $moved)
                ),
                Assign($links, Call(Member($links, "concat"), $accepted)),
                Assign($dirty, $next)
              )
            ),
            Comment("Each word written as its Concept, the words it took as its arguments, in the order said."),
            Comment(
              "A name is Identifier(\"as written\", what it took...); an operator said after the one thing it holds says so: Increment(X(), after=true)."
            ),
            Bind($children, Map($said, Lambda(List(), List()))),
            ForOf(
              $l,
              Call(
                Member(Concat($links), "sort"),
                Lambda(List($a, $b), Subtract(Member($a, "from"), Member($b, "from")))
              ),
              If(
                NotEquals(Member($l, "role"), "Absorbs"),
                Call(Member(Index($children, Member($l, "to")), "push"), Member($l, "from")),
                Undefined()
              )
            ),
            Bind($build,
              Lambda(List($i),
                Sequence(
                  Bind($kids, Map(Index($children, $i), Lambda(List($j), Object(value = Call($build, $j))))),
                  Bind($w, Index($said, $i)),
                  If(
                    Equals(Member($w, "kind"), "number"),
                    Return(
                      If(
                        Equals(Call($String, Call($Number, Member($w, "text"))), Member($w, "text")),
                        Call($Number, Member($w, "text")),
                        Call(Member($api, "call"), "Numeral", Member($w, "text"))
                      )
                    ),
                    Undefined()
                  ),
                  If(
                    Equals(Member($w, "kind"), "text"),
                    Return(Member($w, "value")),
                    Undefined()
                  ),
                  If(
                    Equals(Member($w, "kind"), "regex"),
                    Return(
                      Call(
                        Member($api, "call"),
                        "Regex",
                        Member($w, "value"),
                        Member($w, "flags")
                      )
                    ),
                    Undefined()
                  ),
                  If(
                    Equals(Member($w, "kind"), "comment"),
                    Return(Call(Member($api, "call"), "Comment", Member($w, "value"))),
                    Undefined()
                  ),
                  If(
                    Not(Index($heads, $i)),
                    Return(Call(Member($api, "call"), "Symbol", Member($w, "text"))),
                    Undefined()
                  ),
                  Comment("A name that is not one of the language's words is an identifier, as written: what it"),
                  Comment("names is reading's to work out, never a Concept that happens to share its spelling."),
                  If(
                    And(
                      Equals(Member($w, "kind"), "name"),
                      Or(Not(Call($keyword, Index($heads, $i))), Call(Member($namedHere, "has"), $i))
                    ),
                    Return(Object(head = "Identifier", args = Concat(List(Object(value = Member($w, "text"))), $kids))),
                    Undefined()
                  ),
                  If(
                    And(
                      And(Or(Call($is, $i, "Infix"), Call($is, $i, "Prefix")), Equals(Length(Index($children, $i)), 1)),
                      LessThan(Index(Index($children, $i), 0), $i)
                    ),
                    Call(Member($kids, "push"), Object(name = "after", value = true)),
                    Undefined()
                  ),
                  Return(Object(head = If(Call($is, $i, "Scope"), "Block", Index($heads, $i)), args = $kids))
                )
              )
            ),
            Comment("What stands alone is heard; punctuation nobody took adds nothing."),
            Bind($PUNCTUATION, List("Closer", "Separator")),
            Bind($roots, List()),
            For(
              Var($i, 0),
              LessThan($i, $n),
              PostIncrement($i),
              If(
                And(
                  LessThan(Index($parent, $i), 0),
                  Not(Call(Member($PUNCTUATION, "some"), Lambda(List($k), Includes(Index($kinds, $i), $k))))
                ),
                Call(Member($roots, "push"), Object(value = Call($build, $i))),
                Undefined()
              )
            ),
            Return(Object(head = "Phrases", args = Concat($roots, List(Object(name = "rounds", value = $rounds)))))
          )
        )
      )
    )
  )
)

// What a word hearing code sees: the kinds around it and the groups the links have made.
Concept(CodeView(),
  Realization(CodeView($view),
    context = Hearing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("What a word hearing code needs to see: what each word is, and what the links so far make"),
            Comment("of the words around it (where each group of words starts and ends)."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Comment("Reads what each word is from the view hear.js keeps (each field a list, one entry a word),"),
            Comment("and gives it back with what that makes of the words around each added."),
            Bind($view, Call(Member(Member($api, "cells"), "read"), Member(Index($args, 0), "value"))),
            Bind($field, Object()),
            ForOf(
              $a,
              Member($view, "args"),
              Assign(
                Index($field, Member($a, "name")),
                Call(Member(Member($api, "lists"), "values"), Member($a, "value"))
              )
            ),
            Bind($n, Length(Member($field, "heads"))),
            Bind($kinds,
              Map(
                Member($field, "kinds"),
                Lambda(List($k), Map(Member($k, "args"), Lambda(List($a), Member($a, "value"))))
              )
            ),
            Bind(Object(binds = $binds, after = $after, right = $right, pair = $pair, inside = $inside),
              $field
            ),
            Comment("The words whose kinds this changes, and only those, get a new list of kinds."),
            Bind($changed, New($Map)),
            Comment("A word that closes a bracket (\"a ? b : c\", \"A<T>\") is only that bracket's end."),
            For(
              Var($i, 0),
              LessThan($i, $n),
              PostIncrement($i),
              If(
                And(
                  And(AtLeast(Index($pair, $i), 0), LessThan(Index($pair, $i), $i)),
                  Not(Includes(Index($kinds, $i), "Closer"))
                ),
                Sequence(
                  Assign(
                    Index($kinds, $i),
                    Concat(
                      Filter(
                        Index($kinds, $i),
                        Lambda(List($k),
                          And(And(NotEquals($k, "Infix"), NotEquals($k, "Separator")), NotEquals($k, "Prefix"))
                        )
                      ),
                      List("Closer")
                    )
                  ),
                  Call(
                    Member($changed, "set"),
                    $i,
                    Call(
                      Member($api, "call"),
                      "List",
                      Spread(Index($kinds, $i))
                    )
                  )
                ),
                Undefined()
              )
            ),
            Bind($is, Lambda(List($i, $k), And(And(AtLeast($i, 0), LessThan($i, $n)), Includes(Index($kinds, $i), $k)))),
            Bind($scope, Call(Member($kinds, "map"), Lambda(List($_, $i), Call($is, $i, "Scope")))),
            Bind($infix, Call(Member($kinds, "map"), Lambda(List($_, $i), Call($is, $i, "Infix")))),
            Bind($prefix, Call(Member($kinds, "map"), Lambda(List($_, $i), Call($is, $i, "Prefix")))),
            Comment("What binds as an operator does, for what waits on it: operators, and an index after a thing."),
            Comment("A block after an operator is the operator's thing: it stands alone, as a value does."),
            Bind($alone,
              Call(Member($kinds, "map"), Lambda(List($_, $i), And(Index($scope, $i), Index($infix, Subtract($i, 1)))))
            ),
            Comment("A thing can end here: a name that is not an operator, a value, a closed group (not a block)."),
            Comment("A closed group ends a thing, but not a block, a header (\"if (x)\"), or a question's \":\"."),
            Bind($plainEnd,
              Lambda(List($i),
                Or(
                  Or(
                    Or(
                      Or(
                        And(And(Call($is, $i, "Name"), Not(Index($infix, $i))), Not(Index($prefix, $i))),
                        Call($is, $i, "Number")
                      ),
                      Call($is, $i, "Text")
                    ),
                    Call($is, $i, "Regex")
                  ),
                  And(
                    And(
                      And(
                        Call($is, $i, "Closer"),
                        Or(Not(Index($scope, Index($pair, $i))), Index($alone, Index($pair, $i)))
                      ),
                      Not(Call($is, Subtract(Index($pair, $i), 1), "Heads"))
                    ),
                    Not(Index($infix, Index($pair, $i)))
                  )
                )
              )
            ),
            Comment("An operator that cannot stand alone, found where a thing should be, is a thing (\"import *\");"),
            Comment("a word that joins, found where a thing should be, is only a name (\"(from: number)\")."),
            Comment("(nothing after it to hold either: \"import * as\", but not \"(): void =>\")."),
            Bind($nothingAfter,
              Lambda(List($i),
                And(
                  And(
                    And(
                      And(
                        And(
                          And(
                            Not(And(Call($is, Add($i, 1), "Name"), Not(Index($infix, Add($i, 1))))),
                            Not(Call($is, Add($i, 1), "Number"))
                          ),
                          Not(Call($is, Add($i, 1), "Text"))
                        ),
                        Not(Call($is, Add($i, 1), "Regex"))
                      ),
                      Not(And(Call($is, Add($i, 1), "Opener"), Not(Index($scope, Add($i, 1)))))
                    ),
                    Not(Index($alone, Add($i, 1)))
                  ),
                  Not(Call($is, Add($i, 1), "Unary"))
                )
              )
            ),
            Bind($symbolStray,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i),
                  And(
                    And(
                      And(
                        And(
                          And(
                            And(And(Index($infix, $i), Not(Call($is, $i, "Unary"))), Not(Index($prefix, $i))),
                            Not(Call($is, $i, "Name"))
                          ),
                          GreaterThan($i, 0)
                        ),
                        Not(Call($plainEnd, Subtract($i, 1)))
                      ),
                      Not(Index($infix, Subtract($i, 1)))
                    ),
                    Call($nothingAfter, $i)
                  )
                )
              )
            ),
            Bind($stray,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i),
                  Or(
                    Index($symbolStray, $i),
                    And(
                      And(
                        And(
                          And(And(Index($infix, $i), Call($is, $i, "Name")), Not(Call($is, $i, "Unary"))),
                          Not(Index($prefix, $i))
                        ),
                        Not(Call($plainEnd, Subtract($i, 1)))
                      ),
                      Not(Index($symbolStray, Subtract($i, 1)))
                    )
                  )
                )
              )
            ),
            Comment("A leading word with nothing to lead is only a name (\"(): void =>\", \"default:\")."),
            Bind($leads,
              Lambda(List($i),
                And(
                  And(
                    And(
                      And(And(Index($prefix, $i), Call($is, $i, "Name")), Not(Call($is, $i, "Heads"))),
                      Not(Call($is, $i, "TakesBlock"))
                    ),
                    Not(Call($is, $i, "Continues"))
                  ),
                  Not(Index($infix, $i))
                )
              )
            ),
            Bind($idle,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i),
                  And(
                    And(Call($leads, $i), AtMost(Add($i, 1), $n)),
                    Not(
                      Or(
                        Or(
                          Or(
                            Or(
                              Or(
                                Or(
                                  Or(Call($is, Add($i, 1), "Name"), Call($is, Add($i, 1), "Number")),
                                  Call($is, Add($i, 1), "Text")
                                ),
                                Call($is, Add($i, 1), "Regex")
                              ),
                              And(Call($is, Add($i, 1), "Opener"), Not(Index($scope, Add($i, 1))))
                            ),
                            Call($is, Add($i, 1), "Unary")
                          ),
                          Call($is, Add($i, 1), "Prefix")
                        ),
                        Index($stray, Add($i, 1))
                      )
                    )
                  )
                )
              )
            ),
            Bind($ends,
              Lambda(List($i), Or(Or(Call($plainEnd, $i), Not(Not(Index($stray, $i)))), Not(Not(Index($idle, $i)))))
            ),
            Comment("What binds as an operator does, for what waits on it: operators that are not only names"),
            Comment("here, and an index after a thing."),
            Bind($operator,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i), Or(And(Index($infix, $i), Not(Index($stray, $i))), Call($is, $i, "Postfix")))
              )
            ),
            Comment("A thing can start here: a name, a value, a group, an operator standing alone."),
            Bind($attached, Lambda(List($i), Or(Call($is, $i, "Postfix"), Call($is, $i, "Attached")))),
            Bind($starts,
              Lambda(List($i, $lone),
                Or(
                  Or(
                    Or(
                      Or(
                        Or(
                          Or(
                            Or(
                              Or(Index($stray, $i), Index($idle, $i)),
                              And(Call($is, $i, "Name"), Not(Index($infix, $i)))
                            ),
                            Call($is, $i, "Number")
                          ),
                          Call($is, $i, "Text")
                        ),
                        Call($is, $i, "Regex")
                      ),
                      And(
                        And(And(Call($is, $i, "Opener"), Not(Index($scope, $i))), Not(Call($attached, $i))),
                        Not(Index($infix, $i))
                      )
                    ),
                    Index($alone, $i)
                  ),
                  Call($lone, $i)
                )
              )
            ),
            Comment("An operator with a thing before it and none after holds only that thing (\"x++\", \"x!\"),"),
            Comment("and ends a thing itself; one with nothing before it holds only what follows (\"-x\")."),
            Comment("Only a word that can stand before a thing alone (Unary: \"-\", \"!\", \"++\") does."),
            Bind($lone, Lambda(List($i), And(Index($infix, $i), Or(Call($is, $i, "Unary"), Index($prefix, $i))))),
            Bind($firstUnary, Lambda(List($i), And(Call($lone, $i), Not(Call($ends, Subtract($i, 1)))))),
            Bind($postfix,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i),
                  And(
                    And(And(Index($infix, $i), Not(Index($stray, $i))), Call($ends, Subtract($i, 1))),
                    Not(Call($starts, Add($i, 1), $firstUnary))
                  )
                )
              )
            ),
            Bind($operandEnd,
              Call(Member($kinds, "map"), Lambda(List($_, $i), Or(Call($ends, $i), Index($postfix, $i))))
            ),
            Bind($unary,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i), And(Call($lone, $i), Not(Index($operandEnd, Subtract($i, 1)))))
              )
            ),
            Bind($operandStart,
              Call(Member($kinds, "map"), Lambda(List($_, $i), Call($starts, $i, Lambda(List($k), Index($unary, $k)))))
            ),
            Comment("Where what is being said stops: a separator, a closer, a block, a comment, the end."),
            Bind($boundary,
              Concat(
                Call(
                  Member($kinds, "map"),
                  Lambda(List($_, $i),
                    Or(
                      Or(
                        Or(Call($is, $i, "Separator"), Call($is, $i, "Closer")),
                        And(Index($scope, $i), Not(Index($alone, $i)))
                      ),
                      Call($is, $i, "Comment")
                    )
                  )
                ),
                List(true)
              )
            ),
            Bind($punctuation,
              Call(Member($kinds, "map"), Lambda(List($_, $i), Or(Call($is, $i, "Separator"), Call($is, $i, "Closer"))))
            ),
            Bind($made,
              Object(
                operator = $operator,
                stray = $stray,
                scope = $scope,
                alone = $alone,
                infix = $infix,
                prefix = $prefix,
                unary = $unary,
                postfix = $postfix,
                operandEnd = $operandEnd,
                operandStart = $operandStart,
                boundary = $boundary,
                punctuation = $punctuation
              )
            ),
            Bind($derived,
              Concat(
                List(
                  Object(
                    name = "kinds",
                    value = Call(
                      Member(Member($api, "lists"), "with"),
                      Member(
                        Call(
                          Member(Member($view, "args"), "find"),
                          Lambda(List($a), Equals(Member($a, "name"), "kinds"))
                        ),
                        "value"
                      ),
                      $changed
                    )
                  )
                ),
                Map(
                  Call(Member($Object, "entries"), $made),
                  Lambda(List(List($name, $xs)),
                    Object(
                      name = $name,
                      value = Call(
                        Member(Member($api, "lists"), "of"),
                        Map($xs, Lambda(List($x), Call(Member($api, "fromHost"), $x)))
                      )
                    )
                  )
                )
              )
            ),
            Bind($own, New($Set, Map($derived, Lambda(List($a), Member($a, "name"))))),
            Return(
              Object(
                head = Member($view, "head"),
                args = Concat(
                  Filter(Member($view, "args"), Lambda(List($a), Not(Call(Member($own, "has"), Member($a, "name"))))),
                  $derived
                )
              )
            )
          )
        )
      )
    )
  )
)

// Between two things: takes them by how tightly it binds. A word of the language used as a
// name ("x.in", "{ from: 1 }") says it is only a name.
Concept(Infix(),
  Realization($word,
    context = Sensing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("A word of the language used as a name is only a name: typed other than as its Concept's"),
            Comment(
              "plain name (\"Set\" beside \"set\"), a member's name (\"x.set\"), a key (\"{ default: 1 }\"), what"
            ),
            Comment("a member is of (\"type.name\"), or, for a word of the language only where it is not a name,"),
