Concept(Assign(),
  IsA(Infix()),
  Spelled("="),
  Binds(2, Right()),
  Realization(Assign($place, $value),
    context = Context(Code($language), Reading()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"x = 1\": x now holds 1. Said with a binding word, it declares x: const once (Bind), let or"),
            Comment("var to change (Var)."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(List($place, $value), Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($DECLARES, Object(Const = "Bind", Let = "Var", Var = "Var")),
            If(
              And(
                And(Call($isCall, $place), Index($DECLARES, Member($place, "head"))),
                Equals(Length(Member($place, "args")), 1)
              ),
              Return(
                Call(
                  Member($api, "call"),
                  Index($DECLARES, Member($place, "head")),
                  Member(Index(Member($place, "args"), 0), "value"),
                  $value
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "Assign", $place, $value))
          )
        )
      )
    )
  ),
  Realization(Assign($place, $value),
    context = Context(Code(Python()), Reading()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("In Python, \"x = 1\" to a bare name is where x begins: a variable that can change (Var)."),
            Bind(List($place, $value), Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($bare, And(And(NotEquals($place, null), Equals(TypeOf($place), "object")), In("variable", $place))),
            Return(
              Call(
                Member($api, "call"),
                If($bare, "Var", "Assign"),
                $place,
                $value
              )
            )
          )
        )
      )
    )
  )
)

