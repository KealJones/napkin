                      $j,
                      If(
                        And(Call($is, $j, "Closer"), AtLeast(Call($pair, $j), 0)),
                        Subtract(Call($pair, $j), 1),
                        Subtract($j, 1)
                      )
                    ),
                    Sequence(
                      If(Call($returns, $j), Return(true), Undefined()),
                      If(
                        Or(
                          Or(
                            Or(
                              Or(Call($is, $j, "Separator"), Call($is, $j, "Scope")),
                              And(
                                Call($is, $j, "Opener"),
                                Not(And(AtLeast(Call($pair, $j), 0), LessThan(Call($pair, $j), $at)))
                              )
                            ),
                            Equals(Call($head, $j), "Arrow")
                          ),
                          Equals(Call($head, $j), "Assign")
                        ),
                        Break(),
                        Undefined()
                      )
                    )
                  ),
                  Comment("After round brackets, a block, or angles (\"f(x) {\", \"} {\", \"A<T> {\"): a block."),
                  If(
                    Call($is, $p, "Closer"),
                    Return(
                      And(
                        AtLeast(Call($pair, $p), 0),
                        Or(
                          Or(Call($is, Call($pair, $p), "Round"), Call($is, Call($pair, $p), "Scope")),
                          Call($is, Call($pair, $p), "Attached")
                        )
                      )
                    ),
                    Undefined()
                  ),
                  Return(Or(Call($ends, $p), Call($is, $p, "Comment")))
                )
              )
            ),
            Return(
              If(
                Call($blockAt),
                Call($sense, "Block"),
                Call(Member($api, "call"), "List")
              )
            )
          )
        )
      )
    )
  )
)

// "[" after a thing: its index.
Concept(Brackets(),
  Realization($word,
    context = Sensing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"[\" after a thing (not after a header, \"if (x) [a, b] = ...\") is that thing's index."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($words,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 0), "value")),
                "args"
              )
            ),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member($a, "value"))
            ),
            Comment("Each field is a List, one entry a word."),
            Bind($v,
              Lambda(List($k, $i),
                Call(
                  Member(Member($api, "lists"), "at"),
                  Index($field, $k),
                  $i
                )
              )
            ),
            Bind($n, Call(Member(Member($api, "lists"), "size"), Member($field, "kinds"))),
            Bind($is,
              Lambda(List($i, $k),
                And(
                  And(AtLeast($i, 0), LessThan($i, $n)),
                  Call(
                    Member(Member(Call($v, "kinds", $i), "args"), "some"),
                    Lambda(List($a), Equals(Member($a, "value"), $k))
                  )
                )
              )
            ),
            Bind($text,
              Lambda(List($i),
                If(
                  And(AtLeast($i, 0), LessThan($i, $n)),
                  Member(Index(Member(Member(Index($words, $i), "value"), "args"), 0), "value"),
                  ""
                )
              )
            ),
            Bind($head, Lambda(List($i), Call($v, "heads", $i))),
            Bind($pair,
              Lambda(List($i),
                If(
                  Equals(Call($v, "pair", $i), Undefined()),
                  Negate(1),
                  Call($v, "pair", $i)
                )
              )
            ),
            Comment("As the kind of word it also is: what it does when it is not the case here."),
            Bind($as,
              Lambda(List($kind),
                Call(
                  Member($api, "evaluate"),
                  Object(head = $kind, args = Member($self, "args")),
                  Member($api, "context")
                )
              )
            ),
            Bind($sense,
              Lambda(List($h),
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Sense",
                    $at,
                    Call(Member($api, "call"), $h)
                  )
                )
              )
            ),
            Comment("A thing ends here: a name that is no operator, a value, a closed bracket."),
            Bind($ends,
              Lambda(List($i),
                Or(
                  Or(
                    Or(
                      Or(
                        And(And(Call($is, $i, "Name"), Not(Call($is, $i, "Infix"))), Not(Call($is, $i, "Prefix"))),
                        Call($is, $i, "Number")
                      ),
                      Call($is, $i, "Text")
                    ),
                    Call($is, $i, "Regex")
                  ),
                  And(
                    And(
                      And(Call($is, $i, "Closer"), NotEquals(Call($head, $i), "Dedent")),
                      NotEquals(Call($head, $i), null)
                    ),
                    Not(Call($is, Call($pair, $i), "Infix"))
                  )
                )
              )
            ),
            Comment("Round brackets that head a statement: \"if (x)\"."),
            Bind($header,
              Lambda(List($i),
                And(
                  And(Call($is, $i, "Closer"), GreaterThan(Call($pair, $i), 0)),
                  Call($is, Subtract(Call($pair, $i), 1), "Heads")
                )
              )
            ),
            If(
              LessThan(Call($pair, $at), 0),
              Return(
                Call(
                  Member($api, "call"),
                  "List",
                  Call(Member($api, "call"), "Waits"),
                  Spread(Map(Member(Await(Call($as, "Opener")), "args"), Lambda(List($a), Member($a, "value"))))
                )
              ),
              Undefined()
            ),
            Return(
              If(
                And(Call($ends, Subtract($at, 1)), Not(Call($header, Subtract($at, 1)))),
                Call($sense, "Index"),
                Call(Member($api, "call"), "List")
              )
            )
          )
        )
      )
    )
  )
)

// "(" after a closed group: what it gives, called.
Concept(Parens(),
  Realization($word,
    context = Sensing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"(\" right after a closed group that is not a header, a block or angles: what that group"),
            Comment("gives, called (\"f(x)(y)\")."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
