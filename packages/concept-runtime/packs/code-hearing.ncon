      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"function f(a, b) { ... }\": the call it holds names the function and its parameters; the"),
            Comment("rest is its body, which gives undefined when it does not end by returning."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(List($signature, Spread($body)), Map($args, Lambda(List($a), Member($a, "value")))),
            If(
              Or(Not(Call($isCall, $signature)), NotEquals(Member($signature, "head"), "Call")),
              Return(
                Call(
                  Member($api, "call"),
                  "Func",
                  $signature,
                  Spread($body)
                )
              ),
              Undefined()
            ),
            Bind(List($name, Spread($params)), Map(Member($signature, "args"), Lambda(List($a), Member($a, "value")))),
            Bind($steps,
              Filter(
                $body,
                Lambda(List($s),
                  Not(
                    And(
                      And(Call($isCall, $s), Equals(Member($s, "head"), "Undefined")),
                      Equals(Length(Member($s, "args")), 0)
                    )
                  )
                )
              )
            ),
            Bind($last, Index($steps, Subtract(Length($steps), 1))),
            If(
              Not(And(Call($isCall, $last), Equals(Member($last, "head"), "Return"))),
              Call(Member($steps, "push"), Call(Member($api, "call"), "Undefined")),
              Undefined()
            ),
            Return(
              Call(
                Member($api, "call"),
                "Func",
                $name,
                Call(Member($api, "call"), "List", Spread($params)),
                If(
                  Equals(Length($steps), 1),
                  Index($steps, 0),
                  Call(Member($api, "call"), "Sequence", Spread($steps))
                )
              )
            )
          )
        )
      )
    )
  )
)

