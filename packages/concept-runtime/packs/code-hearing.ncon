Concept(For(),
  IsA(Prefix()),
  Binds(0),
  Realization(For($header, Rest($body)),
    context = Context(Code($language), Reading()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"for\" holding \"x of xs\" loops over the values of xs, \"x in xs\" over its keys; what else"),
            Comment("it holds is the loop's body. A binding word before x (const, let) says how x is declared."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(List($header, Spread($body)), Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($LOOPS, Object(Of = "ForOf", In = "ForIn")),
            If(
              Or(
                Or(Not(Call($isCall, $header)), Not(Index($LOOPS, Member($header, "head")))),
                NotEquals(Length(Member($header, "args")), 2)
              ),
              Return(Call(Member($api, "call"), "For", $header, Spread($body))),
              Undefined()
            ),
            Var($x, Member(Index(Member($header, "args"), 0), "value")),
            If(
              And(
                And(Call($isCall, $x), Includes(List("Const", "Let", "Var"), Member($x, "head"))),
                Equals(Length(Member($x, "args")), 1)
              ),
              Assign($x, Member(Index(Member($x, "args"), 0), "value")),
              Undefined()
            ),
            Bind($block,
              If(
                Equals(Length($body), 1),
                Index($body, 0),
                Call(Member($api, "call"), "Sequence", Spread($body))
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                Index($LOOPS, Member($header, "head")),
                $x,
                Member(Index(Member($header, "args"), 1), "value"),
                $block
              )
            )
          )
        )
      )
    )
  ),
  Realization(For($header, Rest($body)),
    context = Context(Code(Python()), Reading()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"for\" holding \"x of xs\" loops over the values of xs, \"x in xs\" over its keys; what else"),
            Comment("it holds is the loop's body. A binding word before x (const, let) says how x is declared."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(List($header, Spread($body)), Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($LOOPS, Object(In = "ForOf")),
            If(
              Or(
                Or(Not(Call($isCall, $header)), Not(Index($LOOPS, Member($header, "head")))),
                NotEquals(Length(Member($header, "args")), 2)
              ),
              Return(Call(Member($api, "call"), "For", $header, Spread($body))),
              Undefined()
            ),
            Var($x, Member(Index(Member($header, "args"), 0), "value")),
            If(
              And(
                And(Call($isCall, $x), Includes(List("Const", "Let", "Var"), Member($x, "head"))),
                Equals(Length(Member($x, "args")), 1)
              ),
              Assign($x, Member(Index(Member($x, "args"), 0), "value")),
              Undefined()
            ),
            Bind($block,
              If(
                Equals(Length($body), 1),
                Index($body, 0),
                Call(Member($api, "call"), "Sequence", Spread($body))
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                Index($LOOPS, Member($header, "head")),
                $x,
                Member(Index(Member($header, "args"), 1), "value"),
                $block
              )
            )
          )
        )
      )
    )
  )
)

Concept(If(),
  IsA(Prefix()),
  Binds(0),
  Realization(If($condition, Rest($then)),
    context = Context(Code($language), Reading()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"if\" holds a condition, then what to do, then (after \"else\") what to do otherwise."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(List($condition, Spread($rest)), Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($otherwise,
              If(
                And(
                  And(Length($rest), Call($isCall, Index($rest, Subtract(Length($rest), 1)))),
                  Equals(Member(Index($rest, Subtract(Length($rest), 1)), "head"), "Else")
                ),
                Map(Member(Call(Member($rest, "pop")), "args"), Lambda(List($a), Member($a, "value"))),
                List()
              )
            ),
            Bind($block,
              Lambda(List($xs),
                If(
                  Equals(Length($xs), 0),
                  Call(Member($api, "call"), "Undefined"),
                  If(
                    Equals(Length($xs), 1),
                    Index($xs, 0),
                    Call(Member($api, "call"), "Sequence", Spread($xs))
                  )
                )
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "If",
                $condition,
                Call($block, $rest),
                Call($block, $otherwise)
              )
            )
          )
        )
      )
    )
  )
)

