              Return(
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Link",
                    $r,
                    $at,
                    Call(Member($api, "call"), "Takes")
                  )
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List"))
          )
        )
      )
    )
  ),
  Realization($word,
    context = Context(Code($language), Reading()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("An operator reads as the Concept the graph says it is a synonym of, else as itself."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($unit, Call(Member(Member($api, "store"), "get"), Member($self, "head"))),
            Bind($synonym,
              If(
                $unit,
                Call(
                  Member(Member($unit, "relations"), "find"),
                  Lambda(List($r),
                    And(
                      And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), "SynonymOf")),
                      Call($isCall, Member(Index(Member(Member($r, "claim"), "args"), 0), "value"))
                    )
                  )
                ),
                Undefined()
              )
            ),
            Return(
              Object(
                head = If(
                  $synonym,
                  Member(Member(Index(Member(Member($synonym, "claim"), "args"), 0), "value"), "head"),
                  Member($self, "head")
                ),
                args = Member($self, "args")
              )
            )
          )
