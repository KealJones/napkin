            Bind($ask,
              Lambda(List($head, Spread($xs)),
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), $head, Spread($xs)),
                  Member($api, "context")
                )
              )
            ),
            Bind($nameOf,
              Lambda(List($e),
                Sequence(
                  If(Equals(TypeOf($e), "string"), Return($e), Undefined()),
                  If(
                    Not(Call($isCall, $e)),
                    Return(Call($String, $e)),
                    Undefined()
                  ),
                  If(
                    Equals(Member($e, "head"), "Identifier"),
                    Return(Member(Index(Member($e, "args"), 0), "value")),
                    Undefined()
                  ),
                  Return(
                    Add(
                      Call(Member(Index(Member($e, "head"), 0), "toLowerCase")),
                      Call(Member(Member($e, "head"), "slice"), 1)
                    )
                  )
                )
              )
            ),
            Bind($variable, Lambda(List($e), Call(Member($api, "fromHost"), Object(variable = Call($nameOf, $e))))),
            Bind($is, Lambda(List($e, $head), And(Call($isCall, $e), Equals(Member($e, "head"), $head)))),
            Comment("\"switch (x) { case 1: a; break; default: b }\": each case with the statements after its label."),
            Bind(List($subject, Spread($rest)), $parts),
            Bind($cases, List()),
            Var($current, Undefined()),
            Bind($label,
              Lambda(List($x),
                If(
                  And(
                    Call($is, $x, "Colon"),
                    Or(
                      Call($is, Index(Call($positional, $x), 0), "Case"),
                      Call($is, Index(Call($positional, $x), 0), "Default")
                    )
                  ),
                  Index(Call($positional, $x), 0),
                  Undefined()
                )
              )
            ),
            ForOf(
              $x,
              $rest,
              Sequence(
                Bind($l, Call($label, $x)),
                Bind($said,
                  If(
                    $l,
                    Call(Member(Call($positional, $x), "slice"), 1),
                    List($x)
                  )
                ),
                If(
                  $l,
                  Call(Member($cases, "push"), Assign($current, Object(l = $l, body = List()))),
                  Undefined()
                ),
                ForOf(
                  $y,
                  $said,
                  Sequence(
                    If(Not($current), Continue(), Undefined()),
                    If(
                      Call($is, $y, "Braces"),
                      Call(Member(Member($current, "body"), "push"), Spread(Call($positional, $y))),
                      Call(Member(Member($current, "body"), "push"), $y)
                    )
                  )
                )
              )
            ),
            Bind($out, List()),
            ForOf(
              $c,
              $cases,
              Sequence(
                Bind($body, Await(Call($ask, "CodeStatements", Spread(Member($c, "body"))))),
                Call(
                  Member($out, "push"),
                  If(
                    Call($is, Member($c, "l"), "Case"),
                    Call(
                      Member($api, "call"),
                      "Case",
                      Await(Call($read, Index(Call($positional, Member($c, "l")), 0))),
                      $body
                    ),
                    Call(Member($api, "call"), "Default", $body)
                  )
                )
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "Switch",
                Await(Call($read, $subject)),
                Call(Member($api, "call"), "List", Spread($out))
              )
            )
          )
        )
      )
    )
  )
)

