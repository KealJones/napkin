  Realization($word,
    context = Hearing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"a ? b : c\": the question takes what is asked before it, and holds what is between it and"),
            Comment("its \":\" and what follows the \":\" as the two answers."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member($a, "value"))
            ),
            Comment("Each field is a List, one entry a word."),
            Bind($v,
              Lambda(List($k, $i),
                Call(
                  Member(Member($api, "lists"), "at"),
                  Index($field, $k),
                  $i
                )
              )
            ),
            Bind($close, Call($v, "pair", $at)),
            If(
              LessThan($close, 0),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($mine, Otherwise(Call($v, "binds", $at), 25)),
            Bind($holding, Lambda(List($b), If(Call($v, "unary", $b), 150, Call($v, "binds", $b)))),
            Bind($out, List()),
            Bind($link,
              Lambda(List($from, $role),
                Sequence(
                  If(
                    And(AtLeast($from, 0), LessThan(Call($v, "parent", $from), 0)),
                    Call(
                      Member($out, "push"),
                      Call(
                        Member($api, "call"),
                        "Link",
                        $from,
                        $at,
                        Call(Member($api, "call"), $role)
                      )
                    ),
                    Undefined()
                  ),
                  Undefined()
                )
              )
            ),
            Call($link, $close, "Absorbs"),
            Comment("What is asked: the thing before, unless the operator before it holds it more tightly."),
            Var($l, Subtract($at, 1)),
            While(
              And(
                And(AtLeast($l, 0), AtLeast(Call($v, "parent", $l), 0)),
                LessThan(Call($v, "hi", Call($v, "parent", $l)), $at)
              ),
              Assign($l, Call($v, "parent", $l))
            ),
            If(
              And(And(AtLeast($l, 0), LessThan(Call($v, "parent", $l), 0)), Not(Call($v, "punctuation", $l))),
              Sequence(
                Bind($b, Subtract(Call($v, "lo", $l), 1)),
                Comment(
                  "Something still to its left that belongs to it (\"a.b\" before \"a\" is taken): not whole yet."
                ),
                If(
                  Call($v, "operandEnd", $b),
                  Return(Call(Member($api, "call"), "List", Spread($out))),
                  Undefined()
                ),
                Bind($before,
                  If(
                    And(
                      And(AtLeast($b, 0), Not(GreaterThan(Call($v, "pair", $b), $at))),
                      Or(Call($v, "operator", $b), Call($v, "prefix", $b))
                    ),
                    Call($holding, $b),
                    null
                  )
                ),
                If(
                  Or(Equals($before, null), AtMost($before, $mine)),
                  Call($link, $l, "Takes"),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Comment("The first answer: the one thing between."),
            Var($m, Add($at, 1)),
            While(
              And(
                And(AtLeast(Call($v, "parent", $m), 0), GreaterThan(Call($v, "parent", $m), $at)),
                LessThan(Call($v, "parent", $m), $close)
              ),
              Assign($m, Call($v, "parent", $m))
            ),
            If(
              And(Equals(Call($v, "lo", $m), Add($at, 1)), Equals(Call($v, "hi", $m), Subtract($close, 1))),
              Call($link, $m, "Takes"),
              Undefined()
            ),
            Comment("The second: the whole thing after the \":\"."),
            Var($r, Add($close, 1)),
            If(
              Call($v, "operandStart", $r),
              Sequence(
                While(
                  And(AtLeast(Call($v, "parent", $r), 0), GreaterThan(Call($v, "lo", Call($v, "parent", $r)), $close)),
                  Assign($r, Call($v, "parent", $r))
                ),
                Bind($e, Add(Call($v, "hi", $r), 1)),
                Comment("Its own closing bracket, not yet absorbed, is not where it ends."),
                If(
                  And(
                    And(Call($v, "punctuation", $e), AtLeast(Call($v, "pair", $e), Call($v, "lo", $r))),
                    LessThan(Call($v, "pair", $e), $e)
                  ),
                  Return(Call(Member($api, "call"), "List", Spread($out))),
                  Undefined()
                ),
                Bind($next,
                  If(
                    And(Call($v, "operator", $e), Not(Call($v, "unary", $e))),
                    Call($holding, $e),
                    Undefined()
                  )
                ),
                If(
                  Or(
                    Call($v, "boundary", $e),
                    And(And(NotEquals($next, Undefined()), NotEquals($next, null)), LessThan($next, $mine))
                  ),
                  Call($link, $r, "Takes"),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// "<" after a name, closing on a ">" around nothing that computes: the name's angles.
