        )
      )
    )
  )
)

Concept(Numeral(),
  Realization(Numeral($said),
    context = Context(Code($language), Reading()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("A number written other than as its plain value keeps what its writing states, so a"),
            Comment("language that must choose a type can: \"2.0\" and \"1e3\" are Float, a suffix is kept as said"),
            Comment("for the language to read ({ n: \"BigInt\" }), digit groups (\"1_000\") and bases are only layout."),
            Bind($said, Call($String, Member(Index($args, 0), "value"))),
            Bind($plain, Call(Member($said, "replace"), Regex("_", "g"), "")),
            Bind($suffix, Call(Member(Regex("^(.*?[0-9a-f.])([a-z]+)$", "i"), "exec"), $plain)),
            Bind($SUFFIX, Object(n = "BigInt")),
            If(
              And(
                And($suffix, Not(Call(Member(Regex("^0[xob]", "i"), "test"), $plain))),
                Index($SUFFIX, Index($suffix, 2))
              ),
              Return(
                Call(
                  Member($api, "call"),
                  Index($SUFFIX, Index($suffix, 2)),
                  Index($suffix, 1)
                )
              ),
              Undefined()
            ),
            Bind($value, Call($Number, $plain)),
            If(
              Call(Member($Number, "isNaN"), $value),
              Return(Call(Member($api, "call"), "Number", $said)),
              Undefined()
            ),
            Return(
              If(
                And(
                  Call(Member(Regex("^[0-9]*\\.|e", "i"), "test"), $plain),
                  Not(Call(Member(Regex("^0x", "i"), "test"), $plain))
                ),
                Call(Member($api, "call"), "Float", $value),
                $value
              )
            )
          )
        )
      )
    )
  ),
  Realization(Numeral($said),
    context = Context(Code(Python()), Reading()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("A number written other than as its plain value keeps what its writing states, so a"),
            Comment("language that must choose a type can: \"2.0\" and \"1e3\" are Float, a suffix is kept as said"),
            Comment("for the language to read ({}), digit groups (\"1_000\") and bases are only layout."),
            Bind($said, Call($String, Member(Index($args, 0), "value"))),
            Bind($plain, Call(Member($said, "replace"), Regex("_", "g"), "")),
            Bind($suffix, Call(Member(Regex("^(.*?[0-9a-f.])([a-z]+)$", "i"), "exec"), $plain)),
            Bind($SUFFIX, Object()),
            If(
              And(
                And($suffix, Not(Call(Member(Regex("^0[xob]", "i"), "test"), $plain))),
                Index($SUFFIX, Index($suffix, 2))
              ),
              Return(
                Call(
                  Member($api, "call"),
                  Index($SUFFIX, Index($suffix, 2)),
                  Index($suffix, 1)
                )
              ),
              Undefined()
            ),
            Bind($value, Call($Number, $plain)),
            If(
              Call(Member($Number, "isNaN"), $value),
              Return(Call(Member($api, "call"), "Number", $said)),
              Undefined()
            ),
            Return(
              If(
                And(
                  Call(Member(Regex("^[0-9]*\\.|e", "i"), "test"), $plain),
                  Not(Call(Member(Regex("^0x", "i"), "test"), $plain))
                ),
                Call(Member($api, "call"), "Float", $value),
                $value
              )
            )
          )
        )
      )
    )
  )
)

