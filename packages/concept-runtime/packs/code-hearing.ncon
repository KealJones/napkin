              Return(
                Call(
                  Member($api, "call"),
                  "List",
                  Call(Member($api, "call"), "Waits"),
                  Spread(Map(Member(Await(Call($as, "Opener")), "args"), Lambda(List($a), Member($a, "value"))))
                )
              ),
