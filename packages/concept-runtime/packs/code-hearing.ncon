            Bind($is,
              Lambda(List($i, $k),
                And(
                  And(AtLeast($i, 0), LessThan($i, $n)),
                  Call(
                    Member(Member(Call($v, "kinds", $i), "args"), "some"),
                    Lambda(List($a), Equals(Member($a, "value"), $k))
                  )
                )
              )
            ),
            Bind($text,
              Lambda(List($i),
                If(
                  And(AtLeast($i, 0), LessThan($i, $n)),
                  Member(Index(Member(Member(Index($words, $i), "value"), "args"), 0), "value"),
                  ""
                )
              )
            ),
            Bind($head, Lambda(List($i), Call($v, "heads", $i))),
            Bind($pair,
              Lambda(List($i),
                If(
                  Equals(Call($v, "pair", $i), Undefined()),
                  Negate(1),
                  Call($v, "pair", $i)
                )
              )
            ),
            Comment("As the kind of word it also is: what it does when it is not the case here."),
            Bind($as,
              Lambda(List($kind),
                Call(
                  Member($api, "evaluate"),
                  Object(head = $kind, args = Member($self, "args")),
                  Member($api, "context")
                )
