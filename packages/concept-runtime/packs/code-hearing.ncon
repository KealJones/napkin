Concept(CodeScope(),
  Realization($word,
    context = Context(Code($language), Reading()),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Comment("An identifier's first part is how it was written; what follows is what it took."),
            Bind($positional,
              Lambda(List($e),
                Sequence(
                  Bind($xs,
                    Map(
                      Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                      Lambda(List($a), Member($a, "value"))
                    )
                  ),
                  Return(
                    If(
                      Equals(Member($e, "head"), "Identifier"),
                      Call(Member($xs, "slice"), 1),
                      $xs
                    )
                  )
                )
              )
            ),
            Bind($parts, Call($positional, $self)),
            Bind($named,
              Lambda(List($k),
                Sequence(
                  Bind($a,
                    Call(Member(Member($self, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $k)))
                  ),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($read, Lambda(List($e), Call(Member($api, "evaluate"), $e, Member($api, "context")))),
            Bind($ask,
              Lambda(List($head, Spread($xs)),
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), $head, Spread($xs)),
                  Member($api, "context")
                )
              )
            ),
            Bind($nameOf,
              Lambda(List($e),
                Sequence(
                  If(Equals(TypeOf($e), "string"), Return($e), Undefined()),
                  If(
                    Not(Call($isCall, $e)),
                    Return(Call($String, $e)),
                    Undefined()
                  ),
                  If(
                    Equals(Member($e, "head"), "Identifier"),
                    Return(Member(Index(Member($e, "args"), 0), "value")),
                    Undefined()
                  ),
                  Return(
                    Add(
                      Call(Member(Index(Member($e, "head"), 0), "toLowerCase")),
                      Call(Member(Member($e, "head"), "slice"), 1)
                    )
                  )
                )
              )
            ),
            Bind($variable, Lambda(List($e), Call(Member($api, "fromHost"), Object(variable = Call($nameOf, $e))))),
            Bind($is, Lambda(List($e, $head), And(Call($isCall, $e), Equals(Member($e, "head"), $head)))),
            Comment("The names code binds, as heard, so reading can tell the program's own variables from names it"),
            Comment("only uses. The words say how they bind: a word that Declares binds what it holds (const, let,"),
            Comment("import, catch); one that DeclaresFirst binds only its first part (a loop's binding, an"),
            Comment("assignment's target); one that DeclaresName binds the name it holds and what"),
            Comment("that name takes (a function, a class); one that DeclaresParameters binds what it is given (an"),
            Comment(
              "arrow). BindsLeft and BindsRight say which side of a pair is the bound one (\"x = 1\", \"a as b\")."
            ),
            Bind($claims,
              Lambda(List($e),
                If(
                  Call($isCall, $e),
                  Otherwise(
                    OptionalMember(Call(Member(Member($api, "store"), "get"), Member($e, "head")), "relations"),
                    List()
                  ),
                  List()
                )
              )
            ),
            Bind($holds,
              Lambda(List($e, $claim),
                Call(Member(Call($claims, $e), "some"), Lambda(List($r), Call($is, Member($r, "claim"), $claim)))
              )
            ),
            Bind($isa,
              Lambda(List($e, $kind),
                Call(
                  Member(Call($claims, $e), "some"),
                  Lambda(List($r),
                    And(
                      Call($is, Member($r, "claim"), "IsA"),
                      Call(
                        $is,
                        Member(Index(Member(Member($r, "claim"), "args"), 0), "value"),
                        $kind
                      )
                    )
                  )
                )
              )
            ),
            Bind($names, New($Set)),
            Comment("A pattern of names: a name, or brackets of them; a default or a type beside it is not bound."),
            Bind($bind,
              Lambda(List($e),
                Sequence(
                  If(
                    Call($is, $e, "Identifier"),
                    Call(Member($names, "add"), Call($nameOf, $e)),
                    If(
                      Call($holds, $e, "BindsLeft"),
                      Call($bind, Index(Call($positional, $e), 0)),
                      If(
                        Call($holds, $e, "BindsRight"),
                        Call($bind, Index(Call($positional, $e), 1)),
                        If(
                          Or(Or(Call($isa, $e, "Opener"), Call($is, $e, "Spread")), Call($holds, $e, "Declares")),
                          ForOf($x, Call($positional, $e), Call($bind, $x)),
                          Undefined()
                        )
                      )
                    )
                  ),
                  Undefined()
                )
              )
            ),
            Bind($takes,
              Lambda(List($e),
                Sequence(
                  Call(Member($names, "add"), Call($nameOf, $e)),
                  ForOf(
                    $x,
                    Call($positional, $e),
                    If(
                      Not(Call($is, $x, "Block")),
                      Call($bind, $x),
                      Undefined()
                    )
                  ),
                  Undefined()
                )
              )
            ),
            Bind($walk,
              Lambda(List($e),
                Sequence(
                  If(Not(Call($isCall, $e)), Return(), Undefined()),
                  Bind($p, Call($positional, $e)),
                  If(
                    Call($holds, $e, "Declares"),
                    Call(Member($p, "forEach"), $bind),
                    If(
                      Call($holds, $e, "DeclaresFirst"),
                      Call($bind, Index($p, 0)),
                      If(
                        And(Call($holds, $e, "DeclaresName"), Call($is, Index($p, 0), "Identifier")),
                        Call($takes, Index($p, 0)),
                        If(
                          Call($holds, $e, "DeclaresParameters"),
                          Call($bind, Index($p, 0)),
                          Undefined()
                        )
                      )
                    )
                  ),
                  Comment("A method in a class or an object: what it takes."),
                  If(
                    And(Call($is, $e, "Identifier"), Call(Member($p, "some"), Lambda(List($x), Call($is, $x, "Block")))),
                    Call($takes, $e),
                    Undefined()
                  ),
                  ForOf($x, $p, Call($walk, $x)),
                  Undefined()
                )
              )
            ),
            ForOf($s, $parts, Call($walk, $s)),
            Return(Call(Member($api, "call"), "List", Spread(Concat($names))))
          )
        )
      )
    )
  )
)

