                  Return(If($t, Member($t, "value"), Undefined()))
                )
              )
            ),
            Bind($code,
              Call(
                Member(
                  Map(Otherwise(Member(Member($api, "context"), "args"), List()), Lambda(List($a), Member($a, "value"))),
                  "find"
                ),
                Lambda(List($f), And(Call($isCall, $f), Equals(Member($f, "head"), "Code")))
              )
            ),
            Bind($language,
              If(
                And($code, Call($isCall, Member(Index(Member($code, "args"), 0), "value"))),
                Member(Member(Index(Member($code, "args"), 0), "value"), "head"),
                ""
              )
            ),
            Bind($rulesOf,
              Lambda(List($head),
                Sequence(
                  Bind($unit, Call(Member(Member($api, "store"), "get"), $head)),
                  Return(
                    If(
                      $unit,
                      Filter(
                        Member($unit, "realizations"),
                        Lambda(List($r),
                          And(
                            And(
                              And(Not(Member($r, "retired")), Call($isCall, Member($r, "context"))),
                              Call(
                                Member(Member(Member($r, "context"), "args"), "some"),
                                Lambda(List($a),
                                  And(
                                    Call($isCall, Member($a, "value")),
                                    Equals(Member(Member($a, "value"), "head"), "Reading")
                                  )
                                )
                              )
                            ),
                            Call(
                              Member(Member(Member($r, "context"), "args"), "some"),
                              Lambda(List($a),
                                And(
                                  Call($isCall, Member($a, "value")),
                                  Includes(
                                    List("JavaScript", "TypeScript", $language),
                                    Member(Member($a, "value"), "head")
                                  )
                                )
                              )
                            )
                          )
                        )
                      ),
                      List()
                    )
                  )
                )
              )
            ),
            Bind($isVar,
              Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("variable", $e)))
            ),
