                        0
                      )
                    ),
                    Bind($f, Index($values, 0)),
                    If(
                      And(
                        And(
                          And(And($least, Call($isCall, $f)), Equals(Member($f, "head"), "Lambda")),
                          Call($isCall, Member(Index(Member($f, "args"), 0), "value"))
                        ),
                        AtLeast(Length(Member(Member(Index(Member($f, "args"), 0), "value"), "args")), $least)
                      ),
                      Return(Call(Member($api, "call"), "Call", $got, Spread($values))),
                      Undefined()
                    )
                  )
                ),
                ForOf(
                  $r,
                  Call($rulesOf, "JsCallExpression"),
                  Sequence(
                    Bind($ex, Call($field, Member($r, "pattern"), "expression")),
                    If(
                      Or(
                        Or(
                          Or(Not($ex), Not(Call($isCall, Member($ex, "value")))),
                          NotEquals(Member(Member($ex, "value"), "head"), "JsPropertyAccessExpression")
                        ),
                        NotEquals(Call($text, Member($ex, "value")), $name)
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Bind($as, Call($field, Member($r, "pattern"), "arguments")),
                    Bind($wanted,
                      If(
                        And($as, Call($isCall, Member($as, "value"))),
                        Map(Member(Member($as, "value"), "args"), Lambda(List($a), Member($a, "value"))),
                        List()
                      )
                    ),
                    Bind($o, Call($field, Member($ex, "value"), "expression")),
                    If(
                      Or(
                        Or(
                          Or(
                            Or(Not($o), Not(Call($isVar, Member($o, "value")))),
                            NotEquals(Length($wanted), Length($values))
                          ),
                          Not(Call(Member($wanted, "every"), $isVar))
                        ),
                        Not(Call($isCall, Member($r, "body")))
