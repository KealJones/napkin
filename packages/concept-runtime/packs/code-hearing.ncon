                    Bind($ps, If($fn, Call($field, $fn, "parameters"), Undefined())),
                    Bind($least,
                      If(
                        And($ps, Call($isCall, Member($ps, "value"))),
                        Length(
                          Filter(
                            Member(Member($ps, "value"), "args"),
                            Lambda(List($a),
                              And(
                                Call($isVar, Member($a, "value")),
                                Equals(Member(Member($a, "value"), "variable"), "_")
