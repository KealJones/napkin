            Bind($is, Lambda(List($e, $head), And(Call($isCall, $e), Equals(Member($e, "head"), $head)))),
            Comment("\"a.name\": the member of a by that name; \"a.b(c)\": that member called. Where the graph says a"),
            Comment("member by that name is a Concept of the code IR in this language (\"xs.length\" is Length(xs),"),
            Comment("\"xs.map(f)\" is Map(xs, f)), it reads as that Concept."),
            Bind(List($owner, $member),
              Map(
                Filter(Member($self, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                Lambda(List($a), Member($a, "value"))
              )
            ),
