              )
            ),
            Bind($variable, Lambda(List($e), Call(Member($api, "fromHost"), Object(variable = Call($nameOf, $e))))),
            Bind($is, Lambda(List($e, $head), And(Call($isCall, $e), Equals(Member($e, "head"), $head)))),
            Comment(
              "\"const x: number = 1\": a declaration with its type. Elsewhere a colon pairs a key with its value."
            ),
            Bind(List($place, $rest), $parts),
            Bind($DECLARES, Object(Const = "Bind", Let = "Var", Var = "Var")),
            If(
              And(Call($isCall, $place), Index($DECLARES, Member($place, "head"))),
              Sequence(
                Bind($target,
                  Await(
                    Call(
                      $ask,
                      "CodeTarget",
                      Index(Call($positional, $place), 0)
                    )
                  )
                ),
                Bind($hasValue, And(Call($is, $rest, "Assign"), Equals(Length(Call($positional, $rest)), 2))),
                Bind($type, If($hasValue, Index(Call($positional, $rest), 0), $rest)),
                Return(
                  Object(
                    head = Index($DECLARES, Member($place, "head")),
                    args = List(
                      Object(value = $target),
                      Object(
                        value = If(
                          $hasValue,
                          Await(Call($read, Index(Call($positional, $rest), 1))),
                          Call(Member($api, "call"), "Undefined")
                        )
                      ),
                      Object(name = "type", value = $type)
                    )
                  )
                )
              ),
              Undefined()
            ),
            Return(
              Call(
                Member($api, "call"),
                "Colon",
                Await(Call($read, $place)),
                Await(Call($read, $rest))
              )
            )
          )
        )
      )
    )
  )
)

