                  If(
                    Equals(Member($e, "head"), "Identifier"),
                    Return(Member(Index(Member($e, "args"), 0), "value")),
                    Undefined()
                  ),
                  Return(
                    Add(
                      Call(Member(Index(Member($e, "head"), 0), "toLowerCase")),
                      Call(Member(Member($e, "head"), "slice"), 1)
                    )
                  )
                )
              )
            ),
            Bind($variable, Lambda(List($e), Call(Member($api, "fromHost"), Object(variable = Call($nameOf, $e))))),
            Bind($is, Lambda(List($e, $head), And(Call($isCall, $e), Equals(Member($e, "head"), $head)))),
            Comment("In Python an \"if\" with no \"else\" has no otherwise; \"elif\" goes on as another if."),
            Bind(List($condition, Spread($rest)), $parts),
            Bind($last, Index($rest, Subtract(Length($rest), 1))),
            Bind($tail,
              If(
                Or(Call($is, $last, "Else"), Call($is, $last, "Elif")),
                Call(Member($rest, "pop")),
                Undefined()
              )
            ),
            Bind($then, Await(Call($ask, "CodeStatements", Spread($rest)))),
            If(
              Not($tail),
              Return(
                Call(
                  Member($api, "call"),
                  "If",
                  Await(Call($read, $condition)),
                  $then
                )
              ),
              Undefined()
            ),
            Bind($otherwise,
              If(
                Call($is, $tail, "Elif"),
                Await(Call($read, Object(head = "If", args = Member($tail, "args")))),
                Await(
                  Call(
                    $ask,
                    "CodeStatements",
                    Spread(Call($positional, $tail))
                  )
                )
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "If",
                Await(Call($read, $condition)),
                $then,
                $otherwise
              )
            )
          )
        )
      )
    )
  )
)

