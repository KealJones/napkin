Concept(CodeTarget(),
  Realization($word,
    context = Context(Code($language), Reading()),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Comment("An identifier's first part is how it was written; what follows is what it took."),
            Bind($positional,
              Lambda(List($e),
                Sequence(
                  Bind($xs,
                    Map(
                      Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                      Lambda(List($a), Member($a, "value"))
                    )
                  ),
                  Return(
                    If(
                      Equals(Member($e, "head"), "Identifier"),
                      Call(Member($xs, "slice"), 1),
                      $xs
                    )
                  )
                )
              )
            ),
            Bind($parts, Call($positional, $self)),
            Bind($named,
              Lambda(List($k),
                Sequence(
                  Bind($a,
                    Call(Member(Member($self, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $k)))
                  ),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($read, Lambda(List($e), Call(Member($api, "evaluate"), $e, Member($api, "context")))),
            Bind($ask,
              Lambda(List($head, Spread($xs)),
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), $head, Spread($xs)),
                  Member($api, "context")
                )
              )
            ),
            Bind($nameOf,
              Lambda(List($e),
                Sequence(
                  If(Equals(TypeOf($e), "string"), Return($e), Undefined()),
                  If(
                    Not(Call($isCall, $e)),
                    Return(Call($String, $e)),
                    Undefined()
                  ),
                  If(
                    Equals(Member($e, "head"), "Identifier"),
                    Return(Member(Index(Member($e, "args"), 0), "value")),
                    Undefined()
                  ),
                  Return(
                    Add(
                      Call(Member(Index(Member($e, "head"), 0), "toLowerCase")),
                      Call(Member(Member($e, "head"), "slice"), 1)
                    )
                  )
                )
              )
            ),
            Bind($variable, Lambda(List($e), Call(Member($api, "fromHost"), Object(variable = Call($nameOf, $e))))),
            Bind($is, Lambda(List($e, $head), And(Call($isCall, $e), Equals(Member($e, "head"), $head)))),
            Comment("What is bound: a name, or a pattern of names ({ a, b: c }, [a, ...b]), with its type set aside."),
            Bind($e, Index($parts, 0)),
            If(Not(Call($isCall, $e)), Return($e), Undefined()),
            Bind($p, Call($positional, $e)),
            If(
              And(Call($is, $e, "Identifier"), Equals(Length($p), 0)),
              Return(Call($variable, $e)),
              Undefined()
            ),
            If(
              And(Or(Call($is, $e, "Colon"), Call($is, $e, "OptionalColon")), Equals(Length($p), 2)),
              Sequence(
                Comment("The type may itself be a function type: the default is at its far end (\"f: () => T = g\")."),
                Var($t, Index($p, 1)),
                While(
                  And(Call($is, $t, "Arrow"), Equals(Length(Call($positional, $t)), 2)),
                  Assign($t, Index(Call($positional, $t), 1))
                ),
                Return(
                  If(
                    And(Call($is, $t, "Assign"), Equals(Length(Call($positional, $t)), 2)),
                    Call(
                      Member($api, "call"),
                      "Default",
                      Await(Call($ask, "CodeTarget", Index($p, 0))),
                      Await(Call($read, Index(Call($positional, $t), 1)))
                    ),
                    Call($ask, "CodeTarget", Index($p, 0))
                  )
                )
              ),
              Undefined()
            ),
            If(
              And(
                Includes(List("Readonly", "Private", "Public", "Protected"), Member($e, "head")),
                Equals(Length($p), 1)
              ),
              Return(Call($ask, "CodeTarget", Index($p, 0))),
              Undefined()
            ),
            If(
              Call($is, $e, "Spread"),
              Return(
                Call(
                  Member($api, "call"),
                  "Spread",
                  Await(Call($ask, "CodeTarget", Index($p, 0)))
                )
              ),
              Undefined()
            ),
            If(
              And(Call($is, $e, "Assign"), Equals(Length($p), 2)),
              Return(
                Call(
                  Member($api, "call"),
                  "Default",
                  Await(Call($ask, "CodeTarget", Index($p, 0))),
                  Await(Call($read, Index($p, 1)))
                )
              ),
              Undefined()
            ),
            If(
              Call($is, $e, "Brackets"),
              Sequence(
                Bind($xs, List()),
                ForOf(
                  $x,
                  $p,
                  Call(Member($xs, "push"), Await(Call($ask, "CodeTarget", $x)))
                ),
                Return(Call(Member($api, "call"), "List", Spread($xs)))
              ),
              Undefined()
            ),
            If(
              Call($is, $e, "Braces"),
              Sequence(
                Bind($items, List()),
                ForOf(
                  $item,
                  $p,
                  If(
                    And(Call($is, $item, "Colon"), Equals(Length(Call($positional, $item)), 2)),
                    Call(
                      Member($items, "push"),
                      Object(
                        name = Call($nameOf, Index(Call($positional, $item), 0)),
                        value = Await(Call($ask, "CodeTarget", Index(Call($positional, $item), 1)))
                      )
                    ),
                    If(
                      Call($is, $item, "Spread"),
                      Call(Member($items, "push"), Object(value = Await(Call($ask, "CodeTarget", $item)))),
                      If(
                        Call($is, $item, "Assign"),
                        Call(
                          Member($items, "push"),
                          Object(
                            name = Call($nameOf, Index(Call($positional, $item), 0)),
                            value = Await(Call($ask, "CodeTarget", $item))
                          )
                        ),
                        Call(
                          Member($items, "push"),
                          Object(name = Call($nameOf, $item), value = Call($variable, $item))
                        )
                      )
                    )
                  )
                ),
                Return(Object(head = "Object", args = $items))
              ),
              Undefined()
            ),
            Return(Call($read, $e))
          )
        )
      )
    )
  )
)

