Concept(Import(),
  Realization($word,
    context = Context(Code($language), Reading()),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Comment("An identifier's first part is how it was written; what follows is what it took."),
            Bind($positional,
              Lambda(List($e),
                Sequence(
                  Bind($xs,
                    Map(
                      Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                      Lambda(List($a), Member($a, "value"))
                    )
                  ),
                  Return(
                    If(
                      Equals(Member($e, "head"), "Identifier"),
                      Call(Member($xs, "slice"), 1),
                      $xs
                    )
                  )
                )
              )
            ),
            Bind($parts, Call($positional, $self)),
            Bind($named,
              Lambda(List($k),
                Sequence(
                  Bind($a,
                    Call(Member(Member($self, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $k)))
                  ),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($read, Lambda(List($e), Call(Member($api, "evaluate"), $e, Member($api, "context")))),
            Bind($ask,
              Lambda(List($head, Spread($xs)),
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), $head, Spread($xs)),
                  Member($api, "context")
                )
              )
            ),
            Bind($nameOf,
              Lambda(List($e),
                Sequence(
                  If(Equals(TypeOf($e), "string"), Return($e), Undefined()),
                  If(
                    Not(Call($isCall, $e)),
                    Return(Call($String, $e)),
                    Undefined()
                  ),
                  If(
                    Equals(Member($e, "head"), "Identifier"),
                    Return(Member(Index(Member($e, "args"), 0), "value")),
                    Undefined()
                  ),
                  Return(
                    Add(
                      Call(Member(Index(Member($e, "head"), 0), "toLowerCase")),
                      Call(Member(Member($e, "head"), "slice"), 1)
                    )
                  )
                )
              )
            ),
            Bind($variable, Lambda(List($e), Call(Member($api, "fromHost"), Object(variable = Call($nameOf, $e))))),
            Bind($is, Lambda(List($e, $head), And(Call($isCall, $e), Equals(Member($e, "head"), $head)))),
            Comment("\"import { a, b as c } from 'x'\": the names it brings in, and from where."),
            Var($e, Index($parts, 0)),
            If(
              Call($is, $e, "Type"),
              Assign($e, Index(Call($positional, $e), 0)),
              Undefined()
            ),
            If(
              Call($is, $e, "Parens"),
              Sequence(
                Bind($xs, List()),
                ForOf(
                  $x,
                  Call($positional, $e),
                  Call(Member($xs, "push"), Await(Call($read, $x)))
                ),
                Return(Call(Member($api, "call"), "DynamicImport", Spread($xs)))
              ),
              Undefined()
            ),
            If(
              Not(Call($is, $e, "From")),
              Return(
                Call(
                  Member($api, "call"),
                  "Import",
                  Call(Member($api, "call"), "List"),
                  Await(Call($read, $e))
                )
              ),
              Undefined()
            ),
            Bind(List($what, $source), Call($positional, $e)),
            Bind($names, List()),
            Bind($add,
              Lambda(List($x),
                Sequence(
                  If(
                    Call($is, $x, "Type"),
                    Return(Call($add, Index(Call($positional, $x), 0))),
                    Undefined()
                  ),
                  If(
                    Call($is, $x, "As"),
                    Return(Call(Member($names, "push"), Call($variable, Index(Call($positional, $x), 1)))),
                    Undefined()
                  ),
                  Call(Member($names, "push"), Call($variable, $x)),
                  Undefined()
                )
              )
            ),
            ForOf(
              $x,
              If(
                Call($is, $what, "Braces"),
                Call($positional, $what),
                List($what)
              ),
              Call($add, $x)
            ),
            Return(
              Call(
                Member($api, "call"),
                "Import",
                Call(Member($api, "call"), "List", Spread($names)),
                Await(Call($read, $source))
              )
            )
          )
        )
      )
    )
  )
)

