                  )
                )
              )
            ),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($n, Call(Member(Member($api, "lists"), "size"), Member($field, "kinds"))),
            Bind($head, Lambda(List($i), Call($v, "heads", $i))),
            Bind($claim,
              Lambda(List($h, $k),
                Sequence(
                  Bind($unit,
                    If(
                      $h,
                      Call(Member(Member($api, "store"), "get"), $h),
                      Undefined()
                    )
                  ),
                  Bind($r,
                    If(
                      $unit,
                      Call(
                        Member(Member($unit, "relations"), "find"),
                        Lambda(List($x),
                          And(Call($isCall, Member($x, "claim")), Equals(Member(Member($x, "claim"), "head"), $k))
                        )
                      ),
                      Undefined()
                    )
                  ),
                  Return(If($r, Member($r, "claim"), Undefined()))
                )
              )
            ),
            If(
              AtLeast(Call($v, "pair", $at), 0),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Sequence(
              Comment("Its closer: the next closing bracket where the brackets between have all closed. A"),
              Comment("bracket that says it is closed by something other than a bracket (\"?\" by \":\") is"),
              Comment("left to find its own."),
              Bind($plain,
                Lambda(List($i),
                  Sequence(
                    Bind($c, Call($claim, Call($head, $i), "ClosedBy")),
                    If(Not($c), Return(true), Undefined()),
                    Bind($to,
                      Call(
                        Member(Member($api, "store"), "get"),
                        Member(Member(Index(Member($c, "args"), 0), "value"), "head")
                      )
                    ),
                    Return(
                      And(
                        Not(Not($to)),
                        Call(
                          Member(Member($to, "relations"), "some"),
                          Lambda(List($r),
                            And(
                              And(
                                And(
                                  Call($isCall, Member($r, "claim")),
                                  Equals(Member(Member($r, "claim"), "head"), "IsA")
                                ),
                                Call($isCall, Member(Index(Member(Member($r, "claim"), "args"), 0), "value"))
                              ),
                              Equals(
                                Member(Member(Index(Member(Member($r, "claim"), "args"), 0), "value"), "head"),
                                "Closer"
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              ),
              If(
                Not(Call($plain, $at)),
                Return(Call(Member($api, "call"), "List")),
                Undefined()
              ),
              Var($depth, 0),
              For(
                Var($k, Add($at, 1)),
                LessThan($k, $n),
                PostIncrement($k),
                Sequence(
                  Bind($p, Call($v, "pair", $k)),
                  If(
                    GreaterThan($p, $k),
                    Sequence(Assign($k, $p), Continue()),
                    Undefined()
                  ),
                  If(AtLeast($p, 0), Continue(), Undefined()),
                  If(
                    And(Call($is, $k, "Opener"), Call($plain, $k)),
                    PostIncrement($depth),
                    If(
                      Call($is, $k, "Closer"),
                      Sequence(
                        If(
                          Equals($depth, 0),
                          Return(
                            Call(
                              Member($api, "call"),
                              "List",
                              Call(
                                Member($api, "call"),
                                "Link",
