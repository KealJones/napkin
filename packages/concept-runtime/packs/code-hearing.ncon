            Bind($is, Lambda(List($e, $head), And(Call($isCall, $e), Equals(Member($e, "head"), $head)))),
            Comment("A number written other than as its plain value keeps what its writing states, so a language"),
            Comment("that must choose a type can: \"2.0\" and \"1e3\" are Float; a suffix is what the graph says it is"),
            Comment("in this language (\"3n\" is BigInt in TypeScript, NumberSuffix(\"n\")); digit groups (\"1_000\")"),
            Comment("and bases are only layout."),
            Bind($said, Call($String, Index($parts, 0))),
            Bind($plain, Call(Member($said, "replace"), Regex("_", "g"), "")),
            Bind($suffix, Call(Member(Regex("^(.*?[0-9a-f.])([a-z]+)$", "i"), "exec"), $plain)),
