            Comment("empty, they stay said (\"print()\" is Print(Parens()));"),
            Comment("- after a word that heads a statement (\"if (...)\", \"for (...)\"), they are its header;"),
            Comment("- a block belongs to the word that leads what is said before it (\"for ... { }\", \"if"),
            Comment("...:\"), its statements that word's; a block a name leads is the name's Block (\"m() { }\");"),
            Comment("- angles belong to the name before them; an index takes the thing before it too;"),
            Comment("- a template takes each piece inside it, an interpolation is its one thing;"),
            Comment("- any other group is itself a word (Brackets(1, 2), Braces(...), Parens(a, b)), except"),
            Comment("round brackets around one thing, which are only how the thing is said."),
            Comment("The closing bracket and the separators are part of how it is said: absorbed."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member($a, "value"))
            ),
            Comment("Each field is a List, one entry a word."),
            Bind($v,
              Lambda(List($k, $i),
                Call(
                  Member(Member($api, "lists"), "at"),
                  Index($field, $k),
                  $i
                )
              )
            ),
            Bind($is,
              Lambda(List($i, $k),
                And(
                  And(
                    AtLeast($i, 0),
                    LessThan($i, Call(Member(Member($api, "lists"), "size"), Member($field, "kinds")))
                  ),
                  Call(
                    Member(Member(Call($v, "kinds", $i), "args"), "some"),
                    Lambda(List($a), Equals(Member($a, "value"), $k))
                  )
                )
              )
            ),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($n, Call(Member(Member($api, "lists"), "size"), Member($field, "kinds"))),
            Bind($head, Lambda(List($i), Call($v, "heads", $i))),
            Bind($claim,
              Lambda(List($h, $k),
                Sequence(
                  Bind($unit,
                    If(
                      $h,
                      Call(Member(Member($api, "store"), "get"), $h),
                      Undefined()
                    )
                  ),
                  Bind($r,
                    If(
                      $unit,
                      Call(
                        Member(Member($unit, "relations"), "find"),
                        Lambda(List($x),
                          And(Call($isCall, Member($x, "claim")), Equals(Member(Member($x, "claim"), "head"), $k))
                        )
                      ),
                      Undefined()
                    )
                  ),
                  Return(If($r, Member($r, "claim"), Undefined()))
                )
              )
            ),
            Bind($close, Call($v, "pair", $at)),
            If(
              LessThan($close, 0),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Comment("The parts: between separators; a comment is a part of its own; in a template, each piece."),
            Comment("A separator that introduces a block (Python's \":\") is inside a part, not between two."),
            Bind($each, Call($is, $at, "Juxtaposed")),
            Bind($parts, List()),
            Bind($separators, List()),
            Var($a, Add($at, 1)),
            For(
              Var($k, Add($at, 1)),
              LessThan($k, $close),
              PostIncrement($k),
              Sequence(
                If(
                  NotEquals(Call($v, "inside", $k), $at),
                  Continue(),
                  Undefined()
                ),
                If(
                  $each,
                  Call(
                    Member($parts, "push"),
                    List(
                      $k,
                      If(
                        GreaterThan(Call($v, "pair", $k), $k),
                        Add(Call($v, "pair", $k), 1),
                        Add($k, 1)
                      )
                    )
                  ),
                  If(
                    Call($is, $k, "Comment"),
                    Sequence(
                      If(
                        GreaterThan($k, $a),
                        Call(Member($parts, "push"), List($a, $k)),
                        Undefined()
                      ),
                      Call(Member($parts, "push"), List($k, Add($k, 1))),
                      Assign($a, Add($k, 1))
                    ),
                    If(
                      And(
                        And(
                          And(
                            And(
                              And(GreaterThan(Call($v, "pair", $k), $k), Call($v, "scope", $k)),
                              Not(Call($v, "alone", $k))
                            ),
                            Call($v, "operandStart", Add(Call($v, "pair", $k), 1))
                          ),
                          Not(Call($is, Add(Call($v, "pair", $k), 1), "Continues"))
                        ),
                        LessThan(Add(Call($v, "pair", $k), 1), $close)
                      ),
                      Sequence(
                        Comment("A block ends what is said: what starts after it is another part."),
                        Call(Member($parts, "push"), List($a, Add(Call($v, "pair", $k), 1))),
                        Assign($a, Add(Call($v, "pair", $k), 1))
                      ),
                      If(
                        And(
                          And(Call($is, $k, "Separator"), Not(Call($v, "scope", Add($k, 1)))),
                          Not(Call($is, Add($k, 1), "Continues"))
                        ),
                        Sequence(
                          If(
                            GreaterThan($k, $a),
                            Call(Member($parts, "push"), List($a, $k)),
                            Undefined()
                          ),
                          Call(Member($separators, "push"), $k),
                          Assign($a, Add($k, 1))
                        ),
                        Undefined()
                      )
                    )
                  )
                ),
                If(
                  GreaterThan(Call($v, "pair", $k), $k),
                  Assign($k, Subtract(Call($v, "pair", $k), 1)),
                  Undefined()
                )
              )
            ),
            If(
              And(Not($each), GreaterThan($close, $a)),
              Call(Member($parts, "push"), List($a, $close)),
              Undefined()
            ),
            Bind($tops,
              Map(
                $parts,
                Lambda(List(List($x, $y)),
                  Sequence(
                    Bind($found, New($Set)),
                    For(
                      Var($k, $x),
                      LessThan($k, $y),
                      PostIncrement($k),
                      Sequence(
                        If(
                          And(Call($is, $k, "Separator"), LessThan(Call($v, "parent", $k), 0)),
                          Continue(),
                          Undefined()
                        ),
                        Var($t, $k),
                        While(
                          And(AtLeast(Call($v, "parent", $t), $x), LessThan(Call($v, "parent", $t), $y)),
                          Assign($t, Call($v, "parent", $t))
                        ),
                        Call(Member($found, "add"), $t),
                        If(
                          GreaterThan(Member($found, "size"), 1),
                          Break(),
                          Undefined()
                        )
                      )
                    ),
                    Return(Concat($found))
                  )
                )
              )
            ),
            Bind($settled, Call(Member($tops, "every"), Lambda(List($t), Equals(Length($t), 1)))),
            Bind($out, List()),
            Bind($link,
              Lambda(List($from, $to, $role),
                Sequence(
                  If(
                    And(AtLeast($from, 0), LessThan(Call($v, "parent", $from), 0)),
                    Call(
                      Member($out, "push"),
                      Call(
                        Member($api, "call"),
                        "Link",
                        $from,
                        $to,
                        Call(Member($api, "call"), $role)
                      )
                    ),
                    Undefined()
                  ),
                  Undefined()
                )
              )
            ),
            Comment("Its parts are the owner's: the brackets are only how they are said."),
            Bind($into,
              Lambda(List($owner),
                Sequence(
                  Call($link, $at, $owner, "Absorbs"),
                  Call($link, $close, $owner, "Absorbs"),
                  ForOf($s, $separators, Call($link, $s, $owner, "Absorbs")),
                  If(
                    $settled,
                    ForOf($t, $tops, Call($link, Index($t, 0), $owner, "Takes")),
                    Undefined()
                  ),
                  Undefined()
                )
              )
            ),
            Comment("It is a word of its own, holding its parts."),
            Bind($word,
              Lambda(List(),
                Sequence(
                  Call($link, $close, $at, "Absorbs"),
                  ForOf($s, $separators, Call($link, $s, $at, "Absorbs")),
                  If(
                    $settled,
                    ForOf($t, $tops, Call($link, Index($t, 0), $at, "Takes")),
                    Undefined()
                  ),
                  Undefined()
                )
              )
            ),
            Bind($transparent,
              Lambda(List(),
                Sequence(
                  If(
                    And(Equals(Length($tops), 1), $settled),
                    Sequence(
                      Call($link, $at, Index(Index($tops, 0), 0), "Absorbs"),
                      Call($link, $close, Index(Index($tops, 0), 0), "Absorbs")
                    ),
                    Undefined()
                  ),
                  Undefined()
                )
              )
            ),
            If(
              Call($v, "scope", $at),
              Sequence(
                Comment("Who the block belongs to: the name whose brackets come just before it (a function, a"),
                Comment("method; with its return type, that type's colon), else the word that leads what is said"),
                Comment("before it (if, for, class, else). After an operator it belongs to no one: it is the"),
                Comment("operator's thing (\"=> { }\")."),
                Bind($stops,
                  Lambda(List($k),
                    Or(
                      Or(Or(Call($is, $k, "Separator"), Call($v, "scope", $k)), Call($is, $k, "Comment")),
                      And(Call($is, $k, "Closer"), Call($v, "scope", Call($v, "pair", $k)))
                    )
                  )
                ),
                Bind($back,
                  Lambda(List($j),
                    If(
                      And(Call($is, $j, "Closer"), AtLeast(Call($v, "pair", $j), 0)),
                      Subtract(Call($v, "pair", $j), 1),
                      Subtract($j, 1)
                    )
                  )
                ),
                Bind($leader,
                  Lambda(List(),
                    Sequence(
                      Var($p, Subtract($at, 1)),
                      If(
                        And(Call($is, $p, "Separator"), NotEquals(Call($head, $at), "Block")),
                        PostDecrement($p),
                        Undefined()
                      ),
                      If(
                        Or(LessThan($p, 0), Call($v, "infix", $p)),
                        Return(Negate(1)),
                        Undefined()
                      ),
                      Var($k, $p),
                      Var($typed, Negate(1)),
                      If(
                        Not(And(Call($is, $k, "Closer"), Equals(Call($head, Call($v, "pair", $k)), "Parens"))),
                        For(
                          Var($j, $k),
                          And(AtLeast($j, 0), Not(Call($stops, $j))),
                          Assign($j, Call($back, $j)),
                          Sequence(
                            If(Call($is, $j, "Opener"), Break(), Undefined()),
                            If(
                              Equals(Call($head, $j), "Returns"),
                              Sequence(
                                Assign($typed, $j),
                                Assign($k, Subtract($j, 1)),
                                Break()
                              ),
                              Undefined()
                            )
                          )
                        ),
                        Undefined()
                      ),
                      If(
                        And(Call($is, $k, "Closer"), Equals(Call($head, Call($v, "pair", $k)), "Parens")),
                        Sequence(
                          Var($g, Subtract(Call($v, "pair", $k), 1)),
                          If(
                            And(Call($is, $g, "Closer"), Equals(Call($head, Call($v, "pair", $g)), "Angles")),
                            Assign($g, Subtract(Call($v, "pair", $g), 1)),
                            Undefined()
                          ),
                          If(
                            And(Call($is, $g, "Name"), Not(Call($v, "infix", $g))),
                            Return(
                              If(
                                Call($v, "prefix", $g),
                                $g,
                                If(AtLeast($typed, 0), $typed, $g)
                              )
                            ),
                            Undefined()
                          )
                        ),
                        Undefined()
                      ),
                      For(
                        Var($j, $p),
                        And(AtLeast($j, 0), Not(Call($stops, $j))),
                        Assign($j, Call($back, $j)),
                        Sequence(
                          If(Call($is, $j, "Opener"), Break(), Undefined()),
                          If(Call($v, "prefix", $j), Return($j), Undefined())
                        )
                      ),
                      Return(Negate(1))
                    )
                  )
                ),
                Bind($owner, Call($leader)),
                If(
                  And(AtLeast($owner, 0), Call($is, $owner, "Prefix")),
                  Call($into, $owner),
                  Sequence(
                    Call($word),
                    If(
                      AtLeast($owner, 0),
                      Call($link, $at, $owner, "Takes"),
                      Undefined()
                    )
                  )
                )
              ),
              If(
                Call($is, $at, "Transparent"),
                Call($transparent),
                If(
                  $each,
                  Call($word),
                  If(
                    Call($is, $at, "Attached"),
                    Sequence(
                      Call($word),
                      If(
                        Call($is, Subtract($at, 1), "Name"),
                        Call($link, $at, Subtract($at, 1), "Takes"),
                        Undefined()
                      )
                    ),
                    If(
                      Call($is, $at, "Postfix"),
                      Sequence(
                        Comment("The thing before it, as an operator after a thing takes it: \"a.b[0]\" indexes a.b."),
                        Call($word),
                        Var($l, Subtract($at, 1)),
                        While(
                          And(
                            And(AtLeast($l, 0), AtLeast(Call($v, "parent", $l), 0)),
                            LessThan(Call($v, "hi", Call($v, "parent", $l)), $at)
                          ),
                          Assign($l, Call($v, "parent", $l))
                        ),
                        Bind($b,
                          If(
                            AtLeast($l, 0),
                            Subtract(Call($v, "lo", $l), 1),
                            Negate(1)
                          )
                        ),
                        If(
                          Call($v, "operandEnd", $b),
                          Return(Call(Member($api, "call"), "List", Spread($out))),
                          Undefined()
                        ),
                        Bind($before,
                          If(
                            And(
                              And(AtLeast($b, 0), Not(GreaterThan(Call($v, "pair", $b), $at))),
                              Or(Call($v, "operator", $b), Call($v, "prefix", $b))
                            ),
                            If(Call($v, "unary", $b), 150, Call($v, "binds", $b)),
                            null
                          )
                        ),
                        If(
                          And(
                            And(
                              And(AtLeast($l, 0), LessThan(Call($v, "parent", $l), 0)),
                              Not(Call($v, "punctuation", $l))
                            ),
                            Or(Equals($before, null), LessThan($before, Otherwise(Call($v, "binds", $at), 200)))
                          ),
                          Call($link, $l, $at, "Takes"),
                          Undefined()
                        )
                      ),
                      Sequence(
                        Var($p, Subtract($at, 1)),
                        If(
                          And(Call($is, $p, "Closer"), Call($is, Call($v, "pair", $p), "Attached")),
                          Assign($p, Subtract(Call($v, "pair", $p), 1)),
                          Undefined()
                        ),
                        Bind($round, Call($is, $at, "Round")),
                        Bind($named, And(And($round, Call($is, $p, "Name")), Not(Call($v, "infix", $p)))),
                        If(
                          And($named, Call($is, $p, "Callable")),
                          Sequence(
                            Comment("A leading word that can also be called (\"import(...)\"): its brackets are said."),
                            Call($word),
                            Call($link, $at, $p, "Takes")
                          ),
                          If(
                            And($named, Call($is, $p, "Heads")),
                            If(
                              Equals(Length($parts), 1),
                              Call($into, $p),
                              Sequence(Call($word), Call($link, $at, $p, "Takes"))
                            ),
                            If(
                              And($named, Not(Call($v, "prefix", $p))),
                              If(
                                Length($parts),
                                Call($into, $p),
                                Sequence(Call($link, $at, $p, "Takes"), Call($link, $close, $at, "Absorbs"))
                              ),
                              If(
                                And($round, Equals(Length($parts), 1)),
                                Call($transparent),
                                Call($word)
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// Goes on from the statement before it. Used as a name, only a name.
Concept(Continues(),
  Realization($word,
    context = Sensing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("A word of the language used as a name is only a name: typed other than as its Concept's"),
            Comment(
              "plain name (\"Set\" beside \"set\"), a member's name (\"x.set\"), a key (\"{ default: 1 }\"), what"
            ),
            Comment("a member is of (\"type.name\"), or, for a word of the language only where it is not a name,"),
            Comment("called (\"get(x)\")."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($words,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 0), "value")),
                "args"
              )
            ),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member($a, "value"))
            ),
            Comment("Each field is a List, one entry a word."),
            Bind($v,
              Lambda(List($k, $i),
                Call(
                  Member(Member($api, "lists"), "at"),
                  Index($field, $k),
                  $i
                )
              )
            ),
            Bind($is,
              Lambda(List($i, $k),
                And(
                  And(
                    AtLeast($i, 0),
                    LessThan($i, Call(Member(Member($api, "lists"), "size"), Member($field, "kinds")))
                  ),
                  Call(
                    Member(Member(Call($v, "kinds", $i), "args"), "some"),
                    Lambda(List($a), Equals(Member($a, "value"), $k))
                  )
                )
              )
            ),
            Bind($text,
              Lambda(List($i),
                If(
                  And(AtLeast($i, 0), LessThan($i, Length($words))),
                  Member(Index(Member(Member(Index($words, $i), "value"), "args"), 0), "value"),
                  ""
                )
              )
            ),
            Bind($head, Call($v, "heads", $at)),
            If(
              Or(Not(Call($is, $at, "Name")), Not($head)),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($typed,
              NotEquals(
                Call($text, $at),
                Add(Call(Member(Index($head, 0), "toLowerCase")), Call(Member($head, "slice"), 1))
              )
            ),
            Bind($member, Or(Equals(Call($text, Subtract($at, 1)), "."), Equals(Call($text, Subtract($at, 1)), "?."))),
            Bind($key,
              And(
                Equals(Call($text, Add($at, 1)), ":"),
                Or(Equals(Call($text, Subtract($at, 1)), "{"), Equals(Call($text, Subtract($at, 1)), ","))
              )
            ),
            Bind($owner, And(Equals(Call($text, Add($at, 1)), "."), Not(Call($is, $at, "Infix")))),
            Bind($called, And(Call($is, $at, "Contextual"), Equals(Call($text, Add($at, 1)), "("))),
            Return(
              If(
                Or(Or(Or(Or($typed, $member), $key), $owner), $called),
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Sense",
                    $at,
                    Call(Member($api, "call"), "Name")
                  )
                ),
                Call(Member($api, "call"), "List")
              )
            )
          )
        )
      )
    )
  ),
  Realization($word,
    context = Hearing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"else\", \"catch\", \"finally\" go on from what was said just before them: they belong to the"),
            Comment("statement before, and take what follows them as any leading word does (\"else if ...\")."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member($a, "value"))
            ),
            Comment("Each field is a List, one entry a word."),
            Bind($v,
              Lambda(List($k, $i),
                Call(
                  Member(Member($api, "lists"), "at"),
                  Index($field, $k),
                  $i
                )
              )
            ),
            Bind($is,
              Lambda(List($i, $k),
                And(
                  And(
                    AtLeast($i, 0),
                    LessThan($i, Call(Member(Member($api, "lists"), "size"), Member($field, "kinds")))
                  ),
                  Call(
                    Member(Member(Call($v, "kinds", $i), "args"), "some"),
                    Lambda(List($a), Equals(Member($a, "value"), $k))
                  )
                )
              )
            ),
            Bind($out, List()),
            Var($p, Subtract($at, 1)),
            While(And(AtLeast($p, 0), Call($is, $p, "Separator")), PostDecrement($p)),
            Var($r, $p),
            While(And(AtLeast($r, 0), AtLeast(Call($v, "parent", $r), 0)), Assign($r, Call($v, "parent", $r))),
            Comment("Once that statement is one thing, led by a word that leads (not yet by something that"),
            Comment("itself goes on from before, which will find its own place first)."),
            If(
              And(And(AtLeast($r, 0), Call($is, $r, "Prefix")), Not(Call($is, $r, "Continues"))),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  $at,
                  $r,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            Bind($leads,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Object(head = "Prefix", args = Member($self, "args")),
                  Member($api, "context")
                )
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "List",
                Spread($out),
                Spread(
                  If(
                    And($leads, Equals(Member($leads, "head"), "List")),
                    Map(Member($leads, "args"), Lambda(List($a), Member($a, "value"))),
                    List()
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

// "a ? b : c": finds its ":", then takes what is asked and the two answers.
Concept(Question(),
  Realization($word,
    context = Sensing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"a ? b : c\": the question takes what is asked before it, and holds what is between it and"),
            Comment("its \":\" and what follows the \":\" as the two answers."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member($a, "value"))
            ),
            Comment("Each field is a List, one entry a word."),
            Bind($v,
              Lambda(List($k, $i),
                Call(
                  Member(Member($api, "lists"), "at"),
                  Index($field, $k),
                  $i
                )
              )
            ),
            If(
              AtLeast(Call($v, "pair", $at), 0),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Sequence(
              Comment("Its \":\": the first where the brackets between have closed and any question asked between"),
              Comment("has had its own."),
              Bind($n, Call(Member(Member($api, "lists"), "size"), Member($field, "kinds"))),
              Bind($is,
                Lambda(List($i, $k),
                  And(
                    And(AtLeast($i, 0), LessThan($i, $n)),
                    Call(
                      Member(Member(Call($v, "kinds", $i), "args"), "some"),
                      Lambda(List($a), Equals(Member($a, "value"), $k))
                    )
                  )
                )
              ),
              Var($asked, 0),
              For(
                Var($k, Add($at, 1)),
                LessThan($k, $n),
                PostIncrement($k),
                Sequence(
                  Bind($p, Call($v, "pair", $k)),
                  If(
                    GreaterThan($p, $k),
                    Sequence(Assign($k, $p), Continue()),
                    Undefined()
                  ),
                  If(
                    And(Call($is, $k, "Closer"), LessThan($p, 0)),
                    Break(),
                    Undefined()
                  ),
                  Comment("A bracket between that has not found its closer yet: wait for it."),
                  If(
