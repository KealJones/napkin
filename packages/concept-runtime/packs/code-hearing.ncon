                      If(
                        Equals($t, ">"),
                        PostDecrement($depth),
                        If(
                          Or(Or(Equals($t, "("), Equals($t, "[")), Equals($t, "{")),
                          PostIncrement($round),
                          If(
                            Or(Or(Equals($t, ")"), Equals($t, "]")), Equals($t, "}")),
                            Sequence(
                              Comment("A bracket that closes one opened before me: I was not around it."),
                              If(LessThan(PreDecrement($round), 0), Break(), Undefined())
                            ),
                            If(
                              Not(
                                Or(
                                  Or(Or(Call($is, $j, "Name"), Call($is, $j, "Text")), Call($is, $j, "Number")),
                                  And(Call($is, $j, "Symbol"), Call(Member($CALM, "has"), $t))
                                )
                              ),
                              Break(),
                              Undefined()
                            )
                          )
                        )
                      )
                    ),
                    If(
                      Equals($depth, 0),
                      Sequence(
                        If(
                          And(Equals($t, ">"), Equals($round, 0)),
                          Return(
                            Call(
                              Member($api, "call"),
                              "List",
                              Call(
                                Member($api, "call"),
                                "Sense",
                                $at,
                                Call(Member($api, "call"), "Angles")
                              ),
                              Call(
                                Member($api, "call"),
                                "Link",
                                $j,
                                $at,
                                Call(Member($api, "call"), "Closes")
                              )
                            )
                          ),
                          Undefined()
                        ),
                        Break()
                      ),
                      Undefined()
                    )
                  )
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List"))
          )
        )
      )
    )
  )
)

