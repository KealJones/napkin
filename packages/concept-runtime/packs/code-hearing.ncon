            Bind($said,
              Call(Member(Member($member, "args"), "find"), Lambda(List($a), Equals(Member($a, "name"), "said")))
            ),
            Bind($name,
              If(
                $said,
                Member($said, "value"),
                Add(
                  Call(Member(Index(Member($member, "head"), 0), "toLowerCase")),
                  Call(Member(Member($member, "head"), "slice"), 1)
                )
              )
            ),
            Bind($got, Call(Member($api, "call"), "Member", $of, $name)),
            Bind($values, List()),
            Var($called, false),
            ForOf(
              $a,
              Member($member, "args"),
              Sequence(
                If(
                  NotEquals(Member($a, "name"), Undefined()),
                  Continue(),
                  Undefined()
                ),
                If(
                  And(
                    And(Call($isCall, Member($a, "value")), Equals(Member(Member($a, "value"), "head"), "Parens")),
                    Equals(Length(Member(Member($a, "value"), "args")), 0)
                  ),
                  Assign($called, true),
                  If(
                    Not(And(Call($isCall, Member($a, "value")), Equals(Member(Member($a, "value"), "head"), "Angles"))),
                    Call(
                      Member($values, "push"),
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Member($a, "value"),
                          Member($api, "context")
                        )
                      )
                    ),
                    Undefined()
                  )
                )
              )
            ),
            Comment("The language's reading rules for members by name (javascript.ncon's From rules)."),
            Bind($field,
              Lambda(List($e, $k),
                If(
                  Call($isCall, $e),
                  Call(Member(Member($e, "args"), "find"), Lambda(List($a), Equals(Member($a, "name"), $k))),
                  Undefined()
                )
              )
            ),
            Bind($text,
              Lambda(List($e),
                Sequence(
                  Bind($n, Call($field, $e, "name")),
                  Bind($t,
                    If(
                      And(
                        And($n, Call($isCall, Member($n, "value"))),
                        Equals(Member(Member($n, "value"), "head"), "JsIdentifier")
                      ),
                      Call($field, Member($n, "value"), "text"),
                      Undefined()
                    )
