                )
              )
            ),
            Bind($head, Lambda(List($i), Call($v, "heads", $i))),
            Bind($pair,
              Lambda(List($i),
                If(
                  Equals(Call($v, "pair", $i), Undefined()),
                  Negate(1),
                  Call($v, "pair", $i)
                )
              )
            ),
            Comment("As the kind of word it also is: what it does when it is not the case here."),
            Bind($as,
              Lambda(List($kind),
                Call(
                  Member($api, "evaluate"),
                  Object(head = $kind, args = Member($self, "args")),
                  Member($api, "context")
                )
              )
            ),
            Bind($sense,
              Lambda(List($h),
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Sense",
                    $at,
                    Call(Member($api, "call"), $h)
                  )
                )
              )
            ),
            Comment("A thing ends here: a name that is no operator, a value, a closed bracket."),
            Bind($ends,
              Lambda(List($i),
                Or(
                  Or(
                    Or(
                      Or(
                        And(And(Call($is, $i, "Name"), Not(Call($is, $i, "Infix"))), Not(Call($is, $i, "Prefix"))),
                        Call($is, $i, "Number")
                      ),
                      Call($is, $i, "Text")
                    ),
                    Call($is, $i, "Regex")
                  ),
                  And(
                    And(
                      And(Call($is, $i, "Closer"), NotEquals(Call($head, $i), "Dedent")),
                      NotEquals(Call($head, $i), null)
                    ),
                    Not(Call($is, Call($pair, $i), "Infix"))
                  )
                )
              )
            ),
            Comment("Round brackets that head a statement: \"if (x)\"."),
            Bind($header,
              Lambda(List($i),
                And(
                  And(Call($is, $i, "Closer"), GreaterThan(Call($pair, $i), 0)),
                  Call($is, Subtract(Call($pair, $i), 1), "Heads")
                )
              )
            ),
            If(
              LessThan(Call($pair, $at), 0),
              Return(
                Call(
                  Member($api, "call"),
                  "List",
                  Call(Member($api, "call"), "Waits"),
                  Spread(Map(Member(Await(Call($as, "Opener")), "args"), Lambda(List($a), Member($a, "value"))))
                )
              ),
              Undefined()
            ),
            Bind($p, Subtract($at, 1)),
            Bind($applied,
              And(
                And(
                  And(
                    And(And(Call($is, $p, "Closer"), Not(Call($header, $p))), NotEquals(Call($head, $p), null)),
                    AtLeast(Call($pair, $p), 0)
                  ),
                  Not(Call($is, Call($pair, $p), "Scope"))
                ),
                Not(Call($is, Call($pair, $p), "Attached"))
              )
            ),
            Return(
              If(
                $applied,
                Call($sense, "Apply"),
                Call(Member($api, "call"), "List")
              )
            )
          )
        )
      )
    )
  )
)

// Reading what was heard as the code IR, where that works something out: each Concept's own, from
// read/<Concept>.js (read/<Concept>.<Language>.js for one language only). Readings that only say
// it with other Concepts are packs/codereadings.ncon.
Concept(Angles(),
  Realization($word,
    context = Context(Code($language), Reading()),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Comment("An identifier's first part is how it was written; what follows is what it took."),
            Bind($positional,
              Lambda(List($e),
                Sequence(
                  Bind($xs,
                    Map(
                      Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                      Lambda(List($a), Member($a, "value"))
                    )
                  ),
                  Return(
                    If(
                      Equals(Member($e, "head"), "Identifier"),
                      Call(Member($xs, "slice"), 1),
                      $xs
                    )
                  )
                )
              )
            ),
            Bind($parts, Call($positional, $self)),
            Bind($named,
              Lambda(List($k),
                Sequence(
                  Bind($a,
                    Call(Member(Member($self, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $k)))
                  ),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($read, Lambda(List($e), Call(Member($api, "evaluate"), $e, Member($api, "context")))),
            Bind($ask,
              Lambda(List($head, Spread($xs)),
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), $head, Spread($xs)),
                  Member($api, "context")
                )
              )
            ),
            Bind($nameOf,
              Lambda(List($e),
                Sequence(
                  If(Equals(TypeOf($e), "string"), Return($e), Undefined()),
                  If(
                    Not(Call($isCall, $e)),
                    Return(Call($String, $e)),
                    Undefined()
                  ),
                  If(
                    Equals(Member($e, "head"), "Identifier"),
                    Return(Member(Index(Member($e, "args"), 0), "value")),
                    Undefined()
                  ),
                  Return(
                    Add(
                      Call(Member(Index(Member($e, "head"), 0), "toLowerCase")),
                      Call(Member(Member($e, "head"), "slice"), 1)
                    )
                  )
                )
              )
            ),
            Bind($variable, Lambda(List($e), Call(Member($api, "fromHost"), Object(variable = Call($nameOf, $e))))),
            Bind($is, Lambda(List($e, $head), And(Call($isCall, $e), Equals(Member($e, "head"), $head)))),
            Comment("Types a name is used at, kept as said."),
            Return($self)
          )
        )
      )
    )
  )
)

Concept(Apply(),
  Realization($word,
    context = Context(Code($language), Reading()),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
