// SPIKE (spike/hear-code-words): code heard the way a message is. Each word of the code is
// its own Concept and hears under Hearing(Code(<language>)): an operator takes the things either
// side of it, a leading word takes what follows, a bracket groups, a block belongs to the word
// that leads it. The heard words then realize, under Context(Code(<language>), Reading()), as
// the code IR (ForOf, Func, If, Call ...), which the language packs write out. Written from the
// JavaScript in scratch/code-hearing by gen.mjs.
Requires(Hearing(), Code(), Python(), TypeScript())

// How a language lays its words out.
Concept(Python(), Comments("#"), Offside())

Concept(JavaScript(),
  Comments("//", "/*"),
  Templates("`"),
  RegexLiterals()
)

Concept(TypeScript(),
  Comments("//", "/*"),
  Templates("`"),
  RegexLiterals()
)

// What code's words are, for hearing.
Concept(CodeWord(), IsA(Category()))

// Code heard: its words, the links they find in rounds, each word written as its Concept.
Concept(Hear(),
  Realization(Hear($text),
    context = Context(Execution(), Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("Code heard as a message is: each word is its own Concept, and the words find each other in"),
            Comment("rounds. The language is the context (Code(Python())), so a word hears as it does there."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($text, Call($String, Call(Member($api, "toHost"), Member(Index($args, 0), "value")))),
            Bind($facets,
              If(
                And(Call($isCall, Member($api, "context")), Equals(Member(Member($api, "context"), "head"), "Context")),
                Map(Member(Member($api, "context"), "args"), Lambda(List($a), Member($a, "value"))),
                List(Member($api, "context"))
              )
            ),
            Bind($code,
              Call(
                Member($facets, "find"),
                Lambda(List($f), And(Call($isCall, $f), Equals(Member($f, "head"), "Code")))
              )
            ),
            Bind($language, Member(Index(Member($code, "args"), 0), "value")),
            Bind($hearing, Call(Member($api, "call"), "Hearing", $code)),
            Bind($same,
              Lambda(List($a, $b), Equals(Call(Member($api, "format"), $a), Call(Member($api, "format"), $b)))
            ),
            Comment("A relation holds here when it holds everywhere or in this language; this language's wins."),
            Bind($holds,
              Lambda(List($r),
                Or(Equals(Member($r, "context"), Undefined()), Call($same, Member($r, "context"), $code))
              )
            ),
            Bind($claims,
              Lambda(List($identity, $head),
                Sequence(
                  Bind($unit, Call(Member(Member($api, "store"), "get"), $identity)),
                  Bind($found,
                    If(
                      $unit,
                      Filter(
                        Member($unit, "relations"),
                        Lambda(List($r),
                          And(
                            And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), $head)),
                            Call($holds, $r)
                          )
                        )
                      ),
                      List()
                    )
                  ),
                  Return(
                    Map(
                      Concat(
                        Filter($found, Lambda(List($r), NotEquals(Member($r, "context"), Undefined()))),
                        Filter($found, Lambda(List($r), Equals(Member($r, "context"), Undefined())))
                      ),
                      Lambda(List($r), Member($r, "claim"))
                    )
                  )
                )
              )
            ),
            Bind($first,
              Lambda(List($identity, $head),
                Sequence(
                  Bind($c, Index(Call($claims, $identity, $head), 0)),
                  Return(
                    If(
                      And($c, Length(Member($c, "args"))),
                      Member(Index(Member($c, "args"), 0), "value"),
                      If($c, true, Undefined())
                    )
                  )
                )
              )
            ),
            Comment("How the language lays its text out: comments, indentation, templates, regular expressions."),
            Bind($comments,
              FlatMap(
                Call($claims, Member($language, "head"), "Comments"),
                Lambda(List($c), Map(Member($c, "args"), Lambda(List($a), Member($a, "value"))))
              )
            ),
            Bind($offside, GreaterThan(Length(Call($claims, Member($language, "head"), "Offside")), 0)),
            Bind($templates, Call($first, Member($language, "head"), "Templates")),
            Bind($regex, GreaterThan(Length(Call($claims, Member($language, "head"), "RegexLiterals")), 0)),
            Comment("A symbol is the word the graph says it spells: \"+\" is Plus."),
            Bind($spelled, New($Map)),
            ForOf(
              $unit,
              Call(Member(Member($api, "store"), "all")),
              ForOf(
                $r,
                Member($unit, "relations"),
                Sequence(
                  If(
                    Or(
                      Or(
                        Not(Call($isCall, Member($r, "claim"))),
                        NotEquals(Member(Member($r, "claim"), "head"), "Spelled")
                      ),
                      Not(Call($holds, $r))
                    ),
                    Continue(),
                    Undefined()
                  ),
                  Bind($s, Member(Index(Member(Member($r, "claim"), "args"), 0), "value")),
                  If(
                    Or(Not(Call(Member($spelled, "has"), $s)), NotEquals(Member($r, "context"), Undefined())),
                    Call(Member($spelled, "set"), $s, Member($unit, "identity")),
                    Undefined()
                  )
                )
              )
            ),
            Comment("Where a \"/\" may begin a regular expression after a name: after the language's words that"),
            Comment("lead or join (\"return /x/\")."),
            Bind($leading, List()),
            ForOf(
              $unit,
              Call(Member(Member($api, "store"), "all")),
              If(
                Call(
                  Member(Member($unit, "relations"), "some"),
                  Lambda(List($r),
                    And(
                      And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), "Keyword")),
                      Call($holds, $r)
                    )
                  )
                ),
                Call(
                  Member($leading, "push"),
                  Add(
                    Call(Member(Index(Member($unit, "identity"), 0), "toLowerCase")),
                    Call(Member(Member($unit, "identity"), "slice"), 1)
                  )
                ),
                Undefined()
              )
            ),
            Bind($said,
              Call(
                Member($api, "codeWords"),
                $text,
                Object(
                  spellings = Concat(Call(Member($spelled, "keys"))),
                  comments = $comments,
                  offside = $offside,
                  templates = $templates,
                  regex = $regex,
                  regexAfter = $leading
                )
              )
            ),
            Bind($n, Length($said)),
            Comment("A name is its Concept (\"print\" is Print); layout is a word too (Newline, Indent, Dedent)."),
            Bind($upper, Lambda(List($t), Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1)))),
            Bind($LAYOUT,
              Object(
                newline = "Newline",
                indent = "Indent",
                dedent = "Dedent",
                template = "Template",
                Pair("template-end", "TemplateEnd")
              )
            ),
            Bind($heads,
              Map(
                $said,
                Lambda(List($w),
                  If(
                    Equals(Member($w, "kind"), "name"),
                    Call($upper, Member($w, "text")),
                    If(
                      Equals(Member($w, "kind"), "symbol"),
                      Call(Member($spelled, "get"), Member($w, "text")),
                      Index($LAYOUT, Member($w, "kind"))
                    )
                  )
                )
              )
            ),
            Comment("What the graph knows a word is, as code, here: its kinds."),
            Bind($known, New($Map)),
            Bind($kindsOf,
              Lambda(List($head),
                Sequence(
                  If(
                    Call(Member($known, "has"), $head),
                    Return(Call(Member($known, "get"), $head)),
                    Undefined()
                  ),
                  Bind($out, List()),
                  Bind($seen, New($Set)),
                  Var($frontier, If($head, List($head), List())),
                  While(
                    And(Length($frontier), LessThan(Member($seen, "size"), 32)),
                    Sequence(
                      Bind($next, List()),
                      ForOf(
                        $id,
                        $frontier,
                        Sequence(
                          If(Call(Member($seen, "has"), $id), Continue(), Undefined()),
                          Call(Member($seen, "add"), $id),
                          ForOf(
                            $k,
                            Map(
                              Call($claims, $id, "IsA"),
                              Lambda(List($c), Member(Index(Member($c, "args"), 0), "value"))
                            ),
                            Sequence(
                              If(Not(Call($isCall, $k)), Continue(), Undefined()),
                              If(
                                Call(
                                  Member(Call($claims, Member($k, "head"), "IsA"), "some"),
                                  Lambda(List($x),
                                    And(
                                      Call($isCall, Member(Index(Member($x, "args"), 0), "value")),
                                      Equals(Member(Member(Index(Member($x, "args"), 0), "value"), "head"), "CodeWord")
                                    )
                                  )
                                ),
                                Call(Member($out, "push"), Member($k, "head")),
                                Undefined()
                              ),
                              Call(Member($next, "push"), Member($k, "head"))
                            )
                          )
                        )
                      ),
                      Assign($frontier, $next)
                    )
                  ),
                  Call(Member($known, "set"), $head, $out),
                  Return($out)
                )
              )
            ),
            Bind($SHAPE,
              Object(
                name = "Name",
                number = "Number",
                text = "Text",
                comment = "Comment",
                regex = "Regex"
              )
            ),
            Comment("A name is a word of the language only where the language says it is one (Keyword):"),
            Comment("\"comma\" and \"not\" are names in TypeScript, \"not\" a word in Python."),
            Bind($keyword, Lambda(List($head), GreaterThan(Length(Call($claims, Or($head, ""), "Keyword")), 0))),
            Bind($kinds,
              Call(
                Member($said, "map"),
                Lambda(List($w, $i),
                  Concat(
                    List(Otherwise(Index($SHAPE, Member($w, "kind")), "Symbol")),
                    If(
                      Or(NotEquals(Member($w, "kind"), "name"), Call($keyword, Index($heads, $i))),
                      Call($kindsOf, Index($heads, $i)),
                      List()
                    )
                  )
                )
              )
            ),
            Comment("A word typed other than as its Concept's plain name (\"Set\" beside \"set\"), a member's name"),
            Comment("(\"x.set\"), or a key (\"{ default: 1 }\") is a name, whatever the word is elsewhere."),
            Bind($is0, Lambda(List($i, $k), Includes(Index($kinds, $i), $k))),
            For(
              Var($i, 0),
              LessThan($i, $n),
              PostIncrement($i),
              Sequence(
                Bind($w, Index($said, $i)),
                If(
                  Or(NotEquals(Member($w, "kind"), "name"), Equals(Length(Index($kinds, $i)), 1)),
                  Continue(),
                  Undefined()
                ),
                Bind($member,
                  And(
                    And(GreaterThan($i, 0), Equals(Member(Index($said, Subtract($i, 1)), "kind"), "symbol")),
                    Or(
                      Equals(Member(Index($said, Subtract($i, 1)), "text"), "."),
                      Equals(Member(Index($said, Subtract($i, 1)), "text"), "?.")
                    )
                  )
                ),
                Bind($key,
                  And(
                    And(
                      And(
                        And(
                          And(LessThan(Add($i, 1), $n), Equals(Member(Index($said, Add($i, 1)), "kind"), "symbol")),
                          Equals(Member(Index($said, Add($i, 1)), "text"), ":")
                        ),
                        GreaterThan($i, 0)
                      ),
                      Equals(Member(Index($said, Subtract($i, 1)), "kind"), "symbol")
                    ),
                    Or(
                      Equals(Member(Index($said, Subtract($i, 1)), "text"), "{"),
                      Equals(Member(Index($said, Subtract($i, 1)), "text"), ",")
                    )
                  )
                ),
                Bind($owner,
                  And(
                    And(
                      And(LessThan(Add($i, 1), $n), Equals(Member(Index($said, Add($i, 1)), "kind"), "symbol")),
                      Equals(Member(Index($said, Add($i, 1)), "text"), ".")
                    ),
                    Not(Call($is0, $i, "Infix"))
                  )
                ),
                Comment("A word of the language only where not used as a name, called: \"get(x)\" calls get."),
                Bind($called,
                  And(
                    And(
                      And(Call($is0, $i, "Contextual"), LessThan(Add($i, 1), $n)),
                      Equals(Member(Index($said, Add($i, 1)), "kind"), "symbol")
                    ),
                    Equals(Member(Index($said, Add($i, 1)), "text"), "(")
                  )
                ),
                If(
                  Or(
                    Or(
                      Or(
                        Or(
                          NotEquals(
                            Member($w, "text"),
                            Add(
                              Call(Member(Index(Index($heads, $i), 0), "toLowerCase")),
                              Call(Member(Index($heads, $i), "slice"), 1)
                            )
                          ),
                          $member
                        ),
                        $key
                      ),
                      $owner
                    ),
                    $called
                  ),
                  Assign(Index($kinds, $i), List("Name")),
                  Undefined()
                )
              )
            ),
            Bind($is, Lambda(List($i, $k), And(And(AtLeast($i, 0), LessThan($i, $n)), Includes(Index($kinds, $i), $k)))),
            Bind($become,
              Lambda(List($i, $head),
                Sequence(
                  Assign(Index($heads, $i), $head),
                  Assign(
                    Index($kinds, $i),
                    Concat(
                      List(Otherwise(Index($SHAPE, Member(Index($said, $i), "kind")), "Symbol")),
                      Call($kindsOf, $head)
                    )
                  ),
                  Undefined()
                )
              )
            ),
            Comment("A thing ends here: a name that is no operator, a value, a closed bracket."),
            Bind($ends,
              Lambda(List($i),
                Or(
                  Or(
                    Or(
                      Or(
                        Or(
                          And(And(Call($is, $i, "Name"), Not(Call($is, $i, "Infix"))), Not(Call($is, $i, "Prefix"))),
                          Call($is, $i, "Number")
                        ),
                        Call($is, $i, "Text")
                      ),
                      Call($is, $i, "Regex")
                    ),
                    And(
                      And(Call($is, $i, "Closer"), Not(Call($is, $i, "Dedent"))),
                      NotEquals(Index($heads, $i), Undefined())
                    )
                  ),
                  And(
                    And(
                      And(
                        And(
                          And(
                            And(Call($is, $i, "Unary"), Equals(Member(Index($said, $i), "kind"), "symbol")),
                            GreaterThan($i, 0)
                          ),
                          Call($ends, Subtract($i, 1))
                        ),
                        Index($said, Add($i, 1))
                      ),
                      Equals(Member(Index($said, Add($i, 1)), "kind"), "symbol")
                    ),
                    Includes("[.(", Index(Member(Index($said, Add($i, 1)), "text"), 0))
                  )
                )
              )
            ),
            Comment("Where a bracket stands says which it is. \"[\" after a thing is that thing's index. \"<\""),
            Comment("right after a name, closing on \">\" around nothing that computes, is the name's angles."),
            Comment("A \"{\" where a thing can start is a value; where a statement starts, or after what a"),
            Comment("block follows, a block. Where indentation makes blocks, a brace is always a value."),
            Bind($CALM,
              New(
                $Set,
                List(
                  ",",
                  ".",
                  "[",
                  "]",
                  "|",
                  "&",
                  "?",
                  ":",
                  "?:",
                  "(",
                  ")",
                  "=>",
                  "{",
                  "}",
                  ";",
                  "...",
                  "<",
                  ">",
                  "\n"
                )
              )
            ),
            For(
              Var($i, 0),
              LessThan($i, $n),
              PostIncrement($i),
              Sequence(
                Comment("A colon that opens a block (Python's) only separates the block from what leads it."),
                If(
                  And(Equals(Index($heads, $i), "Colon"), Call($is, Add($i, 1), "Scope")),
                  Assign(Index($kinds, $i), List("Symbol", "Separator")),
                  Undefined()
                )
              )
            ),
            For(
              Var($i, 1),
              LessThan($i, $n),
              PostIncrement($i),
              Sequence(
                Comment("A colon right after round brackets says what they give: \"(x): number\"."),
                If(
                  And(
                    And(Equals(Index($heads, $i), "Colon"), Call($is, $i, "Infix")),
                    Equals(Member(Index($said, Subtract($i, 1)), "text"), ")")
                  ),
                  Call($become, $i, "Returns"),
                  Undefined()
                ),
                If(
                  And(
                    And(Equals(Index($heads, $i), "Less"), Call($is, Subtract($i, 1), "Name")),
                    Not(Call($is, Subtract($i, 1), "Infix"))
                  ),
                  Sequence(
                    Var($depth, 0),
                    Var($j, $i),
                    For(
                      Undefined(),
                      And(LessThan($j, $n), LessThan($j, Add($i, 200))),
                      PostIncrement($j),
                      Sequence(
                        Bind($t, Index($said, $j)),
                        If(
                          And(Equals(Member($t, "kind"), "symbol"), Equals(Member($t, "text"), "<")),
                          PostIncrement($depth),
                          If(
                            And(Equals(Member($t, "kind"), "symbol"), Equals(Member($t, "text"), ">")),
                            PostDecrement($depth),
                            If(
                              Not(
                                Or(
                                  Or(
                                    Or(Equals(Member($t, "kind"), "name"), Equals(Member($t, "kind"), "text")),
                                    Equals(Member($t, "kind"), "number")
                                  ),
                                  And(
                                    Equals(Member($t, "kind"), "symbol"),
                                    Call(Member($CALM, "has"), Member($t, "text"))
                                  )
                                )
                              ),
                              Break(),
                              Undefined()
                            )
                          )
                        ),
                        If(Equals($depth, 0), Break(), Undefined())
                      )
                    ),
                    If(
                      And(And(Equals($depth, 0), LessThan($j, $n)), Equals(Member(Index($said, $j), "text"), ">")),
                      Sequence(Call($become, $i, "Angles"), Call($become, $j, "AngleEnd")),
                      Undefined()
                    )
                  ),
                  Undefined()
                )
              )
            ),
            Comment("Brackets pair by counting, as any bracket is read; an opener that says what closes it"),
            Comment("(ClosedBy: \"?\" by \":\", angles by their end) is closed only by that."),
            Bind($pair, Map($said, Lambda(List(), Negate(1)))),
            Bind($inside, Map($said, Lambda(List(), Negate(1)))),
            Bind($open, List()),
            Bind($closedBy, Lambda(List($i), Call($first, Or(Index($heads, $i), ""), "ClosedBy"))),
            Bind($blockAt,
              Lambda(List($i),
                Sequence(
                  If($offside, Return(false), Undefined()),
                  Bind($p, Subtract($i, 1)),
                  If(LessThan($p, 0), Return(true), Undefined()),
                  If(Call($is, $p, "TakesBlock"), Return(true), Undefined()),
                  If(
                    Call($is, $p, "Separator"),
                    Return(
                      Or(
                        Or(LessThan(Index($inside, $p), 0), Call($is, Index($inside, $p), "Scope")),
                        Equals(Index($heads, $p), "Semicolon")
                      )
                    ),
                    Undefined()
                  ),
                  If(
                    Call($is, $p, "Opener"),
                    Return(Call($is, $p, "Scope")),
                    Undefined()
                  ),
                  Comment("After a signature's type (\"f(): string[] {\", \"(): void {\"), a brace is the block the"),
                  Comment("type is of: look back along what is said for the colon that follows round brackets."),
                  Comment("Right after the colon, the brace is the type itself (\"(): { a: T } {\")."),
                  If(
                    Equals(Index($heads, $p), "Returns"),
                    Return(false),
                    Undefined()
                  ),
                  For(
                    Var($j, $p),
                    AtLeast($j, 0),
                    Assign(
                      $j,
                      If(
                        And(Call($is, $j, "Closer"), AtLeast(Index($pair, $j), 0)),
                        Subtract(Index($pair, $j), 1),
                        Subtract($j, 1)
                      )
                    ),
                    Sequence(
                      If(
                        Equals(Index($heads, $j), "Returns"),
                        Return(true),
                        Undefined()
                      ),
                      If(
                        Or(
                          Or(
                            Or(
                              Or(Call($is, $j, "Separator"), Call($is, $j, "Scope")),
                              And(
                                Call($is, $j, "Opener"),
                                Not(And(AtLeast(Index($pair, $j), 0), LessThan(Index($pair, $j), $i)))
                              )
                            ),
                            Equals(Index($heads, $j), "Arrow")
                          ),
                          Equals(Index($heads, $j), "Assign")
                        ),
                        Break(),
                        Undefined()
                      )
                    )
                  ),
                  Comment("After round brackets, a block, or angles (\"f(x) {\", \"} {\", \"A<T> {\"): a block."),
                  If(
                    Call($is, $p, "Closer"),
                    Return(
                      And(
                        AtLeast(Index($pair, $p), 0),
                        Or(
                          Or(Call($is, Index($pair, $p), "Round"), Call($is, Index($pair, $p), "Scope")),
                          Call($is, Index($pair, $p), "Attached")
                        )
                      )
                    ),
                    Undefined()
                  ),
                  Return(Or(Call($ends, $p), Call($is, $p, "Comment")))
                )
              )
            ),
            For(
              Var($i, 0),
              LessThan($i, $n),
              PostIncrement($i),
              Sequence(
                If(
                  And(Equals(Index($heads, $i), "Braces"), Call($blockAt, $i)),
                  Call($become, $i, "Block"),
                  Undefined()
                ),
                Assign(
                  Index($inside, $i),
                  If(
                    Length($open),
                    Index($open, Subtract(Length($open), 1)),
                    Negate(1)
                  )
                ),
                Bind($top,
                  If(
                    Length($open),
                    Index($open, Subtract(Length($open), 1)),
                    Negate(1)
                  )
                ),
                Bind($wanted, If(AtLeast($top, 0), Call($closedBy, $top), Undefined())),
                If(
                  And(
                    And($wanted, Call($isCall, $wanted)),
                    Or(
                      Equals(Member($wanted, "head"), Index($heads, $i)),
                      And(Equals(Member($wanted, "head"), "Colon"), Equals(Index($heads, $i), "Returns"))
                    )
                  ),
                  Sequence(
                    Call(Member($open, "pop")),
                    Assign(Index($pair, $top), $i),
                    Assign(Index($pair, $i), $top),
                    Assign(
                      Index($inside, $i),
                      If(
                        Length($open),
                        Index($open, Subtract(Length($open), 1)),
                        Negate(1)
                      )
                    ),
                    Assign(
                      Index($kinds, $i),
                      Concat(
                        Filter(
                          Index($kinds, $i),
                          Lambda(List($k), And(NotEquals($k, "Infix"), NotEquals($k, "Separator")))
                        ),
                        List("Closer")
                      )
                    ),
                    Comment("It only closes: what it does elsewhere (\"a: b\") it does not do here."),
                    If(
                      Not(Includes(Call($kindsOf, Index($heads, $i)), "Closer")),
                      Assign(Index($heads, $i), Undefined()),
                      Undefined()
                    ),
                    Continue()
                  ),
                  Undefined()
                ),
                If(
                  Call($is, $i, "Closer"),
                  Sequence(
                    While(
                      And(Length($open), Call($closedBy, Index($open, Subtract(Length($open), 1)))),
                      Call(Member($open, "pop"))
                    ),
                    If(
                      Length($open),
                      Sequence(
                        Bind($o, Call(Member($open, "pop"))),
                        Assign(Index($pair, $o), $i),
                        Assign(Index($pair, $i), $o)
                      ),
                      Undefined()
                    ),
                    Assign(
                      Index($inside, $i),
                      If(
                        Length($open),
                        Index($open, Subtract(Length($open), 1)),
                        Negate(1)
                      )
                    )
                  ),
                  Undefined()
                ),
                If(
                  Call($is, $i, "Opener"),
                  Call(Member($open, "push"), $i),
                  Undefined()
                )
              )
            ),
            Comment("\"[\" after a thing (not after a header, \"if (x) [a, b] = ...\") is that thing's index."),
            For(
              Var($i, 1),
              LessThan($i, $n),
              PostIncrement($i),
              Sequence(
                Bind($header,
                  And(
                    And(Call($is, Subtract($i, 1), "Closer"), GreaterThan(Index($pair, Subtract($i, 1)), 0)),
                    Call(
                      $is,
                      Subtract(Index($pair, Subtract($i, 1)), 1),
                      "Heads"
                    )
                  )
                ),
                If(
                  And(And(Equals(Index($heads, $i), "Brackets"), Call($ends, Subtract($i, 1))), Not($header)),
                  Call($become, $i, "Index"),
                  Undefined()
                )
              )
            ),
            Comment("Who a block belongs to: the name whose brackets come just before it (a function, a"),
            Comment("method; with its return type, that type's colon), else the word that leads what is"),
            Comment("said before it (if, for, class, else). After an operator it belongs to no one: it is"),
            Comment("the operator's thing (\"=> { }\")."),
            Bind($leader, Map($said, Lambda(List(), Negate(1)))),
            Bind($stops,
              Lambda(List($k),
                Or(
                  Or(Or(Call($is, $k, "Separator"), Call($is, $k, "Scope")), Call($is, $k, "Comment")),
                  And(Call($is, $k, "Closer"), Call($is, Index($pair, $k), "Scope"))
                )
              )
            ),
            For(
              Var($o, 0),
              LessThan($o, $n),
              PostIncrement($o),
              Sequence(
                If(Not(Call($is, $o, "Scope")), Continue(), Undefined()),
                Var($p, Subtract($o, 1)),
                If(
                  And(Call($is, $p, "Separator"), $offside),
                  PostDecrement($p),
                  Undefined()
                ),
                If(
                  Or(LessThan($p, 0), Call($is, $p, "Infix")),
                  Continue(),
                  Undefined()
                ),
                Var($k, $p),
                Var($typed, Negate(1)),
                If(
                  Not(And(Call($is, $k, "Closer"), Equals(Index($heads, Index($pair, $k)), "Parens"))),
                  For(
                    Var($j, $k),
                    And(AtLeast($j, 0), Not(Call($stops, $j))),
                    Assign(
                      $j,
                      If(
                        And(Call($is, $j, "Closer"), AtLeast(Index($pair, $j), 0)),
                        Subtract(Index($pair, $j), 1),
                        Subtract($j, 1)
                      )
                    ),
                    Sequence(
                      If(Call($is, $j, "Opener"), Break(), Undefined()),
                      If(
                        Equals(Index($heads, $j), "Returns"),
                        Sequence(
                          Assign($typed, $j),
                          Assign($k, Subtract($j, 1)),
                          Break()
                        ),
                        Undefined()
                      )
                    )
                  ),
                  Undefined()
                ),
                If(
                  And(Call($is, $k, "Closer"), Equals(Index($heads, Index($pair, $k)), "Parens")),
                  Sequence(
                    Var($g, Subtract(Index($pair, $k), 1)),
                    If(
                      And(Call($is, $g, "Closer"), Equals(Index($heads, $g), "AngleEnd")),
                      Assign($g, Subtract(Index($pair, $g), 1)),
                      Undefined()
                    ),
                    If(
                      And(Call($is, $g, "Name"), Not(Call($is, $g, "Infix"))),
                      Sequence(
                        Assign(
                          Index($leader, $o),
                          If(
                            Call($is, $g, "Prefix"),
                            $g,
                            If(AtLeast($typed, 0), $typed, $g)
                          )
                        ),
                        Continue()
                      ),
                      Undefined()
                    )
                  ),
                  Undefined()
                ),
                For(
                  Var($j, $p),
                  And(AtLeast($j, 0), Not(Call($stops, $j))),
                  Assign(
                    $j,
                    If(
                      And(Call($is, $j, "Closer"), AtLeast(Index($pair, $j), 0)),
                      Subtract(Index($pair, $j), 1),
                      Subtract($j, 1)
                    )
                  ),
                  Sequence(
                    If(Call($is, $j, "Opener"), Break(), Undefined()),
                    If(
                      Call($is, $j, "Prefix"),
                      Sequence(Assign(Index($leader, $o), $j), Break()),
                      Undefined()
                    )
                  )
                )
              )
            ),
            Bind($bindsOf, New($Map)),
            Bind($words,
              Call(
                Member($said, "map"),
                Lambda(List($w, $i),
                  Sequence(
                    Bind($tags, Map(Index($kinds, $i), Lambda(List($k), Call(Member($api, "call"), $k)))),
                    If(
                      Not(Call(Member($bindsOf, "has"), Index($heads, $i))),
                      Call(
                        Member($bindsOf, "set"),
                        Index($heads, $i),
                        Index(Call($claims, Or(Index($heads, $i), ""), "Binds"), 0)
                      ),
                      Undefined()
                    ),
                    Bind($binds, Call(Member($bindsOf, "get"), Index($heads, $i))),
                    If($binds, Call(Member($tags, "push"), $binds), Undefined()),
                    Bind($after, Index(Call($claims, Or(Index($heads, $i), ""), "BindsAfter"), 0)),
                    If($after, Call(Member($tags, "push"), $after), Undefined()),
                    If(
                      AtLeast(Index($pair, $i), 0),
                      Call(Member($tags, "push"), Call(Member($api, "call"), "Pairs", Index($pair, $i))),
                      Undefined()
                    ),
                    If(
                      AtLeast(Index($inside, $i), 0),
                      Call(Member($tags, "push"), Call(Member($api, "call"), "Inside", Index($inside, $i))),
                      Undefined()
                    ),
                    If(
                      AtLeast(Index($leader, $i), 0),
                      Call(Member($tags, "push"), Call(Member($api, "call"), "Leader", Index($leader, $i))),
                      Undefined()
                    ),
                    Return(
                      Call(
                        Member($api, "call"),
                        "Word",
                        Member($w, "text"),
                        $i,
                        Call(Member($api, "call"), "List", Spread($tags))
                      )
                    )
                  )
                )
              )
            ),
            Bind($prompt, Call(Member($api, "call"), "Prompt", Spread($words))),
            Comment("Rounds until nothing changes. What each word sees (CodeView: the kinds around it and the"),
            Comment("groups the links have made) is worked out once a round, held in a cell, and handed over by"),
            Comment("reference, so a word's hearing costs what it looks at, not the length of the code. A word"),
            Comment("with no hearing of its own (it answered with itself) is not asked again, and a word is"),
            Comment("asked again only where a link was just made: beside a group whose edges moved, or in a"),
            Comment("bracket that just gained one."),
            Var($links, List()),
            Bind($parent, Call(Member(New($Array, $n), "fill"), Negate(1))),
            Bind($promptCell, Call(Member(Member($api, "cells"), "allocate"), $prompt)),
            Bind($linksCell, Call(Member(Member($api, "cells"), "allocate"), Call(Member($api, "call"), "List"))),
            Bind($viewCell, Call(Member(Member($api, "cells"), "allocate"), Call(Member($api, "call"), "List"))),
            Bind($RANK, Object(Absorbs = 1, Takes = 2)),
            Bind($deaf, New($Set)),
            Var($dirty, New($Set, Call(Member($said, "map"), Lambda(List($_, $i), $i)))),
            Bind($lo, Concat(Call(Member(Call($Array, $n), "keys")))),
            Bind($hi, Concat(Call(Member(Call($Array, $n), "keys")))),
            Var($rounds, 0),
            For(
              Var($round, 0),
              And(LessThan($round, Add($n, 2)), Member($dirty, "size")),
              PostIncrement($round),
              Sequence(
                PostIncrement($rounds),
                Call(
                  Member(Member($api, "cells"), "write"),
                  $linksCell,
                  Call(
                    Member($api, "call"),
                    "List",
                    Spread(
                      Map(
                        $links,
                        Lambda(List($l),
                          Call(
                            Member($api, "call"),
                            "Link",
                            Member($l, "from"),
                            Member($l, "to"),
                            Call(Member($api, "call"), Member($l, "role"))
                          )
                        )
                      )
                    )
                  )
                ),
                Call(
                  Member(Member($api, "cells"), "write"),
                  $viewCell,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Call(
                        Member($api, "call"),
                        "CodeView",
                        $promptCell,
                        $linksCell
                      ),
                      $hearing
                    )
                  )
                ),
                Bind($proposals, List()),
                ForOf(
                  $i,
                  Call(Member(Concat($dirty), "sort"), Lambda(List($a, $b), Subtract($a, $b))),
                  Sequence(
                    If(
                      Or(Not(Index($heads, $i)), Call(Member($deaf, "has"), $i)),
                      Continue(),
                      Undefined()
                    ),
                    Bind($proposed,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "call"),
                            Index($heads, $i),
                            $promptCell,
                            $i,
                            $linksCell,
                            $viewCell
                          ),
                          $hearing
                        )
                      )
                    ),
                    If(
                      Or(Not(Call($isCall, $proposed)), NotEquals(Member($proposed, "head"), "List")),
                      Sequence(Call(Member($deaf, "add"), $i), Continue()),
                      Undefined()
                    ),
                    ForOf(
                      $a,
                      Member($proposed, "args"),
                      Sequence(
                        Bind($p, Member($a, "value")),
                        If(
                          Or(Not(Call($isCall, $p)), NotEquals(Member($p, "head"), "Link")),
                          Continue(),
                          Undefined()
                        ),
                        Call(
                          Member($proposals, "push"),
                          Object(
                            from = Member(Index(Member($p, "args"), 0), "value"),
                            to = Member(Index(Member($p, "args"), 1), "value"),
                            role = Member(Member(Index(Member($p, "args"), 2), "value"), "head")
                          )
                        )
                      )
                    )
                  )
                ),
                Call(
                  Member($proposals, "sort"),
                  Lambda(List($a, $b),
                    Subtract(
                      Otherwise(Index($RANK, Member($a, "role")), 3),
                      Otherwise(Index($RANK, Member($b, "role")), 3)
                    )
                  )
                ),
                Bind($above,
                  Lambda(List($i, $j),
                    Sequence(
                      For(
                        Sequence(Var($k, $i), Var($g, 0)),
                        And(AtLeast($k, 0), LessThan($g, $n)),
                        Sequence(Assign($k, Index($parent, $k)), PostIncrement($g)),
                        If(Equals($k, $j), Return(true), Undefined())
                      ),
                      Return(false)
                    )
                  )
                ),
                Bind($accepted, List()),
                ForOf(
                  $p,
                  $proposals,
                  Sequence(
                    If(
                      Or(
                        Or(AtLeast(Index($parent, Member($p, "from")), 0), Equals(Member($p, "from"), Member($p, "to"))),
                        Call($above, Member($p, "to"), Member($p, "from"))
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Call(Member($accepted, "push"), $p),
                    Assign(Index($parent, Member($p, "from")), Member($p, "to"))
                  )
                ),
                Comment("A waiting word waits on the edges of the groups beside it, or on its bracket's parts."),
                Bind($next, New($Set)),
                Bind($touch,
                  Lambda(List($i),
                    Sequence(
                      If(
                        And(AtLeast($i, 0), LessThan($i, $n)),
                        Call(Member($next, "add"), $i),
                        Undefined()
                      ),
                      Undefined()
                    )
                  )
                ),
                ForOf(
                  $p,
                  $accepted,
                  Sequence(
                    Call($touch, Member($p, "from")),
                    Call($touch, Index($inside, Member($p, "from"))),
                    For(
                      Sequence(Var($k, Member($p, "to")), Var($g, 0)),
                      And(AtLeast($k, 0), LessThan($g, $n)),
                      Sequence(Assign($k, Index($parent, $k)), PostIncrement($g)),
                      Sequence(
                        Assign(
                          Index($lo, $k),
                          Call(
                            Member($Math, "min"),
                            Index($lo, $k),
                            Index($lo, Member($p, "from"))
                          )
                        ),
                        Assign(
                          Index($hi, $k),
                          Call(
                            Member($Math, "max"),
                            Index($hi, $k),
                            Index($hi, Member($p, "from"))
                          )
                        ),
                        Call($touch, $k),
                        Call($touch, Subtract(Index($lo, $k), 1)),
                        Call($touch, Add(Index($hi, $k), 1)),
                        Call($touch, Index($inside, $k)),
                        If(
                          AtLeast(Index($pair, Add(Index($hi, $k), 1)), 0),
                          Call($touch, Index($pair, Add(Index($hi, $k), 1))),
                          Undefined()
                        ),
                        If(
                          And(GreaterThan(Index($lo, $k), 0), AtLeast(Index($pair, Subtract(Index($lo, $k), 1)), 0)),
                          Call($touch, Index($pair, Subtract(Index($lo, $k), 1))),
                          Undefined()
                        ),
                        If(
                          And(GreaterThan(Index($lo, $k), 0), AtLeast(Index($parent, Subtract(Index($lo, $k), 1)), 0)),
                          Call($touch, Index($parent, Subtract(Index($lo, $k), 1))),
                          Undefined()
                        ),
                        Comment("What goes on from it past a separator (\"...; else\")."),
                        For(
                          Var($j, Add(Index($hi, $k), 1)),
                          And(LessThan($j, $n), AtMost($j, Add(Index($hi, $k), 3))),
                          PostIncrement($j),
                          Sequence(
                            Call($touch, $j),
                            If(
                              Not(Includes(Index($kinds, $j), "Separator")),
                              Break(),
                              Undefined()
                            )
                          )
                        )
                      )
                    )
                  )
                ),
                Assign($links, Call(Member($links, "concat"), $accepted)),
                Assign($dirty, $next)
              )
            ),
            Comment("Each word written as its Concept, the words it took as its arguments, in the order said."),
            Comment("A name keeps how it was typed when its Concept's name does not say it: MyClass(said=\"MyClass\");"),
            Comment("an operator said after the one thing it holds says so: Increment(X(), after=true)."),
            Bind($children, Map($said, Lambda(List(), List()))),
            ForOf(
              $l,
              Call(
                Member(Concat($links), "sort"),
                Lambda(List($a, $b), Subtract(Member($a, "from"), Member($b, "from")))
              ),
              If(
                NotEquals(Member($l, "role"), "Absorbs"),
                Call(Member(Index($children, Member($l, "to")), "push"), Member($l, "from")),
                Undefined()
              )
            ),
            Bind($lower, Lambda(List($t), Add(Call(Member(Index($t, 0), "toLowerCase")), Call(Member($t, "slice"), 1)))),
            Bind($build,
              Lambda(List($i),
                Sequence(
                  Bind($kids, Map(Index($children, $i), Lambda(List($j), Object(value = Call($build, $j))))),
                  Bind($w, Index($said, $i)),
                  If(
                    Equals(Member($w, "kind"), "number"),
                    Return(
                      If(
                        Equals(Call($String, Call($Number, Member($w, "text"))), Member($w, "text")),
                        Call($Number, Member($w, "text")),
                        Call(Member($api, "call"), "Numeral", Member($w, "text"))
                      )
                    ),
                    Undefined()
                  ),
                  If(
                    Equals(Member($w, "kind"), "text"),
                    Return(Member($w, "value")),
                    Undefined()
                  ),
                  If(
                    Equals(Member($w, "kind"), "regex"),
                    Return(
                      Call(
                        Member($api, "call"),
                        "Regex",
                        Member($w, "value"),
                        Member($w, "flags")
                      )
                    ),
                    Undefined()
                  ),
                  If(
                    Equals(Member($w, "kind"), "comment"),
                    Return(Call(Member($api, "call"), "Comment", Member($w, "value"))),
                    Undefined()
                  ),
                  If(
                    Not(Index($heads, $i)),
                    Return(Call(Member($api, "call"), "Symbol", Member($w, "text"))),
                    Undefined()
                  ),
                  Comment("A name that is a word of code elsewhere (\"index\", \"comma\") says it is only a name here."),
                  If(
                    And(
                      Equals(Member($w, "kind"), "name"),
                      Or(
                        NotEquals(Call($lower, Index($heads, $i)), Member($w, "text")),
                        And(
                          Equals(Length(Index($kinds, $i)), 1),
                          GreaterThan(Length(Call($kindsOf, Index($heads, $i))), 0)
                        )
                      )
                    ),
                    Call(Member($kids, "push"), Object(name = "said", value = Member($w, "text"))),
                    Undefined()
                  ),
                  If(
                    And(
                      And(Or(Call($is, $i, "Infix"), Call($is, $i, "Prefix")), Equals(Length(Index($children, $i)), 1)),
                      LessThan(Index(Index($children, $i), 0), $i)
                    ),
                    Call(Member($kids, "push"), Object(name = "after", value = true)),
                    Undefined()
                  ),
                  Return(Object(head = If(Call($is, $i, "Scope"), "Block", Index($heads, $i)), args = $kids))
                )
              )
            ),
            Comment("What stands alone is heard; punctuation nobody took adds nothing."),
            Bind($PUNCTUATION, List("Closer", "Separator")),
            Bind($roots, List()),
            For(
              Var($i, 0),
              LessThan($i, $n),
              PostIncrement($i),
              If(
                And(
                  LessThan(Index($parent, $i), 0),
                  Not(Call(Member($PUNCTUATION, "some"), Lambda(List($k), Includes(Index($kinds, $i), $k))))
                ),
                Call(Member($roots, "push"), Object(value = Call($build, $i))),
                Undefined()
              )
            ),
            Return(Object(head = "Phrases", args = Concat($roots, List(Object(name = "rounds", value = $rounds)))))
          )
        )
      )
    )
  )
)

// What a word hearing code sees: the kinds around it and the groups the links have made.
Concept(CodeView(),
  Realization(CodeView($prompt, $links),
    context = Hearing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("What a word hearing code needs to see: what each word is, and what the links so far make"),
            Comment("of the words around it (where each group of words starts and ends)."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($words,
              Map(
                Member(Call(Member(Member($api, "cells"), "read"), Member(Index($args, 0), "value")), "args"),
                Lambda(List($a), Member($a, "value"))
              )
            ),
            Bind($n, Length($words)),
            Bind($kinds, List()),
            Bind($binds, List()),
            Comment("How tightly it holds what follows it, where that differs (\"x as A | B\": the type)."),
            Bind($after, List()),
            Bind($right, List()),
            Bind($pair, List()),
            Bind($inside, List()),
            Bind($leader, List()),
            Bind($tagged,
              Lambda(List($tags, $head),
                Sequence(
                  Bind($t,
                    Call(
                      Member($tags, "find"),
                      Lambda(List($x), And(Call($isCall, $x), Equals(Member($x, "head"), $head)))
                    )
                  ),
                  Return(
                    If(
                      $t,
                      Member(Index(Member($t, "args"), 0), "value"),
                      Negate(1)
                    )
                  )
                )
              )
            ),
            ForOf(
              $w,
              $words,
              Sequence(
                Bind($tags,
                  Map(
                    Member(Member(Index(Member($w, "args"), 2), "value"), "args"),
                    Lambda(List($a), Member($a, "value"))
                  )
                ),
                Call(
                  Member($kinds, "push"),
                  Map(
                    Filter($tags, Lambda(List($t), And(Call($isCall, $t), Equals(Length(Member($t, "args")), 0)))),
                    Lambda(List($t), Member($t, "head"))
                  )
                ),
                Bind($b,
                  Call(
                    Member($tags, "find"),
                    Lambda(List($t), And(Call($isCall, $t), Equals(Member($t, "head"), "Binds")))
                  )
                ),
                Call(Member($binds, "push"), If($b, Member(Index(Member($b, "args"), 0), "value"), null)),
                Bind($a,
                  Call(
                    Member($tags, "find"),
                    Lambda(List($t), And(Call($isCall, $t), Equals(Member($t, "head"), "BindsAfter")))
                  )
                ),
                Call(
                  Member($after, "push"),
                  If(
                    $a,
                    Member(Index(Member($a, "args"), 0), "value"),
                    If($b, Member(Index(Member($b, "args"), 0), "value"), null)
                  )
                ),
                Call(Member($right, "push"), If($b, GreaterThan(Length(Member($b, "args")), 1), false)),
                Call(Member($pair, "push"), Call($tagged, $tags, "Pairs")),
                Call(Member($inside, "push"), Call($tagged, $tags, "Inside")),
                Call(Member($leader, "push"), Call($tagged, $tags, "Leader"))
              )
            ),
            Bind($is, Lambda(List($i, $k), And(And(AtLeast($i, 0), LessThan($i, $n)), Includes(Index($kinds, $i), $k)))),
            Bind($scope, Call(Member($kinds, "map"), Lambda(List($_, $i), Call($is, $i, "Scope")))),
            Bind($infix, Call(Member($kinds, "map"), Lambda(List($_, $i), Call($is, $i, "Infix")))),
            Bind($prefix, Call(Member($kinds, "map"), Lambda(List($_, $i), Call($is, $i, "Prefix")))),
            Comment("What binds as an operator does, for what waits on it: operators, and an index after a thing."),
            Comment("A block after an operator is the operator's thing: it stands alone, as a value does."),
            Bind($alone,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i),
                  And(And(Index($scope, $i), LessThan(Index($leader, $i), 0)), Index($infix, Subtract($i, 1)))
                )
              )
            ),
            Comment("A thing can end here: a name that is not an operator, a value, a closed group (not a block)."),
            Comment("A closed group ends a thing, but not a block, a header (\"if (x)\"), or a question's \":\"."),
            Bind($plainEnd,
              Lambda(List($i),
                Or(
                  Or(
                    Or(
                      Or(
                        And(And(Call($is, $i, "Name"), Not(Index($infix, $i))), Not(Index($prefix, $i))),
                        Call($is, $i, "Number")
                      ),
                      Call($is, $i, "Text")
                    ),
                    Call($is, $i, "Regex")
                  ),
                  And(
                    And(
                      And(
                        Call($is, $i, "Closer"),
                        Or(Not(Index($scope, Index($pair, $i))), Index($alone, Index($pair, $i)))
                      ),
                      Not(Call($is, Subtract(Index($pair, $i), 1), "Heads"))
                    ),
                    Not(Index($infix, Index($pair, $i)))
                  )
                )
              )
            ),
            Comment("An operator that cannot stand alone, found where a thing should be, is a thing (\"import *\");"),
            Comment("a word that joins, found where a thing should be, is only a name (\"(from: number)\")."),
            Bind($symbolStray,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i),
                  And(
                    And(
                      And(
                        And(
                          And(And(Index($infix, $i), Not(Call($is, $i, "Unary"))), Not(Index($prefix, $i))),
                          Not(Call($is, $i, "Name"))
                        ),
                        GreaterThan($i, 0)
                      ),
                      Not(Call($plainEnd, Subtract($i, 1)))
                    ),
                    Not(Index($infix, Subtract($i, 1)))
                  )
                )
              )
            ),
            Bind($stray,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i),
                  Or(
                    Index($symbolStray, $i),
                    And(
                      And(
                        And(
                          And(And(Index($infix, $i), Call($is, $i, "Name")), Not(Call($is, $i, "Unary"))),
                          Not(Index($prefix, $i))
                        ),
                        Not(Call($plainEnd, Subtract($i, 1)))
                      ),
                      Not(Index($symbolStray, Subtract($i, 1)))
                    )
                  )
                )
              )
            ),
            Bind($ends, Lambda(List($i), Or(Call($plainEnd, $i), Not(Not(Index($stray, $i)))))),
            Comment("What binds as an operator does, for what waits on it: operators that are not only names"),
            Comment("here, and an index after a thing."),
            Bind($operator,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i), Or(And(Index($infix, $i), Not(Index($stray, $i))), Call($is, $i, "Postfix")))
              )
            ),
            Comment("A thing can start here: a name, a value, a group, an operator standing alone."),
            Bind($attached, Lambda(List($i), Or(Call($is, $i, "Postfix"), Call($is, $i, "Attached")))),
            Bind($starts,
              Lambda(List($i, $lone),
                Or(
                  Or(
                    Or(
                      Or(
                        Or(
                          Or(
                            Or(Index($stray, $i), And(Call($is, $i, "Name"), Not(Index($infix, $i)))),
                            Call($is, $i, "Number")
                          ),
                          Call($is, $i, "Text")
                        ),
                        Call($is, $i, "Regex")
                      ),
                      And(
                        And(And(Call($is, $i, "Opener"), Not(Index($scope, $i))), Not(Call($attached, $i))),
                        Not(Index($infix, $i))
                      )
                    ),
                    Index($alone, $i)
                  ),
                  Call($lone, $i)
                )
              )
            ),
            Comment("An operator with a thing before it and none after holds only that thing (\"x++\", \"x!\"),"),
            Comment("and ends a thing itself; one with nothing before it holds only what follows (\"-x\")."),
            Comment("Only a word that can stand before a thing alone (Unary: \"-\", \"!\", \"++\") does."),
            Bind($lone, Lambda(List($i), And(Index($infix, $i), Or(Call($is, $i, "Unary"), Index($prefix, $i))))),
            Bind($firstUnary, Lambda(List($i), And(Call($lone, $i), Not(Call($ends, Subtract($i, 1)))))),
            Bind($postfix,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i),
                  And(
                    And(And(Index($infix, $i), Not(Index($stray, $i))), Call($ends, Subtract($i, 1))),
                    Not(Call($starts, Add($i, 1), $firstUnary))
                  )
                )
              )
            ),
            Bind($operandEnd,
              Call(Member($kinds, "map"), Lambda(List($_, $i), Or(Call($ends, $i), Index($postfix, $i))))
            ),
            Bind($unary,
              Call(
                Member($kinds, "map"),
                Lambda(List($_, $i), And(Call($lone, $i), Not(Index($operandEnd, Subtract($i, 1)))))
              )
            ),
            Bind($operandStart,
              Call(Member($kinds, "map"), Lambda(List($_, $i), Call($starts, $i, Lambda(List($k), Index($unary, $k)))))
            ),
            Comment("Where what is being said stops: a separator, a closer, a block, a comment, the end."),
            Bind($boundary,
              Concat(
                Call(
                  Member($kinds, "map"),
                  Lambda(List($_, $i),
                    Or(
                      Or(
                        Or(Call($is, $i, "Separator"), Call($is, $i, "Closer")),
                        And(Index($scope, $i), Not(Index($alone, $i)))
                      ),
                      Call($is, $i, "Comment")
                    )
                  )
                ),
                List(true)
              )
            ),
            Bind($punctuation,
              Call(Member($kinds, "map"), Lambda(List($_, $i), Or(Call($is, $i, "Separator"), Call($is, $i, "Closer"))))
            ),
            Bind($parent, Call(Member(New($Array, $n), "fill"), Negate(1))),
            Bind($role, Call(Member(New($Array, $n), "fill"), "")),
            ForOf(
              $l,
              Member(Call(Member(Member($api, "cells"), "read"), Member(Index($args, 1), "value")), "args"),
              Sequence(
                Bind(List($from, $to, $r),
                  Map(Member(Member($l, "value"), "args"), Lambda(List($a), Member($a, "value")))
                ),
                Assign(Index($parent, $from), $to),
                Assign(Index($role, $from), Member($r, "head"))
              )
            ),
            Bind($lo, Concat(Call(Member(Call($Array, $n), "keys")))),
            Bind($hi, Concat(Call(Member(Call($Array, $n), "keys")))),
            For(
              Var($i, 0),
              LessThan($i, $n),
              PostIncrement($i),
              For(
                Sequence(Var($p, Index($parent, $i)), Var($g, 0)),
                And(AtLeast($p, 0), LessThan($g, $n)),
                Sequence(Assign($p, Index($parent, $p)), PostIncrement($g)),
                Sequence(
                  Assign(Index($lo, $p), Call(Member($Math, "min"), Index($lo, $p), $i)),
                  Assign(Index($hi, $p), Call(Member($Math, "max"), Index($hi, $p), $i))
                )
              )
            ),
            Return(
              Call(
                Member($api, "fromHost"),
                Object(
                  after = $after,
                  operator = $operator,
                  stray = $stray,
                  kinds = $kinds,
                  binds = $binds,
                  right = $right,
                  pair = $pair,
                  inside = $inside,
                  leader = $leader,
                  scope = $scope,
                  alone = $alone,
                  infix = $infix,
                  prefix = $prefix,
                  unary = $unary,
                  postfix = $postfix,
                  operandEnd = $operandEnd,
                  operandStart = $operandStart,
                  boundary = $boundary,
                  punctuation = $punctuation,
                  parent = $parent,
                  role = $role,
                  lo = $lo,
                  hi = $hi
                )
              )
            )
          )
        )
      )
    )
  )
)

// Between two things: takes them by how tightly it binds.
Concept(Infix(),
  IsA(CodeWord()),
  Realization($word,
    context = Hearing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"a + b\": an operator takes the thing before it and the thing after it, once neither is"),
            Comment("held more tightly by the operator on its other side. With nothing before it, it holds"),
            Comment("only what follows (\"-x\"), as tightly as any word alone before a thing does (or as its own"),
            Comment("Binds says, for a word that also leads, like \"not\"); with nothing after it, only what is"),
            Comment("before it (\"x++\")."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member(Member($a, "value"), "args"))
            ),
            Bind($v,
              Lambda(List($k, $i),
                If(
                  And(AtLeast($i, 0), LessThan($i, Length(Index($field, $k)))),
                  Member(Index(Index($field, $k), $i), "value"),
                  Undefined()
                )
              )
            ),
            If(
              Call($v, "stray", $at),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($ALONE, 150),
            Bind($alone,
              Lambda(List($i),
                If(
                  Call($v, "prefix", $i),
                  Otherwise(Call($v, "binds", $i), $ALONE),
                  $ALONE
                )
              )
            ),
            Bind($unary, Call($v, "unary", $at)),
            Bind($postfix, Call($v, "postfix", $at)),
            Bind($mine,
              If(
                $unary,
                Call($alone, $at),
                If(
                  $postfix,
                  Add($ALONE, 10),
                  Otherwise(Call($v, "binds", $at), 0)
                )
              )
            ),
            Bind($mineAfter,
              If(
                Or($unary, $postfix),
                $mine,
                Otherwise(Call($v, "after", $at), $mine)
              )
            ),
            Bind($rightToLeft, Call($v, "right", $at)),
            Bind($holding,
              Lambda(List($b),
                If(
                  Call($v, "unary", $b),
                  Call($alone, $b),
                  Call($v, "binds", $b)
                )
              )
            ),
            Bind($holdingAfter,
              Lambda(List($b),
                If(
                  Call($v, "unary", $b),
                  Call($alone, $b),
                  Call($v, "after", $b)
                )
              )
            ),
            Bind($out, List()),
            Comment("What follows: the whole thing that starts after me, once what comes after it is not held"),
            Comment("more tightly by the next operator, and nothing still belongs to it."),
            Var($r, Add($at, 1)),
            If(
              And(Not($postfix), Call($v, "operandStart", $r)),
              Sequence(
                While(
                  And(AtLeast(Call($v, "parent", $r), 0), GreaterThan(Call($v, "lo", Call($v, "parent", $r)), $at)),
                  Assign($r, Call($v, "parent", $r))
                ),
                Bind($e, Add(Call($v, "hi", $r), 1)),
                Comment("Its own closing bracket, not yet absorbed, is not where it ends."),
                If(
                  And(
                    And(Call($v, "punctuation", $e), AtLeast(Call($v, "pair", $e), Call($v, "lo", $r))),
                    LessThan(Call($v, "pair", $e), $e)
                  ),
                  Return(Call(Member($api, "call"), "List", Spread($out))),
                  Undefined()
                ),
                Bind($next,
                  If(
                    And(Call($v, "operator", $e), Not(Call($v, "unary", $e))),
                    Call($holding, $e),
                    Undefined()
                  )
                ),
                Bind($free, And(LessThan(Call($v, "parent", $r), 0), Not(Call($v, "punctuation", $r)))),
                If(
                  And(
                    $free,
                    Or(
                      Call($v, "boundary", $e),
                      And(
                        And(NotEquals($next, Undefined()), NotEquals($next, null)),
                        Or(LessThan($next, $mineAfter), And(Equals($next, $mineAfter), Not($rightToLeft)))
                      )
                    )
                  ),
                  Call(
                    Member($out, "push"),
                    Call(
                      Member($api, "call"),
                      "Link",
                      $r,
                      $at,
                      Call(Member($api, "call"), "Takes")
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            If(
              $unary,
              Return(Call(Member($api, "call"), "List", Spread($out))),
              Undefined()
            ),
            Comment("What comes before: the whole thing that ends before me, once the operator before it (if"),
            Comment("any) does not hold it more tightly."),
            Var($l, Subtract($at, 1)),
            While(
              And(
                And(AtLeast($l, 0), AtLeast(Call($v, "parent", $l), 0)),
                LessThan(Call($v, "hi", Call($v, "parent", $l)), $at)
              ),
              Assign($l, Call($v, "parent", $l))
            ),
            If(
              And(
                And(And(AtLeast($l, 0), Call($v, "operandEnd", Subtract($at, 1))), LessThan(Call($v, "parent", $l), 0)),
                Not(Call($v, "punctuation", $l))
              ),
              Sequence(
                Bind($b, Subtract(Call($v, "lo", $l), 1)),
                Comment(
                  "Something still to its left that belongs to it (\"a.b\" before \"a\" is taken): not whole yet."
                ),
                If(
                  Call($v, "operandEnd", $b),
                  Return(Call(Member($api, "call"), "List", Spread($out))),
                  Undefined()
                ),
                Bind($before,
                  If(
                    And(
                      And(AtLeast($b, 0), Not(GreaterThan(Call($v, "pair", $b), $at))),
                      Or(Call($v, "operator", $b), Call($v, "prefix", $b))
                    ),
                    Call($holdingAfter, $b),
                    Undefined()
                  )
                ),
                If(
                  Or(
                    Or(Or(Equals($before, Undefined()), Equals($before, null)), LessThan($before, $mine)),
                    And(Equals($before, $mine), $rightToLeft)
                  ),
                  Call(
                    Member($out, "push"),
                    Call(
                      Member($api, "call"),
                      "Link",
                      $l,
                      $at,
                      Call(Member($api, "call"), "Takes")
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// Before a thing: takes what follows.
Concept(Prefix(),
  IsA(CodeWord()),
  Realization($word,
    context = Hearing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"return a + b\", \"const x\", \"for x in xs\": a word that leads takes the whole thing after it,"),
            Comment("up to where an operator holding less tightly than it begins. A word that heads a statement"),
            Comment("with a bracketed header (\"if (x) ...\") takes, after the header, the statement it heads."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member(Member($a, "value"), "args"))
            ),
            Bind($v,
              Lambda(List($k, $i),
                If(
                  And(AtLeast($i, 0), LessThan($i, Length(Index($field, $k)))),
                  Member(Index(Index($field, $k), $i), "value"),
                  Undefined()
                )
              )
            ),
            Bind($is,
              Lambda(List($i, $k),
                And(
                  And(AtLeast($i, 0), LessThan($i, Length(Member($field, "kinds")))),
                  Call(
                    Member(Member(Call($v, "kinds", $i), "args"), "some"),
                    Lambda(List($a), Equals(Member($a, "value"), $k))
                  )
                )
              )
            ),
            Bind($mine, Otherwise(Call($v, "binds", $at), 0)),
            Bind($take,
              Lambda(List($start, $after),
                Sequence(
                  Var($r, $start),
                  If(
                    Not(Call($v, "operandStart", $r)),
                    Return(List()),
                    Undefined()
                  ),
                  While(
                    And(AtLeast(Call($v, "parent", $r), 0), GreaterThan(Call($v, "lo", Call($v, "parent", $r)), $after)),
                    Assign($r, Call($v, "parent", $r))
                  ),
                  If(
                    Or(AtLeast(Call($v, "parent", $r), 0), Call($v, "punctuation", $r)),
                    Return(List()),
                    Undefined()
                  ),
                  Bind($e, Add(Call($v, "hi", $r), 1)),
                  Comment("Its own closing bracket, not yet absorbed, is not where it ends."),
                  If(
                    And(
                      And(Call($v, "punctuation", $e), AtLeast(Call($v, "pair", $e), Call($v, "lo", $r))),
                      LessThan(Call($v, "pair", $e), $e)
                    ),
                    Return(List()),
                    Undefined()
                  ),
                  Bind($next,
                    If(
                      And(Call($v, "operator", $e), Not(Call($v, "unary", $e))),
                      Call($v, "binds", $e),
                      Undefined()
                    )
                  ),
                  Return(
                    If(
                      Or(
                        Call($v, "boundary", $e),
                        And(And(NotEquals($next, Undefined()), NotEquals($next, null)), AtMost($next, $mine))
                      ),
                      List(
                        Call(
                          Member($api, "call"),
                          "Link",
                          $r,
                          $at,
                          Call(Member($api, "call"), "Takes")
                        )
                      ),
                      List()
                    )
                  )
                )
              )
            ),
            Bind($out, Call($take, Add($at, 1), $at)),
            If(
              And(
                And(Call($is, $at, "Heads"), Call($is, Add($at, 1), "Round")),
                GreaterThan(Call($v, "pair", Add($at, 1)), $at)
              ),
              Call(
                Member($out, "push"),
                Spread(
                  Call(
                    $take,
                    Add(Call($v, "pair", Add($at, 1)), 1),
                    Call($v, "pair", Add($at, 1))
                  )
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// A bracket: groups what it holds, for whoever it belongs to.
Concept(Opener(),
  IsA(CodeWord()),
  Realization($word,
    context = Hearing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("A bracket groups what it holds, and where it stands says whose the group is:"),
            Comment("- after a name, round brackets are what the name takes (\"print(x)\"): its arguments;"),
            Comment("empty, they stay said (\"print()\" is Print(Parens()));"),
            Comment("- after a word that heads a statement (\"if (...)\", \"for (...)\"), they are its header;"),
            Comment("- a block belongs to the word that leads what is said before it (\"for ... { }\", \"if"),
            Comment("...:\"), its statements that word's; a block a name leads is the name's Block (\"m() { }\");"),
            Comment("- angles belong to the name before them; an index takes the thing before it too;"),
            Comment("- a template takes each piece inside it, an interpolation is its one thing;"),
            Comment("- any other group is itself a word (Brackets(1, 2), Braces(...), Parens(a, b)), except"),
            Comment("round brackets around one thing, which are only how the thing is said."),
            Comment("The closing bracket and the separators are part of how it is said: absorbed."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member(Member($a, "value"), "args"))
            ),
            Bind($v,
              Lambda(List($k, $i),
                If(
                  And(AtLeast($i, 0), LessThan($i, Length(Index($field, $k)))),
                  Member(Index(Index($field, $k), $i), "value"),
                  Undefined()
                )
              )
            ),
            Bind($is,
              Lambda(List($i, $k),
                And(
                  And(AtLeast($i, 0), LessThan($i, Length(Member($field, "kinds")))),
                  Call(
                    Member(Member(Call($v, "kinds", $i), "args"), "some"),
                    Lambda(List($a), Equals(Member($a, "value"), $k))
                  )
                )
              )
            ),
            Bind($close, Call($v, "pair", $at)),
            If(
              LessThan($close, 0),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Comment("The parts: between separators; a comment is a part of its own; in a template, each piece."),
            Comment("A separator that introduces a block (Python's \":\") is inside a part, not between two."),
            Bind($each, Call($is, $at, "Juxtaposed")),
            Bind($parts, List()),
            Bind($separators, List()),
            Var($a, Add($at, 1)),
            For(
              Var($k, Add($at, 1)),
              LessThan($k, $close),
              PostIncrement($k),
              Sequence(
                If(
                  NotEquals(Call($v, "inside", $k), $at),
                  Continue(),
                  Undefined()
                ),
                If(
                  $each,
                  Call(
                    Member($parts, "push"),
                    List(
                      $k,
                      If(
                        GreaterThan(Call($v, "pair", $k), $k),
                        Add(Call($v, "pair", $k), 1),
                        Add($k, 1)
                      )
                    )
                  ),
                  If(
                    Call($is, $k, "Comment"),
                    Sequence(
                      If(
                        GreaterThan($k, $a),
                        Call(Member($parts, "push"), List($a, $k)),
                        Undefined()
                      ),
                      Call(Member($parts, "push"), List($k, Add($k, 1))),
                      Assign($a, Add($k, 1))
                    ),
                    If(
                      And(
                        And(
                          And(
                            And(GreaterThan(Call($v, "pair", $k), $k), Call($v, "scope", $k)),
                            Not(Call($v, "alone", $k))
                          ),
                          Call($v, "operandStart", Add(Call($v, "pair", $k), 1))
                        ),
                        LessThan(Add(Call($v, "pair", $k), 1), $close)
                      ),
                      Sequence(
                        Comment("A block ends what is said: what starts after it is another part."),
                        Call(Member($parts, "push"), List($a, Add(Call($v, "pair", $k), 1))),
                        Assign($a, Add(Call($v, "pair", $k), 1))
                      ),
                      If(
                        And(Call($is, $k, "Separator"), Not(Call($v, "scope", Add($k, 1)))),
                        Sequence(
                          If(
                            GreaterThan($k, $a),
                            Call(Member($parts, "push"), List($a, $k)),
                            Undefined()
                          ),
                          Call(Member($separators, "push"), $k),
                          Assign($a, Add($k, 1))
                        ),
                        Undefined()
                      )
                    )
                  )
                ),
                If(
                  GreaterThan(Call($v, "pair", $k), $k),
                  Assign($k, Subtract(Call($v, "pair", $k), 1)),
                  Undefined()
                )
              )
            ),
            If(
              And(Not($each), GreaterThan($close, $a)),
              Call(Member($parts, "push"), List($a, $close)),
              Undefined()
            ),
            Bind($tops,
              Map(
                $parts,
                Lambda(List(List($x, $y)),
                  Sequence(
                    Bind($found, New($Set)),
                    For(
                      Var($k, $x),
                      LessThan($k, $y),
                      PostIncrement($k),
                      Sequence(
                        If(
                          And(Call($is, $k, "Separator"), LessThan(Call($v, "parent", $k), 0)),
                          Continue(),
                          Undefined()
                        ),
                        Var($t, $k),
                        While(
                          And(AtLeast(Call($v, "parent", $t), $x), LessThan(Call($v, "parent", $t), $y)),
                          Assign($t, Call($v, "parent", $t))
                        ),
                        Call(Member($found, "add"), $t),
                        If(
                          GreaterThan(Member($found, "size"), 1),
                          Break(),
                          Undefined()
                        )
                      )
                    ),
                    Return(Concat($found))
                  )
                )
              )
            ),
            Bind($settled, Call(Member($tops, "every"), Lambda(List($t), Equals(Length($t), 1)))),
            Bind($out, List()),
            Bind($link,
              Lambda(List($from, $to, $role),
                Sequence(
                  If(
                    And(AtLeast($from, 0), LessThan(Call($v, "parent", $from), 0)),
                    Call(
                      Member($out, "push"),
                      Call(
                        Member($api, "call"),
                        "Link",
                        $from,
                        $to,
                        Call(Member($api, "call"), $role)
                      )
                    ),
                    Undefined()
                  ),
                  Undefined()
                )
              )
            ),
            Comment("Its parts are the owner's: the brackets are only how they are said."),
            Bind($into,
              Lambda(List($owner),
                Sequence(
                  Call($link, $at, $owner, "Absorbs"),
                  Call($link, $close, $owner, "Absorbs"),
                  ForOf($s, $separators, Call($link, $s, $owner, "Absorbs")),
                  If(
                    $settled,
                    ForOf($t, $tops, Call($link, Index($t, 0), $owner, "Takes")),
                    Undefined()
                  ),
                  Undefined()
                )
              )
            ),
            Comment("It is a word of its own, holding its parts."),
            Bind($word,
              Lambda(List(),
                Sequence(
                  Call($link, $close, $at, "Absorbs"),
                  ForOf($s, $separators, Call($link, $s, $at, "Absorbs")),
                  If(
                    $settled,
                    ForOf($t, $tops, Call($link, Index($t, 0), $at, "Takes")),
                    Undefined()
                  ),
                  Undefined()
                )
              )
            ),
            Bind($transparent,
              Lambda(List(),
                Sequence(
                  If(
                    And(Equals(Length($tops), 1), $settled),
                    Sequence(
                      Call($link, $at, Index(Index($tops, 0), 0), "Absorbs"),
                      Call($link, $close, Index(Index($tops, 0), 0), "Absorbs")
                    ),
                    Undefined()
                  ),
                  Undefined()
                )
              )
            ),
            If(
              Call($v, "scope", $at),
              Sequence(
                Bind($owner, Call($v, "leader", $at)),
                If(
                  And(AtLeast($owner, 0), Call($is, $owner, "Prefix")),
                  Call($into, $owner),
                  Sequence(
                    Call($word),
                    If(
                      AtLeast($owner, 0),
                      Call($link, $at, $owner, "Takes"),
                      Undefined()
                    )
                  )
                )
              ),
              If(
                Call($is, $at, "Transparent"),
                Call($transparent),
                If(
                  $each,
                  Call($word),
                  If(
                    Call($is, $at, "Attached"),
                    Sequence(
                      Call($word),
                      If(
                        Call($is, Subtract($at, 1), "Name"),
                        Call($link, $at, Subtract($at, 1), "Takes"),
                        Undefined()
                      )
                    ),
                    If(
                      Call($is, $at, "Postfix"),
                      Sequence(
                        Comment("The thing before it, as an operator after a thing takes it: \"a.b[0]\" indexes a.b."),
                        Call($word),
                        Var($l, Subtract($at, 1)),
                        While(
                          And(
                            And(AtLeast($l, 0), AtLeast(Call($v, "parent", $l), 0)),
                            LessThan(Call($v, "hi", Call($v, "parent", $l)), $at)
                          ),
                          Assign($l, Call($v, "parent", $l))
                        ),
                        Bind($b,
                          If(
                            AtLeast($l, 0),
                            Subtract(Call($v, "lo", $l), 1),
                            Negate(1)
                          )
                        ),
                        If(
                          Call($v, "operandEnd", $b),
                          Return(Call(Member($api, "call"), "List", Spread($out))),
                          Undefined()
                        ),
                        Bind($before,
                          If(
                            And(
                              And(AtLeast($b, 0), Not(GreaterThan(Call($v, "pair", $b), $at))),
                              Or(Call($v, "operator", $b), Call($v, "prefix", $b))
                            ),
                            If(Call($v, "unary", $b), 150, Call($v, "binds", $b)),
                            null
                          )
                        ),
                        If(
                          And(
                            And(
                              And(AtLeast($l, 0), LessThan(Call($v, "parent", $l), 0)),
                              Not(Call($v, "punctuation", $l))
                            ),
                            Or(Equals($before, null), LessThan($before, Otherwise(Call($v, "binds", $at), 200)))
                          ),
                          Call($link, $l, $at, "Takes"),
                          Undefined()
                        )
                      ),
                      Sequence(
                        Var($p, Subtract($at, 1)),
                        If(
                          And(Call($is, $p, "Closer"), Call($is, Call($v, "pair", $p), "Attached")),
                          Assign($p, Subtract(Call($v, "pair", $p), 1)),
                          Undefined()
                        ),
                        Bind($round, Call($is, $at, "Round")),
                        Bind($named, And(And($round, Call($is, $p, "Name")), Not(Call($v, "infix", $p)))),
                        If(
                          And($named, Call($is, $p, "Callable")),
                          Sequence(
                            Comment("A leading word that can also be called (\"import(...)\"): its brackets are said."),
                            Call($word),
                            Call($link, $at, $p, "Takes")
                          ),
                          If(
                            And($named, Call($is, $p, "Heads")),
                            If(
                              Equals(Length($parts), 1),
                              Call($into, $p),
                              Sequence(Call($word), Call($link, $at, $p, "Takes"))
                            ),
                            If(
                              And($named, Not(Call($v, "prefix", $p))),
                              If(
                                Length($parts),
                                Call($into, $p),
                                Sequence(Call($link, $at, $p, "Takes"), Call($link, $close, $at, "Absorbs"))
                              ),
                              If(
                                And($round, Equals(Length($parts), 1)),
                                Call($transparent),
                                Call($word)
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// Goes on from the statement before it.
Concept(Continues(),
  IsA(Prefix()),
  IsA(CodeWord()),
  Realization($word,
    context = Hearing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"else\", \"catch\", \"finally\" go on from what was said just before them: they belong to the"),
            Comment("statement before, and take what follows them as any leading word does (\"else if ...\")."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($field, Object()),
            ForOf(
              $a,
              Member(
                Call(Member(Member($api, "cells"), "read"), Member(Index(Member($self, "args"), 3), "value")),
                "args"
              ),
              Assign(Index($field, Member($a, "name")), Member(Member($a, "value"), "args"))
            ),
            Bind($v,
              Lambda(List($k, $i),
                If(
                  And(AtLeast($i, 0), LessThan($i, Length(Index($field, $k)))),
                  Member(Index(Index($field, $k), $i), "value"),
                  Undefined()
                )
              )
            ),
            Bind($is,
              Lambda(List($i, $k),
                And(
                  And(AtLeast($i, 0), LessThan($i, Length(Member($field, "kinds")))),
                  Call(
                    Member(Member(Call($v, "kinds", $i), "args"), "some"),
                    Lambda(List($a), Equals(Member($a, "value"), $k))
                  )
                )
              )
            ),
            Bind($out, List()),
            Var($p, Subtract($at, 1)),
            While(And(AtLeast($p, 0), Call($is, $p, "Separator")), PostDecrement($p)),
            Var($r, $p),
            While(And(AtLeast($r, 0), AtLeast(Call($v, "parent", $r), 0)), Assign($r, Call($v, "parent", $r))),
            Comment("Once that statement is one thing, led by a word that leads (not yet by something that"),
            Comment("itself goes on from before, which will find its own place first)."),
            If(
              And(And(AtLeast($r, 0), Call($is, $r, "Prefix")), Not(Call($is, $r, "Continues"))),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  $at,
                  $r,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            Bind($leads,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Object(head = "Prefix", args = Member($self, "args")),
                  Member($api, "context")
                )
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "List",
                Spread($out),
                Spread(
                  If(
                    And($leads, Equals(Member($leads, "head"), "List")),
                    Map(Member($leads, "args"), Lambda(List($a), Member($a, "value"))),
                    List()
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

// A block of statements.
Concept(Scope(), IsA(Opener()), IsA(CodeWord()))

Concept(Closer(), IsA(CodeWord()))

Concept(Separator(), IsA(CodeWord()))

// Round brackets: after a name, its arguments.
Concept(Round(), IsA(CodeWord()))

// Takes the thing before it too.
Concept(Postfix(), IsA(CodeWord()))

// Belongs to the name before it.
Concept(Attached(), IsA(CodeWord()))

// Takes each thing inside it, with nothing between them.
Concept(Juxtaposed(), IsA(CodeWord()))

// Only how its one thing is said.
Concept(Transparent(), IsA(CodeWord()))

// Heads a statement: a bracketed header, then what it heads.
Concept(Heads(), IsA(CodeWord()))

// Can stand before a thing alone: "-x".
Concept(Unary(), IsA(CodeWord()))

// Leads, and can also be called: "import(...)".
Concept(Callable(), IsA(CodeWord()))

// A word of the language only where it is not used as a name: "get(x)" calls get.
Concept(Contextual(), IsA(CodeWord()))

// A brace after it opens a block.
Concept(TakesBlock(), IsA(CodeWord()))

// The words, their spellings, and how tightly each binds (higher is tighter).
Concept(Dot(),
  IsA(Infix()),
  Spelled("."),
  Binds(200),
  Realization($word,
    context = Context(Code($language), Reading()),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"a.name\": the member of a by that name; \"a.b(c)\": that member called. Where the language's"),
            Comment("own reading rules say a member or a member call is a Concept of the code IR (\"xs.length\" is"),
            Comment("Length(xs), \"xs.map(f)\" is Map(xs, f)), it reads as that Concept: the rules are asked, not"),
            Comment("repeated here."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind(List($owner, $member),
              Map(
                Filter(Member($self, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                Lambda(List($a), Member($a, "value"))
              )
            ),
            Comment("\"import.meta\": the module's own facts."),
            If(
              And(
                And(
                  And(
                    And(Call($isCall, $owner), Equals(Member($owner, "head"), "Import")),
                    Call(
                      Member(Member($owner, "args"), "every"),
                      Lambda(List($a), NotEquals(Member($a, "name"), Undefined()))
                    )
                  ),
                  Call($isCall, $member)
                ),
                Equals(Member($member, "head"), "Meta")
              ),
              Return(Call(Member($api, "call"), "ImportMeta")),
              Undefined()
            ),
            Bind($of,
              Await(
                Call(
                  Member($api, "evaluate"),
                  $owner,
                  Member($api, "context")
                )
