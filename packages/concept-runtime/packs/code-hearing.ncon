// A bracket: finds what closes it, then groups what it holds, for whoever it belongs to.
Concept(Opener(),
  Realization($word,
    context = Sensing(Code($language)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("A bracket finds what closes it (Closes). (Its hearing, once it has, is opener.js.)"),
            Comment("A bracket groups what it holds, and where it stands says whose the group is:"),
            Comment("- after a name, round brackets are what the name takes (\"print(x)\"): its arguments;"),
            Comment("empty, they stay said (\"print()\" is Print(Parens()));"),
            Comment("- after a word that heads a statement (\"if (...)\", \"for (...)\"), they are its header;"),
            Comment("- a block belongs to the word that leads what is said before it (\"for ... { }\", \"if"),
            Comment("...:\"), its statements that word's; a block a name leads is the name's Block (\"m() { }\");"),
            Comment("- angles belong to the name before them; an index takes the thing before it too;"),
            Comment("- a template takes each piece inside it, an interpolation is its one thing;"),
            Comment("- any other group is itself a word (Brackets(1, 2), Braces(...), Parens(a, b)), except"),
            Comment("round brackets around one thing, which are only how the thing is said."),
            Comment("The closing bracket and the separators are part of how it is said: absorbed."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($field, Object()),
