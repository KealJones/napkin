// Reading what was heard as the code IR.
Concept(Concept(),
  Realization($word,
    context = Context(Code($language), Reading()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("A word read as code that has no reading of its own is a name: alone, the variable it"),
            Comment("names ($element); holding things, a call of it with them (print(x))."),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($said,
              Call(Member(Member($self, "args"), "find"), Lambda(List($a), Equals(Member($a, "name"), "said")))
            ),
            Bind($name,
              If(
                $said,
                Member($said, "value"),
                Add(
                  Call(Member(Index(Member($self, "head"), 0), "toLowerCase")),
                  Call(Member(Member($self, "head"), "slice"), 1)
                )
              )
            ),
            Bind($values,
              Map(
                Filter(Member($self, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                Lambda(List($a), Member($a, "value"))
              )
            ),
            Bind($variable, Call(Member($api, "fromHost"), Object(variable = $name))),
            Return(
              If(
                Length($values),
                Call(
                  Member($api, "call"),
                  "Call",
                  $variable,
                  Spread($values)
                ),
                $variable
              )
            )
          )
        )
      )
    )
  )
)

