Concept(Concept(),
  Realization($word,
    context = Context(Code($language), Reading()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("A word read as code that has no reading of its own is a name: alone, the variable it"),
            Comment("names ($element); holding things, or said with its empty brackets, a call of it (print(x),"),
            Comment("print()). Angles after it are what types it is used at, set aside here."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($said,
              Call(Member(Member($self, "args"), "find"), Lambda(List($a), Equals(Member($a, "name"), "said")))
            ),
            Bind($name,
              If(
                $said,
                Member($said, "value"),
                Add(
                  Call(Member(Index(Member($self, "head"), 0), "toLowerCase")),
                  Call(Member(Member($self, "head"), "slice"), 1)
                )
              )
            ),
            Bind($values,
              Map(
                Filter(Member($self, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                Lambda(List($a), Member($a, "value"))
              )
            ),
            Bind($called,
              Call(
                Member($values, "some"),
                Lambda(List($v),
                  And(
                    And(Call($isCall, $v), Equals(Member($v, "head"), "Parens")),
                    Equals(Length(Member($v, "args")), 0)
                  )
                )
              )
            ),
            Bind($passed,
              Filter(
                $values,
                Lambda(List($v),
                  Not(
                    And(
                      Call($isCall, $v),
                      Or(
                        Or(
                          And(Equals(Member($v, "head"), "Parens"), Equals(Length(Member($v, "args")), 0)),
                          Equals(Member($v, "head"), "Angles")
                        ),
                        Equals(Member($v, "head"), "Comment")
                      )
                    )
                  )
                )
              )
            ),
            Bind($variable, Call(Member($api, "fromHost"), Object(variable = $name))),
            Return(
              If(
                Or(Length($passed), $called),
                Call(
                  Member($api, "call"),
                  "Call",
                  $variable,
                  Spread($passed)
                ),
                $variable
              )
            )
          )
        )
      )
    )
  )
)

Concept(Phrases(),
  Realization(Phrases(Rest($statements)),
    context = Context(Code($language), Reading()),
