            Comment("\"`a${b}c`\": its pieces of text and what is between them, joined."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind($parts, Call($positional, $self)),
            Bind($named,
              Lambda(List($k),
                Sequence(
                  Bind($a,
                    Call(Member(Member($self, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $k)))
                  ),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($read, Lambda(List($e), Call(Member($api, "evaluate"), $e, Member($api, "context")))),
            Bind($ask,
              Lambda(List($head, Spread($xs)),
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), $head, Spread($xs)),
                  Member($api, "context")
                )
              )
            ),
            Bind($nameOf,
              Lambda(List($e),
                Sequence(
                  If(Equals(TypeOf($e), "string"), Return($e), Undefined()),
                  If(
                    Not(Call($isCall, $e)),
                    Return(Call($String, $e)),
                    Undefined()
                  ),
                  Bind($said,
                    Call(Member(Member($e, "args"), "find"), Lambda(List($a), Equals(Member($a, "name"), "said")))
                  ),
                  Return(
                    If(
                      $said,
                      Member($said, "value"),
                      Add(
                        Call(Member(Index(Member($e, "head"), 0), "toLowerCase")),
                        Call(Member(Member($e, "head"), "slice"), 1)
                      )
                    )
                  )
                )
              )
            ),
            Bind($variable, Lambda(List($e), Call(Member($api, "fromHost"), Object(variable = Call($nameOf, $e))))),
            Bind($is, Lambda(List($e, $head), And(Call($isCall, $e), Equals(Member($e, "head"), $head)))),
            Comment("A word typed other than as its plain name (\"Set\" beside \"set\") is only a name here."),
            If(
              NotEquals(Call($named, "said"), Undefined()),
              Sequence(
                Bind($xs, List()),
                Var($called, false),
                ForOf(
                  $p,
                  $parts,
                  If(
                    And(Call($is, $p, "Parens"), Equals(Length(Member($p, "args")), 0)),
                    Assign($called, true),
                    If(
                      Not(Call($is, $p, "Angles")),
                      Call(Member($xs, "push"), Await(Call($read, $p))),
                      Undefined()
                    )
                  )
                ),
                Return(
                  If(
                    Or(Length($xs), $called),
                    Call(
                      Member($api, "call"),
                      "Call",
                      Call($variable, $self),
                      Spread($xs)
                    ),
                    Call($variable, $self)
                  )
                )
              ),
              Undefined()
            ),
            Var($acc, Await(Call($read, Index($parts, 0)))),
            For(
              Var($i, 1),
              LessThan($i, Length($parts)),
              Assign($i, Add($i, 2)),
              Sequence(
                Assign(
                  $acc,
                  Call(
                    Member($api, "call"),
                    "Add",
                    $acc,
                    Await(Call($read, Index($parts, $i)))
                  )
                ),
                If(
                  And(NotEquals(Index($parts, Add($i, 1)), Undefined()), NotEquals(Index($parts, Add($i, 1)), "")),
                  Assign(
                    $acc,
                    Call(
                      Member($api, "call"),
                      "Add",
                      $acc,
                      Index($parts, Add($i, 1))
                    )
                  ),
                  Undefined()
                )
              )
            ),
            Return($acc)
          )
        )
      )
    )
  )
)

