                Not(Call($v, "punctuation", $l))
              ),
              Sequence(
                Bind($b, Subtract(Call($v, "lo", $l), 1)),
                Comment(
                  "Something still to its left that belongs to it (\"a.b\" before \"a\" is taken): not whole yet."
                ),
                If(
                  Call($v, "operandEnd", $b),
                  Return(Call(Member($api, "call"), "List", Spread($out))),
                  Undefined()
                ),
                Bind($before,
                  If(
                    And(
                      And(AtLeast($b, 0), Not(GreaterThan(Call($v, "pair", $b), $at))),
                      Or(Call($v, "operator", $b), Call($v, "prefix", $b))
                    ),
                    Call($holdingAfter, $b),
                    Undefined()
                  )
