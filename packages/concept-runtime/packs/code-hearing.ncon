// Reading what was heard as the code IR.
Concept(Infix(),
  Realization($word,
    context = Context(Code($language), Reading()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("An operator or a leading word reads as the Concept the graph says it is a synonym of, else"),
            Comment("as itself. Holding nothing, a leading word is only a name here (\"type\", \"from\")."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            Bind($values, Filter(Member($self, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined())))),
            Bind($said,
              Call(Member(Member($self, "args"), "find"), Lambda(List($a), Equals(Member($a, "name"), "said")))
            ),
            If(
              $said,
              Sequence(
                Comment("Typed other than as its plain name (\"Set\" beside \"set\"): only a name here."),
                Bind($passed,
                  Filter(
                    Map($values, Lambda(List($a), Member($a, "value"))),
                    Lambda(List($v),
                      Not(
                        And(
                          Call($isCall, $v),
                          Or(
                            Equals(Member($v, "head"), "Angles"),
                            And(Equals(Member($v, "head"), "Parens"), Equals(Length(Member($v, "args")), 0))
                          )
                        )
                      )
                    )
                  )
                ),
                Bind($called,
                  Call(
                    Member($values, "some"),
                    Lambda(List($a),
                      And(
                        And(Call($isCall, Member($a, "value")), Equals(Member(Member($a, "value"), "head"), "Parens")),
                        Equals(Length(Member(Member($a, "value"), "args")), 0)
                      )
                    )
                  )
                ),
                Bind($variable, Call(Member($api, "fromHost"), Object(variable = Member($said, "value")))),
                Return(
                  If(
                    Or(Length($passed), $called),
                    Call(
                      Member($api, "call"),
                      "Call",
                      $variable,
                      Spread($passed)
                    ),
                    $variable
                  )
                )
              ),
              Undefined()
            ),
            If(
              Not(Length($values)),
              Return(
                Call(
                  Member($api, "fromHost"),
                  Object(
                    variable = If(
                      $said,
                      Member($said, "value"),
                      Add(
                        Call(Member(Index(Member($self, "head"), 0), "toLowerCase")),
                        Call(Member(Member($self, "head"), "slice"), 1)
                      )
                    )
                  )
                )
              ),
              Undefined()
            ),
            Bind($unit, Call(Member(Member($api, "store"), "get"), Member($self, "head"))),
            Bind($synonym,
              If(
                $unit,
                Call(
                  Member(Member($unit, "relations"), "find"),
                  Lambda(List($r),
                    And(
                      And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), "SynonymOf")),
                      Call($isCall, Member(Index(Member(Member($r, "claim"), "args"), 0), "value"))
                    )
                  )
                ),
                Undefined()
              )
            ),
            Return(
              Object(
                head = If(
                  $synonym,
                  Member(Member(Index(Member(Member($synonym, "claim"), "args"), 0), "value"), "head"),
                  Member($self, "head")
                ),
                args = $values
              )
            )
          )
        )
      )
    )
  )
)

