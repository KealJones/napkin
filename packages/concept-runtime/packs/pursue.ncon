            ),
            Bind($parts, List()),
            Bind($gather,
              Lambda(List($e),
                Sequence(
                  If(Not(Call($isCall, $e)), Return(), Undefined()),
                  ForOf(
                    $a,
                    Member($e, "args"),
                    If(
                      And(Equals(Member($a, "name"), Undefined()), Call($isCall, Member($a, "value"))),
                      Sequence(Call(Member($parts, "push"), Member($a, "value")), Call($gather, Member($a, "value"))),
                      Undefined()
                    )
                  ),
                  Undefined()
                )
              )
            ),
            Call($gather, $goal),
            ForOf(
              $part,
              $parts,
              Sequence(
                Bind($unit, Call(Member(Member($api, "store"), "get"), Member($part, "head"))),
                If(
                  Or(
                    Not($unit),
                    Not(
                      Call(Member(Member($unit, "realizations"), "some"), Lambda(List($r), Not(Member($r, "retired"))))
                    )
                  ),
                  Continue(),
                  Undefined()
                ),
                Var($r, Undefined()),
                Try(Assign($r, Await(Call(Member($api, "evaluate"), $part, $here))), Catch($error, Continue())),
                If(
                  Or(
                    Not(Call($isCall, $r)),
                    Equals(Call(Member($api, "format"), $r), Call(Member($api, "format"), $part))
                  ),
                  Continue(),
                  Undefined()
                ),
                Bind($kinds,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Call(
                        Member($api, "call"),
                        "Closure",
                        Member($r, "head"),
                        "IsA"
                      )
                    )
                  )
                ),
                If(
                  And(
                    Call($isCall, $kinds),
                    Call(
                      Member(Member($kinds, "args"), "some"),
                      Lambda(List($a),
                        And(Call($isCall, Member($a, "value")), Equals(Member(Member($a, "value"), "head"), "Result"))
                      )
                    )
                  ),
                  Return(
                    Call(
                      Member($api, "call"),
                      "Found",
                      If(
                        And(Equals(Member($r, "head"), "Answer"), Equals(Length(Member($r, "args")), 1)),
                        Member(Index(Member($r, "args"), 0), "value"),
                        $r
                      ),
                      $part
                    )
                  ),
                  Undefined()
                )
              )
            ),
            Bind($kinds,
              Async(
                Lambda(List($h),
                  Sequence(
                    Bind($k, Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "Closure", $h, "IsA")))),
                    Return(
                      If(
                        And(Call($isCall, $k), Equals(Member($k, "head"), "List")),
                        Map(
                          Member($k, "args"),
                          Lambda(List($a),
                            If(
                              Call($isCall, Member($a, "value")),
                              Member(Member($a, "value"), "head"),
                              Undefined()
                            )
                          )
                        ),
                        List()
                      )
                    )
                  )
                )
              )
            ),
            Bind($words, List()),
            ForOf(
              $h,
              $heads,
              Sequence(
                Bind($k, Await(Call($kinds, $h))),
                If(
                  Includes($k, "Deictic"),
                  Return(Call(Member($api, "call"), "NotFound", $goal)),
                  Undefined()
                ),
                If(
                  Or(Includes($k, "Marker"), Includes($k, "MoodKind")),
                  Continue(),
                  Undefined()
                ),
                Var($text, ""),
                ForOf(
                  $ch,
                  $h,
