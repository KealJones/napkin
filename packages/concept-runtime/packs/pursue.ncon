            ),
            ForOf(
              $p,
              $propertyWords,
              Sequence(
                Bind($property, Await(Call($find, Member($p, "text"), "property"))),
                If(
                  Or(Not(Call($isCall, $property)), NotEquals(Member($property, "head"), "Wikidata")),
                  Continue(),
                  Undefined()
                ),
                ForOf(
                  $e,
                  $words,
                  Sequence(
                    If(
                      Equals(Member($e, "head"), Member($p, "head")),
                      Continue(),
                      Undefined()
                    ),
                    Bind($senses,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "call"),
                            "WikidataSenses",
                            Member($e, "text")
