            ),
            Bind($found, New($Map)),
            Bind($find,
              Async(
                Lambda(List($text, $kind),
                  Sequence(
                    Bind($key, Add(Add($kind, ":"), $text)),
                    If(
                      Not(Call(Member($found, "has"), $key)),
