                      Call(
                        Member(Member($api, "store"), "addRealization"),
                        Member($p, "head"),
                        Object(
                          pattern = $pattern,
                          context = Call(
                            Member($api, "call"),
                            "Context",
                            Call(Member($api, "call"), "Execution"),
                            Call(Member($api, "call"), "Interrogative")
