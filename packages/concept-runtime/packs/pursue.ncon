                      ),
                      Continue(),
                      Undefined()
                    ),
                    Bind($content, OptionalMember(Index(Member($claim, "args"), 1), "value")),
                    Bind($lines, List()),
                    Bind($statements,
                      Lambda(List($e),
                        Sequence(
                          If(Not(Call($isCall, $e)), Return(), Undefined()),
                          If(
                            Equals(Member($e, "head"), "Mood"),
                            Sequence(
                              If(
                                And(
                                  Call($isCall, OptionalMember(Index(Member($e, "args"), 0), "value")),
                                  Equals(Member(Member(Index(Member($e, "args"), 0), "value"), "head"), "Declarative")
                                ),
                                Call(Member($lines, "push"), Member(Index(Member($e, "args"), 1), "value")),
                                Undefined()
                              ),
                              Return()
                            ),
                            Undefined()
                          ),
                          ForOf(
                            $a,
                            Member($e, "args"),
                            Call($statements, Member($a, "value"))
                          ),
                          Undefined()
                        )
                      )
                    ),
                    Call($statements, $content),
                    ForOf(
                      $line,
                      $lines,
                      Sequence(
                        Bind($seen, New($Set)),
                        Bind($note,
                          Lambda(List($e),
                            Sequence(
                              If(Not(Call($isCall, $e)), Return(), Undefined()),
                              Call(Member($seen, "add"), Call($base, Member($e, "head"))),
                              ForOf(
                                $a,
                                Member($e, "args"),
                                If(
                                  Equals(Member($a, "name"), Undefined()),
                                  Call($note, Member($a, "value")),
                                  Undefined()
                                )
                              ),
                              Undefined()
                            )
                          )
                        ),
                        Call($note, $line),
                        If(
                          Not(Call(Member(Concat($asked), "every"), Lambda(List($w), Call(Member($seen, "has"), $w)))),
                          Continue(),
                          Undefined()
                        ),
                        Bind($covered,
                          Lambda(List($e),
                            And(
                              Call($isCall, $e),
                              Or(
                                Call(Member($asked, "has"), Call($base, Member($e, "head"))),
                                Call(
                                  Member(Member($e, "args"), "some"),
                                  Lambda(List($a),
                                    And(Equals(Member($a, "name"), Undefined()), Call($covered, Member($a, "value")))
