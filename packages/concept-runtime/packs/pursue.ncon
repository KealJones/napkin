                    Bind($pattern, Call($leaf, $goal)),
                    Bind($owner, Call(Member(Member($api, "store"), "get"), Member($p, "head"))),
                    Bind($held,
                      If(
                        $owner,
                        Call(
                          Member(Member($owner, "realizations"), "some"),
                          Lambda(List($r),
                            Equals(
                              Call(Member($api, "format"), Member($r, "pattern")),
                              Call(Member($api, "format"), $pattern)
