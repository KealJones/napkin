Requires(Basic(), Code())

// ================================================================
// Pursue: looking for an answer instead of stopping at a residual
// (design/pursue-predict.md).
//
// Nothing here knows what is being asked about. A goal is an expression that realized to
// itself; the graph is searched for what mentions it, and what was said or held is matched
// against it by shape. Every piece is its own Concept, so each can be called, traced and
// replaced on its own.

// A relation found by what it mentions: the identity holding it, and the claim.
Concept(Held(), IsA(Result()))

// What Pursue came back with: the value, and the statement it was read from.
Concept(Found(), IsA(Result()))

// Nothing in the graph filled the goal. Not an error: the caller decides what to do next.
Concept(NotFound(), IsA(Result()))

// A web resource, read as JSON, as a Concept value. A read, so not Effectful: looking
// something up changes nothing in the world. Failed(...) when it cannot be read.
Concept(Fetch(),
  IsA(Category()),
  Realization(Fetch($url),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($url, Call(Member($api, "toHost"), Member(Index($args, 0), "value"))),
            If(
              NotEquals(TypeOf($url), "string"),
              Return(
                Call(
                  Member($api, "call"),
                  "Fetch",
                  Member(Index($args, 0), "value")
                )
              ),
              Undefined()
            ),
            Try(
              Sequence(
                Bind($response,
                  Await(
                    Call(
                      $fetch,
                      $url,
                      Object(
                        headers = Object(
                          Pair("user-agent", "Napkin/0.1 (https://github.com/KealJones/napkin)"),
                          accept = "application/json"
                        ),
                        signal = Call(Member($AbortSignal, "timeout"), 10000)
                      )
                    )
                  )
                ),
                If(
                  Not(Member($response, "ok")),
                  Return(
                    Call(
                      Member($api, "call"),
                      "Failed",
                      Call(Member($api, "call"), "Fetch", $url),
                      Member($response, "status")
                    )
                  ),
                  Undefined()
                ),
                Return(Call(Member($api, "fromHost"), Await(Call(Member($response, "json")))))
              ),
              Catch(
                $error,
                Return(
                  Call(
                    Member($api, "call"),
                    "Failed",
                    Call(Member($api, "call"), "Fetch", $url),
                    Call($String, $error)
                  )
                )
              )
            ),
            Undefined()
          )
        )
      )
    )
  )
)

// A web page's text. Failed(...) when it cannot be read.
Concept(FetchText(),
  IsA(Category()),
  Realization(FetchText($url),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($url, Call(Member($api, "toHost"), Member(Index($args, 0), "value"))),
            If(
              NotEquals(TypeOf($url), "string"),
              Return(
                Call(
                  Member($api, "call"),
                  "FetchText",
                  Member(Index($args, 0), "value")
                )
              ),
              Undefined()
            ),
            Try(
              Sequence(
                Bind($response,
                  Await(
                    Call(
                      $fetch,
                      $url,
                      Object(
                        headers = Object(
                          Pair(
                            "user-agent",
                            "Mozilla/5.0 (compatible; napkin/0.1; https://github.com/KealJones/napkin)"
                          )
                        ),
                        signal = Call(Member($AbortSignal, "timeout"), 8000)
                      )
                    )
                  )
                ),
                If(
                  Not(Member($response, "ok")),
                  Return(
                    Call(
                      Member($api, "call"),
                      "Failed",
                      Call(Member($api, "call"), "FetchText", $url),
                      Member($response, "status")
                    )
                  ),
                  Undefined()
                ),
                Return(Await(Call(Member($response, "text"))))
              ),
              Catch(
                $error,
                Return(
                  Call(
                    Member($api, "call"),
                    "Failed",
                    Call(Member($api, "call"), "FetchText", $url),
                    Call($String, $error)
                  )
                )
              )
            ),
            Undefined()
          )
        )
      )
    )
  )
)

// The pages a web search finds for a query, best first, as their addresses (DuckDuckGo's
// HTML results). WebSearch (basic) gives titles and snippets; this gives pages to read.
Concept(SearchPages(),
  IsA(Category()),
  Realization(SearchPages($query),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($query, Call(Member($api, "toHost"), Member(Index($args, 0), "value"))),
            If(
              NotEquals(TypeOf($query), "string"),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($html,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "FetchText",
                    Add("https://html.duckduckgo.com/html/?q=", Call($encodeURIComponent, $query))
                  )
                )
              )
            ),
            If(
              NotEquals(TypeOf($html), "string"),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($out, List()),
            Bind($marker, "class=\"result__a\""),
            Var($at, Call(Member($html, "indexOf"), $marker)),
            While(
              And(AtLeast($at, 0), LessThan(Length($out), 6)),
              Sequence(
                Bind($href, Call(Member($html, "indexOf"), "href=\"", $at)),
                Bind($end, Call(Member($html, "indexOf"), "\"", Add($href, 6))),
                Var($url, Call(Member($html, "slice"), Add($href, 6), $end)),
                Bind($u, Call(Member($url, "indexOf"), "uddg=")),
                If(
                  AtLeast($u, 0),
                  Assign(
                    $url,
                    Call(
                      $decodeURIComponent,
                      Index(Call(Member(Call(Member($url, "slice"), Add($u, 5)), "split"), "&"), 0)
                    )
                  ),
                  Undefined()
                ),
                If(
                  And(
                    And(Call(Member($url, "startsWith"), "http"), Not(Includes($url, "duckduckgo.com/y.js"))),
                    Not(Includes($out, $url))
                  ),
                  Call(Member($out, "push"), $url),
                  Undefined()
                ),
                Assign($at, Call(Member($html, "indexOf"), $marker, $end))
              )
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// What a page lists, as text: every list item of two to ten words, without the page's
// scripts, navigation, header and footer.
Concept(ListItems(),
  IsA(Category()),
  Realization(ListItems($url),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($url, Call(Member($api, "toHost"), Member(Index($args, 0), "value"))),
            Bind($page,
              If(
                Equals(TypeOf($url), "string"),
                Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "FetchText", $url))),
                Undefined()
              )
            ),
            If(
              NotEquals(TypeOf($page), "string"),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Var($body, $page),
            ForOf(
              $tag,
              List("script", "style", "nav", "header", "footer"),
              Assign(
                $body,
                Call(
                  Member($body, "replace"),
                  New(
                    $RegExp,
                    Add(Add(Add(Add("<", $tag), "[\\s\\S]*?</"), $tag), ">"),
                    "gi"
                  ),
                  " "
                )
              )
            ),
            Bind($text,
              Lambda(List($s),
                Call(
                  Member(
                    Call(
                      Member(
                        Call(
                          Member(
                            Call(
                              Member(
                                Call(
                                  Member(Call(Member($s, "replace"), Regex("<[^>]+>", "g"), " "), "replace"),
                                  Regex("&amp;", "g"),
                                  "&"
                                ),
                                "replace"
                              ),
                              Regex("&#8217;|&rsquo;|&#039;|&#39;", "g"),
                              "'"
                            ),
                            "replace"
                          ),
                          Regex("&[a-z#0-9]+;", "g"),
                          " "
                        ),
                        "replace"
                      ),
                      Regex("\\s+", "g"),
                      " "
                    ),
                    "trim"
                  )
                )
              )
            ),
            Bind($items, List()),
            Bind($re, Regex("<li[^>]*>([\\s\\S]*?)<\\/li>", "gi")),
            Var($m, Undefined()),
            While(
              Assign($m, Call(Member($re, "exec"), $body)),
              Sequence(
                Bind($t, Call(Member(Index(Call(Member(Call($text, Index($m, 1)), "split"), ":"), 0), "trim"))),
                Bind($n, Length(Call(Member($t, "split"), " "))),
                If(
                  And(And(AtLeast($n, 2), AtMost($n, 10)), Not(Includes($items, $t))),
                  Call(Member($items, "push"), $t),
                  Undefined()
                )
              )
            ),
            Return(Call(Member($api, "call"), "List", Spread($items)))
          )
        )
      )
    )
  )
)

// Every Wikidata item whose label or alias is exactly this text: its senses, best known
// first (by how many Wikipedias write about it), each with what it is a kind of.
Concept(WikidataSenses(),
  IsA(Category()),
  Realization(WikidataSenses($text),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($text, Call(Member($api, "toHost"), Member(Index($args, 0), "value"))),
            If(
              NotEquals(TypeOf($text), "string"),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($base, "https://www.wikidata.org/w/api.php?format=json&"),
            Bind($search,
              Call(
                Member($api, "toHost"),
                Await(
                  Call(
                    Member($api, "evaluate"),
                    Call(
                      Member($api, "call"),
                      "Fetch",
                      Add(
                        Add($base, "action=wbsearchentities&language=en&limit=20&type=item&search="),
                        Call($encodeURIComponent, $text)
                      )
                    )
                  )
                )
              )
            ),
            Bind($hits,
              If(
                And($search, Call(Member($Array, "isArray"), Member($search, "search"))),
                Member($search, "search"),
                List()
              )
            ),
            Bind($same,
              Lambda(List($s),
                And(
                  Equals(TypeOf($s), "string"),
                  Equals(Call(Member($s, "toLowerCase")), Call(Member($text, "toLowerCase")))
                )
              )
            ),
            Bind($exact,
              Call(
                Member(
                  Filter(
                    $hits,
                    Lambda(List($h),
                      Or(
                        Call($same, Member($h, "label")),
                        And(Member($h, "match"), Call($same, Member(Member($h, "match"), "text")))
                      )
                    )
                  ),
                  "slice"
                ),
                0,
                6
              )
            ),
            If(
              Not(Length($exact)),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($got,
              Call(
                Member($api, "toHost"),
                Await(
                  Call(
                    Member($api, "evaluate"),
                    Call(
                      Member($api, "call"),
                      "Fetch",
                      Add(
                        Add($base, "action=wbgetentities&props=sitelinks|claims&ids="),
                        Call(Member(Map($exact, Lambda(List($h), Member($h, "id"))), "join"), "|")
                      )
                    )
                  )
                )
              )
            ),
            Bind($entities,
              If(
                And($got, Member($got, "entities")),
                Member($got, "entities"),
                Object()
              )
            ),
            Bind($kindsOf,
              Lambda(List($e),
                Sequence(
                  Bind($out, List()),
                  ForOf(
                    $p,
                    List("P31", "P279"),
                    ForOf(
                      $c,
                      Or(And(And($e, Member($e, "claims")), Index(Member($e, "claims"), $p)), List()),
                      Sequence(
                        Bind($v,
                          If(
                            And(Member($c, "mainsnak"), Member(Member($c, "mainsnak"), "datavalue")),
                            Member(Member(Member($c, "mainsnak"), "datavalue"), "value"),
                            Undefined()
                          )
                        ),
                        If(
                          And(And($v, Member($v, "id")), Not(Includes($out, Member($v, "id")))),
                          Call(Member($out, "push"), Member($v, "id")),
                          Undefined()
                        )
                      )
                    )
                  ),
                  Return($out)
                )
              )
            ),
            Bind($senses,
              Map(
                $exact,
                Lambda(List($h),
                  Sequence(
                    Bind($e, Index($entities, Member($h, "id"))),
                    Bind($links,
                      If(
                        And($e, Member($e, "sitelinks")),
                        Length(Call(Member($Object, "keys"), Member($e, "sitelinks"))),
                        0
                      )
                    ),
                    Return(
                      Object(
                        id = Member($h, "id"),
                        label = Or(Member($h, "label"), $text),
                        description = Or(Member($h, "description"), ""),
                        links = $links,
                        kinds = Call($kindsOf, $e)
                      )
                    )
                  )
                )
              )
            ),
            Call(Member($senses, "sort"), Lambda(List($a, $b), Subtract(Member($b, "links"), Member($a, "links")))),
            Return(
              Call(
                Member($api, "call"),
                "List",
                Spread(
                  Map(
                    $senses,
                    Lambda(List($s),
                      Object(
                        head = "Wikidata",
                        args = List(
                          Object(value = Member($s, "id")),
                          Object(value = Member($s, "label")),
                          Object(name = "description", value = Member($s, "description")),
                          Object(name = "sitelinks", value = Member($s, "links")),
                          Object(
                            name = "kinds",
                            value = Call(
                              Member($api, "call"),
                              "List",
                              Spread(Member($s, "kinds"))
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

// A Wikidata item or property whose label (or an alias) is exactly this text, as
// Wikidata(id, label). Exact, because the nearest match to a word is often another sense;
// for an item, the best-known sense ("tea" the drink, not the given name).
Concept(WikidataFind(),
  IsA(Category()),
  Realization(WikidataFind($text, $kind),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($text, Call(Member($api, "toHost"), Member(Index($args, 0), "value"))),
            Bind($kind, Call(Member($api, "toHost"), Member(Index($args, 1), "value"))),
            If(
              Or(NotEquals(TypeOf($text), "string"), NotEquals(TypeOf($kind), "string")),
              Return(
                Call(
                  Member($api, "call"),
                  "NotFound",
                  Member(Index($args, 0), "value")
                )
              ),
              Undefined()
            ),
            If(
              Equals($kind, "item"),
              Sequence(
                Bind($senses,
                  Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "WikidataSenses", $text)))
                ),
                Bind($first,
                  If(
                    And(And($senses, Equals(Member($senses, "head"), "List")), Length(Member($senses, "args"))),
                    Member(Index(Member($senses, "args"), 0), "value"),
                    Undefined()
                  )
                ),
                Return(
                  If(
                    $first,
                    Call(
                      Member($api, "call"),
                      "Wikidata",
                      Member(Index(Member($first, "args"), 0), "value"),
                      Member(Index(Member($first, "args"), 1), "value")
                    ),
                    Call(Member($api, "call"), "NotFound", $text)
                  )
                )
              ),
              Undefined()
            ),
            Bind($url,
              Add(
                Add(
                  Add(
                    "https://www.wikidata.org/w/api.php?action=wbsearchentities&format=json&language=en&limit=7&type=",
                    $kind
                  ),
                  "&search="
                ),
                Call($encodeURIComponent, $text)
              )
            ),
            Bind($found,
              Call(
                Member($api, "toHost"),
                Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "Fetch", $url)))
              )
            ),
            Bind($hits,
              If(
                And($found, Call(Member($Array, "isArray"), Member($found, "search"))),
                Member($found, "search"),
                List()
              )
            ),
            Bind($same,
              Lambda(List($s),
                And(
                  Equals(TypeOf($s), "string"),
                  Equals(Call(Member($s, "toLowerCase")), Call(Member($text, "toLowerCase")))
                )
              )
            ),
            Bind($hit,
              Or(
                Call(Member($hits, "find"), Lambda(List($h), Call($same, Member($h, "label")))),
                Call(
                  Member($hits, "find"),
                  Lambda(List($h), And(Member($h, "match"), Call($same, Member(Member($h, "match"), "text"))))
                )
              )
            ),
            If(
              Not($hit),
              Return(Call(Member($api, "call"), "NotFound", $text)),
              Undefined()
            ),
            Return(
              Call(
                Member($api, "call"),
                "Wikidata",
                Member($hit, "id"),
                Or(Member($hit, "label"), $text)
              )
            )
          )
        )
      )
    )
  )
)

// What a Wikidata item holds by a property: its values as Concepts, numbers or text.
// Preferred statements when there are any, never deprecated ones.
Concept(LookUp(),
  IsA(Category()),
  Realization(LookUp($item, $property),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($item, Member(Index($args, 0), "value")),
            Bind($property, Member(Index($args, 1), "value")),
            Bind($id,
              Lambda(List($e),
                If(
                  And(And($e, Equals(Member($e, "head"), "Wikidata")), Length(Member($e, "args"))),
                  Member(Index(Member($e, "args"), 0), "value"),
                  Undefined()
                )
              )
            ),
            Bind($q, Call($id, $item)),
            Bind($p, Call($id, $property)),
            If(
              Or(NotEquals(TypeOf($q), "string"), NotEquals(TypeOf($p), "string")),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($api_, "https://www.wikidata.org/w/api.php?format=json&"),
            Bind($got,
              Call(
                Member($api, "toHost"),
                Await(
                  Call(
                    Member($api, "evaluate"),
                    Call(
                      Member($api, "call"),
                      "Fetch",
                      Add(Add(Add(Add($api_, "action=wbgetclaims&entity="), $q), "&property="), $p)
                    )
                  )
                )
              )
            ),
            Bind($claims,
              If(
                And(
                  And($got, Member($got, "claims")),
                  Call(Member($Array, "isArray"), Index(Member($got, "claims"), $p))
                ),
                Index(Member($got, "claims"), $p),
                List()
              )
            ),
            Bind($preferred, Filter($claims, Lambda(List($c), Equals(Member($c, "rank"), "preferred")))),
            Bind($chosen,
              Call(
                Member(
                  If(
                    Length($preferred),
                    $preferred,
                    Filter($claims, Lambda(List($c), NotEquals(Member($c, "rank"), "deprecated")))
                  ),
                  "slice"
                ),
                0,
                3
              )
            ),
            Bind($name,
              Lambda(List($label),
                Sequence(
                  Var($out, ""),
                  Var($up, true),
                  ForOf(
                    $ch,
                    $label,
                    Sequence(
                      Bind($letter,
                        Or(
                          Or(And(AtLeast($ch, "a"), AtMost($ch, "z")), And(AtLeast($ch, "A"), AtMost($ch, "Z"))),
                          And(AtLeast($ch, "0"), AtMost($ch, "9"))
                        )
                      ),
                      If(
                        Not($letter),
                        Sequence(Assign($up, true), Continue()),
                        Undefined()
                      ),
                      Assign($out, Add($out, If($up, Call(Member($ch, "toUpperCase")), $ch))),
                      Assign($up, false)
                    )
                  ),
                  Return($out)
                )
              )
            ),
            Bind($values, List()),
            ForOf(
              $c,
              $chosen,
              Sequence(
                Bind($v,
                  If(
                    And(Member($c, "mainsnak"), Member(Member($c, "mainsnak"), "datavalue")),
                    Member(Member(Member($c, "mainsnak"), "datavalue"), "value"),
                    Undefined()
                  )
                ),
                If(Equals($v, Undefined()), Continue(), Undefined()),
                If(
                  Equals(TypeOf($v), "string"),
                  Call(Member($values, "push"), $v),
                  If(
                    Member($v, "id"),
                    Sequence(
                      Bind($labels,
                        Call(
                          Member($api, "toHost"),
                          Await(
                            Call(
                              Member($api, "evaluate"),
                              Call(
                                Member($api, "call"),
                                "Fetch",
                                Add(Add($api_, "action=wbgetentities&props=labels&languages=en&ids="), Member($v, "id"))
                              )
                            )
                          )
                        )
                      ),
                      Bind($label,
                        If(
                          And(
                            And(
                              And(
                                And($labels, Member($labels, "entities")),
                                Index(Member($labels, "entities"), Member($v, "id"))
                              ),
                              Member(Index(Member($labels, "entities"), Member($v, "id")), "labels")
                            ),
                            Member(Member(Index(Member($labels, "entities"), Member($v, "id")), "labels"), "en")
                          ),
                          Member(
                            Member(Member(Index(Member($labels, "entities"), Member($v, "id")), "labels"), "en"),
                            "value"
                          ),
                          Member($v, "id")
                        )
                      ),
                      Bind($head, Call($name, $label)),
                      If(
                        And($head, Not(And(AtLeast(Index($head, 0), "0"), AtMost(Index($head, 0), "9")))),
                        Sequence(
                          If(
                            Not(
                              Call(
                                Member(
                                  Member(
                                    Or(Call(Member(Member($api, "store"), "get"), $head), Object(relations = List())),
                                    "relations"
                                  ),
                                  "some"
                                ),
                                Lambda(List($r),
                                  And(Member($r, "claim"), Equals(Member(Member($r, "claim"), "head"), "Named"))
                                )
                              )
                            ),
                            Call(
                              Member(Member($api, "store"), "addRelation"),
                              $head,
                              Call(Member($api, "call"), "Named", $label)
                            ),
                            Undefined()
                          ),
                          Call(Member($values, "push"), Call(Member($api, "call"), $head))
                        ),
                        Call(Member($values, "push"), $label)
                      )
                    ),
                    If(
                      NotEquals(Member($v, "amount"), Undefined()),
                      Call(Member($values, "push"), Call($Number, Member($v, "amount"))),
                      If(
                        NotEquals(Member($v, "time"), Undefined()),
                        Call(Member($values, "push"), Member($v, "time")),
                        If(
                          NotEquals(Member($v, "text"), Undefined()),
                          Call(Member($values, "push"), Member($v, "text")),
                          Undefined()
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($seen, New($Set)),
            Bind($distinct,
              Filter(
                $values,
                Lambda(List($v),
                  If(
                    Call(Member($seen, "has"), Call(Member($api, "format"), $v)),
                    false,
                    Sequence(Call(Member($seen, "add"), Call(Member($api, "format"), $v)), true)
                  )
                )
              )
            ),
            Return(Call(Member($api, "call"), "List", Spread($distinct)))
          )
        )
      )
    )
  )
)

// What is held about something, described: "tell me about yourself". A word for someone in
// the conversation is about who it refers to.
Concept(About(),
  Realization(About($x),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Var($x, Member(Index($args, 0), "value")),
            If(
              Not(Call($isCall, $x)),
              Return(Call(Member($api, "call"), "About", $x)),
              Undefined()
            ),
            Bind($refers,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "Closure",
                    Member($x, "head"),
                    "Refers"
                  )
                )
              )
            ),
            Bind($to,
              If(
                And(
                  And(
                    And(Call($isCall, $refers), Equals(Member($refers, "head"), "List")),
                    Length(Member($refers, "args"))
                  ),
                  Call($isCall, Member(Index(Member($refers, "args"), 0), "value"))
                ),
                Member(Member(Index(Member($refers, "args"), 0), "value"), "head"),
                Undefined()
              )
            ),
            If(
              Equals($to, "Self"),
              Assign($x, Call(Member($api, "call"), "Self")),
              If(
                Equals($to, "Me"),
                Sequence(
                  Bind($user,
                    Call(
                      Member(Call(Member(Member($api, "store"), "all")), "find"),
                      Lambda(List($u),
                        Call(
                          Member(Member($u, "relations"), "some"),
                          Lambda(List($r),
                            And(
                              And(
                                And(
                                  Call($isCall, Member($r, "claim")),
                                  Equals(Member(Member($r, "claim"), "head"), "IsA")
                                ),
                                Call($isCall, OptionalMember(Index(Member(Member($r, "claim"), "args"), 0), "value"))
                              ),
                              Equals(
                                Member(Member(Index(Member(Member($r, "claim"), "args"), 0), "value"), "head"),
                                "User"
                              )
                            )
                          )
                        )
                      )
                    )
                  ),
                  If(
                    $user,
                    Assign($x, Call(Member($api, "call"), Member($user, "identity"))),
                    Undefined()
                  )
                ),
                Undefined()
              )
            ),
            Bind($described,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "Relations", $x),
                  Call(Member($api, "call"), "Describe")
                )
              )
            ),
            Return(
              If(
                And(Call($isCall, $described), Equals(Member($described, "head"), "Describes")),
                $described,
                Call(
                  Member($api, "call"),
                  "About",
                  Member(Index($args, 0), "value")
                )
              )
            )
          )
        )
      )
    )
  )
)

// A route Pursue found and kept: an item's value by a Wikidata property, the sense that has it.
Concept(LookUpBy(),
  IsA(Category()),
  Realization(LookUpBy($item, $property),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind(List($item, $property), Map($args, Lambda(List($a), Member($a, "value")))),
            If(
              Or(Not(Call($isCall, $item)), Not(Call($isCall, $property))),
              Return(
                Call(
                  Member($api, "call"),
                  "LookUpBy",
                  Spread(Map($args, Lambda(List($a), Member($a, "value"))))
                )
              ),
              Undefined()
            ),
            Var($text, ""),
            ForOf(
              $ch,
              Member($item, "head"),
              Assign(
                $text,
                Add(
                  $text,
                  If(
                    And(And(AtLeast($ch, "A"), AtMost($ch, "Z")), Length($text)),
                    Add(" ", Call(Member($ch, "toLowerCase"))),
                    Call(Member($ch, "toLowerCase"))
                  )
                )
              )
            ),
            Bind($senses, Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "WikidataSenses", $text)))),
            ForOf(
              $s,
              If(
                And(Call($isCall, $senses), Equals(Member($senses, "head"), "List")),
                Call(Member(Member($senses, "args"), "slice"), 0, 4),
                List()
              ),
              Sequence(
                Bind($candidate,
                  Call(
                    Member($api, "call"),
                    "Wikidata",
                    Member(Index(Member(Member($s, "value"), "args"), 0), "value"),
                    Member(Index(Member(Member($s, "value"), "args"), 1), "value")
                  )
                ),
                Bind($got,
                  Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "LookUp", $candidate, $property)))
                ),
                If(
                  And(And(Call($isCall, $got), Equals(Member($got, "head"), "List")), Length(Member($got, "args"))),
                  Return(
                    If(
                      Equals(Length(Member($got, "args")), 1),
                      Member(Index(Member($got, "args"), 0), "value"),
                      $got
                    )
                  ),
                  Undefined()
                )
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "LookUpBy",
                Spread(Map($args, Lambda(List($a), Member($a, "value"))))
              )
            )
          )
        )
      )
    )
  )
)

// Where a kept route came from.
Concept(Chunked(), IsA(Data()))

// Every relation mentioning a Concept, at any depth, read from the store's mention index.
Concept(Mentions(),
  IsA(Category()),
  Realization(Mentions($x),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Lambda(List($args, $bindings, $api),
        Sequence(
          Bind($x, Member(Index($args, 0), "value")),
          Bind($key,
            If(
              And(And($x, Equals(TypeOf($x), "object")), In("head", $x)),
              Call(Member($api, "call"), Member($x, "head")),
              $x
            )
          ),
          Bind($found, Call(Member(Member($api, "store"), "mentioning"), $key)),
          Return(
            Call(
              Member($api, "call"),
              "List",
              Spread(
                Map(
                  $found,
                  Lambda(List($m),
                    Call(
                      Member($api, "call"),
                      "Held",
                      Call(Member($api, "call"), Member($m, "identity")),
                      Member(Member($m, "relation"), "claim")
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

// Does a stored expression say more than the goal, in the goal's own shape? Same heads in the
// same places, with arguments the goal did not have. The answer is those extra arguments, a
// List, or False when the stored expression is not the goal's shape at all.
//
// "my name is Keal" is My(Name(Is(Keal()))); "what is my name" asks about My(Name()). The
// stored one extends the asked one by Is(Keal()).
Concept(Extends(),
  IsA(Category()),
  Realization(Extends($stored, $goal),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Lambda(List($args, $bindings, $api),
        Sequence(
          Bind($stored, Member(Index($args, 0), "value")),
          Bind($goal, Member(Index($args, 1), "value")),
          Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
          Bind($positional,
            Lambda(List($e),
              Map(
                Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                Lambda(List($a), Member($a, "value"))
              )
            )
          ),
          Bind($rest,
            Lambda(List($s, $g),
              Sequence(
                If(
                  Not(Call($isCall, $g)),
                  Return(
                    If(
                      Equals(Call(Member($api, "format"), $s), Call(Member($api, "format"), $g)),
                      List(),
                      Undefined()
                    )
                  ),
                  Undefined()
                ),
                If(
                  Or(Not(Call($isCall, $s)), NotEquals(Member($s, "head"), Member($g, "head"))),
                  Return(Undefined()),
                  Undefined()
                ),
                Bind($ss, Call($positional, $s)),
                Bind($gs, Call($positional, $g)),
                If(
                  LessThan(Length($ss), Length($gs)),
                  Return(Undefined()),
                  Undefined()
                ),
                Bind($left, List()),
                For(
                  Var($i, 0),
                  LessThan($i, Length($gs)),
                  PostIncrement($i),
                  Sequence(
                    Bind($r, Call($rest, Index($ss, $i), Index($gs, $i))),
                    If(
                      Equals($r, Undefined()),
                      Return(Undefined()),
                      Undefined()
                    ),
                    Call(Member($left, "push"), Spread($r))
                  )
                ),
                ForOf(
                  $v,
                  Call(Member($ss, "slice"), Length($gs)),
                  Call(Member($left, "push"), $v)
                ),
                Return($left)
              )
            )
          ),
          Bind($left, Call($rest, $stored, $goal)),
          If(
            Equals($left, Undefined()),
            Return(Call(Member($api, "call"), "False")),
            Undefined()
          ),
          Return(Call(Member($api, "call"), "List", Spread($left)))
        )
      )
    )
  )
)

// Fill a goal from the graph.
//
// The goal's rarest head is searched first, so a word every relation mentions does not
// flood the candidates (the fan effect). Newest first, so what was said last wins. What was
// said counts only from the one asking, since "my" in someone else's words is theirs, and a
// question asserts nothing, so interrogative lines are skipped. A single extra argument that
// wraps one value, like Is(Keal()), answers with the value. A second argument is what the
// question asks for (Someone(), Place(), Time(), Amount()), and an answer of another kind is
// passed over.
//
// When the graph has nothing, the world is asked: of the goal's words, one names a Wikidata
// property and another an item ("capital", "germany"), tried in turn. What is found is kept
// on the item's Concept in the shape it was asked in, with where it came from, so the next
// ask is answered from the graph. A goal about the people talking is never looked up.
Concept(Pursue(),
  IsA(Category()),
  Realization(Pursue(Rest($goal)),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($goal, Member(Index($args, 0), "value")),
            Bind($asks,
              If(
                GreaterThan(Length($args), 1),
                Member(Index($args, 1), "value"),
                Undefined()
              )
            ),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            If(
              Not(Call($isCall, $goal)),
              Return(Call(Member($api, "call"), "NotFound", $goal)),
              Undefined()
            ),
            Bind($wanted, If(Call($isCall, $asks), Member($asks, "head"), Undefined())),
            Bind($fits,
              Lambda(List($v),
                Sequence(
                  If(
                    Or(Equals($wanted, "Someone"), Equals($wanted, "Place")),
                    Return(And(Call($isCall, $v), Not(Length(Member($v, "args"))))),
                    Undefined()
                  ),
                  If(
                    Equals($wanted, "Amount"),
                    Return(Equals(TypeOf($v), "number")),
                    Undefined()
                  ),
                  If(
                    Equals($wanted, "Time"),
                    Return(Or(Equals(TypeOf($v), "string"), Equals(TypeOf($v), "number"))),
                    Undefined()
                  ),
                  Return(true)
                )
              )
            ),
            Bind($heads, List()),
            Bind($collect,
              Lambda(List($e),
                Sequence(
                  If(Not(Call($isCall, $e)), Return(), Undefined()),
                  If(
                    Not(Includes($heads, Member($e, "head"))),
                    Call(Member($heads, "push"), Member($e, "head")),
                    Undefined()
                  ),
                  ForOf(
                    $a,
                    Member($e, "args"),
                    If(
                      Equals(Member($a, "name"), Undefined()),
                      Call($collect, Member($a, "value")),
                      Undefined()
                    )
                  ),
                  Undefined()
                )
              )
            ),
            Call($collect, $goal),
            Bind($answer,
              Lambda(List($values),
                Sequence(
                  Bind($only,
                    If(
                      Equals(Length($values), 1),
                      Index($values, 0),
                      Undefined()
                    )
                  ),
                  If(
                    And(
                      And(
                        And(NotEquals($only, Undefined()), Call($isCall, $only)),
                        Equals(Length(Member($only, "args")), 1)
                      ),
                      Call(Member(Member($api, "store"), "has"), Member($only, "head"))
                    ),
                    Return(Member(Index(Member($only, "args"), 0), "value")),
                    Undefined()
                  ),
                  Return(
                    If(
                      NotEquals($only, Undefined()),
                      $only,
                      Call(Member($api, "call"), "List", Spread($values))
                    )
                  )
                )
              )
            ),
            Bind($fan,
              Lambda(List($h),
                Length(Call(Member(Member($api, "store"), "mentioning"), Call(Member($api, "call"), $h)))
              )
            ),
            Bind($known, Filter($heads, Lambda(List($h), GreaterThan(Call($fan, $h), 0)))),
            If(
              Length($known),
              Sequence(
                Bind($rarest,
                  Call(
                    Member($known, "reduce"),
                    Lambda(List($a, $b), If(LessThan(Call($fan, $b), Call($fan, $a)), $b, $a))
                  )
                ),
                Bind($latest,
                  Lambda(List($r),
                    Call(
                      Member($Math, "max"),
                      0,
                      Spread(Map(Or(Member($r, "stamps"), List()), Lambda(List($s), Member($s, "seq"))))
                    )
                  )
                ),
                Bind($held,
                  Call(
                    Member(
                      Call(
                        Member(
                          Call(Member(Member($api, "store"), "mentioning"), Call(Member($api, "call"), $rarest)),
                          "slice"
                        )
                      ),
                      "sort"
                    ),
                    Lambda(List($a, $b),
                      Subtract(Call($latest, Member($b, "relation")), Call($latest, Member($a, "relation")))
                    )
                  )
                ),
                Bind($inner,
                  Lambda(List($e, $out),
                    Sequence(
                      If(Not(Call($isCall, $e)), Return(), Undefined()),
                      If(
                        And(
                          And(
                            Equals(Member($e, "head"), "Mood"),
                            Call($isCall, OptionalMember(Index(Member($e, "args"), 0), "value"))
                          ),
                          Equals(Member(Member(Index(Member($e, "args"), 0), "value"), "head"), "Interrogative")
                        ),
                        Return(),
                        Undefined()
                      ),
                      Call(Member($out, "push"), $e),
                      ForOf(
                        $a,
                        Member($e, "args"),
                        Call($inner, Member($a, "value"), $out)
                      ),
                      Undefined()
                    )
                  )
                ),
                ForOf(
                  $m,
                  Call(Member($held, "slice"), 0, 200),
                  Sequence(
                    Bind($claim, Member(Member($m, "relation"), "claim")),
                    If(Not(Call($isCall, $claim)), Continue(), Undefined()),
                    If(
                      And(
                        Equals(Member($claim, "head"), "Said"),
                        Not(
                          And(
                            Call($isCall, OptionalMember(Index(Member($claim, "args"), 0), "value")),
                            Equals(Member(Member(Index(Member($claim, "args"), 0), "value"), "head"), "Me")
                          )
                        )
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Bind($content,
                      If(
                        Equals(Member($claim, "head"), "Said"),
                        OptionalMember(Index(Member($claim, "args"), 1), "value"),
                        $claim
                      )
                    ),
                    Bind($subs, List()),
                    Call($inner, $content, $subs),
                    ForOf(
                      $s,
                      $subs,
                      Sequence(
                        Bind($left,
                          Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "Extends", $s, $goal)))
                        ),
                        If(
                          Or(
                            Or(Not(Call($isCall, $left)), NotEquals(Member($left, "head"), "List")),
                            Not(Length(Member($left, "args")))
                          ),
                          Continue(),
                          Undefined()
                        ),
                        Bind($value, Call($answer, Map(Member($left, "args"), Lambda(List($a), Member($a, "value"))))),
                        If(Not(Call($fits, $value)), Continue(), Undefined()),
                        Return(Call(Member($api, "call"), "Found", $value, $content))
                      )
                    )
                  )
                )
              ),
              Undefined()
            ),
            Bind($holderOf,
              Async(
                Lambda(List($h),
                  Sequence(
                    Bind($r, Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "Closure", $h, "Refers")))),
                    Bind($to,
                      If(
                        And(
                          And(And(Call($isCall, $r), Equals(Member($r, "head"), "List")), Length(Member($r, "args"))),
                          Call($isCall, Member(Index(Member($r, "args"), 0), "value"))
                        ),
                        Member(Member(Index(Member($r, "args"), 0), "value"), "head"),
                        Undefined()
                      )
                    ),
                    If(NotEquals($to, "Me"), Return($to), Undefined()),
                    Bind($user,
                      Call(
                        Member(Call(Member(Member($api, "store"), "all")), "find"),
                        Lambda(List($u),
                          Call(
                            Member(Member($u, "relations"), "some"),
                            Lambda(List($x),
                              And(
                                And(
                                  And(
                                    Call($isCall, Member($x, "claim")),
                                    Equals(Member(Member($x, "claim"), "head"), "IsA")
                                  ),
                                  Call($isCall, OptionalMember(Index(Member(Member($x, "claim"), "args"), 0), "value"))
                                ),
                                Equals(
                                  Member(Member(Index(Member(Member($x, "claim"), "args"), 0), "value"), "head"),
                                  "User"
                                )
                              )
                            )
                          )
                        )
                      )
                    ),
                    Return(If($user, Member($user, "identity"), Undefined()))
                  )
                )
              )
            ),
            Bind($attribute,
              If(
                And(
                  And(
                    Equals(Length(Member($goal, "args")), 1),
                    Call($isCall, Member(Index(Member($goal, "args"), 0), "value"))
                  ),
                  Not(Length(Member(Member(Index(Member($goal, "args"), 0), "value"), "args")))
                ),
                Member(Index(Member($goal, "args"), 0), "value"),
                Undefined()
              )
            ),
            Bind($holder,
              If(
                $attribute,
                Await(Call($holderOf, Member($goal, "head"))),
                Undefined()
              )
            ),
            If(
              And($holder, Call(Member(Member($api, "store"), "get"), $holder)),
              Sequence(
                Bind($baseWord,
                  Lambda(List($h),
                    Sequence(
                      Var($text, ""),
                      ForOf(
                        $ch,
                        $h,
                        Assign(
                          $text,
                          Add(
                            $text,
                            If(
                              And(And(AtLeast($ch, "A"), AtMost($ch, "Z")), Length($text)),
                              Add(" ", Call(Member($ch, "toLowerCase"))),
                              Call(Member($ch, "toLowerCase"))
                            )
                          )
                        )
                      ),
                      Return(Call(Member($api, "lemma"), $text))
                    )
                  )
                ),
                Bind($want, Call($baseWord, Member($attribute, "head"))),
                ForOf(
                  $r,
                  Member(Call(Member(Member($api, "store"), "get"), $holder), "relations"),
                  Sequence(
                    Bind($claim, Member($r, "claim")),
                    If(
                      Or(
                        Or(
                          Or(Not(Call($isCall, $claim)), NotEquals(Member($r, "context"), Undefined())),
                          NotEquals(Call($baseWord, Member($claim, "head")), $want)
                        ),
                        Not(Length(Member($claim, "args")))
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Bind($value, Member(Index(Member($claim, "args"), 0), "value")),
                    If(
                      Call($fits, $value),
                      Return(
                        Call(
                          Member($api, "call"),
                          "Found",
                          $value,
                          Call(
                            Member($api, "call"),
                            "Held",
                            Call(Member($api, "call"), $holder),
                            $claim
                          )
                        )
                      ),
                      Undefined()
                    )
                  )
                )
              ),
              Undefined()
            ),
            Bind($kindsOf,
              Async(
                Lambda(List($h),
                  Sequence(
                    Bind($k, Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "Closure", $h, "IsA")))),
                    Return(
                      If(
                        And(Call($isCall, $k), Equals(Member($k, "head"), "List")),
                        Map(
                          Member($k, "args"),
                          Lambda(List($a),
                            If(
                              Call($isCall, Member($a, "value")),
                              Member(Member($a, "value"), "head"),
                              Undefined()
                            )
                          )
                        ),
                        List()
                      )
                    )
                  )
                )
              )
            ),
            Bind($base,
              Lambda(List($h),
                Sequence(
                  Var($text, ""),
                  ForOf(
                    $ch,
                    $h,
                    Assign(
                      $text,
                      Add(
                        $text,
                        If(
                          And(And(AtLeast($ch, "A"), AtMost($ch, "Z")), Length($text)),
                          Add(" ", Call(Member($ch, "toLowerCase"))),
                          Call(Member($ch, "toLowerCase"))
                        )
                      )
                    )
                  ),
                  Return(Call(Member($api, "lemma"), $text))
                )
              )
            ),
            Bind($askedParts,
              If(
                Includes(Await(Call($kindsOf, Member($goal, "head"))), "Interrogative"),
                Map(
                  Filter(Member($goal, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                ),
                List($goal)
              )
            ),
            Bind($facets,
              If(
                And(Member($api, "context"), Equals(Member(Member($api, "context"), "head"), "Context")),
                Map(Member(Member($api, "context"), "args"), Lambda(List($a), Member($a, "value"))),
                If(
                  Member($api, "context"),
                  List(Member($api, "context")),
                  List()
                )
              )
            ),
            Bind($here,
              Call(
                Member($api, "call"),
                "Context",
                Spread($facets),
                Call(Member($api, "call"), "Hypothetical")
              )
            ),
            Bind($bareParts,
              Filter($askedParts, Lambda(List($x), And(Call($isCall, $x), Not(Length(Member($x, "args"))))))
            ),
            ForOf(
              $verb,
              $bareParts,
              Sequence(
                Bind($unit, Call(Member(Member($api, "store"), "get"), Member($verb, "head"))),
                Bind($takesOne,
                  And(
                    $unit,
                    Call(
                      Member(Member($unit, "realizations"), "some"),
                      Lambda(List($r),
                        And(
                          And(
                            And(Not(Member($r, "retired")), Call($isCall, Member($r, "pattern"))),
                            Equals(Member(Member($r, "pattern"), "head"), Member($verb, "head"))
                          ),
                          Equals(Length(Member(Member($r, "pattern"), "args")), 1)
                        )
                      )
                    )
                  )
                ),
                If(Not($takesOne), Continue(), Undefined()),
                ForOf(
                  $other,
                  $askedParts,
                  Sequence(
                    If(Equals($other, $verb), Continue(), Undefined()),
                    Bind($attempt, Call(Member($api, "call"), Member($verb, "head"), $other)),
                    Var($r, Undefined()),
                    Try(Assign($r, Await(Call(Member($api, "evaluate"), $attempt, $here))), Catch($error, Continue())),
                    If(
                      Or(
                        Not(Call($isCall, $r)),
                        Equals(Call(Member($api, "format"), $r), Call(Member($api, "format"), $attempt))
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Return(
                      Call(
                        Member($api, "call"),
                        "Found",
                        If(
                          And(Equals(Member($r, "head"), "Answer"), Equals(Length(Member($r, "args")), 1)),
                          Member(Index(Member($r, "args"), 0), "value"),
                          $r
                        ),
                        $attempt
                      )
                    )
                  )
                )
              )
            ),
            Bind($asked, New($Set)),
            ForOf(
              $part,
              $askedParts,
              Sequence(
                Bind($walkHeads,
                  Lambda(List($e),
                    Sequence(
                      If(Not(Call($isCall, $e)), Return(), Undefined()),
                      Call(Member($asked, "add"), Call($base, Member($e, "head"))),
                      ForOf(
                        $a,
                        Member($e, "args"),
                        If(
                          Equals(Member($a, "name"), Undefined()),
                          Call($walkHeads, Member($a, "value")),
                          Undefined()
                        )
                      ),
                      Undefined()
                    )
                  )
                ),
                Call($walkHeads, $part)
              )
            ),
            If(
              Member($asked, "size"),
              Sequence(
                Bind($rarestAsked, Filter($heads, Lambda(List($h), GreaterThan(Call($fan, $h), 0)))),
                Bind($pool, List()),
                ForOf(
                  $h,
                  $rarestAsked,
                  ForOf(
                    $m,
                    Call(Member(Member($api, "store"), "mentioning"), Call(Member($api, "call"), $h)),
                    If(
                      Not(Includes($pool, $m)),
                      Call(Member($pool, "push"), $m),
                      Undefined()
                    )
