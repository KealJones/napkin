                            )
                          )
                        ),
                        Bind($besides, List()),
                        Bind($collect,
                          Lambda(List($e),
                            Sequence(
                              If(Not(Call($isCall, $e)), Return(), Undefined()),
                              Bind($own, Call(Member($asked, "has"), Call($base, Member($e, "head")))),
                              If(
                                And(Not($own), NotEquals(Call($base, Member($e, "head")), $copula)),
                                Sequence(
                                  If(
                                    Not(Call($covered, $e)),
                                    Return(Void(Call(Member($besides, "push"), $e))),
                                    Undefined()
                                  ),
                                  Call(Member($besides, "push"), Call(Member($api, "call"), Member($e, "head")))
                                ),
                                Undefined()
                              ),
                              ForOf(
                                $a,
                                Member($e, "args"),
                                If(
                                  Equals(Member($a, "name"), Undefined()),
                                  Call($collect, Member($a, "value")),
                                  Undefined()
                                )
                              ),
                              Undefined()
                            )
