                          Return(
                            Object(
                              head = Member($g, "head"),
                              args = Map(
                                Filter(Member($g, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                                Lambda(List($a), Object(value = Call($leaf, Member($a, "value"))))
                              )
                            )
                          )
