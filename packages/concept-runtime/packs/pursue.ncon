                    Var($item, Undefined()),
                    Var($values, Undefined()),
                    ForOf(
                      $s,
                      If(
                        And(Call($isCall, $senses), Equals(Member($senses, "head"), "List")),
                        Call(Member(Member($senses, "args"), "slice"), 0, 4),
                        List()
                      ),
                      Sequence(
                        Bind($candidate,
                          Call(
                            Member($api, "call"),
                            "Wikidata",
                            Member(Index(Member(Member($s, "value"), "args"), 0), "value"),
                            Member(Index(Member(Member($s, "value"), "args"), 1), "value")
                          )
                        ),
                        Bind($got,
                          Await(
                            Call(Member($api, "evaluate"), Call(Member($api, "call"), "LookUp", $candidate, $property))
                          )
                        ),
                        If(
                          And(
                            And(
                              And(Call($isCall, $got), Equals(Member($got, "head"), "List")),
                              Length(Member($got, "args"))
                            ),
                            Call(
                              Member(Member($got, "args"), "every"),
                              Lambda(List($a), Call($fits, Member($a, "value")))
                            )
                          ),
                          Sequence(
                            Assign($item, $candidate),
                            Assign($values, $got),
                            Break()
                          ),
                          Undefined()
                        )
                      )
                    ),
                    If(Not($item), Continue(), Undefined()),
                    Bind($value,
                      If(
                        Equals(Length(Member($values, "args")), 1),
                        Member(Index(Member($values, "args"), 0), "value"),
                        $values
                      )
                    ),
                    Bind($from,
                      Call(
                        Member($api, "call"),
                        "Wikidata",
                        Member(Index(Member($item, "args"), 0), "value"),
                        Member(Index(Member($property, "args"), 0), "value")
                      )
                    ),
                    Bind($fact,
                      Object(
                        head = Member($goal, "head"),
                        args = Concat(
                          Member($goal, "args"),
                          List(
                            Object(value = Call(Member($api, "call"), "Is", $value)),
                            Object(name = "from", value = $from)
                          )
                        )
                      )
                    ),
                    Call(
                      Member(Member($api, "store"), "addRelation"),
                      Member($e, "head"),
                      $fact,
                      Undefined(),
                      Member(Member($api, "trace"), "cause")
                    ),
                    Bind($leaf,
                      Lambda(List($g),
                        Sequence(
                          If(Not(Call($isCall, $g)), Return($g), Undefined()),
                          If(
                            And(Equals(Member($g, "head"), Member($e, "head")), Not(Length(Member($g, "args")))),
