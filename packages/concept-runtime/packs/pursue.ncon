                      Undefined()
                    ),
                    Return(Call(Member($found, "get"), $key))
                  )
                )
              )
            ),
            Bind($propertyWords, List()),
            ForOf(
              $w,
              $words,
              Sequence(
                If(
                  Equals($wanted, "Someone"),
                  Call(Member($propertyWords, "push"), Object(Spread($w), text = Add(Member($w, "text"), " by"))),
                  Undefined()
                ),
                Call(Member($propertyWords, "push"), $w)
