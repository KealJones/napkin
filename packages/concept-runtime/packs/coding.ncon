        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($w,
              Call(
                $String,
                Otherwise(
                  OptionalMember(
                    Index(Filter($args, Lambda(List($a), Equals(Member($a, "name"), Undefined()))), 1),
                    "value"
                  ),
                  ""
                )
              )
            ),
            Return(Add(Add("Here's what it does: ", $w), If(Call(Member(Regex("[.!?]$", ""), "test"), $w), "", ".")))
          )
        )
      )
    )
  )
)

// Code in another language: which, then the code.
