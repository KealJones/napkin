// What looks wrong in code, one finding a line; that nothing does, when nothing does.
Concept(Findings(),
  Realization(Findings($code, $found),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($found, Call(Member($bindings, "get"), "found")),
            Bind($items,
              If(
                And(And(NotEquals($found, null), Equals(TypeOf($found), "object")), In("args", $found)),
                Map(Member($found, "args"), Lambda(List($a), Member($a, "value"))),
                List()
              )
            ),
            Bind($text,
              Map(
                $items,
                Lambda(List($f),
                  If(
                    And(And(NotEquals($f, null), Equals(TypeOf($f), "object")), In("args", $f)),
                    Call($String, Member(Index(Member($f, "args"), 0), "value")),
                    Call($String, $f)
                  )
                )
              )
            ),
            If(
              Not(Length($text)),
              Return("Nothing in it looks wrong to me."),
              Undefined()
            ),
            Return(
              If(
                Equals(Length($text), 1),
                Add(Add("One thing looks wrong: ", Index($text, 0)), "."),
                Add(
                  "Here's what looks wrong:\n",
                  Call(Member(Map($text, Lambda(List($t), Add("- ", $t))), "join"), "\n")
                )
              )
            )
          )
        )
      )
    )
  )
)

// Code fixed: what was changed, then the code.
Concept(Fixed(),
  Realization(Fixed($code, Rest($about)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($named,
              Lambda(List($k),
                OptionalMember(Call(Member($args, "find"), Lambda(List($a), Equals(Member($a, "name"), $k))), "value")
              )
            ),
            Bind($changes, Call($named, "changes")),
            Bind($list,
              If(
                Call($isCall, $changes),
                Map(Member($changes, "args"), Lambda(List($a), Call($String, Member($a, "value")))),
                List()
              )
            ),
            Bind($shown,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($bindings, "get"), "code"),
                  Call(Member($api, "call"), "Speaking")
                )
              )
            ),
            Bind($as, Call($named, "writtenAs")),
            Bind($said,
              If(
                Equals(Length($list), 1),
                Add(Add("Fixed: ", Index($list, 0)), "."),
                Add("Fixed:\n", Call(Member(Map($list, Lambda(List($c), Add("- ", $c))), "join"), "\n"))
              )
            ),
            Return(
              Add(
                Add(Add($said, "\n\n"), If(Equals(TypeOf($shown), "string"), $shown, "")),
                If(
                  Call($isCall, $as),
                  Add(Add("\n\n(Written in ", Member($as, "head")), ": I can't write its own language yet.)"),
                  ""
                )
              )
            )
          )
        )
      )
    )
  )
)

// What running code gave, or why it failed.
Concept(Ran(),
  Realization(Ran(Rest($what)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($error,
              OptionalMember(
                Call(Member($args, "find"), Lambda(List($a), Equals(Member($a, "name"), "error"))),
                "value"
              )
            ),
            If(
              NotEquals($error, Undefined()),
              Return(Add(Add("Running it failed: ", Call($String, $error)), ".")),
              Undefined()
            ),
            If(
              Equals(
                Call(Member($args, "find"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                Undefined()
              ),
              Return("It ran."),
              Undefined()
            ),
            Bind($v, Member(Index($args, 0), "value")),
            Comment("A value as code would write it, or as JSON when code can't write it (a record, say)."),
            Bind($shown,
              Lambda(List($x),
                Sequence(
                  Bind($w, Call(Member($api, "writeCode"), $x, "JavaScript")),
                  Return(
                    If(
                      Length(Member($w, "unwritable")),
                      Call(Member($JSON, "stringify"), Call(Member($api, "toHost"), $x)),
                      Member($w, "text")
                    )
                  )
                )
              )
            ),
            Bind($said,
              If(
                Equals(TypeOf($v), "string"),
                Call(Member($JSON, "stringify"), $v),
                If(
                  Or(
                    Or(Equals($v, Undefined()), Equals($v, null)),
                    And(Equals(TypeOf($v), "object"), Equals(Member($v, "head"), "Undefined"))
                  ),
                  "nothing",
                  If(
                    Equals(TypeOf($v), "object"),
                    Add(Add("`", Call($shown, $v)), "`"),
                    Call($String, $v)
                  )
                )
              )
            ),
            Return(Add(Add("It gives ", $said), "."))
          )
        )
      )
    )
  )
)

