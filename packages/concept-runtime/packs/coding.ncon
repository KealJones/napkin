            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($code, Call(Member($bindings, "get"), "code")),
            Bind($language,
              If(
                Call($isCall, $code),
                OptionalMember(
                  Call(Member(Member($code, "args"), "find"), Lambda(List($a), Equals(Member($a, "name"), "language"))),
                  "value"
                ),
                Undefined()
              )
            ),
            Bind($shown,
              Await(
                Call(
                  Member($api, "evaluate"),
                  $code,
                  Call(Member($api, "call"), "Speaking")
                )
              )
            ),
