      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($code,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "CodeOf",
                    Call(Member($bindings, "get"), "thing")
                  ),
                  Member($api, "context")
                )
              )
            ),
            If(
              And(Call($isCall, $code), Equals(Member($code, "head"), "SourceCode")),
              Return(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "Explain", $code),
                  Member($api, "context")
                )
              ),
              Undefined()
            ),
            Return(
              Call(
                Member($api, "evaluate"),
                Call(
                  Member($api, "call"),
                  "What",
                  Call(Member($bindings, "get"), "thing")
                ),
                Member($api, "context")
              )
            )
          )
        )
      )
    )
  )
)

