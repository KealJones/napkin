// Code written from examples the message shows ("write a function where f(1) is 2, f(2) is 4"),
// in the language said, if one is (a TargetLanguage the graph holds), else JavaScript. With no
// examples, a function that does what a doing names (WriteDoing).
Concept(Write(),
  Realization(Write(Rest($said)),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($languages,
              Map(
                Filter(
                  Call(Member(Member($api, "store"), "all")),
                  Lambda(List($u),
                    Call(
                      Member(Member($u, "relations"), "some"),
                      Lambda(List($r),
                        And(
                          And(
                            And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), "IsA")),
                            Call($isCall, Member(Index(Member(Member($r, "claim"), "args"), 0), "value"))
                          ),
                          Equals(
                            Member(Member(Index(Member(Member($r, "claim"), "args"), 0), "value"), "head"),
                            "TargetLanguage"
                          )
                        )
                      )
                    )
                  )
                ),
                Lambda(List($u), Member($u, "identity"))
              )
            ),
            Var($examples, Undefined()),
            Var($target, Undefined()),
            Bind($find,
              Lambda(List($e),
                Sequence(
                  If(Not(Call($isCall, $e)), Return(), Undefined()),
                  If(
                    Equals(Member($e, "head"), "Examples"),
                    Assign($examples, Otherwise($examples, $e)),
                    Undefined()
                  ),
                  Bind($hit,
                    Call(
                      Member($languages, "find"),
                      Lambda(List($l),
                        Equals(Call(Member($l, "toLowerCase")), Call(Member(Member($e, "head"), "toLowerCase")))
                      )
                    )
                  ),
                  If(
                    $hit,
                    Assign($target, Otherwise($target, $hit)),
                    Undefined()
                  ),
                  ForOf(
                    $a,
                    Member($e, "args"),
                    Call($find, Member($a, "value"))
                  ),
                  Undefined()
                )
              )
            ),
            ForOf($a, $args, Call($find, Member($a, "value"))),
            Comment(
              "A language said may have been lifted into the context the order runs in (TargetLanguage is a facet)."
            ),
            Bind($inContext,
              Lambda(List($e),
                Sequence(
                  If(Not(Call($isCall, $e)), Return(), Undefined()),
                  Bind($hit, Call(Member($languages, "find"), Lambda(List($l), Equals($l, Member($e, "head"))))),
                  If(
                    $hit,
                    Assign($target, Otherwise($target, $hit)),
                    Undefined()
                  ),
                  ForOf(
                    $a,
                    Member($e, "args"),
                    Call($inContext, Member($a, "value"))
                  ),
                  Undefined()
                )
              )
            ),
            If(
              $examples,
              Call($inContext, Member($api, "context")),
              Undefined()
            ),
            If(
              Not($examples),
              Return(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "WriteDoing",
                    Spread(Map($args, Lambda(List($a), Member($a, "value"))))
                  ),
                  Member($api, "context")
                )
              ),
              Undefined()
            ),
            Bind($derived,
              Await(
                Call(
                  Member($api, "evaluate"),
                  $examples,
                  Member($api, "context")
                )
              )
            ),
            If(
              Or(
                Or(Or(Not($target), Equals($target, "JavaScript")), Not(Call($isCall, $derived))),
                NotEquals(Member($derived, "head"), "Derived")
              ),
              Return($derived),
              Undefined()
            ),
            Bind($ir,
              Member(
                Call(
                  Member(Member(Member(Index(Member($derived, "args"), 0), "value"), "args"), "find"),
                  Lambda(List($a), Equals(Member($a, "name"), "ir"))
                ),
                "value"
              )
            ),
            Bind($written, Call(Member($api, "writeCode"), $ir, $target)),
            If(
              Length(Member($written, "unwritable")),
              Return(
                Call(
                  Member($api, "call"),
                  "CannotWrite",
                  $target,
                  Call(
                    Member($api, "call"),
                    "List",
                    Spread(Member($written, "unwritable"))
                  )
                )
              ),
              Undefined()
            ),
            Return(
              Object(
                Spread($derived),
                args = Concat(
                  List(
                    Object(
                      value = Object(
                        head = "SourceCode",
                        args = List(
                          Object(value = Member($written, "text")),
                          Object(name = "language", value = Call(Member($api, "call"), $target)),
                          Object(name = "ir", value = $ir)
                        )
                      )
                    )
                  ),
                  Call(Member(Member($derived, "args"), "slice"), 1)
                )
              )
            )
          )
        )
      )
    )
  )
)

// A function that does what a doing said names ("write a function that adds two numbers"): the
// Concept the verb is (Adds is Add), taking as many values as its own realization does, written
// in the language said when code can be written for it. Derived(SourceCode(...)), CannotWrite, or
// Write itself when nothing said is a doing Napkin has.
Concept(WriteDoing(),
  Realization(WriteDoing(Rest($said)),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($isVar,
              Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("variable", $e)))
            ),
            Bind($languages,
              Map(
                Filter(
                  Call(Member(Member($api, "store"), "all")),
                  Lambda(List($u),
                    Call(
                      Member(Member($u, "relations"), "some"),
                      Lambda(List($r),
                        And(
                          And(
                            And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), "IsA")),
                            Call($isCall, Member(Index(Member(Member($r, "claim"), "args"), 0), "value"))
                          ),
                          Equals(
                            Member(Member(Index(Member(Member($r, "claim"), "args"), 0), "value"), "head"),
                            "TargetLanguage"
                          )
                        )
                      )
                    )
                  )
                ),
                Lambda(List($u), Member($u, "identity"))
              )
            ),
            Var($target, Undefined()),
            Bind($inContext,
              Lambda(List($e),
                Sequence(
                  If(
                    Or($target, Not(Call($isCall, $e))),
                    Return(),
                    Undefined()
                  ),
                  Assign($target, Call(Member($languages, "find"), Lambda(List($l), Equals($l, Member($e, "head"))))),
                  ForOf(
                    $a,
                    Member($e, "args"),
                    Call($inContext, Member($a, "value"))
                  ),
                  Undefined()
                )
              )
            ),
            Comment(
              "The doing: the first word said that is, in its base form, a Concept with a realization of plain values."
            ),
            Var($doing, Undefined()),
            Var($noun, Undefined()),
            Var($said, Undefined()),
            Comment("Only what was said: not what a \"that\" points back to."),
            Bind($find,
              Lambda(List($e),
                Sequence(
                  If(
                    Or(Not(Call($isCall, $e)), Equals(Member($e, "head"), "Ref")),
                    Return(),
                    Undefined()
                  ),
                  If(
                    Not($target),
                    Assign(
                      $target,
                      Call(
                        Member($languages, "find"),
                        Lambda(List($l),
                          Equals(Call(Member($l, "toLowerCase")), Call(Member(Member($e, "head"), "toLowerCase")))
                        )
                      )
                    ),
                    Undefined()
                  ),
                  If(
                    Not($doing),
                    Sequence(
                      Bind($base, Call(Member($api, "lemma"), Call(Member(Member($e, "head"), "toLowerCase")))),
                      Bind($name, Add(Call(Member(Index($base, 0), "toUpperCase")), Call(Member($base, "slice"), 1))),
                      Comment(
                        "A word said in a verb's form (\"inverts\" is \"invert\"), in case nothing Napkin has does it."
                      ),
                      If(
                        And(And(Not($said), NotEquals($name, Member($e, "head"))), Length(Member($e, "args"))),
                        Sequence(
                          Bind($object,
                            Call(
                              Member(Member($e, "args"), "find"),
                              Lambda(List($a),
                                And(
                                  And(Equals(Member($a, "name"), Undefined()), Call($isCall, Member($a, "value"))),
                                  NotEquals(Member(Member($a, "value"), "head"), "Ref")
                                )
                              )
                            )
                          ),
                          Assign(
                            $said,
                            Object(
                              name = $name,
                              base = $base,
                              noun = If($object, Member($object, "value"), Undefined())
                            )
                          )
                        ),
                        Undefined()
                      ),
                      Bind($unit,
                        If(
                          Or(NotEquals($name, Member($e, "head")), Length(Member($e, "args"))),
                          Call(Member(Member($api, "store"), "get"), $name),
                          Undefined()
                        )
                      ),
                      Comment(
                        "Of its realizations of plain values, the one taking fewest (\"sort a list\" is Sort($xs))."
                      ),
                      Bind($r,
                        Index(
                          Call(
                            Member(
                              Filter(
                                OptionalMember($unit, "realizations"),
                                Lambda(List($r),
                                  And(
                                    And(
                                      And(
                                        And(
                                          And(Not(Member($r, "retired")), Call($isCall, Member($r, "pattern"))),
                                          Equals(Member(Member($r, "pattern"), "head"), $name)
                                        ),
                                        GreaterThan(Length(Member(Member($r, "pattern"), "args")), 0)
                                      ),
                                      Call(
