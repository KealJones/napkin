// Follows: what is told answered by what follows from it and how it feels, read off the graph
// (src/research/conceptnet.ts, src/research/feeling.ts). Written by scripts/pack.mjs from
// sources/follows (edit those, not this).
Requires(Core(), Basic())

// How a word feels, from -4 (worst) to 4 (best): learned from the VADER lexicon the first time
// a message says the word, kept on the written word (`Word_broken Valence(-2.1)`).
Concept(Valence(), IsA(Relation()))

// What an event leads to, as ConceptNet says it: what it causes, makes one want, has happen in
// it, takes first, is done for. Looked up when a message tells of the event.
Concept(CausesDesire(), IsA(Relation()))

Concept(HasSubevent(), IsA(Relation()))

Concept(HasFirstSubevent(), IsA(Relation()))

Concept(HasLastSubevent(), IsA(Relation()))

Concept(HasPrerequisite(), IsA(Relation()))

Concept(MotivatedByGoal(), IsA(Relation()))

Concept(Entails(), IsA(Relation()))

// What follows from what was told, and how it felt: a reply's matter.
Concept(Follows(), IsA(Result()))

// Where the lexicon and the common sense come from, and under what license.
Concept(Vader(), IsA(LearningSource()), License("MIT"))

Concept(ConceptNet(),
  IsA(LearningSource()),
  License("CC BY-SA 4.0")
)

// Talk that keeps company rather than asks: a greeting, and how one is doing. When something bad
// was told before, small talk asks after it (`CheckIn`), once.
Concept(SmallTalk(), IsA(Category()))

Concept(Greeting(), IsA(SmallTalk()))

Concept(DoingWell(), IsA(SmallTalk()))

// Something going on in the life of the one talking, as they told it ("your mom is sick"), kept
// on Me with how bad it felt; and that it was asked after.
Concept(Concern(), IsA(Relation()))

Concept(CheckedIn(), IsA(Relation()))

Concept(CheckIn(), IsA(Result()))

// What a reply offered ("Do you want to talk about it?"): kept on Self with the words it was said in,
// so a yes or no next answers it (`OfferAnswered`).
Concept(Offered(), IsA(Relation()))

Concept(OfferAnswered(), IsA(Result()))

Concept(TalkingItOver(), IsA(Data()))

// Why: a question word that asks for a reason, answered from causes (src/research/why.ts).
Concept(Reason(), IsA(Category()))

Concept(Why(), Asks(Reason()))

// The words that say why, in what is written. One that a whole clause follows ("because the
// air scatters blue light") Introduces(Clause()); the others name the cause as a thing ("due to
// Rayleigh scattering").
Concept(CausalConnective(), IsA(Category()))

Concept(Clause(), IsA(Category()))

Concept(Because(),
  IsA(CausalConnective()),
  Introduces(Clause())
)

Concept(BecauseOf(), IsA(CausalConnective()))

Concept(DueTo(), IsA(CausalConnective()))

Concept(CausedBy(), IsA(CausalConnective()))

Concept(OwingTo(), IsA(CausalConnective()))

Concept(ResultsFrom(), IsA(CausalConnective()))

Concept(HasCause(), IsA(Relation()))

Concept(Introduces(), IsA(Relation()))

// Why something is so, put together: the cause, what the cause is, and where each was read.
Concept(Explanation(), IsA(Result()))

// What follows from what was told, read off the graph: how its words feel (each word's Valence,
// turned by a word the tagger calls negative just before it, and summed the way VADER sums), and
// what the event it tells of leads to (the event the turn found, `follows`). Follows() when
// neither says anything.
Concept(Follows(),
  Realization(Follows($said),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($said,
              If(
                Index($args, 0),
                Member(Index($args, 0), "value"),
                Undefined()
              )
            ),
            If(
              Or(NotEquals(TypeOf($said), "string"), Not(Call(Member($said, "trim")))),
              Return(Call(Member($api, "call"), "Follows")),
              Undefined()
            ),
            Bind($code,
              Lambda(List($w),
                Add(
                  "Word_",
                  Call(
                    Member(
                      Map(
                        Concat(Call(Member($w, "toLowerCase"))),
                        Lambda(List($ch),
                          If(
                            Call(Member(Regex("[a-z]", ""), "test"), $ch),
                            $ch,
                            Add("x", Call(Member(Call(Member($ch, "codePointAt"), 0), "toString"), 16))
                          )
                        )
                      ),
                      "join"
                    ),
                    ""
                  )
                )
              )
            ),
            Bind($valence,
              Lambda(List($w),
                Sequence(
                  ForOf(
                    $t,
                    Call(Member(Member($api, "store"), "asSubject"), Call($code, $w)),
                    If(
                      And(
                        And(Equals(Member($t, "predicate"), "Valence"), Index(Member(Member($t, "expr"), "args"), 0)),
                        Equals(TypeOf(Member(Index(Member(Member($t, "expr"), "args"), 0), "value")), "number")
                      ),
                      Return(Member(Index(Member(Member($t, "expr"), "args"), 0), "value")),
                      Undefined()
                    )
                  ),
                  Return(Undefined())
                )
              )
            ),
            Bind($ws, Call(Member($api, "words"), $said)),
            Var($sum, 0),
            Var($felt, false),
            Comment("The words said in parts (sentences, and what \"and\" joins), each with how strongly it felt."),
            Bind($parts, List()),
            Var($part, Object(words = List(), strength = 0)),
            ForOf(
              List($i, $w),
              Call(Member($ws, "entries")),
              Sequence(
                If(
                  And(
                    Length(Member($part, "words")),
                    Or(
                      Includes(Member($w, "tags"), "Conjunction"),
                      And($i, NotEquals(Member($w, "sentence"), Member(Index($ws, Subtract($i, 1)), "sentence")))
                    )
                  ),
                  Sequence(Call(Member($parts, "push"), $part), Assign($part, Object(words = List(), strength = 0))),
                  Undefined()
                ),
                If(
                  Not(Includes(Member($w, "tags"), "Conjunction")),
                  Call(Member(Member($part, "words"), "push"), $w),
                  Undefined()
                ),
                Var($v, Call($valence, Member($w, "text"))),
                If(
                  And(Equals($v, Undefined()), Member($w, "typed")),
                  Assign($v, Call($valence, Member($w, "typed"))),
                  Undefined()
                ),
                If(Equals($v, Undefined()), Continue(), Undefined()),
                Assign($felt, true),
                Bind($turned,
                  Call(
                    Member(
                      Call(
                        Member($ws, "slice"),
                        Call(Member($Math, "max"), 0, Subtract($i, 3)),
                        $i
                      ),
                      "some"
                    ),
                    Lambda(List($x), Includes(Member($x, "tags"), "Negative"))
                  )
                ),
                Bind($value, If($turned, Multiply($v, Negate(0.74)), $v)),
                Assign($sum, Add($sum, $value)),
                Assign(
                  Member($part, "strength"),
                  Call(
                    Member($Math, "max"),
                    Member($part, "strength"),
                    Call(Member($Math, "abs"), $value)
                  )
                )
              )
            ),
            If(
              Length(Member($part, "words")),
              Call(Member($parts, "push"), $part),
              Undefined()
            ),
            Comment("What the event leads to counts for how it feels, at half weight: losing a job causes"),
            Comment("depression, so losing a job is bad even said plainly."),
            Bind($event, Call(Member($api, "ambient"), "follows")),
            Bind($led,
              If(
                And($event, Call(Member(Member($api, "store"), "get"), $event)),
                Member(Call(Member(Member($api, "store"), "get"), $event), "relations"),
                List()
              )
            ),
            ForOf(
              $r,
              $led,
              Sequence(
                Bind($claim, Member($r, "claim")),
                If(
                  Or(
                    Or(NotEquals(Member($r, "context"), Undefined()), Not($claim)),
                    And(
                      And(NotEquals(Member($claim, "head"), "Causes"), NotEquals(Member($claim, "head"), "Entails")),
                      NotEquals(Member($claim, "head"), "CausesDesire")
                    )
                  ),
                  Continue(),
                  Undefined()
                ),
                Bind($target,
                  If(
                    Index(Member($claim, "args"), 0),
                    Member(Index(Member($claim, "args"), 0), "value"),
                    Undefined()
                  )
                ),
                If(
                  Or(Not($target), Not(Member($target, "head"))),
                  Continue(),
                  Undefined()
                ),
                ForOf(
                  $w,
                  Call(
                    Member(
                      Call(
                        Member(Member($target, "head"), "replace"),
                        Regex("([a-z0-9])([A-Z])", "g"),
                        "$1 $2"
                      ),
                      "split"
                    ),
                    " "
                  ),
                  Sequence(
                    Bind($v, Call($valence, $w)),
                    If(Equals($v, Undefined()), Continue(), Undefined()),
                    Assign($felt, true),
                    Assign($sum, Add($sum, Multiply($v, 0.5)))
                  )
                )
              )
            ),
            Comment(
              "What was told, said back to the one who told it: a word for the one speaking (\"my\", \"I\") becomes"
            ),
            Comment("the word of the same kind for the one spoken to (\"your\", \"you\"), by what each Refers to."),
            Bind($kinds,
              Lambda(List($id),
                Sequence(
                  Bind($u, Call(Member(Member($api, "store"), "get"), $id)),
                  Return(
                    If(
                      $u,
                      Map(
                        Filter(
                          Member($u, "relations"),
                          Lambda(List($r),
                            And(
                              And(
                                And(
                                  And(Member($r, "claim"), Equals(Member(Member($r, "claim"), "head"), "IsA")),
                                  Index(Member(Member($r, "claim"), "args"), 0)
                                ),
                                Member(Index(Member(Member($r, "claim"), "args"), 0), "value")
                              ),
                              Member(Member(Index(Member(Member($r, "claim"), "args"), 0), "value"), "head")
                            )
                          )
                        ),
                        Lambda(List($r), Member(Member(Index(Member(Member($r, "claim"), "args"), 0), "value"), "head"))
                      ),
                      List()
                    )
                  )
                )
              )
            ),
            Bind($refersTo,
              Lambda(List($id),
                Sequence(
                  ForOf(
                    $t,
                    Call(Member(Member($api, "store"), "asSubject"), $id),
                    If(
                      And(
                        And(
                          And(Equals(Member($t, "predicate"), "Refers"), Index(Member(Member($t, "expr"), "args"), 0)),
                          Member(Index(Member(Member($t, "expr"), "args"), 0), "value")
                        ),
                        Member(Member(Index(Member(Member($t, "expr"), "args"), 0), "value"), "head")
                      ),
                      Return(Member(Member(Index(Member(Member($t, "expr"), "args"), 0), "value"), "head")),
                      Undefined()
                    )
                  ),
                  ForOf(
                    $t,
                    Call(Member(Member($api, "store"), "asSubject"), $id),
                    If(
                      And(
                        And(
                          And(
                            And(
                              Equals(Member($t, "predicate"), "HeardAs"),
                              Index(Member(Member($t, "expr"), "args"), 0)
                            ),
                            Member(Index(Member(Member($t, "expr"), "args"), 0), "value")
                          ),
                          Member(Member(Index(Member(Member($t, "expr"), "args"), 0), "value"), "head")
                        ),
                        NotEquals(Member(Member(Index(Member(Member($t, "expr"), "args"), 0), "value"), "head"), $id)
                      ),
                      Return(
                        Call($refersTo, Member(Member(Index(Member(Member($t, "expr"), "args"), 0), "value"), "head"))
                      ),
                      Undefined()
                    )
                  ),
                  Return(Undefined())
                )
              )
            ),
            Bind($listener,
              Map(
                Filter(
                  Call(Member(Member($api, "store"), "asObject"), "Self"),
                  Lambda(List($t), Equals(Member($t, "predicate"), "Refers"))
                ),
                Lambda(List($t), Member($t, "subject"))
              )
            ),
            Bind($suffix,
              Lambda(List($a, $b),
                Sequence(
                  Var($n, 0),
                  While(
                    And(
                      And(LessThan($n, Length($a)), LessThan($n, Length($b))),
                      Equals(
                        Index($a, Subtract(Subtract(Length($a), 1), $n)),
                        Index($b, Subtract(Subtract(Length($b), 1), $n))
                      )
                    ),
                    Assign($n, Add($n, 1))
                  ),
                  Return($n)
                )
              )
            ),
            Comment(
              "A pointing word said back as what it pointed at (\"she\" after \"my mom is sick\" is \"your mom\"):"
            ),
            Comment("someone's relative is theirs."),
            Bind($pointedPair, Call(Member(Or(Call(Member($api, "ambient"), "pointed"), ""), "split"), "=")),
            Bind($pointedWords,
              Lambda(List($word),
                Sequence(
                  Bind($id,
                    Add(
                      Call(Member(Call(Member($word, "charAt"), 0), "toUpperCase")),
                      Call(Member(Call(Member($word, "slice"), 1), "toLowerCase"))
                    )
                  ),
                  If(
                    Or(NotEquals(Length($pointedPair), 2), NotEquals(Index($pointedPair, 0), $id)),
                    Return(Undefined()),
                    Undefined()
                  ),
                  Bind($thing, Index($pointedPair, 1)),
                  Bind($words,
                    Call(
                      Member(
                        Call(
                          Member($thing, "replace"),
                          Regex("([a-z0-9])([A-Z])", "g"),
                          "$1 $2"
                        ),
                        "toLowerCase"
                      )
                    )
                  ),
                  Bind($kinds, Call(Member($api, "typesOf"), Call(Member($api, "call"), $thing))),
                  Return(
                    If(
                      Includes($kinds, "Relative"),
                      Add("your ", $words),
                      If(
                        Includes($kinds, "Human"),
                        Call(
                          Member($thing, "replace"),
                          Regex("([a-z0-9])([A-Z])", "g"),
                          "$1 $2"
                        ),
                        Add("the ", $words)
                      )
                    )
                  )
                )
              )
            ),
            Bind($swapped,
              Lambda(List($word),
                Sequence(
                  Bind($pointedAs, Call($pointedWords, $word)),
                  If($pointedAs, Return($pointedAs), Undefined()),
                  Bind($id,
                    Add(
                      Call(Member(Call(Member($word, "charAt"), 0), "toUpperCase")),
                      Call(Member(Call(Member($word, "slice"), 1), "toLowerCase"))
                    )
                  ),
                  If(
                    NotEquals(Call($refersTo, $id), "Me"),
                    Return(Undefined()),
                    Undefined()
                  ),
                  Bind($mine,
                    Call(
                      Member(Call($kinds, $id), "concat"),
                      Spread(
                        Map(
                          Filter(
                            Call(Member(Member($api, "store"), "asSubject"), $id),
                            Lambda(List($t), Equals(Member($t, "predicate"), "HeardAs"))
                          ),
                          Lambda(List($t),
                            Call($kinds, Member(Member(Index(Member(Member($t, "expr"), "args"), 0), "value"), "head"))
                          )
                        )
                      )
                    )
                  ),
                  Bind($best,
                    Index(
                      Call(
                        Member(
                          Map(
                            $listener,
                            Lambda(List($c),
                              Object(
                                c = $c,
                                score = Add(
                                  Multiply(Length(Filter(Call($kinds, $c), Lambda(List($k), Includes($mine, $k)))), 10),
                                  Call(
                                    $suffix,
                                    Call(Member($c, "toLowerCase")),
                                    Call(Member($word, "toLowerCase"))
                                  )
                                )
                              )
                            )
                          ),
                          "sort"
                        ),
                        Lambda(List($a, $b), Subtract(Member($b, "score"), Member($a, "score")))
                      ),
                      0
                    )
                  ),
                  Return(
                    If(
                      And($best, AtLeast(Member($best, "score"), 10)),
                      Call(Member(Member($best, "c"), "toLowerCase")),
                      Undefined()
                    )
                  )
                )
              )
            ),
            Bind($strongest,
              Index(
                Call(
                  Member(
                    Filter(
                      $parts,
                      Lambda(List($x),
                        Call(
                          Member(Member($x, "words"), "some"),
                          Lambda(List($w), Not(Includes(Member($w, "tags"), "Emoticon")))
                        )
                      )
                    ),
                    "sort"
                  ),
                  Lambda(List($a, $b), Subtract(Member($b, "strength"), Member($a, "strength")))
                ),
                0
              )
            ),
            Var($told, ""),
            Comment("Said of the one spoken to (\"i love you\", \"you're useless\"): about Napkin, answered as such."),
            Bind($aboutListener,
              If(
                $strongest,
                Call(
                  Member(Member($strongest, "words"), "some"),
                  Lambda(List($w),
                    Equals(
                      Call(
                        $refersTo,
                        Add(
                          Call(Member(Call(Member(Member($w, "text"), "charAt"), 0), "toUpperCase")),
                          Call(Member(Call(Member(Member($w, "text"), "slice"), 1), "toLowerCase"))
                        )
                      ),
                      "Self"
                    )
                  )
                ),
                false
              )
            ),
            If(
              $strongest,
              Sequence(
                Bind($out, List()),
                Var($subject, false),
                ForOf(
                  $w,
                  Member($strongest, "words"),
                  Sequence(
                    If(
                      Includes(Member($w, "tags"), "Emoticon"),
                      Continue(),
                      Undefined()
                    ),
                    Bind($word, Member($w, "text")),
                    Bind($other, Call($swapped, $word)),
                    Comment("What agrees with the one now spoken of: \"I am\" is \"you are\", \"I was\" \"you were\"."),
                    If(
                      And($subject, Includes(Member($w, "tags"), "Copula")),
                      Call(
                        Member($out, "push"),
                        If(
                          Equals($word, "am"),
                          "are",
                          If(Equals($word, "was"), "were", $word)
                        )
                      ),
                      Call(
                        Member($out, "push"),
                        Otherwise(
                          $other,
                          If(
                            Includes(Member($w, "tags"), "ProperNoun"),
                            $word,
                            Call(Member($word, "toLowerCase"))
                          )
                        )
                      )
                    ),
                    Assign($subject, Equals($other, "you"))
                  )
                ),
                Assign(
                  $told,
                  Call(
                    Member(
                      Call(
                        Member(
                          Call(
                            Member(Call(Member($out, "join"), " "), "replace"),
                            Regex("\\s+([,.!?;:])", "g"),
                            "$1"
                          ),
                          "replace"
                        ),
                        Regex("[.!?]+$", ""),
                        ""
                      ),
                      "trim"
                    )
                  )
                )
              ),
              Undefined()
            ),
            Bind($out, List()),
            If(
              $felt,
              Call(
                Member($out, "push"),
                Object(
                  name = "valence",
                  value = Divide(
                    Call(
                      Member($Math, "round"),
                      Multiply(Divide($sum, Call(Member($Math, "sqrt"), Add(Multiply($sum, $sum), 15))), 100)
                    ),
                    100
                  )
                )
              ),
              Undefined()
            ),
            If(
              And($felt, $told),
              Call(Member($out, "push"), Object(name = "told", value = $told)),
              Undefined()
            ),
            If(
              And($felt, $aboutListener),
              Call(Member($out, "push"), Object(name = "about", value = Call(Member($api, "call"), "Self"))),
              Undefined()
            ),
            If(
              $event,
              Sequence(
                Bind($by, Object()),
                Bind($unit, Call(Member(Member($api, "store"), "get"), $event)),
                ForOf(
                  $r,
                  If($unit, Member($unit, "relations"), List()),
                  Sequence(
                    Bind($claim, Member($r, "claim")),
                    If(
                      Or(
                        Or(Or(NotEquals(Member($r, "context"), Undefined()), Not($claim)), Not(Member($claim, "head"))),
                        Not(Length(Member($claim, "args")))
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Bind($target, Member(Index(Member($claim, "args"), 0), "value")),
                    If(
                      Or(Or(Not($target), NotEquals(TypeOf($target), "object")), Not(Member($target, "head"))),
                      Continue(),
                      Undefined()
                    ),
                    Call(
                      Member(
                        Assign(Index($by, Member($claim, "head")), Or(Index($by, Member($claim, "head")), List())),
                        "push"
                      ),
                      Call(Member($api, "call"), Member($target, "head"))
                    )
                  )
                ),
                Bind($names,
                  Object(
                    Causes = "causes",
                    CausesDesire = "wants",
                    HasSubevent = "involves",
                    HasFirstSubevent = "involves",
                    HasLastSubevent = "involves",
                    HasPrerequisite = "needs",
                    MotivatedByGoal = "for",
                    Entails = "causes"
                  )
                ),
                Bind($lists, Object()),
                ForOf(
                  List($head, $items),
                  Call(Member($Object, "entries"), $by),
                  Sequence(
                    Bind($name, Index($names, $head)),
                    If(Not($name), Continue(), Undefined()),
                    Call(Member(Assign(Index($lists, $name), Or(Index($lists, $name), List())), "push"), Spread($items))
                  )
                ),
                If(
                  Length(Call(Member($Object, "keys"), $lists)),
                  Sequence(
                    Call(Member($out, "unshift"), Object(value = Call(Member($api, "call"), $event))),
                    ForOf(
                      List($name, $items),
                      Call(Member($Object, "entries"), $lists),
                      Call(
                        Member($out, "push"),
                        Object(name = $name, value = Call(Member($api, "call"), "List", Spread($items)))
                      )
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Return(
              If(
                Length($out),
                Object(head = "Follows", args = $out),
                Call(Member($api, "call"), "Follows")
              )
            )
          )
        )
      )
    )
  )
)

// Asking after something told before: about someone or something of theirs ("your mom is sick"),
// how it is ("How is your mom doing?"); about themselves ("you lost your job"), how things have
// been since. What it is about is read by the tagger: the words before the doing.
Concept(CheckIn(),
  Realization(CheckIn($told),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($told,
              If(
                Index($args, 0),
                Member(Index($args, 0), "value"),
                Undefined()
              )
            ),
            If(
              Or(NotEquals(TypeOf($told), "string"), Not($told)),
              Return(""),
              Undefined()
            ),
            Bind($ws, Call(Member($api, "words"), $told)),
            Bind($first, Index($ws, 0)),
            If(Not($first), Return(""), Undefined()),
            If(
              Includes(Member($first, "tags"), "Possessive"),
              Sequence(
                Bind($whose, List(Call(Member(Member($first, "text"), "toLowerCase")))),
                ForOf(
                  $w,
                  Call(Member($ws, "slice"), 1),
                  Sequence(
                    If(
                      Includes(Member($w, "tags"), "Verb"),
                      Break(),
                      Undefined()
                    ),
                    Call(Member($whose, "push"), Call(Member(Member($w, "text"), "toLowerCase")))
                  )
                ),
                Return(
                  If(
                    GreaterThan(Length($whose), 1),
                    Add(Add("By the way, how is ", Call(Member($whose, "join"), " ")), " doing?"),
                    ""
                  )
                )
              ),
              Undefined()
            ),
            Comment("How they felt (\"you were so sad\": \"you\", a \"be\", what they were): asked how they feel now."),
            If(
              And(Index($ws, 1), Includes(Member(Index($ws, 1), "tags"), "Copula")),
              Return("By the way, how are you feeling now?"),
              Undefined()
            ),
            Return(Add(Add("By the way, how have things been since ", $told), "?"))
          )
        )
      )
    )
  )
)

// Why, said as a chain: the cause ("Because of Rayleigh scattering."), then what the cause is,
// then where each link was read. A connective that a clause follows says the clause as it is.
Concept(Explanation(),
  Realization(Explanation(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($named,
              Lambda(List($n),
                Sequence(
                  Bind($a, Call(Member($args, "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($cause, Call($named, "cause")),
            If(
              Or(NotEquals(TypeOf($cause), "string"), Not($cause)),
              Return(""),
              Undefined()
            ),
            Bind($connective, Call($named, "connective")),
            Bind($clause,
              And(
                And($connective, Member($connective, "head")),
                Call(
                  Member(Call(Member(Member($api, "store"), "asSubject"), Member($connective, "head")), "some"),
                  Lambda(List($t),
                    And(
                      And(
                        And(Equals(Member($t, "predicate"), "Introduces"), Index(Member(Member($t, "expr"), "args"), 0)),
                        Member(Index(Member(Member($t, "expr"), "args"), 0), "value")
                      ),
                      Equals(Member(Member(Index(Member(Member($t, "expr"), "args"), 0), "value"), "head"), "Clause")
                    )
                  )
                )
              )
            ),
            Bind($parts,
              List(
                Add(
                  Add(
                    If($clause, "Because ", "Because of "),
                    Call(Member($cause, "replace"), Regex("[.\\s]+$", ""), "")
                  ),
                  "."
                )
              )
            ),
            Bind($is, Call($named, "is")),
            If(
              And(Equals(TypeOf($is), "string"), $is),
              Call(Member($parts, "push"), Call(Member($is, "trim"))),
              Undefined()
            ),
            Bind($from, Call($named, "from")),
            Bind($pages,
              If(
                And($from, Member($from, "args")),
                Map(Member($from, "args"), Lambda(List($a), Call($String, Member($a, "value")))),
                List()
              )
            ),
            If(
              Length($pages),
              Call(Member($parts, "push"), Add(Add("(From Wikipedia: ", Call(Member($pages, "join"), "; ")), ".)")),
              Undefined()
            ),
            Return(Call(Member($parts, "join"), " "))
          )
        )
      )
    )
  )
)

// What follows from what was told, said: how it felt ("Sorry to hear that."), what the event
// leads to ("Losing your job can cause depression."), and what it makes one want, asked ("Do you
// want to find a new job?"). A Concept is said in its name's words (FindANewJob is "find a new
// job"); a doing (the tagger says its first word is a verb) is what something makes you do.
Concept(Follows(),
  Realization(Follows(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($named,
              Lambda(List($n),
                Sequence(
                  Bind($a, Call(Member($args, "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($wordsOf,
              Lambda(List($e),
                If(
                  And($e, Member($e, "head")),
                  Call(
                    Member(
                      Call(
                        Member(
                          Call(
                            Member(Member($e, "head"), "replace"),
                            Regex("([a-z0-9])([A-Z])", "g"),
                            "$1 $2"
                          ),
                          "replace"
                        ),
                        Regex("([A-Z])([A-Z][a-z])", "g"),
                        "$1 $2"
                      ),
                      "toLowerCase"
                    )
                  ),
                  ""
                )
              )
            ),
            Bind($items,
              Lambda(List($list),
                If(
                  And($list, Member($list, "args")),
                  Filter(Map(Member($list, "args"), Lambda(List($a), Call($wordsOf, Member($a, "value")))), $Boolean),
                  List()
                )
              )
            ),
            Bind($either,
              Lambda(List($xs),
                If(
                  LessThan(Length($xs), 2),
                  Call(Member($xs, "join"), ""),
                  Add(
                    Add(Call(Member(Call(Member($xs, "slice"), 0, Negate(1)), "join"), ", "), " or "),
                    Index($xs, Subtract(Length($xs), 1))
                  )
                )
              )
            ),
            Bind($doing,
              Lambda(List($phrase),
                Sequence(
                  Bind($first, Index(Call(Member($api, "words"), $phrase), 0)),
                  Return(
                    If(
                      $first,
                      And(Includes(Member($first, "tags"), "Verb"), Not(Includes(Member($first, "tags"), "Gerund"))),
                      false
                    )
                  )
                )
              )
            ),
            Bind($up,
              Lambda(List($s),
                If(
                  $s,
                  Add(Call(Member(Index($s, 0), "toUpperCase")), Call(Member($s, "slice"), 1)),
                  $s
                )
              )
            ),
            Bind($parts, List()),
            Bind($v, Call($named, "valence")),
            Bind($told, Call($named, "told")),
            Comment("Said of Napkin itself: thanked for, or owned."),
            Bind($about, Call($named, "about")),
            If(
              And(And(Equals(TypeOf($v), "number"), $about), Equals(Member($about, "head"), "Self")),
              Sequence(
                If(
                  AtLeast($v, 0.1),
                  Return("Thank you, that's really kind of you!"),
                  Undefined()
                ),
                If(
                  AtMost($v, Negate(0.1)),
                  Return("I'm sorry. What did I get wrong?"),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Comment("Said differently from the last reply: of the ways to say it, the first the last reply did not"),
            Comment("already say (its words, less what was told). A conversation is not the same line over and over."),
            Bind($last, Call(Member(Or(Call(Member($api, "ambient"), "lastSpoken"), ""), "toLowerCase"))),
            Bind($said,
              Lambda(List($form),
                Call(
                  Member(Call(Member($form, "split"), "{t}"), "every"),
                  Lambda(List($piece),
                    Or(
                      Not(Call(Member($piece, "trim"))),
                      Not(Includes($last, Call(Member(Call(Member($piece, "trim")), "toLowerCase"))))
                    )
                  )
                )
              )
            ),
            Bind($pick, Lambda(List($forms), Or(Call(Member($forms, "find"), $said), Index($forms, 0)))),
            Bind($t, If(And(Equals(TypeOf($told), "string"), $told), $told, "")),
            Bind($fill, Lambda(List($form), Call(Member(Call(Member($form, "split"), "{t}"), "join"), $t))),
            Comment(
              "How it felt, said back with what was told when it is known (\"Sorry to hear your car broke down.\")."
            ),
            If(
              Equals(TypeOf($v), "number"),
              If(
                AtMost($v, Negate(0.5)),
                Call(
                  Member($parts, "push"),
                  Call(
                    $fill,
                    Call(
                      $pick,
                      If(
                        $t,
                        List(
                          "Sorry to hear {t}.",
                          "Oh no, {t}. I'm so sorry.",
                          "That's really hard, {t}."
                        ),
                        List("Sorry to hear that.", "That's really hard.")
                      )
                    )
                  )
                ),
                If(
                  LessThan($v, Negate(0.1)),
                  Call(
                    Member($parts, "push"),
                    Call(
                      $fill,
                      Call(
                        $pick,
                        If(
                          $t,
                          List(
                            "Oh no, {t}? That doesn't sound good.",
                            "Hmm, {t}. That sounds rough.",
                            "I'm sorry {t}."
                          ),
                          List("That doesn't sound good.", "That sounds rough.")
                        )
                      )
                    )
                  ),
                  If(
                    AtLeast($v, 0.3),
                    Call(
                      Member($parts, "push"),
                      Call(
                        $fill,
                        Call(
                          $pick,
                          If(
                            $t,
                            List(
                              "That's great that {t}!",
                              "Nice, {t}!",
                              "That's wonderful!"
                            ),
                            List("That's great!", "That's wonderful!")
                          )
                        )
                      )
                    ),
                    If(
                      GreaterThan($v, 0.1),
                      Call(Member($parts, "push"), Call($pick, List("Nice.", "Good to hear."))),
                      Undefined()
                    )
                  )
                )
              ),
              Undefined()
            ),
            Bind($first, Call(Member($args, "find"), Lambda(List($a), Equals(Member($a, "name"), Undefined())))),
            Bind($event, If($first, Call($wordsOf, Member($first, "value")), "")),
            Bind($causes,
              Call(
                Member(Call($items, Call($named, "causes")), "slice"),
                0,
                2
              )
            ),
            Bind($wants, Call($items, Call($named, "wants"))),
            If(
              And($event, Length($causes)),
              Sequence(
                Bind($made, Filter($causes, $doing)),
                Bind($brought, Filter($causes, Lambda(List($x), Not(Call($doing, $x))))),
                If(
                  Length($brought),
                  Call(
                    Member($parts, "push"),
                    Add(Add(Add(Call($up, $event), " can cause "), Call($either, $brought)), ".")
                  ),
                  Call(
                    Member($parts, "push"),
                    Add(Add(Add(Call($up, $event), " can make you "), Call($either, $made)), ".")
                  )
                )
              ),
              If(
                And($event, Not(Length($wants))),
                Sequence(
                  Bind($involves,
                    Call(
                      Member(Call($items, Call($named, "involves")), "slice"),
                      0,
                      2
                    )
                  ),
                  Bind($needs,
                    Call(
                      Member(Call($items, Call($named, "needs")), "slice"),
                      0,
                      2
                    )
                  ),
                  If(
                    Length($involves),
                    Call(
                      Member($parts, "push"),
                      Add(Add(Add(Call($up, $event), " usually means "), Call($either, $involves)), ".")
                    ),
                    If(
                      Length($needs),
                      Call(
                        Member($parts, "push"),
                        Add(Add(Add(Call($up, $event), " takes "), Call($either, $needs)), " first.")
                      ),
                      Undefined()
                    )
                  )
                ),
                Undefined()
              )
            ),
            If(
              Length($wants),
              Sequence(
                Bind($want, Or(Call(Member($wants, "find"), $doing), Index($wants, 0))),
                Call(
                  Member($parts, "push"),
                  If(
                    Call($doing, $want),
                    Add(Add("Do you want to ", $want), "?"),
                    Add(Add("Do you want ", $want), "?")
                  )
                )
              ),
              Undefined()
            ),
            Comment("Nothing more to say of it: the conversation is left open, the way a friend would, and not with"),
            Comment("the question just asked."),
            If(
              And(Equals(TypeOf($v), "number"), Not(Length($wants))),
              If(
                AtMost($v, Negate(0.2)),
                Call(
                  Member($parts, "push"),
                  Call(
                    $pick,
                    List(
                      "Do you want to talk about it?",
                      "How are you holding up?",
                      "Is there anything I can do?"
                    )
                  )
                ),
                If(
                  AtLeast($v, 0.3),
                  Call(Member($parts, "push"), Call($pick, List("Tell me more!", "How do you feel about it?"))),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Return(Call(Member($parts, "join"), " "))
          )
        )
      )
    )
  )
)

// A yes or no to what was offered: to talking, an open ear; to a doing ("find a new job"), the
// first step asked; a no, left open.
Concept(OfferAnswered(),
  Realization(OfferAnswered($what, $answer),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($what,
              If(
                Index($args, 0),
                Member(Index($args, 0), "value"),
                Undefined()
              )
            ),
            Bind($answer,
              If(
                Index($args, 1),
                Member(Index($args, 1), "value"),
                Undefined()
              )
            ),
            Bind($yes, And($answer, Equals(Member($answer, "head"), "Agreement"))),
            Bind($words,
              If(
                And($what, Member($what, "head")),
                Call(
                  Member(
                    Call(
                      Member(Member($what, "head"), "replace"),
                      Regex("([a-z0-9])([A-Z])", "g"),
                      "$1 $2"
                    ),
                    "toLowerCase"
                  )
                ),
                ""
              )
            ),
            If(
              Not($yes),
              Return("That's okay. I'm here if you change your mind."),
              Undefined()
            ),
            If(
              Or(Not($what), Equals(Member($what, "head"), "TalkingItOver")),
              Return("I'm listening. What's been going on?"),
              Undefined()
            ),
            Return(Add(Add("Okay. What would be the first step to ", $words), "?"))
          )
        )
      )
    )
  )
)
