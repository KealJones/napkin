// TypeScript: JavaScript with types. Every JavaScript program is a TypeScript program, so
// reading TypeScript uses every rule in javascript.ncon, and these read what only
// TypeScript has.
//
// A type is kept, on the declaration that says it, never on each use of the name:
// `const x: number = 1` is Bind($x, 1, type = Number()), and a function says its
// parameters' types by position and what it gives back,
// Func($f, List($a), body, types = List(Number()), returns = String()). Nothing runs
// differently for them: JavaScript writes none, and TypeScript writes them back.
// Declarations of types alone (interface, type) are erased.
Requires(Core(), JavaScript())

Concept(TypeScript(),
  IsA(TargetLanguage()),
  SupersetOf(JavaScript())
)

Language(TypeScript())

From(JsInterfaceDeclaration(), Erased())
From(JsTypeAliasDeclaration(), Erased())
From(JsModuleDeclaration(), Erased())
From(JsIndexSignature(), Erased())
From(JsPropertySignature(), Erased())
From(JsAsExpression(expression = $e), $e)
From(JsTypeAssertionExpression(expression = $e), $e)
From(JsNonNullExpression(expression = $e), $e)
From(JsSatisfiesExpression(expression = $e), $e)

// A type as Concepts: a pattern whose holes are types. `number[]` is ListOf(Number()), short
// for List(Rest(Number())), `[string, ...number[]]` List(String(), Rest(Number())),
// `number | string` OneOf(Number(), String()), and a generic type applied to types is its
// Concept applied to them, `Map<string, T>` Map(String(), $T). A type is read beside the type
// parameters its declaration declares: a name one of them declares is that variable. A type
// Concepts cannot say yet, or `any` and `unknown`, is Concept(): anything.
From(JsType($t), JsType($t, List()))
From(JsType(JsNumberKeyword(), $_), Number())
From(JsType(JsStringKeyword(), $_), String())
From(JsType(JsBooleanKeyword(), $_), Boolean())
From(JsType(JsArrayType(elementType = $e), $gs), ListOf(JsType($e, $gs)))
From(
  JsType(JsTypeReference(typeName = JsIdentifier(text = "Array"), typeArguments = List($e)), $gs),
  ListOf(JsType($e, $gs))
)
From(JsType(JsTypeReference(typeName = JsIdentifier(text = $n), typeArguments = Undefined()), $gs), JsTypeName($n, $gs))
From(
  JsType(JsTypeReference(typeName = JsIdentifier(text = $n), typeArguments = List(Rest($as))), $gs),
  ConceptNamed($n, Each(List(Rest($as)), Lambda(List($a), JsType($a, $gs))))
)
From(
  JsType(JsTupleType(elements = List(Rest($es))), $gs),
  List(Each(List(Rest($es)), Lambda(List($e), JsType($e, $gs))))
)
From(JsType(JsRestType(type = JsArrayType(elementType = $e)), $gs), Rest(JsType($e, $gs)))
From(JsType(JsUnionType(types = List(Rest($ts))), $gs), OneOf(Each(List(Rest($ts)), Lambda(List($t), JsType($t, $gs)))))
From(JsType(JsParenthesizedType(type = $t), $gs), JsType($t, $gs))
From(JsType($_, $_), Concept())
// A name among the declared type parameters is the variable; any other names a Concept.
From(JsTypeName($n, List(JsTypeParameter(name = JsIdentifier(text = $n)), Rest($_))), Variable($n))
From(JsTypeName($n, List($_, Rest($gs))), JsTypeName($n, List(Rest($gs))))
From(JsTypeName($n, $_), ConceptNamed($n))

// A declaration's type parameters, `generics = List($T)`, where it declares any: each a
// variable, or Extends($T, Foo()) where it says what the variable must be.
From(JsGenerics(Undefined()), Erased())
From(
  JsGenerics(List(Rest($gs))),
  Named("generics", List(Each(List(Rest($gs)), Lambda(List($g), JsGeneric($g, List(Rest($gs)))))))
)
From(JsGeneric(JsTypeParameter(name = JsIdentifier(text = $n), constraint = Undefined()), $_), Variable($n))
From(
  JsGeneric(JsTypeParameter(name = JsIdentifier(text = $n), constraint = $c), $gs),
  Extends(Variable($n), JsType($c, $gs))
)

// Anything is not said: a declaration without a type, or with one Concepts cannot say
// (`any`, `Promise<T>`), keeps no `type=`.
From(Named($_, Concept()), Erased())

// A function's parameters' types, by position, where any parameter says one Concepts can
// say: a parameter that says none is anything, Concept().
From(JsParameterTypes(List(Rest($ps)), $gs), JsParameterTypes(List(Rest($ps)), List(Rest($ps)), $gs))
From(JsParameterTypes(List(), $_, $_), Erased())
From(
  JsParameterTypes(
    List(JsParameter(type = JsNumberKeyword()), Rest($_)),
    $ps,
    $gs
  ),
  JsTypesSaid($ps, $gs)
)
From(
  JsParameterTypes(
    List(JsParameter(type = JsStringKeyword()), Rest($_)),
    $ps,
    $gs
  ),
  JsTypesSaid($ps, $gs)
)
From(
  JsParameterTypes(
    List(JsParameter(type = JsBooleanKeyword()), Rest($_)),
    $ps,
    $gs
  ),
  JsTypesSaid($ps, $gs)
)
From(
  JsParameterTypes(
    List(JsParameter(type = JsArrayType()), Rest($_)),
    $ps,
    $gs
  ),
  JsTypesSaid($ps, $gs)
)
From(
  JsParameterTypes(
    List(JsParameter(type = JsTupleType()), Rest($_)),
    $ps,
    $gs
  ),
  JsTypesSaid($ps, $gs)
)
From(
  JsParameterTypes(
    List(JsParameter(type = JsUnionType()), Rest($_)),
    $ps,
    $gs
  ),
  JsTypesSaid($ps, $gs)
)
From(
  JsParameterTypes(
    List(JsParameter(type = JsTypeReference(typeName = JsIdentifier())), Rest($_)),
    $ps,
    $gs
  ),
  JsTypesSaid($ps, $gs)
)
From(JsParameterTypes(List($_, Rest($r)), $ps, $gs), JsParameterTypes(List(Rest($r)), $ps, $gs))
From(
  JsTypesSaid(List(Rest($ps)), $gs),
  Named("types", List(Each(List(Rest($ps)), Lambda(List($p), JsParameterType($p, $gs)))))
)
From(JsParameterType(JsParameter(type = $t), $gs), JsType($t, $gs))

// The declarations JavaScript reads, with their types.
From(
  JsDeclare(
    JsConstKeyword(),
    JsVariableDeclaration(
      name = $n,
      initializer = $v,
      type = $t
    )
  ),
  Bind($n, $v, Named("type", JsType($t)))
)
From(
  JsDeclare(
    $_,
    JsVariableDeclaration(
      name = $n,
      initializer = $v,
      type = $t
    )
  ),
  Var($n, $v, Named("type", JsType($t)))
)
From(
  JsFunctionDeclaration(
    name = $n,
    parameters = List(Rest($ps)),
    body = $b,
    asteriskToken = $star,
    modifiers = $m,
    type = $r,
    typeParameters = $gs
  ),
  JsMods(
    $m,
    JsStar(
      $star,
      Func(
        $n,
        List(Rest($ps)),
        JsBody($b),
        JsParameterTypes(List(Rest($ps)), $gs),
        Named("returns", JsType($r, $gs)),
        JsGenerics($gs)
      )
    )
  )
)
From(
  JsFunctionExpression(
    parameters = List(Rest($ps)),
    body = $b,
    asteriskToken = $star,
    modifiers = $m,
    type = $r,
    typeParameters = $gs
  ),
  JsMods(
    $m,
    JsStar(
      $star,
      Lambda(List(Rest($ps)),
        JsBody($b),
        JsParameterTypes(List(Rest($ps)), $gs),
        Named("returns", JsType($r, $gs)),
        JsGenerics($gs)
      )
    )
  )
)
From(
  JsFunctionExpression(
    name = JsIdentifier(text = $n),
    parameters = List(Rest($ps)),
    body = $b,
    asteriskToken = $star,
    modifiers = $m,
    type = $r,
    typeParameters = $gs
  ),
  JsMods(
    $m,
    JsStar(
      $star,
      Func(
        Variable($n),
        List(Rest($ps)),
        JsBody($b),
        JsParameterTypes(List(Rest($ps)), $gs),
        Named("returns", JsType($r, $gs)),
        JsGenerics($gs)
      )
    )
  )
)
From(
  JsArrowFunction(
    parameters = List(Rest($ps)),
    body = $b,
    modifiers = $m,
    type = $r,
    typeParameters = $gs
  ),
  JsMods(
    $m,
    Lambda(List(Rest($ps)),
      JsBody($b),
      JsParameterTypes(List(Rest($ps)), $gs),
      Named("returns", JsType($r, $gs)),
      JsGenerics($gs)
    )
  )
)

// Writing a type. ListOf, or a List whose one part is Rest, is an array, and any other List
// a tuple.
To(TsType(Number()), "number")
To(TsType(String()), "string")
To(TsType(Boolean()), "boolean")
To(TsType(Concept()), "unknown")
To(TsType(List(Capture($r, Rest($k)))), TsType(ListOf($k)))
To(TsType(ListOf(Capture($k, OneOf(Rest($_))))), TsArray(TsGroup(TsType($k))))
To(TsType(ListOf($k)), TsArray(TsType($k)))
To(TsType(List(Rest($ks))), TsTuple(Each(List(Rest($ks)), Lambda(List($k), TsType($k)))))
To(TsType(Capture($r, Rest($k))), TsSpread(TsType(ListOf($k))))
To(TsType(OneOf($k)), TsType($k))
To(TsType(OneOf($a, $b, Rest($r))), TsOr(TsType($a), TsType(OneOf($b, Rest($r)))))
// Any other Concept is the type of its name, applied to the types it is applied to, and a
// type parameter is its name.
To(TsType($k), TsApplied(NameOf($k), Each(ArgumentsOf($k), Lambda(List($a), TsType($a)))))
To(TsApplied($n), "#n")
To(TsApplied($n, Rest($ts)), "#n<$ts>")
To(TsArray($t), "$t[]")
To(TsGroup($t), "($t)")
To(TsTuple(Rest($ts)), "[$ts]")
To(TsSpread($t), "...$t")
To(TsOr($a, $b), "$a | $b")
// A type after a name, `: number`; nothing where it is anything.
To(TsAnnotation(Concept()), "")
To(TsAnnotation($k), TsColon(TsType($k)))
To(TsColon($t), ": $t")

// A declaration writes its type after its name.
To(
  Bind($n, $v, type = $k),
  Statement(),
  TsDeclare("const", $n, TsAnnotation($k), $v)
)
To(
  Var($n, $v, type = $k),
  Statement(),
  TsDeclare("let", $n, TsAnnotation($k), $v)
)
To(
  TsDeclare($keyword, $n, $k, $v),
  Statement(),
  "#keyword $n$k = $v"
)
// A function writes each parameter with the type at its position, and what it gives back,
// however it is wrapped. One that says no types is written as JavaScript writes it.
To(Func($n, List(Rest($ps)), $b, Rest($t)), TsFunction("function", $n, List(Rest($ps)), $b, Rest($t)))
To(
  Async(Func($n, List(Rest($ps)), $b, Rest($t))),
  Statement(),
  TsFunction(
    "async function",
    $n,
    List(Rest($ps)),
    $b,
    Rest($t)
  )
)
To(
  Generator(Func($n, List(Rest($ps)), $b, Rest($t))),
  Statement(),
  TsFunction("function*", $n, List(Rest($ps)), $b, Rest($t))
)
To(
  Async(Generator(Func($n, List(Rest($ps)), $b, Rest($t)))),
  Statement(),
  TsFunction(
    "async function*",
    $n,
    List(Rest($ps)),
    $b,
    Rest($t)
  )
)
To(Lambda(List(Rest($ps)), $b, Rest($t)), TsLambda("", List(Rest($ps)), $b, Rest($t)))
To(Async(Lambda(List(Rest($ps)), $b, Rest($t))), TsLambda("async ", List(Rest($ps)), $b, Rest($t)))
To(
  TsFunction($keyword, $n, List(Rest($ps)), $b, Rest($t)),
  TsWritten(
    $keyword,
    $n,
    TsSignature(List(Rest($ps)), TsNamed(Rest($t))),
    $b
  )
)
To(
  TsWritten($keyword, $n, $s, $b),
  Statement(),
  "#keyword $n$s { %b }"
)
To(TsWritten($keyword, $n, $s, $b), "(#keyword $n$s { %b })")
To(
  TsLambda($keyword, List(Rest($ps)), $b, Rest($t)),
  TsArrow(
    $keyword,
    TsSignature(List(Rest($ps)), TsNamed(Rest($t))),
    $b
  )
)
To(TsArrow($keyword, $s, Sequence(Rest($ss))), "#keyword$s => { %ss }")
To(TsArrow($keyword, $s, $b), Either("#keyword$s => ($b)", "#keyword$s => { %b }"))
// A signature: the type parameters, each parameter with its type, and what it gives back,
// each found among the declaration's named arguments. The rule that finds one comes before
// the rule for none.
To(
  TsSignature($ps, $named),
  TsSigned(
    TsGenericsOf($named),
    TsParametersOf($ps, $named),
    TsReturnsOf($named)
  )
)
To(TsSigned($g, $ps, $r), "$g($ps)$r")
To(
  TsGenericsOf(TsNamed(generics = List(Rest($gs)))),
  TsGenerics(Each(List(Rest($gs)), Lambda(List($g), TsGeneric($g))))
)
To(TsGenericsOf(TsNamed()), "")
To(TsParametersOf($ps, TsNamed(types = $ks)), TsParameters($ps, $ks))
To(TsParametersOf($ps, TsNamed()), TsParameters($ps, List()))
To(TsReturnsOf(TsNamed(returns = $r)), TsAnnotation($r))
To(TsReturnsOf(TsNamed()), "")
To(TsGenerics(Rest($gs)), "<$gs>")
To(TsGeneric(Extends($v, $k)), TsExtends($v, TsType($k)))
To(TsGeneric($v), "$v")
To(TsExtends($v, $t), "$v extends $t")
// Parameters and types, one by one: a parameter past the last type has none.
To(TsParameters(List(), $_), "")
To(TsParameters(List($p), List()), TsParameter($p, Concept()))
To(TsParameters(List($p), List($k, Rest($_))), TsParameter($p, $k))
To(
  TsParameters(List($p, $q, Rest($ps)), List()),
  TsComma(TsParameter($p, Concept()), TsParameters(List($q, Rest($ps)), List()))
)
To(
  TsParameters(List($p, $q, Rest($ps)), List($k, Rest($ks))),
  TsComma(TsParameter($p, $k), TsParameters(List($q, Rest($ps)), List(Rest($ks))))
)
To(TsComma($a, $b), "$a, $b")
To(TsParameter(Default($n, $v), $k), TsDefaulted($n, TsAnnotation($k), $v))
To(TsParameter($p, $k), TsAnnotated($p, TsAnnotation($k)))
To(TsDefaulted($n, $k, $v), "$n$k = $v")
To(TsAnnotated($p, $k), "$p$k")
