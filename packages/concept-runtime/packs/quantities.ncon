// Quantities: what a doing does to what it is done with, read when a message tells a situation and
// asks about it (src/situation/situation.ts). What is eaten, sold, spent, given or lost is taken away
// from what was had; what is bought, earned, found or received is added. Each is a fact on the
// doing's own Concept, so a doing known once counts in every situation.
Requires(Core(), Basic())

Concept(Removes(), IsA(Relation()))

Concept(Adds(), IsA(Relation()))

Concept(Eat(), Removes())

Concept(Drink(), Removes())

Concept(Use(), Removes())

Concept(Bake(), Removes())

Concept(Cook(), Removes())

Concept(Sell(), Removes())

Concept(Spend(), Removes())

Concept(Pay(), Removes())

Concept(Give(), Removes())

Concept(Donate(), Removes())

Concept(Lose(), Removes())

Concept(Break(), Removes())

Concept(Throw(), Removes())

Concept(Lend(), Removes())

Concept(Remove(), Removes())

Concept(Take(), Removes())

Concept(Buy(), Adds())

Concept(Earn(), Adds())

Concept(Receive(), Adds())

Concept(Get(), Adds())

Concept(Find(), Adds())

Concept(Collect(), Adds())

Concept(Win(), Adds())

Concept(Gain(), Adds())

Concept(Pick(), Adds())

Concept(Save(), Adds())

Concept(Borrow(), Adds())

Concept(Add(), Adds())

// How many of a smaller unit one of a larger holds: a year holds 12 months. Read when a situation
// counts in one and asks in the other ("4 car washes a month ... in a year").
Concept(Holds(), IsA(Relation()))

Concept(Year(),
  Holds(Month(), 12),
  Holds(Week(), 52),
  Holds(Day(), 365)
)

Concept(Month(), Holds(Week(), 4), Holds(Day(), 30))

Concept(Week(), Holds(Day(), 7))

Concept(Day(), Holds(Hour(), 24))

Concept(Hour(), Holds(Minute(), 60))

Concept(Minute(), Holds(Second(), 60))

Concept(Dozen(), Holds(Item(), 12))

Concept(Foot(), Holds(Inch(), 12))

Concept(Yard(), Holds(Foot(), 3))

Concept(Mile(), Holds(Foot(), 5280))

Concept(Pound(), Holds(Ounce(), 16))

Concept(Gallon(), Holds(Quart(), 4))

Concept(Quart(), Holds(Pint(), 2))

Concept(Pint(), Holds(Cup(), 2))

Concept(Kilogram(), Holds(Gram(), 1000))

Concept(Kilometer(), Holds(Meter(), 1000))

Concept(Meter(), Holds(Centimeter(), 100))

Concept(Dollar(), Holds(Cent(), 100))

// Words for the same unit, as they are written short: "60 ml" is 60 milliliters. Not "min": that
// is a word for the least of some (Min, in the everyday pack) as well.
Concept(Ml(), SynonymOf(Milliliter()))

Concept(Km(), SynonymOf(Kilometer()))

Concept(Kg(), SynonymOf(Kilogram()))

Concept(Lb(), SynonymOf(Pound()))

Concept(Lbs(), SynonymOf(Pound()))

Concept(Oz(), SynonymOf(Ounce()))

Concept(Ft(), SynonymOf(Foot()))

Concept(Hr(), SynonymOf(Hour()))

Concept(Hrs(), SynonymOf(Hour()))

Concept(Mins(), SynonymOf(Minute()))

Concept(Sec(), SynonymOf(Second()))

Concept(Cm(), SynonymOf(Centimeter()))

Concept(Mm(), SynonymOf(Millimeter()))

// Words for the same things counted: "4 kids" are 4 children.
Concept(Kid(), SynonymOf(Child()))

Concept(Buck(), SynonymOf(Dollar()))

// A situation read but not worked out: what was read, said honestly, instead of a guess.
Concept(Unworked(),
  Realization(Unworked(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($named,
              Lambda(List($n),
                Sequence(
                  Bind($a, Call(Member($args, "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($read, Call($named, "read")),
            Bind($amounts,
              If(
                And($read, Member($read, "args")),
                Map(Member($read, "args"), Lambda(List($a), Call($String, Member($a, "value")))),
                List()
              )
            ),
            If(Not(Length($amounts)), Return(""), Undefined()),
            Return(
              Add(
                Add("I read ", Call(Member($amounts, "join"), ", ")),
                ", but I couldn't work out how they come together to answer that yet."
              )
            )
          )
        )
      )
    )
  )
)

// A situation worked out, said with its working so it can be checked: what was worked out from
// what was said ("twice of 20 sheep = 40"), each step, then the answer. Not sure of the reading,
// it says so first.
Concept(Worked(),
  Realization(Worked(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($named,
              Lambda(List($n),
                Sequence(
                  Bind($a, Call(Member($args, "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($answer, Call($named, "answer")),
            If(
              Or(NotEquals(TypeOf($answer), "string"), Not($answer)),
              Return(""),
              Undefined()
            ),
            Bind($list,
              Lambda(List($n),
                Sequence(
                  Bind($v, Call($named, $n)),
                  Return(
                    If(
                      And($v, Member($v, "args")),
                      Map(Member($v, "args"), Lambda(List($a), Call($String, Member($a, "value")))),
                      List()
                    )
                  )
                )
              )
            ),
            Bind($working, Concat(Call($list, "read"), Call($list, "steps"))),
            Bind($said,
              If(
                Length($working),
                Add(Call(Member($working, "join"), "; "), ". "),
                ""
              )
            ),
            If(
              Equals(Call($named, "sure"), true),
              Return(Add(Add(Add($said, "So "), $answer), ".")),
              Undefined()
            ),
            Return(Add(Add(Add(Add("I'm not sure I read it right. ", $said), "My best reading gives "), $answer), "."))
          )
        )
      )
    )
  )
)
