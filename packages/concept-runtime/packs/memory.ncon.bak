    properties = List(Program()),
    body = Bind($x2,
      Quote($x),
      If(
        Identical(TypeOf($x2), "number"),
        $x2,
        Bind($taken,
          Evaluate($x2),
          If(
            Truthy(
              Bind($t0,
                $taken,
                If(Truthy($t0), Identical(Head($taken), "InGame"), $t0)
              )
            ),
            $taken,
            MakeCall("Take", List($taken))
          )
        )
      )
    )
  )
)

