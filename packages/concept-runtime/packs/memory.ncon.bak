          Bind($square,
            Lambda(List($i), Add(Index("ABC", Modulo($i, 3)), Add(Call(Member($Math, "floor"), Divide($i, 3)), 1)))
          ),
          Bind($LINES,
            List(
              List(0, 1, 2),
              List(3, 4, 5),
              List(6, 7, 8),
              List(0, 3, 6),
              List(1, 4, 7),
              List(2, 5, 8),
              List(0, 4, 8),
              List(2, 4, 6)
            )
