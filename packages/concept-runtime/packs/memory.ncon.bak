                Modulo(Length(Filter($cs, Lambda(List($ch), NotEquals($ch, ".")))), 2),
                "O",
                "X"
              )
            )
          ),
          Bind($move, Call(Member($bindings, "get"), "move")),
          Bind($sq,
            Call(
              Member(Map(Member($move, "args"), Lambda(List($a), Member($a, "value"))), "find"),
              Lambda(List($e), AtLeast(Call($index, $e), 0))
            )
          ),
          If(
            Not($sq),
            Return(
              Call(
                Member($api, "call"),
                "TicTacToe",
                Call(
                  Member($api, "call"),
                  "Apply",
                  Call(Member($bindings, "get"), "board"),
                  $move
                )
              )
            ),
            Undefined()
          ),
          Bind($cs, Call($cells, Call(Member($bindings, "get"), "board"))),
          Bind($illegal,
            Lambda(List($reason),
              Object(
                head = "Illegal",
                args = List(
                  Object(value = Call(Member($api, "call"), Member($sq, "head"))),
                  Object(name = "reason", value = $reason)
                )
              )
            )
          ),
          If(
            Or(Call($winner, $cs), Not(Includes($cs, "."))),
            Return(Call($illegal, "the game is over")),
            Undefined()
          ),
          If(
            NotEquals(Index($cs, Call($index, $sq)), "."),
            Return(Call($illegal, "taken")),
            Undefined()
          ),
          Bind($mark, Call($toMove, $cs)),
          Assign(Index($cs, Call($index, $sq)), $mark),
          Return(
            Object(
              head = "Moved",
              args = List(
                Object(value = Call(Member($api, "call"), $mark)),
                Object(value = Call(Member($api, "call"), Member($sq, "head"))),
                Object(name = "after", value = Call($toBoard, $cs))
              )
            )
          )
        )
      )
    )
  ),
  Realization(TicTacToe(Outcome($board)),
    evaluateArguments = false,
    properties = List(Program()),
    body = Bind($isCall,
      Lambda(List($e),
        Bind($t0,
          If(
            NotIdentical($e, null),
            Identical(TypeOf($e), "object"),
            false
          ),
          If(Truthy($t0), HasField("head", $e), $t0)
        )
      ),
      Bind($cells,
        Lambda(List($board2), Split(Join(Map(Arguments($board2), Lambda(List($a), FieldOf($a, "value"))), ""), "")),
        Bind($toBoard,
          Lambda(List($cs),
            MakeCall(
              "Board",
              List(
                Join(Slice($cs, 0, 3), ""),
                Join(Slice($cs, 3, 6), ""),
                Join(Slice($cs, 6), "")
              )
            )
          ),
          Bind($index,
            Lambda(List($sq),
              If(
                Truthy(
                  Bind($t1,
                    Call($isCall, $sq),
                    If(
                      Truthy($t1),
                      MatchesPattern(Regex("^[A-C][1-3]$", ""), Head($sq)),
                      $t1
                    )
                  )
                ),
                AddValues(
                  MultiplyValues(SubtractValues(ToNumber(Element(Head($sq), 1)), 1), 3),
                  IndexOf("ABC", Element(Head($sq), 0))
                ),
                NegateValue(1)
              )
            ),
            Bind($square,
              Lambda(List($i),
                AddValues(Element("ABC", RemainderOf($i, 3)), AddValues(RoundDown(DivideValues($i, 3)), 1))
              ),
              Bind($LINES,
                List(
                  List(0, 1, 2),
                  List(3, 4, 5),
                  List(6, 7, 8),
                  List(0, 3, 6),
                  List(1, 4, 7),
                  List(2, 5, 8),
                  List(0, 4, 8),
                  List(2, 4, 6)
                ),
                Bind($winner,
                  Lambda(List($cs2),
                    Bind($t2,
                      FirstSatisfying(
                        Map($LINES, Lambda(List($l), Join(Map($l, Lambda(List($i2), Element($cs2, $i2))), ""))),
                        Lambda(List($s), If(Identical($s, "XXX"), true, Identical($s, "OOO")))
                      ),
                      If(IsNothing($t2), Undefined(), Element($t2, 0))
                    )
                  ),
                  Bind($toMove,
                    Lambda(List($cs3),
                      If(
                        Truthy(RemainderOf(Length(Filter($cs3, Lambda(List($ch), NotIdentical($ch, ".")))), 2)),
                        "O",
                        "X"
                      )
                    ),
                    Bind($cs4,
                      Call($cells, Quote($board)),
                      Bind($won,
                        Call($winner, $cs4),
                        If(
                          Truthy($won),
                          MakeCall("Won", List(MakeCall($won, List()))),
                          If(
                            Truthy(Includes($cs4, ".")),
                            MakeCall("Ongoing", List()),
                            MakeCall("Drawn", List())
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ),
  Realization(TicTacToe(Reply($board)),
    evaluateArguments = false,
    properties = List(Program()),
    body = Bind($isCall,
      Lambda(List($e),
        Bind($t0,
          If(
            NotIdentical($e, null),
            Identical(TypeOf($e), "object"),
            false
          ),
          If(Truthy($t0), HasField("head", $e), $t0)
        )
      ),
      Bind($cells,
        Lambda(List($board2), Split(Join(Map(Arguments($board2), Lambda(List($a), FieldOf($a, "value"))), ""), "")),
        Bind($toBoard,
          Lambda(List($cs),
            MakeCall(
              "Board",
              List(
                Join(Slice($cs, 0, 3), ""),
                Join(Slice($cs, 3, 6), ""),
                Join(Slice($cs, 6), "")
              )
            )
          ),
          Bind($index,
            Lambda(List($sq),
              If(
                Truthy(
                  Bind($t1,
                    Call($isCall, $sq),
                    If(
                      Truthy($t1),
                      MatchesPattern(Regex("^[A-C][1-3]$", ""), Head($sq)),
                      $t1
                    )
                  )
                ),
                AddValues(
                  MultiplyValues(SubtractValues(ToNumber(Element(Head($sq), 1)), 1), 3),
                  IndexOf("ABC", Element(Head($sq), 0))
                ),
                NegateValue(1)
              )
            ),
            Bind($square,
              Lambda(List($i),
                AddValues(Element("ABC", RemainderOf($i, 3)), AddValues(RoundDown(DivideValues($i, 3)), 1))
              ),
              Bind($LINES,
                List(
                  List(0, 1, 2),
                  List(3, 4, 5),
                  List(6, 7, 8),
                  List(0, 3, 6),
                  List(1, 4, 7),
                  List(2, 5, 8),
                  List(0, 4, 8),
                  List(2, 4, 6)
                ),
                Bind($winner,
                  Lambda(List($cs2),
                    Bind($t2,
                      FirstSatisfying(
                        Map($LINES, Lambda(List($l), Join(Map($l, Lambda(List($i2), Element($cs2, $i2))), ""))),
                        Lambda(List($s), If(Identical($s, "XXX"), true, Identical($s, "OOO")))
                      ),
                      If(IsNothing($t2), Undefined(), Element($t2, 0))
                    )
                  ),
                  Bind($toMove,
                    Lambda(List($cs3),
                      If(
                        Truthy(RemainderOf(Length(Filter($cs3, Lambda(List($ch), NotIdentical($ch, ".")))), 2)),
                        "O",
                        "X"
                      )
                    ),
                    Bind($cs4,
                      Call($cells, Quote($board)),
                      Bind($me,
                        Call($toMove, $cs4),
                        Bind($free,
                          Filter(
                            Map($cs4, Lambda(List($ch2, $i3), If(Identical($ch2, "."), $i3, NegateValue(1)))),
                            Lambda(List($i4), NotBelow($i4, 0))
                          ),
                          Bind($finishing,
                            Lambda(List($m),
                              FirstSatisfying(
                                $free,
                                Lambda(List($i5),
                                  Bind($t,
                                    Cell(Concat(AsList($cs4))),
                                    Steps(
                                      Bind($t3,
                                        $m,
                                        Steps(Set($t, WithElement(Get($t), $i5, $t3)), $t3)
                                      ),
                                      Identical(Call($winner, Get($t)), $m)
                                    )
                                  )
                                )
                              )
                            ),
                            Bind($pick,
                              Bind($t5,
                                Bind($t4,
                                  Call($finishing, $me),
                                  If(
                                    IsNothing($t4),
                                    Call($finishing, If(Identical($me, "X"), "O", "X")),
                                    $t4
                                  )
                                ),
                                If(
                                  IsNothing($t5),
                                  FirstSatisfying(
                                    List(4, 0, 2, 6, 8, 1, 3, 5, 7),
                                    Lambda(List($i6), Truthy(Includes($free, $i6)))
                                  ),
                                  $t5
                                )
                              ),
                              MakeCall(Call($square, $pick), List())
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(X(), IsA(Mark()))

Concept(O(), IsA(Mark()))

Concept(Mark(), IsA(Category()))

Concept(Square(),
  IsA(Category()),
  Realization($square,
    context = Context(Execution(), Imperative()),
    evaluateArguments = false,
    properties = List(Program()),
    body = Bind($said,
      Quote($square),
      Bind($moved,
        Evaluate(
          MakeCall(
            "Move",
            Concat(
              List(MakeCall(Head($said), List())),
              AsList(Map(Arguments($said), Lambda(List($a), FieldOf($a, "value"))))
            )
          )
        ),
        If(
          Truthy(
            Bind($t0,
              $moved,
              If(Truthy($t0), Identical(Head($moved), "Move"), $t0)
            )
          ),
          $said,
          $moved
        )
      )
    )
  )
)

