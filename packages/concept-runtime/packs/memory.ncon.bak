                                                                )
                                                              )
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        ),
                                        Bind($game9,
                                          Head(Quote($game)),
                                          Call($inGame, $game9, Call($fold, $game9))
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

// Win, else block, else the best free square: centre, corners, edges.
Concept(TicTacToe(),
  IsA(Game()),
  DefinesEnding(),
  Realization(TicTacToe(Begin()),
    evaluateArguments = false,
    properties = List(Program()),
    body = Bind($isCall,
      Lambda(List($e),
        Bind($t0,
          If(
            NotIdentical($e, null),
            Identical(TypeOf($e), "object"),
            false
          ),
          If(Truthy($t0), HasField("head", $e), $t0)
        )
      ),
      Bind($cells,
        Lambda(List($board), Split(Join(Map(Arguments($board), Lambda(List($a), FieldOf($a, "value"))), ""), "")),
        Bind($toBoard,
          Lambda(List($cs),
            MakeCall(
              "Board",
              List(
                Join(Slice($cs, 0, 3), ""),
                Join(Slice($cs, 3, 6), ""),
                Join(Slice($cs, 6), "")
