          Bind($OWNER,
            Record(My = "Me", Your = "You", Our = "We"),
            Bind($user,
              Lambda(List($create),
                Bind($held,
                  FirstSatisfying(
                    ClaimsWithObject("User"),
                    Lambda(List($t), Identical(FieldOf($t, "predicate"), "IsA"))
                  ),
                  If(
                    Truthy($held),
                    FieldOf($held, "subject"),
                    If(
                      Falsy($create),
                      Undefined(),
                      Bind($id,
                        MintIdentity("User"),
                        Steps(
                          Assert(
                            $id,
                            MakeCall("IsA", List(MakeCall("User", List()))),
                            Undefined(),
                            CurrentCause()
                          ),
                          $id
                        )
                      )
                    )
                  )
                )
              ),
              Bind($who,
                Lambda(List($deictic, $create2),
                  If(
                    Identical($deictic, "Me"),
