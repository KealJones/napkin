      ),
      Bind($positional,
        Lambda(List($e2),
          If(
            Truthy(Call($isCall, $e2)),
            Map(
              Filter(Arguments($e2), Lambda(List($a), Identical(FieldOf($a, "name"), Undefined()))),
              Lambda(List($a2), FieldOf($a2, "value"))
