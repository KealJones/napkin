            List()
          )
        ),
        Bind($named,
          Lambda(List($e3, $n),
            If(
              Truthy(Call($isCall, $e3)),
              Bind($t1,
                FirstSatisfying(Arguments($e3), Lambda(List($a3), Identical(FieldOf($a3, "name"), $n))),
                If(IsNothing($t1), Undefined(), FieldOf($t1, "value"))
