              )
            )
          )
        )
      )
    )
  ),
  Realization(TicTacToe(Apply($board, $move)),
    evaluateArguments = false,
    body = Code(
      ir = Lambda(List($args, $bindings, $api),
        Sequence(
          Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
          Bind($cells,
            Lambda(List($board),
              Call(
                Member(
                  Call(Member(Map(Member($board, "args"), Lambda(List($a), Member($a, "value"))), "join"), ""),
                  "split"
                ),
                ""
              )
            )
          ),
          Bind($toBoard,
            Lambda(List($cs),
              Call(
                Member($api, "call"),
                "Board",
                Call(Member(Call(Member($cs, "slice"), 0, 3), "join"), ""),
                Call(Member(Call(Member($cs, "slice"), 3, 6), "join"), ""),
                Call(Member(Call(Member($cs, "slice"), 6), "join"), "")
              )
            )
          ),
          Bind($index,
            Lambda(List($sq),
              If(
                And(Call($isCall, $sq), Call(Member(Regex("^[A-C][1-3]$", ""), "test"), Member($sq, "head"))),
                Add(
                  Multiply(Subtract(Call($Number, Index(Member($sq, "head"), 1)), 1), 3),
