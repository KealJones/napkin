// "what's in the list": what the thing it names holds.
Concept(What(),
  Realization(What(Is(In($said))),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($done,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "Held",
                    Call(Member($bindings, "get"), "said")
                  ),
                  Member($api, "context")
                )
              )
            ),
            Return(
              If(
                And($done, Equals(Member($done, "head"), "Held")),
                Call(
                  Member($api, "call"),
                  "What",
                  Member(Index($args, 0), "value")
                ),
                $done
              )
            )
          )
        )
      )
    )
  )
)

