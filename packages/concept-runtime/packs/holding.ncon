                    Member($api, "call"),
                    "Change",
                    Call(Member($api, "call"), "Add"),
                    Call(Member($bindings, "get"), "said")
                  ),
                  Member($api, "context")
                )
              )
            ),
            Return(
              If(
                And($done, Equals(Member($done, "head"), "Change")),
                Call(
                  Member($api, "call"),
                  "Put",
                  Call(Member($bindings, "get"), "said")
                ),
                $done
              )
            )
          )
        )
      )
    )
  )
)

