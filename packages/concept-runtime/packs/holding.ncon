// Things made in conversation, and one thing holding others (memory-spec Part 6.1 and 7).
// "Make a shopping list" makes ShoppingList_1, a ShoppingList, which is a List; "add milk to my
// shopping list" puts Contains(Milk()) on it, "take milk off it" retracts that, and "what is on
// my list" is what still holds (Contains, packs/basic.ncon). Which thing the words mean is focus's (ReferentOf, given the
// description). Nothing here is about lists or shopping. Written by scripts/pack.mjs from
// sources/holding (edit those, not this).
Requires(Core(), Basic(), Memory(), Focus())

// What came of making, adding and removing: said by packs/english.ncon.
Concept(Made(), IsA(Result()))

Concept(Added(), IsA(Result()))

Concept(Removed(), IsA(Result()))

// "can you add cheetos to my list?": asked for, so done. Asked, not worked out, so hearing still reads Add as taking two.
Concept(Add(),
  Realization(Add($said),
    context = Interrogative(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($done,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "Change",
                    Call(Member($api, "call"), "Add"),
                    Call(Member($bindings, "get"), "said")
                  ),
                  Member($api, "context")
                )
              )
            ),
            Return(
              If(
                And($done, Equals(Member($done, "head"), "Change")),
                Call(
                  Member($api, "call"),
                  "Add",
                  Call(Member($bindings, "get"), "said")
                ),
                $done
              )
            )
          )
        )
      )
    )
  )
)

// "add milk and eggs to my list", heard as the two things Add takes: put in the thing named;
// naming none, Add's next realization adds.
Concept(Add(),
  Realization(Add($item, $said),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($done,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "Change",
                    Call(Member($api, "call"), "Add"),
                    Call(
                      Member($api, "call"),
                      "And",
                      Call(Member($bindings, "get"), "item"),
                      Call(Member($bindings, "get"), "said")
                    )
                  ),
                  Member($api, "context")
                )
              )
            ),
            Return(
              If(
                And($done, Equals(Member($done, "head"), "Change")),
                Call(
                  Member($api, "call"),
                  "Add",
                  Call(Member($bindings, "get"), "item"),
                  Call(Member($bindings, "get"), "said")
                ),
                $done
              )
            )
          )
        )
      )
    )
  )
)

// "add cheese and pie and nuts to the list", heard as the things Add takes, each its own: put in
// the thing named; naming none, Add's next realization adds them.
Concept(Add(),
  Realization(Add($a, $b, $c, Rest($more)),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($all,
              Map(
                Filter($args, Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                Lambda(List($a), Member($a, "value"))
              )
            ),
            Bind($done,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "Change",
                    Call(Member($api, "call"), "Add"),
                    Call(Member($api, "call"), "And", Spread($all))
                  ),
                  Member($api, "context")
                )
              )
            ),
            Return(
              If(
                And($done, Equals(Member($done, "head"), "Change")),
                Call(Member($api, "call"), "Add", Spread($all)),
                $done
              )
            )
          )
        )
      )
    )
  )
)

// "add cheetos to my shopping list": put in the thing it names; naming none, Add's next realization adds.
Concept(Add(),
  Realization(Add(Ref(Rest($r)), $said),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($done,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "Change",
                    Call(Member($api, "call"), "Add"),
                    Call(Member($bindings, "get"), "said")
                  ),
                  Member($api, "context")
                )
              )
            ),
            Return(
              If(
                And($done, Equals(Member($done, "head"), "Change")),
                Call(
                  Member($api, "call"),
                  "Add",
                  Member(Index($args, 0), "value"),
                  Call(Member($bindings, "get"), "said")
                ),
                $done
              )
            )
          )
        )
      )
    )
  )
)

// Things put in or taken out of the thing the words name: "add cheetos to my shopping list" is
// heard Cheetos(To(My(List(Shopping())))), where it goes said inside what goes. $doing is Add
// or Remove. Adding to a kind of collection nothing is made of yet makes one. Answered, so a
// statement that does this is taken as done; supposed (Hypothetical), nothing changes. The call
// itself when the words name no such thing.
Concept(Change(),
  Realization(Change($doing, $said),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($doing, Call(Member($bindings, "get"), "doing")),
            Bind($said, Call(Member($bindings, "get"), "said")),
            Bind($none, Call(Member($api, "call"), "Change", $doing, $said)),
            Bind($adding, And(Call($isCall, $doing), Equals(Member($doing, "head"), "Add"))),
            Bind($facets,
              If(
                And(Member($api, "context"), Equals(Member(Member($api, "context"), "head"), "Context")),
                Map(Member(Member($api, "context"), "args"), Lambda(List($a), Member($a, "value"))),
                List(Member($api, "context"))
              )
            ),
            Bind($supposed,
              Call(
                Member($facets, "some"),
                Lambda(List($f), And(Call($isCall, $f), Equals(Member($f, "head"), "Hypothetical")))
              )
            ),
            Comment("Where: the one word inside that says where (to, on, in, from) and holds what names a thing."),
            Comment("\"to it\": what the word points at, when it was pointed at already (resolvedTo) or by the word."),
            Bind($refer,
              Async(
                Lambda(List($e),
                  Sequence(
                    If(
                      And(Call($isCall, $e), Equals(Member($e, "head"), "Ref")),
                      Sequence(
                        Bind($to,
                          Call(
                            Member(Member($e, "args"), "find"),
                            Lambda(List($a), Equals(Member($a, "name"), "resolvedTo"))
                          )
                        ),
                        If(
                          $to,
                          Return(
                            If(
                              Call($isCall, Member($to, "value")),
                              Member($to, "value"),
                              Undefined()
                            )
                          ),
                          Undefined()
                        ),
                        If(
                          Or(
                            NotEquals(TypeOf(OptionalMember(Index(Member($e, "args"), 0), "value")), "string"),
                            Not(Member(Index(Member($e, "args"), 0), "value"))
                          ),
                          Return(Undefined()),
                          Undefined()
                        ),
                        Assign($e, Member(Index(Member($e, "args"), 0), "value"))
                      ),
                      Undefined()
                    ),
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "ReferentOf", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(
                      If(
                        And(Call($isCall, $r), NotEquals(Member($r, "head"), "ReferentOf")),
                        $r,
                        Undefined()
                      )
                    )
                  )
                )
              )
            ),
            Var($target, Undefined()),
            Var($place, Undefined()),
            Bind($look,
              Async(
                Lambda(List($e),
                  Sequence(
                    If(
                      Or(Not(Call($isCall, $e)), $target),
                      Return($e),
                      Undefined()
                    ),
                    Bind($args, List()),
                    ForOf(
                      $a,
                      Member($e, "args"),
                      Sequence(
                        Bind($v, Member($a, "value")),
                        If(
                          And(
                            And(And(Not($target), Equals(Member($a, "name"), Undefined())), Call($isCall, $v)),
                            Equals(Length(Member($v, "args")), 1)
                          ),
                          Sequence(
                            Bind($inner, Member(Index(Member($v, "args"), 0), "value")),
                            Bind($found, Await(Call($refer, $inner))),
                            If(
                              $found,
                              Sequence(Assign($target, $found), Continue()),
                              Undefined()
                            ),
                            Bind($collection,
                              And(
                                Call($isCall, $inner),
                                Await(
                                  Call(
                                    Member($api, "evaluate"),
                                    Call(
                                      Member($api, "call"),
                                      "Fits",
                                      $inner,
                                      Call(Member($api, "call"), "Collection")
                                    ),
                                    Call(Member($api, "call"), "Execution")
                                  )
                                )
                              )
                            ),
                            If(
                              And(
                                And(And($adding, Not($supposed)), Call($isCall, $collection)),
                                Equals(Member($collection, "head"), "True")
                              ),
                              Sequence(Assign($place, $inner), Continue()),
                              Undefined()
                            )
                          ),
                          Undefined()
                        ),
                        Call(Member($args, "push"), Object(Spread($a), value = Await(Call($look, $v))))
                      )
                    ),
                    Return(Object(head = Member($e, "head"), args = $args))
                  )
                )
              )
            ),
            Bind($rest, Await(Call($look, $said))),
            If(
              And(Not($target), $place),
              Sequence(
                Bind($made,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Call(Member($api, "call"), "Write", $place),
                      Call(Member($api, "call"), "Execution")
                    )
                  )
                ),
                Assign(
                  $target,
                  If(
                    And(Call($isCall, $made), Equals(Member($made, "head"), "Made")),
                    Member(Index(Member($made, "args"), 0), "value"),
                    Undefined()
                  )
                )
              ),
              Undefined()
            ),
            If(Not($target), Return($none), Undefined()),
            Bind($items, List()),
            Bind($flat,
              Async(
                Lambda(List($e),
                  Sequence(
                    If(
                      And(Call($isCall, $e), Includes(List("And", "List", "Sequence"), Member($e, "head"))),
                      ForOf(
                        $a,
                        Member($e, "args"),
                        Await(Call($flat, Member($a, "value")))
                      ),
                      If(
                        And(Call($isCall, $e), NotEquals(Member($e, "head"), "Ref")),
                        Call(
                          Member($items, "push"),
                          Await(
                            Call(
                              Member($api, "evaluate"),
                              Call(Member($api, "call"), "Read", $e),
                              Call(Member($api, "call"), "Execution")
                            )
                          )
                        ),
                        Undefined()
                      )
                    ),
                    Undefined()
                  )
                )
              )
            ),
            Await(Call($flat, $rest)),
            If(Not(Length($items)), Return($none), Undefined()),
            Bind($unit, Call(Member(Member($api, "store"), "get"), Member($target, "head"))),
            Bind($held,
              Lambda(List($item),
                Filter(
                  Otherwise(OptionalMember($unit, "relations"), List()),
                  Lambda(List($r),
                    And(
                      And(
                        And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), "Contains")),
                        Equals(
                          Call(Member($api, "format"), Member(Index(Member(Member($r, "claim"), "args"), 0), "value")),
                          Call(Member($api, "format"), $item)
                        )
                      ),
                      Not(
                        Call(
                          Member(Member($api, "store"), "retracted"),
                          Member($target, "head"),
                          Member($r, "claim")
                        )
                      )
                    )
                  )
                )
              )
            ),
            ForOf(
              $item,
              If($supposed, List(), $items),
              If(
                $adding,
                If(
                  Not(Length(Call($held, $item))),
                  Call(
                    Member(Member($api, "store"), "addRelation"),
                    Member($target, "head"),
                    Call(Member($api, "call"), "Contains", $item),
                    Undefined(),
                    Member(Member($api, "trace"), "cause")
                  ),
                  Undefined()
                ),
                ForOf(
                  $r,
                  Call($held, $item),
                  ForOf(
                    $s,
                    Otherwise(Member($r, "stamps"), List()),
                    Call(
                      Member(Member($api, "store"), "addRelation"),
                      Member($target, "head"),
                      Call(Member($api, "call"), "Retracts", Member($s, "seq")),
                      Undefined(),
                      Member(Member($api, "trace"), "cause")
                    )
                  )
                )
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "Answer",
                Call(
                  Member($api, "call"),
                  If($adding, "Added", "Removed"),
                  Call(Member($api, "call"), "List", Spread($items)),
                  $target
                )
              )
            )
          )
        )
      )
    )
  )
)

// Things told of a holder just made go in it: "make a shopping list? I need milk, eggs" (the
// same message), or "milk, eggs" said alone while it is the newest thing in play. What goes in
// is the group the line names (milk, eggs), else what it ends on (milk, in "I need milk"). The
// call itself otherwise, to be noted as told.
Concept(Fills(),
  Realization(Fills($line),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($line, Call(Member($bindings, "get"), "line")),
            Bind($none, Call(Member($api, "call"), "Fills", $line)),
            Bind($conversation, Call(Member($api, "ambient"), "conversation")),
            If(
              Or(Not($conversation), Not(Call($isCall, $line))),
              Return($none),
              Undefined()
            ),
            Bind($focus,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "ConversationFocus",
                    $conversation
                  ),
                  Call(Member($api, "call"), "Execution")
                )
              )
            ),
            Bind($newest,
              If(
                And(And(Call($isCall, $focus), Equals(Member($focus, "head"), "List")), Length(Member($focus, "args"))),
                Member(Index(Member($focus, "args"), 0), "value"),
                Undefined()
              )
            ),
            Bind($holder,
              If(
                And(
                  And(Call($isCall, $newest), Call(Member(Regex("_[0-9]+$", ""), "test"), Member($newest, "head"))),
                  Includes(Call(Member($api, "typesOf"), $newest), "Collection")
                ),
                $newest,
                Undefined()
              )
            ),
            If(Not($holder), Return($none), Undefined()),
            Bind($now, Member(Member($api, "trace"), "cause")),
            Comment("Made in this message: what it is was said now, not only what it holds."),
            Bind($madeNow,
              And(
                NotEquals($now, Undefined()),
                Call(
                  Member(
                    Otherwise(
                      OptionalMember(Call(Member(Member($api, "store"), "get"), Member($holder, "head")), "relations"),
                      List()
                    ),
                    "some"
                  ),
                  Lambda(List($r),
                    And(
                      And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), "IsA")),
                      Call(
                        Member(Otherwise(Member($r, "stamps"), List()), "some"),
                        Lambda(List($s), Equals(Member($s, "source"), $now))
                      )
                    )
                  )
                )
              )
            ),
            Bind($group,
              Lambda(List($e),
                And(Call($isCall, $e), Or(Equals(Member($e, "head"), "And"), Equals(Member($e, "head"), "List")))
              )
            ),
            Bind($find,
              Lambda(List($e),
                Sequence(
                  If(Not(Call($isCall, $e)), Return(Undefined()), Undefined()),
                  If(Call($group, $e), Return($e), Undefined()),
                  ForOf(
                    $a,
                    Member($e, "args"),
                    Sequence(
                      Bind($inner,
                        If(
                          Equals(Member($a, "name"), Undefined()),
                          Call($find, Member($a, "value")),
                          Undefined()
                        )
                      ),
                      If($inner, Return($inner), Undefined())
                    )
                  ),
                  Return(Undefined())
                )
              )
            ),
            Comment("What a line ends on: its last word's last thing, past who is speaking."),
            Bind($last,
              Lambda(List($e),
                Sequence(
                  Var($at, $e),
                  While(
                    And(
                      And(
                        And(Call($isCall, $at), Length(Member($at, "args"))),
                        Call(
                          Member(Member($at, "args"), "every"),
                          Lambda(List($a), Equals(Member($a, "name"), Undefined()))
                        )
                      ),
                      Not(Call($group, $at))
                    ),
                    Sequence(
                      Bind($next, Member(Index(Member($at, "args"), Subtract(Length(Member($at, "args")), 1)), "value")),
                      If(
                        Or(
                          Not(Call($isCall, $next)),
                          And(
                            Not(Length(Member($next, "args"))),
                            Includes(Call(Member($api, "typesOf"), $next), "Deictic")
                          )
                        ),
                        Break(),
                        Undefined()
                      ),
                      If(
                        Not(Length(Member($next, "args"))),
                        Return($next),
                        Undefined()
                      ),
                      Assign($at, $next)
                    )
                  ),
                  Return(If(Call($group, $at), $at, Undefined()))
                )
              )
            ),
            Comment("Said alone, only things: no doing, no one speaking."),
            Bind($onlyThings,
              Or(
                Call($group, $line),
                And(
                  And(
                    Call($isCall, $line),
                    Not(
                      Includes(
                        Call(Member($api, "typesOf"), Call(Member($api, "call"), Member($line, "head"))),
                        "Deictic"
                      )
                    )
                  ),
                  Call(
                    Member(Member($line, "args"), "every"),
                    Lambda(List($a),
                      And(Call($isCall, Member($a, "value")), Not(Length(Member(Member($a, "value"), "args"))))
                    )
                  )
                )
              )
            ),
            If(
              And(Not($madeNow), Not($onlyThings)),
              Return($none),
              Undefined()
            ),
            Bind($items, Otherwise(Call($find, $line), If($onlyThings, $line, Call($last, $line)))),
            If(Not($items), Return($none), Undefined()),
            Bind($done,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "Change",
                    Call(Member($api, "call"), "Add"),
                    Call(
                      Member($api, "call"),
                      "And",
                      $items,
                      Call(Member($api, "call"), "To", $holder)
                    )
                  ),
                  Member($api, "context")
                )
              )
            ),
            Return(
              If(
                And($done, Equals(Member($done, "head"), "Change")),
                $none,
                $done
              )
            )
          )
        )
      )
    )
  )
)

// What the thing the words name holds: every item put in it and not taken out. The call itself
// when the words name nothing made.
Concept(Held(),
  Realization(Held($said),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($said, Call(Member($bindings, "get"), "said")),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "ReferentOf", $said),
                  Call(Member($api, "call"), "Execution")
                )
              )
            ),
            If(
              Or(Not(Call($isCall, $thing)), Equals(Member($thing, "head"), "ReferentOf")),
              Return(Call(Member($api, "call"), "Held", $said)),
              Undefined()
            ),
            Bind($items,
              Map(
                Filter(
                  Otherwise(
                    OptionalMember(Call(Member(Member($api, "store"), "get"), Member($thing, "head")), "relations"),
                    List()
                  ),
                  Lambda(List($r),
                    And(
                      And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), "Contains")),
                      Not(
                        Call(
                          Member(Member($api, "store"), "retracted"),
                          Member($thing, "head"),
                          Member($r, "claim")
                        )
                      )
                    )
                  )
                ),
                Lambda(List($r), Member(Index(Member(Member($r, "claim"), "args"), 0), "value"))
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "Answer",
                Call(Member($api, "call"), "List", Spread($items))
              )
            )
          )
        )
      )
    )
  )
)

// "make a shopping list": a thing of that kind, made here, when none is in play yet. Its kind
// (ShoppingList) is a kind of what was said (List), so "my list" finds it too. What it is made
// with ("with eggs, aspirin and cheese") is put in it.
Concept(Write(),
  Realization(Write($said),
    context = Execution(),
    evaluateArguments = false,
    types = Types(said = OneOf(Collection(), Described(Collection()))),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Var($whole, Call(Member($bindings, "get"), "said")),
            Comment("\"a new shopping list\": the describer around the list says which one, not what kind, and one"),
            Comment("described is another one, not one already in play."),
            Bind($wrapped, Not(Includes(Call(Member($api, "typesOf"), $whole), "Collection"))),
            If(
              $wrapped,
              Assign(
                $whole,
                Member(
                  Call(
                    Member(Member($whole, "args"), "find"),
                    Lambda(List($a), Equals(Member($a, "name"), Undefined()))
                  ),
                  "value"
                )
              ),
              Undefined()
            ),
            Comment("The things it is made with are what goes in it, not what kind of thing it is."),
            Bind($withs,
              Filter(
                Member($whole, "args"),
                Lambda(List($a),
                  And(
                    And(Equals(Member($a, "name"), Undefined()), Call($isCall, Member($a, "value"))),
                    Equals(Member(Member($a, "value"), "head"), "With")
                  )
                )
              )
            ),
            Bind($said,
              Object(
                head = Member($whole, "head"),
                args = Filter(Member($whole, "args"), Lambda(List($a), Not(Includes($withs, $a))))
              )
            ),
            Bind($kind,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "KindNamed", $said),
                  Call(Member($api, "call"), "Execution")
                )
              )
            ),
            If(
              Or(Not(Call($isCall, $kind)), Equals(Member($kind, "head"), "KindNamed")),
              Return(
                Call(
                  Member($api, "call"),
                  "Write",
                  Call(Member($bindings, "get"), "said")
                )
              ),
              Undefined()
            ),
            Comment("One of exactly that kind already in play is the one meant (\"make a shopping list\", said"),
            Comment("again); \"make a list\" after a grocery list makes a list."),
            Comment("One described by more than its kind (\"a new shopping list\", \"a red box\") is another one."),
            Bind($described,
              Or(
                $wrapped,
                And(
                  GreaterThan(Length(Member($said, "args")), 0),
                  NotEquals(
                    Member($kind, "head"),
                    Add(
                      Call(
                        Member(
                          Map(
                            Member($said, "args"),
                            Lambda(List($a),
                              If(
                                Call($isCall, Member($a, "value")),
                                Member(Member($a, "value"), "head"),
                                ""
                              )
                            )
                          ),
                          "join"
                        ),
                        ""
                      ),
                      Member($said, "head")
                    )
                  )
                )
              )
            ),
            Var(
              $thing,
              If(
                $described,
                Undefined(),
                Await(
                  Call(
                    Member($api, "evaluate"),
                    Call(Member($api, "call"), "ReferentOf", $said),
                    Call(Member($api, "call"), "Execution")
                  )
                )
              )
            ),
            Bind($exactly,
              And(
                And(Call($isCall, $thing), NotEquals(Member($thing, "head"), "ReferentOf")),
                Equals(Index(Call(Member($api, "typesOf"), $thing), 1), Member($kind, "head"))
              )
            ),
            If(
              Not($exactly),
              Sequence(
                If(
                  And(
                    NotEquals(Member($kind, "head"), Member($said, "head")),
                    Not(Includes(Call(Member($api, "typesOf"), $kind), Member($said, "head")))
                  ),
                  Call(
                    Member(Member($api, "store"), "addRelation"),
                    Member($kind, "head"),
                    Call(
                      Member($api, "call"),
                      "IsA",
                      Call(Member($api, "call"), Member($said, "head"))
                    ),
                    Undefined(),
                    Member(Member($api, "trace"), "cause")
                  ),
                  Undefined()
                ),
                Assign(
                  $thing,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Call(Member($api, "call"), "Mint", Member($kind, "head")),
                      Call(Member($api, "call"), "Execution")
                    )
                  )
                ),
                Call(
                  Member(Member($api, "store"), "addRelation"),
                  Member($thing, "head"),
                  Call(Member($api, "call"), "IsA", $kind),
                  Undefined(),
                  Member(Member($api, "trace"), "cause")
                )
              ),
              Undefined()
            ),
            Comment("Made or found again, it is what this message is about now: said so with its kind, stamped"),
            Comment("by this message, so what the rest of it names goes in it (Fills)."),
            If(
              $exactly,
              Call(
                Member(Member($api, "store"), "addRelation"),
                Member($thing, "head"),
                Call(Member($api, "call"), "IsA", $kind),
                Undefined(),
                Member(Member($api, "trace"), "cause")
              ),
              Undefined()
            ),
            Bind($made, Call(Member($api, "call"), "Made", $thing)),
            If(Not(Length($withs)), Return($made), Undefined()),
            Bind($items,
              FlatMap(
                $withs,
                Lambda(List($w),
                  Map(
                    Filter(
                      Member(Member($w, "value"), "args"),
                      Lambda(List($a), Equals(Member($a, "name"), Undefined()))
                    ),
                    Lambda(List($a), Member($a, "value"))
                  )
                )
              )
            ),
            Bind($added,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "Change",
                    Call(Member($api, "call"), "Add"),
                    Call(
                      Member($api, "call"),
                      "And",
                      Spread($items),
                      Call(Member($api, "call"), "To", $thing)
                    )
                  ),
                  Member($api, "context")
                )
              )
            ),
            Return(
              If(
                And($added, NotEquals(Member($added, "head"), "Change")),
                Call(Member($api, "call"), "Sequence", $made, $added),
                $made
              )
            )
          )
        )
      )
    )
  )
)

// "make me a shopping list": who it is for is said, and the list is made as any is.
Concept(Write(),
  Realization(Write($for, $said),
    context = Execution(),
    evaluateArguments = false,
    types = Types(said = Collection()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($done,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "Write",
                    Call(Member($bindings, "get"), "said")
                  ),
                  Member($api, "context")
                )
              )
            ),
            Return(
              If(
                And($done, Equals(Member($done, "head"), "Write")),
                Call(
                  Member($api, "call"),
                  "Write",
                  Call(Member($bindings, "get"), "for"),
                  Call(Member($bindings, "get"), "said")
                ),
                $done
              )
            )
          )
        )
      )
    )
  )
)

