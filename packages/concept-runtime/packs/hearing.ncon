Requires(Basic())

// ================================================================
// Hearing: the words of a message finding their relations to each other
// (design/prompt-hearing.md). A word hears as its own Concept, then as what it is (its
// kind, its word class, the tagger's tags), then as the universal parent. What each hears is
// a proposal of links to other words, settled in rounds until nothing changes.

// Under Hearing(), a word hears, and nothing it does elsewhere runs: "add" must not add. Its
// rounds are quiet: not traced unless asked for (Quiet()).
Concept(Hearing(),
  IsA(ContextFacet()),
  Exclusive(),
  Quiet()
)

// A message as its words, in order, each as typed with what it is known or tagged to be.
Concept(Prompt(), IsA(Data()))

Concept(Word(), IsA(Data()))

// What hearing writes out: one Concept expression per part of the message that stands alone.
Concept(Phrases(), IsA(Data()))

// A relation one word proposes to another, by position: Link(from, to, role).
Concept(Link(), IsA(Data()))

Concept(LinkRole(), IsA(Category()))

// "teen" modifies "film": the thing is the head.
Concept(Modifies(), IsA(LinkRole()))

// "by" takes "weitz"; "co-produced" takes "by".
Concept(Takes(), IsA(LinkRole()))

// "and" groups the words either side of it.
Concept(Joins(), IsA(LinkRole()))

// "the" is part of how "car" is said, and adds nothing to run.
Concept(Absorbs(), IsA(LinkRole()))

// "?", "not", "maybe": asked, negated, blurred.
Concept(Marks(), IsA(LinkRole()))

// "what" asks about what follows it; it holds what nothing else took.
Concept(AskedAbout(), IsA(LinkRole()))

// "too", "also": one more of something said before.
Concept(Adds(), IsA(LinkRole()))

// "it", "that bug": something said before, or known.
Concept(PointsAt(), IsA(LinkRole()))

// Every word hears, known or not. A word with no hearing of its own hears as its tags do:
// "americanpie", tagged Noun, hears as a noun (design/prompt-hearing.md, 2.5).
Concept(Concept(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("Every word hears, known or not. A word with no hearing of its own hears as its tags do:"),
            Comment("\"americanpie\", tagged Noun, hears as a noun. A tag with no hearing of its own proposes nothing."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            If(
              Or(Not(Call($isCall, $self)), LessThan(Length(Member($self, "args")), 3)),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($prompt, Member(Index(Member($self, "args"), 0), "value")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($word,
              If(
                Index(Member($prompt, "args"), $at),
                Member(Index(Member($prompt, "args"), $at), "value"),
                Undefined()
              )
            ),
            If(
              Not(Call($isCall, $word)),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($text, Call($String, Member(Index(Member($word, "args"), 0), "value"))),
            Bind($name,
              Call(
                Member(
                  Map(
                    Filter(
                      Call(Member($text, "split"), Regex("[^A-Za-z0-9]+", "")),
                      Lambda(List($p), GreaterThan(Length($p), 0))
                    ),
                    Lambda(List($p),
                      Add(
                        Call(Member(Index($p, 0), "toUpperCase")),
                        Call(Member(Call(Member($p, "slice"), 1), "toLowerCase"))
                      )
                    )
                  ),
                  "join"
                ),
                ""
              )
            ),
            If(
              NotEquals(Member($self, "head"), $name),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($tags, Member(Index(Member($word, "args"), 2), "value")),
            Bind($out, List()),
            ForOf(
              $t,
              If(Call($isCall, $tags), Member($tags, "args"), List()),
              Sequence(
                If(
                  Not(Call($isCall, Member($t, "value"))),
                  Continue(),
                  Undefined()
                ),
                Bind($proposed,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Call(
                        Member($api, "call"),
                        Member(Member($t, "value"), "head"),
                        $prompt,
                        $at,
                        Member(Index(Member($self, "args"), 2), "value")
                      ),
                      Call(Member($api, "call"), "Hearing")
                    )
                  )
                ),
                If(
                  And(Call($isCall, $proposed), Equals(Member($proposed, "head"), "List")),
                  ForOf(
                    $p,
                    Member($proposed, "args"),
                    Call(Member($out, "push"), Member($p, "value"))
                  ),
                  Undefined()
                )
              )
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// What a word is, as the tagger proposes it or the graph knows it, with hearing of its own.
Concept(Determiner(), IsA(WordClass()))

Concept(Value(), IsA(WordClass()))

Concept(Pronoun(), IsA(WordClass()))

Concept(Preposition(), IsA(WordClass()))

Concept(Conjunction(), IsA(WordClass()))

Concept(Copula(), IsA(WordClass()))

// "lol means laugh out loud": a word said to mean something is said with a verb, whatever the
// tagger guesses of "means".
Concept(Means(), IsA(Verb()))

// A word that says something about the thing after it: "old", "1999", "my".
Concept(Describer(), IsA(Category()))

Concept(Adjective(), IsA(Describer()))

Concept(Value(), IsA(Describer()))

Concept(Possessive(), IsA(Describer()))

// "hello world": an interjection before a thing is said of it.
Concept(Expression(), IsA(Describer()))

// The closed classes, known by the graph whatever the tagger guesses in context: "in" in
// "work in progress" is a preposition, though the tagger calls it a noun there.
Concept(In(), IsA(Preposition()))

Concept(On(), IsA(Preposition()))

Concept(At(), IsA(Preposition()))

Concept(For(), IsA(Preposition()))

Concept(To(), IsA(Preposition()))

Concept(Of(), IsA(Preposition()))

Concept(With(), IsA(Preposition()))

Concept(About(), IsA(Preposition()))

Concept(From(), IsA(Preposition()))

Concept(By(), IsA(Preposition()))

// "From" marks the first of two values: subtract 3 from 10 is 10 minus 3.
Concept(From(), MarksFirst())

Concept(Into(), IsA(Preposition()))

Concept(Onto(), IsA(Preposition()))

Concept(Over(), IsA(Preposition()))

Concept(Under(), IsA(Preposition()))

Concept(After(), IsA(Preposition()))

Concept(Before(), IsA(Preposition()))

Concept(Until(), IsA(Preposition()))

Concept(Near(), IsA(Preposition()))

Concept(As(), IsA(Preposition()))

Concept(Like(), IsA(Preposition()))

Concept(Per(), IsA(Preposition()))

Concept(Without(), IsA(Preposition()))

Concept(Through(), IsA(Preposition()))

Concept(During(), IsA(Preposition()))

Concept(Above(), IsA(Preposition()))

Concept(Across(), IsA(Preposition()))

Concept(Against(), IsA(Preposition()))

Concept(Along(), IsA(Preposition()))

Concept(Alongside(), IsA(Preposition()))

Concept(Amid(), IsA(Preposition()))

Concept(Among(), IsA(Preposition()))

Concept(Around(), IsA(Preposition()))

Concept(Atop(), IsA(Preposition()))

Concept(Behind(), IsA(Preposition()))

Concept(Below(), IsA(Preposition()))

Concept(Beneath(), IsA(Preposition()))

Concept(Beside(), IsA(Preposition()))

Concept(Besides(), IsA(Preposition()))

Concept(Between(), IsA(Preposition()))

Concept(Beyond(), IsA(Preposition()))

Concept(Despite(), IsA(Preposition()))

Concept(Except(), IsA(Preposition()))

Concept(Inside(), IsA(Preposition()))

Concept(Outside(), IsA(Preposition()))

Concept(Past(), IsA(Preposition()))

Concept(Throughout(), IsA(Preposition()))

Concept(Toward(), IsA(Preposition()))

Concept(Towards(), IsA(Preposition()))

Concept(Underneath(), IsA(Preposition()))

Concept(Unlike(), IsA(Preposition()))

Concept(Upon(), IsA(Preposition()))

Concept(Via(), IsA(Preposition()))

Concept(Within(), IsA(Preposition()))

Concept(Versus(), IsA(Preposition()))

Concept(And(), IsA(Conjunction()))

Concept(Or(), IsA(Conjunction()))

Concept(But(), IsA(Conjunction()))

// The thing a phrase starting after a word is about: the last noun of what follows.
Concept(ThingAfter(),
  Realization(ThingAfter($prompt, $at),
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("The thing a phrase starting after `at` is about: the last noun of the describers and"),
            Comment("nouns that follow, before anything else. \"a 1999 American teen comedy film\": film."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($inPhrase,
              Lambda(List($i),
                And(
                  And(
                    Call(
                      Member(
                        List(
                          "Determiner",
                          "Adjective",
                          "Value",
                          "Possessive",
                          "Noun",
                          "Expression",
                          "Time",
                          "Date"
                        ),
                        "some"
                      ),
                      Lambda(List($t), Call($has, $i, $t))
                    ),
                    Not(And(Call($has, $i, "Pronoun"), Not(Call($has, $i, "Possessive"))))
                  ),
                  Not(
                    Call(
                      Member(
                        List(
                          "Preposition",
                          "Conjunction",
                          "Copula",
                          "Negative",
                          "Operator"
                        ),
                        "some"
                      ),
                      Lambda(List($t), Call($has, $i, $t))
                    )
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 3), "value"),
                  Negate(1)
                )
              )
            ),
            Var($thing, Negate(1)),
            Comment("Filler is passed over: \"like uh pie\" likes pie."),
            Var($value, Negate(1)),
            Bind($after,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Call(
                    $String,
                    Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 5), "value")
                  ),
                  ""
                )
              )
            ),
            Comment("A comma or colon ends a phrase: \"2, 4, 8\" are three things, \"next: 2\" two."),
            If(
              And(Call(Member(Regex("[,:;]", ""), "test"), Call($after, $at)), Not(Call($has, $at, "Filler"))),
              Return(Negate(1)),
              Undefined()
            ),
            For(
              Var($j, Add($at, 1)),
              And(
                And(LessThan($j, Length(Member($prompt, "args"))), Equals(Call($sentence, $j), Call($sentence, $at))),
                Or(Call($inPhrase, $j), Call($has, $j, "Filler"))
              ),
              PostIncrement($j),
              Sequence(
                If(
                  And(
                    And(
                      GreaterThan($j, Add($at, 1)),
                      Call(Member(Regex("[,:;]", ""), "test"), Call($after, Subtract($j, 1)))
                    ),
                    Not(Call($has, Subtract($j, 1), "Filler"))
                  ),
                  Break(),
                  Undefined()
                ),
                Comment("A determiner after a thing starts the next one: \"chess a sport\"."),
                If(
                  And(Or(AtLeast($thing, 0), AtLeast($value, 0)), Call($has, $j, "Determiner")),
                  Break(),
                  Undefined()
                ),
                If(Call($has, $j, "Filler"), Continue(), Undefined()),
                Comment("\"the date tomorrow\": a when after a thing is a thing of its own."),
                If(
                  And(And(AtLeast($thing, 0), Call($has, $j, "Date")), Not(Call($has, $thing, "Date"))),
                  Break(),
                  Undefined()
                ),
                Comment("\"is your name keal\": a name after a common thing is a thing of its own."),
                If(
                  And(And(AtLeast($thing, 0), Call($has, $j, "ProperNoun")), Not(Call($has, $thing, "ProperNoun"))),
                  Break(),
                  Undefined()
                ),
                If(
                  Call($has, $j, "Noun"),
                  Assign($thing, $j),
                  If(
                    Or(Or(Call($has, $j, "Value"), Call($has, $j, "Time")), Call($has, $j, "Date")),
                    Assign($value, $j),
                    Undefined()
                  )
                )
              )
            ),
            Comment("\"take 10\", \"the second one\": with no noun, the last number is the thing."),
            If(LessThan($thing, 0), Assign($thing, $value), Undefined()),
            Return($thing)
          )
        )
      )
    )
  )
)

// "the", "a": part of how the next thing is said.
Concept(Determiner(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"the\", \"a\": part of how the next thing is said."),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Comment("\"a function that says hello world\": after a thing and before a doing, it holds the doing,"),
            Comment("and belongs to the thing."),
            If(
              And(
                And(And(GreaterThan($at, 0), Call($has, Subtract($at, 1), "Noun")), Call($has, Add($at, 1), "Verb")),
                Not(Call($has, Add($at, 1), "Noun"))
              ),
              Return(
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Link",
                    Call($root, Add($at, 1)),
                    $at,
                    Call(Member($api, "call"), "Takes")
                  ),
                  Call(
                    Member($api, "call"),
                    "Link",
                    $at,
                    Call($root, Subtract($at, 1)),
                    Call(Member($api, "call"), "Modifies")
                  )
                )
              ),
              Undefined()
            ),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "ThingAfter",
                    Member(Index($args, 0), "value"),
                    $at
                  ),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Return(
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Link",
                    $at,
                    $thing,
                    Call(Member($api, "call"), "Absorbs")
                  )
                ),
                Call(Member($api, "call"), "List")
              )
            )
          )
        )
      )
    )
  )
)

Concept(Describer(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"old\", \"1999\", \"my\": says something about the thing after it."),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "ThingAfter",
                    Member(Index($args, 0), "value"),
                    $at
                  ),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Return(
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Link",
                    $at,
                    $thing,
                    Call(Member($api, "call"), "Modifies")
                  )
                ),
                Call(Member($api, "call"), "List")
              )
            )
          )
        )
      )
    )
  )
)

// "comedy" in "comedy film": a noun before the thing describes it; the last is the thing.
Concept(Noun(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Comment("\"comedy\" in \"comedy film\": a noun before the thing describes it; the last noun is the thing."),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "ThingAfter",
                    Member(Index($args, 0), "value"),
                    $at
                  ),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($out, List()),
            If(
              And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  $at,
                  $thing,
                  Call(Member($api, "call"), "Modifies")
                )
              ),
              Undefined()
            ),
            Comment("\"a film directed by Paul Weitz\": after a verb already said, a doing right after a thing is"),
            Comment("said about it, and the thing takes it, with whatever that doing was grouped into."),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 3), "value"),
                  Negate(1)
                )
              )
            ),
            Var($earlier, false),
            For(
              Var($i, 0),
              LessThan($i, $at),
              PostIncrement($i),
              If(
                And(
                  Equals(Call($sentence, $i), Call($sentence, $at)),
                  Or(Call($has, $i, "Verb"), Call($has, $i, "Copula"))
                ),
                Assign($earlier, true),
                Undefined()
              )
            ),
            If(
              And($earlier, Call($has, Add($at, 1), "PastTense")),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  Call($root, Add($at, 1)),
                  $at,
                  Call(Member($api, "call"), "Modifies")
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// "by Paul Weitz": takes the thing after it, and belongs to the word before it.
Concept(Preposition(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"by Paul Weitz\": a preposition takes the thing after it, and belongs to the word before it."),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 3), "value"),
                  Negate(1)
                )
              )
            ),
            Bind($out, List()),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "ThingAfter", $prompt, $at),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($taken,
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                Call($root, $thing),
                If(
                  And(
                    LessThan(Add($at, 1), Length(Member($prompt, "args"))),
                    Equals(Call($sentence, Add($at, 1)), Call($sentence, $at))
                  ),
                  Add($at, 1),
                  Negate(1)
                )
              )
            ),
            Comment("\"to call\": before a doing, it is part of how the doing is said."),
            If(
              And(
                And(Call($has, Add($at, 1), "Verb"), Not(Call($has, Add($at, 1), "Noun"))),
                Equals(Call($sentence, Add($at, 1)), Call($sentence, $at))
              ),
              Return(
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Link",
                    $at,
                    Add($at, 1),
                    Call(Member($api, "call"), "Absorbs")
                  )
                )
              ),
              Undefined()
            ),
            Comment("Nothing after it to take: not a preposition here. \"what do i like\" likes."),
            If(
              LessThan($taken, 0),
              Return(
                If(
                  Call($has, $at, "Verb"),
                  Call(
                    Member($api, "evaluate"),
                    Call(
                      Member($api, "call"),
                      "Verb",
                      $prompt,
                      $at,
                      Member(Index($args, 2), "value")
                    ),
                    Call(Member($api, "call"), "Hearing")
                  ),
                  Call(Member($api, "call"), "List")
                )
              ),
              Undefined()
            ),
            If(
              GreaterThan($taken, $at),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  $taken,
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            Comment("\"in 1, 1, 2, 3\": numbers written one after another with commas are all taken."),
            Bind($after,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Call(
                    $String,
                    Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 5), "value")
                  ),
                  ""
                )
              )
            ),
            For(
              Var($j, $taken),
              And(
                And(And(GreaterThan($j, $at), Includes(Call($after, $j), ",")), Call($has, Add($j, 1), "Value")),
                Equals(Call($sentence, Add($j, 1)), Call($sentence, $at))
              ),
              PostIncrement($j),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  Add($j, 1),
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              )
            ),
            Comment("\"tell me about yourself\": after a person, a preposition belongs to the doing before them."),
            Var(
              $owner,
              If(
                GreaterThan($at, 0),
                Call($root, Subtract($at, 1)),
                Negate(1)
              )
            ),
            Comment("Nor does kept text own anything: 'say \"hello world\" to me' says it to me."),
            If(
              And(AtLeast($owner, 0), Or(Call($has, $owner, "Pronoun"), Call($has, $owner, "Verbatim"))),
              For(
                Var($i, Subtract($at, 2)),
                And(AtLeast($i, 0), Equals(Call($sentence, $i), Call($sentence, $at))),
                PostDecrement($i),
                If(
                  And(Call($has, $i, "Verb"), Not(Call($has, $i, "Copula"))),
                  Sequence(Assign($owner, Call($root, $i)), Break()),
                  Undefined()
                )
              ),
              Undefined()
            ),
            If(
              AtLeast($owner, 0),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  $at,
                  $owner,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// "toilet paper and cheese sticks": the words either side are one group.
Concept(Conjunction(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"toilet paper and cheese sticks\": the words either side of \"and\" are one group."),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            If(
              Or(Equals($at, 0), AtLeast(Add($at, 1), Length(Member($prompt, "args")))),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "ThingAfter", $prompt, $at),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($right,
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                $thing,
                Add($at, 1)
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "List",
                Call(
                  Member($api, "call"),
                  "Link",
                  Call($root, Subtract($at, 1)),
                  $at,
                  Call(Member($api, "call"), "Joins")
                ),
                Call(
                  Member($api, "call"),
                  "Link",
                  $right,
                  $at,
                  Call(Member($api, "call"), "Joins")
                )
              )
            )
          )
        )
      )
    )
  )
)

// "napkin is a work in progress": holds what is before it and what is after it.
Concept(Copula(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"napkin is a work in progress\": \"is\" holds what is before it and what is after it."),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($out, List()),
            Comment("\"will be\": after a helper, \"be\" is what the helper carries, not what it is said of."),
            If(
              And(
                And(
                  And(GreaterThan($at, 0), Not(Call($has, Call($root, Subtract($at, 1)), "QuestionWord"))),
                  Not(Call($has, Subtract($at, 1), "Helper"))
                ),
                Not(Call($has, Subtract($at, 1), "Modal"))
              ),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  Call($root, Subtract($at, 1)),
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "ThingAfter", $prompt, $at),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($right,
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                Call($root, $thing),
                If(
                  LessThan(Add($at, 1), Length(Member($prompt, "args"))),
                  Add($at, 1),
                  Negate(1)
                )
              )
            ),
            If(
              GreaterThan($right, $at),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  $right,
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// "i like pie": takes the thing after it, and belongs to the thing before it.
Concept(Verb(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"i like pie\": a doing takes the thing after it, and belongs to the thing before it. After"),
            Comment("a verb already said (\"... is a film directed by\"), a doing is said about the thing before"),
            Comment("it, and that thing takes it (see Noun)."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Comment("\"is\" holds both sides itself (Copula)."),
            If(
              Call($has, $at, "Copula"),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($out, List()),
            Comment("\"write me a function\", \"give me three examples\": whom for, then what, each taken."),
            Bind($sentence,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 3), "value"),
                  Negate(1)
                )
              )
            ),
            Var($from, $at),
            For(
              Var($n, 0),
              And(
                And(LessThan($n, 2), LessThan(Add($from, 1), Length(Member($prompt, "args")))),
                Equals(Call($sentence, Add($from, 1)), Call($sentence, $at))
              ),
              PostIncrement($n),
              Sequence(
                If(
                  And(
                    And(Call($has, Add($from, 1), "Pronoun"), Not(Call($has, Add($from, 1), "Possessive"))),
                    Not(Call($has, Add($from, 1), "QuestionWord"))
                  ),
                  Sequence(
                    Call(
                      Member($out, "push"),
                      Call(
                        Member($api, "call"),
                        "Link",
                        Call($root, Add($from, 1)),
                        $at,
                        Call(Member($api, "call"), "Takes")
                      )
                    ),
                    Assign($from, Add($from, 1)),
                    Continue()
                  ),
                  Undefined()
                ),
                Bind($thing,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Call(Member($api, "call"), "ThingAfter", $prompt, $from),
                      Call(Member($api, "call"), "Hearing")
                    )
                  )
                ),
                If(
                  Or(NotEquals(TypeOf($thing), "number"), AtMost($thing, $from)),
                  Break(),
                  Undefined()
                ),
                Call(
                  Member($out, "push"),
                  Call(
                    Member($api, "call"),
                    "Link",
                    Call($root, $thing),
                    $at,
                    Call(Member($api, "call"), "Takes")
                  )
                ),
                Assign($from, $thing)
              )
            ),
            Comment("\"remind me to call mum\": a doing after \"to\" is what the doing before it is about."),
            If(
              And(GreaterThan($at, 1), Call($has, Subtract($at, 1), "Preposition")),
              For(
                Var($i, Subtract($at, 2)),
                And(AtLeast($i, 0), Equals(Call($sentence, $i), Call($sentence, $at))),
                PostDecrement($i),
                If(
                  And(Call($has, $i, "Verb"), Not(Call($has, $i, "Helper"))),
                  Sequence(
                    Call(
                      Member($out, "push"),
                      Call(
                        Member($api, "call"),
                        "Link",
                        $at,
                        $i,
                        Call(Member($api, "call"), "Takes")
                      )
                    ),
                    Break()
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Var($earlier, false),
            For(
              Var($i, 0),
              LessThan($i, Subtract($at, 1)),
              PostIncrement($i),
              If(
                And(
                  Equals(Call($sentence, $i), Call($sentence, $at)),
                  Or(
                    Or(Or(Call($has, $i, "Verb"), Call($has, $i, "Copula")), Call($has, $i, "Helper")),
                    Call($has, $i, "Modal")
                  )
                ),
                Assign($earlier, true),
                Undefined()
              )
            ),
            If(
              And(GreaterThan($at, 0), Not($earlier)),
              Sequence(
                Bind($subject, Call($root, Subtract($at, 1))),
                If(
                  Or(Call($has, $subject, "Noun"), Call($has, $subject, "Pronoun")),
                  Call(
                    Member($out, "push"),
                    Call(
                      Member($api, "call"),
                      "Link",
                      $at,
                      $subject,
                      Call(Member($api, "call"), "Takes")
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// "what is chess": the question word leads, holding what follows it.
Concept(QuestionWord(), IsA(WordClass()))

Concept(What(), IsA(QuestionWord()))

Concept(Who(), IsA(QuestionWord()))

Concept(When(), IsA(QuestionWord()))

Concept(Where(), IsA(QuestionWord()))

Concept(Why(), IsA(QuestionWord()))

Concept(How(), IsA(QuestionWord()))

Concept(Which(), IsA(QuestionWord()))

Concept(QuestionWord(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"what is chess\", \"who wrote hamlet\": the question word leads, holding what follows it."),
            Comment("It asks last (AskedAbout settles after every other role), so it holds what nothing else took."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 3), "value"),
                  Negate(1)
                )
              )
            ),
            Bind($out, List()),
            Comment("\"what time\", \"which file\": a thing right after the question word is what it asks about."),
            If(
              And(
                And(
                  Or(Call($has, Add($at, 1), "Noun"), Call($has, Add($at, 1), "Adjective")),
                  Not(Call($has, Add($at, 1), "Pronoun"))
                ),
                Equals(Call($sentence, Add($at, 1)), Call($sentence, $at))
              ),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  Add($at, 1),
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            For(
              Var($j, Add($at, 1)),
              And(LessThan($j, Length(Member($prompt, "args"))), Equals(Call($sentence, $j), Call($sentence, $at))),
              PostIncrement($j),
              If(
                And(Not(Call(Member($parent, "has"), $j)), Not(Call($has, $j, "Expression"))),
                Call(
                  Member($out, "push"),
                  Call(
                    Member($api, "call"),
                    "Link",
                    $j,
                    $at,
                    Call(Member($api, "call"), "AskedAbout")
                  )
                ),
                Undefined()
              )
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// "could you close the door", "is chess a sport": a helper first asks.
Concept(Helper(), IsA(WordClass()))

Concept(Helper(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"could you close the door\", \"is chess a sport\", \"what do i like\": a helper first, or"),
            Comment("right after the question word, asks, and holds what it asks about and what is asked of it."),
            Comment("Anywhere else a copula holds both sides (Copula), and other helpers wait for stage 3."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($hearing, Call(Member($api, "call"), "Hearing")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 3), "value"),
                  Negate(1)
                )
              )
            ),
            Comment("First, or right after the question (\"what do\", \"which file did\": the word before is the"),
            Comment("question word, or what the question word asks about)."),
            Bind($asking,
              And(
                GreaterThan($at, 0),
                Or(
                  Call($has, Subtract($at, 1), "QuestionWord"),
                  And(
                    Call(Member($parent, "has"), Subtract($at, 1)),
                    Call(
                      $has,
                      Call(Member($parent, "get"), Subtract($at, 1)),
                      "QuestionWord"
                    )
                  )
                )
              )
            ),
            Bind($starts,
              Or(Or(Equals($at, 0), NotEquals(Call($sentence, Subtract($at, 1)), Call($sentence, $at))), $asking)
            ),
            Comment("Anywhere else a copula holds both sides, and another helper (\"be\" after \"will\") takes"),
            Comment("what follows it, as a doing does."),
            If(
              Not($starts),
              Sequence(
                If(
                  Call($has, $at, "Copula"),
                  Return(
                    Call(
                      Member($api, "evaluate"),
                      Call(
                        Member($api, "call"),
                        "Copula",
                        $prompt,
                        $at,
                        Member(Index($args, 2), "value")
                      ),
                      $hearing
                    )
                  ),
                  Undefined()
                ),
                If(
                  And(
                    GreaterThan($at, 0),
                    Or(Call($has, Subtract($at, 1), "Helper"), Call($has, Subtract($at, 1), "Modal"))
                  ),
                  Return(
                    Call(
                      Member($api, "evaluate"),
                      Call(
                        Member($api, "call"),
                        "Verb",
                        $prompt,
                        $at,
                        Member(Index($args, 2), "value")
                      ),
                      $hearing
                    )
                  ),
                  Undefined()
                ),
                Return(Call(Member($api, "call"), "List"))
              ),
              Undefined()
            ),
            Bind($thingAt,
              Async(
                Lambda(List($i),
                  Sequence(
                    Bind($t,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "call"),
                            "ThingAfter",
                            $prompt,
                            Subtract($i, 1)
                          ),
                          $hearing
                        )
                      )
                    ),
                    Return(
                      If(
                        And(Equals(TypeOf($t), "number"), AtLeast($t, $i)),
                        $t,
                        If(
                          And(
                            LessThan($i, Length(Member($prompt, "args"))),
                            Equals(Call($sentence, $i), Call($sentence, $at))
                          ),
                          $i,
                          Negate(1)
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($could,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(
                        And(Call($isCall, $w), Index(Member($w, "args"), 4)),
                        Call($isCall, Member(Index(Member($w, "args"), 4), "value"))
                      ),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 4), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($out, List()),
            Comment("\"what will be the date\": a doing right after the helper is what it carries, and does the rest."),
            If(
              And(
                And(
                  And(Call($has, Add($at, 1), "Verb"), Not(Call($has, Add($at, 1), "Noun"))),
                  Not(Call($has, Add($at, 1), "Pronoun"))
                ),
                Equals(Call($sentence, Add($at, 1)), Call($sentence, $at))
              ),
              Return(
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Link",
                    Add($at, 1),
                    $at,
                    Call(Member($api, "call"), "Takes")
                  )
                )
              ),
              Undefined()
            ),
            Var($subject, Await(Call($thingAt, Add($at, 1)))),
            If(
              LessThan($subject, 0),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Comment("A helper that is not a copula carries a doing (\"did hamlet kill\"): with no verb after the"),
            Comment("subject, the subject's last word is the doing when it could be one, whatever the tagger"),
            Comment("made of it in this sentence."),
            Var($carried, Negate(1)),
            If(
              And(
                And(Not(Call($has, $at, "Copula")), GreaterThan($subject, Add($at, 1))),
                Call($could, $subject, "Verb")
              ),
              Sequence(
                Var($verbAfter, false),
                For(
                  Var($j, Add($subject, 1)),
                  And(LessThan($j, Length(Member($prompt, "args"))), Equals(Call($sentence, $j), Call($sentence, $at))),
                  PostIncrement($j),
                  If(
                    Call($has, $j, "Verb"),
                    Assign($verbAfter, true),
                    Undefined()
                  )
                ),
                If(
                  Not($verbAfter),
                  Sequence(Assign($carried, $subject), Assign($subject, Subtract($subject, 1))),
                  Undefined()
                )
              ),
              Undefined()
            ),
            If(
              GreaterThan($carried, 0),
              Sequence(
                Call(
                  Member($out, "push"),
                  Call(
                    Member($api, "call"),
                    "Link",
                    Call($root, $subject),
                    $at,
                    Call(Member($api, "call"), "Takes")
                  )
                ),
                Call(
                  Member($out, "push"),
                  Call(
                    Member($api, "call"),
                    "Link",
                    $carried,
                    $at,
                    Call(Member($api, "call"), "Takes")
                  )
                ),
                Return(Call(Member($api, "call"), "List", Spread($out)))
              ),
              Undefined()
            ),
            Call(
              Member($out, "push"),
              Call(
                Member($api, "call"),
                "Link",
                Call($root, $subject),
                $at,
                Call(Member($api, "call"), "Takes")
              )
            ),
            Comment("What is asked of it: the doing or the thing after the subject's phrase."),
            Bind($next, Add($subject, 1)),
            Comment("A preposition after the subject belongs to it (\"the capital of france\"), not to the question."),
            Comment("\"is not a mammal\": \"not\" holds what it denies itself."),
            If(
              Call($has, $subject, "Negative"),
              Return(Call(Member($api, "call"), "List", Spread($out))),
              Undefined()
            ),
            Bind($takes,
              And(
                And(Call($has, $next, "Preposition"), LessThan(Add($next, 1), Length(Member($prompt, "args")))),
                Equals(Call($sentence, Add($next, 1)), Call($sentence, $at))
              )
            ),
            If(
              And(
                And(
                  LessThan($next, Length(Member($prompt, "args"))),
                  Equals(Call($sentence, $next), Call($sentence, $at))
                ),
                Not($takes)
              ),
              Sequence(
                Bind($asked,
                  If(
                    Call($has, $next, "Verb"),
                    $next,
                    Await(Call($thingAt, $next))
                  )
                ),
                If(
                  GreaterThan($asked, $subject),
                  Call(
                    Member($out, "push"),
                    Call(
                      Member($api, "call"),
                      "Link",
                      Call($root, $asked),
                      $at,
                      Call(Member($api, "call"), "Takes")
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// "not a mammal": "not" holds what it denies.
