Concept(A(), IsA(Determiner()))

Concept(An(), IsA(Determiner()))

Concept(This(), IsA(Determiner()))

Concept(That(), IsA(Determiner()))

Concept(These(), IsA(Determiner()))

Concept(Those(), IsA(Determiner()))

Concept(Some(), IsA(Determiner()))

Concept(Any(), IsA(Determiner()))

Concept(Every(), IsA(Determiner()))

Concept(Each(), IsA(Determiner()))

// "5 plus 2", "17 times 4": an operator takes the things either side of it.
Concept(Operator(), IsA(WordClass()))

Concept(Operand(), IsA(LinkRole()))

Concept(Plus(), IsA(Operator()))

Concept(Minus(), IsA(Operator()))

Concept(Times(), IsA(Operator()))

Concept(Divided(), IsA(Operator()), HeardAs(Over()))

Concept(Operator(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"5 plus 2\": an operator takes the things either side of it."),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($sentence,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 3), "value"),
                  Negate(1)
                )
              )
            ),
            If(
              Or(
                Or(
                  Or(Equals($at, 0), AtLeast(Add($at, 1), Length(Member($prompt, "args")))),
                  NotEquals(Call($sentence, Subtract($at, 1)), Call($sentence, $at))
                ),
                NotEquals(Call($sentence, Add($at, 1)), Call($sentence, $at))
              ),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "ThingAfter", $prompt, $at),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($right,
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                $thing,
                Add($at, 1)
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "List",
                Call(
                  Member($api, "call"),
                  "Link",
                  Call($root, Subtract($at, 1)),
                  $at,
                  Call(Member($api, "call"), "Operand")
                ),
                Call(
                  Member($api, "call"),
                  "Link",
                  Call($root, $right),
                  $at,
                  Call(Member($api, "call"), "Operand")
                )
              )
            )
          )
        )
      )
    )
  )
)

