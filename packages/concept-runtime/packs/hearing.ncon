Requires(Basic())

// ================================================================
// Hearing: the words of a message finding their relations to each other
// (design/prompt-hearing.md). A word hears as its own Concept, then as what it is (its
// kind, its word class, the tagger's tags), then as the universal parent. What each hears is
// a proposal of links to other words, settled in rounds until nothing changes.

// Under Hearing(), a word hears, and nothing it does elsewhere runs: "add" must not add.
Concept(Hearing(), IsA(ContextFacet()), Exclusive())

// A message as its words, in order, each as typed with what it is known or tagged to be.
Concept(Prompt(), IsA(Data()))

Concept(Word(), IsA(Data()))

// What hearing writes out: one Concept expression per part of the message that stands alone.
Concept(Phrases(), IsA(Data()))

// A relation one word proposes to another, by position: Link(from, to, role).
Concept(Link(), IsA(Data()))

Concept(LinkRole(), IsA(Category()))

// "teen" modifies "film": the thing is the head.
Concept(Modifies(), IsA(LinkRole()))

// "by" takes "weitz"; "co-produced" takes "by".
Concept(Takes(), IsA(LinkRole()))

// "and" groups the words either side of it.
Concept(Joins(), IsA(LinkRole()))

// "the" is part of how "car" is said, and adds nothing to run.
Concept(Absorbs(), IsA(LinkRole()))

// "?", "not", "maybe": asked, negated, blurred.
Concept(Marks(), IsA(LinkRole()))

// "too", "also": one more of something said before.
Concept(Adds(), IsA(LinkRole()))

// "it", "that bug": something said before, or known.
Concept(PointsAt(), IsA(LinkRole()))

// Every word hears, known or not. A word with no hearing of its own hears as its tags do:
// "americanpie", tagged Noun, hears as a noun (design/prompt-hearing.md, 2.5).
Concept(Concept(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($self, Call(Member($bindings, "get"), "word")),
            If(
              Or(Not(Call($isCall, $self)), LessThan(Length(Member($self, "args")), 3)),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($prompt, Member(Index(Member($self, "args"), 0), "value")),
            Bind($at, Member(Index(Member($self, "args"), 1), "value")),
            Bind($word,
              If(
                Index(Member($prompt, "args"), $at),
                Member(Index(Member($prompt, "args"), $at), "value"),
                Undefined()
              )
            ),
            If(
              Not(Call($isCall, $word)),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($text, Call($String, Member(Index(Member($word, "args"), 0), "value"))),
            Bind($name,
              Call(
                Member(
                  Map(
                    Filter(
                      Call(Member($text, "split"), Regex("[^A-Za-z0-9]+", "")),
                      Lambda(List($p), GreaterThan(Length($p), 0))
                    ),
                    Lambda(List($p),
                      Add(
                        Call(Member(Index($p, 0), "toUpperCase")),
                        Call(Member(Call(Member($p, "slice"), 1), "toLowerCase"))
                      )
                    )
                  ),
                  "join"
                ),
                ""
              )
            ),
            If(
              NotEquals(Member($self, "head"), $name),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($tags, Member(Index(Member($word, "args"), 2), "value")),
            Bind($out, List()),
            ForOf(
              $t,
              If(Call($isCall, $tags), Member($tags, "args"), List()),
              Sequence(
                If(
                  Not(Call($isCall, Member($t, "value"))),
                  Continue(),
                  Undefined()
                ),
                Bind($proposed,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Call(
                        Member($api, "call"),
                        Member(Member($t, "value"), "head"),
                        $prompt,
                        $at,
                        Member(Index(Member($self, "args"), 2), "value")
                      ),
                      Call(Member($api, "call"), "Hearing")
                    )
                  )
                ),
                If(
                  And(Call($isCall, $proposed), Equals(Member($proposed, "head"), "List")),
                  ForOf(
                    $p,
                    Member($proposed, "args"),
                    Call(Member($out, "push"), Member($p, "value"))
                  ),
                  Undefined()
                )
              )
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// What a word is, as the tagger proposes it or the graph knows it, with hearing of its own.
Concept(Determiner(), IsA(WordClass()))

Concept(Value(), IsA(WordClass()))

Concept(Pronoun(), IsA(WordClass()))

Concept(Preposition(), IsA(WordClass()))

Concept(Conjunction(), IsA(WordClass()))

Concept(Copula(), IsA(WordClass()))

// A word that says something about the thing after it: "old", "1999", "my".
Concept(Describer(), IsA(Category()))

Concept(Adjective(), IsA(Describer()))

Concept(Value(), IsA(Describer()))

Concept(Possessive(), IsA(Describer()))

// The closed classes, known by the graph whatever the tagger guesses in context: "in" in
// "work in progress" is a preposition, though the tagger calls it a noun there.
Concept(In(), IsA(Preposition()))

Concept(On(), IsA(Preposition()))

Concept(At(), IsA(Preposition()))

Concept(For(), IsA(Preposition()))

Concept(To(), IsA(Preposition()))

Concept(Of(), IsA(Preposition()))

Concept(With(), IsA(Preposition()))

Concept(About(), IsA(Preposition()))

Concept(From(), IsA(Preposition()))

Concept(By(), IsA(Preposition()))

Concept(Into(), IsA(Preposition()))

Concept(Onto(), IsA(Preposition()))

Concept(Over(), IsA(Preposition()))

Concept(Under(), IsA(Preposition()))

Concept(After(), IsA(Preposition()))

Concept(Before(), IsA(Preposition()))

Concept(Until(), IsA(Preposition()))

Concept(Near(), IsA(Preposition()))

Concept(As(), IsA(Preposition()))

Concept(Like(), IsA(Preposition()))

Concept(Per(), IsA(Preposition()))

Concept(Without(), IsA(Preposition()))

Concept(Through(), IsA(Preposition()))

Concept(During(), IsA(Preposition()))

Concept(Above(), IsA(Preposition()))

Concept(Across(), IsA(Preposition()))

Concept(Against(), IsA(Preposition()))

Concept(Along(), IsA(Preposition()))

Concept(Alongside(), IsA(Preposition()))

Concept(Amid(), IsA(Preposition()))

Concept(Among(), IsA(Preposition()))

Concept(Around(), IsA(Preposition()))

Concept(Atop(), IsA(Preposition()))

Concept(Behind(), IsA(Preposition()))

Concept(Below(), IsA(Preposition()))

Concept(Beneath(), IsA(Preposition()))

Concept(Beside(), IsA(Preposition()))

Concept(Besides(), IsA(Preposition()))

Concept(Between(), IsA(Preposition()))

Concept(Beyond(), IsA(Preposition()))

Concept(Despite(), IsA(Preposition()))

Concept(Except(), IsA(Preposition()))

Concept(Inside(), IsA(Preposition()))

Concept(Outside(), IsA(Preposition()))

Concept(Past(), IsA(Preposition()))

Concept(Throughout(), IsA(Preposition()))

Concept(Toward(), IsA(Preposition()))

Concept(Towards(), IsA(Preposition()))

Concept(Underneath(), IsA(Preposition()))

Concept(Unlike(), IsA(Preposition()))

Concept(Upon(), IsA(Preposition()))

Concept(Via(), IsA(Preposition()))

Concept(Within(), IsA(Preposition()))

Concept(Versus(), IsA(Preposition()))

Concept(And(), IsA(Conjunction()))

Concept(Or(), IsA(Conjunction()))

Concept(But(), IsA(Conjunction()))

// The thing a phrase starting after a word is about: the last noun of what follows.
Concept(ThingAfter(),
  Realization(ThingAfter($prompt, $at),
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($inPhrase,
              Lambda(List($i),
                And(
                  Call(
                    Member(
                      List(
                        "Determiner",
                        "Adjective",
                        "Value",
                        "Possessive",
                        "Noun"
                      ),
                      "some"
                    ),
                    Lambda(List($t), Call($has, $i, $t))
                  ),
                  Not(
                    Call(
                      Member(List("Pronoun", "Preposition", "Conjunction", "Copula"), "some"),
                      Lambda(List($t), Call($has, $i, $t))
                    )
                  )
                )
              )
            ),
            Var($thing, Negate(1)),
            For(
              Var($j, Add($at, 1)),
              And(LessThan($j, Length(Member($prompt, "args"))), Call($inPhrase, $j)),
              PostIncrement($j),
              If(Call($has, $j, "Noun"), Assign($thing, $j), Undefined())
            ),
            Return($thing)
          )
        )
      )
    )
  )
)

// "the", "a": part of how the next thing is said.
Concept(Determiner(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($at, Member(Index($args, 1), "value")),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "ThingAfter",
                    Member(Index($args, 0), "value"),
                    $at
                  ),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Return(
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Link",
                    $at,
                    $thing,
                    Call(Member($api, "call"), "Absorbs")
                  )
                ),
                Call(Member($api, "call"), "List")
              )
            )
          )
        )
      )
    )
  )
)

Concept(Describer(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($at, Member(Index($args, 1), "value")),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "ThingAfter",
                    Member(Index($args, 0), "value"),
                    $at
                  ),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Return(
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Link",
                    $at,
                    $thing,
                    Call(Member($api, "call"), "Modifies")
                  )
                ),
                Call(Member($api, "call"), "List")
              )
            )
          )
        )
      )
    )
  )
)

// "comedy" in "comedy film": a noun before the thing describes it; the last is the thing.
Concept(Noun(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "ThingAfter",
                    Member(Index($args, 0), "value"),
                    $at
                  ),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($out, List()),
            If(
              And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  $at,
                  $thing,
                  Call(Member($api, "call"), "Modifies")
                )
              ),
              Undefined()
            ),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Var($earlier, false),
            For(
              Var($i, 0),
              LessThan($i, $at),
              PostIncrement($i),
              If(
                Or(Call($has, $i, "Verb"), Call($has, $i, "Copula")),
                Assign($earlier, true),
                Undefined()
              )
            ),
            If(
              And($earlier, Call($has, Add($at, 1), "PastTense")),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  Call($root, Add($at, 1)),
                  $at,
                  Call(Member($api, "call"), "Modifies")
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// "by Paul Weitz": takes the thing after it, and belongs to the word before it.
Concept(Preposition(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($out, List()),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "ThingAfter", $prompt, $at),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($taken,
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                Call($root, $thing),
                If(
                  LessThan(Add($at, 1), Length(Member($prompt, "args"))),
                  Add($at, 1),
                  Negate(1)
                )
              )
            ),
            If(
              GreaterThan($taken, $at),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  $taken,
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            If(
              GreaterThan($at, 0),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  $at,
                  Call($root, Subtract($at, 1)),
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// "toilet paper and cheese sticks": the words either side are one group.
Concept(Conjunction(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            If(
              Or(Equals($at, 0), AtLeast(Add($at, 1), Length(Member($prompt, "args")))),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "ThingAfter", $prompt, $at),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($right,
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                $thing,
                Add($at, 1)
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "List",
                Call(
                  Member($api, "call"),
                  "Link",
                  Call($root, Subtract($at, 1)),
                  $at,
                  Call(Member($api, "call"), "Joins")
                ),
                Call(
                  Member($api, "call"),
                  "Link",
                  $right,
                  $at,
                  Call(Member($api, "call"), "Joins")
                )
              )
            )
          )
        )
      )
    )
  )
)

// "napkin is a work in progress": holds what is before it and what is after it.
Concept(Copula(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($out, List()),
            If(
              GreaterThan($at, 0),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  Call($root, Subtract($at, 1)),
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "ThingAfter", $prompt, $at),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($right,
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                Call($root, $thing),
                If(
                  LessThan(Add($at, 1), Length(Member($prompt, "args"))),
                  Add($at, 1),
                  Negate(1)
                )
              )
            ),
            If(
              GreaterThan($right, $at),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  $right,
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// "i like pie": takes the thing after it, and belongs to the thing before it.
Concept(Verb(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            If(
              Call($has, $at, "Copula"),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($out, List()),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "ThingAfter", $prompt, $at),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($object,
              If(
                And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                Call($root, $thing),
                If(
                  Call($has, Add($at, 1), "Pronoun"),
                  Add($at, 1),
                  Negate(1)
                )
              )
            ),
            If(
              GreaterThan($object, $at),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  $object,
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            Var($earlier, false),
            For(
              Var($i, 0),
              LessThan($i, Subtract($at, 1)),
              PostIncrement($i),
              If(
                Or(Call($has, $i, "Verb"), Call($has, $i, "Copula")),
                Assign($earlier, true),
                Undefined()
              )
            ),
            If(
              And(GreaterThan($at, 0), Not($earlier)),
              Sequence(
                Bind($subject, Call($root, Subtract($at, 1))),
                If(
                  Or(Call($has, $subject, "Noun"), Call($has, $subject, "Pronoun")),
                  Call(
                    Member($out, "push"),
                    Call(
                      Member($api, "call"),
                      "Link",
                      $at,
                      $subject,
                      Call(Member($api, "call"), "Takes")
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// A message heard: its words, the rounds in which they propose links until nothing changes,
// and each word written as its Concept with the words linked to it as arguments.
Concept(Hear(),
  Realization(Hear($text),
    context = Execution(),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($text, Call(Member($api, "toHost"), Member(Index($args, 0), "value"))),
            Bind($said, Call(Member($api, "words"), Call($String, $text))),
            Bind($name,
              Lambda(List($t),
                Call(
                  Member(
                    Map(
                      Filter(
                        Call(Member($t, "split"), Regex("[^A-Za-z0-9]+", "")),
                        Lambda(List($p), GreaterThan(Length($p), 0))
                      ),
                      Lambda(List($p),
                        Add(
                          Call(Member(Index($p, 0), "toUpperCase")),
                          Call(Member(Call(Member($p, "slice"), 1), "toLowerCase"))
                        )
                      )
                    ),
                    "join"
                  ),
                  ""
                )
              )
            ),
            Bind($classOf,
              Lambda(List($w),
                Sequence(
                  Bind($kinds, List()),
                  Bind($unit, Call(Member(Member($api, "store"), "get"), Call($name, $w))),
                  ForOf(
                    $r,
                    If($unit, Member($unit, "relations"), List()),
                    Sequence(
                      Bind($k,
                        If(
                          And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), "IsA")),
                          Member(Index(Member(Member($r, "claim"), "args"), 0), "value"),
                          Undefined()
                        )
                      ),
                      If(Not(Call($isCall, $k)), Continue(), Undefined()),
                      Bind($kind, Call(Member(Member($api, "store"), "get"), Member($k, "head"))),
                      Bind($isClass,
                        If(
                          $kind,
                          Call(
                            Member(Member($kind, "relations"), "some"),
                            Lambda(List($x),
                              And(
                                And(
                                  And(
                                    Call($isCall, Member($x, "claim")),
                                    Equals(Member(Member($x, "claim"), "head"), "IsA")
                                  ),
                                  Call($isCall, Member(Index(Member(Member($x, "claim"), "args"), 0), "value"))
                                ),
                                Equals(
                                  Member(Member(Index(Member(Member($x, "claim"), "args"), 0), "value"), "head"),
                                  "WordClass"
                                )
                              )
                            )
                          ),
                          false
                        )
                      ),
                      If(
                        $isClass,
                        Call(Member($kinds, "push"), Member($k, "head")),
                        Undefined()
                      )
                    )
                  ),
                  Return($kinds)
                )
              )
            ),
            Bind($words, List()),
            For(
              Var($i, 0),
              LessThan($i, Length($said)),
              PostIncrement($i),
              Sequence(
                Bind($known, Call($classOf, Member(Index($said, $i), "text"))),
                Bind($tags, If(Length($known), $known, Member(Index($said, $i), "tags"))),
                Assign(Member(Index($said, $i), "tags"), $tags),
                Call(
                  Member($words, "push"),
                  Call(
                    Member($api, "call"),
                    "Word",
                    Member(Index($said, $i), "text"),
                    $i,
                    Call(
                      Member($api, "call"),
                      "List",
                      Spread(Map($tags, Lambda(List($t), Call(Member($api, "call"), $t))))
                    )
                  )
                )
              )
            ),
            Bind($prompt, Call(Member($api, "call"), "Prompt", Spread($words))),
            Bind($hearing, Call(Member($api, "call"), "Hearing")),
            Var($links, List()),
            Bind($linked,
              Lambda(List(),
                Call(
                  Member($api, "call"),
                  "List",
                  Spread(
                    Map(
                      $links,
                      Lambda(List($l),
                        Call(
                          Member($api, "call"),
                          "Link",
                          Member($l, "from"),
                          Member($l, "to"),
                          Call(Member($api, "call"), Member($l, "role"))
                        )
                      )
                    )
                  )
                )
              )
            ),
            For(
              Var($round, 0),
              LessThan($round, Add(Length($said), 2)),
              PostIncrement($round),
              Sequence(
                Bind($placed, New($Set, Map($links, Lambda(List($l), Member($l, "from"))))),
                Bind($proposals, List()),
                For(
                  Var($i, 0),
                  LessThan($i, Length($said)),
                  PostIncrement($i),
                  Sequence(
                    Bind($head, Call($name, Member(Index($said, $i), "text"))),
                    Bind($asked,
                      If(
                        Call(Member(Regex("^[A-Za-z]", ""), "test"), $head),
                        List($head),
                        Member(Index($said, $i), "tags")
                      )
                    ),
                    Bind($heard, List()),
                    ForOf(
                      $h,
                      $asked,
                      Sequence(
                        Bind($proposed,
                          Await(
                            Call(
                              Member($api, "evaluate"),
                              Call(Member($api, "call"), $h, $prompt, $i, Call($linked)),
                              $hearing
                            )
                          )
                        ),
                        If(
                          And(Call($isCall, $proposed), Equals(Member($proposed, "head"), "List")),
                          ForOf(
                            $a,
                            Member($proposed, "args"),
                            Call(Member($heard, "push"), $a)
                          ),
                          Undefined()
                        )
                      )
                    ),
                    ForOf(
                      $a,
                      $heard,
                      Sequence(
                        Bind($p, Member($a, "value")),
                        If(
                          Or(
                            Or(Not(Call($isCall, $p)), NotEquals(Member($p, "head"), "Link")),
                            LessThan(Length(Member($p, "args")), 3)
                          ),
                          Continue(),
                          Undefined()
                        ),
                        Bind($role, Member(Index(Member($p, "args"), 2), "value")),
                        Call(
                          Member($proposals, "push"),
                          Object(
                            from = Member(Index(Member($p, "args"), 0), "value"),
                            to = Member(Index(Member($p, "args"), 1), "value"),
                            role = If(
                              Call($isCall, $role),
                              Member($role, "head"),
                              Call($String, $role)
                            )
                          )
                        )
                      )
                    )
                  )
                ),
                Bind($rank, Object(Joins = 0, Absorbs = 1, Takes = 2, Modifies = 3)),
                Call(
                  Member($proposals, "sort"),
                  Lambda(List($a, $b),
                    Subtract(
                      Otherwise(Index($rank, Member($a, "role")), 4),
                      Otherwise(Index($rank, Member($b, "role")), 4)
                    )
                  )
                ),
                Bind($accepted, List()),
                Bind($taken, New($Set, $placed)),
                Bind($up, New($Map, Map($links, Lambda(List($l), List(Member($l, "from"), Member($l, "to")))))),
                Bind($above,
                  Lambda(List($i, $j),
                    Sequence(
                      For(
                        Sequence(Var($k, $i), Var($n, 0)),
                        And(NotEquals($k, Undefined()), LessThan($n, 256)),
                        Sequence(Assign($k, Call(Member($up, "get"), $k)), PostIncrement($n)),
                        If(Equals($k, $j), Return(true), Undefined())
                      ),
                      Return(false)
                    )
                  )
                ),
                ForOf(
                  $p,
                  $proposals,
                  Sequence(
                    If(
                      Or(
                        Or(
                          Call(Member($taken, "has"), Member($p, "from")),
                          Equals(Member($p, "from"), Member($p, "to"))
                        ),
                        Call($above, Member($p, "to"), Member($p, "from"))
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Call(Member($accepted, "push"), $p),
                    Call(Member($taken, "add"), Member($p, "from")),
                    Call(
                      Member($up, "set"),
                      Member($p, "from"),
                      Member($p, "to")
                    )
                  )
                ),
                If(Equals(Length($accepted), 0), Break(), Undefined()),
                Assign($links, Call(Member($links, "concat"), $accepted))
              )
            ),
            Bind($parentOf, New($Map, Map($links, Lambda(List($l), List(Member($l, "from"), $l))))),
            Bind($build,
              Lambda(List($i),
                Sequence(
                  Bind($kids, List()),
                  For(
                    Var($j, 0),
                    LessThan($j, Length($said)),
                    PostIncrement($j),
                    Sequence(
                      Bind($l, Call(Member($parentOf, "get"), $j)),
                      If(
                        And(
                          And(NotEquals($l, Undefined()), Equals(Member($l, "to"), $i)),
                          NotEquals(Member($l, "role"), "Absorbs")
                        ),
                        Call(Member($kids, "push"), Call($build, $j)),
                        Undefined()
                      )
                    )
                  ),
                  Bind($t, Member(Index($said, $i), "text")),
                  If(
                    And(Call(Member(Regex("^[0-9]+([.][0-9]+)?$", ""), "test"), $t), Equals(Length($kids), 0)),
                    Return(Call($Number, $t)),
                    Undefined()
                  ),
                  Return(
                    Call(
                      Member($api, "call"),
                      Or(Call($name, $t), $t),
                      Spread($kids)
                    )
                  )
                )
              )
            ),
            Bind($roots, List()),
            For(
              Var($i, 0),
              LessThan($i, Length($said)),
              PostIncrement($i),
              If(
                Not(Call(Member($parentOf, "has"), $i)),
                Call(Member($roots, "push"), Call($build, $i)),
                Undefined()
              )
            ),
            Return(Call(Member($api, "call"), "Phrases", Spread($roots)))
          )
        )
      )
    )
  )
)
