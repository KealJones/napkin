// Hesitation, said beside what is meant and set aside: "so like uh". Between two words of one
// kind, it takes the first back ("by 3, er, 4pm").
Concept(Filler(), IsA(WordClass()))

Concept(Filler(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Comment("\"by 3, er, 4pm\": a hesitation between two words of one kind, the first ending in a comma,"),
            Comment("takes the first back: the second corrects it."),
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($word,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member($prompt, "args"), $i), "value"),
                  Undefined()
                )
              )
            ),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w, Call($word, $i)),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($before, Subtract($at, 1)),
            Bind($after, Add($at, 1)),
            If(
              Or(
                Or(LessThan($before, 0), Not(Call($word, $after))),
                Not(Includes(Call($String, Member(Index(Member(Call($word, $before), "args"), 5), "value")), ","))
              ),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($same,
              Or(
                Call(
                  Member(List("Value", "Noun", "Verb", "Adjective"), "some"),
                  Lambda(List($t), And(Call($has, $before, $t), Call($has, $after, $t)))
                ),
                And(Call($has, $before, "Value"), Call($has, $after, "Time"))
              )
            ),
            Return(
              If(
                $same,
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Link",
                    $before,
                    $after,
                    Call(Member($api, "call"), "Corrects")
                  )
                ),
                Call(Member($api, "call"), "List")
              )
            )
          )
        )
      )
    )
  )
)

// "by 3, er, 4pm": the second corrects the first.
Concept(Corrects(), IsA(LinkRole()))

