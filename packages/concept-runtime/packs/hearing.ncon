                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 3), "value"),
                  Negate(1)
                )
              )
            ),
            If(
              Or(
                AtLeast(Add($at, 1), Length(Member($prompt, "args"))),
                NotEquals(Call($sentence, Add($at, 1)), Call($sentence, $at))
              ),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "ThingAfter", $prompt, $at),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($denied,
              If(
                Call($has, Add($at, 1), "Verb"),
                Add($at, 1),
                If(
                  And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                  $thing,
                  Add($at, 1)
                )
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "List",
                Call(
                  Member($api, "call"),
                  "Link",
                  Call($root, $denied),
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              )
            )
          )
        )
      )
    )
  )
)

// "please add 2 and 2": asked politely, around what it asks.
