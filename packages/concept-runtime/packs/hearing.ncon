// A message heard: its words, the rounds in which they propose links until nothing changes,
// and each word written as its Concept with the words linked to it as arguments.
Concept(Hear(),
  Realization(Hear(Rest($text)),
    context = Execution(),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($text, Call(Member($api, "toHost"), Member(Index($args, 0), "value"))),
            Comment("Hear(text, \"rules\"): written in the rules parser's conventions, which the graph's"),
            Comment("behaviour was built on, while that parser is the reference (design/prompt-hearing.md 4)."),
            Bind($asRules,
              And(
                GreaterThan(Length($args), 1),
                Equals(Call(Member($api, "toHost"), Member(Index($args, 1), "value")), "rules")
              )
            ),
            Comment("Code, links and quotes are kept as typed, each one thing: \"fix `foo()`\" fixes InlineCode."),
            Bind($kept,
              Await(
                Call(
                  Member($api, "verbatim"),
                  Call(
                    Member(Call($String, $text), "replace"),
                    Regex("(\\d)%", "g"),
                    "$1 percent"
                  )
                )
              )
            ),
            Comment("Numbers listed (\"2, 4 and 9\", \"3, 4, 5\") are one thing, a List, as code is one thing."),
            Assign(
              Member($kept, "text"),
              Call(
                Member(Member($kept, "text"), "replace"),
                Regex(
                  "(-?\\d+(?:\\.\\d+)?)((?:\\s*,\\s*-?\\d+(?:\\.\\d+)?)+)(?:\\s*,?\\s+(and|or)\\s+(-?\\d+(?:\\.\\d+)?))?",
                  "g"
                ),
                Lambda(List($m, $first, $more, $joined, $last),
                  Sequence(
                    Bind($items,
                      Concat(
                        List($first),
                        Filter(
                          Map(Call(Member($more, "split"), ","), Lambda(List($x), Call(Member($x, "trim")))),
                          Lambda(List($x), GreaterThan(Length($x), 0))
                        ),
                        If($last, List($last), List())
                      )
                    ),
                    If(
                      And(LessThan(Length($items), 3), Not($last)),
                      Return($m),
                      Undefined()
                    ),
                    Call(
                      Member(Member($kept, "spans"), "push"),
                      Call(
                        Member($api, "call"),
                        "List",
                        Spread(Map($items, $Number))
                      )
                    ),
                    Return(Add(Add(" verbatim", Subtract(Length(Member($kept, "spans")), 1)), " "))
                  )
                )
              )
            ),
            Bind($said, Call(Member($api, "words"), Member($kept, "text"))),
            ForOf(
              $w,
              $said,
              If(
                Call(Member(Regex("^verbatim[0-9]+$", ""), "test"), Member($w, "text")),
                Assign(Member($w, "tags"), List("Noun", "Verbatim")),
                Undefined()
              )
            ),
            Comment("\"milk, eggs, parmesan cheese\": a comma between things joins them, as \"and\" does."),
            Bind($thing,
