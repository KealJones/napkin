            If(
              Or(
                AtLeast(Add($at, 1), Length(Member($prompt, "args"))),
                NotEquals(Call($sentence, Add($at, 1)), Call($sentence, $at))
              ),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($thing,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "ThingAfter", $prompt, $at),
                  Call(Member($api, "call"), "Hearing")
                )
              )
            ),
            Bind($denied,
              If(
                Call($has, Add($at, 1), "Verb"),
                Add($at, 1),
                If(
                  And(Equals(TypeOf($thing), "number"), GreaterThan($thing, $at)),
                  $thing,
                  Add($at, 1)
                )
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "List",
                Call(
                  Member($api, "call"),
                  "Link",
                  Call($root, $denied),
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              )
            )
          )
        )
      )
    )
  )
)

// "please add 2 and 2": asked politely, around what it asks.
Concept(Please(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($sentence,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 3), "value"),
                  Negate(1)
                )
              )
            ),
            Bind($asked,
              If(
                And(
                  LessThan(Add($at, 1), Length(Member($prompt, "args"))),
                  Equals(Call($sentence, Add($at, 1)), Call($sentence, $at))
                ),
                Add($at, 1),
                If(
                  And(GreaterThan($at, 0), Equals(Call($sentence, Subtract($at, 1)), Call($sentence, $at))),
                  Subtract($at, 1),
                  Negate(1)
                )
              )
            ),
            Return(
              If(
                LessThan($asked, 0),
                Call(Member($api, "call"), "List"),
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Link",
                    Call($root, $asked),
                    $at,
                    Call(Member($api, "call"), "Takes")
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

// Hesitation, said beside what is meant and set aside: "so like uh". Between two words of one
// kind, it takes the first back ("by 3, er, 4pm").
Concept(Filler(), IsA(WordClass()))

Concept(Filler(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($word,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member($prompt, "args"), $i), "value"),
                  Undefined()
                )
              )
            ),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w, Call($word, $i)),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($before, Subtract($at, 1)),
            Bind($after, Add($at, 1)),
            If(
              Or(
                Or(LessThan($before, 0), Not(Call($word, $after))),
                Not(Includes(Call($String, Member(Index(Member(Call($word, $before), "args"), 5), "value")), ","))
              ),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Bind($same,
              Or(
                Call(
                  Member(List("Value", "Noun", "Verb", "Adjective"), "some"),
                  Lambda(List($t), And(Call($has, $before, $t), Call($has, $after, $t)))
                ),
                And(Call($has, $before, "Value"), Call($has, $after, "Time"))
              )
            ),
            Return(
              If(
                $same,
                Call(
                  Member($api, "call"),
                  "List",
                  Call(
                    Member($api, "call"),
                    "Link",
                    $before,
                    $after,
                    Call(Member($api, "call"), "Corrects")
                  )
                ),
                Call(Member($api, "call"), "List")
              )
            )
          )
        )
      )
    )
  )
)

// "by 3, er, 4pm": the second corrects the first.
Concept(Corrects(), IsA(LinkRole()))

// Words that point at something said before or known: written out as a Ref for memory.
Concept(Pointing(), IsA(WordClass()))

Concept(It(), IsA(Pointing()))

Concept(This(), IsA(Pointing()))

Concept(That(), IsA(Pointing()))

Concept(These(), IsA(Pointing()))

Concept(Those(), IsA(Pointing()))

Concept(Them(), IsA(Pointing()))

// How a word is written out, where the graph names it otherwise: "i" is Me.
Concept(HeardAs(), IsA(Relation()))

Concept(I(), IsA(Pronoun()), HeardAs(Me()))

Concept(Me(), IsA(Pronoun()))

Concept(Us(), IsA(Pronoun()), HeardAs(We()))

Concept(Uh(), IsA(Filler()))

Concept(Um(), IsA(Filler()))

Concept(Er(), IsA(Filler()))

Concept(Erm(), IsA(Filler()))

Concept(Uhm(), IsA(Filler()))

Concept(Uhh(), IsA(Filler()))

Concept(Umm(), IsA(Filler()))

Concept(Hmm(), IsA(Filler()))

Concept(Ah(), IsA(Filler()))

// Determiners, known whatever the tagger guesses ("the" is a noun in "what's the average").
Concept(The(), IsA(Determiner()))

Concept(A(), IsA(Determiner()))

Concept(An(), IsA(Determiner()))

Concept(This(), IsA(Determiner()))

Concept(That(), IsA(Determiner()))

Concept(These(), IsA(Determiner()))

Concept(Those(), IsA(Determiner()))

Concept(Some(), IsA(Determiner()))

Concept(Any(), IsA(Determiner()))

Concept(Every(), IsA(Determiner()))

Concept(Each(), IsA(Determiner()))

// A message heard: its words, the rounds in which they propose links until nothing changes,
// and each word written as its Concept with the words linked to it as arguments.
Concept(Hear(),
  Realization(Hear($text),
    context = Execution(),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($text, Call(Member($api, "toHost"), Member(Index($args, 0), "value"))),
            Bind($said, Call(Member($api, "words"), Call($String, $text))),
            Bind($name,
              Lambda(List($t),
                Call(
                  Member(
                    Map(
                      Filter(
                        Call(Member($t, "split"), Regex("[^A-Za-z0-9]+", "")),
                        Lambda(List($p), GreaterThan(Length($p), 0))
                      ),
                      Lambda(List($p),
                        Add(
                          Call(Member(Index($p, 0), "toUpperCase")),
                          Call(Member(Call(Member($p, "slice"), 1), "toLowerCase"))
                        )
                      )
                    ),
                    "join"
                  ),
                  ""
                )
              )
            ),
            Bind($classOf,
              Lambda(List($w),
                Sequence(
                  Bind($kinds, List()),
                  Bind($unit, Call(Member(Member($api, "store"), "get"), Call($name, $w))),
                  ForOf(
                    $r,
                    If($unit, Member($unit, "relations"), List()),
                    Sequence(
                      Bind($k,
                        If(
                          And(Call($isCall, Member($r, "claim")), Equals(Member(Member($r, "claim"), "head"), "IsA")),
                          Member(Index(Member(Member($r, "claim"), "args"), 0), "value"),
                          Undefined()
                        )
                      ),
                      If(Not(Call($isCall, $k)), Continue(), Undefined()),
                      Bind($kind, Call(Member(Member($api, "store"), "get"), Member($k, "head"))),
                      Bind($isClass,
                        If(
                          $kind,
                          Call(
                            Member(Member($kind, "relations"), "some"),
                            Lambda(List($x),
                              And(
                                And(
                                  And(
                                    Call($isCall, Member($x, "claim")),
                                    Equals(Member(Member($x, "claim"), "head"), "IsA")
                                  ),
                                  Call($isCall, Member(Index(Member(Member($x, "claim"), "args"), 0), "value"))
                                ),
                                Equals(
                                  Member(Member(Index(Member(Member($x, "claim"), "args"), 0), "value"), "head"),
                                  "WordClass"
                                )
                              )
                            )
                          ),
                          false
                        )
                      ),
                      If(
                        $isClass,
                        Call(Member($kinds, "push"), Member($k, "head")),
                        Undefined()
                      )
                    )
                  ),
                  Return($kinds)
                )
              )
            ),
            Var($clause, 0),
            Bind($sentences, Map($said, Lambda(List($w), Member($w, "sentence")))),
            For(
              Var($i, 0),
              LessThan($i, Length($said)),
              PostIncrement($i),
              Sequence(
                Bind($breaks,
                  And(
                    GreaterThan($i, 0),
                    Or(
                      NotEquals(Index($sentences, $i), Index($sentences, Subtract($i, 1))),
                      And(
                        And(
                          And(
                            Includes(Member(Index($said, Subtract($i, 1)), "after"), ","),
                            Includes(Member(Index($said, $i), "tags"), "Verb")
                          ),
                          Not(Includes(Member(Index($said, $i), "tags"), "Noun"))
                        ),
                        Not(Includes(Member(Index($said, $i), "tags"), "PastTense"))
                      )
                    )
                  )
                ),
                If($breaks, Assign($clause, Add($clause, 1)), Undefined()),
                Assign(Member(Index($said, $i), "sentence"), $clause)
              )
            ),
            For(
              Var($i, 0),
              LessThan(Add($i, 1), Length($said)),
              PostIncrement($i),
              If(
                And(
                  And(
                    Equals(
                      Call(Member(Member(Index($said, $i), "text"), "toLowerCase")),
                      Call(Member(Member(Index($said, Add($i, 1)), "text"), "toLowerCase"))
                    ),
                    Equals(Member(Index($said, $i), "sentence"), Member(Index($said, Add($i, 1)), "sentence"))
                  ),
                  Call(Member(Regex("^[a-z]", "i"), "test"), Member(Index($said, $i), "text"))
                ),
                Assign(Member(Index($said, $i), "stutter"), true),
                Undefined()
              )
            ),
            Bind($words, List()),
            For(
              Var($i, 0),
              LessThan($i, Length($said)),
              PostIncrement($i),
              Sequence(
                Bind($known, Call($classOf, Member(Index($said, $i), "text"))),
                Bind($tags,
                  Concat(
                    If(
                      Member(Index($said, $i), "stutter"),
                      List("Filler"),
                      List()
                    ),
                    $known,
                    Filter(Member(Index($said, $i), "tags"), Lambda(List($t), Not(Includes($known, $t))))
                  )
                ),
                Assign(Member(Index($said, $i), "tags"), $tags),
                Call(
                  Member($words, "push"),
                  Call(
                    Member($api, "call"),
                    "Word",
                    Member(Index($said, $i), "text"),
                    $i,
                    Call(
                      Member($api, "call"),
                      "List",
                      Spread(Map($tags, Lambda(List($t), Call(Member($api, "call"), $t))))
                    ),
                    Member(Index($said, $i), "sentence"),
                    Call(
                      Member($api, "call"),
                      "List",
                      Spread(Map(Member(Index($said, $i), "could"), Lambda(List($t), Call(Member($api, "call"), $t))))
                    ),
                    Member(Index($said, $i), "after")
                  )
                )
              )
            ),
            Bind($prompt, Call(Member($api, "call"), "Prompt", Spread($words))),
            Bind($seen, New($Map)),
            Bind($count,
              Lambda(List($e),
                Sequence(
                  If(Not(Call($isCall, $e)), Return(), Undefined()),
                  ForOf(
                    $a,
                    Member($e, "args"),
                    Sequence(
                      If(
                        Call($isCall, Member($a, "value")),
                        Call(
                          Member($seen, "set"),
                          Add(Add(Member($e, "head"), ">"), Member(Member($a, "value"), "head")),
                          Add(
                            Otherwise(
                              Call(
                                Member($seen, "get"),
                                Add(Add(Member($e, "head"), ">"), Member(Member($a, "value"), "head"))
                              ),
                              0
                            ),
                            1
                          )
                        ),
                        Undefined()
                      ),
                      Call($count, Member($a, "value"))
                    )
                  ),
                  Undefined()
                )
              )
            ),
            ForOf(
              $unit,
              Call(Member(Member($api, "store"), "all")),
              ForOf(
                $r,
                Member($unit, "relations"),
                Sequence(
                  Bind($said_, Member($r, "claim")),
                  If(
                    And(
                      And(
                        And(Call($isCall, $said_), Equals(Member($said_, "head"), "Said")),
                        Call($isCall, Member(Index(Member($said_, "args"), 0), "value"))
                      ),
                      Equals(Member(Member(Index(Member($said_, "args"), 0), "value"), "head"), "Me")
                    ),
                    Call(
                      $count,
                      If(
                        Index(Member($said_, "args"), 1),
                        Member(Index(Member($said_, "args"), 1), "value"),
                        Undefined()
                      )
                    ),
                    Undefined()
                  )
                )
              )
            ),
            Bind($heardBefore,
              Lambda(List($p),
                Otherwise(
                  Call(
                    Member($seen, "get"),
                    Add(
                      Add(Call($name, Member(Index($said, Member($p, "to")), "text")), ">"),
                      Call($name, Member(Index($said, Member($p, "from")), "text"))
                    )
                  ),
                  0
                )
              )
            ),
            Bind($hearing, Call(Member($api, "call"), "Hearing")),
            Var($links, List()),
            Bind($linked,
              Lambda(List(),
                Call(
                  Member($api, "call"),
                  "List",
                  Spread(
                    Map(
                      $links,
                      Lambda(List($l),
                        Call(
                          Member($api, "call"),
                          "Link",
                          Member($l, "from"),
                          Member($l, "to"),
                          Call(Member($api, "call"), Member($l, "role"))
                        )
                      )
                    )
                  )
                )
              )
            ),
            For(
              Var($round, 0),
              LessThan($round, Add(Length($said), 2)),
              PostIncrement($round),
              Sequence(
                Bind($placed, New($Set, Map($links, Lambda(List($l), Member($l, "from"))))),
                Bind($proposals, List()),
                For(
                  Var($i, 0),
                  LessThan($i, Length($said)),
                  PostIncrement($i),
                  Sequence(
                    Bind($head, Call($name, Member(Index($said, $i), "text"))),
                    Bind($asked,
                      If(
                        Call(Member(Regex("^[A-Za-z]", ""), "test"), $head),
                        List($head),
                        Member(Index($said, $i), "tags")
                      )
                    ),
                    Bind($heard, List()),
                    ForOf(
                      $h,
                      $asked,
                      Sequence(
                        Bind($proposed,
                          Await(
                            Call(
                              Member($api, "evaluate"),
                              Call(Member($api, "call"), $h, $prompt, $i, Call($linked)),
                              $hearing
                            )
                          )
                        ),
                        If(
                          And(Call($isCall, $proposed), Equals(Member($proposed, "head"), "List")),
                          ForOf(
                            $a,
                            Member($proposed, "args"),
                            Call(Member($heard, "push"), $a)
                          ),
                          Undefined()
                        )
                      )
                    ),
                    ForOf(
                      $a,
                      $heard,
                      Sequence(
                        Bind($p, Member($a, "value")),
                        If(
                          Or(
                            Or(Not(Call($isCall, $p)), NotEquals(Member($p, "head"), "Link")),
                            LessThan(Length(Member($p, "args")), 3)
                          ),
                          Continue(),
                          Undefined()
                        ),
                        Bind($role, Member(Index(Member($p, "args"), 2), "value")),
                        Call(
                          Member($proposals, "push"),
                          Object(
                            from = Member(Index(Member($p, "args"), 0), "value"),
                            to = Member(Index(Member($p, "args"), 1), "value"),
                            role = If(
                              Call($isCall, $role),
                              Member($role, "head"),
                              Call($String, $role)
                            )
                          )
                        )
                      )
                    )
                  )
                ),
                Bind($rank,
                  Object(
                    Corrects = 0,
                    Joins = 0,
                    Absorbs = 1,
                    Takes = 2,
                    Modifies = 3,
                    AskedAbout = 5
                  )
                ),
                Call(
                  Member($proposals, "sort"),
                  Lambda(List($a, $b),
                    Or(
                      Subtract(
                        Otherwise(Index($rank, Member($a, "role")), 4),
                        Otherwise(Index($rank, Member($b, "role")), 4)
                      ),
                      Subtract(Call($heardBefore, $b), Call($heardBefore, $a))
                    )
                  )
                ),
                Bind($accepted, List()),
                Bind($taken, New($Set, $placed)),
                Bind($up, New($Map, Map($links, Lambda(List($l), List(Member($l, "from"), Member($l, "to")))))),
                Bind($above,
                  Lambda(List($i, $j),
                    Sequence(
                      For(
                        Sequence(Var($k, $i), Var($n, 0)),
                        And(NotEquals($k, Undefined()), LessThan($n, 256)),
                        Sequence(Assign($k, Call(Member($up, "get"), $k)), PostIncrement($n)),
                        If(Equals($k, $j), Return(true), Undefined())
                      ),
                      Return(false)
                    )
                  )
                ),
                Var($settling, false),
                ForOf(
                  $p,
                  $proposals,
                  Sequence(
                    If(
                      And(Equals(Member($p, "role"), "AskedAbout"), $settling),
                      Continue(),
                      Undefined()
                    ),
                    Bind($within,
                      And(
                        And(Index($said, Member($p, "from")), Index($said, Member($p, "to"))),
                        Equals(
                          Member(Index($said, Member($p, "from")), "sentence"),
                          Member(Index($said, Member($p, "to")), "sentence")
                        )
                      )
                    ),
                    If(
                      And(
                        Index($said, Member($p, "from")),
                        Includes(Member(Index($said, Member($p, "from")), "tags"), "Filler")
                      ),
                      Continue(),
                      Undefined()
                    ),
                    If(
                      Or(
                        Or(
                          Or(Not($within), Call(Member($taken, "has"), Member($p, "from"))),
                          Equals(Member($p, "from"), Member($p, "to"))
                        ),
                        Call($above, Member($p, "to"), Member($p, "from"))
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Call(Member($accepted, "push"), $p),
                    Call(Member($taken, "add"), Member($p, "from")),
                    Call(
                      Member($up, "set"),
                      Member($p, "from"),
                      Member($p, "to")
                    ),
                    If(
                      NotEquals(Member($p, "role"), "AskedAbout"),
                      Assign($settling, true),
                      Undefined()
                    )
                  )
                ),
                If(Equals(Length($accepted), 0), Break(), Undefined()),
                Assign($links, Call(Member($links, "concat"), $accepted))
              )
            ),
            Bind($parentOf, New($Map, Map($links, Lambda(List($l), List(Member($l, "from"), $l))))),
            Bind($under,
              Lambda(List($i, $role),
                Sequence(
                  Bind($out, List()),
                  For(
                    Var($j, 0),
                    LessThan($j, Length($said)),
                    PostIncrement($j),
                    Sequence(
                      Bind($l, Call(Member($parentOf, "get"), $j)),
                      If(
                        And(
                          And(NotEquals($l, Undefined()), Equals(Member($l, "to"), $i)),
                          Equals(Member($l, "role"), $role)
                        ),
                        Call(Member($out, "push"), $j),
                        Undefined()
                      )
                    )
                  ),
                  Return($out)
                )
              )
            ),
            Bind($tagged, Lambda(List($i, $tag), Includes(Member(Index($said, $i), "tags"), $tag))),
            Bind($heardAs,
              Lambda(List($w),
                Sequence(
                  Bind($unit, Call(Member(Member($api, "store"), "get"), Call($name, $w))),
                  Bind($r,
                    If(
                      $unit,
                      Call(
                        Member(Member($unit, "relations"), "find"),
                        Lambda(List($x),
                          And(
                            Call($isCall, Member($x, "claim")),
                            Equals(Member(Member($x, "claim"), "head"), "HeardAs")
                          )
                        )
                      ),
                      Undefined()
                    )
                  ),
                  Return(
                    If(
                      And($r, Call($isCall, Member(Index(Member(Member($r, "claim"), "args"), 0), "value"))),
                      Member(Member(Index(Member(Member($r, "claim"), "args"), 0), "value"), "head"),
                      Undefined()
                    )
                  )
                )
              )
            ),
            Bind($CLOCK, Regex("^([0-9]{1,2})(?::([0-9]{2}))?(am|pm)$", "i")),
            Bind($build,
              Lambda(List($i),
                Sequence(
                  Bind($kids, List()),
                  For(
                    Var($j, 0),
                    LessThan($j, Length($said)),
                    PostIncrement($j),
                    Sequence(
                      Bind($l, Call(Member($parentOf, "get"), $j)),
                      If(
                        And(
                          And(
                            And(NotEquals($l, Undefined()), Equals(Member($l, "to"), $i)),
                            NotEquals(Member($l, "role"), "Absorbs")
                          ),
                          NotEquals(Member($l, "role"), "Corrects")
                        ),
                        Call(Member($kids, "push"), Call($build, $j)),
                        Undefined()
                      )
                    )
                  ),
                  Bind($t, Member(Index($said, $i), "text")),
                  Var($e, Undefined()),
                  Bind($clock, Call(Member($CLOCK, "exec"), $t)),
                  If(
                    And(Call(Member(Regex("^[0-9]+([.][0-9]+)?$", ""), "test"), $t), Equals(Length($kids), 0)),
                    Assign($e, Call($Number, $t)),
                    If(
                      And($clock, Equals(Length($kids), 0)),
                      Sequence(
                        Bind($at, List(Call($Number, Index($clock, 1)))),
                        If(
                          Index($clock, 2),
                          Call(Member($at, "push"), Call($Number, Index($clock, 2))),
                          Undefined()
                        ),
                        Assign(
                          $e,
                          Call(
                            Member($api, "call"),
                            "Time",
                            Spread($at),
                            Call(
                              Member($api, "call"),
                              If(
                                Equals(Call(Member(Index($clock, 3), "toLowerCase")), "am"),
                                "Am",
                                "Pm"
                              )
                            )
                          )
                        )
                      ),
                      Sequence(
                        Bind($span,
                          Call(
                            Member(
                              Concat(
                                Call($under, $i, "Absorbs"),
                                Call($under, $i, "Modifies"),
                                List($i)
                              ),
                              "sort"
                            ),
                            Lambda(List($a, $b), Subtract($a, $b))
                          )
                        ),
                        Bind($points,
                          Or(
                            Or(
                              Call($tagged, $i, "Pointing"),
                              Call(
                                Member(Call($under, $i, "Absorbs"), "some"),
                                Lambda(List($j), Call($tagged, $j, "Pointing"))
                              )
                            ),
                            And(
                              Call(Member(Regex("^ones?$", "i"), "test"), $t),
                              GreaterThan(Length(Call($under, $i, "Modifies")), 0)
                            )
                          )
                        ),
                        Bind($simple,
                          Call(
                            Member($span, "every"),
                            Lambda(List($j), Or(Equals($j, $i), Equals(Length(Call($under, $j, "Modifies")), 0)))
                          )
                        ),
                        Bind($relative,
                          And(Call($tagged, $i, "Pointing"), GreaterThan(Length(Call($under, $i, "Takes")), 0))
                        ),
                        Bind($deictic,
                          Lambda(List($j),
                            Sequence(
                              Bind($unit,
                                Call(
                                  Member(Member($api, "store"), "get"),
                                  Call($name, Member(Index($said, $j), "text"))
                                )
                              ),
                              Return(
                                And(
                                  And(Not(Call($tagged, $j, "Pronoun")), Not(Not($unit))),
                                  Call(
                                    Member(Member($unit, "relations"), "some"),
                                    Lambda(List($r),
                                      And(
                                        And(
                                          And(
                                            Call($isCall, Member($r, "claim")),
                                            Equals(Member(Member($r, "claim"), "head"), "IsA")
                                          ),
                                          Call($isCall, Member(Index(Member(Member($r, "claim"), "args"), 0), "value"))
                                        ),
                                        Equals(
                                          Member(Member(Index(Member(Member($r, "claim"), "args"), 0), "value"), "head"),
                                          "Deictic"
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        ),
                        Bind($ambient,
                          And(
                            Call(Member(Regex("^it$", "i"), "test"), $t),
                            Call(
                              Member($said, "some"),
                              Lambda(List($w, $j),
                                And(
                                  Equals(Member($w, "sentence"), Member(Index($said, $i), "sentence")),
                                  Or(
                                    Call(
                                      Member(List("Date", "Time", "Duration"), "some"),
                                      Lambda(List($x), Includes(Member($w, "tags"), $x))
                                    ),
                                    Call($deictic, $j)
                                  )
                                )
                              )
                            )
                          )
                        ),
                        If(
                          And(And(And($points, $simple), Not($relative)), Not($ambient)),
                          Assign(
                            $e,
                            Call(
                              Member($api, "call"),
                              "Ref",
                              Call(
                                Member(
                                  Map(
                                    $span,
                                    Lambda(List($j),
                                      Or(Member(Index($said, $j), "typed"), Member(Index($said, $j), "text"))
                                    )
                                  ),
                                  "join"
                                ),
                                " "
                              ),
                              Spread(Map(Call($under, $i, "Takes"), $build))
                            )
                          ),
                          Undefined()
                        ),
                        If(
                          Equals($e, Undefined()),
                          Assign(
                            $e,
                            Call(
                              Member($api, "call"),
                              Or(Or(Call($heardAs, $t), Call($name, $t)), $t),
                              Spread($kids)
                            )
                          ),
                          Undefined()
                        )
                      )
                    )
                  ),
                  ForOf(
                    $j,
                    Call($under, $i, "Corrects"),
                    Assign(
                      $e,
                      Call(
                        Member($api, "call"),
                        "MarkCorrection",
                        Call($build, $j),
                        $e
                      )
                    )
                  ),
                  Return($e)
                )
              )
            ),
            Bind($moodOf,
              Lambda(List($sentence),
                Sequence(
                  Bind($in_, List()),
                  For(
                    Var($i, 0),
                    LessThan($i, Length($said)),
                    PostIncrement($i),
                    If(
                      And(
                        Equals(Member(Index($said, $i), "sentence"), $sentence),
                        Not(Includes(Member(Index($said, $i), "tags"), "Expression"))
                      ),
                      Call(Member($in_, "push"), $i),
                      Undefined()
                    )
                  ),
                  If(Not(Length($in_)), Return("Declarative"), Undefined()),
                  Bind($first, Member(Index($said, Index($in_, 0)), "tags")),
                  If(
                    Call(Member($in_, "some"), Lambda(List($i), Includes(Member(Index($said, $i), "after"), "?"))),
                    Return("Interrogative"),
                    Undefined()
                  ),
                  If(
                    And(
                      And(Includes($first, "Helper"), GreaterThan(Length($in_), 1)),
                      Includes(Member(Index($said, Index($in_, 1)), "tags"), "Negative")
                    ),
                    Return("Imperative"),
                    Undefined()
                  ),
                  If(
                    Or(Includes($first, "QuestionWord"), Includes($first, "Helper")),
                    Return("Interrogative"),
                    Undefined()
                  ),
                  If(
                    Or(
                      Includes($first, "Imperative"),
                      And(
                        And(Includes($first, "Verb"), Includes($first, "Infinitive")),
                        Not(Includes($first, "Helper"))
                      )
                    ),
                    Return("Imperative"),
                    Undefined()
                  ),
                  Return("Declarative")
                )
              )
            ),
            Bind($moods, New($Map)),
            Bind($said_,
              Lambda(List($i, $e),
                Sequence(
                  Bind($s, Member(Index($said, $i), "sentence")),
                  If(
                    Not(Call(Member($moods, "has"), $s)),
                    Call(Member($moods, "set"), $s, Call($moodOf, $s)),
                    Undefined()
                  ),
                  Return(
                    Call(
                      Member($api, "call"),
                      "Mood",
                      Call(Member($api, "call"), Call(Member($moods, "get"), $s)),
                      $e
                    )
                  )
                )
              )
            ),
            Bind($filler, Lambda(List($i), Includes(Member(Index($said, $i), "tags"), "Filler"))),
            Bind($roots, List()),
            Var($aside, List()),
            Bind($flush,
              Lambda(List(),
                Sequence(
                  If(
                    Length($aside),
                    Call(
                      Member($roots, "push"),
                      Call(
                        Member($api, "call"),
                        "MarkAside",
                        Call(Member($aside, "join"), " ")
                      )
                    ),
                    Undefined()
                  ),
                  Assign($aside, List()),
                  Undefined()
                )
              )
            ),
            For(
              Var($i, 0),
              LessThan($i, Length($said)),
              PostIncrement($i),
              Sequence(
                If(
                  Call(Member($parentOf, "has"), $i),
                  Continue(),
                  Undefined()
                ),
                Bind($lone, Not(Call(Member($links, "some"), Lambda(List($l), Equals(Member($l, "to"), $i))))),
                If(
                  And(Call($filler, $i), $lone),
                  Sequence(
                    Call(
                      Member($aside, "push"),
                      Or(Member(Index($said, $i), "typed"), Member(Index($said, $i), "text"))
                    ),
                    Continue()
                  ),
                  Undefined()
                ),
                Call($flush),
                Call(Member($roots, "push"), Call($said_, $i, Call($build, $i)))
              )
            ),
            Call($flush),
            Return(Call(Member($api, "call"), "Phrases", Spread($roots)))
          )
        )
      )
    )
  )
)
