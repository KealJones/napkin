                            )
                          )
                        )
                      ),
                      Lambda(List($r),
                        Length(
                          Filter(
                            Member(Member($r, "pattern"), "args"),
                            Lambda(List($a), Equals(Member($a, "name"), Undefined()))
                          )
                        )
                      )
                    )
                  ),
                  Return(And(Includes($arities, 2), Not(Includes($arities, 1))))
                )
              )
            ),
            Bind($onLast,
              Lambda(List($e),
                Sequence(
                  Bind($x, Call($inner, $e)),
                  If(
                    Or(
                      Or(Not(Call($isCall, $x)), Not(Call($takesTwo, Member($x, "head")))),
                      Call(
                        Member(Member($x, "args"), "some"),
                        Lambda(List($a), NotEquals(Member($a, "name"), Undefined()))
                      )
                    ),
                    Return($e),
                    Undefined()
                  ),
                  Comment("\"and plus 3\": the word that carries the talk on is not the first thing added."),
                  Bind($first,
                    If(
                      Equals(Length(Member($x, "args")), 2),
                      Member(Index(Member($x, "args"), 0), "value"),
                      Undefined()
                    )
                  ),
                  Bind($carried,
                    And(
                      And(And(NotEquals($first, Undefined()), Call($joining, $first)), Call($isCall, $first)),
                      Not(Length(Member($first, "args")))
                    )
                  ),
                  If(
                    And(NotEquals(Length(Member($x, "args")), 1), Not($carried)),
                    Return($e),
                    Undefined()
                  ),
                  Bind($only, Member(Index(Member($x, "args"), Subtract(Length(Member($x, "args")), 1)), "value")),
                  Comment("\"add 2 and 3\": the two things joined are the two it takes."),
                  Bind($pair,
                    If(
                      And(
                        And(And(Not($carried), Call($isCall, $only)), Equals(Member($only, "head"), "And")),
                        Equals(Length(Member($only, "args")), 2)
                      ),
                      Map(Member($only, "args"), Lambda(List($a), Member($a, "value"))),
                      Undefined()
                    )
                  ),
                  Bind($y,
                    If(
                      $pair,
                      Call(
                        Member($api, "call"),
                        Member($x, "head"),
                        Spread($pair)
                      ),
                      Call(
                        Member($api, "call"),
                        Member($x, "head"),
                        Call(Member($api, "call"), "Ref", ""),
                        $only
                      )
                    )
                  ),
                  Return(
                    If(
                      Equals($x, $e),
                      $y,
                      Call(
                        Member($api, "call"),
                        "ContextScope",
                        Member(Index(Member($e, "args"), 0), "value"),
                        $y
                      )
                    )
                  )
                )
              )
            ),
            Comment("\"explain this code: `f(1)`\": what is pointed at with \"this\" is what the message shows,"),
            Comment("code or a file said on its own beside it, so the two are one: Explain(the code)."),
            Bind($shown, Filter($kept_, Lambda(List($e), Includes(Member($kept, "spans"), Call($inner, $e))))),
            Bind($pointing,
              Lambda(List($e),
                And(
                  And(
                    And(
                      And(Call($isCall, $e), Equals(Member($e, "head"), "Ref")),
                      Equals(TypeOf(OptionalMember(Index(Member($e, "args"), 0), "value")), "string")
                    ),
                    Call(
                      Member(Regex("^(this|that|it|these|those)\\b", "i"), "test"),
                      Member(Index(Member($e, "args"), 0), "value")
                    )
                  ),
                  Equals(Length(Member($e, "args")), 1)
                )
              )
            ),
            Bind($has,
              Lambda(List($e),
                And(
                  Call($isCall, $e),
                  Or(
                    Call($pointing, $e),
                    Call(Member(Member($e, "args"), "some"), Lambda(List($a), Call($has, Member($a, "value"))))
                  )
                )
              )
            ),
            Bind($put,
              Lambda(List($e, $span),
                Sequence(
                  Var($done, false),
                  Bind($go,
                    Lambda(List($x),
                      Sequence(
                        If(
                          Or($done, Not(Call($isCall, $x))),
                          Return($x),
                          Undefined()
                        ),
                        If(
                          Call($pointing, $x),
                          Sequence(Assign($done, true), Return($span)),
                          Undefined()
                        ),
                        Return(
                          Object(
                            head = Member($x, "head"),
                            args = Map(
                              Member($x, "args"),
                              Lambda(List($a),
                                If(
                                  Equals(Member($a, "name"), Undefined()),
                                  Object(value = Call($go, Member($a, "value"))),
                                  Object(name = Member($a, "name"), value = Call($go, Member($a, "value")))
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  ),
                  Return(Call($go, $e))
                )
              )
            ),
            Var($joined, $kept_),
            Comment("An order's verb said alone before what it is about (\"convert | this to javascript ...\"):"),
            Comment("the verb takes it."),
            Bind($verbAlone,
              Lambda(List($e),
                Sequence(
                  Bind($x, Call($inner, $e)),
                  If(
                    Or(
                      Or(
                        Or(
                          Or(Or(Not(Call($isCall, $x)), Length(Member($x, "args"))), Not(Call($isCall, $e))),
                          And(NotEquals(Member($e, "head"), "Mood"), NotEquals(Member($e, "head"), "ContextScope"))
                        ),
                        Not(Call($isCall, Member(Index(Member($e, "args"), 0), "value")))
                      ),
                      NotEquals(Member(Member(Index(Member($e, "args"), 0), "value"), "head"), "Imperative")
                    ),
                    Return(false),
                    Undefined()
                  ),
                  Bind($w,
                    Call(
                      Member($said, "find"),
                      Lambda(List($s), Equals(Call($name, Member($s, "text")), Member($x, "head")))
                    )
                  ),
                  Return(And(Not(Not($w)), Includes(Member($w, "tags"), "Verb")))
                )
              )
            ),
            For(
              Var($k, 0),
              LessThan(Add($k, 1), Length($joined)),
              PostIncrement($k),
              Sequence(
                If(
                  Not(Call($verbAlone, Index($joined, $k))),
                  Continue(),
                  Undefined()
                ),
                Bind($next, Index($joined, Add($k, 1))),
                Assign(
                  $joined,
                  Concat(
                    Call(Member($joined, "slice"), 0, $k),
                    List(
                      Call(
                        Member($api, "call"),
                        "ContextScope",
                        Member(Index(Member(Index($joined, $k), "args"), 0), "value"),
                        Call(
                          Member($api, "call"),
                          Member(Call($inner, Index($joined, $k)), "head"),
                          Call($inner, $next)
                        )
                      )
                    ),
                    Call(Member($joined, "slice"), Add($k, 2))
                  )
                )
              )
            ),
            ForOf(
              $span,
              $shown,
              Sequence(
                Bind($at,
                  Call(Member($joined, "findIndex"), Lambda(List($e), And(NotEquals($e, $span), Call($has, $e))))
                ),
                If(LessThan($at, 0), Continue(), Undefined()),
                Assign(
                  $joined,
                  Filter(
                    Call(
                      Member($joined, "map"),
                      Lambda(List($e, $k), If(Equals($k, $at), Call($put, $e, Call($inner, $span)), $e))
                    ),
                    Lambda(List($e), NotEquals($e, $span))
                  )
                )
              )
            ),
            Comment("What an order is to work from, said after it (\"write a function | where f(1) is 2, ...\"):"),
            Comment("a phrase holding code, a file or examples the message shows goes to the order before it."),
            Bind($holdsShown,
              Lambda(List($e),
                Or(
                  Includes(Member($kept, "spans"), $e),
                  And(
                    Call($isCall, $e),
                    Call(Member(Member($e, "args"), "some"), Lambda(List($a), Call($holdsShown, Member($a, "value"))))
                  )
                )
              )
            ),
            Bind($ordered,
              Lambda(List($e),
                And(
                  And(
                    And(
                      And(
                        And(
                          Call($isCall, $e),
                          Or(Equals(Member($e, "head"), "Mood"), Equals(Member($e, "head"), "ContextScope"))
                        ),
                        Call($isCall, Member(Index(Member($e, "args"), 0), "value"))
                      ),
                      Equals(Member(Member(Index(Member($e, "args"), 0), "value"), "head"), "Imperative")
                    ),
                    Call($isCall, Call($inner, $e))
                  ),
                  Not(Call($holdsShown, Call($inner, $e)))
                )
              )
            ),
            For(
              Var($k, 1),
              LessThan($k, Length($joined)),
              PostIncrement($k),
              Sequence(
                If(
                  Or(Not(Call($holdsShown, Index($joined, $k))), Not(Call($ordered, Index($joined, Subtract($k, 1))))),
                  Continue(),
                  Undefined()
                ),
                Bind($order, Call($inner, Index($joined, Subtract($k, 1)))),
                Bind($merged,
                  Call(
                    Member($api, "call"),
                    "ContextScope",
                    Member(Index(Member(Index($joined, Subtract($k, 1)), "args"), 0), "value"),
                    Object(
                      head = Member($order, "head"),
                      args = Concat(Member($order, "args"), List(Object(value = Call($inner, Index($joined, $k)))))
                    )
                  )
                ),
                Assign(
                  $joined,
                  Concat(
                    Call(Member($joined, "slice"), 0, Subtract($k, 1)),
                    List($merged),
                    Call(Member($joined, "slice"), Add($k, 1))
                  )
                ),
                PostDecrement($k)
              )
            ),
            Return(
              Call(
                Member($api, "call"),
                "Phrases",
                Spread(Map($joined, $onLast))
              )
            )
          )
        )
      )
    )
  )
)
