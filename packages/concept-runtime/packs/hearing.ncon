Concept(Where(), IsA(QuestionWord()))

Concept(Why(), IsA(QuestionWord()))

Concept(How(), IsA(QuestionWord()))

Concept(Which(), IsA(QuestionWord()))

Concept(QuestionWord(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 3), "value"),
                  Negate(1)
                )
              )
            ),
            Bind($out, List()),
            If(
              And(
                And(
                  Or(Call($has, Add($at, 1), "Noun"), Call($has, Add($at, 1), "Adjective")),
                  Not(Call($has, Add($at, 1), "Pronoun"))
                ),
                Equals(Call($sentence, Add($at, 1)), Call($sentence, $at))
              ),
              Call(
                Member($out, "push"),
                Call(
                  Member($api, "call"),
                  "Link",
                  Add($at, 1),
                  $at,
                  Call(Member($api, "call"), "Takes")
                )
              ),
              Undefined()
            ),
            For(
              Var($j, Add($at, 1)),
              And(LessThan($j, Length(Member($prompt, "args"))), Equals(Call($sentence, $j), Call($sentence, $at))),
              PostIncrement($j),
              If(
                And(Not(Call(Member($parent, "has"), $j)), Not(Call($has, $j, "Expression"))),
                Call(
                  Member($out, "push"),
                  Call(
                    Member($api, "call"),
                    "Link",
                    $j,
                    $at,
                    Call(Member($api, "call"), "AskedAbout")
                  )
                ),
                Undefined()
              )
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

// "could you close the door", "is chess a sport": a helper first asks.
Concept(Helper(), IsA(WordClass()))

Concept(Helper(),
  Realization($word,
    context = Hearing(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($prompt, Member(Index($args, 0), "value")),
            Bind($at, Member(Index($args, 1), "value")),
            Bind($hearing, Call(Member($api, "call"), "Hearing")),
            Bind($parent,
              New(
                $Map,
                Map(
                  Member(Member(Index($args, 2), "value"), "args"),
                  Lambda(List($a),
                    List(
                      Member(Index(Member(Member($a, "value"), "args"), 0), "value"),
                      Member(Index(Member(Member($a, "value"), "args"), 1), "value")
                    )
                  )
                )
              )
            ),
            Bind($root,
              Lambda(List($i),
                Sequence(
                  Var($j, $i),
                  For(
                    Var($n, 0),
                    And(Call(Member($parent, "has"), $j), LessThan($n, 64)),
                    PostIncrement($n),
                    Assign($j, Call(Member($parent, "get"), $j))
                  ),
                  Return($j)
                )
              )
            ),
            Bind($has,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(Call($isCall, $w), Call($isCall, Member(Index(Member($w, "args"), 2), "value"))),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 2), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($i),
                If(
                  Index(Member($prompt, "args"), $i),
                  Member(Index(Member(Member(Index(Member($prompt, "args"), $i), "value"), "args"), 3), "value"),
                  Negate(1)
                )
              )
            ),
            Bind($asking,
              And(
                GreaterThan($at, 0),
                Or(
                  Call($has, Subtract($at, 1), "QuestionWord"),
                  And(
                    Call(Member($parent, "has"), Subtract($at, 1)),
                    Call(
                      $has,
                      Call(Member($parent, "get"), Subtract($at, 1)),
                      "QuestionWord"
                    )
                  )
                )
              )
            ),
            Bind($starts,
              Or(Or(Equals($at, 0), NotEquals(Call($sentence, Subtract($at, 1)), Call($sentence, $at))), $asking)
            ),
            If(
              Not($starts),
              Return(
                If(
                  Call($has, $at, "Copula"),
                  Call(
                    Member($api, "evaluate"),
                    Call(
                      Member($api, "call"),
                      "Copula",
                      $prompt,
                      $at,
                      Member(Index($args, 2), "value")
                    ),
                    $hearing
                  ),
                  Call(Member($api, "call"), "List")
                )
              ),
              Undefined()
            ),
            Bind($thingAt,
              Async(
                Lambda(List($i),
                  Sequence(
                    Bind($t,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "call"),
                            "ThingAfter",
                            $prompt,
                            Subtract($i, 1)
                          ),
                          $hearing
                        )
                      )
                    ),
                    Return(
                      If(
                        And(Equals(TypeOf($t), "number"), AtLeast($t, $i)),
                        $t,
                        If(
                          And(
                            LessThan($i, Length(Member($prompt, "args"))),
                            Equals(Call($sentence, $i), Call($sentence, $at))
                          ),
                          $i,
                          Negate(1)
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($could,
              Lambda(List($i, $tag),
                Sequence(
                  Bind($w,
                    If(
                      Index(Member($prompt, "args"), $i),
                      Member(Index(Member($prompt, "args"), $i), "value"),
                      Undefined()
                    )
                  ),
                  Return(
                    And(
                      And(
                        And(Call($isCall, $w), Index(Member($w, "args"), 4)),
                        Call($isCall, Member(Index(Member($w, "args"), 4), "value"))
                      ),
                      Call(
                        Member(Member(Member(Index(Member($w, "args"), 4), "value"), "args"), "some"),
                        Lambda(List($t),
                          And(Call($isCall, Member($t, "value")), Equals(Member(Member($t, "value"), "head"), $tag))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Bind($out, List()),
            Var($subject, Await(Call($thingAt, Add($at, 1)))),
            If(
              LessThan($subject, 0),
              Return(Call(Member($api, "call"), "List")),
              Undefined()
            ),
            Var($carried, Negate(1)),
            If(
              And(
                And(Not(Call($has, $at, "Copula")), GreaterThan($subject, Add($at, 1))),
                Call($could, $subject, "Verb")
              ),
              Sequence(
                Var($verbAfter, false),
                For(
                  Var($j, Add($subject, 1)),
                  And(LessThan($j, Length(Member($prompt, "args"))), Equals(Call($sentence, $j), Call($sentence, $at))),
                  PostIncrement($j),
                  If(
                    Call($has, $j, "Verb"),
                    Assign($verbAfter, true),
                    Undefined()
                  )
                ),
                If(
                  Not($verbAfter),
                  Sequence(Assign($carried, $subject), Assign($subject, Subtract($subject, 1))),
                  Undefined()
                )
              ),
              Undefined()
            ),
            If(
              GreaterThan($carried, 0),
              Sequence(
                Call(
                  Member($out, "push"),
                  Call(
                    Member($api, "call"),
                    "Link",
                    Call($root, $subject),
                    $at,
                    Call(Member($api, "call"), "Takes")
                  )
                ),
                Call(
                  Member($out, "push"),
                  Call(
                    Member($api, "call"),
                    "Link",
                    $carried,
                    $at,
                    Call(Member($api, "call"), "Takes")
                  )
                ),
                Return(Call(Member($api, "call"), "List", Spread($out)))
              ),
              Undefined()
            ),
            Call(
              Member($out, "push"),
              Call(
                Member($api, "call"),
                "Link",
                Call($root, $subject),
                $at,
                Call(Member($api, "call"), "Takes")
              )
            ),
            Bind($next, Add($subject, 1)),
            If(
              Call($has, $subject, "Negative"),
              Return(Call(Member($api, "call"), "List", Spread($out))),
              Undefined()
            ),
            Bind($takes,
              And(
                And(Call($has, $next, "Preposition"), LessThan(Add($next, 1), Length(Member($prompt, "args")))),
                Equals(Call($sentence, Add($next, 1)), Call($sentence, $at))
              )
            ),
            If(
              And(
                And(
                  LessThan($next, Length(Member($prompt, "args"))),
                  Equals(Call($sentence, $next), Call($sentence, $at))
                ),
                Not($takes)
              ),
              Sequence(
                Bind($asked,
                  If(
                    Call($has, $next, "Verb"),
                    $next,
                    Await(Call($thingAt, $next))
                  )
                ),
                If(
                  GreaterThan($asked, $subject),
                  Call(
                    Member($out, "push"),
                    Call(
                      Member($api, "call"),
                      "Link",
                      Call($root, $asked),
                      $at,
                      Call(Member($api, "call"), "Takes")
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Return(Call(Member($api, "call"), "List", Spread($out)))
          )
        )
      )
    )
  )
)

