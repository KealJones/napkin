// Python, read by tree-sitter's grammar (src/code/tree.ts) and these rules into the same
// Concepts JavaScript reads as: a loop is ForOf whichever language wrote it, so what is
// learned about one program applies to another.
Requires(Core(), Code())

Concept(Python(),
  IsA(TargetLanguage()),
  Grammar("python"),
  SyntaxPrefix("Py")
)

Language(Python())

From(PyModule(Rest($ss)), Module(Sequence(Rest($ss))))

// One step is itself, as JavaScript reads it: a lone return is the body.
From(Sequence($s), $s)

From(PyComment(text = $t), Comment($t))

From(PyIdentifier(text = $n), Variable($n))

From(PyExpressionStatement($e), $e)

From(PyBlock(Rest($ss)), Sequence(Rest($ss)))

From(PyPassStatement(text = $_), Erased())

// A function's body says what it gives back: its return, or nothing.
From(
  PyFunctionDefinition(
    name = $n,
    parameters = PyParameters(Rest($ps)),
    body = $b
  ),
  Func($n, List(Rest($ps)), PyBody($b))
)

From(PyBody(PyBlock(Rest($ss), Capture($last, PyReturnStatement()))), Sequence(Rest($ss), $last))

From(PyBody(PyBlock(Rest($ss), Capture($last, PyReturnStatement($_)))), Sequence(Rest($ss), $last))

From(PyBody(PyBlock(Rest($ss))), Sequence(Rest($ss), Undefined()))

From(PyReturnStatement(Rest($e)), Return(Rest($e)))

From(PyForStatement(left = $x, right = $xs, body = $b), ForOf($x, $xs, $b))

From(PyWhileStatement(condition = $c, body = $b), While($c, $b))

From(
  PyIfStatement(
    condition = $c,
    consequence = $t,
    alternative = PyElseClause(body = $e)
  ),
  If($c, $t, $e)
)

From(PyIfStatement(condition = $c, consequence = $t), If($c, $t))

From(PyAssignment(left = $x, right = $v), Var($x, $v))

// len(x) is the Length every language's code has.
From(PyCall(function = PyIdentifier(text = "len"), arguments = PyArgumentList($x)), Length($x))
From(PyCall(function = $f, arguments = PyArgumentList(Rest($a))), Call($f, Rest($a)))

From(PyAttribute(object = $o, attribute = PyIdentifier(text = $t)), Member($o, $t))

From(PyParenthesizedExpression($e), $e)

From(PyList(Rest($es)), List(Rest($es)))

From(
  PyBinaryOperator(
    left = $a,
    operator = PyToken(text = "+"),
    right = $b
  ),
  Add($a, $b)
)

From(
  PyBinaryOperator(
    left = $a,
    operator = PyToken(text = "-"),
    right = $b
  ),
  Subtract($a, $b)
)

From(
  PyBinaryOperator(
    left = $a,
    operator = PyToken(text = "*"),
    right = $b
  ),
  Multiply($a, $b)
)

From(
  PyBinaryOperator(
    left = $a,
    operator = PyToken(text = "/"),
    right = $b
  ),
  Divide($a, $b)
)

From(
  PyBinaryOperator(
    left = $a,
    operator = PyToken(text = "%"),
    right = $b
  ),
  Modulo($a, $b)
)

From(
  PyBinaryOperator(
    left = $a,
    operator = PyToken(text = "**"),
    right = $b
  ),
  Power($a, $b)
)

From(
  PyComparisonOperator(
    operators = PyToken(text = "<"),
    $a,
    $b
  ),
  LessThan($a, $b)
)

From(
  PyComparisonOperator(
    operators = PyToken(text = ">"),
    $a,
    $b
  ),
  GreaterThan($a, $b)
)

From(
  PyComparisonOperator(
    operators = PyToken(text = "<="),
    $a,
    $b
  ),
  AtMost($a, $b)
)

From(
  PyComparisonOperator(
    operators = PyToken(text = ">="),
    $a,
    $b
  ),
  AtLeast($a, $b)
)

From(
  PyComparisonOperator(
    operators = PyToken(text = "=="),
    $a,
    $b
  ),
  Equals($a, $b)
)

From(
  PyComparisonOperator(
    operators = PyToken(text = "!="),
    $a,
    $b
  ),
  NotEquals($a, $b)
)

From(
  PyBooleanOperator(
    left = $a,
    operator = PyToken(text = "and"),
    right = $b
  ),
  And($a, $b)
)

From(
  PyBooleanOperator(
    left = $a,
    operator = PyToken(text = "or"),
    right = $b
  ),
  Or($a, $b)
)

From(PyNotOperator(argument = $x), Not($x))

// ================================================================
// Writing Python (code/write.ts). A block starts on a line of its own, so its statements are
// written in lines at that indentation; every compound expression brings its own parentheses.
To(Module($x), Statement(), "\n%x")
To(Sequence(Rest($ss)), Statement(), "%ss")
To(Literal(true), "True")
To(Literal(false), "False")
To(Literal(null), "None")
To(Undefined(), "None")
To(
  Func($n, List(Rest($ps)), $b),
  Statement(),
  "def $n($ps):\n    %b"
)
To(Lambda(List(Rest($ps)), $b), "(lambda $ps: $b)")
To(Return(), Statement(), "return")
To(Return($x), Statement(), "return $x")
To(Throw($x), Statement(), "raise $x")
To(If($c, $t, $e), "($t if $c else $e)")
To(If($c, $t), Statement(), "if $c:\n    %t")
To(If($c, $t, Undefined()), Statement(), "if $c:\n    %t")
To(
  If($c, $t, $e),
  Statement(),
  "if $c:\n    %t\nelse:\n    %e"
)
To(While($c, $s), Statement(), "while $c:\n    %s")
To(ForOf($n, $e, $s), Statement(), "for $n in $e:\n    %s")
To(Continue(), Statement(), "continue")
To(Break(), Statement(), "break")
To(Comment($t), Statement(), "# #t")
To(Bind($n, $v), Statement(), "$n = $v")
To(Var($n, $v), Statement(), "$n = $v")
To(Assign($t, $v), Statement(), "$t = $v")
To(Assign($t, $v), "($t := $v)")
To(Member($o, $k), "$o.#k")
To(UnboundName($n), "#n")
To(Index($o, $i), "$o[$i]")
To(Length($o), "len($o)")
To(Traverse($xs, Direction(First(), Last())), "$xs")
To(Traverse($xs, Direction(Last(), First())), "$xs[::-1]")
To(Map($xs, $f), "list(map($f, $xs))")
To(Filter($xs, $f), "list(filter($f, $xs))")
To(Includes($xs, $x), "($x in $xs)")
To(Call($f, Rest($a)), "$f($a)")
To(Spread($e), "*$e")
To(Not($x), "(not $x)")
To(Negate($x), "(-$x)")
To(Equals($l, $r), "($l == $r)")
To(NotEquals($l, $r), "($l != $r)")
To(LooseEquals($l, $r), "($l == $r)")
To(LooseNotEquals($l, $r), "($l != $r)")
To(Add($l, $r), "($l + $r)")
To(Subtract($l, $r), "($l - $r)")
To(Multiply($l, $r), "($l * $r)")
To(Divide($l, $r), "($l / $r)")
To(Modulo($l, $r), "($l % $r)")
To(Power($l, $r), "($l ** $r)")
To(GreaterThan($l, $r), "($l > $r)")
To(LessThan($l, $r), "($l < $r)")
To(AtLeast($l, $r), "($l >= $r)")
To(AtMost($l, $r), "($l <= $r)")
To(And($l, $r), "($l and $r)")
To(Or($l, $r), "($l or $r)")
To(In($l, $r), "($l in $r)")
To(BitAnd($l, $r), "($l & $r)")
To(BitOr($l, $r), "($l | $r)")
To(BitXor($l, $r), "($l ^ $r)")
To(ShiftLeft($l, $r), "($l << $r)")
To(ShiftRight($l, $r), "($l >> $r)")
To(List(Rest($xs)), "[$xs]")

// Primitives every language has (packs/code.ncon, packs/primitives.ncon), written as Python,
// with no imports: what needs one is written with what the language has built in.
To(Concat($a, $b), "($a + $b)")
To(Reduce($xs, $f, $init), "__import__(\"functools\").reduce($f, $xs, $init)")
To(AddValues($a, $b), "($a + $b)")
To(SubtractValues($a, $b), "($a - $b)")
To(MultiplyValues($a, $b), "($a * $b)")
To(DivideValues($a, $b), "($a / $b)")
To(RemainderOf($a, $b), "($a % $b)")
To(NegateValue($a), "(-$a)")
To(RaiseToPower($x, $n), "($x ** $n)")
To(Above($a, $b), "($a > $b)")
To(Below($a, $b), "($a < $b)")
To(AbsoluteValue($x), "abs($x)")
To(SquareRootOf($x), "($x ** 0.5)")
To(CubeRootOf($x), "($x ** (1 / 3))")
To(RoundDown($x), "int($x // 1)")
To(RoundUp($x), "(-int(-$x // 1))")
To(RoundNearest($x), "int(($x + 0.5) // 1)")
To(RoundTo($x, $p), "round($x, $p)")
To(Largest($xs), "max($xs)")
To(Smallest($xs), "min($xs)")
To(ToNumber($x), "float($x)")
To(ToText($x), "str($x)")
To(Sort($xs), "sorted($xs)")
To(Reverse($xs), "$xs[::-1]")
To(Unique($xs), "list(dict.fromkeys($xs))")
To(First($xs), "$xs[0]")
To(Last($xs), "$xs[-1]")
To(Slice($x, $from), "$x[$from:]")
To(Slice($x, $from, $to), "$x[$from:$to]")
To(AtPosition($x, $i), "$x[$i]")
To(IndexOf($x, $item), "$x.index($item)")
To(Join($xs, $separator), "$separator.join($xs)")
To(Split($t, $separator), "$t.split($separator)")
To(Lowercase($t), "$t.lower()")
To(Uppercase($t), "$t.upper()")
To(Trim($t), "$t.strip()")
To(StartsWith($t, $p), "$t.startswith($p)")
To(EndsWith($t, $p), "$t.endswith($p)")
To(Replace($t, $pattern, $with), "$t.replace($pattern, $with, 1)")
To(Repeat($t, $n), "($t * $n)")
To(PadStart($t, $width), "$t.rjust($width)")
To(PadStart($t, $width, $fill), "$t.rjust($width, $fill)")
To(Append($xs, $x), "[*$xs, $x]")
To(Prepend($xs, $x), "[$x, *$xs]")
To(InsertAt($xs, $i, $x), "[*$xs[:$i], $x, *$xs[$i:]]")
To(Without($xs, $x), "[item for item in $xs if item != $x]")
To(Range($from, $to), "list(range($from, $to))")
To(Zip($a, $b), "[list(p) for p in zip($a, $b)]")
To(SizeOf($s), "len($s)")
