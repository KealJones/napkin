Concept(Research(), IsA(Capability()))

Concept(Capability(), IsA(Category()))

// A SynonymOf relation is the source of truth; the forwarding realization is derived from
// it, so the same fact is not asserted in two places that can disagree.
// Give a Concept the forwarding behaviour its SynonymOf relation implies. The relation is
// the source of truth and this is derived from it, so the fact is asserted once.
// A realization that only hands the call to another Concept, rather than doing anything.
// Can this Concept actually do something, following forwards to wherever they lead?
//
// A forward is not behaviour, it is a pointer at behaviour. Hi forwarded to Hello and
// Hello forwarded back to Hi -- each looked realized, neither could do anything, and
// evaluating Hi() ran to the depth budget. SynonymOf is symmetric, so both arrows get
// derived from one assertion and the cycle builds itself.
// Behaviour reached by inheritance is behaviour: What has no realization of its own and
// answers through Interrogative's, so WhatIs forwarding to it is not a pointer at nothing.
// Point one name at another's behaviour. Refused when the target has none of its own to
// lend, because a pointer at a pointer is not a destination.
// The target is named in the property, so the evaluator can see where a forward
// goes without reading its source.
// A forwarding is derived from a synonym, so it goes when the synonym does: emoji kept
// answering "what is an emoji" with Emoticon after SynonymOf(Emoticon()) was retracted.

// ------------------------------------------------------------------ *
// Durations and shifting dates and clock times by them.
//
// "what day will it be in 5 days" reads as What(Day(Will(Be(In(Days(5)))))): every word as
// said. A duration is data. In, Ago, Add and Subtract shift a date or a clock time by one,
// sharing one routine, and each checks the value it received rather than its pattern,
// because patterns cannot yet say "any date" (no typed variables; reading-spec Part 5.7).
// ------------------------------------------------------------------
Concept(Days(), IsA(Duration()), IsA(Data()))

Concept(Weeks(), IsA(Duration()), IsA(Data()))

Concept(Hours(), IsA(Duration()), IsA(Data()))

Concept(Minutes(), IsA(Duration()), IsA(Data()))

Concept(Duration(), IsA(Category()))

Concept(Ago(),
  IsA(Relation()),
  Realization(Ago($x), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $field,
              Lambda(
                List($r, $n),
                Sequence(
                  Let(
                    $a,
                    Call(
                      Member(Member($r, "args"), "find"),
                      Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))))),
            Let(
              $DAY,
              List("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday")),
            Let(
              $units,
              Object(
                Days=List(1, "day"),
                Weeks=List(7, "day"),
                Hours=List(60, "minute"),
                Minutes=List(1, "minute"))),
            Let(
              $isDuration,
              Lambda(
                List($v),
                And(
                  And(
                    And($v, Index($units, Member($v, "head"))),
                    Equals(Length(Member($v, "args")), 1)),
                  Equals(TypeOf(Member(Index(Member($v, "args"), 0), "value")), "number")))),
            Let(
              $isRecord,
              Lambda(
                List($v),
                And(
                  And(
                    $v,
                    Or(Equals(Member($v, "head"), "Date"), Equals(Member($v, "head"), "Time"))),
                  Call(
                    Member(Member($v, "args"), "every"),
                    Lambda(List($a), NotEquals(Member($a, "name"), Undefined())))))),
            Let(
              $clock,
              Lambda(
                List($t),
                Sequence(
                  Let($h24, Call(Member($Math, "floor"), Divide($t, 60))),
                  Let($mm, Modulo($t, 60)),
                  Let($h12, If(Equals(Modulo($h24, 12), 0), 12, Modulo($h24, 12))),
                  Return(
                    Object(
                      head="Time",
                      args=List(
                        Object(name="hour", value=$h24),
                        Object(name="minute", value=$mm),
                        Object(
                          name="spoken",
                          value=Add(
                            Add(
                              Add(
                                Add($h12, ":"),
                                Call(Member(Call($String, $mm), "padStart"), 2, "0")),
                              " "),
                            If(LessThan($h24, 12), "AM", "PM"))))))))),
            Let(
              $date,
              Lambda(
                List($d, $time),
                Object(
                  head="Date",
                  args=Concat(
                    List(
                      Object(name="year", value=Call(Member($d, "getFullYear"))),
                      Object(name="month", value=Add(Call(Member($d, "getMonth")), 1)),
                      Object(name="day", value=Call(Member($d, "getDate"))),
                      Object(name="weekday", value=Index($DAY, Call(Member($d, "getDay"))))),
                    If($time, List(Object(name="time", value=$time)), List()))))),
            Let(
              $minutesOf,
              Lambda(
                List($t),
                Add(
                  Multiply(Call($Number, Call($field, $t, "hour")), 60),
                  Call($Number, Call($field, $t, "minute"))))),
            Let(
              $shift,
              Lambda(
                List($record, $duration, $sign),
                Sequence(
                  Let(List($per, $kind), Index($units, Member($duration, "head"))),
                  Let(
                    $n,
                    Multiply(
                      Multiply(Member(Index(Member($duration, "args"), 0), "value"), $per),
                      $sign)),
                  If(
                    Equals(Member($record, "head"), "Date"),
                    Sequence(
                      Let($time, Call($field, $record, "time")),
                      Let($total, If(Equals($kind, "day"), Multiply($n, 1440), $n)),
                      If(And(NotEquals($kind, "day"), Not($time)), Return(Undefined()), Undefined()),
                      Let($t, Add(If($time, Call($minutesOf, $time), 0), $total)),
                      Let($carry, Call(Member($Math, "floor"), Divide($t, 1440))),
                      Let($rest, Modulo(Add(Modulo($t, 1440), 1440), 1440)),
                      Let(
                        $d,
                        New(
                          $Date,
                          Call($Number, Call($field, $record, "year")),
                          Subtract(Call($Number, Call($field, $record, "month")), 1),
                          Add(Call($Number, Call($field, $record, "day")), $carry))),
                      Return(Call($date, $d, If($time, Call($clock, $rest), Undefined())))),
                    Undefined()),
                  Let($total, If(Equals($kind, "day"), Multiply($n, 1440), $n)),
                  Return(
                    Call(
                      $clock,
                      Modulo(Add(Modulo(Add(Call($minutesOf, $record), $total), 1440), 1440), 1440)))))),
            Let(
              $now,
              Async(
                Lambda(
                  List($duration),
                  Call(
                    Member($api, "evaluate"),
                    Call(
                      Member($api, "call"),
                      If(
                        Equals(Index(Index($units, Member($duration, "head")), 1), "day"),
                        "Today",
                        "Time")))))),
            Let($x, Member(Index($args, 0), "value")),
            Return(
              If(
                Call($isDuration, $x),
                Otherwise(
                  Call($shift, Await(Call($now, $x)), $x, Negate(1)),
                  Call(Member($api, "call"), "Ago", $x)),
                Call(Member($api, "call"), "Ago", $x)))))))))

// "tomorrow at 3pm" is At(Tomorrow(), Time(3, Pm())): a date and a clock time, joined by the
// user's own word, realize to the date carrying its time. No DateTime Concept: half a moment
// ("at 3pm", "tomorrow") stays the half it is.
Concept(At(),
  Realization(At($a, $b), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $field,
              Lambda(
                List($r, $n),
                Sequence(
                  Let(
                    $a,
                    Call(
                      Member(Member($r, "args"), "find"),
                      Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))))),
            Let(
              $DAY,
              List("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday")),
            Let(
              $units,
              Object(
                Days=List(1, "day"),
                Weeks=List(7, "day"),
                Hours=List(60, "minute"),
                Minutes=List(1, "minute"))),
            Let(
              $isDuration,
              Lambda(
                List($v),
                And(
                  And(
                    And($v, Index($units, Member($v, "head"))),
                    Equals(Length(Member($v, "args")), 1)),
                  Equals(TypeOf(Member(Index(Member($v, "args"), 0), "value")), "number")))),
            Let(
              $isRecord,
              Lambda(
                List($v),
                And(
                  And(
                    $v,
                    Or(Equals(Member($v, "head"), "Date"), Equals(Member($v, "head"), "Time"))),
                  Call(
                    Member(Member($v, "args"), "every"),
                    Lambda(List($a), NotEquals(Member($a, "name"), Undefined())))))),
            Let(
              $clock,
              Lambda(
                List($t),
                Sequence(
                  Let($h24, Call(Member($Math, "floor"), Divide($t, 60))),
                  Let($mm, Modulo($t, 60)),
                  Let($h12, If(Equals(Modulo($h24, 12), 0), 12, Modulo($h24, 12))),
                  Return(
                    Object(
                      head="Time",
                      args=List(
                        Object(name="hour", value=$h24),
                        Object(name="minute", value=$mm),
                        Object(
                          name="spoken",
                          value=Add(
                            Add(
                              Add(
                                Add($h12, ":"),
                                Call(Member(Call($String, $mm), "padStart"), 2, "0")),
                              " "),
                            If(LessThan($h24, 12), "AM", "PM"))))))))),
            Let(
              $date,
              Lambda(
                List($d, $time),
                Object(
                  head="Date",
                  args=Concat(
                    List(
                      Object(name="year", value=Call(Member($d, "getFullYear"))),
                      Object(name="month", value=Add(Call(Member($d, "getMonth")), 1)),
                      Object(name="day", value=Call(Member($d, "getDate"))),
                      Object(name="weekday", value=Index($DAY, Call(Member($d, "getDay"))))),
                    If($time, List(Object(name="time", value=$time)), List()))))),
            Let(
              $minutesOf,
              Lambda(
                List($t),
                Add(
                  Multiply(Call($Number, Call($field, $t, "hour")), 60),
                  Call($Number, Call($field, $t, "minute"))))),
            Let(
              $shift,
              Lambda(
                List($record, $duration, $sign),
                Sequence(
                  Let(List($per, $kind), Index($units, Member($duration, "head"))),
                  Let(
                    $n,
                    Multiply(
                      Multiply(Member(Index(Member($duration, "args"), 0), "value"), $per),
                      $sign)),
                  If(
                    Equals(Member($record, "head"), "Date"),
                    Sequence(
                      Let($time, Call($field, $record, "time")),
                      Let($total, If(Equals($kind, "day"), Multiply($n, 1440), $n)),
                      If(And(NotEquals($kind, "day"), Not($time)), Return(Undefined()), Undefined()),
                      Let($t, Add(If($time, Call($minutesOf, $time), 0), $total)),
                      Let($carry, Call(Member($Math, "floor"), Divide($t, 1440))),
                      Let($rest, Modulo(Add(Modulo($t, 1440), 1440), 1440)),
                      Let(
                        $d,
                        New(
                          $Date,
                          Call($Number, Call($field, $record, "year")),
                          Subtract(Call($Number, Call($field, $record, "month")), 1),
                          Add(Call($Number, Call($field, $record, "day")), $carry))),
                      Return(Call($date, $d, If($time, Call($clock, $rest), Undefined())))),
                    Undefined()),
                  Let($total, If(Equals($kind, "day"), Multiply($n, 1440), $n)),
                  Return(
                    Call(
                      $clock,
                      Modulo(Add(Modulo(Add(Call($minutesOf, $record), $total), 1440), 1440), 1440)))))),
            Let(
              $now,
              Async(
                Lambda(
                  List($duration),
                  Call(
                    Member($api, "evaluate"),
                    Call(
                      Member($api, "call"),
                      If(
                        Equals(Index(Index($units, Member($duration, "head")), 1), "day"),
                        "Today",
                        "Time")))))),
            Let(List($a, $b), Map($args, Lambda(List($x), Member($x, "value")))),
            Let(
              List($d, $t),
              If(And($a, Equals(Member($a, "head"), "Date")), List($a, $b), List($b, $a))),
            If(
              Or(
                Or(
                  Or(Not(Call($isRecord, $d)), NotEquals(Member($d, "head"), "Date")),
                  Not(Call($isRecord, $t))),
                NotEquals(Member($t, "head"), "Time")),
              Return(Call(Member($api, "call"), "At", $a, $b)),
              Undefined()),
            Return(
              Object(
                head="Date",
                args=Concat(
                  Filter(
                    Member($d, "args"),
                    Lambda(List($x), NotEquals(Member($x, "name"), "time"))),
                  List(Object(name="time", value=$t)))))))))))

Concept(Be(),
  Realization(Be($x), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 0), "value"))))))))

Concept(Was(),
  Realization(Was($x), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 0), "value"))))))))

// A day, asked of a date, is its weekday; asked of nothing, today's.
Concept(Day(),
  Realization(Day(), context=Execution(), body=Day(Today())),
  Realization(Day($date), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let($d, Member(Index($args, 0), "value")),
          Let(
            $w,
            If(
              And($d, Equals(Member($d, "head"), "Date")),
              Call(
                Member(Member($d, "args"), "find"),
                Lambda(List($a), Equals(Member($a, "name"), "weekday"))),
              Undefined())),
          Return(If($w, Member($w, "value"), Call(Member($api, "call"), "Day", $d))))))))

// ================================================================
// From src/seed/grounding/vocabulary.ts
//
// The relation vocabulary the grounding layers write, seeded so a grounded graph describes
// itself (concept-spec Part 5.3): the properties the relations have are relations on them.
//
// Seeded whether or not any layer is grounded, because it is ordinary vocabulary and costs a
// handful of Concepts. The layers themselves are data and are loaded on request.

// Stored on the part; the whole's HasPart is derived, not written twice.
Concept(PartOf(), IsA(Relation()), InverseOf(HasPart()))

Concept(HasPart(), IsA(Relation()))

Concept(AntonymOf(), IsA(Relation()), Symmetric(), Irreflexive())

Concept(UsedFor(), IsA(Relation()))

Concept(CapableOf(), IsA(Relation()))

Concept(Causes(), IsA(Relation()))

// Where a Concept is tied to outside, not something to say about it.
Concept(SameAs(), IsA(Relation()), Incidental())

Concept(Named(), IsA(Relation()))

// Scoped to Lexical(): a fact about the word, read by reading-spec R14 when it lands.
Concept(PartOfSpeech(), IsA(Relation()))

Concept(WordClass(), IsA(Category()))

Concept(Noun(), IsA(WordClass()))

Concept(Verb(), IsA(WordClass()))

Concept(Adjective(), IsA(WordClass()))

Concept(Adverb(), IsA(WordClass()))

// The import stamp of each layer is an Imported relation on its source.
Concept(Imported(), IsA(Relation()))

Concept(Ngsl(), IsA(Source()))

Concept(OpenEnglishWordNet(), IsA(Source()))

Concept(ConceptNet(), IsA(Source()))

Concept(Cili(), IsA(Source()))

// ================================================================
// From src/seed/memory-indexes.ts
//
// Reading stamps and the indexes that come with them (memory-spec Part 4.2, 14).
//
// A stamp is structural, not semantic (memory-spec Part 4.2): the store writes it and no
// evaluator rule consults it. Reading one back is therefore an ordinary Concept, exactly
// the arrangement the trace already has (concept-spec Part 15.1) -- written as a side
// effect, read as a Concept. `Mentioning`, `Between`, `Stamps`, `RecordedAt` and `SourceOf`
// are that read side: their bodies do nothing but call the store through `api` and hand
// back an expression. None of them decide what a mention or a time range *means* --
// that judgment belongs to whatever composes them.
//
// Kept in its own file, separate from `seed.ts`, so a lane building the importer (which
// touches `seed.ts` itself) does not collide with this one. `seed.ts` calls
// `memoryIndexUnits()` once, with a single line, and adds what it returns.

// The claims an index found, oriented the same way `Relations` already reports them
// (concept-spec Part 5.3): a contextual claim wrapped in `In`, since flattening it would
// claim it holds everywhere it does not.
Concept(Mentioning(),
  Realization(Mentioning($subject),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $toList,
            Lambda(
              List($entries),
              Object(
                head="List",
                args=Map(
                  $entries,
                  Lambda(
                    List($e),
                    Object(
                      value=If(
                        Member(Member($e, "relation"), "context"),
                        Object(
                          head="In",
                          args=List(
                            Object(value=Member(Member($e, "relation"), "claim")),
                            Object(value=Member(Member($e, "relation"), "context")))),
                        Member(Member($e, "relation"), "claim")))))))),
          Return(
            Call(
              $toList,
              Call(Member(Member($api, "store"), "mentioning"), Member(Index($args, 0), "value")))))))))

Concept(Between(),
  Realization(Between($from, $to),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $iso,
            Lambda(
              List($x),
              If(
                Equals(TypeOf($x), "string"),
                $x,
                If(
                  And($x, Equals(Member($x, "head"), "Timestamp")),
                  OptionalMember(Index(Member($x, "args"), 0), "value"),
                  Undefined())))),
          Let($from, Call($iso, Member(Index($args, 0), "value"))),
          Let($to, Call($iso, Member(Index($args, 1), "value"))),
          If(
            Or(Equals($from, Undefined()), Equals($to, Undefined())),
            Return(
              Call(
                Member($api, "call"),
                "Between",
                Member(Index($args, 0), "value"),
                Member(Index($args, 1), "value"))),
            Undefined()),
          Let(
            $toList,
            Lambda(
              List($entries),
              Object(
                head="List",
                args=Map(
                  $entries,
                  Lambda(
                    List($e),
                    Object(
                      value=If(
                        Member(Member($e, "relation"), "context"),
                        Object(
                          head="In",
                          args=List(
                            Object(value=Member(Member($e, "relation"), "claim")),
                            Object(value=Member(Member($e, "relation"), "context")))),
                        Member(Member($e, "relation"), "claim")))))))),
          Return(Call($toList, Call(Member(Member($api, "store"), "between"), $from, $to))))))))

Concept(Stamps(),
  Realization(Stamps($seq),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $found,
            Call(Member(Member($api, "store"), "findStamp"), Member(Index($args, 0), "value"))),
          If(
            Not($found),
            Return(Call(Member($api, "call"), "Stamps", Member(Index($args, 0), "value"))),
            Undefined()),
          Let($s, Member($found, "stamp")),
          Return(
            Object(
              head="Stamp",
              args=Concat(
                List(
                  Object(name="seq", value=Member($s, "seq")),
                  Object(name="recordedAt", value=Member($s, "recordedAt"))),
                If(
                  Equals(Member($s, "source"), Undefined()),
                  List(),
                  List(Object(name="source", value=Member($s, "source"))))))))))))

Concept(RecordedAt(),
  Realization(RecordedAt($seq),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $found,
            Call(Member(Member($api, "store"), "findStamp"), Member(Index($args, 0), "value"))),
          Return(
            If(
              $found,
              Member(Member($found, "stamp"), "recordedAt"),
              Call(Member($api, "call"), "RecordedAt", Member(Index($args, 0), "value")))))))))

Concept(SourceOf(),
  Realization(SourceOf($seq),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $found,
            Call(Member(Member($api, "store"), "findStamp"), Member(Index($args, 0), "value"))),
          If(
            Not($found),
            Return(Call(Member($api, "call"), "SourceOf", Member(Index($args, 0), "value"))),
            Undefined()),
          Return(
            If(
              Equals(Member(Member($found, "stamp"), "source"), Undefined()),
              Call(Member($api, "call"), "Unknown"),
              Member(Member($found, "stamp"), "source"))))))))
