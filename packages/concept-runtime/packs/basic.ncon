// The words arithmetic is read aloud in, pointing at what does it.
Concept(Times(), SynonymOf(Multiply()))

Concept(Plus(), SynonymOf(Add()))

Concept(Minus(), SynonymOf(Subtract()))

Concept(Over(), SynonymOf(Divide()))

Concept(Mod(), SynonymOf(Modulo()))

Concept(Count(),
  Realization(Count($needle, $haystack),
    context = Execution(),
    properties = List(Program()),
    body = Bind($text,
      Lambda(List($x),
        If(
          Identical(TypeOf($x), "string"),
          $x,
          If(
            Truthy(
              Bind($t0,
                $x,
                If(Truthy($t0), Identical(Head($x), "String"), $t0)
              )
            ),
            FieldOf(Element(Arguments($x), 0), "value"),
            null
          )
        )
      ),
      Bind($needle2,
        Call($text, $needle),
        Bind($haystack2,
          Call($text, $haystack),
          If(
            Truthy(
              If(
                Identical($needle2, null),
                true,
                Identical($haystack2, null)
              )
            ),
            MakeCall("Count", List($needle, $haystack)),
            SubtractValues(Length(Split($haystack2, $needle2)), 1)
          )
        )
      )
    )
  )
)

// ------------------------------------------------------------------ *
// Self-reference. A message that talks about itself needs a referent for itself, and
// without one the instruction "use this prompt as a test case" cannot be expressed at all.
// This was the measured weak spot: long self-referential messages scored 13-43% fidelity
// at every model size.
// ------------------------------------------------------------------
Concept(Self(),
  Realization(Self(),
    context = Execution(),
    properties = List(Program()),
    body = Bind($message,
      Ambient("message"),
      If(
        Identical($message, Undefined()),
        MakeCall("Self", List()),
        MakeCall("Message", List($message))
      )
    )
  )
)

Concept(Message(), IsA(Data()))

// ------------------------------------------------------------------ *
// Preserved ambiguity. When context does not resolve which reading is meant, the system
// may pick, ask, or keep both — and which it does is itself a realization selected by
// context, so the policy is inspectable rather than hardcoded.
// ------------------------------------------------------------------
// Under Execution the best-supported reading wins: the first that realizes.
// Under Describe all readings are kept and shown.
Concept(Ambiguous(),
  Realization(Ambiguous(Rest($readings)),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Program()),
    body = Bind($tried,
      Cell(List()),
      Bind($t2,
        LoopOver(
          Arguments(Quote($readings)),
          Lambda(List($t0),
            Bind($a,
              $t0,
              Bind($value,
                Evaluate(FieldOf($a, "value")),
                If(
                  NotIdentical(FormatExpression($value), FormatExpression(FieldOf($a, "value"))),
                  LoopReturn($value),
                  Steps(
                    Bind($t1,
                      Concat(Get($tried), List($value)),
                      Steps(Set($tried, $t1), Length($t1))
                    ),
                    Undefined()
                  )
                )
              )
            )
          )
        ),
        If(
          IsLoopReturn($t2),
          LoopReturnValue($t2),
          MakeCall("Ambiguous", AsList(Get($tried)))
        )
      )
    )
  ),
  Realization(Ambiguous(Rest($readings)),
    context = Describe(),
    evaluateArguments = false,
    properties = List(Program()),
    body = MakeCall("Readings", AsList(Map(Arguments(Quote($readings)), Lambda(List($a), FieldOf($a, "value")))))
  )
)

Concept(Web(), IsA(Source()))

Concept(Wikidata(), IsA(Source()))

Concept(SearchResult(), IsA(Data()))

Concept(SearchResults(), IsA(Collection()))

Concept(WikidataSearch(),
  IsA(Research()),
  Realization(WikidataSearch($query),
    context = Execution(),
    properties = List(Effectful()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($text,
              If(
                Equals(TypeOf(Member(Index($args, 0), "value")), "string"),
                Member(Index($args, 0), "value"),
                If(
                  And(Member(Index($args, 0), "value"), Member(Member(Index($args, 0), "value"), "head")),
                  Member(Member(Index($args, 0), "value"), "head"),
                  ""
                )
              )
            ),
            Bind(Object(wikidata = $wikidata, asConcepts = $asConcepts), Await(DynamicImport("../research/sources.js"))),
            Return(Call($asConcepts, Await(Call($wikidata, $text, 5))))
          )
        )
      )
    )
  )
)

Concept(WebSearch(),
  IsA(Research()),
  Realization(WebSearch($query),
    context = Execution(),
    properties = List(Effectful()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($text,
              If(
                Equals(TypeOf(Member(Index($args, 0), "value")), "string"),
                Member(Index($args, 0), "value"),
                If(
                  And(Member(Index($args, 0), "value"), Member(Member(Index($args, 0), "value"), "head")),
                  Member(Member(Index($args, 0), "value"), "head"),
                  ""
                )
              )
            ),
            Bind(Object(web = $web, asConcepts = $asConcepts), Await(DynamicImport("../research/sources.js"))),
            Return(Call($asConcepts, Await(Call($web, $text, 5))))
          )
        )
      )
    )
  )
)

Concept(Research(), IsA(Capability()))

Concept(Capability(), IsA(Category()))

// A SynonymOf relation is the source of truth; the forwarding realization is derived from
// it, so the same fact is not asserted in two places that can disagree.
// Give a Concept the forwarding behaviour its SynonymOf relation implies. The relation is
// the source of truth and this is derived from it, so the fact is asserted once.
// A realization that only hands the call to another Concept, rather than doing anything.
// Can this Concept actually do something, following forwards to wherever they lead?
//
// A forward is not behaviour, it is a pointer at behaviour. Hi forwarded to Hello and
// Hello forwarded back to Hi -- each looked realized, neither could do anything, and
// evaluating Hi() ran to the depth budget. SynonymOf is symmetric, so both arrows get
// derived from one assertion and the cycle builds itself.
// Behaviour reached by inheritance is behaviour: What has no realization of its own and
// answers through Interrogative's, so WhatIs forwarding to it is not a pointer at nothing.
// Point one name at another's behaviour. Refused when the target has none of its own to
// lend, because a pointer at a pointer is not a destination.
// The target is named in the property, so the evaluator can see where a forward
// goes without reading its source.
// A forwarding is derived from a synonym, so it goes when the synonym does: emoji kept
// answering "what is an emoji" with Emoticon after SynonymOf(Emoticon()) was retracted.

// ------------------------------------------------------------------ *
// Durations and shifting dates and clock times by them.
//
// "what day will it be in 5 days" reads as What(Day(Will(Be(In(Days(5)))))): every word as
// said. A duration is data. In, Ago, Add and Subtract shift a date or a clock time by one,
// sharing one routine, and each checks the value it received rather than its pattern,
// because patterns cannot yet say "any date" (no typed variables; reading-spec Part 5.7).
// ------------------------------------------------------------------
Concept(Days(), IsA(Duration()), IsA(Data()))

Concept(Weeks(), IsA(Duration()), IsA(Data()))

Concept(Hours(), IsA(Duration()), IsA(Data()))

Concept(Minutes(), IsA(Duration()), IsA(Data()))

Concept(Duration(), IsA(Category()))

Concept(Ago(),
  IsA(Relation()),
  Realization(Ago($x),
    context = Execution(),
    properties = List(Program()),
    body = Bind($field,
      Lambda(List($r, $n),
        Bind($a,
          FirstSatisfying(Arguments($r), Lambda(List($x2), Identical(FieldOf($x2, "name"), $n))),
          If(Truthy($a), FieldOf($a, "value"), Undefined())
        )
      ),
      Bind($DAY,
        List(
          "Sunday",
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ),
        Bind($units,
          Record(
            Days = List(1, "day"),
            Weeks = List(7, "day"),
            Hours = List(60, "minute"),
            Minutes = List(1, "minute")
          ),
          Bind($isDuration,
            Lambda(List($v),
              Bind($t2,
                Bind($t1,
                  Bind($t0,
                    $v,
                    If(Truthy($t0), Element($units, Head($v)), $t0)
                  ),
                  If(Truthy($t1), Identical(Length(Arguments($v)), 1), $t1)
                ),
                If(
                  Truthy($t2),
                  Identical(TypeOf(FieldOf(Element(Arguments($v), 0), "value")), "number"),
                  $t2
                )
              )
            ),
            Bind($isRecord,
              Lambda(List($v2),
                Bind($t4,
                  Bind($t3,
                    $v2,
                    If(
                      Truthy($t3),
                      If(
                        Identical(Head($v2), "Date"),
                        true,
                        Identical(Head($v2), "Time")
                      ),
                      $t3
                    )
                  ),
                  If(
                    Truthy($t4),
                    AllSatisfy(Arguments($v2), Lambda(List($a2), NotIdentical(FieldOf($a2, "name"), Undefined()))),
                    $t4
                  )
                )
              ),
              Bind($clock,
                Lambda(List($t),
                  Bind($h24,
                    RoundDown(DivideValues($t, 60)),
                    Bind($mm,
                      RemainderOf($t, 60),
                      Bind($h12,
                        If(
                          Identical(RemainderOf($h24, 12), 0),
                          12,
                          RemainderOf($h24, 12)
                        ),
                        CallOf(
                          "Time",
                          List(
                            Record(name = "hour", value = $h24),
                            Record(name = "minute", value = $mm),
                            Record(
                              name = "spoken",
                              value = AddValues(
                                AddValues(AddValues(AddValues($h12, ":"), PadStart(ToText($mm), 2, "0")), " "),
                                If(Below($h24, 12), "AM", "PM")
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                ),
                Bind($date,
                  Lambda(List($d, $time),
                    CallOf(
                      "Date",
                      Concat(
                        List(
                          Record(name = "year", value = YearOf($d)),
                          Record(name = "month", value = AddValues(SubtractValues(MonthOf($d), 1), 1)),
                          Record(name = "day", value = DayOf($d)),
                          Record(name = "weekday", value = Element($DAY, WeekdayOf($d)))
                        ),
                        AsList(
                          If(
                            Truthy($time),
                            List(Record(name = "time", value = $time)),
                            List()
                          )
                        )
                      )
                    )
                  ),
                  Bind($minutesOf,
                    Lambda(List($t5),
                      AddValues(
                        MultiplyValues(ToNumber(Call($field, $t5, "hour")), 60),
                        ToNumber(Call($field, $t5, "minute"))
                      )
                    ),
                    Bind($shift,
                      Lambda(List($record, $duration, $sign),
                        Bind($t6,
                          Element($units, Head($duration)),
                          Bind($per,
                            Element($t6, 0),
                            Bind($kind,
                              Element($t6, 1),
                              Bind($n2,
                                MultiplyValues(
                                  MultiplyValues(FieldOf(Element(Arguments($duration), 0), "value"), $per),
                                  $sign
                                ),
                                If(
                                  Identical(Head($record), "Date"),
                                  Bind($time2,
                                    Call($field, $record, "time"),
                                    Bind($total,
                                      If(Identical($kind, "day"), MultiplyValues($n2, 1440), $n2),
                                      If(
                                        Truthy(If(NotIdentical($kind, "day"), Falsy($time2), false)),
                                        Undefined(),
                                        Bind($t7,
                                          AddValues(If(Truthy($time2), Call($minutesOf, $time2), 0), $total),
                                          Bind($carry,
                                            RoundDown(DivideValues($t7, 1440)),
                                            Bind($rest,
                                              RemainderOf(AddValues(RemainderOf($t7, 1440), 1440), 1440),
                                              Bind($d2,
                                                LocalInstant(
                                                  ToNumber(Call($field, $record, "year")),
                                                  AddValues(
                                                    SubtractValues(ToNumber(Call($field, $record, "month")), 1),
                                                    1
                                                  ),
                                                  AddValues(ToNumber(Call($field, $record, "day")), $carry)
                                                ),
                                                Call(
                                                  $date,
                                                  $d2,
                                                  If(Truthy($time2), Call($clock, $rest), Undefined())
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  ),
                                  Bind($total2,
                                    If(Identical($kind, "day"), MultiplyValues($n2, 1440), $n2),
                                    Call(
                                      $clock,
                                      RemainderOf(
                                        AddValues(
                                          RemainderOf(AddValues(Call($minutesOf, $record), $total2), 1440),
                                          1440
                                        ),
                                        1440
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      ),
                      Bind($now,
                        Lambda(List($duration2),
                          Evaluate(
                            MakeCall(
                              If(
                                Identical(Element(Element($units, Head($duration2)), 1), "day"),
                                "Today",
                                "Time"
                              ),
                              List()
                            )
                          )
                        ),
                        Bind($x3,
                          $x,
                          If(
                            Truthy(Call($isDuration, $x3)),
                            Bind($t8,
                              Call($shift, Call($now, $x3), $x3, NegateValue(1)),
                              If(IsNothing($t8), MakeCall("Ago", List($x3)), $t8)
                            ),
                            MakeCall("Ago", List($x3))
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

// "tomorrow at 3pm" is At(Tomorrow(), Time(3, Pm())): a date and a clock time, joined by the
// user's own word, realize to the date carrying its time. No DateTime Concept: half a moment
// ("at 3pm", "tomorrow") stays the half it is.
Concept(At(),
  Realization(At($a, $b),
    context = Execution(),
    properties = List(Program()),
    body = Bind($field,
      Lambda(List($r, $n),
        Bind($a2,
          FirstSatisfying(Arguments($r), Lambda(List($x), Identical(FieldOf($x, "name"), $n))),
          If(Truthy($a2), FieldOf($a2, "value"), Undefined())
        )
      ),
      Bind($DAY,
        List(
          "Sunday",
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ),
        Bind($units,
          Record(
            Days = List(1, "day"),
            Weeks = List(7, "day"),
            Hours = List(60, "minute"),
            Minutes = List(1, "minute")
          ),
          Bind($isDuration,
            Lambda(List($v),
              Bind($t2,
                Bind($t1,
                  Bind($t0,
                    $v,
                    If(Truthy($t0), Element($units, Head($v)), $t0)
                  ),
                  If(Truthy($t1), Identical(Length(Arguments($v)), 1), $t1)
                ),
                If(
                  Truthy($t2),
                  Identical(TypeOf(FieldOf(Element(Arguments($v), 0), "value")), "number"),
                  $t2
                )
              )
            ),
            Bind($isRecord,
              Lambda(List($v2),
                Bind($t4,
                  Bind($t3,
                    $v2,
                    If(
                      Truthy($t3),
                      If(
                        Identical(Head($v2), "Date"),
                        true,
                        Identical(Head($v2), "Time")
                      ),
                      $t3
                    )
                  ),
                  If(
                    Truthy($t4),
                    AllSatisfy(Arguments($v2), Lambda(List($a3), NotIdentical(FieldOf($a3, "name"), Undefined()))),
                    $t4
                  )
                )
              ),
              Bind($clock,
                Lambda(List($t),
                  Bind($h24,
                    RoundDown(DivideValues($t, 60)),
                    Bind($mm,
                      RemainderOf($t, 60),
                      Bind($h12,
                        If(
                          Identical(RemainderOf($h24, 12), 0),
                          12,
                          RemainderOf($h24, 12)
                        ),
                        CallOf(
                          "Time",
                          List(
                            Record(name = "hour", value = $h24),
                            Record(name = "minute", value = $mm),
                            Record(
                              name = "spoken",
                              value = AddValues(
                                AddValues(AddValues(AddValues($h12, ":"), PadStart(ToText($mm), 2, "0")), " "),
                                If(Below($h24, 12), "AM", "PM")
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                ),
                Bind($date,
                  Lambda(List($d, $time),
                    CallOf(
                      "Date",
                      Concat(
                        List(
                          Record(name = "year", value = YearOf($d)),
                          Record(name = "month", value = AddValues(SubtractValues(MonthOf($d), 1), 1)),
                          Record(name = "day", value = DayOf($d)),
                          Record(name = "weekday", value = Element($DAY, WeekdayOf($d)))
                        ),
                        AsList(
                          If(
                            Truthy($time),
                            List(Record(name = "time", value = $time)),
                            List()
                          )
                        )
                      )
                    )
                  ),
                  Bind($minutesOf,
                    Lambda(List($t5),
                      AddValues(
                        MultiplyValues(ToNumber(Call($field, $t5, "hour")), 60),
                        ToNumber(Call($field, $t5, "minute"))
                      )
                    ),
                    Bind($shift,
                      Lambda(List($record, $duration, $sign),
                        Bind($t6,
                          Element($units, Head($duration)),
                          Bind($per,
                            Element($t6, 0),
                            Bind($kind,
                              Element($t6, 1),
                              Bind($n2,
                                MultiplyValues(
                                  MultiplyValues(FieldOf(Element(Arguments($duration), 0), "value"), $per),
                                  $sign
                                ),
                                If(
                                  Identical(Head($record), "Date"),
                                  Bind($time2,
                                    Call($field, $record, "time"),
                                    Bind($total,
                                      If(Identical($kind, "day"), MultiplyValues($n2, 1440), $n2),
                                      If(
                                        Truthy(If(NotIdentical($kind, "day"), Falsy($time2), false)),
                                        Undefined(),
                                        Bind($t7,
                                          AddValues(If(Truthy($time2), Call($minutesOf, $time2), 0), $total),
                                          Bind($carry,
                                            RoundDown(DivideValues($t7, 1440)),
                                            Bind($rest,
                                              RemainderOf(AddValues(RemainderOf($t7, 1440), 1440), 1440),
                                              Bind($d2,
                                                LocalInstant(
                                                  ToNumber(Call($field, $record, "year")),
                                                  AddValues(
                                                    SubtractValues(ToNumber(Call($field, $record, "month")), 1),
                                                    1
                                                  ),
                                                  AddValues(ToNumber(Call($field, $record, "day")), $carry)
                                                ),
                                                Call(
                                                  $date,
                                                  $d2,
                                                  If(Truthy($time2), Call($clock, $rest), Undefined())
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  ),
                                  Bind($total2,
                                    If(Identical($kind, "day"), MultiplyValues($n2, 1440), $n2),
                                    Call(
                                      $clock,
                                      RemainderOf(
                                        AddValues(
                                          RemainderOf(AddValues(Call($minutesOf, $record), $total2), 1440),
                                          1440
                                        ),
                                        1440
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      ),
                      Bind($now,
                        Lambda(List($duration2),
                          Evaluate(
                            MakeCall(
                              If(
                                Identical(Element(Element($units, Head($duration2)), 1), "day"),
                                "Today",
                                "Time"
                              ),
                              List()
                            )
                          )
                        ),
                        Bind($t8,
                          Map(
                            List(Argument(value = $a), Argument(value = $b)),
                            Lambda(List($x2), FieldOf($x2, "value"))
                          ),
                          Bind($a4,
                            Element($t8, 0),
                            Bind($b2,
                              Element($t8, 1),
                              Bind($t10,
                                If(
                                  Truthy(
                                    Bind($t9,
                                      $a4,
                                      If(Truthy($t9), Identical(Head($a4), "Date"), $t9)
                                    )
                                  ),
                                  List($a4, $b2),
                                  List($b2, $a4)
                                ),
                                Bind($d3,
                                  Element($t10, 0),
                                  Bind($t11,
                                    Element($t10, 1),
                                    If(
                                      Truthy(
                                        Bind($t13,
                                          Bind($t12,
                                            If(
                                              Falsy(Call($isRecord, $d3)),
                                              true,
                                              NotIdentical(Head($d3), "Date")
                                            ),
                                            If(Truthy($t12), $t12, Falsy(Call($isRecord, $t11)))
                                          ),
                                          If(Truthy($t13), $t13, NotIdentical(Head($t11), "Time"))
                                        )
                                      ),
                                      MakeCall("At", List($a4, $b2)),
                                      CallOf(
                                        "Date",
                                        Concat(
                                          AsList(
                                            Filter(
                                              Arguments($d3),
                                              Lambda(List($x3), NotIdentical(FieldOf($x3, "name"), "time"))
                                            )
                                          ),
                                          List(Record(name = "time", value = $t11))
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(Be(),
  Realization(Be($x),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

Concept(Was(),
  Realization(Was($x),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

// A day, asked of a date, is its weekday; asked of nothing, today's.
Concept(Day(),
  Realization(Day(),
    context = Execution(),
    body = Day(Today())
  ),
  Realization(Day($date),
    context = Execution(),
    properties = List(Program()),
    body = Bind($d,
      $date,
      Bind($w,
        If(
          Truthy(
            Bind($t0,
              $d,
              If(Truthy($t0), Identical(Head($d), "Date"), $t0)
            )
          ),
          FirstSatisfying(Arguments($d), Lambda(List($a), Identical(FieldOf($a, "name"), "weekday"))),
          Undefined()
        ),
        If(
          Truthy($w),
          FieldOf($w, "value"),
          MakeCall("Day", List($d))
        )
      )
    )
  )
)

// ================================================================
// From src/seed/grounding/vocabulary.ts
//
// The relation vocabulary the grounding layers write, seeded so a grounded graph describes
// itself (concept-spec Part 5.3): the properties the relations have are relations on them.
//
// Seeded whether or not any layer is grounded, because it is ordinary vocabulary and costs a
// handful of Concepts. The layers themselves are data and are loaded on request.

// Stored on the part; the whole's HasPart is derived, not written twice.
Concept(PartOf(), IsA(Relation()), InverseOf(HasPart()))

Concept(HasPart(), IsA(Relation()))

Concept(AntonymOf(),
  IsA(Relation()),
  Symmetric(),
  Irreflexive()
)

Concept(UsedFor(), IsA(Relation()))

Concept(CapableOf(), IsA(Relation()))

Concept(Causes(), IsA(Relation()))

// Where a Concept is tied to outside, not something to say about it.
Concept(SameAs(), IsA(Relation()), Incidental())

Concept(Named(), IsA(Relation()))

// Scoped to Lexical(): a fact about the word, read by reading-spec R14 when it lands.
Concept(PartOfSpeech(), IsA(Relation()))

Concept(WordClass(), IsA(Category()))

Concept(Noun(), IsA(WordClass()))

Concept(Verb(), IsA(WordClass()))

Concept(Adjective(), IsA(WordClass()))

Concept(Adverb(), IsA(WordClass()))

// The import stamp of each layer is an Imported relation on its source.
Concept(Imported(), IsA(Relation()))

Concept(Ngsl(), IsA(Source()))

Concept(OpenEnglishWordNet(), IsA(Source()))

Concept(ConceptNet(), IsA(Source()))

Concept(Cili(), IsA(Source()))

// ================================================================
// From src/seed/memory-indexes.ts
//
// Reading stamps and the indexes that come with them (memory-spec Part 4.2, 14).
//
// A stamp is structural, not semantic (memory-spec Part 4.2): the store writes it and no
// evaluator rule consults it. Reading one back is therefore an ordinary Concept, exactly
// the arrangement the trace already has (concept-spec Part 15.1) -- written as a side
// effect, read as a Concept. `Mentioning`, `Between`, `Stamps`, `RecordedAt` and `SourceOf`
// are that read side: their bodies do nothing but call the store through `api` and hand
// back an expression. None of them decide what a mention or a time range *means* --
// that judgment belongs to whatever composes them.
//
// Kept in its own file, separate from `seed.ts`, so a lane building the importer (which
// touches `seed.ts` itself) does not collide with this one. `seed.ts` calls
// `memoryIndexUnits()` once, with a single line, and adds what it returns.

// The claims an index found, oriented the same way `Relations` already reports them
// (concept-spec Part 5.3): a contextual claim wrapped in `In`, since flattening it would
// claim it holds everywhere it does not.
Concept(Mentioning(),
  Realization(Mentioning($subject),
    properties = List(Program()),
    body = Bind($toList,
      Lambda(List($entries),
        CallOf(
          "List",
          Map(
            $entries,
            Lambda(List($e),
              Record(
                value = If(
                  Truthy(FieldOf(FieldOf($e, "relation"), "context")),
                  CallOf(
                    "In",
                    List(
                      Record(value = FieldOf(FieldOf($e, "relation"), "claim")),
                      Record(value = FieldOf(FieldOf($e, "relation"), "context"))
                    )
                  ),
                  FieldOf(FieldOf($e, "relation"), "claim")
                )
              )
            )
          )
        )
      ),
      Call($toList, MentionsOf($subject))
    )
  )
)

Concept(Between(),
  Realization(Between($from, $to),
    properties = List(Program()),
    body = Bind($iso,
      Lambda(List($x),
        If(
          Identical(TypeOf($x), "string"),
          $x,
          If(
            Truthy(
              Bind($t0,
                $x,
                If(Truthy($t0), Identical(Head($x), "Timestamp"), $t0)
              )
            ),
            Bind($t1,
              Element(Arguments($x), 0),
              If(IsNothing($t1), Undefined(), FieldOf($t1, "value"))
            ),
            Undefined()
          )
        )
      ),
      Bind($from2,
        Call($iso, $from),
        Bind($to2,
          Call($iso, $to),
          If(
            Truthy(
              If(
                Identical($from2, Undefined()),
                true,
                Identical($to2, Undefined())
              )
            ),
            MakeCall("Between", List($from, $to)),
            Bind($toList,
              Lambda(List($entries),
                CallOf(
                  "List",
                  Map(
                    $entries,
                    Lambda(List($e),
                      Record(
                        value = If(
                          Truthy(FieldOf(FieldOf($e, "relation"), "context")),
                          CallOf(
                            "In",
                            List(
                              Record(value = FieldOf(FieldOf($e, "relation"), "claim")),
                              Record(value = FieldOf(FieldOf($e, "relation"), "context"))
                            )
                          ),
                          FieldOf(FieldOf($e, "relation"), "claim")
                        )
                      )
                    )
                  )
                )
              ),
              Call($toList, StampsBetween($from2, $to2))
            )
          )
        )
      )
    )
  )
)

Concept(Stamps(),
  Realization(Stamps($seq),
    properties = List(Program()),
    body = Bind($found,
      StampOf($seq),
      If(
        Falsy($found),
        MakeCall("Stamps", List($seq)),
        Bind($s,
          FieldOf($found, "stamp"),
          CallOf(
            "Stamp",
            Concat(
              List(
                Record(name = "seq", value = FieldOf($s, "seq")),
                Record(name = "recordedAt", value = FieldOf($s, "recordedAt"))
              ),
              AsList(
                If(
                  Identical(FieldOf($s, "source"), Undefined()),
                  List(),
                  List(Record(name = "source", value = FieldOf($s, "source")))
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(RecordedAt(),
  Realization(RecordedAt($seq),
    properties = List(Program()),
    body = Bind($found,
      StampOf($seq),
      If(
        Truthy($found),
        FieldOf(FieldOf($found, "stamp"), "recordedAt"),
        MakeCall("RecordedAt", List($seq))
      )
    )
  )
)

Concept(SourceOf(),
  Realization(SourceOf($seq),
    properties = List(Program()),
    body = Bind($found,
      StampOf($seq),
      If(
        Falsy($found),
        MakeCall("SourceOf", List($seq)),
        If(
          Identical(FieldOf(FieldOf($found, "stamp"), "source"), Undefined()),
          MakeCall("Unknown", List()),
          FieldOf(FieldOf($found, "stamp"), "source")
        )
      )
    )
  )
)
