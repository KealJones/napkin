Concept(AtLeast(),
  Realization(AtLeast($left, $right),
    context = Execution(),
    properties = List(Program()),
    body = Bind($asNumber,
      Recursive(
        $asNumber,
        Lambda(List($x),
          If(
            Identical(TypeOf($x), "number"),
            $x,
            If(
              Truthy(
                Bind($t0,
                  $x,
                  If(Truthy($t0), Identical(Head($x), "Number"), $t0)
                )
              ),
              Call($asNumber, FieldOf(Element(Arguments($x), 0), "value")),
              NotANumber()
            )
          )
        )
      ),
      Bind($l,
        Call($asNumber, $left),
        Bind($r,
          Call($asNumber, $right),
          If(
            Truthy(If(IsNotANumber($l), true, IsNotANumber($r))),
            MakeCall("AtLeast", List($left, $right)),
            If(
              NotBelow($l, $r),
              CallOf("True", List()),
              CallOf("False", List())
            )
          )
        )
      )
    )
  )
)

