Requires(Core(), Code())

// ================================================================
// From src/seed/seed.ts
//
// The Concepts the network starts with (design/seed-concepts.md).
//
// A seed Concept is an ordinary Concept that happens to exist at time zero. It can be
// shadowed, appended to, retired, and forgotten like any other. Seeding is idempotent and
// additive: create when absent, otherwise add only what is not already there.
//
// Nothing here is stubbed. A Concept that cannot yet be honestly realized is omitted, so
// that it produces a residual the learning path can act on rather than a wrong answer.


// Symmetric but NOT transitive, which is the whole difficulty with synonymy.
//
// Bright is a synonym of smart, and bright is a synonym of luminous, and smart is not a
// synonym of luminous. Declared transitive, the chains close: a 554-Concept graph produced
// Identity equivalent to Sameness, Role, Duty, Task and finally Chore, each hop arguable
// and the closure nonsense. Synonym islands are a success (they are how language works);
// synonym CONTINENTS are the failure, and transitivity is what makes them.
// Machinery relations are not led with in a summary; interest is a property of the
// question, so this is a soft default and never a prohibition.
Concept(SynonymOf(), Symmetric(), Incidental())

// InverseOf reads a relation backwards; these are the other two things "inverse" means,
// kept apart so the backwards reading is never applied to a colour or an operation.
Concept(OppositeOf(), Symmetric())

Concept(InverseOperation(), Symmetric())

Concept(Reflexive(), IsA(RelationProperty()))

Concept(Suppresses(), Incidental(), IsA(RelationProperty()))

Concept(Effectful(), IsA(RealizationProperty()))

Concept(Lossy(), IsA(RealizationProperty()))

Concept(Pure(), IsA(RealizationProperty()))

Concept(Teaching(), IsA(ContextFacet()))

Concept(Lexical(), IsA(ContextFacet()))

Concept(Rust(), IsA(TargetLanguage()))

// Every JavaScript program is a TypeScript program: what JavaScript emits is valid here.
Concept(TypeScript(), IsA(TargetLanguage()), SupersetOf(JavaScript()))

Concept(Python(), IsA(TargetLanguage()))

Concept(Describe(), IsA(ContextFacet()), Suppresses(Effectful()), Suppresses(Lossy()))

Concept(Saved(), IsA(Result()))

Concept(Rejected())

Concept(NeedsFirst())

Concept(SelfReferential())

Concept(TooMany())

// A claim together with the context it holds in, for reporting rather than storing.
Concept(In(),
  IsA(Marker()),
  Realization(In($x), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $field,
              Lambda(
                List($r, $n),
                Sequence(
                  Let(
                    $a,
                    Call(
                      Member(Member($r, "args"), "find"),
                      Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))))),
            Let(
              $DAY,
              List("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday")),
            Let(
              $units,
              Object(
                Days=List(1, "day"),
                Weeks=List(7, "day"),
                Hours=List(60, "minute"),
                Minutes=List(1, "minute"))),
            Let(
              $isDuration,
              Lambda(
                List($v),
                And(
                  And(
                    And($v, Index($units, Member($v, "head"))),
                    Equals(Length(Member($v, "args")), 1)),
                  Equals(TypeOf(Member(Index(Member($v, "args"), 0), "value")), "number")))),
            Let(
              $isRecord,
              Lambda(
                List($v),
                And(
                  And(
                    $v,
                    Or(Equals(Member($v, "head"), "Date"), Equals(Member($v, "head"), "Time"))),
                  Call(
                    Member(Member($v, "args"), "every"),
                    Lambda(List($a), NotEquals(Member($a, "name"), Undefined())))))),
            Let(
              $clock,
              Lambda(
                List($t),
                Sequence(
                  Let($h24, Call(Member($Math, "floor"), Divide($t, 60))),
                  Let($mm, Modulo($t, 60)),
                  Let($h12, If(Equals(Modulo($h24, 12), 0), 12, Modulo($h24, 12))),
                  Return(
                    Object(
                      head="Time",
                      args=List(
                        Object(name="hour", value=$h24),
                        Object(name="minute", value=$mm),
                        Object(
                          name="spoken",
                          value=Add(
                            Add(
                              Add(
                                Add($h12, ":"),
                                Call(Member(Call($String, $mm), "padStart"), 2, "0")),
                              " "),
                            If(LessThan($h24, 12), "AM", "PM"))))))))),
            Let(
              $date,
              Lambda(
                List($d, $time),
                Object(
                  head="Date",
                  args=Concat(
                    List(
                      Object(name="year", value=Call(Member($d, "getFullYear"))),
                      Object(name="month", value=Add(Call(Member($d, "getMonth")), 1)),
                      Object(name="day", value=Call(Member($d, "getDate"))),
                      Object(name="weekday", value=Index($DAY, Call(Member($d, "getDay"))))),
                    If($time, List(Object(name="time", value=$time)), List()))))),
            Let(
              $minutesOf,
              Lambda(
                List($t),
                Add(
                  Multiply(Call($Number, Call($field, $t, "hour")), 60),
                  Call($Number, Call($field, $t, "minute"))))),
            Let(
              $shift,
              Lambda(
                List($record, $duration, $sign),
                Sequence(
                  Let(List($per, $kind), Index($units, Member($duration, "head"))),
                  Let(
                    $n,
                    Multiply(
                      Multiply(Member(Index(Member($duration, "args"), 0), "value"), $per),
                      $sign)),
                  If(
                    Equals(Member($record, "head"), "Date"),
                    Sequence(
                      Let($time, Call($field, $record, "time")),
                      Let($total, If(Equals($kind, "day"), Multiply($n, 1440), $n)),
                      If(And(NotEquals($kind, "day"), Not($time)), Return(Undefined()), Undefined()),
                      Let($t, Add(If($time, Call($minutesOf, $time), 0), $total)),
                      Let($carry, Call(Member($Math, "floor"), Divide($t, 1440))),
                      Let($rest, Modulo(Add(Modulo($t, 1440), 1440), 1440)),
                      Let(
                        $d,
                        New(
                          $Date,
                          Call($Number, Call($field, $record, "year")),
                          Subtract(Call($Number, Call($field, $record, "month")), 1),
                          Add(Call($Number, Call($field, $record, "day")), $carry))),
                      Return(Call($date, $d, If($time, Call($clock, $rest), Undefined())))),
                    Undefined()),
                  Let($total, If(Equals($kind, "day"), Multiply($n, 1440), $n)),
                  Return(
                    Call(
                      $clock,
                      Modulo(Add(Modulo(Add(Call($minutesOf, $record), $total), 1440), 1440), 1440)))))),
            Let(
              $now,
              Async(
                Lambda(
                  List($duration),
                  Call(
                    Member($api, "evaluate"),
                    Call(
                      Member($api, "call"),
                      If(
                        Equals(Index(Index($units, Member($duration, "head")), 1), "day"),
                        "Today",
                        "Time")))))),
            Let($x, Member(Index($args, 0), "value")),
            Return(
              If(
                Call($isDuration, $x),
                Otherwise(
                  Call($shift, Await(Call($now, $x)), $x, 1),
                  Call(Member($api, "call"), "In", $x)),
                Call(Member($api, "call"), "In", $x)))))))))

// The sense of a word that is something else sharing its name: a film, a game, a surname.
// It covers the categories whose members take their names from ordinary words, so research
// on a word keeps finding one: a game called Volcano, a band called Moment. Held here
// rather than on each category, so seeding it does not make those words known and stop
// them being learned.
Concept(Namesake(),
  IsA(ContextFacet()),
  Covers(ElectronicGame()),
  Covers(VideoGame()),
  Covers(Film()),
  Covers(Movie()),
  Covers(Album()),
  Covers(Song()),
  Covers(MusicSingle()),
  Covers(Book()),
  Covers(Novel()),
  Covers(TelevisionSeries()),
  Covers(Band()),
  Covers(MusicalGroup()),
  Covers(Company()),
  Covers(Surname()),
  Covers(FamilyName()),
  Covers(GivenName()),
  Covers(FirstName()),
  Covers(Musical()),
  Covers(Magazine()),
  Covers(AcademicJournal()),
  Covers(WrittenWork()),
  Covers(Painting()))

Concept(Covers(), Incidental())

Concept(NotComposed())

Concept(Incomplete())

Concept(InvalidDeclaration(), IsA(Data()))

Concept(Missing(), IsA(Data()))

Concept(Relations(),
  Realization(Relations($subject), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let($subject, Member(Index($args, 0), "value")),
            If(
              Or(Not($subject), Not(Member($subject, "head"))),
              Return(Call(Member($api, "call"), "Unknown")),
              Undefined()),
            Let(
              $resolved,
              OptionalMember(
                Call(
                  Member(Member($subject, "args"), "find"),
                  Lambda(List($a), Equals(Member($a, "name"), "resolvedTo"))),
                "value")),
            Let(
              $user,
              If(
                Equals(Member($subject, "head"), "Me"),
                OptionalMember(
                  Call(
                    Member(Call(Member(Member($api, "store"), "asObject"), "User"), "find"),
                    Lambda(List($t), Equals(Member($t, "predicate"), "IsA"))),
                  "subject"),
                Undefined())),
            Let(
              $self,
              If(
                And(
                  Equals(Member($subject, "head"), "You"),
                  Equals(Length(Member($subject, "args")), 0)),
                "Self",
                Undefined())),
            Let(
              $about,
              If(
                And($resolved, Member($resolved, "head")),
                Member($resolved, "head"),
                Otherwise(Otherwise($user, $self), Member($subject, "head")))),
            Let(
              $triples,
              Filter(
                Call(Member(Member($api, "relations"), "of"), $about, Object(transitive=false)),
                Lambda(
                  List($t),
                  Sequence(
                    Let($unit, Call(Member(Member($api, "store"), "get"), Member($t, "predicate"))),
                    Return(
                      Not(
                        Call(
                          Member(Otherwise(OptionalMember($unit, "relations"), List()), "some"),
                          Lambda(
                            List($r),
                            Equals(Member(Member($r, "claim"), "head"), "Incidental"))))))))),
            If(
              Not(Length($triples)),
              Return(Call(Member($api, "call"), "NoDescription", $subject)),
              Undefined()),
            Let(
              $ordered,
              Concat(
                Filter($triples, Lambda(List($t), Not(Member($t, "context")))),
                Filter($triples, Lambda(List($t), Member($t, "context"))))),
            Let(
              $described,
              Map(
                $ordered,
                Lambda(
                  List($t),
                  If(
                    Member($t, "context"),
                    Call(Member($api, "call"), "In", Member($t, "expr"), Member($t, "context")),
                    Member($t, "expr"))))),
            Return(
              Call(
                Member($api, "call"),
                "Describes",
                $subject,
                Call(Member($api, "call"), "List", Spread($described))))))))))


// ------------------------------------------------------------------ *
// Evaluation control. All take their arguments unevaluated.
// ------------------------------------------------------------------
Concept(Sequence(),
  Realization(Sequence(Rest($steps)), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $isCall,
              Lambda(
                List($e),
                And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Let(
              $unmood,
              Lambda(
                List($e),
                If(
                  And(
                    And(Call($isCall, $e), Equals(Member($e, "head"), "Mood")),
                    Equals(Length(Member($e, "args")), 2)),
                  Member(Index(Member($e, "args"), 1), "value"),
                  $e))),
            Let(
              $binary,
              Lambda(
                List($head),
                Call(
                  Member(
                    Otherwise(
                      OptionalMember(
                        Call(Member(Member($api, "store"), "get"), $head),
                        "realizations"),
                      List()),
                    "some"),
                  Lambda(
                    List($r),
                    And(
                      Call($isCall, Member($r, "pattern")),
                      Equals(Length(Member(Member($r, "pattern"), "args")), 2)))))),
            Let(
              $carry,
              Lambda(
                List($e, $prev),
                Sequence(
                  If(Not(Call($isCall, $e)), Return($e), Undefined()),
                  If(
                    And(
                      And(Equals(Member($e, "head"), "Ref"), Equals(Length(Member($e, "args")), 1)),
                      Call(
                        Member(Regex("^(it|that|this|)$", ""), "test"),
                        Call($String, Member(Index(Member($e, "args"), 0), "value")))),
                    Return($prev),
                    Undefined()),
                  Return(
                    Object(
                      head=Member($e, "head"),
                      args=Map(
                        Member($e, "args"),
                        Lambda(
                          List($a),
                          Object(Spread($a), value=Call($carry, Member($a, "value"), $prev))))))))),
            Var($last, null),
            Let($answers, List()),
            ForOf(
              List($i, $a),
              Call(Member($args, "entries")),
              Sequence(
                Var($line, Member($a, "value")),
                If(
                  And(
                    And(GreaterThan($i, 0), NotEquals($last, null)),
                    Or(Equals(TypeOf($last), "number"), Call($isCall, $last))),
                  Sequence(
                    Let(
                      $prev,
                      If(
                        And(
                          And(Call($isCall, $last), Equals(Member($last, "head"), "Answer")),
                          Equals(Length(Member($last, "args")), 1)),
                        Member(Index(Member($last, "args"), 0), "value"),
                        $last)),
                    Assign($line, Call($carry, $line, $prev)),
                    Let($core, Call($unmood, $line)),
                    If(
                      And(
                        And(
                          And(
                            And(Call($isCall, $core), Equals(Length(Member($core, "args")), 1)),
                            Equals(Member(Index(Member($core, "args"), 0), "name"), Undefined())),
                          Call($binary, Member($core, "head"))),
                        Equals(TypeOf($prev), "number")),
                      Sequence(
                        Let(
                          $applied,
                          Call(
                            Member($api, "call"),
                            Member($core, "head"),
                            $prev,
                            Member(Index(Member($core, "args"), 0), "value"))),
                        Assign(
                          $line,
                          If(
                            Equals($line, $core),
                            $applied,
                            Call(
                              Member($api, "call"),
                              "Mood",
                              Member(Index(Member($line, "args"), 0), "value"),
                              $applied)))),
                      Undefined())),
                  Undefined()),
                Let($value, Await(Call(Member($api, "evaluate"), $line))),
                If(
                  And(
                    Call($isCall, $value),
                    Includes(List("Answer", "Believed", "Noted"), Member($value, "head"))),
                  Call(Member($answers, "push"), $value),
                  Undefined()),
                Assign($last, $value))),
            Return(
              If(
                GreaterThan(Length($answers), 1),
                Call(Member($api, "call"), "Sequence", Spread($answers)),
                $last))))))))

Concept(If(),
  Realization(If($condition, $then, $otherwise), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let($test, Await(Call(Member($api, "evaluate"), Member(Index($args, 0), "value")))),
            Let($truthy, Or(Equals($test, true), And($test, Equals(Member($test, "head"), "True")))),
            Return(
              Await(
                Call(
                  Member($api, "evaluate"),
                  If($truthy, Member(Index($args, 1), "value"), Member(Index($args, 2), "value")))))))))))

Concept(Try(),
  Realization(Try($body, $catch), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Try(
            Return(Await(Call(Member($api, "evaluate"), Member(Index($args, 0), "value")))),
            Catch(
              $caught,
              Sequence(
                Let(
                  $failure,
                  If(
                    And($caught, Member($caught, "value")),
                    Member($caught, "value"),
                    Call(Member($api, "call"), "ExecutionFailed"))),
                Let($handler, Member(Index($args, 1), "value")),
                If(
                  And($handler, Equals(Member($handler, "head"), "Catch")),
                  Sequence(
                    Let(
                      $name,
                      Member(Member(Index(Member($handler, "args"), 0), "value"), "variable")),
                    Return(
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "substitute"),
                            Member(Index(Member($handler, "args"), 1), "value"),
                            New($Map, List(List($name, $failure)))))))),
                  Undefined()),
                Return(Await(Call(Member($api, "evaluate"), $handler)))))))))))

Concept(Catch(), IsA(Data()))


// ------------------------------------------------------------------ *
// State. Cells reach the store through the same interface everything else uses.
