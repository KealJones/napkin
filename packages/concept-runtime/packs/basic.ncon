          if (Number.isNaN(l) || Number.isNaN(r)) return api.call("Power", args[0].value, args[1].value);
          return Math.pow(l, r);
        }""")))

// "the square root of 144", "15% of 80": said with "of", so the pattern keeps it. A
// negative has no real square root, which is the answer, as division by zero is.
Concept(SquareRoot(),
  Realization(SquareRoot($x), context=Execution(),
    body=Code(
      source="""(args, bindings, api) => {
          const asNumber = (v) => (typeof v === "number" ? v : v && v.head === "Number" ? asNumber(v.args[0].value) : v && v.head === "Of" ? asNumber(v.args[0].value) : NaN);
          const x = asNumber(args[args.length - 1].value);
          const p = 0;
          if (Number.isNaN(x) || Number.isNaN(p)) return api.call("SquareRoot", ...args.map((a) => a.value));
          return x < 0 ? api.call('Undefined') : Math.sqrt(x);
        }""")),
  Realization(SquareRoot(Of($x)), context=Execution(),
    body=Code(
      source="""(args, bindings, api) => {
          const asNumber = (v) => (typeof v === "number" ? v : v && v.head === "Number" ? asNumber(v.args[0].value) : v && v.head === "Of" ? asNumber(v.args[0].value) : NaN);
          const x = asNumber(args[args.length - 1].value);
          const p = 0;
          if (Number.isNaN(x) || Number.isNaN(p)) return api.call("SquareRoot", ...args.map((a) => a.value));
          return x < 0 ? api.call('Undefined') : Math.sqrt(x);
        }""")))

