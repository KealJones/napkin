  Realization(Power($left, $right), context=Execution(),
    body=Code(
      source="""(args, bindings, api) => {
          const asNumber = (x) => {
            if (typeof x === "number") return x;
            if (x && x.head === "Number") return asNumber(x.args[0].value);
