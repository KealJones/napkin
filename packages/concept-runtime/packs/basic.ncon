Concept(Hello(), IsA(Greeting()))

Concept(Hey(), IsA(Greeting()))

Concept(HeyThere(), IsA(Greeting()))

Concept(Howdy(), IsA(Greeting()))

Concept(Yo(), IsA(Greeting()))

Concept(GoodMorning(), IsA(Greeting()))

Concept(GoodAfternoon(), IsA(Greeting()))

Concept(GoodEvening(), IsA(Greeting()))

