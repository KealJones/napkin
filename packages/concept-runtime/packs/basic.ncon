// Division by zero is undefined, which is the answer, not Infinity and not a failure.
Concept(Divide(),
  Realization(Divide($left, $right), context=Execution(),
    body=Code(
      source="""(args, bindings, api) => {
          const asNumber = (x) => {
            if (typeof x === "number") return x;
            if (x && x.head === "Number") return asNumber(x.args[0].value);
            return NaN;
          };
          const l = asNumber(args[0].value), r = asNumber(args[1].value);
          if (Number.isNaN(l) || Number.isNaN(r)) return api.call("Divide", args[0].value, args[1].value);
          return r === 0 ? api.call('Undefined') : l / r;
        }""")))

Concept(Modulo(),
  Realization(Modulo($left, $right), context=Execution(),
    body=Code(
      source="""(args, bindings, api) => {
          const asNumber = (x) => {
            if (typeof x === "number") return x;
            if (x && x.head === "Number") return asNumber(x.args[0].value);
            return NaN;
          };
          const l = asNumber(args[0].value), r = asNumber(args[1].value);
          if (Number.isNaN(l) || Number.isNaN(r)) return api.call("Modulo", args[0].value, args[1].value);
          return r === 0 ? api.call('Undefined') : l % r;
        }""")))

Concept(Undefined(), IsA(Result()))

