// "the square root of 144", "15% of 80": said with "of", so the pattern keeps it. A
// negative has no real square root, which is the answer, as division by zero is.
Concept(SquareRoot(),
  Realization(SquareRoot($x), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $asNumber,
            Lambda(
              List($v),
              If(
                Equals(TypeOf($v), "number"),
                $v,
                If(
                  And($v, Equals(Member($v, "head"), "Number")),
                  Call($asNumber, Member(Index(Member($v, "args"), 0), "value")),
                  If(
                    And($v, Equals(Member($v, "head"), "Of")),
                    Call($asNumber, Member(Index(Member($v, "args"), 0), "value")),
                    $NaN))))),
          Let($x, Call($asNumber, Member(Index($args, Subtract(Length($args), 1)), "value"))),
          Let($p, 0),
          If(
            Or(Call(Member($Number, "isNaN"), $x), Call(Member($Number, "isNaN"), $p)),
            Return(
              Call(
                Member($api, "call"),
                "SquareRoot",
                Spread(Map($args, Lambda(List($a), Member($a, "value")))))),
            Undefined()),
          Return(
            If(
              LessThan($x, 0),
              Call(Member($api, "call"), "Undefined"),
              Call(Member($Math, "sqrt"), $x))))))),
  Realization(SquareRoot(Of($x)), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $asNumber,
            Lambda(
              List($v),
              If(
                Equals(TypeOf($v), "number"),
                $v,
                If(
                  And($v, Equals(Member($v, "head"), "Number")),
                  Call($asNumber, Member(Index(Member($v, "args"), 0), "value")),
                  If(
                    And($v, Equals(Member($v, "head"), "Of")),
                    Call($asNumber, Member(Index(Member($v, "args"), 0), "value")),
                    $NaN))))),
          Let($x, Call($asNumber, Member(Index($args, Subtract(Length($args), 1)), "value"))),
          Let($p, 0),
          If(
            Or(Call(Member($Number, "isNaN"), $x), Call(Member($Number, "isNaN"), $p)),
            Return(
              Call(
                Member($api, "call"),
                "SquareRoot",
                Spread(Map($args, Lambda(List($a), Member($a, "value")))))),
            Undefined()),
          Return(
            If(
              LessThan($x, 0),
              Call(Member($api, "call"), "Undefined"),
              Call(Member($Math, "sqrt"), $x))))))))

