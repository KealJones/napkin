// ------------------------------------------------------------------ *
// Interrogatives. An interrogative goes where the unknown is.
// ------------------------------------------------------------------
// One realization serves every question word, reached by inheritance. Asking for the
// value of something is the same operation whichever word the message used.
Concept(Interrogative(),
  IsA(ContextFacet()),
  IsA(MoodKind()),
  Realization($question, context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            If(Not(Length($args)), Return(Call(Member($api, "call"), "Unknown")), Undefined()),
            Var($subject, Member(Index($args, 0), "value")),
            Let(
              $WHEN,
              List(
                "Tomorrow",
                "Yesterday",
                "Today",
                "Tonight",
                "In",
                "Ago",
                "Next",
                "Last",
                "On",
                "After",
                "Before")),
            Let(
              $when,
              Lambda(
                List($e),
                Sequence(
                  If(Or(Not($e), Not(Member($e, "head"))), Return(Undefined()), Undefined()),
                  If(Includes($WHEN, Member($e, "head")), Return($e), Undefined()),
                  Let(
                    $inner,
                    Map(
                      Filter(
                        Member($e, "args"),
                        Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                      Lambda(List($a), Member($a, "value")))),
                  If(
                    Or(
                      Or(Equals(Member($e, "head"), "Will"), Equals(Member($e, "head"), "Is")),
                      Equals(Member($e, "head"), "Was")),
                    Sequence(
                      Let(
                        $rest,
                        Filter(
                          $inner,
                          Lambda(
                            List($v),
                            Not(
                              And(
                                And($v, Equals(Member($v, "head"), "It")),
                                Equals(Length(Member($v, "args")), 0)))))),
                      Return(
                        If(Equals(Length($rest), 1), Call($when, Index($rest, 0)), Undefined()))),
                    Undefined()),
                  If(
                    And(Equals(Member($e, "head"), "Be"), Equals(Length($inner), 1)),
                    Return(Call($when, Index($inner, 0))),
                    Undefined()),
                  Return(Undefined())))),
            Let(
              $at,
              Call(
                Member(
                  Map(
                    Call(Member($args, "slice"), 1),
                    Lambda(List($a), Call($when, Member($a, "value")))),
                  "find"),
                Lambda(List($w), NotEquals($w, Undefined())))),
            If(
              And(
                And(And($at, $subject), Member($subject, "head")),
                Equals(Length(Member($subject, "args")), 0)),
              Assign($subject, Call(Member($api, "call"), Member($subject, "head"), $at)),
              Undefined()),
            If(
              And(
                And(
                  And(
                    And(And(Not($at), GreaterThan(Length($args), 1)), $subject),
                    Member($subject, "head")),
                  Equals(Length(Member($subject, "args")), 0)),
                Call(Member(Regex("[^s]s$", ""), "test"), Member($subject, "head"))),
              Sequence(
                Let(
                  $members,
                  Await(
                    Call(Member($api, "evaluate"), Call(Member($api, "call"), "Members", $subject)))),
                If(
                  And(
                    And($members, Equals(Member($members, "head"), "List")),
                    Length(Member($members, "args"))),
                  Return(Call(Member($api, "call"), "Answer", $members)),
                  Undefined())),
              Undefined()),
            If(
              And(
                And(
                  And(
                    And(
                      And(Not($at), Equals(Length($args), 2)),
                      Equals(TypeOf(Member(Index($args, 1), "value")), "number")),
                    $subject),
                  Member($subject, "head")),
                Equals(Length(Member($subject, "args")), 0)),
              Assign(
                $subject,
                Call(
                  Member($api, "call"),
                  Member($subject, "head"),
                  Member(Index($args, 1), "value"))),
              Undefined()),
            Let($value, Await(Call(Member($api, "evaluate"), $subject))),
            Let(
              $plainKind,
              And(
                And(
                  And(
                    And(
                      And(
                        And($subject, Member($subject, "head")),
                        Equals(Length(Member($subject, "args")), 0)),
                      $value),
                    Member($value, "head")),
                  Equals(Length(Member($value, "args")), 0)),
                Not(
                  Call(
                    Member(
                      Otherwise(
                        OptionalMember(
                          Call(Member(Member($api, "store"), "get"), Member($value, "head")),
                          "realizations"),
                        List()),
                      "some"),
                    Lambda(
                      List($r),
                      And(
                        Not(Member($r, "retired")),
                        Not(
                          Call(
                            Member(Member($r, "properties"), "some"),
                            Lambda(List($p), Equals(Member($p, "head"), "Forwarding")))))))))),
            If(
              And(
                $plainKind,
                NotEquals(
                  Call(Member($api, "format"), $value),
                  Call(Member($api, "format"), $subject))),
              Return(
                Await(
                  Call(
                    Member($api, "evaluate"),
                    Call(Member($api, "call"), "Relations", $value),
                    Call(Member($api, "call"), "Describe")))),
              Undefined()),
            If(
              NotEquals(
                Call(Member($api, "format"), $value),
                Call(Member($api, "format"), $subject)),
              Return(Call(Member($api, "call"), "Answer", $value)),
              Undefined()),
            Return(
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "Relations", $subject),
                  Call(Member($api, "call"), "Describe"))))))))))

