      )
    )
  )
)

// "help me X": the help is doing X.
Concept(Help(),
  IsA(Frame()),
  Realization(Help(Rest($args)),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = Bind($recipient,
      Lambda(List($v),
        Bind($t1,
          Bind($t0,
            $v,
            If(
              Truthy($t0),
              Truthy(Includes(List("Me", "You", "We", "Us", "Them"), Head($v))),
              $t0
            )
          ),
          If(Truthy($t1), Identical(Length(Arguments($v)), 0), $t1)
        )
      ),
      Bind($content,
        Filter(Arguments(Quote($args)), Lambda(List($a), Falsy(Call($recipient, FieldOf($a, "value"))))),
        If(
          Falsy(Length($content)),
          MakeCall("Help", AsList(Map(Arguments(Quote($args)), Lambda(List($a2), FieldOf($a2, "value"))))),
          Bind($result,
            Cell(Undefined()),
            Steps(
              LoopOver(
                $content,
                Lambda(List($t2),
                  Bind($a3,
                    $t2,
                    Steps(Set($result, Evaluate(FieldOf($a3, "value"))), Undefined())
                  )
                )
              ),
              Get($result)
            )
          )
        )
      )
    )
  )
)

// Finding something out is being told it.
Concept(FigureOut(), SynonymOf(Tell()))

Concept(FindOut(), SynonymOf(Tell()))

Concept(WorkOut(), SynonymOf(Tell()))

// Social talk. A greeting or a thanks is answered, not computed: one realization on the
// category, inherited by every word for it, the way every question word answers through
// Interrogative.
Concept(Greeting(),
  IsA(Category()),
  Realization($said,
    context = Execution(),
    evaluateArguments = false,
    properties = List(Program()),
    body = MakeCall("Answer", List(MakeCall("Hello", List())))
  )
)

Concept(Thanking(),
  IsA(Category()),
  Realization($said,
    context = Execution(),
    evaluateArguments = false,
    properties = List(Program()),
    body = MakeCall("Answer", List(MakeCall("YoureWelcome", List())))
  )
)

Concept(Farewell(),
  IsA(Category()),
  Realization($said,
    context = Execution(),
    evaluateArguments = false,
    properties = List(Program()),
    body = MakeCall("Answer", List(MakeCall("Goodbye", List())))
  )
)

