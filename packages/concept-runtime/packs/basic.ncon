Requires(Core(), Code())

// ================================================================
// From src/seed/seed.ts
//
// The Concepts the network starts with (design/seed-concepts.md).
//
// A seed Concept is an ordinary Concept that happens to exist at time zero. It can be
// shadowed, appended to, retired, and forgotten like any other. Seeding is idempotent and
// additive: create when absent, otherwise add only what is not already there.
//
// Nothing here is stubbed. A Concept that cannot yet be honestly realized is omitted, so
// that it produces a residual the learning path can act on rather than a wrong answer.

// Symmetric but NOT transitive, which is the whole difficulty with synonymy.
//
// Bright is a synonym of smart, and bright is a synonym of luminous, and smart is not a
// synonym of luminous. Declared transitive, the chains close: a 554-Concept graph produced
// Identity equivalent to Sameness, Role, Duty, Task and finally Chore, each hop arguable
// and the closure nonsense. Synonym islands are a success (they are how language works);
// synonym CONTINENTS are the failure, and transitivity is what makes them.
// Machinery relations are not led with in a summary; interest is a property of the
// question, so this is a soft default and never a prohibition.
Concept(SynonymOf(), Symmetric(), Incidental())

// InverseOf reads a relation backwards; these are the other two things "inverse" means,
// kept apart so the backwards reading is never applied to a colour or an operation.
Concept(OppositeOf(), Symmetric())

Concept(InverseOperation(), Symmetric())

Concept(Reflexive(), IsA(RelationProperty()))

Concept(Suppresses(), Incidental(), IsA(RelationProperty()))

Concept(Effectful(), IsA(RealizationProperty()))

Concept(Lossy(), IsA(RealizationProperty()))

Concept(Pure(), IsA(RealizationProperty()))

Concept(Teaching(), IsA(ContextFacet()))

Concept(Lexical(), IsA(ContextFacet()))

Concept(Rust(), IsA(TargetLanguage()))

// Every JavaScript program is a TypeScript program: what JavaScript emits is valid here.
Concept(TypeScript(),
  IsA(TargetLanguage()),
  SupersetOf(JavaScript())
)

Concept(Python(), IsA(TargetLanguage()))

Concept(Describe(),
  IsA(ContextFacet()),
  Suppresses(Effectful()),
  Suppresses(Lossy())
)

// Trying something without doing it: what would this give? Nothing Effectful runs, so an
// attempt can be made and thrown away (design/pursue-predict.md).
Concept(Hypothetical(),
  IsA(ContextFacet()),
  Suppresses(Effectful())
)

Concept(Saved(), IsA(Result()))

Concept(Rejected())

Concept(NeedsFirst())

Concept(SelfReferential())

Concept(TooMany())

// A claim together with the context it holds in, for reporting rather than storing.
Concept(In(),
  IsA(Marker()),
  Realization(In($x),
    context = Execution(),
    properties = List(Program()),
    body = Bind($field,
      Lambda(List($r, $n),
        Bind($a,
          FirstSatisfying(Arguments($r), Lambda(List($x2), Identical(FieldOf($x2, "name"), $n))),
          If(Truthy($a), FieldOf($a, "value"), Undefined())
        )
      ),
      Bind($DAY,
        List(
          "Sunday",
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ),
        Bind($units,
          Record(
            Days = List(1, "day"),
            Weeks = List(7, "day"),
            Hours = List(60, "minute"),
            Minutes = List(1, "minute")
          ),
          Bind($isDuration,
            Lambda(List($v),
              Bind($t2,
                Bind($t1,
                  Bind($t0,
                    $v,
                    If(Truthy($t0), Element($units, Head($v)), $t0)
                  ),
                  If(Truthy($t1), Identical(Length(Arguments($v)), 1), $t1)
                ),
                If(
                  Truthy($t2),
                  Identical(TypeOf(FieldOf(Element(Arguments($v), 0), "value")), "number"),
                  $t2
                )
              )
            ),
            Bind($isRecord,
              Lambda(List($v2),
                Bind($t4,
                  Bind($t3,
                    $v2,
                    If(
                      Truthy($t3),
                      If(
                        Identical(Head($v2), "Date"),
                        true,
                        Identical(Head($v2), "Time")
                      ),
                      $t3
                    )
                  ),
                  If(
                    Truthy($t4),
                    AllSatisfy(Arguments($v2), Lambda(List($a2), NotIdentical(FieldOf($a2, "name"), Undefined()))),
                    $t4
                  )
                )
              ),
              Bind($clock,
                Lambda(List($t),
                  Bind($h24,
                    RoundDown(DivideValues($t, 60)),
                    Bind($mm,
                      RemainderOf($t, 60),
                      Bind($h12,
                        If(
                          Identical(RemainderOf($h24, 12), 0),
                          12,
                          RemainderOf($h24, 12)
                        ),
                        CallOf(
                          "Time",
                          List(
                            Record(name = "hour", value = $h24),
                            Record(name = "minute", value = $mm),
                            Record(
                              name = "spoken",
                              value = AddValues(
                                AddValues(AddValues(AddValues($h12, ":"), PadStart(ToText($mm), 2, "0")), " "),
                                If(Below($h24, 12), "AM", "PM")
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                ),
                Bind($date,
                  Lambda(List($d, $time),
                    CallOf(
                      "Date",
                      Concat(
                        List(
                          Record(name = "year", value = YearOf($d)),
                          Record(name = "month", value = AddValues(SubtractValues(MonthOf($d), 1), 1)),
                          Record(name = "day", value = DayOf($d)),
                          Record(name = "weekday", value = Element($DAY, WeekdayOf($d)))
                        ),
                        AsList(
                          If(
                            Truthy($time),
                            List(Record(name = "time", value = $time)),
                            List()
                          )
                        )
                      )
                    )
                  ),
                  Bind($minutesOf,
                    Lambda(List($t5),
                      AddValues(
                        MultiplyValues(ToNumber(Call($field, $t5, "hour")), 60),
                        ToNumber(Call($field, $t5, "minute"))
                      )
                    ),
                    Bind($shift,
                      Lambda(List($record, $duration, $sign),
                        Bind($t6,
                          Element($units, Head($duration)),
                          Bind($per,
                            Element($t6, 0),
                            Bind($kind,
                              Element($t6, 1),
                              Bind($n2,
                                MultiplyValues(
                                  MultiplyValues(FieldOf(Element(Arguments($duration), 0), "value"), $per),
                                  $sign
                                ),
                                If(
                                  Identical(Head($record), "Date"),
                                  Bind($time2,
                                    Call($field, $record, "time"),
                                    Bind($total,
                                      If(Identical($kind, "day"), MultiplyValues($n2, 1440), $n2),
                                      If(
                                        Truthy(If(NotIdentical($kind, "day"), Falsy($time2), false)),
                                        Undefined(),
                                        Bind($t7,
                                          AddValues(If(Truthy($time2), Call($minutesOf, $time2), 0), $total),
                                          Bind($carry,
                                            RoundDown(DivideValues($t7, 1440)),
                                            Bind($rest,
                                              RemainderOf(AddValues(RemainderOf($t7, 1440), 1440), 1440),
                                              Bind($d2,
                                                LocalInstant(
                                                  ToNumber(Call($field, $record, "year")),
                                                  AddValues(
                                                    SubtractValues(ToNumber(Call($field, $record, "month")), 1),
                                                    1
                                                  ),
                                                  AddValues(ToNumber(Call($field, $record, "day")), $carry)
                                                ),
                                                Call(
                                                  $date,
                                                  $d2,
                                                  If(Truthy($time2), Call($clock, $rest), Undefined())
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  ),
                                  Bind($total2,
                                    If(Identical($kind, "day"), MultiplyValues($n2, 1440), $n2),
                                    Call(
                                      $clock,
                                      RemainderOf(
                                        AddValues(
                                          RemainderOf(AddValues(Call($minutesOf, $record), $total2), 1440),
                                          1440
                                        ),
                                        1440
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      ),
                      Bind($now,
                        Lambda(List($duration2),
                          Evaluate(
                            MakeCall(
                              If(
                                Identical(Element(Element($units, Head($duration2)), 1), "day"),
                                "Today",
                                "Time"
                              ),
                              List()
                            )
                          )
                        ),
                        Bind($x3,
                          $x,
                          If(
                            Truthy(Call($isDuration, $x3)),
                            Bind($t8,
                              Call($shift, Call($now, $x3), $x3, 1),
                              If(IsNothing($t8), MakeCall("In", List($x3)), $t8)
                            ),
                            MakeCall("In", List($x3))
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

// The sense of a word that is something else sharing its name: a film, a game, a surname.
// It covers the categories whose members take their names from ordinary words, so research
// on a word keeps finding one: a game called Volcano, a band called Moment. Held here
// rather than on each category, so seeding it does not make those words known and stop
// them being learned.
Concept(Namesake(),
  IsA(ContextFacet()),
  Covers(ElectronicGame()),
  Covers(VideoGame()),
  Covers(Film()),
  Covers(Movie()),
  Covers(Album()),
  Covers(Song()),
  Covers(MusicSingle()),
  Covers(Book()),
  Covers(Novel()),
  Covers(TelevisionSeries()),
  Covers(Band()),
  Covers(MusicalGroup()),
  Covers(Company()),
  Covers(Surname()),
  Covers(FamilyName()),
  Covers(GivenName()),
  Covers(FirstName()),
  Covers(Musical()),
  Covers(Magazine()),
  Covers(AcademicJournal()),
  Covers(WrittenWork()),
  Covers(Painting())
)

Concept(Covers(), Incidental())

Concept(NotComposed())

Concept(Incomplete())

Concept(InvalidDeclaration(), IsA(Data()))

Concept(Missing(), IsA(Data()))

Concept(Relations(),
  Realization(Relations($subject),
    evaluateArguments = false,
    properties = List(Program()),
    body = Bind($subject2,
      Quote($subject),
      If(
        Truthy(If(Falsy($subject2), true, Falsy(Head($subject2)))),
        MakeCall("Unknown", List()),
        Bind($resolved,
          Bind($t0,
            FirstSatisfying(Arguments($subject2), Lambda(List($a), Identical(FieldOf($a, "name"), "resolvedTo"))),
            If(IsNothing($t0), Undefined(), FieldOf($t0, "value"))
          ),
          Bind($user,
            If(
              Identical(Head($subject2), "Me"),
              Bind($t1,
                FirstSatisfying(ClaimsWithObject("User"), Lambda(List($t), Identical(FieldOf($t, "predicate"), "IsA"))),
                If(IsNothing($t1), Undefined(), FieldOf($t1, "subject"))
              ),
              Undefined()
            ),
            Bind($self,
              If(
                Truthy(
                  If(
                    Identical(Head($subject2), "You"),
                    Identical(Length(Arguments($subject2)), 0),
                    false
                  )
                ),
                "Self",
                Undefined()
              ),
              Bind($about,
                If(
                  Truthy(Bind($t2, $resolved, If(Truthy($t2), Head($resolved), $t2))),
                  Head($resolved),
                  Bind($t4,
                    Bind($t3, $user, If(IsNothing($t3), $self, $t3)),
                    If(IsNothing($t4), Head($subject2), $t4)
                  )
                ),
                Bind($triples,
                  Filter(
                    // What its synonyms hold describes it too: they mean the same. A claim
                    // naming the Concept itself (a synonym's IsA of it) says nothing about it.
                    Bind($sameAs,
                      Concat(
                        List($about),
                        Map(
                          Filter(
                            ClaimsOf($about, Record(transitive = false)),
                            Lambda(List($syn), Identical(FieldOf($syn, "predicate"), "SynonymOf"))
                          ),
                          Lambda(List($syn2), Head(FieldOf($syn2, "object")))
                        )
                      ),
                      Filter(
                        FlatMap($sameAs, Lambda(List($member), ClaimsOf($member, Record(transitive = false)))),
                        Lambda(List($claimed),
                          Bind($object2,
                            FieldOf($claimed, "object"),
                            Falsy(
                              If(
                                Truthy(IsCall($object2)),
                                Identical(Head($object2), $about),
                                false
                              )
                            )
                          )
                        )
                      )
                    ),
                    Lambda(List($t5),
                      Bind($unit,
                        UnitOf(FieldOf($t5, "predicate")),
                        Falsy(
                          AnySatisfies(
                            Bind($t7,
                              Bind($t6,
                                $unit,
                                If(IsNothing($t6), Undefined(), FieldOf($t6, "relations"))
                              ),
                              If(IsNothing($t7), List(), $t7)
                            ),
                            Lambda(List($r), Identical(Head(FieldOf($r, "claim")), "Incidental"))
                          )
                        )
                      )
                    )
                  ),
                  If(
                    Falsy(Length($triples)),
                    MakeCall("NoDescription", List($subject2)),
                    Bind($ordered,
                      Concat(
                        AsList(Filter($triples, Lambda(List($t8), Falsy(FieldOf($t8, "context"))))),
                        AsList(Filter($triples, Lambda(List($t9), FieldOf($t9, "context"))))
                      ),
                      Bind($described,
                        Map(
                          $ordered,
                          Lambda(List($t10),
                            If(
                              Truthy(FieldOf($t10, "context")),
                              MakeCall("In", List(FieldOf($t10, "expr"), FieldOf($t10, "context"))),
                              FieldOf($t10, "expr")
                            )
                          )
                        ),
                        MakeCall("Describes", List($subject2, MakeCall("List", AsList($described))))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

// ------------------------------------------------------------------ *
// Evaluation control. All take their arguments unevaluated.
// ------------------------------------------------------------------
Concept(Sequence(),
  Realization(Sequence(Rest($steps)),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($unmood,
              Lambda(List($e),
                If(
                  And(And(Call($isCall, $e), Equals(Member($e, "head"), "Mood")), Equals(Length(Member($e, "args")), 2)),
                  Member(Index(Member($e, "args"), 1), "value"),
                  $e
                )
              )
            ),
            Bind($binary,
              Lambda(List($head),
                Call(
                  Member(
                    Otherwise(OptionalMember(Call(Member(Member($api, "store"), "get"), $head), "realizations"), List()),
                    "some"
                  ),
                  Lambda(List($r),
                    And(Call($isCall, Member($r, "pattern")), Equals(Length(Member(Member($r, "pattern"), "args")), 2))
                  )
                )
              )
            ),
            Bind($carry,
              Lambda(List($e, $prev),
                Sequence(
                  If(Not(Call($isCall, $e)), Return($e), Undefined()),
                  If(
                    And(
                      And(Equals(Member($e, "head"), "Ref"), Equals(Length(Member($e, "args")), 1)),
                      Call(
                        Member(Regex("^(it|that|this|)$", ""), "test"),
                        Call($String, Member(Index(Member($e, "args"), 0), "value"))
                      )
                    ),
                    Return($prev),
                    Undefined()
                  ),
                  Bind($carried,
                    Map(
                      Member($e, "args"),
                      Lambda(List($a), Object(Spread($a), value = Call($carry, Member($a, "value"), $prev)))
                    )
                  ),
                  // Nothing carried, the line is itself: rebuilt, a value bound into it would
                  // become a call to evaluate again.
                  If(
                    Call(
                      Member($carried, "every"),
                      Lambda(List($a, $i), Equals(Member($a, "value"), Member(Index(Member($e, "args"), $i), "value")))
                    ),
                    Return($e),
                    Undefined()
                  ),
                  Return(Object(head = Member($e, "head"), args = $carried))
                )
              )
            ),
            Var($last, null),
            Bind($answers, List()),
            ForOf(
              List($i, $a),
              Call(Member($args, "entries")),
              Sequence(
                Var($line, Member($a, "value")),
                If(
                  And(
                    And(GreaterThan($i, 0), NotEquals($last, null)),
                    Or(Equals(TypeOf($last), "number"), Call($isCall, $last))
                  ),
                  Sequence(
                    Bind($prev,
                      If(
                        And(
                          And(Call($isCall, $last), Equals(Member($last, "head"), "Answer")),
                          Equals(Length(Member($last, "args")), 1)
                        ),
                        Member(Index(Member($last, "args"), 0), "value"),
                        $last
                      )
                    ),
                    Assign($line, Call($carry, $line, $prev)),
                    Bind($core, Call($unmood, $line)),
                    If(
                      And(
                        And(
                          And(
                            And(Call($isCall, $core), Equals(Length(Member($core, "args")), 1)),
                            Equals(Member(Index(Member($core, "args"), 0), "name"), Undefined())
                          ),
                          Call($binary, Member($core, "head"))
                        ),
                        Equals(TypeOf($prev), "number")
                      ),
                      Sequence(
                        Bind($applied,
                          Call(
                            Member($api, "call"),
                            Member($core, "head"),
                            $prev,
                            Member(Index(Member($core, "args"), 0), "value")
                          )
                        ),
                        Assign(
                          $line,
                          If(
                            Equals($line, $core),
                            $applied,
                            Call(
                              Member($api, "call"),
                              "Mood",
                              Member(Index(Member($line, "args"), 0), "value"),
                              $applied
                            )
                          )
                        )
                      ),
                      Undefined()
                    )
                  ),
                  Undefined()
                ),
                Bind($value, Await(Call(Member($api, "resolve"), $line))),
                If(
                  And(Call($isCall, $value), Includes(List("Answer", "Believed", "Noted"), Member($value, "head"))),
                  Call(Member($answers, "push"), $value),
                  Undefined()
                ),
                Assign($last, $value)
              )
            ),
            Return(
              If(
                GreaterThan(Length($answers), 1),
                Call(Member($api, "call"), "Sequence", Spread($answers)),
                $last
              )
            )
          )
        )
      )
    )
  )
)

Concept(If(),
  Realization(If($condition, $then, $otherwise),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($test, Await(Call(Member($api, "resolve"), Member(Index($args, 0), "value")))),
            Bind($truthy, Or(Equals($test, true), And($test, Equals(Member($test, "head"), "True")))),
            Return(
              Await(
                Call(
                  Member($api, "resolve"),
                  If(
                    $truthy,
                    Member(Index($args, 1), "value"),
                    Member(Index($args, 2), "value")
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(Try(),
  Realization(Try($body, $catch),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Try(
              Return(Await(Call(Member($api, "evaluate"), Member(Index($args, 0), "value")))),
              Catch(
                $caught,
                Sequence(
                  Bind($failure,
                    If(
                      And($caught, Member($caught, "value")),
                      Member($caught, "value"),
                      Call(Member($api, "call"), "ExecutionFailed")
                    )
                  ),
                  Bind($handler, Member(Index($args, 1), "value")),
                  If(
                    And($handler, Equals(Member($handler, "head"), "Catch")),
                    Sequence(
                      Bind($name, Member(Member(Index(Member($handler, "args"), 0), "value"), "variable")),
                      Return(
                        Await(
                          Call(
                            Member($api, "evaluate"),
                            Call(
                              Member($api, "substitute"),
                              Member(Index(Member($handler, "args"), 1), "value"),
                              New($Map, List(List($name, $failure)))
                            )
                          )
                        )
                      )
                    ),
                    Undefined()
                  ),
                  Return(Await(Call(Member($api, "evaluate"), $handler)))
                )
              )
            ),
            Undefined()
          )
        )
      )
    )
  )
)

Concept(Catch(), IsA(Data()))

// ------------------------------------------------------------------ *
// State. Cells reach the store through the same interface everything else uses.
// ------------------------------------------------------------------
Concept(Cell(),
  Realization(Cell($initial),
    properties = List(Effectful()),
    body = Code(
      ir = Lambda(List($args, $bindings, $api),
        Call(Member(Member($api, "cells"), "allocate"), Member(Index($args, 0), "value"))
      )
    )
  )
)

Concept(Get(),
  Realization(Get($ref),
    properties = List(Effectful()),
    body = Code(
      ir = Lambda(List($args, $bindings, $api),
        Call(Member(Member($api, "cells"), "read"), Member(Index($args, 0), "value"))
      )
    )
  )
)

Concept(Set(),
  Realization(Set($ref, $value),
    properties = List(Effectful()),
    body = Code(
      ir = Lambda(List($args, $bindings, $api),
        Call(
          Member(Member($api, "cells"), "write"),
          Member(Index($args, 0), "value"),
          Member(Index($args, 1), "value")
        )
      )
    )
  )
)

Concept(CellRef(), IsA(Data()))

Concept(ExecutionFailed(), IsA(Failure()))

Concept(UnboundVariable(), IsA(Failure()))

Concept(BudgetExceeded(), IsA(Failure()))

Concept(Unrealized(), IsA(Failure()))

Concept(UnknownTruth(), IsA(TruthValue()))

// ------------------------------------------------------------------ *
// Source markers. Each projection is Lossy, so Describe withholds it and the
// marker survives into its own description.
// ------------------------------------------------------------------
// Markers are named Mark* so no English word collides with one: "a fuzzy bear" is the
// adjective Fuzzy(Bear()), never a marker. A marker whose trigger words would otherwise be
// lost carries them verbatim first: MarkFuzzy("or whatever", x), MarkEmphasis("NOT", x).
Concept(MarkCorrection(),
  IsA(Marker()),
  Realization(MarkCorrection($old, $new),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $new
  )
)

Concept(MarkMisspelling(),
  IsA(Marker()),
  Realization(MarkMisspelling($wrote, $meant),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $meant
  )
)

Concept(MarkFuzzy(),
  IsA(Marker()),
  Realization(MarkFuzzy($words, $x),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

Concept(MarkEmphasis(),
  IsA(Marker()),
  Realization(MarkEmphasis($words, $x),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

// Aside and Ref have no execution realization at all, deliberately: both should stay
// visible until something resolves them rather than quietly evaluating to anything.
// Layout, kept rather than dropped (`eval/ears/gold.md`, convention 7). A list entry and a
// fenced block project to their content; a heading is like an aside and stays visible.
Concept(Heading(), IsA(Marker()))

Concept(Item(),
  IsA(Marker()),
  Realization(Item($n, $x),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  ),
  Realization(Item($x),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

Concept(Block(),
  IsA(Marker()),
  Realization(Block($language, $text),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $text
  ),
  Realization(Block($text),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $text
  )
)

// The user asserting something, as opposed to asking.
Concept(Fact(), IsA(Frame()))

// The user requesting an action. Not a question, and not a claim.
// An imperative is performed: under execution the frame projects to what it frames. It is
// Lossy, so describing the request still shows that it was an order. Without this, every
// request the Ears framed stayed an unevaluated Do(...).
Concept(Do(),
  IsA(Frame()),
  Realization(Do($x),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

// Delivery: "tell me X", "show me X", "help me X". Under execution the frame does what it
// delivers, the way "can you X" does X; who it is delivered to is not part of the work. With
// nothing but a recipient ("tell me") there is nothing to do, so it stays residual.
// Delivery. `Do(Tell(Me(), Whether(...)))` is "tell me if...".
Concept(Tell(),
  IsA(Frame()),
  Realization(Tell(Rest($args)),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = Bind($recipient,
      Lambda(List($v),
        Bind($t1,
          Bind($t0,
            $v,
            If(
              Truthy($t0),
              Truthy(Includes(List("Me", "You", "We", "Us", "Them"), Head($v))),
              $t0
            )
          ),
          If(Truthy($t1), Identical(Length(Arguments($v)), 0), $t1)
        )
      ),
      Bind($content,
        Filter(Arguments(Quote($args)), Lambda(List($a), Falsy(Call($recipient, FieldOf($a, "value"))))),
        If(
          Falsy(Length($content)),
          MakeCall("Tell", AsList(Map(Arguments(Quote($args)), Lambda(List($a2), FieldOf($a2, "value"))))),
          Bind($result,
            Cell(Undefined()),
            Steps(
              LoopOver(
                $content,
                Lambda(List($t2),
                  Bind($a3,
                    $t2,
                    Steps(Set($result, Evaluate(FieldOf($a3, "value"))), Undefined())
                  )
                )
              ),
              Get($result)
            )
          )
        )
      )
    )
  )
)

// Asking for something to be produced, as opposed to told.
Concept(Give(), IsA(Frame()), SynonymOf(Show()))

Concept(Show(),
