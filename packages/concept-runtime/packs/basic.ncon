Concept(Count(),
  Realization(Count($needle, $haystack), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $text,
            Lambda(
              List($x),
              If(
                Equals(TypeOf($x), "string"),
                $x,
                If(
                  And($x, Equals(Member($x, "head"), "String")),
                  Member(Index(Member($x, "args"), 0), "value"),
                  null)))),
          Let($needle, Call($text, Member(Index($args, 0), "value"))),
          Let($haystack, Call($text, Member(Index($args, 1), "value"))),
          If(
            Or(Equals($needle, null), Equals($haystack, null)),
            Return(
              Call(
                Member($api, "call"),
                "Count",
                Member(Index($args, 0), "value"),
                Member(Index($args, 1), "value"))),
            Undefined()),
          Return(Subtract(Length(Call(Member($haystack, "split"), $needle)), 1)))))))


// ------------------------------------------------------------------ *
// Self-reference. A message that talks about itself needs a referent for itself, and
// without one the instruction "use this prompt as a test case" cannot be expressed at all.
// This was the measured weak spot: long self-referential messages scored 13-43% fidelity
// at every model size.
// ------------------------------------------------------------------
Concept(Self(),
  Realization(Self(), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let($message, Call(Member($api, "ambient"), "message")),
          Return(
            If(
              Equals($message, Undefined()),
              Call(Member($api, "call"), "Self"),
              Call(Member($api, "call"), "Message", $message))))))))

Concept(Message(), IsA(Data()))


// ------------------------------------------------------------------ *
// Preserved ambiguity. When context does not resolve which reading is meant, the system
// may pick, ask, or keep both — and which it does is itself a realization selected by
// context, so the policy is inspectable rather than hardcoded.
// ------------------------------------------------------------------
// Under Execution the best-supported reading wins: the first that realizes.
// Under Describe all readings are kept and shown.
Concept(Ambiguous(),
  Realization(Ambiguous(Rest($readings)), context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let($tried, List()),
            ForOf(
              $a,
              $args,
              Sequence(
                Let($value, Await(Call(Member($api, "evaluate"), Member($a, "value")))),
                If(
                  NotEquals(
                    Call(Member($api, "format"), $value),
                    Call(Member($api, "format"), Member($a, "value"))),
                  Return($value),
                  Undefined()),
                Call(Member($tried, "push"), $value))),
            Return(Call(Member($api, "call"), "Ambiguous", Spread($tried)))))))),
  Realization(Ambiguous(Rest($readings)), context=Describe(), evaluateArguments=false,
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Call(
          Member($api, "call"),
          "Readings",
          Spread(Map($args, Lambda(List($a), Member($a, "value")))))))))

Concept(Web(), IsA(Source()))

Concept(Wikidata(), IsA(Source()))

Concept(SearchResult(), IsA(Data()))

Concept(SearchResults(), IsA(Collection()))

Concept(WikidataSearch(),
  IsA(Research()),
  Realization(WikidataSearch($query), context=Execution(), properties=List(Effectful()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $text,
              If(
                Equals(TypeOf(Member(Index($args, 0), "value")), "string"),
                Member(Index($args, 0), "value"),
                If(
                  And(
                    Member(Index($args, 0), "value"),
                    Member(Member(Index($args, 0), "value"), "head")),
                  Member(Member(Index($args, 0), "value"), "head"),
                  ""))),
            Let(
              Object(wikidata=$wikidata, asConcepts=$asConcepts),
              Await(DynamicImport("../research/sources.js"))),
            Return(Call($asConcepts, Await(Call($wikidata, $text, 5))))))))))

Concept(WebSearch(),
