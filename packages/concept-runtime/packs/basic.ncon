// A yes/no question wants a truth value, not a subject, so it declares its own
// realization locally, which beats the inherited one on distance.
//
// One question in form is a request in use: "can you write me X" asks about ability and
// wants X (Searle's indirect speech acts). The Ears writes the form it heard,
// Whether(Can(You(), X)), and this is where the use is read. One realization rather than
// two, because two overlapping patterns on one Concept are ordered only by declaration
// order (concept-spec Part 9 has no rule for pattern specificity).
Concept(Whether(),
  IsA(Interrogative()),
  Realization(Whether($proposition), context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let($p, Member(Index($args, 0), "value")),
            Let(
              $asking,
              And(
                And(
                  And(
                    And($p, Includes(List("Can", "Could", "Would", "Will"), Member($p, "head"))),
                    Equals(Length(Member($p, "args")), 2)),
                  Member(Index(Member($p, "args"), 0), "value")),
                Equals(Member(Member(Index(Member($p, "args"), 0), "value"), "head"), "You"))),
            If(
              $asking,
              Return(
                Await(Call(Member($api, "evaluate"), Member(Index(Member($p, "args"), 1), "value")))),
              Undefined()),
            Let($v, Await(Call(Member($api, "evaluate"), $p))),
            If(
              Or(Equals($v, true), And($v, Equals(Member($v, "head"), "True"))),
              Return(Call(Member($api, "call"), "Answer", Call(Member($api, "call"), "True"))),
              Undefined()),
            If(
              Or(Equals($v, false), And($v, Equals(Member($v, "head"), "False"))),
              Return(Call(Member($api, "call"), "Answer", Call(Member($api, "call"), "False"))),
              Undefined()),
            Return(Call(Member($api, "call"), "Answer", Call(Member($api, "call"), "UnknownTruth")))))))))

// "is chess a sport", "are cats animals", "is 7 prime": a yes/no question in statement
// order, verb first because the subject cannot always head (reading-spec P2). A question
// is a lookup, never a lesson: an unknown answer is said as unknown, so asking can never
// teach Is a realization.
// Written in the code IR, in order: a comparison ("is 100 more than 99") is computed; a
// role held for someone ("is he my coworker") is CoworkerOf(<the user>); a subject never
// heard of is evaluated, leaving the gap where learning finds it, so asking never teaches
// Is; then IsA with inheritance, the SubclassOf chain from the subject or from any kind it
// is an instance of ("is a volcano a mountain", K2 is a volcano so a mountain), DistinctFrom
// for no ("an emoji is not an emoticon"), and a nullary claim like Small() held.
Concept(Is(),
  Realization(Is($subject, $category), context=Context(Execution(), Interrogative()), evaluateArguments=false, properties=List(Compile()),
    body=If(
      Not(IsCall($category)),
      Answer(UnknownTruth()),
      Let(
        $comparison,
        If(
          Matches(Head($category), "^(More|Greater|Bigger|Larger|Higher|Taller|Older)Than$"),
          "GreaterThan",
          If(
            Matches(Head($category), "^(Less|Smaller|Fewer|Lower|Shorter|Younger)Than$"),
            "LessThan",
            "")),
        Let(
          $compared,
          If(
            And(Not(Equals($comparison, "")), Equals(Arg($category, 1), Undefined())),
            Evaluate(MakeCall($comparison, List(Evaluate($subject), Evaluate(Arg($category, 0))))),
            Nothing()),
          If(
            Or(Equals($compared, True()), Equals($compared, False())),
            Answer($compared),
            If(
              Not(IsCall($subject)),
              Answer(UnknownTruth()),
              Let(
                $resolved,
                ArgNamed($subject, "resolvedTo"),
                Let(
                  $what,
                  If(
                    Not(Equals($resolved, Undefined())),
                    MakeCall(Head($resolved), List()),
                    Singular($subject)),
                  If(
                    And(
                      Or(Equals(Head($category), "My"), Equals(Head($category), "Your")),
                      IsCall(Arg($category, 0))),
                    Let(
                      $owner,
                      If(
                        Equals(Head($category), "My"),
                        First(Subjects("IsA", "User")),
                        MakeCall("Self", List())),
                      If(
                        Includes(Closure($what, JoinText(Head(Arg($category, 0)), "Of")), $owner),
                        Answer(True()),
                        Answer(UnknownTruth()))),
                    Let(
                      $learned,
                      If(
                        Or(Known($what), Not(Equals($resolved, Undefined()))),
                        Nothing(),
                        Evaluate($what)),
                      Let(
                        $kind,
                        Singular($category),
                        Let(
                          $truth,
                          TruthOf($what, "IsA", $kind),
                          If(
                            Equals($truth, True()),
                            Answer(True()),
                            If(
                              Equals(TruthOf($what, "SubclassOf", $kind), True()),
                              Answer(True()),
                              If(
                                GreaterThan(
                                  Length(
                                    Filter(
                                      Closure($what, "IsA"),
                                      Lambda(
                                        List($k),
                                        Equals(TruthOf($k, "SubclassOf", $kind), True())))),
                                  0),
                                Answer(True()),
                                If(
                                  Includes(Holds($what, "DistinctFrom"), $kind),
                                  Answer(False()),
                                  If(
                                    Claimed($what, Head($kind)),
                                    Answer(True()),
                                    If(
                                      Equals($truth, False()),
                                      Answer(False()),
                                      Answer(UnknownTruth()))))))))))))))))))),
  Realization(Is($x), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 0), "value"))))))))

Concept(Are(),
  Realization(Are($subject, $category), context=Context(Execution(), Interrogative()), evaluateArguments=false, properties=List(Compile()),
    body=If(
      Not(IsCall($category)),
      Answer(UnknownTruth()),
      Let(
        $comparison,
        If(
          Matches(Head($category), "^(More|Greater|Bigger|Larger|Higher|Taller|Older)Than$"),
          "GreaterThan",
          If(
            Matches(Head($category), "^(Less|Smaller|Fewer|Lower|Shorter|Younger)Than$"),
            "LessThan",
            "")),
        Let(
          $compared,
          If(
            And(Not(Equals($comparison, "")), Equals(Arg($category, 1), Undefined())),
            Evaluate(MakeCall($comparison, List(Evaluate($subject), Evaluate(Arg($category, 0))))),
            Nothing()),
          If(
            Or(Equals($compared, True()), Equals($compared, False())),
            Answer($compared),
            If(
              Not(IsCall($subject)),
              Answer(UnknownTruth()),
              Let(
                $resolved,
                ArgNamed($subject, "resolvedTo"),
                Let(
                  $what,
                  If(
                    Not(Equals($resolved, Undefined())),
                    MakeCall(Head($resolved), List()),
                    Singular($subject)),
                  If(
                    And(
                      Or(Equals(Head($category), "My"), Equals(Head($category), "Your")),
                      IsCall(Arg($category, 0))),
                    Let(
                      $owner,
                      If(
                        Equals(Head($category), "My"),
                        First(Subjects("IsA", "User")),
                        MakeCall("Self", List())),
                      If(
                        Includes(Closure($what, JoinText(Head(Arg($category, 0)), "Of")), $owner),
                        Answer(True()),
                        Answer(UnknownTruth()))),
                    Let(
                      $learned,
                      If(
                        Or(Known($what), Not(Equals($resolved, Undefined()))),
                        Nothing(),
                        Evaluate($what)),
                      Let(
                        $kind,
                        Singular($category),
                        Let(
                          $truth,
                          TruthOf($what, "IsA", $kind),
                          If(
                            Equals($truth, True()),
                            Answer(True()),
                            If(
                              Equals(TruthOf($what, "SubclassOf", $kind), True()),
                              Answer(True()),
                              If(
                                GreaterThan(
                                  Length(
                                    Filter(
                                      Closure($what, "IsA"),
                                      Lambda(
                                        List($k),
                                        Equals(TruthOf($k, "SubclassOf", $kind), True())))),
                                  0),
                                Answer(True()),
                                If(
                                  Includes(Holds($what, "DistinctFrom"), $kind),
                                  Answer(False()),
                                  If(
                                    Claimed($what, Head($kind)),
                                    Answer(True()),
                                    If(
                                      Equals($truth, False()),
                                      Answer(False()),
                                      Answer(UnknownTruth()))))))))))))))))))))

Concept(NoDescription(), IsA(Result()))

Concept(Readings(), IsA(Result()))

Concept(Unknown(), IsA(Data()))

Concept(String(), IsA(Primitive()))

Concept(Boolean(), IsA(Primitive()))

Concept(Object(), IsA(Collection()))

Concept(Pair(), IsA(Collection()))

Concept(Number(),
  Realization(Number($value), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let($v, Member(Index($args, 0), "value")),
          If(Equals(TypeOf($v), "number"), Return($v), Undefined()),
          Let(
            $words,
            Object(
              zero=0,
              one=1,
              two=2,
              three=3,
              four=4,
              five=5,
              six=6,
              seven=7,
              eight=8,
              nine=9,
              ten=10,
              eleven=11,
              twelve=12,
              dozen=12,
              twenty=20,
              thirty=30,
              forty=40,
              fifty=50,
              sixty=60,
              seventy=70,
              eighty=80,
              ninety=90,
              hundred=100,
              thousand=1000,
              million=1000000,
              billion=1000000000)),
          If(
            Equals(TypeOf($v), "string"),
            Sequence(
              Let($n, Index($words, Call(Member($v, "toLowerCase")))),
              If(NotEquals($n, Undefined()), Return($n), Undefined()),
              Let($parsed, Call($Number, $v)),
              If(Call(Member($Number, "isFinite"), $parsed), Return($parsed), Undefined())),
            Undefined()),
          Return(Call(Member($api, "call"), "Number", Member(Index($args, 0), "value"))))))))


// ------------------------------------------------------------------ *
// Rendering wraps its subject rather than parameterising it, so Date never
// learns that formats exist.
//
// Formatting NEVER returns a bare string. It returns the same Concept with its
// rendering carried in `spoken`, because a display string is a field of a value and
// not a replacement for it. Returning "10:15" cost the next turn its arithmetic: the
// reference resolved to text, Add saw a string, and the whole thing went residual.
// ------------------------------------------------------------------
Concept(Format(),
  Realization(Format($subject, $spec), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let($subject, Member(Index($args, 0), "value")),
          Let($spec, Member(Index($args, 1), "value")),
          Let($pattern, If(Equals(TypeOf($spec), "string"), $spec, "")),
          Let($wants12, Call(Member(Regex("12|am|pm", "i"), "test"), $pattern)),
          Let(
            $withSpoken,
            Lambda(
              List($head, $source, $spoken),
              Object(
                head=$head,
                args=Concat(
                  Filter(
                    Member($source, "args"),
                    Lambda(List($a), NotEquals(Member($a, "name"), "spoken"))),
                  List(Object(name="spoken", value=$spoken)))))),
          Let(
            $named,
            Lambda(
              List($e, $n),
              Sequence(
                Let(
                  $a,
                  Call(
                    Member(Member($e, "args"), "find"),
                    Lambda(List($x), Equals(Member($x, "name"), $n)))),
                Return(If($a, Member($a, "value"), Undefined()))))),
          Let(
            $clock,
            Lambda(
              List($h24, $minute),
              Sequence(
                Let($mm, Call(Member(Call($String, $minute), "padStart"), 2, "0")),
                If(
                  Or(Not($pattern), $wants12),
                  Sequence(
                    Let($h, If(Equals(Modulo($h24, 12), 0), 12, Modulo($h24, 12))),
                    Return(
                      Add(Add(Add(Add($h, ":"), $mm), " "), If(LessThan($h24, 12), "AM", "PM")))),
                  Undefined()),
                Return(Add(Add(Call(Member(Call($String, $h24), "padStart"), 2, "0"), ":"), $mm))))),
          If(
            And($subject, Equals(Member($subject, "head"), "Date")),
            Sequence(
              Let($y, Call($String, Call($named, $subject, "year"))),
              Let(
                $m,
                Call(Member(Call($String, Call($named, $subject, "month")), "padStart"), 2, "0")),
              Let(
                $d,
                Call(Member(Call($String, Call($named, $subject, "day")), "padStart"), 2, "0")),
              Let(
                $spoken,
                Call(
                  Member(
                    Call(
                      Member(
                        Call(Member(Or($pattern, "YYYY-MM-DD"), "replace"), "YYYY", $y),
                        "replace"),
                      "MM",
                      $m),
                    "replace"),
                  "DD",
                  $d)),
              Return(Call($withSpoken, "Date", $subject, $spoken))),
            Undefined()),
          If(
            And($subject, Equals(Member($subject, "head"), "Time")),
            Sequence(
              Let($h24, Call($Number, Call($named, $subject, "hour"))),
              Let($minute, Call($Number, Call($named, $subject, "minute"))),
              If(
                And(
                  Call(Member($Number, "isFinite"), $h24),
                  Call(Member($Number, "isFinite"), $minute)),
                Return(Call($withSpoken, "Time", $subject, Call($clock, $h24, $minute))),
                Undefined())),
            Undefined()),
          If(
            And($subject, Equals(Member($subject, "head"), "Timestamp")),
            Sequence(
              Let(
                $raw,
                If(
                  Index(Member($subject, "args"), 0),
                  Member(Index(Member($subject, "args"), 0), "value"),
                  Undefined())),
              Let($when, If(Equals(TypeOf($raw), "string"), New($Date, $raw), New($Date))),
              If(
                Call(Member($Number, "isNaN"), Call(Member($when, "getTime"))),
                Return(Call(Member($api, "call"), "Format", $subject, $spec)),
                Undefined()),
              Let($h24, Call(Member($when, "getHours"))),
              Let($minute, Call(Member($when, "getMinutes"))),
              Return(
                Object(
                  head="Time",
                  args=List(
                    Object(name="hour", value=$h24),
                    Object(name="minute", value=$minute),
                    Object(name="spoken", value=Call($clock, $h24, $minute)))))),
            Undefined()),
          Return(Call(Member($api, "call"), "Format", $subject, $spec)))))))


// ------------------------------------------------------------------ *
// Allen's interval algebra: how two stretches of time can stand to each other.
//
// Thirteen relations, and exactly thirteen. They are jointly exhaustive and pairwise
// disjoint -- any two intervals stand in one of these and never in two. That closure is
// why this calculus is still in use while most of qualitative reasoning is not
// (design/judgment-research.md Part 6): a closed, small, mutually exclusive family
// composes by table lookup, where an open-ended one accumulates cases that cannot be
// resolved.
//
// Seeded rather than taught, for the same reason arithmetic is. These have exact
// definitions, and a Teacher grounded in a web search would return the surname Allen, the
// English word "meets", and a definition of "during" that is merely usable. Where the
// meaning is exact, stating it is honest and learning it is not.
//
// Only Equals is an equivalence. Before, During, Starts and Finishes are transitive but
// asymmetric, so they order without collapsing -- and Meets and Overlaps are neither,
// which is what stops a chain of adjacent intervals from becoming one interval.
// ------------------------------------------------------------------
Concept(IntervalRelation(), IsA(Relation()), IsA(Category()))

Concept(Interval(), IsA(TemporalEntity()))

Concept(TemporalEntity(), IsA(Category()))

// Ordering: transitive, so a chain settles, and asymmetric, so it never closes.
Concept(Before(),
  IsA(IntervalRelation()),
  InverseOf(After()),
  Transitive(),
  Asymmetric(),
  Irreflexive())

Concept(After(),
  IsA(IntervalRelation()),
  InverseOf(Before()),
  Transitive(),
  Asymmetric(),
  Irreflexive())

// Adjacency: A ends exactly where B starts. NOT transitive -- three intervals in a row
// do not make the first meet the third, and treating them as though they did is how a
// sequence of moments collapses into one.
Concept(Meets(), IsA(IntervalRelation()), InverseOf(MetBy()), Asymmetric(), Irreflexive())

Concept(MetBy(), IsA(IntervalRelation()), InverseOf(Meets()), Asymmetric(), Irreflexive())

// Partial overlap: also not transitive, for the same reason.
Concept(Overlaps(), IsA(IntervalRelation()), InverseOf(OverlappedBy()), Asymmetric(), Irreflexive())

Concept(OverlappedBy(), IsA(IntervalRelation()), InverseOf(Overlaps()), Asymmetric(), Irreflexive())

Concept(Starts(),
  IsA(IntervalRelation()),
  InverseOf(StartedBy()),
  Transitive(),
  Asymmetric(),
  Irreflexive())

Concept(StartedBy(),
  IsA(IntervalRelation()),
  InverseOf(Starts()),
  Transitive(),
  Asymmetric(),
  Irreflexive())

Concept(During(),
  IsA(IntervalRelation()),
  InverseOf(Contains()),
  Transitive(),
  Asymmetric(),
  Irreflexive())

Concept(Contains(),
  IsA(IntervalRelation()),
  InverseOf(During()),
  Transitive(),
  Asymmetric(),
  Irreflexive())

Concept(Finishes(),
  IsA(IntervalRelation()),
  InverseOf(FinishedBy()),
  Transitive(),
  Asymmetric(),
  Irreflexive())

Concept(FinishedBy(),
  IsA(IntervalRelation()),
  InverseOf(Finishes()),
  Transitive(),
  Asymmetric(),
  Irreflexive())

// The one equivalence in the family: same start, same end.
Concept(Equals(), IsA(IntervalRelation()), Symmetric(), Transitive(), InverseOf(Equals()))


// ------------------------------------------------------------------ *
// Deixis and defaults. Today() is deictic: it reads the clock and takes no
// arguments. Date() is a default: a lower-arity realization delegating to Date(Today()).
// ------------------------------------------------------------------
Concept(CurrentTimestamp(),
  Realization(CurrentTimestamp(), properties=List(Effectful()),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Call(Member($api, "call"), "Timestamp", Call(Member(New($Date), "toISOString")))))))

Concept(Timestamp(), IsA(Data()))

// The clock time, as opposed to the calendar date. Deictic, like Today.
// A clock time as said is a reading: Time(7, Am()), Time(7, 30, Pm()), Time(19, 0).
// It realizes to the named value record the clock Concepts compute with. The pattern
// variables are deliberately not named hour or minute: the matcher aligns an
// all-named call by name, so a value record can never be re-read as a reading.
Concept(Time(),
  IsA(Deictic()),
  Realization(Time(), context=Execution(), properties=List(Effectful()),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let($now, New($Date)),
          Let($h24, Call(Member($now, "getHours"))),
          Let(
            $mm,
            Call(Member(Call($String, Call(Member($now, "getMinutes"))), "padStart"), 2, "0")),
          Let($h, If(Equals(Modulo($h24, 12), 0), 12, Modulo($h24, 12))),
          Return(
            Object(
              head="Time",
              args=List(
                Object(name="hour", value=$h24),
                Object(name="minute", value=Call(Member($now, "getMinutes"))),
                Object(
                  name="spoken",
                  value=Add(Add(Add(Add($h, ":"), $mm), " "), If(LessThan($h24, 12), "AM", "PM")))))))))),
  Realization(Time($h, $b), context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let($vals, Map($args, Lambda(List($a), Member($a, "value")))),
          Let(
            $period,
            Call(
              Member($vals, "find"),
              Lambda(
                List($v),
                And($v, Or(Equals(Member($v, "head"), "Am"), Equals(Member($v, "head"), "Pm")))))),
          Let($nums, Filter($vals, Lambda(List($v), Equals(TypeOf($v), "number")))),
          If(
            Or(Not(Length($nums)), NotEquals(Add(Length($nums), If($period, 1, 0)), Length($vals))),
            Return(Call(Member($api, "call"), "Time", Spread($vals))),
            Undefined()),
          Let(List($h, Default($m, 0)), $nums),
          Let(
            $h24,
            If($period, Add(Modulo($h, 12), If(Equals(Member($period, "head"), "Pm"), 12, 0)), $h)),
          Let($h12, If(Equals(Modulo($h24, 12), 0), 12, Modulo($h24, 12))),
          Return(
            Object(
              head="Time",
              args=List(
                Object(name="hour", value=$h24),
                Object(name="minute", value=$m),
                Object(
                  name="spoken",
                  value=Add(
                    Add(
                      Add(Add($h12, ":"), Call(Member(Call($String, $m), "padStart"), 2, "0")),
                      " "),
                    If(LessThan($h24, 12), "AM", "PM")))))))))),
  Realization(Time($h, $b, $c), context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let($vals, Map($args, Lambda(List($a), Member($a, "value")))),
          Let(
            $period,
            Call(
              Member($vals, "find"),
              Lambda(
                List($v),
                And($v, Or(Equals(Member($v, "head"), "Am"), Equals(Member($v, "head"), "Pm")))))),
          Let($nums, Filter($vals, Lambda(List($v), Equals(TypeOf($v), "number")))),
          If(
            Or(Not(Length($nums)), NotEquals(Add(Length($nums), If($period, 1, 0)), Length($vals))),
            Return(Call(Member($api, "call"), "Time", Spread($vals))),
            Undefined()),
          Let(List($h, Default($m, 0)), $nums),
          Let(
            $h24,
            If($period, Add(Modulo($h, 12), If(Equals(Member($period, "head"), "Pm"), 12, 0)), $h)),
          Let($h12, If(Equals(Modulo($h24, 12), 0), 12, Modulo($h24, 12))),
          Return(
            Object(
              head="Time",
              args=List(
                Object(name="hour", value=$h24),
                Object(name="minute", value=$m),
                Object(
                  name="spoken",
                  value=Add(
                    Add(
                      Add(Add($h12, ":"), Call(Member(Call($String, $m), "padStart"), 2, "0")),
                      " "),
                    If(LessThan($h24, 12), "AM", "PM")))))))))))

Concept(Am(), IsA(Data()))

Concept(Pm(), IsA(Data()))

Concept(Today(),
  IsA(Date()),
  Realization(Today(), context=Execution(), properties=List(Effectful()),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let($now, New($Date)),
          Let(
            $days,
            List("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday")),
          Return(
            Object(
              head="Date",
              args=List(
                Object(name="year", value=Call(Member($now, "getFullYear"))),
                Object(name="month", value=Add(Call(Member($now, "getMonth")), 1)),
                Object(name="day", value=Call(Member($now, "getDate"))),
                Object(name="weekday", value=Index($days, Call(Member($now, "getDay"))))))))))))

// The zero-argument form is a default: a lower-arity realization delegating to the
// fuller one. Defaults need no feature; patterns already match on exact arity.
Concept(Date(),
  Realization(Date(), context=Execution(), body=Date(Today())),
  Realization(Date($when), context=Execution(),
    body=Code(ir=Async(Lambda(List($args, $bindings, $api), Member(Index($args, 0), "value"))))))

// Date arithmetic, so a deictic that is computable actually computes.
//
// Learning taught Tomorrow what it IS — IsA(TemporalExpression()), InverseOf(Yesterday())
// — and left it inert, so "what will be the date tomorrow" got a definition instead of a
// date. Relations say what a thing is; they never say how to do it. Where the doing is
// expressible from Concepts that already exist, it should be seeded as a composition.
Concept(ShiftDays(),
  Realization(ShiftDays($date, $days), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let($date, Member(Index($args, 0), "value")),
          Let($days, Member(Index($args, 1), "value")),
          If(
            Or(
              Or(Not($date), NotEquals(Member($date, "head"), "Date")),
              NotEquals(TypeOf($days), "number")),
            Return(Call(Member($api, "call"), "ShiftDays", $date, $days)),
            Undefined()),
          Let(
            $get,
            Lambda(
              List($n),
              Sequence(
                Let(
                  $a,
                  Call(
                    Member(Member($date, "args"), "find"),
                    Lambda(List($x), Equals(Member($x, "name"), $n)))),
                Return(If($a, Member($a, "value"), Undefined()))))),
          Let(
            $d,
            New(
              $Date,
              Call($Number, Call($get, "year")),
              Subtract(Call($Number, Call($get, "month")), 1),
              Add(Call($Number, Call($get, "day")), $days))),
          Let(
            $names,
            List("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday")),
          Return(
            Object(
              head="Date",
              args=List(
                Object(name="year", value=Call(Member($d, "getFullYear"))),
                Object(name="month", value=Add(Call(Member($d, "getMonth")), 1)),
                Object(name="day", value=Call(Member($d, "getDate"))),
                Object(name="weekday", value=Index($names, Call(Member($d, "getDay"))))))))))))

Concept(DayAfter(),
  InverseOf(DayBefore()),
  Realization(DayAfter($date), context=Execution(), body=ShiftDays($date, 1)))

Concept(DayBefore(),
  InverseOf(DayAfter()),
  Realization(DayBefore($date), context=Execution(), body=ShiftDays($date, -1)))

Concept(Tomorrow(),
  IsA(Date()),
  IsA(Deictic()),
  InverseOf(Yesterday()),
  Realization(Tomorrow(), context=Execution(), body=DayAfter(Today())))

Concept(Yesterday(),
  IsA(Date()),
  IsA(Deictic()),
  InverseOf(Tomorrow()),
  Realization(Yesterday(), context=Execution(), body=DayBefore(Today())))

// Clock arithmetic, the counterpart of ShiftDays. Without it "add 5 hours to it" had no
// Concept to reach for, so the parser reached for Add, which is numeric, and the whole
// expression went residual on a time that is not a number.
Concept(ShiftHours(),
  Realization(ShiftHours($time, $hours), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let($time, Member(Index($args, 0), "value")),
          Let($raw, Member(Index($args, 1), "value")),
          Let(
            $hours,
            If(
              Equals(TypeOf($raw), "number"),
              $raw,
              If(
                And(
                  And($raw, Equals(Member($raw, "head"), "Number")),
                  Equals(TypeOf(Member(Index(Member($raw, "args"), 0), "value")), "number")),
                Member(Index(Member($raw, "args"), 0), "value"),
                $NaN))),
          If(
            Or(
              Or(Not($time), NotEquals(Member($time, "head"), "Time")),
              Not(Call(Member($Number, "isFinite"), $hours))),
            Return(
              Call(Member($api, "call"), "ShiftHours", $time, Member(Index($args, 1), "value"))),
            Undefined()),
          Let(
            $named,
            Lambda(
              List($n),
              Sequence(
                Let(
                  $a,
                  Call(
                    Member(Member($time, "args"), "find"),
                    Lambda(List($x), Equals(Member($x, "name"), $n)))),
                Return(If($a, Member($a, "value"), Undefined()))))),
          Let($h0, Call($Number, Call($named, "hour"))),
          Let($m0, Call($Number, Call($named, "minute"))),
          If(
            Or(
              Not(Call(Member($Number, "isFinite"), $h0)),
              Not(Call(Member($Number, "isFinite"), $m0))),
            Return(
              Call(Member($api, "call"), "ShiftHours", $time, Member(Index($args, 1), "value"))),
            Undefined()),
          Let($total, Modulo(Add(Modulo(Add($h0, $hours), 24), 24), 24)),
          Let($mm, Call(Member(Call($String, $m0), "padStart"), 2, "0")),
          Let($h12, If(Equals(Modulo($total, 12), 0), 12, Modulo($total, 12))),
          Return(
            Object(
              head="Time",
              args=List(
                Object(name="hour", value=$total),
                Object(name="minute", value=$m0),
                Object(
                  name="spoken",
                  value=Add(Add(Add(Add($h12, ":"), $mm), " "), If(LessThan($total, 12), "AM", "PM")))))))))))

Concept(HourAfter(),
  InverseOf(HourBefore()),
  Realization(HourAfter($time), context=Execution(), body=ShiftHours($time, 1)))

Concept(HourBefore(),
  InverseOf(HourAfter()),
  Realization(HourBefore($time), context=Execution(), body=ShiftHours($time, -1)))

Concept(Now(), SynonymOf(CurrentTimestamp()), IsA(Deictic()))

Concept(Me(), IsA(Deictic()))

Concept(You(), IsA(Deictic()))


// ------------------------------------------------------------------ *
// A little arithmetic, so the first end-to-end turn computes something real.
// ------------------------------------------------------------------
Concept(Multiply(),
  Realization(Multiply($left, $right), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $asNumber,
            Lambda(
              List($x),
              Sequence(
                If(Equals(TypeOf($x), "number"), Return($x), Undefined()),
                If(
                  And($x, Equals(Member($x, "head"), "Number")),
                  Return(Call($asNumber, Member(Index(Member($x, "args"), 0), "value"))),
                  Undefined()),
                Return($NaN)))),
          Let($l, Call($asNumber, Member(Index($args, 0), "value"))),
          Let($r, Call($asNumber, Member(Index($args, 1), "value"))),
          If(
            Or(Call(Member($Number, "isNaN"), $l), Call(Member($Number, "isNaN"), $r)),
            Return(
              Call(
                Member($api, "call"),
                "Multiply",
                Member(Index($args, 0), "value"),
                Member(Index($args, 1), "value"))),
            Undefined()),
          Return(Multiply($l, $r)))))))

Concept(Add(),
  Realization(Add($left, $right), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $asNumber,
            Lambda(
              List($x),
              Sequence(
                If(Equals(TypeOf($x), "number"), Return($x), Undefined()),
                If(
                  And($x, Equals(Member($x, "head"), "Number")),
                  Return(Call($asNumber, Member(Index(Member($x, "args"), 0), "value"))),
                  Undefined()),
                Return($NaN)))),
          Let($l, Call($asNumber, Member(Index($args, 0), "value"))),
          Let($r, Call($asNumber, Member(Index($args, 1), "value"))),
          If(
            Or(Call(Member($Number, "isNaN"), $l), Call(Member($Number, "isNaN"), $r)),
            Return(
              Call(
                Member($api, "call"),
                "Add",
                Member(Index($args, 0), "value"),
                Member(Index($args, 1), "value"))),
            Undefined()),
          Return(Add($l, $r)))))),
  Realization(Add($a, $b), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $field,
              Lambda(
                List($r, $n),
                Sequence(
                  Let(
                    $a,
                    Call(
                      Member(Member($r, "args"), "find"),
                      Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))))),
            Let(
              $DAY,
              List("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday")),
            Let(
              $units,
              Object(
                Days=List(1, "day"),
                Weeks=List(7, "day"),
                Hours=List(60, "minute"),
                Minutes=List(1, "minute"))),
            Let(
              $isDuration,
              Lambda(
                List($v),
                And(
                  And(
                    And($v, Index($units, Member($v, "head"))),
                    Equals(Length(Member($v, "args")), 1)),
                  Equals(TypeOf(Member(Index(Member($v, "args"), 0), "value")), "number")))),
            Let(
              $isRecord,
              Lambda(
                List($v),
                And(
                  And(
                    $v,
                    Or(Equals(Member($v, "head"), "Date"), Equals(Member($v, "head"), "Time"))),
                  Call(
                    Member(Member($v, "args"), "every"),
                    Lambda(List($a), NotEquals(Member($a, "name"), Undefined())))))),
            Let(
              $clock,
              Lambda(
                List($t),
                Sequence(
                  Let($h24, Call(Member($Math, "floor"), Divide($t, 60))),
                  Let($mm, Modulo($t, 60)),
                  Let($h12, If(Equals(Modulo($h24, 12), 0), 12, Modulo($h24, 12))),
                  Return(
                    Object(
                      head="Time",
                      args=List(
                        Object(name="hour", value=$h24),
                        Object(name="minute", value=$mm),
                        Object(
                          name="spoken",
                          value=Add(
                            Add(
                              Add(
                                Add($h12, ":"),
                                Call(Member(Call($String, $mm), "padStart"), 2, "0")),
                              " "),
                            If(LessThan($h24, 12), "AM", "PM"))))))))),
            Let(
              $date,
              Lambda(
                List($d, $time),
                Object(
                  head="Date",
                  args=Concat(
                    List(
                      Object(name="year", value=Call(Member($d, "getFullYear"))),
                      Object(name="month", value=Add(Call(Member($d, "getMonth")), 1)),
                      Object(name="day", value=Call(Member($d, "getDate"))),
                      Object(name="weekday", value=Index($DAY, Call(Member($d, "getDay"))))),
                    If($time, List(Object(name="time", value=$time)), List()))))),
            Let(
              $minutesOf,
              Lambda(
                List($t),
                Add(
                  Multiply(Call($Number, Call($field, $t, "hour")), 60),
                  Call($Number, Call($field, $t, "minute"))))),
            Let(
              $shift,
              Lambda(
                List($record, $duration, $sign),
                Sequence(
                  Let(List($per, $kind), Index($units, Member($duration, "head"))),
                  Let(
                    $n,
                    Multiply(
                      Multiply(Member(Index(Member($duration, "args"), 0), "value"), $per),
                      $sign)),
                  If(
                    Equals(Member($record, "head"), "Date"),
                    Sequence(
                      Let($time, Call($field, $record, "time")),
                      Let($total, If(Equals($kind, "day"), Multiply($n, 1440), $n)),
                      If(And(NotEquals($kind, "day"), Not($time)), Return(Undefined()), Undefined()),
                      Let($t, Add(If($time, Call($minutesOf, $time), 0), $total)),
                      Let($carry, Call(Member($Math, "floor"), Divide($t, 1440))),
                      Let($rest, Modulo(Add(Modulo($t, 1440), 1440), 1440)),
                      Let(
                        $d,
                        New(
                          $Date,
                          Call($Number, Call($field, $record, "year")),
                          Subtract(Call($Number, Call($field, $record, "month")), 1),
                          Add(Call($Number, Call($field, $record, "day")), $carry))),
                      Return(Call($date, $d, If($time, Call($clock, $rest), Undefined())))),
                    Undefined()),
                  Let($total, If(Equals($kind, "day"), Multiply($n, 1440), $n)),
                  Return(
                    Call(
                      $clock,
                      Modulo(Add(Modulo(Add(Call($minutesOf, $record), $total), 1440), 1440), 1440)))))),
            Let(
              $now,
              Async(
                Lambda(
                  List($duration),
                  Call(
                    Member($api, "evaluate"),
                    Call(
                      Member($api, "call"),
                      If(
                        Equals(Index(Index($units, Member($duration, "head")), 1), "day"),
                        "Today",
                        "Time")))))),
            Let(List($a, $b), Map($args, Lambda(List($x), Member($x, "value")))),
            If(
              And(Equals(TypeOf($a), "number"), Equals(TypeOf($b), "number")),
              Return(Add($a, Multiply(1, $b))),
              Undefined()),
            If(
              And(Call($isRecord, $a), Call($isDuration, $b)),
              Return(Otherwise(Call($shift, $a, $b, 1), Call(Member($api, "call"), "Add", $a, $b))),
              Undefined()),
            If(
              And(And(Equals(1, 1), Call($isDuration, $a)), Call($isRecord, $b)),
              Return(Otherwise(Call($shift, $b, $a, 1), Call(Member($api, "call"), "Add", $a, $b))),
              Undefined()),
            Return(Call(Member($api, "call"), "Add", $a, $b))))))))

Concept(Subtract(),
  Realization(Subtract($left, $right), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $asNumber,
            Lambda(
              List($x),
              Sequence(
                If(Equals(TypeOf($x), "number"), Return($x), Undefined()),
                If(
                  And($x, Equals(Member($x, "head"), "Number")),
                  Return(Call($asNumber, Member(Index(Member($x, "args"), 0), "value"))),
                  Undefined()),
                Return($NaN)))),
