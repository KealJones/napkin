Concept(Cell(),
  Realization(Cell($initial), properties=List(Effectful()),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Call(Member(Member($api, "cells"), "allocate"), Member(Index($args, 0), "value"))))))

Concept(Get(),
  Realization(Get($ref), properties=List(Effectful()),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Call(Member(Member($api, "cells"), "read"), Member(Index($args, 0), "value"))))))

Concept(Set(),
  Realization(Set($ref, $value), properties=List(Effectful()),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Call(
          Member(Member($api, "cells"), "write"),
          Member(Index($args, 0), "value"),
          Member(Index($args, 1), "value"))))))

Concept(CellRef(), IsA(Data()))

Concept(ExecutionFailed(), IsA(Failure()))

Concept(UnboundVariable(), IsA(Failure()))

Concept(BudgetExceeded(), IsA(Failure()))

Concept(Unrealized(), IsA(Failure()))

Concept(UnknownTruth(), IsA(TruthValue()))


// ------------------------------------------------------------------ *
// Source markers. Each projection is Lossy, so Describe withholds it and the
// marker survives into its own description.
// ------------------------------------------------------------------
// Markers are named Mark* so no English word collides with one: "a fuzzy bear" is the
// adjective Fuzzy(Bear()), never a marker. A marker whose trigger words would otherwise be
// lost carries them verbatim first: MarkFuzzy("or whatever", x), MarkEmphasis("NOT", x).
Concept(MarkCorrection(),
  IsA(Marker()),
  Realization(MarkCorrection($old, $new), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 1), "value"))))))))

Concept(MarkMisspelling(),
  IsA(Marker()),
  Realization(MarkMisspelling($wrote, $meant), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 1), "value"))))))))

Concept(MarkFuzzy(),
  IsA(Marker()),
  Realization(MarkFuzzy($words, $x), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 1), "value"))))))))

Concept(MarkEmphasis(),
  IsA(Marker()),
  Realization(MarkEmphasis($words, $x), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 1), "value"))))))))

// Aside and Ref have no execution realization at all, deliberately: both should stay
// visible until something resolves them rather than quietly evaluating to anything.
// Layout, kept rather than dropped (`eval/ears/gold.md`, convention 7). A list entry and a
// fenced block project to their content; a heading is like an aside and stays visible.
Concept(Heading(), IsA(Marker()))

Concept(Item(),
  IsA(Marker()),
  Realization(Item($n, $x), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 1), "value"))))))),
  Realization(Item($x), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 0), "value"))))))))

Concept(Block(),
  IsA(Marker()),
  Realization(Block($language, $text), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 1), "value"))))))),
  Realization(Block($text), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 0), "value"))))))))

// The user asserting something, as opposed to asking.
Concept(Fact(), IsA(Frame()))

// The user requesting an action. Not a question, and not a claim.
// An imperative is performed: under execution the frame projects to what it frames. It is
// Lossy, so describing the request still shows that it was an order. Without this, every
// request the Ears framed stayed an unevaluated Do(...).
Concept(Do(),
  IsA(Frame()),
  Realization(Do($x), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Await(Call(Member($api, "evaluate"), Member(Index($args, 0), "value"))))))))

// Delivery: "tell me X", "show me X", "help me X". Under execution the frame does what it
// delivers, the way "can you X" does X; who it is delivered to is not part of the work. With
// nothing but a recipient ("tell me") there is nothing to do, so it stays residual.
// Delivery. `Do(Tell(Me(), Whether(...)))` is "tell me if...".
Concept(Tell(),
  IsA(Frame()),
  Realization(Tell(Rest($args)), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $recipient,
              Lambda(
                List($v),
                And(
                  And($v, Includes(List("Me", "You", "We", "Us", "Them"), Member($v, "head"))),
                  Equals(Length(Member($v, "args")), 0)))),
            Let(
              $content,
              Filter($args, Lambda(List($a), Not(Call($recipient, Member($a, "value")))))),
            If(
              Not(Length($content)),
              Return(
                Call(
                  Member($api, "call"),
                  "Tell",
                  Spread(Map($args, Lambda(List($a), Member($a, "value")))))),
              Undefined()),
            Var($result, Undefined()),
            ForOf(
              $a,
              $content,
              Assign($result, Await(Call(Member($api, "evaluate"), Member($a, "value"))))),
            Return($result)))))))

// Asking for something to be produced, as opposed to told.
Concept(Give(), IsA(Frame()), SynonymOf(Show()))

Concept(Show(),
  IsA(Frame()),
  Realization(Show(Rest($args)), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $recipient,
              Lambda(
                List($v),
                And(
                  And($v, Includes(List("Me", "You", "We", "Us", "Them"), Member($v, "head"))),
                  Equals(Length(Member($v, "args")), 0)))),
            Let(
              $content,
              Filter($args, Lambda(List($a), Not(Call($recipient, Member($a, "value")))))),
            If(
              Not(Length($content)),
              Return(
                Call(
                  Member($api, "call"),
                  "Show",
                  Spread(Map($args, Lambda(List($a), Member($a, "value")))))),
              Undefined()),
            Var($result, Undefined()),
            ForOf(
              $a,
              $content,
              Assign($result, Await(Call(Member($api, "evaluate"), Member($a, "value"))))),
            Return($result)))))))

// "help me X": the help is doing X.
Concept(Help(),
  IsA(Frame()),
  Realization(Help(Rest($args)), context=Execution(), evaluateArguments=false, properties=List(Lossy()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let(
              $recipient,
              Lambda(
                List($v),
                And(
                  And($v, Includes(List("Me", "You", "We", "Us", "Them"), Member($v, "head"))),
                  Equals(Length(Member($v, "args")), 0)))),
            Let(
              $content,
              Filter($args, Lambda(List($a), Not(Call($recipient, Member($a, "value")))))),
            If(
              Not(Length($content)),
              Return(
                Call(
                  Member($api, "call"),
                  "Help",
                  Spread(Map($args, Lambda(List($a), Member($a, "value")))))),
              Undefined()),
            Var($result, Undefined()),
            ForOf(
              $a,
              $content,
              Assign($result, Await(Call(Member($api, "evaluate"), Member($a, "value"))))),
            Return($result)))))))

