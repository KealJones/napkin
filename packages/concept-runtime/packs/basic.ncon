Concept(Ty(), IsA(Thanking()))

Concept(Bye(), IsA(Farewell()))

Concept(Goodbye(), IsA(Farewell()))

Concept(Cya(), IsA(Farewell()))

// Producing text or code, which is what makes a target language reachable from a chat.
Concept(Write(), IsA(Frame()))

// Modifiers: progressive narrowing, position, and politeness that carries no content.
Concept(Qualify(), IsA(Modifier()))

Concept(Ordinal(), IsA(Modifier()))

Concept(Field(), IsA(Modifier()))

// "please" stays where it was said, around what it asks, and projects to it.
Concept(Please(),
  IsA(Politeness()),
  Realization(Please($x),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

// "can you X" is a question about ability in form and a request in use (Searle). Read as
// the request only when asked as a question, which the Interrogative facet says.
Concept(Can(),
  IsA(Politeness()),
  Realization(Can(You(), $x),
    context = Context(Execution(), Interrogative()),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

Concept(Could(),
  IsA(Politeness()),
  Realization(Could(You(), $x),
    context = Context(Execution(), Interrogative()),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

Concept(Would(),
  IsA(Politeness()),
  Realization(Would(You(), $x),
    context = Context(Execution(), Interrogative()),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

// Tense words are kept as said and project to what they wrap when a value is wanted.
Concept(Will(),
  IsA(Politeness()),
  Realization(Will(You(), $x),
    context = Context(Execution(), Interrogative()),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  ),
  Realization(Will($x),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

Concept(Should(), IsA(Politeness()))

Concept(MarkAside(), IsA(Marker()))

// ------------------------------------------------------------------ *
// Mood (`design/reading-spec.md`). Added after the Ears by `ears/mood.ts`, never by the
// model, named for what it does so no English word collides with it. Running a line in
// a mood adds the mood as a facet, so realizations select by mood through ordinary
// context specificity instead of a special case.
// ------------------------------------------------------------------
Concept(Imperative(), IsA(ContextFacet()), IsA(MoodKind()))

Concept(Declarative(), IsA(ContextFacet()), IsA(MoodKind()))

// ------------------------------------------------------------------ *
// Interrogatives. An interrogative goes where the unknown is.
// ------------------------------------------------------------------
// One realization serves every question word, reached by inheritance. Asking for the
// value of something is the same operation whichever word the message used.
Concept(Interrogative(),
  IsA(ContextFacet()),
  IsA(MoodKind()),
  Realization($question,
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            If(
              Not(Length($args)),
              Return(Call(Member($api, "call"), "Unknown")),
              Undefined()
            ),
            Var($subject, Member(Index($args, 0), "value")),
            Bind($WHEN,
              List(
                "Tomorrow",
                "Yesterday",
                "Today",
                "Tonight",
                "In",
                "Ago",
                "Next",
                "Last",
                "On",
                "After",
                "Before"
              )
            ),
            Bind($when,
              Lambda(List($e),
                Sequence(
                  If(
                    Or(Not($e), Not(Member($e, "head"))),
                    Return(Undefined()),
                    Undefined()
                  ),
                  If(
                    Includes($WHEN, Member($e, "head")),
                    Return($e),
                    Undefined()
                  ),
                  Bind($inner,
                    Map(
                      Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                      Lambda(List($a), Member($a, "value"))
                    )
                  ),
                  If(
                    Or(
                      Or(Equals(Member($e, "head"), "Will"), Equals(Member($e, "head"), "Is")),
                      Equals(Member($e, "head"), "Was")
                    ),
                    Sequence(
                      Bind($rest,
                        Filter(
                          $inner,
                          Lambda(List($v),
                            Not(And(And($v, Equals(Member($v, "head"), "It")), Equals(Length(Member($v, "args")), 0)))
                          )
                        )
                      ),
                      Return(
                        If(
                          Equals(Length($rest), 1),
                          Call($when, Index($rest, 0)),
                          Undefined()
                        )
                      )
                    ),
                    Undefined()
                  ),
                  If(
                    And(Equals(Member($e, "head"), "Be"), Equals(Length($inner), 1)),
                    Return(Call($when, Index($inner, 0))),
                    Undefined()
                  ),
                  Return(Undefined())
                )
              )
            ),
            Bind($at,
              Call(
                Member(Map(Call(Member($args, "slice"), 1), Lambda(List($a), Call($when, Member($a, "value")))), "find"),
                Lambda(List($w), NotEquals($w, Undefined()))
              )
            ),
            If(
              And(And(And($at, $subject), Member($subject, "head")), Equals(Length(Member($subject, "args")), 0)),
              Assign($subject, Call(Member($api, "call"), Member($subject, "head"), $at)),
              Undefined()
            ),
            If(
              And(
                And(
                  And(And(And(Not($at), GreaterThan(Length($args), 1)), $subject), Member($subject, "head")),
                  Equals(Length(Member($subject, "args")), 0)
                ),
                Call(Member(Regex("[^s]s$", ""), "test"), Member($subject, "head"))
              ),
              Sequence(
                Bind($members, Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "Members", $subject)))),
                If(
                  And(And($members, Equals(Member($members, "head"), "List")), Length(Member($members, "args"))),
                  Return(Call(Member($api, "call"), "Answer", $members)),
                  Undefined()
                )
              ),
              Undefined()
            ),
            If(
              And(
                And(
                  And(
                    And(
                      And(Not($at), Equals(Length($args), 2)),
                      Equals(TypeOf(Member(Index($args, 1), "value")), "number")
                    ),
                    $subject
                  ),
                  Member($subject, "head")
                ),
                Equals(Length(Member($subject, "args")), 0)
              ),
              Assign(
                $subject,
                Call(
                  Member($api, "call"),
                  Member($subject, "head"),
                  Member(Index($args, 1), "value")
                )
              ),
              Undefined()
            ),
            // A question that says more than its subject, which nothing above read (a copula is
            // only how it was asked): describing
            // the subject would answer something else ("when do you say hello").
            If(
              And(
                And(Not($at), GreaterThan(Length($args), 1)),
                Call(
                  Member(Call(Member($args, "slice"), 1), "some"),
                  Lambda(List($a),
                    And(
                      And(Member($a, "value"), Equals(TypeOf(Member($a, "value")), "object")),
                      And(
                        In("head", Member($a, "value")),
                        Not(
                          Call(
                            Member(List("Is", "Was", "Will", "Be", "Are"), "includes"),
                            Member(Member($a, "value"), "head")
                          )
                        )
                      )
                    )
                  )
                )
              ),
              Return(Call(Member($api, "call"), "Unknown")),
              Undefined()
            ),
            Bind($value, Await(Call(Member($api, "evaluate"), $subject))),
            // A compound subject that realized to itself is looked for, not described: "my
            // name" is not a kind with relations to list, it is something said or held.
            If(
              And(
                And(And($subject, Member($subject, "head")), Length(Member($subject, "args"))),
                Equals(Call(Member($api, "format"), $value), Call(Member($api, "format"), $subject))
              ),
              Sequence(
                Bind($found, Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "Pursue", $subject)))),
                If(
                  And(Member($found, "head"), Equals(Member($found, "head"), "Found")),
                  Return(
                    Call(
                      Member($api, "call"),
                      "Answer",
                      Member(Index(Member($found, "args"), 0), "value")
                    )
                  ),
                  Undefined()
                ),
                // Not found anywhere is not knowing, said plainly. Describing the head of a
                // compound would answer "my cat's name" with what "my" is.
                Return(Call(Member($api, "call"), "Unknown", $subject))
              ),
              Undefined()
            ),
            // A kind that is only its synonym by another name is described as said: what
            // the synonym holds describes it too (Relations).
            If(
              And(
                And(
                  And(
                    And(
                      And(
                        And(And($subject, Member($subject, "head")), Equals(Length(Member($subject, "args")), 0)),
                        $value
                      ),
                      Member($value, "head")
                    ),
                    Equals(Length(Member($value, "args")), 0)
                  ),
                  NotEquals(Member($value, "head"), Member($subject, "head"))
                ),
                Call(
                  Member(
                    Otherwise(
                      OptionalMember(Call(Member(Member($api, "store"), "get"), Member($subject, "head")), "relations"),
                      List()
                    ),
                    "some"
                  ),
                  Lambda(List($r),
                    And(
                      And(Member($r, "claim"), Equals(Member(Member($r, "claim"), "head"), "SynonymOf")),
                      Equals(
                        OptionalMember(OptionalMember(Index(Member(Member($r, "claim"), "args"), 0), "value"), "head"),
                        Member($value, "head")
                      )
                    )
                  )
                )
              ),
              Return(
                Await(
                  Call(
                    Member($api, "evaluate"),
                    Call(Member($api, "call"), "Relations", $subject),
                    Call(Member($api, "call"), "Describe")
                  )
                )
              ),
              Undefined()
            ),
            Bind($plainKind,
              And(
                And(
                  And(
                    And(
                      And(And($subject, Member($subject, "head")), Equals(Length(Member($subject, "args")), 0)),
                      $value
                    ),
                    Member($value, "head")
                  ),
                  Equals(Length(Member($value, "args")), 0)
                ),
                Not(
                  Call(
                    Member(
                      Otherwise(
                        OptionalMember(
                          Call(Member(Member($api, "store"), "get"), Member($value, "head")),
                          "realizations"
                        ),
                        List()
                      ),
                      "some"
                    ),
                    Lambda(List($r),
                      And(
                        Not(Member($r, "retired")),
                        Not(
                          Call(
                            Member(Member($r, "properties"), "some"),
                            Lambda(List($p), Equals(Member($p, "head"), "Forwarding"))
                          )
                        )
                      )
                    )
                  )
                )
              )
            ),
            If(
              And($plainKind, NotEquals(Call(Member($api, "format"), $value), Call(Member($api, "format"), $subject))),
              Return(
                Await(
                  Call(
                    Member($api, "evaluate"),
                    Call(Member($api, "call"), "Relations", $value),
                    Call(Member($api, "call"), "Describe")
                  )
                )
              ),
              Undefined()
            ),
            If(
              NotEquals(Call(Member($api, "format"), $value), Call(Member($api, "format"), $subject)),
              Return(Call(Member($api, "call"), "Answer", $value)),
              Undefined()
            ),
            Return(
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), "Relations", $subject),
                  Call(Member($api, "call"), "Describe")
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(Checking(), IsA(ContextFacet()), IsA(MoodKind()))

Concept(MoodKind(), IsA(Category()))

Concept(InlineCode(),
  IsA(Marker()),
  Realization(InlineCode($text),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $text
  )
)

// Nothing in it names anything; it stays visible so the system can say it did not understand.
Concept(Unclear(), IsA(Marker()))

Concept(What(), IsA(Interrogative()))

Concept(Who(), IsA(Interrogative()))

Concept(When(), IsA(Interrogative()))

Concept(Where(), IsA(Interrogative()))

Concept(Why(), IsA(Interrogative()))

Concept(How(), IsA(Interrogative()))

Concept(Which(), IsA(Interrogative()))

Concept(HowMany(), IsA(Interrogative()))

Concept(HowMuch(), IsA(Interrogative()))

Concept(WhichOf(), IsA(Interrogative()))

// "who is", "where are", "what do": the Ears fuses a helper onto the question word
// (reading-spec P4), and a present-tense one adds nothing the question word does not
// already ask, so each is a plain synonym. A tensed one ("who did") is not: it realizes
// through tense and inverse (reading-spec Part 5.3).
Concept(WhatIs(), SynonymOf(What()))

Concept(WhatAre(), SynonymOf(What()))

Concept(WhatAm(), SynonymOf(What()))

Concept(WhatDo(), SynonymOf(What()))

Concept(WhatDoes(), SynonymOf(What()))

Concept(WhoIs(), SynonymOf(Who()))

Concept(WhoAre(), SynonymOf(Who()))

Concept(WhoAm(), SynonymOf(Who()))

Concept(WhoDo(), SynonymOf(Who()))

Concept(WhoDoes(), SynonymOf(Who()))

Concept(WhenIs(), SynonymOf(When()))

Concept(WhenAre(), SynonymOf(When()))

Concept(WhenAm(), SynonymOf(When()))

Concept(WhenDo(), SynonymOf(When()))

Concept(WhenDoes(), SynonymOf(When()))

Concept(WhereIs(), SynonymOf(Where()))

Concept(WhereAre(), SynonymOf(Where()))

Concept(WhereAm(), SynonymOf(Where()))

Concept(WhereDo(), SynonymOf(Where()))

Concept(WhereDoes(), SynonymOf(Where()))

Concept(WhyIs(), SynonymOf(Why()))

Concept(WhyAre(), SynonymOf(Why()))

Concept(WhyAm(), SynonymOf(Why()))

Concept(WhyDo(), SynonymOf(Why()))

Concept(WhyDoes(), SynonymOf(Why()))

Concept(HowIs(), SynonymOf(How()))

Concept(HowAre(), SynonymOf(How()))

Concept(HowAm(), SynonymOf(How()))

Concept(HowDo(), SynonymOf(How()))

Concept(HowDoes(), SynonymOf(How()))

Concept(WhichIs(), SynonymOf(Which()))

Concept(WhichAre(), SynonymOf(Which()))

Concept(WhichAm(), SynonymOf(Which()))

Concept(WhichDo(), SynonymOf(Which()))

Concept(WhichDoes(), SynonymOf(Which()))

// A yes/no question wants a truth value, not a subject, so it declares its own
// realization locally, which beats the inherited one on distance.
//
// One question in form is a request in use: "can you write me X" asks about ability and
// wants X (Searle's indirect speech acts). The Ears writes the form it heard,
// Whether(Can(You(), X)), and this is where the use is read. One realization rather than
// two, because two overlapping patterns on one Concept are ordered only by declaration
// order (concept-spec Part 9 has no rule for pattern specificity).
Concept(Whether(),
  IsA(Interrogative()),
  Realization(Whether($proposition),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Program()),
    body = Bind($p,
      Quote($proposition),
      Bind($asking,
        Bind($t3,
          Bind($t2,
            Bind($t1,
              Bind($t0,
                $p,
                If(
                  Truthy($t0),
                  Truthy(Includes(List("Can", "Could", "Would", "Will"), Head($p))),
                  $t0
                )
              ),
              If(Truthy($t1), Identical(Length(Arguments($p)), 2), $t1)
            ),
            If(
              Truthy($t2),
              FieldOf(Element(Arguments($p), 0), "value"),
              $t2
            )
          ),
          If(
            Truthy($t3),
            Identical(Head(FieldOf(Element(Arguments($p), 0), "value")), "You"),
            $t3
          )
        ),
        If(
          Truthy($asking),
          Evaluate(FieldOf(Element(Arguments($p), 1), "value")),
          Bind($v,
            Evaluate($p),
            If(
              Truthy(
                If(
                  Identical($v, true),
                  true,
                  Bind($t4,
                    $v,
                    If(Truthy($t4), Identical(Head($v), "True"), $t4)
                  )
                )
              ),
              MakeCall("Answer", List(MakeCall("True", List()))),
              If(
                Truthy(
                  If(
                    Identical($v, false),
                    true,
                    Bind($t5,
                      $v,
                      If(Truthy($t5), Identical(Head($v), "False"), $t5)
                    )
                  )
                ),
                MakeCall("Answer", List(MakeCall("False", List()))),
                MakeCall("Answer", List(MakeCall("UnknownTruth", List())))
              )
            )
          )
        )
      )
    )
  )
)

// "is chess a sport", "are cats animals", "is 7 prime": a yes/no question in statement
// order, verb first because the subject cannot always head (reading-spec P2). A question
// is a lookup, never a lesson: an unknown answer is said as unknown, so asking can never
// teach Is a realization.
// Written in the code IR, in order: a comparison ("is 100 more than 99") is computed; a
// role held for someone ("is he my coworker") is CoworkerOf(<the user>); a subject never
// heard of is evaluated, leaving the gap where learning finds it, so asking never teaches
// Is; then IsA with inheritance, the SubclassOf chain from the subject or from any kind it
// is an instance of ("is a volcano a mountain", K2 is a volcano so a mountain), DistinctFrom
// for no ("an emoji is not an emoticon"), and a nullary claim like Small() held.
Concept(Is(),
  Realization(Is($subject, $category),
    context = Context(Execution(), Interrogative()),
    evaluateArguments = false,
    properties = List(Compile()),
    body = If(
      Not(IsCall($category)),
      Answer(UnknownTruth()),
      Bind($comparison,
        If(
          Matches(Head($category), "^(More|Greater|Bigger|Larger|Higher|Taller|Older)Than$"),
          "GreaterThan",
          If(
            Matches(Head($category), "^(Less|Smaller|Fewer|Lower|Shorter|Younger)Than$"),
            "LessThan",
            ""
          )
        ),
        Bind($compared,
          If(
            And(Not(Equals($comparison, "")), Equals(Arg($category, 1), Undefined())),
            Evaluate(MakeCall($comparison, List(Evaluate($subject), Evaluate(Arg($category, 0))))),
            Nothing()
          ),
          If(
            Or(Equals($compared, True()), Equals($compared, False())),
            Answer($compared),
            If(
              Not(IsCall($subject)),
              Answer(UnknownTruth()),
              Bind($resolved,
                ArgNamed($subject, "resolvedTo"),
                Bind($what,
                  If(
                    Not(Equals($resolved, Undefined())),
                    MakeCall(Head($resolved), List()),
                    Singular($subject)
                  ),
                  If(
                    And(Or(Equals(Head($category), "My"), Equals(Head($category), "Your")), IsCall(Arg($category, 0))),
                    Bind($owner,
                      If(
                        Equals(Head($category), "My"),
                        First(Subjects("IsA", "User")),
                        MakeCall("Self", List())
                      ),
                      If(
                        Includes(Closure($what, JoinText(Head(Arg($category, 0)), "Of")), $owner),
                        Answer(True()),
                        Answer(UnknownTruth())
                      )
                    ),
                    Bind($learned,
                      If(
                        Or(Known($what), Not(Equals($resolved, Undefined()))),
                        Nothing(),
                        Evaluate($what)
                      ),
                      Bind($kind,
                        Singular($category),
                        Bind($truth,
                          TruthOf($what, "IsA", $kind),
                          If(
                            Equals($truth, True()),
                            Answer(True()),
                            If(
                              Equals(TruthOf($what, "SubclassOf", $kind), True()),
                              Answer(True()),
                              If(
                                GreaterThan(
                                  Length(
                                    Filter(
                                      Closure($what, "IsA"),
                                      Lambda(List($k), Equals(TruthOf($k, "SubclassOf", $kind), True()))
                                    )
                                  ),
                                  0
                                ),
                                Answer(True()),
                                If(
                                  Includes(Holds($what, "DistinctFrom"), $kind),
                                  Answer(False()),
                                  If(
                                    Claimed($what, Head($kind)),
                                    Answer(True()),
                                    If(
                                      Equals($truth, False()),
                                      Answer(False()),
                                      Answer(UnknownTruth())
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ),
  Realization(Is($x),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy(), Program()),
    body = $x
  )
)

Concept(Are(),
  Realization(Are($subject, $category),
    context = Context(Execution(), Interrogative()),
    evaluateArguments = false,
    properties = List(Compile()),
    body = If(
      Not(IsCall($category)),
      Answer(UnknownTruth()),
      Bind($comparison,
        If(
          Matches(Head($category), "^(More|Greater|Bigger|Larger|Higher|Taller|Older)Than$"),
          "GreaterThan",
          If(
            Matches(Head($category), "^(Less|Smaller|Fewer|Lower|Shorter|Younger)Than$"),
            "LessThan",
            ""
          )
        ),
        Bind($compared,
          If(
            And(Not(Equals($comparison, "")), Equals(Arg($category, 1), Undefined())),
            Evaluate(MakeCall($comparison, List(Evaluate($subject), Evaluate(Arg($category, 0))))),
            Nothing()
          ),
          If(
            Or(Equals($compared, True()), Equals($compared, False())),
            Answer($compared),
            If(
              Not(IsCall($subject)),
              Answer(UnknownTruth()),
              Bind($resolved,
                ArgNamed($subject, "resolvedTo"),
                Bind($what,
                  If(
                    Not(Equals($resolved, Undefined())),
                    MakeCall(Head($resolved), List()),
                    Singular($subject)
                  ),
                  If(
                    And(Or(Equals(Head($category), "My"), Equals(Head($category), "Your")), IsCall(Arg($category, 0))),
                    Bind($owner,
                      If(
                        Equals(Head($category), "My"),
                        First(Subjects("IsA", "User")),
                        MakeCall("Self", List())
                      ),
                      If(
                        Includes(Closure($what, JoinText(Head(Arg($category, 0)), "Of")), $owner),
                        Answer(True()),
                        Answer(UnknownTruth())
                      )
                    ),
                    Bind($learned,
                      If(
                        Or(Known($what), Not(Equals($resolved, Undefined()))),
                        Nothing(),
                        Evaluate($what)
                      ),
                      Bind($kind,
                        Singular($category),
                        Bind($truth,
                          TruthOf($what, "IsA", $kind),
                          If(
                            Equals($truth, True()),
                            Answer(True()),
                            If(
                              Equals(TruthOf($what, "SubclassOf", $kind), True()),
                              Answer(True()),
                              If(
                                GreaterThan(
                                  Length(
                                    Filter(
                                      Closure($what, "IsA"),
                                      Lambda(List($k), Equals(TruthOf($k, "SubclassOf", $kind), True()))
                                    )
                                  ),
                                  0
                                ),
                                Answer(True()),
                                If(
                                  Includes(Holds($what, "DistinctFrom"), $kind),
                                  Answer(False()),
                                  If(
                                    Claimed($what, Head($kind)),
                                    Answer(True()),
                                    If(
                                      Equals($truth, False()),
                                      Answer(False()),
                                      Answer(UnknownTruth())
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(NoDescription(), IsA(Result()))

Concept(Readings(), IsA(Result()))

Concept(Unknown(), IsA(Data()))

Concept(String(), IsA(Primitive()))

Concept(Boolean(), IsA(Primitive()))

Concept(Object(), IsA(Collection()))

Concept(Pair(), IsA(Collection()))

Concept(Number(),
  Realization(Number($value),
    context = Execution(),
    properties = List(Program()),
    body = Bind($v,
      $value,
      If(
        Identical(TypeOf($v), "number"),
        $v,
        Bind($words,
          Record(
            zero = 0,
            one = 1,
            two = 2,
            three = 3,
            four = 4,
            five = 5,
            six = 6,
            seven = 7,
            eight = 8,
            nine = 9,
            ten = 10,
            eleven = 11,
            twelve = 12,
            dozen = 12,
            twenty = 20,
            thirty = 30,
            forty = 40,
            fifty = 50,
            sixty = 60,
            seventy = 70,
            eighty = 80,
            ninety = 90,
            hundred = 100,
            thousand = 1000,
            million = 1000000,
            billion = 1000000000
          ),
          If(
            Identical(TypeOf($v), "string"),
            Bind($n,
              Element($words, Lowercase($v)),
              If(
                NotIdentical($n, Undefined()),
                $n,
                Bind($parsed,
                  ToNumber($v),
                  If(
                    IsFiniteNumber($parsed),
                    $parsed,
                    MakeCall("Number", List($value))
                  )
                )
              )
            ),
            MakeCall("Number", List($value))
          )
        )
      )
    )
  )
)

// ------------------------------------------------------------------ *
// Rendering wraps its subject rather than parameterising it, so Date never
// learns that formats exist.
//
// Formatting NEVER returns a bare string. It returns the same Concept with its
// rendering carried in `spoken`, because a display string is a field of a value and
// not a replacement for it. Returning "10:15" cost the next turn its arithmetic: the
// reference resolved to text, Add saw a string, and the whole thing went residual.
// ------------------------------------------------------------------
Concept(Format(),
  Realization(Format($subject, $spec),
    context = Execution(),
    properties = List(Program()),
    body = Bind($subject2,
      $subject,
      Bind($spec2,
        $spec,
        Bind($pattern,
          If(Identical(TypeOf($spec2), "string"), $spec2, ""),
          Bind($wants12,
            MatchesPattern(Regex("12|am|pm", "i"), $pattern),
            Bind($withSpoken,
              Lambda(List($head, $source, $spoken),
                CallOf(
                  $head,
                  Concat(
                    AsList(Filter(Arguments($source), Lambda(List($a), NotIdentical(FieldOf($a, "name"), "spoken")))),
                    List(Record(name = "spoken", value = $spoken))
                  )
                )
              ),
              Bind($named,
                Lambda(List($e, $n),
                  Bind($a2,
                    FirstSatisfying(Arguments($e), Lambda(List($x), Identical(FieldOf($x, "name"), $n))),
                    If(Truthy($a2), FieldOf($a2, "value"), Undefined())
                  )
                ),
                Bind($clock,
                  Lambda(List($h24, $minute),
                    Bind($mm,
                      PadStart(ToText($minute), 2, "0"),
                      If(
                        Truthy(If(Falsy($pattern), true, $wants12)),
                        Bind($h,
                          If(
                            Identical(RemainderOf($h24, 12), 0),
                            12,
                            RemainderOf($h24, 12)
                          ),
                          AddValues(AddValues(AddValues(AddValues($h, ":"), $mm), " "), If(Below($h24, 12), "AM", "PM"))
                        ),
                        AddValues(AddValues(PadStart(ToText($h24), 2, "0"), ":"), $mm)
                      )
                    )
                  ),
                  If(
                    Truthy(
                      Bind($t0,
                        $subject2,
                        If(Truthy($t0), Identical(Head($subject2), "Date"), $t0)
                      )
                    ),
                    Bind($y,
                      ToText(Call($named, $subject2, "year")),
                      Bind($m,
                        PadStart(ToText(Call($named, $subject2, "month")), 2, "0"),
                        Bind($d,
                          PadStart(ToText(Call($named, $subject2, "day")), 2, "0"),
                          Bind($spoken2,
                            Replace(
                              Replace(
                                Replace(
                                  Bind($t1, $pattern, If(Truthy($t1), $t1, "YYYY-MM-DD")),
                                  "YYYY",
                                  $y
                                ),
                                "MM",
                                $m
                              ),
                              "DD",
                              $d
                            ),
                            Call($withSpoken, "Date", $subject2, $spoken2)
                          )
                        )
                      )
                    ),
                    If(
                      Truthy(
                        Bind($t2,
                          $subject2,
                          If(Truthy($t2), Identical(Head($subject2), "Time"), $t2)
                        )
                      ),
                      Bind($h242,
                        ToNumber(Call($named, $subject2, "hour")),
                        Bind($minute2,
                          ToNumber(Call($named, $subject2, "minute")),
                          If(
                            Truthy(If(IsFiniteNumber($h242), IsFiniteNumber($minute2), false)),
                            Call(
                              $withSpoken,
                              "Time",
                              $subject2,
                              Call($clock, $h242, $minute2)
                            ),
                            If(
                              Truthy(
                                Bind($t3,
                                  $subject2,
                                  If(
                                    Truthy($t3),
                                    Identical(Head($subject2), "Timestamp"),
                                    $t3
                                  )
                                )
                              ),
                              Bind($raw,
                                If(
                                  Truthy(Element(Arguments($subject2), 0)),
                                  FieldOf(Element(Arguments($subject2), 0), "value"),
                                  Undefined()
                                ),
                                Bind($when,
                                  If(
                                    Identical(TypeOf($raw), "string"),
                                    InstantFrom($raw),
                                    CurrentInstant()
                                  ),
                                  If(
                                    IsNotANumber(MillisecondsOf($when)),
                                    MakeCall("Format", List($subject2, $spec2)),
                                    Bind($h243,
                                      HourOf($when),
                                      Bind($minute3,
                                        MinuteOf($when),
                                        CallOf(
                                          "Time",
                                          List(
                                            Record(name = "hour", value = $h243),
                                            Record(name = "minute", value = $minute3),
                                            Record(name = "spoken", value = Call($clock, $h243, $minute3))
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              ),
                              MakeCall("Format", List($subject2, $spec2))
                            )
                          )
                        )
                      ),
                      If(
                        Truthy(
                          Bind($t4,
                            $subject2,
                            If(
                              Truthy($t4),
                              Identical(Head($subject2), "Timestamp"),
                              $t4
                            )
                          )
                        ),
                        Bind($raw2,
                          If(
                            Truthy(Element(Arguments($subject2), 0)),
                            FieldOf(Element(Arguments($subject2), 0), "value"),
                            Undefined()
                          ),
                          Bind($when2,
                            If(
                              Identical(TypeOf($raw2), "string"),
                              InstantFrom($raw2),
                              CurrentInstant()
                            ),
                            If(
                              IsNotANumber(MillisecondsOf($when2)),
                              MakeCall("Format", List($subject2, $spec2)),
                              Bind($h244,
                                HourOf($when2),
                                Bind($minute4,
                                  MinuteOf($when2),
                                  CallOf(
                                    "Time",
                                    List(
                                      Record(name = "hour", value = $h244),
                                      Record(name = "minute", value = $minute4),
                                      Record(name = "spoken", value = Call($clock, $h244, $minute4))
                                    )
                                  )
                                )
                              )
                            )
                          )
                        ),
                        MakeCall("Format", List($subject2, $spec2))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

// ------------------------------------------------------------------ *
// Allen's interval algebra: how two stretches of time can stand to each other.
//
// Thirteen relations, and exactly thirteen. They are jointly exhaustive and pairwise
// disjoint -- any two intervals stand in one of these and never in two. That closure is
// why this calculus is still in use while most of qualitative reasoning is not
// (design/judgment-research.md Part 6): a closed, small, mutually exclusive family
// composes by table lookup, where an open-ended one accumulates cases that cannot be
// resolved.
//
// Seeded rather than taught, for the same reason arithmetic is. These have exact
// definitions, and a Teacher grounded in a web search would return the surname Allen, the
// English word "meets", and a definition of "during" that is merely usable. Where the
// meaning is exact, stating it is honest and learning it is not.
//
// Only Equals is an equivalence. Before, During, Starts and Finishes are transitive but
// asymmetric, so they order without collapsing -- and Meets and Overlaps are neither,
// which is what stops a chain of adjacent intervals from becoming one interval.
// ------------------------------------------------------------------
Concept(IntervalRelation(),
  IsA(Relation()),
  IsA(Category())
)

Concept(Interval(), IsA(TemporalEntity()))

Concept(TemporalEntity(), IsA(Category()))

// Ordering: transitive, so a chain settles, and asymmetric, so it never closes.
Concept(Before(),
  IsA(IntervalRelation()),
  InverseOf(After()),
  Transitive(),
  Asymmetric(),
  Irreflexive()
)

Concept(After(),
  IsA(IntervalRelation()),
  InverseOf(Before()),
  Transitive(),
  Asymmetric(),
  Irreflexive()
)

// Adjacency: A ends exactly where B starts. NOT transitive -- three intervals in a row
// do not make the first meet the third, and treating them as though they did is how a
// sequence of moments collapses into one.
Concept(Meets(),
  IsA(IntervalRelation()),
  InverseOf(MetBy()),
  Asymmetric(),
  Irreflexive()
)

Concept(MetBy(),
  IsA(IntervalRelation()),
  InverseOf(Meets()),
  Asymmetric(),
  Irreflexive()
)

// Partial overlap: also not transitive, for the same reason.
Concept(Overlaps(),
  IsA(IntervalRelation()),
  InverseOf(OverlappedBy()),
  Asymmetric(),
  Irreflexive()
)

Concept(OverlappedBy(),
  IsA(IntervalRelation()),
  InverseOf(Overlaps()),
  Asymmetric(),
  Irreflexive()
)

Concept(Starts(),
  IsA(IntervalRelation()),
  InverseOf(StartedBy()),
  Transitive(),
  Asymmetric(),
  Irreflexive()
)

Concept(StartedBy(),
  IsA(IntervalRelation()),
  InverseOf(Starts()),
  Transitive(),
  Asymmetric(),
  Irreflexive()
)

Concept(During(),
  IsA(IntervalRelation()),
  InverseOf(Contains()),
  Transitive(),
  Asymmetric(),
  Irreflexive()
)

Concept(Contains(),
  IsA(IntervalRelation()),
  InverseOf(During()),
  Transitive(),
  Asymmetric(),
  Irreflexive()
)

Concept(Finishes(),
  IsA(IntervalRelation()),
  InverseOf(FinishedBy()),
  Transitive(),
  Asymmetric(),
  Irreflexive()
)

Concept(FinishedBy(),
  IsA(IntervalRelation()),
  InverseOf(Finishes()),
  Transitive(),
  Asymmetric(),
  Irreflexive()
)

// The one equivalence in the family: same start, same end.
Concept(Equals(),
  IsA(IntervalRelation()),
  Symmetric(),
  Transitive(),
  InverseOf(Equals())
)

// ------------------------------------------------------------------ *
// Deixis and defaults. Today() is deictic: it reads the clock and takes no
// arguments. Date() is a default: a lower-arity realization delegating to Date(Today()).
// ------------------------------------------------------------------
Concept(CurrentTimestamp(),
  Realization(CurrentTimestamp(),
    properties = List(Effectful(), Program()),
    body = MakeCall("Timestamp", List(IsoText(CurrentInstant())))
  )
)

Concept(Timestamp(), IsA(Data()))

// The clock time, as opposed to the calendar date. Deictic, like Today.
// A clock time as said is a reading: Time(7, Am()), Time(7, 30, Pm()), Time(19, 0).
// It realizes to the named value record the clock Concepts compute with. The pattern
// variables are deliberately not named hour or minute: the matcher aligns an
// all-named call by name, so a value record can never be re-read as a reading.
Concept(Time(),
  IsA(Deictic()),
  Realization(Time(),
    context = Execution(),
    properties = List(Effectful(), Program()),
    body = Bind($now,
      CurrentInstant(),
      Bind($h24,
        HourOf($now),
        Bind($mm,
          PadStart(ToText(MinuteOf($now)), 2, "0"),
          Bind($h,
            If(
              Identical(RemainderOf($h24, 12), 0),
              12,
              RemainderOf($h24, 12)
            ),
            CallOf(
              "Time",
              List(
                Record(name = "hour", value = $h24),
                Record(name = "minute", value = MinuteOf($now)),
                Record(
                  name = "spoken",
                  value = AddValues(AddValues(AddValues(AddValues($h, ":"), $mm), " "), If(Below($h24, 12), "AM", "PM"))
                )
              )
            )
          )
        )
      )
    )
  ),
  Realization(Time($h, $b),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Program()),
    body = Bind($vals,
      Map(List(Argument(value = Quote($h)), Argument(value = Quote($b))), Lambda(List($a), FieldOf($a, "value"))),
      Bind($period,
        FirstSatisfying(
          $vals,
          Lambda(List($v),
            Bind($t0,
              $v,
              If(
                Truthy($t0),
                If(
                  Identical(Head($v), "Am"),
                  true,
                  Identical(Head($v), "Pm")
                ),
                $t0
              )
            )
          )
        ),
        Bind($nums,
          Filter($vals, Lambda(List($v2), Identical(TypeOf($v2), "number"))),
          If(
            Truthy(
              If(
                Falsy(Length($nums)),
                true,
                NotIdentical(AddValues(Length($nums), If(Truthy($period), 1, 0)), Length($vals))
              )
            ),
            MakeCall("Time", AsList($vals)),
            Bind($t1,
              $nums,
              Bind($h2,
                Element($t1, 0),
                Bind($m,
                  Bind($t2,
                    Element($t1, 1),
                    If(Identical($t2, Undefined()), 0, $t2)
                  ),
                  Bind($h24,
                    If(
                      Truthy($period),
                      AddValues(RemainderOf($h2, 12), If(Identical(Head($period), "Pm"), 12, 0)),
                      $h2
                    ),
                    Bind($h12,
                      If(
                        Identical(RemainderOf($h24, 12), 0),
                        12,
                        RemainderOf($h24, 12)
                      ),
                      CallOf(
                        "Time",
                        List(
                          Record(name = "hour", value = $h24),
                          Record(name = "minute", value = $m),
                          Record(
                            name = "spoken",
                            value = AddValues(
                              AddValues(AddValues(AddValues($h12, ":"), PadStart(ToText($m), 2, "0")), " "),
                              If(Below($h24, 12), "AM", "PM")
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ),
  Realization(Time($h, $b, $c),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Program()),
    body = Bind($vals,
      Map(
        List(
          Argument(value = Quote($h)),
          Argument(value = Quote($b)),
          Argument(value = Quote($c))
        ),
        Lambda(List($a), FieldOf($a, "value"))
      ),
      Bind($period,
        FirstSatisfying(
          $vals,
          Lambda(List($v),
            Bind($t0,
              $v,
              If(
                Truthy($t0),
                If(
                  Identical(Head($v), "Am"),
                  true,
                  Identical(Head($v), "Pm")
                ),
                $t0
              )
            )
          )
        ),
        Bind($nums,
          Filter($vals, Lambda(List($v2), Identical(TypeOf($v2), "number"))),
          If(
            Truthy(
              If(
                Falsy(Length($nums)),
                true,
                NotIdentical(AddValues(Length($nums), If(Truthy($period), 1, 0)), Length($vals))
              )
            ),
            MakeCall("Time", AsList($vals)),
            Bind($t1,
              $nums,
              Bind($h2,
                Element($t1, 0),
                Bind($m,
                  Bind($t2,
                    Element($t1, 1),
                    If(Identical($t2, Undefined()), 0, $t2)
                  ),
                  Bind($h24,
                    If(
                      Truthy($period),
                      AddValues(RemainderOf($h2, 12), If(Identical(Head($period), "Pm"), 12, 0)),
                      $h2
                    ),
                    Bind($h12,
                      If(
                        Identical(RemainderOf($h24, 12), 0),
                        12,
                        RemainderOf($h24, 12)
                      ),
                      CallOf(
                        "Time",
                        List(
                          Record(name = "hour", value = $h24),
                          Record(name = "minute", value = $m),
                          Record(
                            name = "spoken",
                            value = AddValues(
                              AddValues(AddValues(AddValues($h12, ":"), PadStart(ToText($m), 2, "0")), " "),
                              If(Below($h24, 12), "AM", "PM")
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(Am(), IsA(Data()))

Concept(Pm(), IsA(Data()))

Concept(Today(),
  IsA(Date()),
  Realization(Today(),
    context = Execution(),
    properties = List(Effectful(), Program()),
    body = Bind($now,
      CurrentInstant(),
      Bind($days,
        List(
          "Sunday",
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ),
        CallOf(
          "Date",
          List(
            Record(name = "year", value = YearOf($now)),
            Record(name = "month", value = AddValues(SubtractValues(MonthOf($now), 1), 1)),
            Record(name = "day", value = DayOf($now)),
            Record(name = "weekday", value = Element($days, WeekdayOf($now)))
          )
        )
      )
    )
  )
)

// The zero-argument form is a default: a lower-arity realization delegating to the
// fuller one. Defaults need no feature; patterns already match on exact arity.
Concept(Date(),
  Realization(Date(),
    context = Execution(),
    body = Date(Today())
  ),
  Realization(Date($when),
    context = Execution(),
    properties = List(Program()),
    body = $when
  )
)

// Date arithmetic, so a deictic that is computable actually computes.
//
// Learning taught Tomorrow what it IS — IsA(TemporalExpression()), InverseOf(Yesterday())
// — and left it inert, so "what will be the date tomorrow" got a definition instead of a
// date. Relations say what a thing is; they never say how to do it. Where the doing is
// expressible from Concepts that already exist, it should be seeded as a composition.
Concept(ShiftDays(),
  Realization(ShiftDays($date, $days),
    context = Execution(),
    properties = List(Program()),
    body = Bind($date2,
      $date,
      Bind($days2,
        $days,
        If(
          Truthy(
            Bind($t0,
              If(Falsy($date2), true, NotIdentical(Head($date2), "Date")),
              If(Truthy($t0), $t0, NotIdentical(TypeOf($days2), "number"))
            )
          ),
          MakeCall("ShiftDays", List($date2, $days2)),
          Bind($get,
            Lambda(List($n),
              Bind($a,
                FirstSatisfying(Arguments($date2), Lambda(List($x), Identical(FieldOf($x, "name"), $n))),
                If(Truthy($a), FieldOf($a, "value"), Undefined())
              )
            ),
            Bind($d,
              LocalInstant(
                ToNumber(Call($get, "year")),
                AddValues(SubtractValues(ToNumber(Call($get, "month")), 1), 1),
                AddValues(ToNumber(Call($get, "day")), $days2)
              ),
              Bind($names,
                List(
                  "Sunday",
                  "Monday",
                  "Tuesday",
                  "Wednesday",
                  "Thursday",
                  "Friday",
                  "Saturday"
                ),
                CallOf(
                  "Date",
                  List(
                    Record(name = "year", value = YearOf($d)),
                    Record(name = "month", value = AddValues(SubtractValues(MonthOf($d), 1), 1)),
                    Record(name = "day", value = DayOf($d)),
                    Record(name = "weekday", value = Element($names, WeekdayOf($d)))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(DayAfter(),
  InverseOf(DayBefore()),
  Realization(DayAfter($date),
    context = Execution(),
    body = ShiftDays($date, 1)
  )
)

Concept(DayBefore(),
  InverseOf(DayAfter()),
  Realization(DayBefore($date),
    context = Execution(),
    body = ShiftDays($date, -1)
  )
)

Concept(Tomorrow(),
  IsA(Date()),
  IsA(Deictic()),
  InverseOf(Yesterday()),
  Realization(Tomorrow(),
    context = Execution(),
    body = DayAfter(Today())
  )
)

Concept(Yesterday(),
  IsA(Date()),
  IsA(Deictic()),
  InverseOf(Tomorrow()),
  Realization(Yesterday(),
    context = Execution(),
    body = DayBefore(Today())
  )
)

// Clock arithmetic, the counterpart of ShiftDays. Without it "add 5 hours to it" had no
// Concept to reach for, so the parser reached for Add, which is numeric, and the whole
// expression went residual on a time that is not a number.
Concept(ShiftHours(),
  Realization(ShiftHours($time, $hours),
    context = Execution(),
    properties = List(Program()),
    body = Bind($time2,
      $time,
      Bind($raw,
        $hours,
        Bind($hours2,
          If(
            Identical(TypeOf($raw), "number"),
            $raw,
            If(
              Truthy(
                Bind($t1,
                  Bind($t0,
                    $raw,
                    If(Truthy($t0), Identical(Head($raw), "Number"), $t0)
                  ),
                  If(
                    Truthy($t1),
                    Identical(TypeOf(FieldOf(Element(Arguments($raw), 0), "value")), "number"),
                    $t1
                  )
                )
              ),
              FieldOf(Element(Arguments($raw), 0), "value"),
              NotANumber()
            )
          ),
          If(
            Truthy(
              Bind($t2,
                If(Falsy($time2), true, NotIdentical(Head($time2), "Time")),
                If(Truthy($t2), $t2, Falsy(IsFiniteNumber($hours2)))
              )
            ),
            MakeCall("ShiftHours", List($time2, $hours)),
            Bind($named,
              Lambda(List($n),
                Bind($a,
                  FirstSatisfying(Arguments($time2), Lambda(List($x), Identical(FieldOf($x, "name"), $n))),
                  If(Truthy($a), FieldOf($a, "value"), Undefined())
                )
              ),
              Bind($h0,
                ToNumber(Call($named, "hour")),
                Bind($m0,
                  ToNumber(Call($named, "minute")),
                  If(
                    Truthy(
                      If(
                        Falsy(IsFiniteNumber($h0)),
                        true,
                        Falsy(IsFiniteNumber($m0))
                      )
                    ),
                    MakeCall("ShiftHours", List($time2, $hours)),
                    Bind($total,
                      RemainderOf(AddValues(RemainderOf(AddValues($h0, $hours2), 24), 24), 24),
                      Bind($mm,
                        PadStart(ToText($m0), 2, "0"),
                        Bind($h12,
                          If(
                            Identical(RemainderOf($total, 12), 0),
                            12,
                            RemainderOf($total, 12)
                          ),
                          CallOf(
                            "Time",
                            List(
                              Record(name = "hour", value = $total),
                              Record(name = "minute", value = $m0),
                              Record(
                                name = "spoken",
                                value = AddValues(
                                  AddValues(AddValues(AddValues($h12, ":"), $mm), " "),
                                  If(Below($total, 12), "AM", "PM")
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(HourAfter(),
  InverseOf(HourBefore()),
  Realization(HourAfter($time),
    context = Execution(),
    body = ShiftHours($time, 1)
  )
)

Concept(HourBefore(),
  InverseOf(HourAfter()),
  Realization(HourBefore($time),
    context = Execution(),
    body = ShiftHours($time, -1)
  )
)

Concept(Now(),
  SynonymOf(CurrentTimestamp()),
  IsA(Deictic())
)

Concept(Me(), IsA(Deictic()))

Concept(You(), IsA(Deictic()))

// Whose: the one speaking, or the one spoken to.
Concept(My(), IsA(Deictic()))

Concept(Your(), IsA(Deictic()))

// ------------------------------------------------------------------ *
// A little arithmetic, so the first end-to-end turn computes something real.
// ------------------------------------------------------------------
Concept(Multiply(),
  Realization(Multiply($left, $right),
    context = Execution(),
    properties = List(Program()),
    body = Bind($asNumber,
      Recursive(
        $asNumber,
        Lambda(List($x),
          If(
            Identical(TypeOf($x), "number"),
            $x,
            If(
              Truthy(
                Bind($t0,
                  $x,
                  If(Truthy($t0), Identical(Head($x), "Number"), $t0)
                )
              ),
              Call($asNumber, FieldOf(Element(Arguments($x), 0), "value")),
              NotANumber()
            )
          )
        )
      ),
      Bind($l,
        Call($asNumber, $left),
        Bind($r,
          Call($asNumber, $right),
          If(
            Truthy(If(IsNotANumber($l), true, IsNotANumber($r))),
            MakeCall("Multiply", List($left, $right)),
            MultiplyValues($l, $r)
          )
        )
      )
    )
  )
)

Concept(Add(),
  Realization(Add($left, $right),
    context = Execution(),
    properties = List(Program()),
    body = Bind($asNumber,
      Recursive(
        $asNumber,
        Lambda(List($x),
          If(
            Identical(TypeOf($x), "number"),
            $x,
            If(
              Truthy(
                Bind($t0,
                  $x,
                  If(Truthy($t0), Identical(Head($x), "Number"), $t0)
                )
              ),
              Call($asNumber, FieldOf(Element(Arguments($x), 0), "value")),
              NotANumber()
            )
          )
        )
      ),
      Bind($l,
        Call($asNumber, $left),
        Bind($r,
          Call($asNumber, $right),
          If(
            Truthy(If(IsNotANumber($l), true, IsNotANumber($r))),
            MakeCall("Add", List($left, $right)),
            AddValues($l, $r)
          )
        )
      )
    )
  ),
  Realization(Add($a, $b),
    context = Execution(),
    properties = List(Program()),
    body = Bind($field,
      Lambda(List($r, $n),
        Bind($a2,
          FirstSatisfying(Arguments($r), Lambda(List($x), Identical(FieldOf($x, "name"), $n))),
          If(Truthy($a2), FieldOf($a2, "value"), Undefined())
        )
      ),
      Bind($DAY,
        List(
          "Sunday",
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ),
        Bind($units,
          Record(
            Days = List(1, "day"),
            Weeks = List(7, "day"),
            Hours = List(60, "minute"),
            Minutes = List(1, "minute")
          ),
          Bind($isDuration,
            Lambda(List($v),
              Bind($t2,
                Bind($t1,
                  Bind($t0,
                    $v,
                    If(Truthy($t0), Element($units, Head($v)), $t0)
                  ),
                  If(Truthy($t1), Identical(Length(Arguments($v)), 1), $t1)
                ),
                If(
                  Truthy($t2),
                  Identical(TypeOf(FieldOf(Element(Arguments($v), 0), "value")), "number"),
                  $t2
                )
              )
            ),
            Bind($isRecord,
              Lambda(List($v2),
                Bind($t4,
                  Bind($t3,
                    $v2,
                    If(
                      Truthy($t3),
                      If(
                        Identical(Head($v2), "Date"),
                        true,
                        Identical(Head($v2), "Time")
                      ),
                      $t3
                    )
                  ),
                  If(
                    Truthy($t4),
                    AllSatisfy(Arguments($v2), Lambda(List($a3), NotIdentical(FieldOf($a3, "name"), Undefined()))),
                    $t4
                  )
                )
              ),
              Bind($clock,
                Lambda(List($t),
                  Bind($h24,
                    RoundDown(DivideValues($t, 60)),
                    Bind($mm,
                      RemainderOf($t, 60),
                      Bind($h12,
                        If(
                          Identical(RemainderOf($h24, 12), 0),
                          12,
                          RemainderOf($h24, 12)
                        ),
                        CallOf(
                          "Time",
                          List(
                            Record(name = "hour", value = $h24),
                            Record(name = "minute", value = $mm),
                            Record(
                              name = "spoken",
                              value = AddValues(
                                AddValues(AddValues(AddValues($h12, ":"), PadStart(ToText($mm), 2, "0")), " "),
                                If(Below($h24, 12), "AM", "PM")
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                ),
                Bind($date,
                  Lambda(List($d, $time),
                    CallOf(
                      "Date",
                      Concat(
                        List(
                          Record(name = "year", value = YearOf($d)),
                          Record(name = "month", value = AddValues(SubtractValues(MonthOf($d), 1), 1)),
                          Record(name = "day", value = DayOf($d)),
                          Record(name = "weekday", value = Element($DAY, WeekdayOf($d)))
                        ),
                        AsList(
                          If(
                            Truthy($time),
                            List(Record(name = "time", value = $time)),
                            List()
                          )
                        )
                      )
                    )
                  ),
                  Bind($minutesOf,
                    Lambda(List($t5),
                      AddValues(
                        MultiplyValues(ToNumber(Call($field, $t5, "hour")), 60),
                        ToNumber(Call($field, $t5, "minute"))
                      )
                    ),
                    Bind($shift,
                      Lambda(List($record, $duration, $sign),
                        Bind($t6,
                          Element($units, Head($duration)),
                          Bind($per,
                            Element($t6, 0),
                            Bind($kind,
                              Element($t6, 1),
                              Bind($n2,
                                MultiplyValues(
                                  MultiplyValues(FieldOf(Element(Arguments($duration), 0), "value"), $per),
                                  $sign
                                ),
                                If(
                                  Identical(Head($record), "Date"),
                                  Bind($time2,
                                    Call($field, $record, "time"),
                                    Bind($total,
                                      If(Identical($kind, "day"), MultiplyValues($n2, 1440), $n2),
                                      If(
                                        Truthy(If(NotIdentical($kind, "day"), Falsy($time2), false)),
                                        Undefined(),
                                        Bind($t7,
                                          AddValues(If(Truthy($time2), Call($minutesOf, $time2), 0), $total),
                                          Bind($carry,
                                            RoundDown(DivideValues($t7, 1440)),
                                            Bind($rest,
                                              RemainderOf(AddValues(RemainderOf($t7, 1440), 1440), 1440),
                                              Bind($d2,
                                                LocalInstant(
                                                  ToNumber(Call($field, $record, "year")),
                                                  AddValues(
                                                    SubtractValues(ToNumber(Call($field, $record, "month")), 1),
                                                    1
                                                  ),
                                                  AddValues(ToNumber(Call($field, $record, "day")), $carry)
                                                ),
                                                Call(
                                                  $date,
                                                  $d2,
                                                  If(Truthy($time2), Call($clock, $rest), Undefined())
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  ),
                                  Bind($total2,
                                    If(Identical($kind, "day"), MultiplyValues($n2, 1440), $n2),
                                    Call(
                                      $clock,
                                      RemainderOf(
                                        AddValues(
                                          RemainderOf(AddValues(Call($minutesOf, $record), $total2), 1440),
                                          1440
                                        ),
                                        1440
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      ),
                      Bind($now,
                        Lambda(List($duration2),
                          Evaluate(
                            MakeCall(
                              If(
                                Identical(Element(Element($units, Head($duration2)), 1), "day"),
                                "Today",
                                "Time"
                              ),
                              List()
                            )
                          )
                        ),
                        Bind($t8,
                          Map(
                            List(Argument(value = $a), Argument(value = $b)),
                            Lambda(List($x2), FieldOf($x2, "value"))
                          ),
                          Bind($a4,
                            Element($t8, 0),
                            Bind($b2,
                              Element($t8, 1),
                              If(
                                Truthy(
                                  If(
                                    Identical(TypeOf($a4), "number"),
                                    Identical(TypeOf($b2), "number"),
                                    false
                                  )
                                ),
                                AddValues($a4, MultiplyValues(1, $b2)),
                                If(
                                  Truthy(
                                    Bind($t9,
                                      Call($isRecord, $a4),
                                      If(Truthy($t9), Call($isDuration, $b2), $t9)
                                    )
                                  ),
                                  Bind($t10,
                                    Call($shift, $a4, $b2, 1),
                                    If(IsNothing($t10), MakeCall("Add", List($a4, $b2)), $t10)
                                  ),
                                  If(
                                    Truthy(
                                      Bind($t11,
                                        If(Identical(1, 1), Call($isDuration, $a4), false),
                                        If(Truthy($t11), Call($isRecord, $b2), $t11)
                                      )
                                    ),
                                    Bind($t12,
                                      Call($shift, $b2, $a4, 1),
                                      If(IsNothing($t12), MakeCall("Add", List($a4, $b2)), $t12)
                                    ),
                                    MakeCall("Add", List($a4, $b2))
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(Subtract(),
  Realization(Subtract($left, $right),
    context = Execution(),
    properties = List(Program()),
    body = Bind($asNumber,
      Recursive(
        $asNumber,
        Lambda(List($x),
          If(
            Identical(TypeOf($x), "number"),
            $x,
            If(
              Truthy(
                Bind($t0,
                  $x,
                  If(Truthy($t0), Identical(Head($x), "Number"), $t0)
                )
              ),
              Call($asNumber, FieldOf(Element(Arguments($x), 0), "value")),
              NotANumber()
            )
          )
        )
      ),
      Bind($l,
        Call($asNumber, $left),
        Bind($r,
          Call($asNumber, $right),
          If(
            Truthy(If(IsNotANumber($l), true, IsNotANumber($r))),
            MakeCall("Subtract", List($left, $right)),
            SubtractValues($l, $r)
          )
        )
      )
    )
  ),
  Realization(Subtract($a, $b),
    context = Execution(),
    properties = List(Program()),
    body = Bind($field,
      Lambda(List($r, $n),
        Bind($a2,
          FirstSatisfying(Arguments($r), Lambda(List($x), Identical(FieldOf($x, "name"), $n))),
          If(Truthy($a2), FieldOf($a2, "value"), Undefined())
        )
      ),
      Bind($DAY,
        List(
          "Sunday",
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ),
        Bind($units,
          Record(
            Days = List(1, "day"),
            Weeks = List(7, "day"),
            Hours = List(60, "minute"),
            Minutes = List(1, "minute")
          ),
          Bind($isDuration,
            Lambda(List($v),
              Bind($t2,
                Bind($t1,
                  Bind($t0,
                    $v,
                    If(Truthy($t0), Element($units, Head($v)), $t0)
                  ),
                  If(Truthy($t1), Identical(Length(Arguments($v)), 1), $t1)
                ),
                If(
                  Truthy($t2),
                  Identical(TypeOf(FieldOf(Element(Arguments($v), 0), "value")), "number"),
                  $t2
                )
              )
            ),
            Bind($isRecord,
              Lambda(List($v2),
                Bind($t4,
                  Bind($t3,
                    $v2,
                    If(
                      Truthy($t3),
                      If(
                        Identical(Head($v2), "Date"),
                        true,
                        Identical(Head($v2), "Time")
                      ),
                      $t3
                    )
                  ),
                  If(
                    Truthy($t4),
                    AllSatisfy(Arguments($v2), Lambda(List($a3), NotIdentical(FieldOf($a3, "name"), Undefined()))),
                    $t4
                  )
                )
              ),
              Bind($clock,
                Lambda(List($t),
                  Bind($h24,
                    RoundDown(DivideValues($t, 60)),
                    Bind($mm,
                      RemainderOf($t, 60),
                      Bind($h12,
                        If(
                          Identical(RemainderOf($h24, 12), 0),
                          12,
                          RemainderOf($h24, 12)
                        ),
                        CallOf(
                          "Time",
                          List(
                            Record(name = "hour", value = $h24),
                            Record(name = "minute", value = $mm),
                            Record(
                              name = "spoken",
                              value = AddValues(
                                AddValues(AddValues(AddValues($h12, ":"), PadStart(ToText($mm), 2, "0")), " "),
                                If(Below($h24, 12), "AM", "PM")
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                ),
                Bind($date,
                  Lambda(List($d, $time),
                    CallOf(
                      "Date",
                      Concat(
                        List(
                          Record(name = "year", value = YearOf($d)),
                          Record(name = "month", value = AddValues(SubtractValues(MonthOf($d), 1), 1)),
                          Record(name = "day", value = DayOf($d)),
                          Record(name = "weekday", value = Element($DAY, WeekdayOf($d)))
                        ),
                        AsList(
                          If(
                            Truthy($time),
                            List(Record(name = "time", value = $time)),
                            List()
                          )
                        )
                      )
                    )
                  ),
                  Bind($minutesOf,
                    Lambda(List($t5),
                      AddValues(
                        MultiplyValues(ToNumber(Call($field, $t5, "hour")), 60),
                        ToNumber(Call($field, $t5, "minute"))
                      )
                    ),
                    Bind($shift,
                      Lambda(List($record, $duration, $sign),
                        Bind($t6,
                          Element($units, Head($duration)),
                          Bind($per,
                            Element($t6, 0),
                            Bind($kind,
                              Element($t6, 1),
                              Bind($n2,
                                MultiplyValues(
                                  MultiplyValues(FieldOf(Element(Arguments($duration), 0), "value"), $per),
                                  $sign
                                ),
                                If(
                                  Identical(Head($record), "Date"),
                                  Bind($time2,
                                    Call($field, $record, "time"),
                                    Bind($total,
                                      If(Identical($kind, "day"), MultiplyValues($n2, 1440), $n2),
                                      If(
                                        Truthy(If(NotIdentical($kind, "day"), Falsy($time2), false)),
                                        Undefined(),
                                        Bind($t7,
                                          AddValues(If(Truthy($time2), Call($minutesOf, $time2), 0), $total),
                                          Bind($carry,
                                            RoundDown(DivideValues($t7, 1440)),
                                            Bind($rest,
                                              RemainderOf(AddValues(RemainderOf($t7, 1440), 1440), 1440),
                                              Bind($d2,
                                                LocalInstant(
                                                  ToNumber(Call($field, $record, "year")),
                                                  AddValues(
                                                    SubtractValues(ToNumber(Call($field, $record, "month")), 1),
                                                    1
                                                  ),
                                                  AddValues(ToNumber(Call($field, $record, "day")), $carry)
                                                ),
                                                Call(
                                                  $date,
                                                  $d2,
                                                  If(Truthy($time2), Call($clock, $rest), Undefined())
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  ),
                                  Bind($total2,
                                    If(Identical($kind, "day"), MultiplyValues($n2, 1440), $n2),
                                    Call(
                                      $clock,
                                      RemainderOf(
                                        AddValues(
                                          RemainderOf(AddValues(Call($minutesOf, $record), $total2), 1440),
                                          1440
                                        ),
                                        1440
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      ),
                      Bind($now,
                        Lambda(List($duration2),
                          Evaluate(
                            MakeCall(
                              If(
                                Identical(Element(Element($units, Head($duration2)), 1), "day"),
                                "Today",
                                "Time"
                              ),
                              List()
                            )
                          )
                        ),
                        Bind($t8,
                          Map(
                            List(Argument(value = $a), Argument(value = $b)),
                            Lambda(List($x2), FieldOf($x2, "value"))
                          ),
                          Bind($a4,
                            Element($t8, 0),
                            Bind($b2,
                              Element($t8, 1),
                              If(
                                Truthy(
                                  If(
                                    Identical(TypeOf($a4), "number"),
                                    Identical(TypeOf($b2), "number"),
                                    false
                                  )
                                ),
                                AddValues($a4, MultiplyValues(NegateValue(1), $b2)),
                                If(
                                  Truthy(
                                    Bind($t9,
                                      Call($isRecord, $a4),
                                      If(Truthy($t9), Call($isDuration, $b2), $t9)
                                    )
                                  ),
                                  Bind($t10,
                                    Call($shift, $a4, $b2, NegateValue(1)),
                                    If(
                                      IsNothing($t10),
                                      MakeCall("Subtract", List($a4, $b2)),
                                      $t10
                                    )
                                  ),
                                  If(
                                    Truthy(
                                      Bind($t11,
                                        If(
                                          Identical(NegateValue(1), 1),
                                          Call($isDuration, $a4),
                                          false
                                        ),
                                        If(Truthy($t11), Call($isRecord, $b2), $t11)
                                      )
                                    ),
                                    Bind($t12,
                                      Call($shift, $b2, $a4, 1),
                                      If(
                                        IsNothing($t12),
                                        MakeCall("Subtract", List($a4, $b2)),
                                        $t12
                                      )
                                    ),
                                    MakeCall("Subtract", List($a4, $b2))
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(GreaterThan(),
  Realization(GreaterThan($left, $right),
    context = Execution(),
    properties = List(Program()),
    body = Bind($asNumber,
      Recursive(
        $asNumber,
        Lambda(List($x),
          If(
            Identical(TypeOf($x), "number"),
            $x,
            If(
              Truthy(
                Bind($t0,
                  $x,
                  If(Truthy($t0), Identical(Head($x), "Number"), $t0)
                )
              ),
              Call($asNumber, FieldOf(Element(Arguments($x), 0), "value")),
              NotANumber()
            )
          )
        )
      ),
      Bind($l,
        Call($asNumber, $left),
        Bind($r,
          Call($asNumber, $right),
          If(
            Truthy(If(IsNotANumber($l), true, IsNotANumber($r))),
            MakeCall("GreaterThan", List($left, $right)),
            If(
              Above($l, $r),
              CallOf("True", List()),
              CallOf("False", List())
            )
          )
        )
      )
    )
  )
)

