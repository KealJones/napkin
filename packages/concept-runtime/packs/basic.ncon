// "the square root of 144", "15% of 80": said with "of", so the pattern keeps it. A
// negative has no real square root, which is the answer, as division by zero is.
Concept(SquareRoot(),
  Realization(SquareRoot($x),
    context = Execution(),
    properties = List(Program()),
    body = Bind($asNumber,
      Recursive(
        $asNumber,
        Lambda(List($v),
          If(
            Identical(TypeOf($v), "number"),
            $v,
            If(
              Truthy(
                Bind($t0,
                  $v,
                  If(Truthy($t0), Identical(Head($v), "Number"), $t0)
                )
              ),
              Call($asNumber, FieldOf(Element(Arguments($v), 0), "value")),
              If(
                Truthy(
                  Bind($t1,
                    $v,
                    If(Truthy($t1), Identical(Head($v), "Of"), $t1)
                  )
                ),
                Call($asNumber, FieldOf(Element(Arguments($v), 0), "value")),
                NotANumber()
              )
            )
          )
        )
      ),
      Bind($x2,
        Call(
          $asNumber,
          FieldOf(Element(List(Argument(value = $x)), SubtractValues(Length(List(Argument(value = $x))), 1)), "value")
        ),
        Bind($p,
          0,
          If(
            Truthy(If(IsNotANumber($x2), true, IsNotANumber($p))),
            MakeCall("SquareRoot", AsList(Map(List(Argument(value = $x)), Lambda(List($a), FieldOf($a, "value"))))),
            If(
              Below($x2, 0),
              MakeCall("Undefined", List()),
              SquareRootOf($x2)
            )
          )
        )
      )
    )
  ),
  Realization(SquareRoot(Of($x)),
    context = Execution(),
    properties = List(Program()),
    body = Bind($asNumber,
      Recursive(
        $asNumber,
        Lambda(List($v),
          If(
            Identical(TypeOf($v), "number"),
            $v,
            If(
              Truthy(
                Bind($t0,
                  $v,
                  If(Truthy($t0), Identical(Head($v), "Number"), $t0)
                )
              ),
              Call($asNumber, FieldOf(Element(Arguments($v), 0), "value")),
              If(
                Truthy(
                  Bind($t1,
                    $v,
                    If(Truthy($t1), Identical(Head($v), "Of"), $t1)
                  )
                ),
                Call($asNumber, FieldOf(Element(Arguments($v), 0), "value")),
                NotANumber()
              )
            )
          )
        )
      ),
      Bind($x2,
        Call(
          $asNumber,
          FieldOf(
            Element(
              List(Argument(value = Quote(Of($x)))),
              SubtractValues(Length(List(Argument(value = Quote(Of($x))))), 1)
            ),
            "value"
          )
        ),
        Bind($p,
          0,
          If(
            Truthy(If(IsNotANumber($x2), true, IsNotANumber($p))),
            MakeCall(
              "SquareRoot",
              AsList(Map(List(Argument(value = Quote(Of($x)))), Lambda(List($a), FieldOf($a, "value"))))
            ),
            If(
              Below($x2, 0),
              MakeCall("Undefined", List()),
              SquareRootOf($x2)
            )
          )
        )
      )
    )
  )
)

