// The kernel: every Concept the host code names directly (the evaluator, selection, the
// compiler, the store and the turn). Everything else is an ordinary pack and optional;
// this one is what the host cannot run without. A test keeps it that way
// (code/ncon.test.ts).
//
// A Concept can have more to it in other packs: this holds what it is, and memory.ncon or
// code.ncon may add realizations of their own.

// ------------------------------------------------------------------ *
// Relation vocabulary. Pure data; the harness never reads these.
// ------------------------------------------------------------------
Concept(IsA(), Transitive())

Concept(InverseOf(), Symmetric(), Incidental())

Concept(Disjoint(), Symmetric(), Irreflexive())

// Classified, not bare. A Concept with no relations and no realizations is
// indistinguishable from an orphan, and Exist would keep trying to "fix" it. Saying what
// kind of thing it is costs one relation and makes the graph self-describing.
Concept(Category(), IsA(Category()))

Concept(RelationProperty(), IsA(Category()))

Concept(Symmetric(), IsA(RelationProperty()), Incidental())

Concept(Asymmetric(), IsA(RelationProperty()))

Concept(Transitive(), IsA(RelationProperty()), Incidental())

Concept(Irreflexive(), IsA(RelationProperty()))

Concept(Functional(), IsA(RelationProperty()))

// ------------------------------------------------------------------ *
// Realization properties, read generically through Suppresses.
// ------------------------------------------------------------------
Concept(RealizationProperty(), IsA(Category()))

// ------------------------------------------------------------------ *
// Context facets.
// ------------------------------------------------------------------
Concept(ContextFacet(), IsA(Category()))

// A facet holding Exclusive() admits only realizations declared for it: under Hearing(), a
// word hears and nothing it does elsewhere runs (runtime/context.ts, exclusiveFacets).
Concept(Exclusive(), IsA(Category()))

// A facet holding Quiet() keeps its workings out of the trace: steps under it run and count but
// are not traced, unless the runtime is asked to (traceQuiet, napkin --trace-quiet).
Concept(Quiet(), IsA(Category()))

// Recalling what a word was said to be, to work a question out with it: nothing recalls again
// while it is on (core Mood).
Concept(Recalling(), IsA(ContextFacet()))

// Reading what was said as the graph names it: folds realize here and nothing else runs, so
// reading a phrase finds the Concept it spells, or leaves the phrase as said.
Concept(Reading(), IsA(ContextFacet()))

// Code(<language>): what is heard or read is code in that language, and nothing a word does
// elsewhere runs (packs/code-hearing.ncon).
Concept(Code(), IsA(ContextFacet()), Exclusive())

Concept(JavaScript(), IsA(TargetLanguage()))

Concept(SupersetOf(), Transitive(), Asymmetric())

// ------------------------------------------------------------------ *
// The universal parent, and the relations fallback.
//
// Presenting a Concept's relations is what answers "what is chess" for anything with
// relations but no composition. It is deliberately NOT a catch-all realization on
// `$subject`: a catch-all under a Describe context would match every sub-expression, so
// nothing would ever be residual and the expansion in concept-spec Part 4.0 would stop
// working — describing a composed body would swallow the body instead of expanding it.
//
// So it is invoked explicitly, by name, on a subject that came back residual.
// ------------------------------------------------------------------
// `Concept()` with no arguments is the universal parent; `Concept(identity=..., ...)` is
// the declaration form the runtime saves. They are distinguished by arity, which patterns
// already do.
// Lower-arity declarations, delegating to the full form -- the same idiom Date() uses.
//
// A Teacher that runs out of tokens mid-list leaves a declaration salvaged back to its
// last complete argument, which is often `identity` and `relations` with `realizations`
// lost off the end. Requiring all three made that a residual, so everything it HAD managed
// to say was discarded over a field it never got to.
Concept(Concept(),
  Realization(Concept(identity = $identity, relations = $relations, realizations = $realizations),
    evaluateArguments = false,
    properties = List(Effectful()),
    body = Code(
      ir = Lambda(List($args, $bindings, $api),
        Sequence(
          Bind($get,
            Lambda(List($n),
              Sequence(
                Bind($a, Call(Member($args, "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                Return(If($a, Member($a, "value"), Undefined()))
              )
            )
          ),
          Bind($identity, Call($get, "identity")),
          If(
            Or(NotEquals(TypeOf($identity), "string"), Not(Call(Member(Regex("^[A-Z]", ""), "test"), $identity))),
            Return(
              Call(
                Member($api, "call"),
                "InvalidDeclaration",
                If(
                  Equals($identity, Undefined()),
                  Call(Member($api, "call"), "Missing"),
                  $identity
                )
              )
            ),
            Undefined()
          ),
          Bind($items,
            Lambda(List($x),
              If(
                And($x, Equals(Member($x, "head"), "List")),
                Map(Member($x, "args"), Lambda(List($a), Member($a, "value"))),
                If($x, List($x), List())
              )
            )
          ),
          Bind($RELATION_CAP, 12),
          Call(
            Member(Member($api, "store"), "seed"),
            Object(
              identity = $identity,
              relations = List(),
              realizations = List()
            )
          ),
          Bind($asked, List()),
          ForOf(
            $r,
            Call($items, Call($get, "relations")),
            If(
              Not(
                Call(
                  Member($asked, "some"),
                  Lambda(List($x), Equals(Call(Member($api, "format"), $x), Call(Member($api, "format"), $r)))
                )
              ),
              Call(Member($asked, "push"), $r),
              Undefined()
            )
          ),
          Bind($relations, Call(Member($asked, "slice"), 0, $RELATION_CAP)),
          Bind($sharesNames,
            Lambda(List($head),
              Call(
                Member(Call(Member(Member($api, "store"), "asObject"), $head), "some"),
                Lambda(List($t),
                  And(Equals(Member($t, "subject"), "Namesake"), Equals(Member($t, "predicate"), "Covers"))
                )
              )
            )
          ),
          Bind($NAMESAKE, Object(has = $sharesNames)),
          Bind($isA,
            Lambda(List($r),
              And(
                And(
                  And(And($r, Equals(Member($r, "head"), "IsA")), Index(Member($r, "args"), 0)),
                  Member(Index(Member($r, "args"), 0), "value")
                ),
                Member(Member(Index(Member($r, "args"), 0), "value"), "head")
              )
            )
          ),
          Bind($hasOther,
            Call(
              Member($relations, "some"),
              Lambda(List($r),
                And(
                  Call($isA, $r),
                  Not(Call(Member($NAMESAKE, "has"), Member(Member(Index(Member($r, "args"), 0), "value"), "head")))
                )
              )
            )
          ),
          ForOf(
            $r,
            $relations,
            Sequence(
              If(
                Or(Not($r), Not(Member($r, "head"))),
                Continue(),
                Undefined()
              ),
              Bind($contextual, And(Equals(Member($r, "head"), "In"), Equals(Length(Member($r, "args")), 2))),
              Bind($claim,
                If(
                  $contextual,
                  Member(Index(Member($r, "args"), 0), "value"),
                  $r
                )
              ),
              Bind($namesake,
                And(
                  And(And(Not($contextual), $hasOther), Call($isA, $r)),
                  Call(Member($NAMESAKE, "has"), Member(Member(Index(Member($r, "args"), 0), "value"), "head"))
                )
              ),
              If(
                And(
                  And(
                    And(
                      And(And($contextual, $claim), Equals(Member($claim, "head"), "IsA")),
                      Index(Member($claim, "args"), 0)
                    ),
                    Member(Index(Member($r, "args"), 1), "value")
                  ),
                  Equals(
                    Call(Member($api, "format"), Member(Index(Member($claim, "args"), 0), "value")),
                    Call(Member($api, "format"), Member(Index(Member($r, "args"), 1), "value"))
                  )
                ),
                Continue(),
                Undefined()
              ),
              Bind($where,
                If(
                  $contextual,
                  Member(Index(Member($r, "args"), 1), "value"),
                  If(
                    $namesake,
                    Call(Member($api, "call"), "Namesake"),
                    Undefined()
                  )
                )
              ),
              If(
                Or(Or(Not($claim), Not(Member($claim, "head"))), Equals(Member($claim, "head"), $identity)),
                Continue(),
                Undefined()
              ),
              Call(
                Member(Member($api, "store"), "addRelation"),
                $identity,
                $claim,
                $where,
                Member(Member($api, "trace"), "cause")
              )
            )
          ),
          Var($added, 0),
          Bind($rejected, List()),
          ForOf(
            $decl,
            Call($items, Call($get, "realizations")),
            Sequence(
              If(
                Or(Not($decl), NotEquals(Member($decl, "head"), "Realization")),
                Continue(),
                Undefined()
              ),
              Bind($field,
                Lambda(List($n),
                  Sequence(
                    Bind($a,
                      Call(Member(Member($decl, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))
                    ),
                    Return(If($a, Member($a, "value"), Undefined()))
                  )
                )
              ),
              Bind($pattern, Call($field, "pattern")),
              Bind($body, Call($field, "body")),
              Bind($context, Call($field, "context")),
              If(
                Or(Not($pattern), Not($body)),
                Sequence(Call(Member($rejected, "push"), Call(Member($api, "call"), "Incomplete")), Continue()),
                Undefined()
              ),
              If(
                Equals(Member($body, "head"), "Code"),
                Sequence(Call(Member($rejected, "push"), Call(Member($api, "call"), "NotComposed", $body)), Continue()),
                Undefined()
              ),
              Bind($namesIn,
                Lambda(List($e, $acc),
                  Sequence(
                    If(
                      Or(Not($e), Not(Member($e, "head"))),
                      Return($acc),
                      Undefined()
                    ),
                    Call(Member($acc, "add"), Member($e, "head")),
                    ForOf(
                      $a,
                      Member($e, "args"),
                      Call($namesIn, Member($a, "value"), $acc)
                    ),
                    Return($acc)
                  )
                )
              ),
              Bind($reachesSelf,
                Lambda(List(),
                  Sequence(
                    Bind($seen, New($Set)),
                    Bind($queue, Concat(Call($namesIn, $body, New($Set)))),
                    While(
                      Length($queue),
                      Sequence(
                        Bind($head, Call(Member($queue, "shift"))),
                        If(Equals($head, $identity), Return(true), Undefined()),
                        If(
                          Call(Member($seen, "has"), $head),
                          Continue(),
                          Undefined()
                        ),
                        Call(Member($seen, "add"), $head),
                        Bind($unit, Call(Member(Member($api, "store"), "get"), $head)),
                        If(Not($unit), Continue(), Undefined()),
                        ForOf(
                          $r,
                          Member($unit, "realizations"),
                          Sequence(
                            If(
                              And(Member($r, "body"), Equals(Member(Member($r, "body"), "head"), "Code")),
                              Continue(),
                              Undefined()
                            ),
                            ForOf(
                              $next,
                              Call($namesIn, Member($r, "body"), New($Set)),
                              Call(Member($queue, "push"), $next)
                            )
                          )
                        )
                      )
                    ),
                    Return(false)
                  )
                )
              ),
              If(
                Call($reachesSelf),
                Sequence(
                  Call(Member($rejected, "push"), Call(Member($api, "call"), "SelfReferential", $body)),
                  Continue()
                ),
                Undefined()
              ),
              Bind($canAct,
                Lambda(List($head, $seen),
                  Sequence(
                    If(
                      Call(Member($seen, "has"), $head),
                      Return(false),
                      Undefined()
                    ),
                    Call(Member($seen, "add"), $head),
                    Bind($unit, Call(Member(Member($api, "store"), "get"), $head)),
                    If(Not($unit), Return(false), Undefined()),
                    If(
                      Length(Member($unit, "realizations")),
                      Return(true),
                      Undefined()
                    ),
                    ForOf(
                      Object(claim = $r),
                      Member($unit, "relations"),
                      If(
                        And(
                          And(
                            And(And($r, Equals(Member($r, "head"), "IsA")), Index(Member($r, "args"), 0)),
                            Member(Index(Member($r, "args"), 0), "value")
                          ),
                          Member(Member(Index(Member($r, "args"), 0), "value"), "head")
                        ),
                        If(
                          Call(
                            $canAct,
                            Member(Member(Index(Member($r, "args"), 0), "value"), "head"),
                            $seen
                          ),
                          Return(true),
                          Undefined()
                        ),
                        Undefined()
                      )
                    ),
                    Return(false)
                  )
                )
              ),
              Bind($inert,
                Concat(
                  New(
                    $Set,
                    Filter(
                      Concat(Call($namesIn, $body, New($Set))),
                      Lambda(List($h), Not(Call($canAct, $h, New($Set))))
                    )
                  )
                )
              ),
              If(
                Length($inert),
                Sequence(
                  Call(
                    Member($rejected, "push"),
                    Call(
                      Member($api, "call"),
                      "NeedsFirst",
                      Call(
                        Member($api, "call"),
                        "List",
                        Spread(Map($inert, Lambda(List($h), Call(Member($api, "call"), $h))))
                      )
                    )
                  ),
                  Continue()
                ),
                Undefined()
              ),
              Bind($heads, List()),
              Call(
                Func(
                  $collect,
                  List($e),
                  Sequence(
                    If(
                      Or(Not($e), Not(Member($e, "head"))),
                      Return(),
                      Undefined()
                    ),
                    Call(Member($heads, "push"), Member($e, "head")),
                    ForOf(
                      $a,
                      Member($e, "args"),
                      Call($collect, Member($a, "value"))
                    ),
                    Undefined()
                  )
                ),
                $body
              ),
              Bind($missing,
                Concat(New($Set, Filter($heads, Lambda(List($h), Not(Call(Member(Member($api, "store"), "has"), $h))))))
              ),
              If(
                Length($missing),
                Sequence(
                  Call(
                    Member($rejected, "push"),
                    Call(
                      Member($api, "call"),
                      "NeedsFirst",
                      Call(
                        Member($api, "call"),
                        "List",
                        Spread(Map($missing, Lambda(List($h), Call(Member($api, "call"), $h))))
                      )
                    )
                  ),
                  Continue()
                ),
                Undefined()
              ),
              Call(
                Member(Member($api, "store"), "addRealization"),
                $identity,
                Object(
                  pattern = $pattern,
                  body = $body,
                  context = If(Equals($context, Undefined()), Undefined(), $context),
                  properties = List(),
                  evaluateArguments = true,
                  evaluateResult = false
                )
              ),
              Assign($added, Add($added, 1))
            )
          ),
          If(
            GreaterThan(Length($asked), $RELATION_CAP),
            Call(
              Member($rejected, "push"),
              Call(
                Member($api, "call"),
                "TooMany",
                Subtract(Length($asked), $RELATION_CAP)
              )
            ),
            Undefined()
          ),
          If(
            Length($rejected),
            Return(
              Call(
                Member($api, "call"),
                "Saved",
                Call(Member($api, "call"), $identity),
                $added,
                Call(Member($api, "call"), "Rejected", Spread($rejected))
              )
            ),
            Undefined()
          ),
          Return(
            Call(
              Member($api, "call"),
              "Saved",
              Call(Member($api, "call"), $identity),
              $added
            )
          )
        )
      )
    )
  ),
  Realization(Concept(identity = $identity, relations = $relations),
    evaluateArguments = false,
    body = Concept(
      identity = $identity,
      relations = $relations,
      realizations = List()
    )
  ),
  Realization(Concept(identity = $identity, realizations = $realizations),
    evaluateArguments = false,
    body = Concept(
      identity = $identity,
      relations = List(),
      realizations = $realizations
    )
  ),
  Realization(Concept(identity = $identity),
    evaluateArguments = false,
    body = Concept(
      identity = $identity,
      relations = List(),
      realizations = List()
    )
  )
)

Concept(Forwarding(), IsA(RealizationProperty()))

// A realization derived from a multi-word name (src/seed/seed.ts): the phrase `Work(In(
// Progress()))` is the Concept `WorkInProgress()`. The target is named so a fold goes when
// its Concept does.
Concept(Fold(), IsA(RealizationProperty()))

// Binding a value (ir-spec Part 10.8): the value is evaluated once, and the name is that
// value wherever it lands, never an expression evaluated again. JavaScript's `const` and
// Rust's `let` mean this; `Let` does not name it, because the two languages disagree on
// what `let` means.
Concept(Bind(),
  Realization(Bind($name, $value, $body),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind(List($nameArg, $valueArg, $bodyArg), $args),
            Bind($name, Member(Member($nameArg, "value"), "variable")),
            Bind($value, Await(Call(Member($api, "resolve"), Member($valueArg, "value")))),
            Bind($bound, New($Map, List(List($name, $value)))),
            Return(
              Await(
                Call(
                  Member($api, "resolve"),
                  Call(
                    Member($api, "bind"),
                    Member($bodyArg, "value"),
                    $bound
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

Concept(Lambda(), IsA(Data()), IsA(CodePrimitive()))

// A function that names itself: Recursive($f, Lambda(...)) is itself wherever the body says $f.
Concept(Recursive(), IsA(Data()), IsA(CodePrimitive()))

// A function applied to values (code.ncon has how); what is not a function stays this call.
Concept(Call(), IsA(CodePrimitive()))

Concept(List(), IsA(Collection()))

Concept(Rest(), IsA(Data()))

Concept(ForeignCode(), IsA(Failure()))

Concept(True(), IsA(TruthValue()))

Concept(False(), IsA(TruthValue()))

// ------------------------------------------------------------------ *
// Request vocabulary (seed-concepts Part 10).
//
// Specified there and never seeded, which left a request with no frame to land in. The
// Ears reached for whatever word came first instead -- "can you write me a function"
// became Can(Write(...)), and the loop then set about learning the auxiliary verb "can",
// discovering among other things that it is a place in Turkey.
//
// A frame is not a computation. Do() says the user asked for something to happen rather
// than asked a question, which is the distinction nothing could previously express.
// ------------------------------------------------------------------

// ------------------------------------------------------------------ *
// Frames and modifiers.
// ------------------------------------------------------------------
Concept(Frame(), IsA(Category()))

// Politeness. Marked rather than dropped, because the design does not normalise away what
// was said -- but inert, so it never becomes the thing the system tries to do.
Concept(Politeness(), IsA(Marker()))

Concept(Marker(), IsA(Category()))

// An unresolved Ref stays residual, deliberately: it should remain visible until
// something resolves it. Once memory has, the resolved value is what computes.
Concept(Ref(),
  IsA(Marker()),
  Realization(Ref($text, resolvedTo = $value),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($found, Call(Member($args, "find"), Lambda(List($a), Equals(Member($a, "name"), "resolvedTo")))),
            If(
              Not($found),
              Return(
                Call(
                  Member($api, "call"),
                  "Ref",
                  Member(Index($args, 0), "value")
                )
              ),
              Undefined()
            ),
            Bind($value, Member($found, "value")),
            Bind($unwrap,
              Lambda(List($x),
                If(
                  And(And($x, Equals(Member($x, "head"), "Answer")), Equals(Length(Member($x, "args")), 1)),
                  Member(Index(Member($x, "args"), 0), "value"),
                  $x
                )
              )
            ),
            If(
              NotEquals(TypeOf($value), "string"),
              Return(Call($unwrap, Await(Call(Member($api, "evaluate"), $value)))),
              Undefined()
            ),
            Try(
              Return(Call($unwrap, Await(Call(Member($api, "evaluate"), Call(Member($api, "parse"), $value))))),
              Catch($_, Return($value))
            ),
            Undefined()
          )
        )
      )
    )
  )
)

Concept(Mood(),
  IsA(Marker()),
  Realization(Mood($kind, $line),
    context = Execution(),
    evaluateArguments = false,
    properties = List(Lossy()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($ctx, Member($api, "context")),
            Bind($facets,
              If(
                And($ctx, Equals(Member($ctx, "head"), "Context")),
                Map(Member($ctx, "args"), Lambda(List($a), Member($a, "value"))),
                List($ctx)
              )
            ),
            Bind($kind, Member(Index($args, 0), "value")),
            Var($line, Member(Index($args, 1), "value")),
            If(
              And($kind, Equals(Member($kind, "head"), "Declarative")),
              Sequence(
                Bind($named, Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "Read", $line)))),
                If(
                  And(
                    And(Member($named, "head"), Not(Length(Member($named, "args")))),
                    Not(Equals(Call(Member($api, "format"), $named), Call(Member($api, "format"), $line)))
                  ),
                  Return(
                    Await(
                      Call(
                        Member($api, "evaluate"),
                        $named,
                        Call(
                          Member($api, "call"),
                          "Context",
                          Spread($facets),
                          $kind
                        )
                      )
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Comment("A thing named that works out to a value (\"average of 3, 5 and 10\", \"square root of 144\")"),
            Comment("is asked for, not told: worked out as a question would be, apart, and answered when it"),
            Comment("gives a value. What is told (a claim, a greeting) gives none and is noted as before."),
            If(
              And(
                And(And(And($kind, Equals(Member($kind, "head"), "Declarative")), $line), Member($line, "head")),
                Length(Member($line, "args"))
              ),
              Sequence(
                Bind($asked,
                  Call(
                    Member($api, "call"),
                    "Context",
                    Spread($facets),
                    Call(Member($api, "call"), "Hypothetical")
                  )
                ),
                Var($value, Undefined()),
                Bind($read, Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "Read", $line)))),
                Try(
                  Assign($value, Await(Call(Member($api, "evaluate"), $read, $asked))),
                  Catch($error, Assign($value, Undefined()))
                ),
                Bind($plain,
                  Lambda(List($v),
                    Or(
                      Or(Equals(TypeOf($v), "number"), And(Equals(TypeOf($v), "string"), GreaterThan(Length($v), 0))),
                      And(
                        And(And($v, Equals(Member($v, "head"), "List")), GreaterThan(Length(Member($v, "args")), 0)),
                        Call(Member(Member($v, "args"), "every"), Lambda(List($a), Call($plain, Member($a, "value"))))
                      )
                    )
                  )
                ),
                Comment("... or a statement something takes as said, with an answer that is not a truth (\"that was"),
                Comment("wrong\" is apologised for; \"my name is Keal\" is not answered \"yes\")."),
                Bind($told,
                  And(
                    And($value, Equals(Member($value, "head"), "Answer")),
                    Not(
                      And(
                        And(Index(Member($value, "args"), 0), Member(Index(Member($value, "args"), 0), "value")),
                        Includes(
                          List("True", "False", "UnknownTruth", "Unknown"),
                          Member(Member(Index(Member($value, "args"), 0), "value"), "head")
                        )
                      )
                    )
                  )
                ),
                If(
                  $told,
                  Return(
                    Await(
                      Call(
                        Member($api, "evaluate"),
                        $read,
                        Call(
                          Member($api, "call"),
                          "Context",
                          Spread($facets),
                          $kind
                        )
                      )
                    )
                  ),
                  Undefined()
                ),
                If(
                  Call($plain, $value),
                  Sequence(
                    Bind($answer,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          $read,
                          Call(
                            Member($api, "call"),
                            "Context",
                            Spread($facets),
                            Call(Member($api, "call"), "Interrogative")
                          )
                        )
                      )
                    ),
                    Return(
                      If(
                        And($answer, Equals(Member($answer, "head"), "Answer")),
                        $answer,
                        Call(Member($api, "call"), "Answer", $answer)
                      )
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            If(
              And($kind, Equals(Member($kind, "head"), "Declarative")),
              Sequence(
                Bind($message, Call(Member($api, "ambient"), "message")),
                Bind($reply,
                  If(
                    And($message, Not(Includes($message, "?"))),
                    Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "Reply", $message))),
                    Undefined()
                  )
                ),
                Return(
                  If(
                    And(And($reply, Equals(Member($reply, "head"), "Reply")), Length(Member($reply, "args"))),
                    Object(head = "Noted", args = List(Object(value = $line), Object(name = "reply", value = $reply))),
                    Call(Member($api, "call"), "Noted", $line)
                  )
                )
              ),
              Undefined()
            ),
            Assign($line, Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), "Read", $line)))),
            Bind($context,
              Call(
                Member($api, "call"),
                "Context",
                Spread($facets),
                $kind
              )
            ),
            Bind($value, Await(Call(Member($api, "evaluate"), $line, $context))),
            If(
              And(
                And($kind, Equals(Member($kind, "head"), "Interrogative")),
                Equals(Call(Member($api, "format"), $value), Call(Member($api, "format"), $line))
              ),
              Sequence(
                Bind($found,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Call(Member($api, "call"), "Pursue", $line),
                      $context
                    )
                  )
                ),
                If(
                  And(Member($found, "head"), Equals(Member($found, "head"), "Found")),
                  Return(
                    Call(
                      Member($api, "call"),
                      "Answer",
                      Member(Index(Member($found, "args"), 0), "value")
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Comment("A question left unanswered for want of a word (\"pi\" in \"what is pi times 2\"): what was"),
            Comment("said that word is (Pursue, as \"what is pi\" would ask) stands in for it, and the question"),
            Comment("is worked out again."),
            Bind($recalling,
              Call(Member($facets, "some"), Lambda(List($f), And($f, Equals(Member($f, "head"), "Recalling"))))
            ),
            If(
              And(And($kind, Equals(Member($kind, "head"), "Interrogative")), Not($recalling)),
              Sequence(
                Bind($isCall,
                  Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))
                ),
                Comment("A word said on its own that is still there, unworked, inside what came back."),
                Bind($said, New($Set)),
                Bind($look,
                  Lambda(List($e, $into),
                    Sequence(
                      If(Not(Call($isCall, $e)), Return(), Undefined()),
                      If(
                        Not(Length(Member($e, "args"))),
                        Call(Member($into, "add"), Member($e, "head")),
                        Undefined()
                      ),
                      ForOf(
                        $a,
                        Member($e, "args"),
                        Call($look, Member($a, "value"), $into)
                      ),
                      Undefined()
                    )
                  )
                ),
                Call($look, $line, $said),
                Bind($left, New($Set)),
                Bind($inner,
                  If(
                    And(
                      And(
                        Call($isCall, $value),
                        Or(Equals(Member($value, "head"), "Answer"), Equals(Member($value, "head"), "Unknown"))
                      ),
                      Length(Member($value, "args"))
                    ),
                    Member(Index(Member($value, "args"), 0), "value"),
                    $value
                  )
                ),
                If(
                  And(Call($isCall, $inner), Length(Member($inner, "args"))),
                  ForOf(
                    $a,
                    Member($inner, "args"),
                    Call($look, Member($a, "value"), $left)
                  ),
                  Undefined()
                ),
                Comment("Only a word with no behaviour of its own: \"do\" and \"is\" are not things to recall."),
                Bind($acts,
                  Lambda(List($h),
                    Call(
                      Member(
                        Otherwise(
                          OptionalMember(Call(Member(Member($api, "store"), "get"), $h), "realizations"),
                          List()
                        ),
                        "some"
                      ),
                      Lambda(List($r), Not(Member($r, "retired")))
                    )
                  )
                ),
                Bind($wanting,
                  Filter(Concat($left), Lambda(List($h), And(Call(Member($said, "has"), $h), Not(Call($acts, $h)))))
                ),
                If(
                  Length($wanting),
                  Sequence(
                    Var($changed, $line),
                    Var($recalled, false),
                    ForOf(
                      $h,
                      $wanting,
                      Sequence(
                        Comment("Asked the way \"what is pi\" asks it, so every way the graph answers that is tried."),
                        Bind($asked,
                          Await(
                            Call(
                              Member($api, "evaluate"),
                              Call(
                                Member($api, "call"),
                                "Mood",
                                $kind,
                                Call(
                                  Member($api, "call"),
                                  "What",
                                  Call(
                                    Member($api, "call"),
                                    "Is",
                                    Call(Member($api, "call"), $h)
                                  )
                                )
                              ),
                              Call(
                                Member($api, "call"),
                                "Context",
                                Spread($facets),
                                $kind,
                                Call(Member($api, "call"), "Recalling")
                              )
                            )
                          )
                        ),
                        Comment("A thing that is a number (pi) is that number where it is worked on (\"pi times 2\"),"),
                        Comment("not where it is what is asked about (\"what is pi\")."),
                        Bind($operand,
                          Lambda(List($e),
                            And(
                              Call($isCall, $e),
                              Call(
                                Member(Member($e, "args"), "some"),
                                Lambda(List($a),
                                  Or(
                                    And(
                                      And(
                                        And(
                                          Call($isCall, Member($a, "value")),
                                          Equals(Member(Member($a, "value"), "head"), $h)
                                        ),
                                        Not(Length(Member(Member($a, "value"), "args")))
                                      ),
                                      Not(Includes(List("What", "Is"), Member($e, "head")))
                                    ),
                                    Call($operand, Member($a, "value"))
                                  )
                                )
                              )
                            )
                          )
                        ),
                        Bind($value,
                          If(
                            Call($operand, $line),
                            Await(
                              Call(
                                Member($api, "evaluate"),
                                Call(
                                  Member($api, "call"),
                                  "NumericValue",
                                  Call(Member($api, "call"), $h)
                                ),
                                Call(Member($api, "call"), "Execution")
                              )
                            ),
                            Undefined()
                          )
                        ),
                        Bind($got,
                          If(
                            Equals(TypeOf($value), "number"),
                            $value,
                            If(
                              And(
                                And(Call($isCall, $asked), Equals(Member($asked, "head"), "Answer")),
                                Length(Member($asked, "args"))
                              ),
                              Member(Index(Member($asked, "args"), 0), "value"),
                              Undefined()
                            )
                          )
                        ),
                        If(
                          Or(
                            Equals($got, Undefined()),
                            And(
                              Call($isCall, $got),
                              Or(
                                Equals(Member($got, "head"), "Unknown"),
                                Includes(Call(Member($api, "format"), $got), Add($h, "()"))
                              )
                            )
                          ),
                          Continue(),
                          Undefined()
                        ),
                        Bind($put,
                          Lambda(List($e),
                            If(
                              Call($isCall, $e),
                              If(
                                And(Equals(Member($e, "head"), $h), Not(Length(Member($e, "args")))),
                                $got,
                                Object(
                                  head = Member($e, "head"),
                                  args = Map(
                                    Member($e, "args"),
                                    Lambda(List($a), Object(Spread($a), value = Call($put, Member($a, "value"))))
                                  )
                                )
                              ),
                              $e
                            )
                          )
                        ),
                        Assign($changed, Call($put, $changed)),
                        Assign($recalled, true)
                      )
                    ),
                    If(
                      $recalled,
                      Sequence(
                        Bind($again, Await(Call(Member($api, "evaluate"), $changed, $context))),
                        If(
                          NotEquals(Call(Member($api, "format"), $again), Call(Member($api, "format"), $changed)),
                          Return($again),
                          Undefined()
                        )
                      ),
                      Undefined()
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Return($value)
          )
        )
      )
    )
  )
)

// The turn's hook for a reply the graph writes itself (runtime/turn.ts); English is one
// language that realizes it (english.ncon).
Concept(RenderResponse())

Concept(Modifier(), IsA(Category()))

Concept(Not(), IsA(Modifier()))

Concept(Result(), IsA(Category()))

Concept(Answer(), IsA(Result()))

// The turn names these too: a reply of several parts (Sequence), one of which may be an aside
// only noted (Noted), left out of the reply when its words are not known yet.
Concept(Noted(), IsA(Result()))

Concept(Sequence(), IsA(CodePrimitive()))

Concept(Describes(), IsA(Result()))

// Text assembly, which is what emitting source is made of. Variadic through Rest, so a
// taught realization can lay out a construct without the grammar needing a list syntax.
//
// Its arguments evaluate under the SAME context it was reached in, so a TypeScript
// realization of If whose body is Text("if (", $c, ") {", $t, "}") emits TypeScript for
// $c and $t too. Composition is what makes one realization per construct enough.
Concept(Text(),
  IsA(Data()),
  IsA(Source()),
  Realization(Text(Rest($parts)),
    body = Code(
      ir = Lambda(List($args, $bindings, $api),
        Sequence(
          If(
            Call(Member($args, "some"), Lambda(List($a), And(Member($a, "value"), Member(Member($a, "value"), "head")))),
            Return(
              Call(
                Member($api, "call"),
                "Text",
                Spread(Map($args, Lambda(List($a), Member($a, "value"))))
              )
            ),
            Undefined()
          ),
          Return(
            Call(
              Member(
                Map(
                  $args,
                  Lambda(List($a),
                    Sequence(
                      Bind($v, Member($a, "value")),
                      If(Equals(TypeOf($v), "string"), Return($v), Undefined()),
                      If(
                        Or(Equals($v, null), Equals($v, Undefined())),
                        Return(""),
                        Undefined()
                      ),
                      Return(Call($String, $v))
                    )
                  )
                ),
                "join"
              ),
              ""
            )
          )
        )
      )
    )
  )
)

Concept(Data(), IsA(Category()))

// ------------------------------------------------------------------ *
// Primitives and collections.
// ------------------------------------------------------------------
Concept(Primitive(), IsA(Data()))

Concept(Collection(), IsA(Data()))

Concept(Deictic(), IsA(Category()))

// Kind to kind: everything that is one is also the other, so it chains (research/wikidata.ts).
Concept(SubclassOf(),
  IsA(Relation()),
  Transitive(),
  Enduring()
)

Concept(Retracts(), Incidental(), Occurrent())

Concept(Compile(), IsA(RealizationProperty()))

// A body written as a program (ir-spec Part 10.8): the code primitives it calls are its
// operations, run wherever it was reached and not traced as steps of thought.
Concept(Program(), IsA(RealizationProperty()))

// What a program's operations are: the code IR's own primitives (code.ncon).
Concept(CodePrimitive(),
  IsA(Category()),
  OperatesIn(Execution())
)

// The context a kind of operation runs in, wherever it is called from.
Concept(OperatesIn(), IsA(Relation()))

Concept(Incidental(), IsA(RelationProperty()))

Concept(TargetLanguage(), IsA(ContextFacet()))

// How a language's source is read when tree-sitter reads it (src/code/tree.ts): the grammar's
// name, and the prefix its syntax nodes are named by (Python's are Py<Type>).
Concept(Grammar(), IsA(Relation()))

Concept(SyntaxPrefix(), IsA(Relation()))

// ------------------------------------------------------------------ *
// Failure and outcome. Pure data.
// ------------------------------------------------------------------
Concept(Failure(), IsA(Category()))

Concept(TruthValue(), IsA(Data()))

// ------------------------------------------------------------------ *
// Research, as Concepts. Search results become Concepts with their source attached, so a
// claim can be traced back to where it came from.
// ------------------------------------------------------------------
Concept(Source(), IsA(Category()))

// Where what Napkin learns comes from (design/sources.md). Every learned fact is stamped from
// a record on one of these (Wikidata Imported("Q..."), Teacher Taught(...)), so each can be
// traced, counted, and trusted by how its facts hold up. Not Source, which Text is.
Concept(LearningSource(), IsA(Category()))

// A model asked to teach, the last resort (src/learn/teacher.ts).
Concept(Teacher(), IsA(LearningSource()))

// What the user said, a turn at a time.
Concept(Conversation(), IsA(LearningSource()))

// Declared the way Symmetric() is (memory-spec Part 5.3): a property of a relation.
Concept(Enduring(), IsA(RelationProperty()))

Concept(Occurrent(), IsA(RelationProperty()))

// What a relation Concept is a kind of: IsA(Relation()) on the predicates that relate things.
Concept(Relation(), IsA(Category()))

// What every compiled body starts with. Each language pack realizes it under
// Context(<language>, Compiled()); without one, compiled bodies are interpreted instead.
Concept(Prelude(), IsA(Category()))

Concept(Execution(), IsA(ContextFacet()))
