Concept(Return(), IsA(Prefix()), Keyword(), Binds(0))

Concept(Throw(),
  Relation(IsA(Prefix()), context = Code(TypeScript())),
  Relation(Keyword(), context = Code(TypeScript())),
  Relation(Binds(0), context = Code(TypeScript()))
