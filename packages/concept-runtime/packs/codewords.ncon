// Brackets.
Concept(Parens(), IsA(Opener()), IsA(Round()), Spelled("("))

Concept(Brackets(), IsA(Opener()), Spelled("["))

Concept(Braces(), IsA(Opener()), Spelled("{"))

Concept(Block(), IsA(Scope()))

Concept(Indent(), IsA(Scope()))

Concept(Index(), IsA(Opener()), IsA(Postfix()), Binds(200))

Concept(Apply(),
  IsA(Opener()),
  IsA(Postfix()),
  IsA(Round()),
  Binds(200)
)

Concept(Angles(), IsA(Opener()), IsA(Attached()))

Concept(Template(),
  IsA(Opener()),
  IsA(Juxtaposed()),
  ClosedBy(TemplateEnd())
)

Concept(Interpolation(),
  IsA(Opener()),
  IsA(Transparent()),
  Spelled("${")
)

Concept(Question(),
  Relation(IsA(Opener()), context = Code(TypeScript())),
  Relation(IsA(Infix()), context = Code(TypeScript())),
  Relation(Spelled("?"), context = Code(TypeScript())),
  Relation(Binds(25, Right()), context = Code(TypeScript())),
  Relation(ClosedBy(Colon()), context = Code(TypeScript()))
)

Concept(CloseParen(), IsA(Closer()), Spelled(")"))

Concept(CloseBracket(), IsA(Closer()), Spelled("]"))

Concept(CloseBrace(), IsA(Closer()), Spelled("}"))

Concept(Dedent(), IsA(Closer()))

Concept(TemplateEnd(), IsA(Closer()))

// Separators and layout.
Concept(Comma(), IsA(Separator()), Spelled(","))

Concept(Semicolon(), IsA(Separator()), Spelled(";"))

Concept(Newline(), IsA(Separator()))

Concept(BlockColon(), Relation(IsA(Separator()), context = Code(Python())))

// What a member of a thing is, as the code IR's Concepts, in a language: xs.map(f) is Map(xs, f).
// Method(name, how many it is given, Passes(how many its callback is given)): a callback taking
// more than that (the index, the array) stays a method call.
Concept(Length(), Relation(Property("length"), context = Code(TypeScript())))

Concept(Map(), Relation(Method("map", 1, Passes(1)), context = Code(TypeScript())))

Concept(Filter(), Relation(Method("filter", 1, Passes(1)), context = Code(TypeScript())))

Concept(FlatMap(), Relation(Method("flatMap", 1, Passes(1)), context = Code(TypeScript())))

Concept(Reduce(), Relation(Method("reduce", 2, Passes(2)), context = Code(TypeScript())))

Concept(Includes(), Relation(Method("includes", 1), context = Code(TypeScript())))
