Concept(Average(),
  Realization(Average($xs), context=Execution(),
    body=Code(
      source="""(args, bindings, api) => {
          const asNumber = (v) => (typeof v === "number" ? v : v && v.head === "Number" ? asNumber(v.args[0].value) : v && v.head === "Of" ? asNumber(v.args[0].value) : NaN);
          const list = args[0].value && args[0].value.head === "Of" ? args[0].value.args[0].value : args[0].value;
          const xs = list && list.head === "List" ? list.args.map((a) => asNumber(a.value)) : [];
          if (!xs.length || xs.some(Number.isNaN)) return api.call("Average", args[0].value);
          return xs.reduce((a, b) => a + b, 0) / xs.length;
        }""")),
  Realization(Average(Of($xs)), context=Execution(),
    body=Code(
      source="""(args, bindings, api) => {
          const asNumber = (v) => (typeof v === "number" ? v : v && v.head === "Number" ? asNumber(v.args[0].value) : v && v.head === "Of" ? asNumber(v.args[0].value) : NaN);
