// "how many days until christmas": from today to the date, in whole days.
Concept(HowMany(),
  Realization(HowMany(Days(), Until($when)), context=Execution(), evaluateArguments=false, properties=List(Program()),
    body=Bind(
      $until,
      FieldOf(Element(Arguments(Quote(Until($when))), 0), "value"),
      Bind(
        $date,
        Evaluate($until),
        Bind(
          $field,
          Lambda(
            List($n),
            If(
              Truthy(Bind($t0, $date, If(Truthy($t0), Identical(Head($date), "Date"), $t0))),
              Bind(
                $t1,
                FirstSatisfying(
                  Arguments($date),
                  Lambda(List($a), Identical(FieldOf($a, "name"), $n))),
                If(IsNothing($t1), Undefined(), FieldOf($t1, "value"))),
              Undefined())),
          If(
            NotIdentical(TypeOf(Call($field, "year")), "number"),
            MakeCall(
              "HowMany",
              AsList(
                Map(
                  List(Argument(value=Quote(Days())), Argument(value=Quote(Until($when)))),
                  Lambda(List($a2), FieldOf($a2, "value"))))),
            Bind(
              $now,
              CurrentInstant(),
              Bind(
                $today,
                UtcMilliseconds(
                  YearOf($now),
                  AddValues(SubtractValues(MonthOf($now), 1), 1),
                  DayOf($now)),
                Bind(
                  $then,
                  UtcMilliseconds(
                    Call($field, "year"),
                    AddValues(SubtractValues(Call($field, "month"), 1), 1),
                    Call($field, "day")),
                  MakeCall(
                    "Answer",
                    List(
                      MakeCall(
                        "Days",
                        List(RoundNearest(DivideValues(SubtractValues($then, $today), 86400000)))))))))))))))

// "wanna play tic tac toe?", "can we play chess": wanting to do something together, said
// to the one who would do it, is asking for it (Searle's indirect requests), the way
// "can you X" already is. Only a thing to do: "want pizza" stays a want.
Concept(Want(),
  Realization(Want($x), context=Execution(), evaluateArguments=false, properties=List(Program()),
    body=Bind(
      $x2,
      Quote($x),
      Bind(
        $doable,
        Bind(
          $t4,
          Bind(
            $t3,
            Bind($t0, $x2, If(Truthy($t0), Head($x2), $t0)),
            If(
              Truthy($t3),
              Above(
                Bind(
                  $t2,
                  Length(
                    Bind(
                      $t1,
                      UnitOf(Head($x2)),
                      If(IsNothing($t1), Undefined(), FieldOf($t1, "realizations")))),
                  If(IsNothing($t2), 0, $t2)),
                0),
              $t3)),
          If(Truthy($t4), Above(Length(Arguments($x2)), 0), $t4)),
        If(
          Falsy($doable),
          MakeCall("Want", List($x2)),
          Bind(
            $ctx,
            CurrentContext(),
            Bind(
              $facets,
              If(
                Truthy(Bind($t5, $ctx, If(Truthy($t5), Identical(Head($ctx), "Context"), $t5))),
                Map(Arguments($ctx), Lambda(List($a), FieldOf($a, "value"))),
                List($ctx)),
              Evaluate(
                $x2,
                MakeCall(
                  "Context",
                  Concat(
                    AsList(
                      Filter(
                        $facets,
                        Lambda(
                          List($f),
                          Bind(
                            $t6,
                            $f,
                            If(
                              Truthy($t6),
                              Falsy(
                                Truthy(
                                  Includes(
                                    List("Checking", "Interrogative", "Declarative"),
                                    Head($f)))),
                              $t6))))),
                    List(MakeCall("Imperative", List()))))))))))))

Concept(Can(),
  Realization(Can(We(), $x), context=Context(Execution(), Interrogative()), evaluateArguments=false, properties=List(Program()),
    body=Evaluate(
      Quote($x),
      MakeCall("Context", List(MakeCall("Execution", List()), MakeCall("Imperative", List()))))))

// "define recursion", "explain recursion": asking what it is, in another form.
Concept(Define(), SynonymOf(What()))

Concept(Explain(), SynonymOf(What()))

// "that was wrong", "that's wrong": told it made a mistake. Apologising is the reply;
// the correction itself is evidence the next turn carries (emergent-judgment-plan
// Part 3.1), not something to believe.
Concept(Was(),
  Realization(Was($said, Wrong()), context=Execution(), evaluateArguments=false, properties=List(Program()),
    body=MakeCall("Answer", List(MakeCall("Sorry", List())))))

Concept(Is(),
  Realization(Is($said, Wrong()), context=Execution(), evaluateArguments=false, properties=List(Program()),
    body=MakeCall("Answer", List(MakeCall("Sorry", List())))))

Concept(Sorry(), IsA(Data()))

Concept(Okay(), IsA(Data()))

// "yes", "no" on their own: a reply to a reply.
Concept(Yes(), IsA(Agreement()))

Concept(Yeah(), IsA(Agreement()))

Concept(Yep(), IsA(Agreement()))

Concept(Refusal(),
  IsA(Category()),
  Realization($said, context=Execution(), evaluateArguments=false, properties=List(Program()),
    body=MakeCall("Answer", List(MakeCall("Okay", List())))))

Concept(No(), IsA(Refusal()))

Concept(Nope(), IsA(Refusal()))

Concept(Nah(), IsA(Refusal()))
