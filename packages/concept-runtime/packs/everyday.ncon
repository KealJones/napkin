Requires(Basic(), Self())

// ================================================================
// From src/seed/everyday.ts
//
// Everyday requests a chat gets that the core seed had no words for: halves and doubles,
// averages and totals, holidays and how far off they are, "define", and being told it was
// wrong. Each is an ordinary realization; nothing here is host code.

// "half of 90", "double it": one number in, one out, said with or without "of".
// "the average of 2, 4 and 9", "add up 3, 4 and 5": over a list, said with or without "of".
// A holiday on a fixed date is the next time that date comes round.
Concept(Half(),
  Realization(Half($x), context=Execution(), properties=List(Program()),
    body=Bind(
      $asNumber,
      Recursive(
        $asNumber,
        Lambda(
          List($v),
          If(
            Identical(TypeOf($v), "number"),
            $v,
            If(
              Truthy(Bind($t0, $v, If(Truthy($t0), Identical(Head($v), "Number"), $t0))),
              Call($asNumber, FieldOf(Element(Arguments($v), 0), "value")),
              If(
                Truthy(Bind($t1, $v, If(Truthy($t1), Identical(Head($v), "Of"), $t1))),
                Call($asNumber, FieldOf(Element(Arguments($v), 0), "value")),
                NotANumber()))))),
      Bind(
        $x2,
        Call($asNumber, $x),
        If(IsNotANumber($x2), MakeCall("Half", List($x)), DivideValues($x2, 2))))),
  Realization(Half(Of($x)), context=Execution(), properties=List(Program()),
    body=Bind(
      $asNumber,
      Recursive(
        $asNumber,
        Lambda(
          List($v),
          If(
            Identical(TypeOf($v), "number"),
            $v,
            If(
              Truthy(Bind($t0, $v, If(Truthy($t0), Identical(Head($v), "Number"), $t0))),
              Call($asNumber, FieldOf(Element(Arguments($v), 0), "value")),
              If(
                Truthy(Bind($t1, $v, If(Truthy($t1), Identical(Head($v), "Of"), $t1))),
                Call($asNumber, FieldOf(Element(Arguments($v), 0), "value")),
                NotANumber()))))),
      Bind(
        $x2,
        Call($asNumber, Quote(Of($x))),
        If(IsNotANumber($x2), MakeCall("Half", List(Quote(Of($x)))), DivideValues($x2, 2))))))

