// "how many days until christmas": from today to the date, in whole days.
Concept(HowMany(),
  Realization(HowMany(Days(), Until($when)), context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let($until, Member(Index(Member(Member(Index($args, 1), "value"), "args"), 0), "value")),
            Let($date, Await(Call(Member($api, "evaluate"), $until))),
            Let(
              $field,
              Lambda(
                List($n),
                If(
                  And($date, Equals(Member($date, "head"), "Date")),
                  OptionalMember(
                    Call(
                      Member(Member($date, "args"), "find"),
                      Lambda(List($a), Equals(Member($a, "name"), $n))),
                    "value"),
                  Undefined()))),
            If(
              NotEquals(TypeOf(Call($field, "year")), "number"),
              Return(
                Call(
                  Member($api, "call"),
                  "HowMany",
                  Spread(Map($args, Lambda(List($a), Member($a, "value")))))),
              Undefined()),
            Let($now, New($Date)),
            Let(
              $today,
              Call(
                Member($Date, "UTC"),
                Call(Member($now, "getFullYear")),
                Call(Member($now, "getMonth")),
                Call(Member($now, "getDate")))),
            Let(
              $then,
              Call(
                Member($Date, "UTC"),
                Call($field, "year"),
                Subtract(Call($field, "month"), 1),
                Call($field, "day"))),
            Return(
              Call(
                Member($api, "call"),
                "Answer",
                Call(
                  Member($api, "call"),
                  "Days",
                  Call(Member($Math, "round"), Divide(Subtract($then, $today), 86400000)))))))))))

// "wanna play tic tac toe?", "can we play chess": wanting to do something together, said
// to the one who would do it, is asking for it (Searle's indirect requests), the way
// "can you X" already is. Only a thing to do: "want pizza" stays a want.
Concept(Want(),
  Realization(Want($x), context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Let($x, Member(Index($args, 0), "value")),
            Let(
              $doable,
              And(
                And(
                  And($x, Member($x, "head")),
                  GreaterThan(
                    Otherwise(
                      Length(
                        OptionalMember(
                          Call(Member(Member($api, "store"), "get"), Member($x, "head")),
                          "realizations")),
                      0),
                    0)),
                GreaterThan(Length(Member($x, "args")), 0))),
            If(Not($doable), Return(Call(Member($api, "call"), "Want", $x)), Undefined()),
            Let($ctx, Member($api, "context")),
            Let(
              $facets,
              If(
                And($ctx, Equals(Member($ctx, "head"), "Context")),
                Map(Member($ctx, "args"), Lambda(List($a), Member($a, "value"))),
                List($ctx))),
            Return(
              Await(
                Call(
                  Member($api, "evaluate"),
                  $x,
                  Call(
                    Member($api, "call"),
                    "Context",
                    Spread(
                      Filter(
                        $facets,
                        Lambda(
                          List($f),
                          And(
                            $f,
                            Not(
                              Includes(
                                List("Checking", "Interrogative", "Declarative"),
                                Member($f, "head"))))))),
                    Call(Member($api, "call"), "Imperative")))))))))))

Concept(Can(),
  Realization(Can(We(), $x), context=Context(Execution(), Interrogative()), evaluateArguments=false,
    body=Evaluate(
      Quote($x),
      MakeCall("Context", List(MakeCall("Execution", List()), MakeCall("Imperative", List()))))))

// "define recursion", "explain recursion": asking what it is, in another form.
Concept(Define(), SynonymOf(What()))

Concept(Explain(), SynonymOf(What()))

// "that was wrong", "that's wrong": told it made a mistake. Apologising is the reply;
// the correction itself is evidence the next turn carries (emergent-judgment-plan
// Part 3.1), not something to believe.
Concept(Was(),
  Realization(Was($said, Wrong()), context=Execution(), evaluateArguments=false,
    body=MakeCall("Answer", List(MakeCall("Sorry", List())))))

Concept(Is(),
  Realization(Is($said, Wrong()), context=Execution(), evaluateArguments=false,
    body=MakeCall("Answer", List(MakeCall("Sorry", List())))))

Concept(Sorry(), IsA(Data()))

Concept(Okay(), IsA(Data()))

// "yes", "no" on their own: a reply to a reply.
Concept(Yes(), IsA(Agreement()))

Concept(Yeah(), IsA(Agreement()))

Concept(Yep(), IsA(Agreement()))

Concept(Refusal(),
  IsA(Category()),
  Realization($said, context=Execution(), evaluateArguments=false,
    body=MakeCall("Answer", List(MakeCall("Okay", List())))))

Concept(No(), IsA(Refusal()))

Concept(Nope(), IsA(Refusal()))

Concept(Nah(), IsA(Refusal()))
