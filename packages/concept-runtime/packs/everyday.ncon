Requires(Basic(), Self())

// ================================================================
// From src/seed/everyday.ts
//
// Everyday requests a chat gets that the core seed had no words for: halves and doubles,
// averages and totals, holidays and how far off they are, "define", and being told it was
// wrong. Each is an ordinary realization; nothing here is host code.

// "half of 90", "double it": one number in, one out, said with or without "of".
// "the average of 2, 4 and 9", "add up 3, 4 and 5": over a list, said with or without "of".
// A holiday on a fixed date is the next time that date comes round.
Concept(Half(),
  Realization(Half($x), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $asNumber,
            Lambda(
              List($v),
              If(
                Equals(TypeOf($v), "number"),
                $v,
                If(
                  And($v, Equals(Member($v, "head"), "Number")),
                  Call($asNumber, Member(Index(Member($v, "args"), 0), "value")),
                  If(
                    And($v, Equals(Member($v, "head"), "Of")),
                    Call($asNumber, Member(Index(Member($v, "args"), 0), "value")),
                    $NaN))))),
          Let($x, Call($asNumber, Member(Index($args, 0), "value"))),
          Return(
            If(
              Call(Member($Number, "isNaN"), $x),
              Call(Member($api, "call"), "Half", Member(Index($args, 0), "value")),
              Divide($x, 2))))))),
  Realization(Half(Of($x)), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Let(
            $asNumber,
            Lambda(
              List($v),
              If(
                Equals(TypeOf($v), "number"),
                $v,
                If(
                  And($v, Equals(Member($v, "head"), "Number")),
                  Call($asNumber, Member(Index(Member($v, "args"), 0), "value")),
                  If(
                    And($v, Equals(Member($v, "head"), "Of")),
                    Call($asNumber, Member(Index(Member($v, "args"), 0), "value")),
                    $NaN))))),
          Let($x, Call($asNumber, Member(Index($args, 0), "value"))),
          Return(
            If(
              Call(Member($Number, "isNaN"), $x),
              Call(Member($api, "call"), "Half", Member(Index($args, 0), "value")),
              Divide($x, 2))))))))

