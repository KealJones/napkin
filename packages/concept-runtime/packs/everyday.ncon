                Call($asNumber, FieldOf(Element(Arguments($v), 0), "value")),
                NotANumber()))))),
      Bind(
        $list,
        If(
          Truthy(Bind($t2, $xs, If(Truthy($t2), Identical(Head($xs), "Of"), $t2))),
          FieldOf(Element(Arguments($xs), 0), "value"),
          $xs),
        Bind(
          $xs2,
          If(
            Truthy(Bind($t3, $list, If(Truthy($t3), Identical(Head($list), "List"), $t3))),
            Map(Arguments($list), Lambda(List($a), Call($asNumber, FieldOf($a, "value")))),
            List()),
          If(
            Truthy(
              If(
                Falsy(Length($xs2)),
                true,
                AnySatisfies($xs2, Lambda(List($t4), IsNotANumber($t4))))),
            MakeCall("Average", List($xs)),
            DivideValues(Reduce($xs2, Lambda(List($a2, $b), AddValues($a2, $b)), 0), Length($xs2))))))),
