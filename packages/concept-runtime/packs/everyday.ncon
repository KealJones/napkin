Concept(Average(),
  Realization(Average($xs), context=Execution(), properties=List(Program()),
    body=Bind(
      $asNumber,
      Recursive(
        $asNumber,
        Lambda(
          List($v),
          If(
            Identical(TypeOf($v), "number"),
            $v,
