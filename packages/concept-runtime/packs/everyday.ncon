          let when = new Date(now.getFullYear(), 11, 24);
          if (when < today) when = new Date(now.getFullYear() + 1, 11, 24);
          const days = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
          return { head: "Date", args: [
