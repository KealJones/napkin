          If(
            Truthy(
              If(
                Falsy(Length($xs2)),
                true,
                AnySatisfies($xs2, Lambda(List($t4), IsNotANumber($t4))))),
            MakeCall("AddUp", List($xs)),
            Reduce($xs2, Lambda(List($a2, $b), AddValues($a2, $b)), 0)))))),
  Realization(AddUp(Of($xs)), context=Execution(), properties=List(Program()),
    body=Bind(
      $asNumber,
      Recursive(
        $asNumber,
        Lambda(
          List($v),
          If(
            Identical(TypeOf($v), "number"),
            $v,
            If(
              Truthy(Bind($t0, $v, If(Truthy($t0), Identical(Head($v), "Number"), $t0))),
              Call($asNumber, FieldOf(Element(Arguments($v), 0), "value")),
              If(
                Truthy(Bind($t1, $v, If(Truthy($t1), Identical(Head($v), "Of"), $t1))),
                Call($asNumber, FieldOf(Element(Arguments($v), 0), "value")),
                NotANumber()))))),
      Bind(
        $list,
        If(
          Truthy(
            Bind($t2, Quote(Of($xs)), If(Truthy($t2), Identical(Head(Quote(Of($xs))), "Of"), $t2))),
          FieldOf(Element(Arguments(Quote(Of($xs))), 0), "value"),
          Quote(Of($xs))),
        Bind(
          $xs2,
          If(
            Truthy(Bind($t3, $list, If(Truthy($t3), Identical(Head($list), "List"), $t3))),
            Map(Arguments($list), Lambda(List($a), Call($asNumber, FieldOf($a, "value")))),
            List()),
          If(
            Truthy(
              If(
                Falsy(Length($xs2)),
                true,
                AnySatisfies($xs2, Lambda(List($t4), IsNotANumber($t4))))),
            MakeCall("AddUp", List(Quote(Of($xs)))),
            Reduce($xs2, Lambda(List($a2, $b), AddValues($a2, $b)), 0)))))))

// "take 10, double it": the number a chain of steps starts from.
Concept(Take(),
  Realization(Take($x), context=Execution(), properties=List(Program()),
    body=If(Identical(TypeOf($x), "number"), $x, MakeCall("Take", List($x)))))

// "half of 90", "until christmas": the preposition is held in the pattern that reads it.
// Left over on its own it is structure, not a word to learn.
Concept(Of(), IsA(Marker()))

Concept(Until(), IsA(Marker()))

Concept(Holiday(), IsA(Category()))

Concept(Christmas(),
  IsA(Holiday()),
  Realization(Christmas(), context=Execution(), properties=List(Program()),
    body=Bind(
      $now,
      CurrentInstant(),
      Bind(
        $today,
        LocalInstant(YearOf($now), AddValues(SubtractValues(MonthOf($now), 1), 1), DayOf($now)),
        Bind(
          $when,
          Cell(LocalInstant(YearOf($now), AddValues(11, 1), 25)),
          Steps(
            If(
              Below(Get($when), $today),
              Steps(
                Set($when, LocalInstant(AddValues(YearOf($now), 1), AddValues(11, 1), 25)),
                Undefined()),
              Steps(Undefined(), Undefined())),
            Bind(
              $days,
              List("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"),
              CallOf(
                "Date",
                List(
                  Record(name="year", value=YearOf(Get($when))),
                  Record(name="month", value=AddValues(SubtractValues(MonthOf(Get($when)), 1), 1)),
                  Record(name="day", value=DayOf(Get($when))),
                  Record(name="weekday", value=Element($days, WeekdayOf(Get($when)))))))))))))

