          Cell(LocalInstant(YearOf($now), AddValues(0, 1), 1)),
          Steps(
            If(
              Below(Get($when), $today),
              Steps(
                Set($when, LocalInstant(AddValues(YearOf($now), 1), AddValues(0, 1), 1)),
                Undefined()),
              Steps(Undefined(), Undefined())),
            Bind(
              $days,
              List("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"),
