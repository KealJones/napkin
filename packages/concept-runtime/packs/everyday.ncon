        Bind(
          $when,
          Cell(LocalInstant(YearOf($now), AddValues(11, 1), 24)),
          Steps(
            If(
              Below(Get($when), $today),
              Steps(
                Set($when, LocalInstant(AddValues(YearOf($now), 1), AddValues(11, 1), 24)),
                Undefined()),
              Steps(Undefined(), Undefined())),
            Bind(
              $days,
              List("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"),
              CallOf(
                "Date",
                List(
                  Record(name="year", value=YearOf(Get($when))),
                  Record(name="month", value=AddValues(SubtractValues(MonthOf(Get($when)), 1), 1)),
                  Record(name="day", value=DayOf(Get($when))),
                  Record(name="weekday", value=Element($days, WeekdayOf(Get($when)))))))))))))

