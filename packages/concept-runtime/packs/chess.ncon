Concept(BestBy(),
  IsA(Capability()),
  Realization(BestBy($items, $score), context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $list,
              Lambda(
                List($x),
                Sequence(
                  If(
                    Or(Not($x), NotEquals(Member($x, "head"), "List")),
                    Throw(New($Error, "Expected List")),
                    Undefined()),
                  Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value"))))))),
            Bind(
              $items,
              Call($list, Await(Call(Member($api, "evaluate"), Member(Index($args, 0), "value"))))),
            Bind($lambda, Member(Index($args, 1), "value")),
            If(
              Or(Not($lambda), NotEquals(Member($lambda, "head"), "Lambda")),
              Throw(New($Error, "Expected scoring Lambda")),
              Undefined()),
            Var($best, null),
            Var($score, Negate($Infinity)),
            ForOf(
              $item,
              $items,
              Sequence(
                Bind(
                  $value,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Call(
                        Member($api, "substitute"),
                        Member(Index(Member($lambda, "args"), 1), "value"),
                        New(
                          $Map,
                          List(
                            List(
                              Member(
                                Member(
                                  Index(
                                    Member(
                                      Member(Index(Member($lambda, "args"), 0), "value"),
                                      "args"),
                                    0),
                                  "value"),
                                "variable"),
                              $item))))))),
                If(
                  Or(
                    NotEquals(TypeOf($value), "number"),
                    Not(Call(Member($Number, "isFinite"), $value))),
                  Throw(New($Error, "Score must be finite")),
                  Undefined()),
                If(
                  GreaterThan($value, $score),
                  Sequence(Assign($best, $item), Assign($score, $value)),
                  Undefined()))),
            Return($best)))))))

Concept(CoordinateFromLabel(),
  IsA(Capability()),
  Realization(CoordinateFromLabel($text, $files, $firstRank), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
          If(
            Or(NotEquals(TypeOf(Index($v, 0)), "string"), NotEquals(TypeOf(Index($v, 1)), "string")),
            Return(null),
            Undefined()),
          Bind($m, Call(Member(Regex("^([a-z])([0-9]+)$", "i"), "exec"), Index($v, 0))),
          If(Not($m), Return(null), Undefined()),
          Bind(
            $file,
            Call(Member(Index($v, 1), "indexOf"), Call(Member(Index($m, 1), "toLowerCase")))),
          Bind($rank, Subtract(Call($Number, Index($m, 2)), Index($v, 2))),
          Return(
            If(
              Or(LessThan($file, 0), LessThan($rank, 0)),
              null,
              Call(Member($api, "call"), "Square", $file, $rank))))))))

Concept(GridOffset(),
  IsA(Capability()),
  Realization(GridOffset($square, $dx, $dy, $width, $height), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
          Bind(
            $x,
            Add(
              OptionalMember(OptionalIndex(OptionalMember(Index($v, 0), "args"), 0), "value"),
              Index($v, 1))),
          Bind(
            $y,
            Add(
              OptionalMember(OptionalIndex(OptionalMember(Index($v, 0), "args"), 1), "value"),
              Index($v, 2))),
          Return(
            If(
              And(
                And(
                  And(
                    And(
                      And(
                        Call(Member($Number, "isInteger"), $x),
                        Call(Member($Number, "isInteger"), $y)),
                      AtLeast($x, 0)),
                    AtLeast($y, 0)),
                  LessThan($x, Index($v, 3))),
                LessThan($y, Index($v, 4))),
              Call(Member($api, "call"), Member(Index($v, 0), "head"), $x, $y),
              null)))))))

Concept(Occupant(),
  IsA(Capability()),
  Realization(Occupant($board, $square), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind(
            $list,
            Lambda(
              List($x),
              Sequence(
                If(
                  Or(Not($x), NotEquals(Member($x, "head"), "List")),
                  Throw(New($Error, "Expected List")),
                  Undefined()),
                Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value"))))))),
          Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
          If(Equals(Index($v, 1), null), Return(null), Undefined()),
          Return(
            Otherwise(
              Call(
                Member(Call($list, Index($v, 0)), "find"),
                Lambda(
                  List($p),
                  Equals(
                    Call(
                      Member($api, "format"),
                      Otherwise(
                        OptionalMember(
                          Call(
                            Member(Member($p, "args"), "find"),
                            Lambda(List($a), Equals(Member($a, "name"), "square"))),
                          "value"),
                        null)),
                    Call(Member($api, "format"), Index($v, 1))))),
              null)))))))

Concept(GridRay(),
  IsA(Capability()),
  Realization(GridRay($board, $from, $delta, $steps, $width, $height, $includeBlocker), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind(
            $list,
            Lambda(
              List($x),
              Sequence(
                If(
                  Or(Not($x), NotEquals(Member($x, "head"), "List")),
                  Throw(New($Error, "Expected List")),
                  Undefined()),
                Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value"))))))),
          Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
          Bind(
            $occupied,
            New(
              $Set,
              Map(
                Call($list, Index($v, 0)),
                Lambda(
                  List($p),
                  Call(
                    Member($api, "format"),
                    Otherwise(
                      OptionalMember(
                        Call(
                          Member(Member($p, "args"), "find"),
                          Lambda(List($a), Equals(Member($a, "name"), "square"))),
                        "value"),
                      null)))))),
          Bind($out, List()),
          Bind($dx, Member(Index(Member(Index($v, 2), "args"), 0), "value")),
          Bind($dy, Member(Index(Member(Index($v, 2), "args"), 1), "value")),
          For(
            Var($i, 1),
            AtMost($i, Index($v, 3)),
            PostIncrement($i),
            Sequence(
              Bind(
                $x,
                Add(Member(Index(Member(Index($v, 1), "args"), 0), "value"), Multiply($dx, $i))),
              Bind(
                $y,
                Add(Member(Index(Member(Index($v, 1), "args"), 1), "value"), Multiply($dy, $i))),
              If(
                Or(
                  Or(Or(LessThan($x, 0), LessThan($y, 0)), AtLeast($x, Index($v, 4))),
                  AtLeast($y, Index($v, 5))),
                Break(),
                Undefined()),
              Bind($sq, Call(Member($api, "call"), Member(Index($v, 1), "head"), $x, $y)),
              Bind($blocked, Call(Member($occupied, "has"), Call(Member($api, "format"), $sq))),
              If(
                Or(Not($blocked), Equals(Index($v, 6), true)),
                Call(Member($out, "push"), $sq),
                Undefined()),
              If($blocked, Break(), Undefined()))),
          Return(Call(Member($api, "call"), "List", Spread($out))))))))

Concept(BoardChange(),
  IsA(Capability()),
  Realization(BoardChange($board, $removals, $additions), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind(
            $list,
            Lambda(
              List($x),
              Sequence(
                If(
                  Or(Not($x), NotEquals(Member($x, "head"), "List")),
                  Throw(New($Error, "Expected List")),
                  Undefined()),
                Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value"))))))),
          Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
          Bind($removed, New($Set, Map(Call($list, Index($v, 1)), Member($api, "format")))),
          Bind(
            $kept,
            Filter(
              Call($list, Index($v, 0)),
              Lambda(
                List($p),
                Not(
                  Call(
                    Member($removed, "has"),
                    Call(
                      Member($api, "format"),
                      Otherwise(
                        OptionalMember(
                          Call(
                            Member(Member($p, "args"), "find"),
                            Lambda(List($a), Equals(Member($a, "name"), "square"))),
                          "value"),
                        null))))))),
          Return(
            Call(Member($api, "call"), "List", Spread($kept), Spread(Call($list, Index($v, 2))))))))))

Concept(AmbientValue(),
  IsA(Capability()),
  Realization(AmbientValue($key, $fallback), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Otherwise(
          Call(Member($api, "ambient"), Member(Index($args, 0), "value")),
          Member(Index($args, 1), "value"))))))

Concept(IdentityKey(),
  IsA(Capability()),
  Realization(IdentityKey($prefix, $scope), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          If(
            Or(
              Not(
                Call(
                  Member(Regex("^[A-Z][A-Za-z0-9_]*$", ""), "test"),
                  Member(Index($args, 0), "value"))),
              NotEquals(TypeOf(Member(Index($args, 1), "value")), "string")),
            Throw(New($Error, "Invalid identity")),
            Undefined()),
          Return(
            Add(
              Add(Member(Index($args, 0), "value"), "_"),
              Call(
                Member(Call(Member($Buffer, "from"), Member(Index($args, 1), "value")), "toString"),
                "hex"))))))))

Concept(Recall(),
  IsA(Capability()),
  Realization(Recall($identity), context=Execution(), properties=List(Effectful()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Return(
            If(
              Call(Member(Member($api, "store"), "has"), Member(Index($args, 0), "value")),
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), Member(Index($args, 0), "value")))),
              null)))))))

Concept(CreateRecord(),
  IsA(Capability()),
  Realization(CreateRecord($identity, $value), context=Execution(), properties=List(Effectful()),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind($identity, Member(Index($args, 0), "value")),
          If(
            Not(Call(Member(Regex("^[A-Z][A-Za-z0-9_]*$", ""), "test"), $identity)),
            Throw(New($Error, "Invalid Concept identity")),
            Undefined()),
          If(
            Call(Member(Member($api, "store"), "has"), $identity),
            Return(Call(Member($api, "call"), "AlreadyExists", $identity)),
            Undefined()),
          Call(
            Member(Member($api, "store"), "seed"),
            Object(
              identity=$identity,
              relations=List(
                Object(
                  claim=Call(Member($api, "call"), "IsA", Call(Member($api, "call"), "StoredRecord")))),
              realizations=List(
                Object(
                  pattern=Call(Member($api, "call"), $identity),
                  body=Call(Member($api, "call"), "Quote", Member(Index($args, 1), "value")),
                  properties=List(),
                  evaluateArguments=false,
                  evaluateResult=false)))),
          Return(Call(Member($api, "call"), "Stored", Member(Index($args, 1), "value"))))))))

Concept(CompareAndSwap(),
  IsA(Capability()),
  Realization(CompareAndSwap($identity, $expected, $next), context=Execution(), properties=List(Effectful()),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($identity, Member(Index($args, 0), "value")),
            Bind($previous, Call(Member(Member($api, "store"), "get"), $identity)),
            If(Not($previous), Return(Call(Member($api, "call"), "Conflict")), Undefined()),
            Bind(
              $current,
              Await(Call(Member($api, "evaluate"), Call(Member($api, "call"), $identity)))),
            If(
              Or(
                NotEquals($previous, Call(Member(Member($api, "store"), "get"), $identity)),
                NotEquals(
                  Call(Member($api, "format"), $current),
                  Call(Member($api, "format"), Member(Index($args, 1), "value")))),
              Return(Call(Member($api, "call"), "Conflict")),
              Undefined()),
            Call(
              Member(Member($api, "store"), "addRealization"),
              $identity,
              Object(
                pattern=Call(Member($api, "call"), $identity),
                body=Call(Member($api, "call"), "Quote", Member(Index($args, 2), "value")),
                properties=List(),
                evaluateArguments=false,
                evaluateResult=false)),
            Return(Call(Member($api, "call"), "Stored", Member(Index($args, 2), "value")))))))))

Concept(StoredRecord(), IsA(Data()))

Concept(Stored(), IsA(Result()))

Concept(AlreadyExists(), IsA(Result()))

Concept(Conflict(), IsA(Result()))

// ================================================================
// From src/seed/chess.ts
//
// Chess is data and composed Concepts. Only the reusable collection/grid operations
// cross into host code; every chess decision remains editable in the Concept graph.

Concept(ChessConcept(), IsA(Data()))

Concept(ChessPosition(), IsA(Data()))

Concept(Piece(), IsA(Data()))

Concept(White(), IsA(Data()))

Concept(Black(), IsA(Data()))

Concept(Pawn(), IsA(Data()))

Concept(Knight(), IsA(Data()))

Concept(Bishop(), IsA(Data()))

Concept(Rook(), IsA(Data()))

Concept(Queen(), IsA(Data()))

Concept(King(), IsA(Data()))

Concept(CastleRight(), IsA(Data()))

Concept(Checkmate(), IsA(Data()))

Concept(Stalemate(), IsA(Data()))

Concept(DeadPosition(), IsA(Data()))

Concept(FivefoldRepetition(), IsA(Data()))

Concept(SeventyFiveMoves(), IsA(Data()))

Concept(ThreefoldRepetition(), IsA(Data()))

Concept(FiftyMoves(), IsA(Data()))

Concept(Square(),
  IsA(ChessConcept()),
  Realization(Square($label), properties=List(Pure()),
    body=Bind(
      $coordinate,
      CoordinateFromLabel($label, "abcdefgh", 1),
      If(And(Not(Same($coordinate, null)), LessThan(Slot($coordinate, 1), 8)), $coordinate, null))))

Concept(ChessMove(),
  IsA(ChessConcept()),
  Realization(ChessMove($from, $to), properties=List(Pure()),
    body=Build(ChessMove(from=$from, to=$to, promotion=null))),
  Realization(ChessMove($from, $to, $promotion), properties=List(Pure()),
    body=Build(ChessMove(from=$from, to=$to, promotion=$promotion))))

Concept(ChessOther(),
  IsA(ChessConcept()),
  Realization(ChessOther($side), properties=List(Pure()),
    body=If(Same($side, White()), Black(), White())))

Concept(ChessForward(),
  IsA(ChessConcept()),
  Realization(ChessForward($side), properties=List(Pure()), body=If(Same($side, White()), 1, -1)))

Concept(ChessHome(),
  IsA(ChessConcept()),
  Realization(ChessHome($side), properties=List(Pure()), body=If(Same($side, White()), 0, 7)))

Concept(ChessPawnHome(),
  IsA(ChessConcept()),
  Realization(ChessPawnHome($side), properties=List(Pure()), body=If(Same($side, White()), 1, 6)))

Concept(ChessPromotionRank(),
  IsA(ChessConcept()),
  Realization(ChessPromotionRank($side), properties=List(Pure()),
    body=If(Same($side, White()), 7, 0)))

Concept(ChessRules(),
  IsA(ChessConcept()),
  Realization(ChessRules(), properties=List(Pure()),
    body=GameRules(
      actions=ChessLegalMoves(),
      transition=ChessPositionAfter(),
      outcome=ChessOutcome(),
      evaluate=ChessScore(),
      setup=ChessInitialPosition(),
      claims=DrawClaimable(),
      editable=List(
        RuleOption(name="pawnDouble", values=List(true, false)),
        RuleOption(name="castling", values=List(true, false))),
      pawnDouble=true,
      castling=true,
      kingSafety=true)))

// Static initial data, not an executable chess implementation.
Concept(ChessInitialPosition(),
  IsA(ChessConcept()),
  Realization(ChessInitialPosition(), properties=List(Pure()),
    body=ChessPosition(
      board=List(
        Piece(kind=Rook(), side=White(), square=Square(0, 0)),
        Piece(kind=Pawn(), side=White(), square=Square(0, 1)),
        Piece(kind=Knight(), side=White(), square=Square(1, 0)),
        Piece(kind=Pawn(), side=White(), square=Square(1, 1)),
        Piece(kind=Bishop(), side=White(), square=Square(2, 0)),
        Piece(kind=Pawn(), side=White(), square=Square(2, 1)),
        Piece(kind=Queen(), side=White(), square=Square(3, 0)),
        Piece(kind=Pawn(), side=White(), square=Square(3, 1)),
        Piece(kind=King(), side=White(), square=Square(4, 0)),
        Piece(kind=Pawn(), side=White(), square=Square(4, 1)),
        Piece(kind=Bishop(), side=White(), square=Square(5, 0)),
        Piece(kind=Pawn(), side=White(), square=Square(5, 1)),
        Piece(kind=Knight(), side=White(), square=Square(6, 0)),
        Piece(kind=Pawn(), side=White(), square=Square(6, 1)),
        Piece(kind=Rook(), side=White(), square=Square(7, 0)),
        Piece(kind=Pawn(), side=White(), square=Square(7, 1)),
        Piece(kind=Rook(), side=Black(), square=Square(0, 7)),
        Piece(kind=Pawn(), side=Black(), square=Square(0, 6)),
        Piece(kind=Knight(), side=Black(), square=Square(1, 7)),
        Piece(kind=Pawn(), side=Black(), square=Square(1, 6)),
        Piece(kind=Bishop(), side=Black(), square=Square(2, 7)),
        Piece(kind=Pawn(), side=Black(), square=Square(2, 6)),
        Piece(kind=Queen(), side=Black(), square=Square(3, 7)),
        Piece(kind=Pawn(), side=Black(), square=Square(3, 6)),
        Piece(kind=King(), side=Black(), square=Square(4, 7)),
        Piece(kind=Pawn(), side=Black(), square=Square(4, 6)),
        Piece(kind=Bishop(), side=Black(), square=Square(5, 7)),
        Piece(kind=Pawn(), side=Black(), square=Square(5, 6)),
        Piece(kind=Knight(), side=Black(), square=Square(6, 7)),
        Piece(kind=Pawn(), side=Black(), square=Square(6, 6)),
        Piece(kind=Rook(), side=Black(), square=Square(7, 7)),
        Piece(kind=Pawn(), side=Black(), square=Square(7, 6))),
      turn=White(),
      rights=List(
        CastleRight(side=White(), rook=Square(0, 0)),
        CastleRight(side=White(), rook=Square(7, 0)),
        CastleRight(side=Black(), rook=Square(0, 7)),
        CastleRight(side=Black(), rook=Square(7, 7))),
      enPassant=null,
      halfmove=0,
      fullmove=1)))

Concept(ChessDiagonalDirections(),
  IsA(ChessConcept()),
  Realization(ChessDiagonalDirections(), properties=List(Pure()),
    body=List(Square(1, 1), Square(1, -1), Square(-1, 1), Square(-1, -1))))

Concept(ChessStraightDirections(),
  IsA(ChessConcept()),
  Realization(ChessStraightDirections(), properties=List(Pure()),
    body=List(Square(1, 0), Square(-1, 0), Square(0, 1), Square(0, -1))))

Concept(ChessKingDirections(),
  IsA(ChessConcept()),
  Realization(ChessKingDirections(), properties=List(Pure()),
    body=Concat(ChessDiagonalDirections(), ChessStraightDirections())))

Concept(ChessKnightDirections(),
  IsA(ChessConcept()),
  Realization(ChessKnightDirections(), properties=List(Pure()),
    body=List(
      Square(1, 2),
      Square(2, 1),
      Square(-1, 2),
      Square(-2, 1),
      Square(1, -2),
      Square(2, -1),
      Square(-1, -2),
      Square(-2, -1))))

Concept(ChessJumps(),
  IsA(ChessConcept()),
  Realization(ChessJumps($square, $directions), properties=List(Pure()),
    body=Filter(
      Map(
        $directions,
        Lambda(List($delta), GridOffset($square, Slot($delta, 0), Slot($delta, 1), 8, 8))),
      Lambda(List($landing), Not(Same($landing, null))))))

Concept(ChessRays(),
  IsA(ChessConcept()),
  Realization(ChessRays($board, $square, $directions), properties=List(Pure()),
    body=FlatMap($directions, Lambda(List($delta), GridRay($board, $square, $delta, 7, 8, 8, true)))))

// Attack squares deliberately include friendly blockers and attacks by pinned pieces.
Concept(ChessAttacks(),
  IsA(ChessConcept()),
  Realization(ChessAttacks($piece, $board, $rules), properties=List(Pure()),
    body=Bind($kind, Slot($piece, "kind"), ChessKindAttacks($kind, $piece, $board, $rules))))

Concept(ChessKindAttacks(),
  IsA(ChessConcept()),
  Realization(ChessKindAttacks(Pawn(), $piece, $board, $rules), properties=List(Pure()),
    body=Bind(
      $direction,
      ChessForward(Slot($piece, "side")),
      ChessJumps(
        Slot($piece, "square"),
        List(Build(Square(-1, $direction)), Build(Square(1, $direction)))))),
  Realization(ChessKindAttacks(Knight(), $piece, $board, $rules), properties=List(Pure()),
    body=ChessJumps(Slot($piece, "square"), ChessKnightDirections())),
  Realization(ChessKindAttacks(King(), $piece, $board, $rules), properties=List(Pure()),
    body=ChessJumps(Slot($piece, "square"), ChessKingDirections())),
  Realization(ChessKindAttacks(Bishop(), $piece, $board, $rules), properties=List(Pure()),
    body=ChessRays($board, Slot($piece, "square"), ChessDiagonalDirections())),
  Realization(ChessKindAttacks(Rook(), $piece, $board, $rules), properties=List(Pure()),
    body=ChessRays($board, Slot($piece, "square"), ChessStraightDirections())),
  Realization(ChessKindAttacks(Queen(), $piece, $board, $rules), properties=List(Pure()),
    body=ChessRays($board, Slot($piece, "square"), ChessKingDirections())))

Concept(ChessAttacked(),
  IsA(ChessConcept()),
  Realization(ChessAttacked($board, $square, $by, $rules), properties=List(Pure()),
    body=Any(
      $board,
      Lambda(
        List($attacker),
        And(
          Same(Slot($attacker, "side"), $by),
          Any(
            ChessAttacks($attacker, $board, $rules),
            Lambda(List($attack), Same($attack, $square))))))))

Concept(ChessCheck(),
  IsA(ChessConcept()),
  Realization(ChessCheck($position, $side, $rules), properties=List(Pure()),
    body=Bind(
      $board,
      Slot($position, "board"),
      Bind(
        $king,
        Find(
          $board,
          Lambda(
            List($piece),
            And(Same(Slot($piece, "side"), $side), Same(Slot($piece, "kind"), King())))),
        If(
          Same($king, null),
          true,
          ChessAttacked($board, Slot($king, "square"), ChessOther($side), $rules))))))

Concept(ChessCanLand(),
  IsA(ChessConcept()),
  Realization(ChessCanLand($board, $square, $side), properties=List(Pure()),
    body=Bind(
      $target,
      Occupant($board, $square),
      Or(
        Same($target, null),
        And(Not(Same(Slot($target, "side"), $side)), Not(Same(Slot($target, "kind"), King())))))))

Concept(ChessMovesTo(),
  IsA(ChessConcept()),
  Realization(ChessMovesTo($piece, $squares), properties=List(Pure()),
    body=FlatMap(
      $squares,
      Lambda(
        List($destination),
        If(
          And(
            Same(Slot($piece, "kind"), Pawn()),
            Same(Slot($destination, 1), ChessPromotionRank(Slot($piece, "side")))),
          Map(
            List(Queen(), Rook(), Bishop(), Knight()),
            Lambda(
              List($promotion),
              Build(ChessMove(from=Slot($piece, "square"), to=$destination, promotion=$promotion)))),
          List(Build(ChessMove(from=Slot($piece, "square"), to=$destination, promotion=null))))))))

Concept(ChessEpCapture(),
  IsA(ChessConcept()),
  Realization(ChessEpCapture($piece, $position, $square), properties=List(Pure()),
    body=And(
      Same($square, Slot($position, "enPassant")),
      Not(Same($square, null)),
      Same(Occupant(Slot($position, "board"), $square), null),
      Bind(
        $victim,
        Occupant(
          Slot($position, "board"),
          GridOffset($square, 0, Multiply(-1, ChessForward(Slot($piece, "side"))), 8, 8)),
        And(
          Same(Slot($victim, "kind"), Pawn()),
          Same(Slot($victim, "side"), ChessOther(Slot($piece, "side"))))))))

Concept(ChessPawnDestinations(),
  IsA(ChessConcept()),
  Realization(ChessPawnDestinations($piece, $position, $rules), properties=List(Pure()),
    body=Bind(
      $board,
      Slot($position, "board"),
      Bind(
        $square,
        Slot($piece, "square"),
        Bind(
          $direction,
          ChessForward(Slot($piece, "side")),
          Bind(
            $one,
            GridOffset($square, 0, $direction, 8, 8),
            Concat(
              If(
                And(Not(Same($one, null)), Same(Occupant($board, $one), null)),
                Concat(
                  List($one),
                  If(
                    And(
                      Same(Slot($rules, "pawnDouble"), true),
                      Same(Slot($square, 1), ChessPawnHome(Slot($piece, "side"))),
                      Same(
                        Occupant($board, GridOffset($square, 0, Multiply(2, $direction), 8, 8)),
                        null)),
                    List(GridOffset($square, 0, Multiply(2, $direction), 8, 8)),
                    List())),
                List()),
              Filter(
                ChessAttacks($piece, $board, $rules),
                Lambda(
                  List($capture),
                  Or(
                    And(
                      Not(Same(Occupant($board, $capture), null)),
                      ChessCanLand($board, $capture, Slot($piece, "side"))),
                    ChessEpCapture($piece, $position, $capture)))))))))))

Concept(ChessPieceMoves(),
  IsA(ChessConcept()),
  Realization(ChessPieceMoves($piece, $position, $rules), properties=List(Pure()),
    body=If(
      Same(Slot($piece, "kind"), Pawn()),
      ChessMovesTo($piece, ChessPawnDestinations($piece, $position, $rules)),
      Concat(
        ChessMovesTo(
          $piece,
          Filter(
            ChessAttacks($piece, Slot($position, "board"), $rules),
            Lambda(
              List($square),
              ChessCanLand(Slot($position, "board"), $square, Slot($piece, "side"))))),
        If(
          And(Same(Slot($piece, "kind"), King()), Same(Slot($rules, "castling"), true)),
          ChessCastleMoves($piece, $position, $rules),
          List())))))

Concept(ChessCastleMoves(),
  IsA(ChessConcept()),
  Realization(ChessCastleMoves($piece, $position, $rules), properties=List(Pure()),
    body=Bind(
      $rank,
      ChessHome(Slot($piece, "side")),
      If(
        Same(Slot($piece, "square"), Build(Square(4, $rank))),
        Concat(
          ChessCastleWing($piece, $position, $rules, 7, 6, 5, List(5, 6)),
          ChessCastleWing($piece, $position, $rules, 0, 2, 3, List(1, 2, 3))),
        List()))))

Concept(ChessCastleWing(),
  IsA(ChessConcept()),
  Realization(ChessCastleWing($piece, $position, $rules, $rookFile, $destinationFile, $transitFile, $emptyFiles), properties=List(Pure()),
    body=Bind(
      $rank,
      ChessHome(Slot($piece, "side")),
      Bind(
        $rookSquare,
        Build(Square($rookFile, $rank)),
        Bind(
          $rook,
          Occupant(Slot($position, "board"), $rookSquare),
          If(
            And(
              Any(
                Slot($position, "rights"),
                Lambda(
                  List($right),
                  And(
                    Same(Slot($right, "side"), Slot($piece, "side")),
                    Same(Slot($right, "rook"), $rookSquare)))),
              Same(Slot($rook, "kind"), Rook()),
              Same(Slot($rook, "side"), Slot($piece, "side")),
              All(
                $emptyFiles,
                Lambda(
                  List($file),
                  Same(Occupant(Slot($position, "board"), Build(Square($file, $rank))), null))),
              Or(
                Same(Slot($rules, "kingSafety"), false),
                And(
                  Not(ChessCheck($position, Slot($piece, "side"), $rules)),
                  Not(
                    ChessCheck(
                      With(
                        $position,
                        "board",
                        BoardChange(
                          Slot($position, "board"),
                          List(Slot($piece, "square")),
                          List(With($piece, "square", Build(Square($transitFile, $rank)))))),
                      Slot($piece, "side"),
                      $rules))))),
            List(
              Build(
                ChessMove(
                  from=Slot($piece, "square"),
                  to=Build(Square($destinationFile, $rank)),
                  promotion=null))),
            List()))))))

Concept(ChessLegalMoves(),
  IsA(ChessConcept()),
  Realization(ChessLegalMoves($position, $actor, $rules), properties=List(Pure()),
    body=If(
      Same($actor, Slot($position, "turn")),
      Filter(
        FlatMap(
          Filter(Slot($position, "board"), Lambda(List($piece), Same(Slot($piece, "side"), $actor))),
          Lambda(List($piece), ChessPieceMoves($piece, $position, $rules))),
        Lambda(
          List($move),
          Or(
            Same(Slot($rules, "kingSafety"), false),
            Not(ChessCheck(ChessPositionAfter($position, $move, $rules), $actor, $rules))))),
      List())))

// Transition assumes the caller has checked membership in ChessLegalMoves.
Concept(ChessPositionAfter(),
  IsA(ChessConcept()),
  Realization(ChessPositionAfter($position, $move, $rules), properties=List(Pure()),
    body=Bind(
      $board,
      Slot($position, "board"),
      Bind(
        $from,
        Slot($move, "from"),
        Bind(
          $to,
          Slot($move, "to"),
          Bind(
            $piece,
            Occupant($board, $from),
            Bind(
              $pawn,
              Same(Slot($piece, "kind"), Pawn()),
              Bind(
                $ep,
                And($pawn, ChessEpCapture($piece, $position, $to)),
                Bind(
                  $castle,
                  And(
                    Same(Slot($piece, "kind"), King()),
                    Same(Abs(Subtract(Slot($to, 0), Slot($from, 0))), 2)),
                  Bind(
                    $newBoard,
                    BoardChange(
                      $board,
                      Concat(
                        List($from, $to),
                        If(
                          $ep,
                          List(
                            GridOffset(
                              $to,
                              0,
                              Multiply(-1, ChessForward(Slot($piece, "side"))),
                              8,
                              8)),
                          List())),
                      List(
                        With(
                          With($piece, "square", $to),
                          "kind",
                          If(
                            And($pawn, Not(Same(Slot($move, "promotion"), null))),
                            Slot($move, "promotion"),
                            Slot($piece, "kind"))))),
                    Build(
                      ChessPosition(
                        board=If($castle, ChessCastleBoard($newBoard, $from, $to), $newBoard),
                        turn=ChessOther(Slot($position, "turn")),
                        rights=Filter(
                          Slot($position, "rights"),
                          Lambda(
                            List($right),
                            Not(
                              Or(
                                And(
                                  Same(Slot($piece, "kind"), King()),
                                  Same(Slot($piece, "side"), Slot($right, "side"))),
                                Same($from, Slot($right, "rook")),
                                Same($to, Slot($right, "rook")))))),
                        enPassant=If(
                          And($pawn, Same(Abs(Subtract(Slot($to, 1), Slot($from, 1))), 2)),
                          GridOffset($from, 0, ChessForward(Slot($piece, "side")), 8, 8),
                          null),
                        halfmove=If(
                          Or($pawn, $ep, Not(Same(Occupant($board, $to), null))),
                          0,
                          Add(Slot($position, "halfmove"), 1)),
                        fullmove=Add(
                          Slot($position, "fullmove"),
                          If(Same(Slot($position, "turn"), Black()), 1, 0))))))))))))))

Concept(ChessCastleBoard(),
  IsA(ChessConcept()),
  Realization(ChessCastleBoard($board, $from, $to), properties=List(Pure()),
    body=Bind(
      $rookSquare,
      Build(Square(If(GreaterThan(Slot($to, 0), Slot($from, 0)), 7, 0), Slot($from, 1))),
      BoardChange(
        $board,
        List($rookSquare),
        List(
          With(
            Occupant($board, $rookSquare),
            "square",
            Build(Square(If(GreaterThan(Slot($to, 0), Slot($from, 0)), 5, 3), Slot($from, 1)))))))))

Concept(ChessMaterial(),
  IsA(ChessConcept()),
  Realization(ChessMaterial(Pawn()), properties=List(Pure()), body=100),
  Realization(ChessMaterial(Knight()), properties=List(Pure()), body=320),
  Realization(ChessMaterial(Bishop()), properties=List(Pure()), body=330),
  Realization(ChessMaterial(Rook()), properties=List(Pure()), body=500),
  Realization(ChessMaterial(Queen()), properties=List(Pure()), body=900),
  Realization(ChessMaterial(King()), properties=List(Pure()), body=0))

Concept(ChessScore(),
  IsA(ChessConcept()),
  Realization(ChessScore($position, $side, $rules), properties=List(Pure()),
    body=Sum(
      Map(
        Slot($position, "board"),
        Lambda(
          List($piece),
          Multiply(
            If(Same(Slot($piece, "side"), $side), 1, -1),
            Bind($kind, Slot($piece, "kind"), ChessMaterial($kind))))))))

Concept(ChessSquareColor(),
  IsA(ChessConcept()),
  Realization(ChessSquareColor($square), properties=List(Pure()),
    body=Modulo(Add(Slot($square, 0), Slot($square, 1)), 2)))

// This proves common dead positions. It does not claim to solve arbitrary blocked positions.
Concept(ChessDeadPosition(),
  IsA(ChessConcept()),
  Realization(ChessDeadPosition($position), properties=List(Pure()),
    body=Bind(
      $pieces,
      Filter(
        Slot($position, "board"),
        Lambda(List($piece), Not(Same(Slot($piece, "kind"), King())))),
      Or(
        Same(Length($pieces), 0),
        And(
          Same(Length($pieces), 1),
          Or(
            Same(Slot(ElementAt($pieces, 0), "kind"), Bishop()),
            Same(Slot(ElementAt($pieces, 0), "kind"), Knight()))),
        And(
          All($pieces, Lambda(List($piece), Same(Slot($piece, "kind"), Bishop()))),
          All(
            $pieces,
            Lambda(
              List($piece),
              Same(
                ChessSquareColor(Slot($piece, "square")),
                ChessSquareColor(Slot(ElementAt($pieces, 0), "square"))))))))))

// En passant changes repetition identity only when a legal en passant capture exists.
Concept(ChessRepetitionEp(),
  IsA(ChessConcept()),
  Realization(ChessRepetitionEp($position, $rules), properties=List(Pure()),
    body=If(
      Same(Slot($position, "enPassant"), null),
      null,
      If(
        Any(
          Filter(
            Slot($position, "board"),
            Lambda(
              List($piece),
              And(
                Same(Slot($piece, "kind"), Pawn()),
                Same(Slot($piece, "side"), Slot($position, "turn"))))),
          Lambda(
            List($piece),
            And(
              Any(
                ChessAttacks($piece, Slot($position, "board"), $rules),
                Lambda(List($square), Same($square, Slot($position, "enPassant")))),
              ChessEpCapture($piece, $position, Slot($position, "enPassant")),
              Or(
                Same(Slot($rules, "kingSafety"), false),
                Not(
                  ChessCheck(
                    ChessPositionAfter(
                      $position,
                      Build(
                        ChessMove(
                          from=Slot($piece, "square"),
                          to=Slot($position, "enPassant"),
                          promotion=null)),
                      $rules),
                    Slot($position, "turn"),
                    $rules)))))),
        Slot($position, "enPassant"),
        null))))

Concept(ChessSamePosition(),
  IsA(ChessConcept()),
  Realization(ChessSamePosition($left, $right, $rules), properties=List(Pure()),
    body=And(
      Same(Slot($left, "turn"), Slot($right, "turn")),
      Same(Slot($left, "rights"), Slot($right, "rights")),
      Same(Length(Slot($left, "board")), Length(Slot($right, "board"))),
      All(
        Slot($left, "board"),
        Lambda(List($piece), Any(Slot($right, "board"), Lambda(List($other), Same($piece, $other))))),
      Same(ChessRepetitionEp($left, $rules), ChessRepetitionEp($right, $rules)))))

Concept(ChessRepetitionCount(),
  IsA(ChessConcept()),
  Realization(ChessRepetitionCount($position, $history, $rules), properties=List(Pure()),
    body=Add(
      1,
      Length(Filter($history, Lambda(List($prior), ChessSamePosition($position, $prior, $rules)))))))

Concept(DrawClaimable(),
  IsA(ChessConcept()),
  Realization(DrawClaimable($position, $history, $rules), properties=List(Pure()),
    body=Concat(
      If(
        GreaterThan(ChessRepetitionCount($position, $history, $rules), 2),
        List(ThreefoldRepetition()),
        List()),
      If(GreaterThan(Slot($position, "halfmove"), 99), List(FiftyMoves()), List()))))

Concept(ChessOutcome(),
  IsA(ChessConcept()),
  Realization(ChessOutcome($position, $history, $rules), properties=List(Pure()),
    body=If(
      Same(Length(ChessLegalMoves($position, Slot($position, "turn"), $rules)), 0),
      If(
        ChessCheck($position, Slot($position, "turn"), $rules),
        Build(Win(ChessOther(Slot($position, "turn")), Checkmate())),
        Draw(Stalemate())),
      If(
        ChessDeadPosition($position),
        Draw(DeadPosition()),
        If(
          GreaterThan(Slot($position, "halfmove"), 149),
          Draw(SeventyFiveMoves()),
          If(
            GreaterThan(ChessRepetitionCount($position, $history, $rules), 4),
            Draw(FivefoldRepetition()),
            Ongoing()))))))
