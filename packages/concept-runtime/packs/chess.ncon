Concept(Range(),
  IsA(Capability()),
  Realization(Range($start, $end), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args, $bindings, $api),
        Sequence(
          Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
          If(
            Or(
              Or(
                Not(Call(Member($Number, "isInteger"), Index($v, 0))),
                Not(Call(Member($Number, "isInteger"), Index($v, 1)))),
              GreaterThan(Subtract(Index($v, 1), Index($v, 0)), 100000)),
            Throw(New($Error, "Invalid range")),
            Undefined()),
          Return(
            Call(
              Member($api, "call"),
              "List",
              Spread(
                Call(
                  Member($Array, "from"),
                  Object(length=Call(Member($Math, "max"), 0, Subtract(Index($v, 1), Index($v, 0)))),
                  Lambda(List($_, $i), Add(Index($v, 0), $i)))))))))))

Concept(Any(),
  IsA(Capability()),
  Realization(Any($items, $lambda), context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $list,
              Lambda(
                List($x),
                Sequence(
                  If(
                    Or(Not($x), NotEquals(Member($x, "head"), "List")),
                    Throw(New($Error, "Expected List")),
                    Undefined()),
                  Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value"))))))),
            Bind(
              $truth,
              Lambda(List($x), Or(Equals($x, true), And($x, Equals(Member($x, "head"), "True"))))),
            Bind(
              $items,
              Call($list, Await(Call(Member($api, "evaluate"), Member(Index($args, 0), "value"))))),
            Bind($lambda, Member(Index($args, 1), "value")),
            If(
              Or(
                Or(
                  Or(Not($lambda), NotEquals(Member($lambda, "head"), "Lambda")),
                  Not(
                    OptionalMember(
                      OptionalMember(
                        OptionalIndex(
                          OptionalMember(
                            OptionalMember(Index(Member($lambda, "args"), 0), "value"),
                            "args"),
                          0),
                        "value"),
                      "variable"))),
                NotEquals(Length(Member($lambda, "args")), 2)),
              Throw(New($Error, "Expected Lambda(List(variable), body)")),
              Undefined()),
            Bind($results, List()),
            ForOf(
              $item,
              $items,
              Sequence(
                Bind(
                  $output,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Call(
                        Member($api, "substitute"),
                        Member(Index(Member($lambda, "args"), 1), "value"),
                        New(
                          $Map,
                          List(
                            List(
                              Member(
                                Member(
                                  Index(
                                    Member(
                                      Member(Index(Member($lambda, "args"), 0), "value"),
                                      "args"),
                                    0),
                                  "value"),
                                "variable"),
                              $item))))))),
                If(And(Equals("Any", "Any"), Call($truth, $output)), Return(true), Undefined()),
                If(
                  And(Equals("Any", "All"), Not(Call($truth, $output))),
                  Return(false),
                  Undefined()),
                If(And(Equals("Any", "Find"), Call($truth, $output)), Return($item), Undefined()),
                If(Equals("Any", "Map"), Call(Member($results, "push"), $output), Undefined()),
                If(
                  Equals("Any", "FlatMap"),
                  Call(Member($results, "push"), Spread(Call($list, $output))),
                  Undefined()),
                If(
                  And(Equals("Any", "Filter"), Call($truth, $output)),
                  Call(Member($results, "push"), $item),
                  Undefined()))),
            If(Equals("Any", "Any"), Return(false), Undefined()),
            If(Equals("Any", "All"), Return(true), Undefined()),
            If(Equals("Any", "Find"), Return(null), Undefined()),
            Return(Call(Member($api, "call"), "List", Spread($results)))))))))

