// Chess, as ordinary Concepts: movement, legality, transitions and outcomes composed over
// reusable game primitives (collections, records, geometry and stored state). Moved from
// src/seed/chess.ts and game-primitives.ts onto the code IR's conventions: Lambda(List($x),
// body), and the IR's own Map, Filter, FlatMap, Head, Length, And, Or, Not, Concat, List,
// LessThan, Sum, Divide and Modulo. ElementAt is a list's element, since At is a time, and
// ChessMove is a chess move, since Move is tic-tac-toe's.

Requires(Core(), Code(), Basic())

Concept(Build(),
  IsA(Capability()),
  Realization(Build($value), context=Execution(), evaluateArguments=false,
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind($value, Member(Index($args, 0), "value")),
            If(Or(Not($value), Not(Member($value, "head"))), Return($value), Undefined()),
            Bind($fields, List()),
            ForOf(
              $a,
              Member($value, "args"),
              Call(
                Member($fields, "push"),
                Object(Spread($a), value=Await(Call(Member($api, "evaluate"), Member($a, "value")))))),
            Return(Object(head=Member($value, "head"), args=$fields))))))))

Concept(Slot(),
  IsA(Capability()),
  Realization(Slot($record, $key), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
          If(Or(Not(Index($v, 0)), Not(Member(Index($v, 0), "head"))), Return(null), Undefined()),
          Bind(
            $found,
            If(
              Equals(TypeOf(Index($v, 1)), "number"),
              Index(Member(Index($v, 0), "args"), Index($v, 1)),
              Call(
                Member(Member(Index($v, 0), "args"), "find"),
                Lambda(List($a), Equals(Member($a, "name"), Index($v, 1)))))),
          Return(If($found, Member($found, "value"), null)))))))

Concept(With(),
  IsA(Capability()),
  Realization(With($record, $key, $value), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
          If(
            Or(
              Or(Not(Index($v, 0)), Not(Member(Index($v, 0), "head"))),
              NotEquals(TypeOf(Index($v, 1)), "string")),
            Throw(New($Error, "With needs a record and field name")),
            Undefined()),
          Bind(
            $fields,
            Filter(
              Member(Index($v, 0), "args"),
              Lambda(List($a), NotEquals(Member($a, "name"), Index($v, 1))))),
          Call(Member($fields, "push"), Object(name=Index($v, 1), value=Index($v, 2))),
          Return(Object(head=Member(Index($v, 0), "head"), args=$fields)))))))

Concept(TextContains(),
  IsA(Capability()),
  Realization(TextContains($text, $part), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Includes(
          Call(Member(Call($String, Member(Index($args, 0), "value")), "toLowerCase")),
          Call(Member(Call($String, Member(Index($args, 1), "value")), "toLowerCase")))))))

Concept(CoordinateLabel(),
  IsA(Capability()),
  Realization(CoordinateLabel($square, $files, $firstRank), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
          Bind($x, OptionalMember(OptionalIndex(OptionalMember(Index($v, 0), "args"), 0), "value")),
          Bind($y, OptionalMember(OptionalIndex(OptionalMember(Index($v, 0), "args"), 1), "value")),
          Return(
            If(
              And(
                And(Call(Member($Number, "isInteger"), $x), Call(Member($Number, "isInteger"), $y)),
                Index(Index($v, 1), $x)),
              Add(Index(Index($v, 1), $x), Call($String, Add($y, Index($v, 2)))),
              "?")))))))

Concept(ElementAt(),
  IsA(Capability()),
  Realization(ElementAt($items, $index), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind(
            $list,
            Lambda(
              List($x),
              Sequence(
                If(
                  Or(Not($x), NotEquals(Member($x, "head"), "List")),
                  Throw(New($Error, "Expected List")),
                  Undefined()),
                Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value"))))))),
          Return(
            Otherwise(
              Index(Call($list, Member(Index($args, 0), "value")), Member(Index($args, 1), "value")),
              null)))))))

Concept(Last(),
  IsA(Capability()),
  Realization(Last($items), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind(
            $list,
            Lambda(
