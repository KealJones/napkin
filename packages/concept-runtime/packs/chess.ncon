Concept(Apply(),
  IsA(Capability()),
  Realization(Apply($callable, $arguments), context=Execution(),
    body=Code(
      ir=Async(
        Lambda(
          List($args, $bindings, $api),
          Sequence(
            Bind(
              $list,
              Lambda(
                List($x),
                Sequence(
                  If(
                    Or(Not($x), NotEquals(Member($x, "head"), "List")),
                    Throw(New($Error, "Expected List")),
                    Undefined()),
                  Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value"))))))),
            Bind($target, Member(Index($args, 0), "value")),
            If(
              Or(Not($target), Not(Member($target, "head"))),
              Throw(New($Error, "Apply needs a Concept")),
              Undefined()),
            Return(
              Await(
                Call(
                  Member($api, "evaluate"),
                  Object(
                    head=Member($target, "head"),
                    args=Concat(
                      Member($target, "args"),
                      Map(
                        Call($list, Member(Index($args, 1), "value")),
                        Lambda(List($value), Object(value=$value))))))))))))))

Concept(Same(),
  IsA(Capability()),
  Realization(Same($left, $right), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind(
            $canonical,
            Lambda(
              List($x),
              Sequence(
                If(
                  Or(Not($x), Not(Member($x, "head"))),
                  Return(Call(Member($JSON, "stringify"), $x)),
                  Undefined()),
                Bind(
                  $fields,
                  If(
                    Call(
                      Member(Member($x, "args"), "every"),
                      Lambda(List($a), NotEquals(Member($a, "name"), Undefined()))),
                    Call(
                      Member(Concat(Member($x, "args")), "sort"),
                      Lambda(
                        List($a, $b),
                        Call(Member(Member($a, "name"), "localeCompare"), Member($b, "name")))),
                    Member($x, "args"))),
                Return(
                  Add(
                    Add(
                      Add(Member($x, "head"), "("),
                      Call(
                        Member(
                          Map(
                            $fields,
                            Lambda(
                              List($a),
                              Add(
                                Add(Or(Member($a, "name"), ""), ":"),
                                Call($canonical, Member($a, "value"))))),
                          "join"),
                        ",")),
                    ")"))))),
          Return(
            Equals(
              Call($canonical, Member(Index($args, 0), "value")),
              Call($canonical, Member(Index($args, 1), "value")))))))))

Concept(Abs(),
  IsA(Capability()),
  Realization(Abs($value), context=Execution(),
    body=Code(
      ir=Lambda(
        List($args),
        Sequence(
          Bind($v, Map($args, Lambda(List($a), Member($a, "value")))),
          If(
            Call(
              Member($v, "some"),
              Lambda(
                List($x),
                Or(NotEquals(TypeOf($x), "number"), Not(Call(Member($Number, "isFinite"), $x))))),
            Throw(New($Error, "Expected finite numbers")),
            Undefined()),
          Bind($result, Call(Member($Math, "abs"), Index($v, 0))),
          If(
            And(Equals(TypeOf($result), "number"), Not(Call(Member($Number, "isFinite"), $result))),
            Throw(New($Error, "Nonfinite arithmetic result")),
            Undefined()),
          Return($result))))))

