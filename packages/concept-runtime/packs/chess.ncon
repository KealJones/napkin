              Sequence(
                If(
                  Or(Not($x), NotEquals(Member($x, "head"), "List")),
                  Throw(New($Error, "Expected List")),
                  Undefined()),
                Return(Map(Member($x, "args"), Lambda(List($a), Member($a, "value"))))))),
          Return(
            Otherwise(
              Call(Member(Call($list, Member(Index($args, 0), "value")), "at"), Negate(1)),
              null)))))))

Concept(DropLast(),
  IsA(Capability()),
  Realization(DropLast($items), context=Execution(),
    body=Code(
      ir=Lambda(
