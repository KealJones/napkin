// Frames: reading by senses and holes (src/frame/, design/frames.md). What the frames read off the
// graph that no other pack says. Written by scripts/pack.mjs from sources/frames (edit those, not
// this).
Requires(Core(), Basic())

// A whole statement, as a hole: what "remember" takes.
Concept(Statement(), IsA(Category()))

// Words whose hole is a statement: "remember (that) my name is Sam" keeps the statement.
Concept(Remember(), Takes(Statement()))

// A statement read and kept, as said. Held by whom it is about.
Concept(Stated(), IsA(Result()))

// A statement asked to be kept, kept.
Concept(Remembered(), IsA(Result()))

// What shape of answer each kind a question asks for takes is basic's (`AnsweredBy`).

// Words that report what someone said or thinks: their hole is a statement, and what it says is
// not asserted by the one speaking now. "I told them that 2 plus 2 was 5" checks the claim and
// keeps nothing as true.
Concept(Reports(), IsA(Relation()))

Concept(Tell(), Takes(Statement()), Reports())

Concept(Say(), Takes(Statement()), Reports())

Concept(Think(), Takes(Statement()), Reports())

// A statement someone reported, as they said it.
Concept(Reported(), IsA(Result()))

// "Do you mean A or B?": readings too close to choose between, each by what it would answer
// (Option(value, says=, features=)). The reply picks one, and its choices are confirmed.
Concept(ChooseOne(), IsA(Result()))

// Feedback on how messages were read, on Frames: Confirmed(feature), Corrected(feature), and the
// choices the last one was read with (LastRead). Weights are their stamps (src/frame/frames.ts).
Concept(Frames(), IsA(Category()))

// Where reading a message got stuck, said after "I don't know": the reading that came nearest
// (near="10 times 10"), the words it could not fit (left=List(...)), and the words it has nothing
// for (unknown=List(...)).
Concept(Stuck(), IsA(Result()))

// Words that say two things are the same, as "is" does in a claim: "is 10 times 10 equal to 100",
// "2 plus 2 equals 4", "is 3 times 3 the same as 9".
Concept(SaysSame(), IsA(Relation()))

Concept(Equal(), SaysSame())

Concept(Equals(), SaysSame())

Concept(Same(), SaysSame())

// Words that say what a word means ("bday means birthday"): what is said teaches how the word is
// written (`WrittenAs`), so it is read as the other from then on.
Concept(Defines(), IsA(Relation()))

Concept(Mean(), Defines(WrittenAs()))

Concept(Means(), Defines(WrittenAs()))

// "Do you mean Acme (ran company) or Boston (ran marathon)?": each reading by what it would answer,
// and what it is about where it says.
Concept(ChooseOne(),
  Realization(ChooseOne(Rest($options)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(
                      If(
                        Equals(TypeOf($r), "string"),
                        Call(Member($r, "replace"), Regex("[.!?]+$", ""), ""),
                        Call($String, $e)
                      )
                    )
                  )
                )
              )
            ),
            Bind($readable,
              Lambda(List($head),
                Call(
                  Member(
                    Call(
                      Member($head, "replace"),
                      Regex("([a-z0-9])([A-Z])", "g"),
                      "$1 $2"
                    ),
                    "toLowerCase"
                  )
                )
              )
            ),
            Bind($parts, List()),
            ForOf(
              $a,
              $args,
              Sequence(
                Bind($o, Member($a, "value")),
                If(
                  Or(Or(Not($o), Not(Member($o, "args"))), Not(Length(Member($o, "args")))),
                  Continue(),
                  Undefined()
                ),
                Bind($says,
                  Call(Member(Member($o, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), "says")))
                ),
                Bind($what, Await(Call($sayOf, Member(Index(Member($o, "args"), 0), "value")))),
                Call(
                  Member($parts, "push"),
                  If(
                    And(And($says, Member($says, "value")), Member(Member($says, "value"), "head")),
                    Add(Add(Add($what, " ("), Call($readable, Member(Member($says, "value"), "head"))), ")"),
                    $what
                  )
                )
              )
            ),
            If(
              LessThan(Length($parts), 2),
              Return("Which do you mean?"),
              Undefined()
            ),
            Return(
              Add(
                Add(
                  Add(
                    Add("Do you mean ", Call(Member(Call(Member($parts, "slice"), 0, Negate(1)), "join"), ", ")),
                    " or "
                  ),
                  Index($parts, Subtract(Length($parts), 1))
                ),
                "?"
              )
            )
          )
        )
      )
    )
  )
)

// "Got it, I'll remember that."
Concept(Remembered(),
  Realization(Remembered(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(ir = Async(Lambda(List($args, $bindings, $api), Return("Got it, I'll remember that."))))
  )
)

// Where reading a message got stuck: "I read 10 times 10, but couldn't fit "equal", "to" and "100"
// into it. I have nothing for "equal" yet."
Concept(Stuck(),
  Realization(Stuck(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($named,
              Lambda(List($n),
                Sequence(
                  Bind($a, Call(Member($args, "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($words,
              Lambda(List($list),
                If(
                  And($list, Member($list, "args")),
                  Map(Member($list, "args"), Lambda(List($a), Call($String, Member($a, "value")))),
                  List()
                )
              )
            ),
            Bind($quoted,
              Lambda(List($ws),
                Sequence(
                  Bind($q, Map($ws, Lambda(List($w), Add(Add("\"", $w), "\"")))),
                  Return(
                    If(
                      LessThan(Length($q), 2),
                      Call(Member($q, "join"), ""),
                      Add(
                        Add(Call(Member(Call(Member($q, "slice"), 0, Negate(1)), "join"), ", "), " and "),
                        Index($q, Subtract(Length($q), 1))
                      )
                    )
                  )
                )
              )
            ),
            Bind($near, Call($named, "near")),
            Bind($left, Call($words, Call($named, "left"))),
            Bind($unknown, Call($words, Call($named, "unknown"))),
            Bind($parts, List()),
            If(
              And(And(Equals(TypeOf($near), "string"), $near), Length($left)),
              If(
                Equals(Call($named, "as"), "thing"),
                Call(
                  Member($parts, "push"),
                  Add(
                    Add(Add(Add("I read it as saying ", $near), ", but couldn't tell what "), Call($quoted, $left)),
                    " is as one thing."
                  )
                ),
                Call(
                  Member($parts, "push"),
                  Add(Add(Add(Add("I read ", $near), ", but couldn't fit "), Call($quoted, $left)), " into it.")
                )
              ),
              Undefined()
            ),
            If(
              Length($unknown),
              Call(Member($parts, "push"), Add(Add("I have nothing for ", Call($quoted, $unknown)), " yet.")),
              Undefined()
            ),
            Return(
              If(
                Length($parts),
                Add("Where I got stuck: ", Call(Member($parts, "join"), " ")),
                ""
              )
            )
          )
        )
      )
    )
  )
)
