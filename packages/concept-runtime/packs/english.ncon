// A list said on its own, as words: "1, 3, 5 and 9."
Concept(List(),
  Realization(List(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($said,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(
                    Member($api, "call"),
                    "Words",
                    Call(
                      Member($api, "call"),
                      "List",
                      Spread(Map($args, Lambda(List($a), Member($a, "value"))))
                    )
                  ),
                  Call(Member($api, "call"), "Execution")
                )
              )
            ),
            Bind($t,
              If(
                Equals(TypeOf($said), "string"),
                Call(Member($said, "trim")),
                ""
              )
            ),
            Return(
              If(
                $t,
                Add(Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1)), "."),
                Call(
                  Member($api, "call"),
                  "List",
                  Spread(Map($args, Lambda(List($a), Member($a, "value"))))
                )
              )
            )
          )
        )
      )
    )
  )
)

// Things made, and what one holds (packs/holding.ncon), said.
// "Added milk and eggs to your shopping list."
Concept(Added(),
  Realization(Added($items, $to),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($words,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Words", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Comment("ShoppingList_1 is \"shopping list\": what it was made as."),
            Bind($called,
              Lambda(List($thing),
                Call(
                  Member(
                    Call(
                      Member(
                        Call(
                          Member(Call($String, Member($thing, "head")), "replace"),
                          Regex("_[0-9]+$", ""),
                          ""
                        ),
                        "replace"
                      ),
                      Regex("([a-z0-9])([A-Z])", "g"),
                      "$1 $2"
                    ),
                    "toLowerCase"
                  )
                )
              )
            ),
            Bind($article,
              Lambda(List($w),
                Add(
                  If(
                    Call(Member(Regex("^[aeiou]", ""), "test"), $w),
                    "an ",
                    "a "
                  ),
                  $w
                )
              )
            ),
            Return(
              Add(
                Add(
                  Add(Add("Added ", Await(Call($words, Call(Member($bindings, "get"), "items")))), " to your "),
                  Call($called, Call(Member($bindings, "get"), "to"))
                ),
                "."
              )
            )
          )
        )
      )
    )
  )
)

