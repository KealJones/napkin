Requires(
  Basic(),
  Pursue(),
  Predict(),
  Judge(),
  Plan(),
  Words(),
  Dialogue()
)

// ================================================================
// English, as one more language Concepts are written in (design/pursue-predict.md).
//
// The Mouth was a model asked to put a result into a sentence, and it said things the graph
// never worked out: that JavaScript was named after Monty Python, that the pilot knows what
// he is doing. Here every result Concept says itself, in the Speaking() context, the way a
// Concept compiles itself to JavaScript in JavaScript(). What has no wording here is not
// guessed at: it falls through to the plain wordings the host has, and only then to a model.

// Being said, as opposed to being worked out.
Concept(Speaking(), IsA(ContextFacet()))

// A Concept as the words it came from: names keep their capitals, "my" is "your" to the one
// spoken to, a List is "a, b and c", someone resolved is the name they hold.
Concept(Words(),
  Realization(Words($x),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($split,
              Lambda(List($h),
                Sequence(
                  Bind($parts, List()),
                  Var($w, ""),
                  Bind($up, Lambda(List($ch), And(AtLeast($ch, "A"), AtMost($ch, "Z")))),
                  For(
                    Var($i, 0),
                    LessThan($i, Length($h)),
                    PostIncrement($i),
                    Sequence(
                      Bind($ch, Index($h, $i)),
                      Bind($acronym,
                        And(
                          And(And($w, Call($up, Index($w, Subtract(Length($w), 1)))), Call($up, $ch)),
                          Not(And(LessThan(Add($i, 1), Length($h)), Not(Call($up, Index($h, Add($i, 1))))))
                        )
                      ),
                      If(
                        And(And(Call($up, $ch), $w), Not($acronym)),
                        Sequence(Call(Member($parts, "push"), $w), Assign($w, "")),
                        Undefined()
                      ),
                      Assign($w, Add($w, $ch))
                    )
                  ),
                  If($w, Call(Member($parts, "push"), $w), Undefined()),
                  Return($parts)
                )
              )
            ),
            Bind($spoken,
              Lambda(List($h),
                Sequence(
                  Bind($parts, Call($split, $h)),
                  Bind($name, Call(Member($parts, "some"), Lambda(List($p), Call(Member($api, "properNoun"), $p)))),
                  Return(
                    Call(
                      Member(
                        Map(
                          $parts,
                          Lambda(List($p),
                            If(
                              Or($name, And(GreaterThan(Length($p), 1), Equals($p, Call(Member($p, "toUpperCase"))))),
                              $p,
                              Call(Member($p, "toLowerCase"))
                            )
                          )
                        ),
                        "join"
                      ),
                      " "
                    )
                  )
                )
              )
            ),
            Bind($OWN, Object(My = "your", Your = "my", Our = "our")),
            Bind($PERSON,
              Object(
                Me = "you",
                Self = "I",
                You = "me",
                Myself = "yourself",
                Yourself = "myself"
              )
            ),
            Bind($number,
              Lambda(List($n),
                If(
                  Call(Member($Number, "isInteger"), $n),
                  Call($String, $n),
                  Call($String, Call($Number, Call(Member($n, "toFixed"), 4)))
                )
              )
            ),
            Bind($list,
              Lambda(List($xs),
                If(
                  LessThan(Length($xs), 2),
                  Or(Index($xs, 0), ""),
                  Add(
                    Add(Call(Member(Call(Member($xs, "slice"), 0, Negate(1)), "join"), ", "), " and "),
                    Index($xs, Subtract(Length($xs), 1))
                  )
                )
              )
            ),
            Bind($say,
              Async(
                Lambda(List($e),
                  Sequence(
                    If(Equals(TypeOf($e), "string"), Return($e), Undefined()),
                    If(
                      Equals(TypeOf($e), "number"),
                      Return(Call($number, $e)),
                      Undefined()
                    ),
                    If(
                      Equals(TypeOf($e), "boolean"),
                      Return(If($e, "yes", "no")),
                      Undefined()
                    ),
                    If(Not(Call($isCall, $e)), Return(""), Undefined()),
                    Bind($positional,
                      Map(
                        Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                        Lambda(List($a), Member($a, "value"))
                      )
                    ),
                    If(
                      Equals(Member($e, "head"), "List"),
                      Return(Call($list, Await(Call(Member($Promise, "all"), Map($positional, $say))))),
                      Undefined()
                    ),
                    Bind($kinds,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(
                            Member($api, "call"),
                            "Closure",
                            Member($e, "head"),
                            "IsA"
                          ),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Bind($kindOf,
                      Lambda(List($k),
                        And(
                          Call($isCall, $kinds),
                          Call(
                            Member(Member($kinds, "args"), "some"),
                            Lambda(List($a),
                              And(Call($isCall, Member($a, "value")), Equals(Member(Member($a, "value"), "head"), $k))
                            )
                          )
                        )
                      )
                    ),
                    Comment("Structure is said as what it holds; a word that is also structure (\"of\") is still said."),
                    If(
                      And(Call($kindOf, "Marker"), Not(Call($kindOf, "WordClass"))),
                      Return(Call(Member(Await(Call(Member($Promise, "all"), Map($positional, $say))), "join"), " ")),
                      Undefined()
                    ),
                    Bind($to,
                      Call(
                        Member(Member($e, "args"), "find"),
                        Lambda(List($a), Equals(Member($a, "name"), "resolvedTo"))
                      )
                    ),
                    If(
                      And($to, Call($isCall, Member($to, "value"))),
                      Sequence(
                        Bind($unit, Call(Member(Member($api, "store"), "get"), Member(Member($to, "value"), "head"))),
                        Bind($named,
                          If(
                            $unit,
                            Call(
                              Member(Map(Member($unit, "relations"), Lambda(List($r), Member($r, "claim"))), "find"),
                              Lambda(List($c), And(Call($isCall, $c), Equals(Member($c, "head"), "Named")))
                            ),
                            Undefined()
                          )
                        ),
                        If(
                          And($named, Equals(TypeOf(Member(Index(Member($named, "args"), 0), "value")), "string")),
                          Return(Member(Index(Member($named, "args"), 0), "value")),
                          Undefined()
                        )
                      ),
                      Undefined()
                    ),
                    If(
                      Not(Length($positional)),
                      Sequence(
                        If(
                          Index($PERSON, Member($e, "head")),
                          Return(Index($PERSON, Member($e, "head"))),
                          Undefined()
                        ),
                        Bind($unit, Call(Member(Member($api, "store"), "get"), Member($e, "head"))),
                        Bind($named,
                          If(
                            $unit,
                            Call(
                              Member(Map(Member($unit, "relations"), Lambda(List($r), Member($r, "claim"))), "find"),
                              Lambda(List($c), And(Call($isCall, $c), Equals(Member($c, "head"), "Named")))
                            ),
                            Undefined()
                          )
                        ),
                        If(
                          And(
                            And($named, Equals(TypeOf(Member(Index(Member($named, "args"), 0), "value")), "string")),
                            NotEquals(Member($e, "head"), "Me")
                          ),
                          Return(Member(Index(Member($named, "args"), 0), "value")),
                          Undefined()
                        ),
                        Return(Call($spoken, Member($e, "head")))
                      ),
                      Undefined()
                    ),
                    If(
                      Index($OWN, Member($e, "head")),
                      Sequence(
                        Bind($chain, List()),
                        Var($at, Index($positional, 0)),
                        While(
                          And(
                            And(
                              And(
                                Call($isCall, $at),
                                Equals(
                                  Length(
                                    Filter(
                                      Member($at, "args"),
                                      Lambda(List($a), Equals(Member($a, "name"), Undefined()))
                                    )
                                  ),
                                  1
                                )
                              ),
                              Call($isCall, Member(Index(Member($at, "args"), 0), "value"))
                            ),
                            Not(Index($OWN, Member($at, "head")))
                          ),
                          Sequence(
                            Call(Member($chain, "push"), Call($spoken, Member($at, "head"))),
                            Assign($at, Member(Index(Member($at, "args"), 0), "value"))
                          )
                        ),
                        If(
                          And(And(Call($isCall, $at), Not(Length(Member($at, "args")))), Length($chain)),
                          Return(
                            Add(
                              Add(Index($OWN, Member($e, "head")), " "),
                              Call(
                                Member(
                                  Call(
                                    Member(Concat($chain, List(Call($spoken, Member($at, "head")))), "map"),
                                    Lambda(List($w, $i, $all),
                                      If(
                                        LessThan($i, Subtract(Length($all), 1)),
                                        Add($w, "'s"),
                                        $w
                                      )
                                    )
                                  ),
                                  "join"
                                ),
                                " "
                              )
                            )
                          ),
                          Undefined()
                        ),
                        Return(
                          Add(
                            Add(Index($OWN, Member($e, "head")), " "),
                            Call(Member(Await(Call(Member($Promise, "all"), Map($positional, $say))), "join"), " ")
                          )
                        )
                      ),
                      Undefined()
                    ),
                    Comment("A count of a plural noun is said count first: Days(89) is \"89 days\"."),
                    Comment("A thing described is said as it was heard: Cheese(Parmesan()) is \"parmesan cheese\" (a"),
                    Comment("doing is not: Need(Milk()) is \"need milk\")."),
                    Bind($noun,
                      Lambda(List($w),
                        Sequence(
                          Bind($tags,
                            Otherwise(OptionalMember(Index(Call(Member($api, "words"), $w), 0), "tags"), List())
                          ),
                          Return(And(Includes($tags, "Noun"), Not(Includes($tags, "Verb"))))
                        )
                      )
                    ),
                    If(
                      And(
                        And(
                          And(
                            Length($positional),
                            Call(
                              Member($positional, "every"),
                              Lambda(List($p), And(Call($isCall, $p), Not(Length(Member($p, "args")))))
                            )
                          ),
                          Call(
                            Member(Member($e, "args"), "every"),
                            Lambda(List($a), Equals(Member($a, "name"), Undefined()))
                          )
                        ),
                        Call($noun, Call($spoken, Member($e, "head")))
                      ),
                      Sequence(
                        Bind($phrase, Await(Call(Member($api, "sayPhrase"), $e))),
                        If($phrase, Return($phrase), Undefined())
                      ),
                      Undefined()
                    ),
                    Bind($word, Call($spoken, Member($e, "head"))),
                    If(
                      And(
                        And(
                          And(Equals(Length($positional), 1), Equals(TypeOf(Index($positional, 0)), "number")),
                          Not(Includes($word, " "))
                        ),
                        NotEquals(Call(Member($api, "lemma"), $word), $word)
                      ),
                      Return(Add(Add(Call($number, Index($positional, 0)), " "), $word)),
                      Undefined()
                    ),
                    Return(
                      Call(
                        Member(
                          Concat(List($word), Await(Call(Member($Promise, "all"), Map($positional, $say)))),
                          "join"
                        ),
                        " "
                      )
                    )
                  )
                )
              )
            ),
            Return(Call($say, Member(Index($args, 0), "value")))
          )
        )
      )
    )
  )
)

// Said by its own realization when it has one, and as its words when it does not.
Concept(Say(),
  Realization(Say($x),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($said,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Member(Index($args, 0), "value"),
                  Call(Member($api, "call"), "Speaking")
                )
              )
            ),
            If(
              Equals(TypeOf($said), "string"),
              Return($said),
              Undefined()
            ),
            Return(
              Call(
                Member($api, "evaluate"),
                Call(
                  Member($api, "call"),
                  "Words",
                  Member(Index($args, 0), "value")
                ),
                Call(Member($api, "call"), "Execution")
              )
            )
          )
        )
      )
    )
  )
)

// The turn's hook for a graph-written reply (runtime/turn.ts): the result, said.
Concept(RenderResponse(),
  Realization(RenderResponse($result),
    context = Execution(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($said,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Member(Index($args, 0), "value"),
                  Call(Member($api, "call"), "Speaking")
                )
              )
            ),
            Return(
              If(
                Equals(TypeOf($said), "string"),
                $said,
                Call(
                  Member($api, "call"),
                  "RenderResponse",
                  Member(Index($args, 0), "value")
                )
              )
            )
          )
        )
      )
    )
  )
)

// An answer is what it answers with, as a sentence. A record (a time, a date) is left to its own wording.
Concept(Answer(),
  // A literal answer (a word, a number said back) is sentence-cased and said as is.
  Realization(Answer($lit),
    context = Speaking(),
    evaluateArguments = false,
    types = Types(lit = OneOf(String(), Number())),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($x, Member(Index($args, 0), "value")),
            Return(Call($sentence, Await(Call($sayOf, $x))))
          )
        )
      )
    )
  ),
  // Anything else is a call: try its own Speaking(), fall to the whole call handed over, then to Say.
  Realization(Answer($x),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($x, Member(Index($args, 0), "value")),
            If(
              Not(Call($isCall, $x)),
              Return(Call(Member($api, "call"), "Answer", $x)),
              Undefined()
            ),
            Bind($own,
              Await(
                Call(
                  Member($api, "evaluate"),
                  $x,
                  Call(Member($api, "call"), "Speaking")
                )
              )
            ),
            If(
              Equals(TypeOf($own), "string"),
              Return($own),
              Undefined()
            ),
            If(
              And(
                Length(Member($x, "args")),
                Call(Member(Member($x, "args"), "every"), Lambda(List($a), NotEquals(Member($a, "name"), Undefined())))
              ),
              Return(Call(Member($api, "call"), "Answer", $x)),
              Undefined()
            ),
            Return(Or(Call($sentence, Await(Call($sayOf, $x))), "I'm not sure what you're asking."))
          )
        )
      )
    )
  )
)

Concept(Unknown(),
  Realization(Unknown(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($named,
              Lambda(List($e, $n),
                Sequence(
                  Bind($a, Call(Member(Member($e, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind($x,
              If(
                Length($args),
                Member(Index($args, 0), "value"),
                Undefined()
              )
            ),
            If(
              Equals($x, Undefined()),
              Return("I don't know that yet."),
              Undefined()
            ),
            Return(Add(Add("I don't know ", Await(Call($sayOf, $x))), " yet."))
          )
        )
      )
    )
  )
)

Concept(NoDescription(),
  Realization(NoDescription($x),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($named,
              Lambda(List($e, $n),
                Sequence(
                  Bind($a, Call(Member(Member($e, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Return(
              Add(Add("I don't know anything about ", Await(Call($sayOf, Member(Index($args, 0), "value")))), " yet.")
            )
          )
        )
      )
    )
  )
)

// A statement: answered by its reply when it has one, acknowledged when not.
Concept(Noted(),
  Realization(Noted(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($named,
              Lambda(List($e, $n),
                Sequence(
                  Bind($a, Call(Member(Member($e, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind($call, Object(head = "Noted", args = $args)),
            Bind($reply, Call($named, $call, "reply")),
            If(
              NotEquals($reply, Undefined()),
              Return(Call($sayOf, $reply)),
              Undefined()
            ),
            Return("Got it.")
          )
        )
      )
    )
  )
)

// A reply close to what was said is said as a person said it; otherwise by the feeling heard and what the reply does.
Concept(Reply(),
  Realization(Reply(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($named,
              Lambda(List($e, $n),
                Sequence(
                  Bind($a, Call(Member(Member($e, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind($call, Object(head = "Reply", args = $args)),
            Bind($like, Call($named, $call, "like")),
            If(
              And(NotEquals(Call($named, $call, "close"), Undefined()), Equals(TypeOf($like), "string")),
              Return(
                Call(
                  Member(
                    Call(
                      Member(
                        Call(
                          Member(
                            Call(
                              Member($like, "replace"),
                              Regex("\\s+([.,!?;:'’])", "g"),
                              "$1"
                            ),
                            "replace"
                          ),
                          Regex("([’'])\\s+", "g"),
                          "$1"
                        ),
                        "replace"
                      ),
                      Regex("\\s+", "g"),
                      " "
                    ),
                    "trim"
                  )
                )
              ),
              Undefined()
            ),
            Bind($heard, Call($named, $call, "heard")),
            Bind($feeling,
              If(
                Call($isCall, $heard),
                Index(Call($positional, $heard), 1),
                Undefined()
              )
            ),
            Bind($act, Index(Call($positional, $call), 0)),
            Bind($parts, List()),
            If(
              Call($isCall, $feeling),
              Sequence(
                Bind($f,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      $feeling,
                      Call(Member($api, "call"), "Speaking")
                    )
                  )
                ),
                If(
                  And(Equals(TypeOf($f), "string"), $f),
                  Call(Member($parts, "push"), $f),
                  Undefined()
                )
              ),
              Undefined()
            ),
            If(
              Call($isCall, $act),
              Sequence(
                Bind($a,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      $act,
                      Call(Member($api, "call"), "Speaking")
                    )
                  )
                ),
                If(
                  And(Equals(TypeOf($a), "string"), $a),
                  Call(Member($parts, "push"), $a),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Return(
              If(
                Length($parts),
                Call(Member($parts, "join"), " "),
                "I see."
              )
            )
          )
        )
      )
    )
  )
)

// What is known of something: its name, what it is a kind of, and the rest.
Concept(Describes(),
  Realization(Describes($thing, $facts),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($named,
              Lambda(List($e, $n),
                Sequence(
                  Bind($a, Call(Member(Member($e, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind($thing, Member(Index($args, 0), "value")),
            Bind($facts, Member(Index($args, 1), "value")),
            If(
              Call($isCall, $thing),
              Sequence(
                Bind($refers,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Call(
                        Member($api, "call"),
                        "Closure",
                        Member($thing, "head"),
                        "Refers"
                      ),
                      Call(Member($api, "call"), "Execution")
                    )
                  )
                ),
                If(
                  And(
                    And(Call($isCall, $refers), Equals(Member($refers, "head"), "List")),
                    Length(Member($refers, "args"))
                  ),
                  Sequence(
                    Bind($about,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "About", $thing),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    If(
                      And(
                        And(Call($isCall, $about), Equals(Member($about, "head"), "Describes")),
                        NotEquals(
                          Call(Member($api, "format"), Member(Index(Member($about, "args"), 0), "value")),
                          Call(Member($api, "format"), $thing)
                        )
                      ),
                      Return(Call($sayOf, $about)),
                      Undefined()
                    ),
                    Return(
                      If(
                        Or(Equals(Member($thing, "head"), "Me"), Equals(Member($thing, "head"), "Myself")),
                        "I don't know much about you yet.",
                        "I don't know much about that yet."
                      )
                    )
                  ),
                  Undefined()
                )
              ),
              Undefined()
            ),
            Bind($items,
              If(
                And(Call($isCall, $facts), Equals(Member($facts, "head"), "List")),
                Call($positional, $facts),
                List()
              )
            ),
            Bind($subject, Await(Call($sayOf, $thing))),
            Bind($verb,
              If(
                Equals($subject, "I"),
                "am",
                If(Equals($subject, "you"), "are", "is")
              )
            ),
            Bind($kinds, List()),
            Bind($other, List()),
            Var($name, Undefined()),
            ForOf(
              $item,
              $items,
              Sequence(
                Bind($f,
                  If(
                    And(
                      And(Call($isCall, $item), Equals(Member($item, "head"), "Mentioned")),
                      Call($isCall, OptionalMember(Index(Member($item, "args"), 0), "value"))
                    ),
                    Member(Index(Member($item, "args"), 0), "value"),
                    $item
                  )
                ),
                If(Not(Call($isCall, $f)), Continue(), Undefined()),
                Bind(List($v), Call($positional, $f)),
                If(
                  And(Equals(Member($f, "head"), "Named"), Equals(TypeOf($v), "string")),
                  Assign($name, $v),
                  If(
                    Or(Equals(Member($f, "head"), "IsA"), Equals(Member($f, "head"), "SubclassOf")),
                    Sequence(
                      Bind($w, Await(Call($sayOf, $v))),
                      Bind($acronym, Call(Member(Regex("^[A-Z]{2}", ""), "test"), $w)),
                      Call(
                        Member($kinds, "push"),
                        Add(
                          If(
                            If(
                              $acronym,
                              Call(Member(Regex("^[AEFHILMNORSX]", ""), "test"), $w),
                              Call(Member(Regex("^[aeiou]", "i"), "test"), $w)
                            ),
                            "an ",
                            "a "
                          ),
                          $w
                        )
                      )
                    ),
                    Call(
                      Member($other, "push"),
                      Add(
                        Add(Await(Call($sayOf, Call(Member($api, "call"), Member($f, "head")))), " "),
                        Await(Call($sayOf, $v))
                      )
                    )
                  )
                )
              )
            ),
            Comment("What it is in words (a description: \"semi-aquatic egg-laying mammal endemic to Australia\")"),
            Comment("is said first, as what it is; the kinds it names are that already, and what it is told apart"),
            Comment("from is for telling senses apart, not for saying what it is."),
            Bind($means,
              Call(
                Member($items, "find"),
                Lambda(List($f),
                  And(
                    And(Call($isCall, $f), Equals(Member($f, "head"), "Means")),
                    Equals(TypeOf(Index(Call($positional, $f), 0)), "string")
                  )
                )
              )
            ),
            If(
              $means,
              Sequence(
                Bind($words, Call($String, Index(Call($positional, $means), 0))),
                Bind($an,
                  Lambda(List($w),
                    If(
                      Call(Member(Regex("^(a|an|the)\\s", "i"), "test"), $w),
                      $w,
                      Add(
                        If(
                          Call(Member(Regex("^[aeiou]", "i"), "test"), $w),
                          "an ",
                          "a "
                        ),
                        $w
                      )
                    )
                  )
                ),
                Bind($proper,
                  Or(NotEquals($subject, Call(Member($subject, "toLowerCase"))), NotEquals($name, Undefined()))
                ),
                Bind($head,
                  Add(
                    Add(
                      Add(
                        Add(
                          If(
                            Or(Or($proper, Equals($subject, "I")), Equals($subject, "you")),
                            $subject,
                            Call($an, $subject)
                          ),
                          " "
                        ),
                        $verb
                      ),
                      " "
                    ),
                    Call($an, $words)
                  )
                ),
                Bind($rest, List()),
                Bind($seen, New($Set)),
                Bind($own, New($Set, Call(Member(Call(Member($subject, "toLowerCase")), "split"), Regex("\\s+", "")))),
                Comment("Beside what it is: what others hold of it (Jaws holds that he directed it), not the"),
                Comment("long tail of what it holds, which is there for questions."),
                ForOf(
                  $m,
                  $items,
                  Sequence(
                    If(
                      Or(
                        Or(Not(Call($isCall, $m)), NotEquals(Member($m, "head"), "Mentioned")),
                        Not(Call($isCall, OptionalMember(Index(Member($m, "args"), 0), "value")))
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Bind($f, Member(Index(Member($m, "args"), 0), "value")),
                    If(
                      Call(Member($seen, "has"), Member($f, "head")),
                      Continue(),
                      Undefined()
                    ),
                    Bind(List($v), Call($positional, $f)),
                    Bind($said, If(Equals($v, Undefined()), "", Await(Call($sayOf, $v)))),
                    Comment(
                      "What only repeats its name (\"given name Steven\") says nothing new; one of each kind of fact."
                    ),
                    If(
                      And(
                        $said,
                        Call(
                          Member(Call(Member(Call(Member($said, "toLowerCase")), "split"), Regex("\\s+", "")), "every"),
                          Lambda(List($w), Call(Member($own, "has"), $w))
                        )
                      ),
                      Continue(),
                      Undefined()
                    ),
                    Call(Member($seen, "add"), Member($f, "head")),
                    Comment(
                      "A fact whose value is a phrase (Director(Of(Jaws()))) is said whole: \"director of Jaws\"."
                    ),
                    Call(
                      Member($rest, "push"),
                      If(
                        Or(Equals($v, Undefined()), And(Call($isCall, $v), Length(Member($v, "args")))),
                        Await(Call($sayOf, $f)),
                        Add(Add(Await(Call($sayOf, Call(Member($api, "call"), Member($f, "head")))), " "), $said)
                      )
                    )
                  )
                ),
                Return(
                  Add(
                    Call($sentence, $head),
                    If(
                      Length($rest),
                      Add(" ", Call($sentence, Call(Member(Call(Member($rest, "slice"), 0, 3), "join"), ", "))),
                      ""
                    )
                  )
                )
              ),
              Undefined()
            ),
            Bind($parts, List()),
            If(
              And($name, NotEquals($name, $subject)),
              Call(Member($parts, "push"), Add(If(Equals($subject, "I"), "I'm ", Add($subject, " is ")), $name)),
              Undefined()
            ),
            If(
              Length($kinds),
              Call(
                Member($parts, "push"),
                Add(
                  If(
                    Length($parts),
                    "",
                    Add(Add(Add($subject, " "), $verb), " ")
                  ),
                  Call(Member($kinds, "join"), ", ")
                )
              ),
              Undefined()
            ),
            If(
              Length($other),
              Call(Member($parts, "push"), Call(Member($other, "join"), ", ")),
              Undefined()
            ),
            Return(
              If(
                Length($parts),
                Call($sentence, Call(Member($parts, "join"), ", ")),
                Add(Add("I don't know anything about ", $subject), " yet.")
              )
            )
          )
        )
      )
    )
  )
)

// The value, and the rule that gave it, the operation by its own shorter word.
Concept(Predicted(),
  Realization(Predicted($value, $rule),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($named,
              Lambda(List($e, $n),
                Sequence(
                  Bind($a, Call(Member(Member($e, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind($value, Member(Index($args, 0), "value")),
            Bind($rule, Member(Index($args, 1), "value")),
            Bind($v, Await(Call($sayOf, $value))),
            If(
              Not(Call($isCall, $rule)),
              Return(Call($sentence, $v)),
              Undefined()
            ),
            Bind($op, Await(Call($sayOf, Call(Member($api, "call"), Member($rule, "head"))))),
            Bind(List($a, $b), Call($positional, $rule)),
            Return(
              Call(
                $sentence,
                Add(
                  Add(Add(Add(Add(Add($v, ": each one is "), Await(Call($sayOf, $a))), " "), $op), " "),
                  Await(Call($sayOf, $b))
                )
              )
            )
          )
        )
      )
    )
  )
)

// Both are that kind; if you want this, that one. Never picks unless it leans.
Concept(Judged(),
  // Couldn't compare: not the same kind of thing.
  Realization(Judged($options, NoCommonKind(), Rest($rest)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind($options, Member(Index($args, 0), "value")),
            Bind($opts,
              If(
                Call($isCall, $options),
                Call($positional, $options),
                List()
              )
            ),
            Bind($names, Await(Call(Member($Promise, "all"), Map($opts, $sayOf)))),
            Return(
              Add(
                Add("I couldn't find ", Call(Member($names, "join"), " and ")),
                " as two of the same kind of thing, so I can't compare them yet."
              )
            )
          )
        )
      )
    )
  ),
  Realization(Judged($options, $kind, Rest($rest)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($named,
              Lambda(List($e, $n),
                Sequence(
                  Bind($a, Call(Member(Member($e, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind(List($options, $kind, Spread($rest)), Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($opts,
              If(
                Call($isCall, $options),
                Call($positional, $options),
                List()
              )
            ),
            Bind($names, Await(Call(Member($Promise, "all"), Map($opts, $sayOf)))),
            Bind($kinds, If(Call($isCall, $kind), Call($positional, $kind), List())),
            Bind($out, List()),
            If(
              Length($kinds),
              Call(
                Member($out, "push"),
                Call(
                  $sentence,
                  Add("Both are kinds of ", Await(Call($sayOf, Index($kinds, Subtract(Length($kinds), 1)))))
                )
              ),
              Undefined()
            ),
            Bind($wants, List()),
            ForOf(
              $r,
              $rest,
              Sequence(
                If(
                  Or(Not(Call($isCall, $r)), NotEquals(Member($r, "head"), "IfYouWant")),
                  Continue(),
                  Undefined()
                ),
                Bind(List($option, $reasons), Call($positional, $r)),
                Bind($why, List()),
                ForOf(
                  $x,
                  If(
                    Call($isCall, $reasons),
                    Call(Member(Call($positional, $reasons), "slice"), 0, 2),
                    List()
                  ),
                  Sequence(
                    If(Not(Call($isCall, $x)), Continue(), Undefined()),
                    Bind(List($p, Spread($vs)), Call($positional, $x)),
                    Bind($WAY,
                      Object(
                        More = "a higher ",
                        Less = "a lower ",
                        Earlier = "an earlier ",
                        Later = "a later "
                      )
                    ),
                    If(
                      Index($WAY, Member($x, "head")),
                      Call(Member($why, "push"), Add(Index($WAY, Member($x, "head")), $p)),
                      Call(
                        Member($why, "push"),
                        Add(If(Equals(TypeOf($p), "string"), Add($p, " "), ""), Call(Member($vs, "join"), " or "))
                      )
                    )
                  )
                ),
                If(
                  Length($why),
                  Call(
                    Member($wants, "push"),
                    Add(
                      Add(Add("if you want ", Call(Member($why, "join"), " and ")), ", "),
                      Await(Call($sayOf, $option))
                    )
                  ),
                  Undefined()
                )
              )
            ),
            If(
              Length($wants),
              Call(Member($out, "push"), Call($sentence, Call(Member($wants, "join"), "; "))),
              Undefined()
            ),
            Bind($lean,
              Call(Member($rest, "find"), Lambda(List($r), And(Call($isCall, $r), Equals(Member($r, "head"), "Leans"))))
            ),
            If(
              $lean,
              Call(
                Member($out, "push"),
                Call(
                  $sentence,
                  Add(Await(Call($sayOf, Index(Call($positional, $lean), 0))), " is the better known of the two")
                )
              ),
              Undefined()
            ),
            Return(Or(Call(Member($out, "join"), " "), Call($sentence, Call(Member($names, "join"), " or "))))
          )
        )
      )
    )
  )
)

Concept(Lacks(),
  Realization(Lacks($plan, $items, Rest($rest)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($named,
              Lambda(List($e, $n),
                Sequence(
                  Bind($a, Call(Member(Member($e, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind($items,
              If(
                Call($isCall, Member(Index($args, 1), "value")),
                Call($positional, Member(Index($args, 1), "value")),
                List()
              )
            ),
            If(
              Not(Length($items)),
              Return("I couldn't find anything your plan is missing."),
              Undefined()
            ),
            Bind($clean,
              Map(
                $items,
                Lambda(List($t),
                  Call(
                    Member(Call($String, $t), "replace"),
                    Regex("[.;]+$", ""),
                    ""
                  )
                )
              )
            ),
            Return(
              Add(Add("Checklists for plans like that usually also have: ", Call(Member($clean, "join"), "; ")), ".")
            )
          )
        )
      )
    )
  )
)

Concept(Meaning(),
  // Nothing found to say (a hint like Verb() stood in for the text): hand the call back unchanged.
  Realization(Meaning(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Return(
            Call(
              Member($api, "call"),
              "Meaning",
              Spread(Map($args, Lambda(List($a), Member($a, "value"))))
            )
          )
        )
      )
    )
  ),
  // A found meaning: word, its text, and how it was found (as=, from=).
  Realization(Meaning($word, $text, Rest($named)),
    context = Speaking(),
    evaluateArguments = false,
    types = Types(text = String()),
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($named,
              Lambda(List($n),
                Sequence(
                  Bind($a, Call(Member($args, "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($word, Member(Index($args, 0), "value")),
            Bind($text, Member(Index($args, 1), "value")),
            Bind($from, Call($named, "from")),
            Bind($w, Call(Member(Await(Call($sayOf, $word)), "toLowerCase"))),
            Bind($body, Call(Member($text, "replace"), Regex("[.\\s]+$", ""), "")),
            If(
              And(Call($isCall, $from), Equals(Member($from, "head"), "Said")),
              Return(Add(Add(Add(Add("You told me ", $w), " means "), $body), ".")),
              Undefined()
            ),
            Return(
              Call(
                $sentence,
                Add(
                  Add(Add(Add("\"", $w), "\" means: "), Call(Member(Index($body, 0), "toLowerCase"))),
                  Call(Member($body, "slice"), 1)
                )
              )
            )
          )
        )
      )
    )
  )
)

// Several answers, said in order. A statement beside an answer is not said back.
Concept(Sequence(),
  Realization(Sequence(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($named,
              Lambda(List($e, $n),
                Sequence(
                  Bind($a, Call(Member(Member($e, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind($parts, List()),
            ForOf(
              $a,
              $args,
              Sequence(
                If(
                  And(
                    And(Call($isCall, Member($a, "value")), Equals(Member(Member($a, "value"), "head"), "Noted")),
                    Call(
                      Member($args, "some"),
                      Lambda(List($b),
                        And(Call($isCall, Member($b, "value")), Equals(Member(Member($b, "value"), "head"), "Answer"))
                      )
                    )
                  ),
                  Continue(),
                  Undefined()
                ),
                Bind($s,
                  Await(
                    Call(
                      Member($api, "evaluate"),
                      Member($a, "value"),
                      Call(Member($api, "call"), "Speaking")
                    )
                  )
                ),
                If(
                  NotEquals(TypeOf($s), "string"),
                  Return(
                    Call(
                      Member($api, "call"),
                      "Sequence",
                      Spread(Map($args, Lambda(List($x), Member($x, "value"))))
                    )
                  ),
                  Undefined()
                ),
                If(
                  And($s, Not(Includes($parts, $s))),
                  Call(Member($parts, "push"), $s),
                  Undefined()
                )
              )
            ),
            Return(Call(Member($parts, "join"), " "))
          )
        )
      )
    )
  )
)

// Something set aside, said alone: answered as the word it is ("lol", laughing), or not at all.
Concept(MarkAside(),
  Realization(MarkAside($text),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($isCall, Lambda(List($e), And(And(NotEquals($e, null), Equals(TypeOf($e), "object")), In("head", $e)))),
            Bind($sayOf,
              Async(
                Lambda(List($e),
                  Sequence(
                    Bind($r,
                      Await(
                        Call(
                          Member($api, "evaluate"),
                          Call(Member($api, "call"), "Say", $e),
                          Call(Member($api, "call"), "Execution")
                        )
                      )
                    ),
                    Return(If(Equals(TypeOf($r), "string"), $r, ""))
                  )
                )
              )
            ),
            Bind($sentence,
              Lambda(List($s),
                Sequence(
                  Bind($t, Call(Member(Call($String, $s), "trim"))),
                  If(Not($t), Return(""), Undefined()),
                  Bind($up, Add(Call(Member(Index($t, 0), "toUpperCase")), Call(Member($t, "slice"), 1))),
                  Return(
                    If(
                      Call(Member(Regex("[.!?]$", ""), "test"), $up),
                      $up,
                      Add($up, ".")
                    )
                  )
                )
              )
            ),
            Bind($named,
              Lambda(List($e, $n),
                Sequence(
                  Bind($a, Call(Member(Member($e, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind($text, Member(Index($args, 0), "value")),
            If(
              NotEquals(TypeOf($text), "string"),
              Return(""),
              Undefined()
            ),
            Var($head, ""),
            Var($up, true),
            ForOf(
              $ch,
              Call(Member($text, "toLowerCase")),
              If(
                And(AtLeast($ch, "a"), AtMost($ch, "z")),
                Sequence(Assign($head, Add($head, If($up, Call(Member($ch, "toUpperCase")), $ch))), Assign($up, false)),
                Assign($up, true)
              )
            ),
            If(
              Or(Not($head), Not(Call(Member(Member($api, "store"), "get"), $head))),
              Return(""),
              Undefined()
            ),
            Bind($done,
              Await(
                Call(
                  Member($api, "evaluate"),
                  Call(Member($api, "call"), $head),
                  Call(Member($api, "call"), "Execution")
                )
              )
            ),
            If(
              Or(Not(Call($isCall, $done)), Equals(Member($done, "head"), $head)),
              Return(""),
              Undefined()
            ),
            Bind($said,
              Await(
                Call(
                  Member($api, "evaluate"),
                  $done,
                  Call(Member($api, "call"), "Speaking")
                )
              )
            ),
            Return(If(Equals(TypeOf($said), "string"), $said, ""))
          )
        )
      )
    )
  )
)

// Words that could not be read, said back as not caught.
Concept(Unclear(),
  Realization(Unclear(Rest($x)),
    context = Speaking(),
    evaluateArguments = false,
    body = Code(
      ir = Async(
        Lambda(List($args, $bindings, $api),
          Sequence(
            Bind($text, Member(Index($args, 0), "value")),
            Return(
              If(
                And(Equals(TypeOf($text), "string"), Call(Member($text, "trim"))),
                Add(Add("I didn't catch \"", Call(Member($text, "trim"))), "\"."),
                "I didn't catch that."
              )
            )
          )
        )
      )
    )
  )
)

