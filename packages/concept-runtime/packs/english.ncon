                Sequence(
                  Bind($a, Call(Member(Member($e, "args"), "find"), Lambda(List($x), Equals(Member($x, "name"), $n)))),
                  Return(If($a, Member($a, "value"), Undefined()))
                )
              )
            ),
            Bind($positional,
              Lambda(List($e),
                Map(
                  Filter(Member($e, "args"), Lambda(List($a), Equals(Member($a, "name"), Undefined()))),
                  Lambda(List($a), Member($a, "value"))
                )
              )
            ),
            Bind(List($options, $kind, Spread($rest)), Map($args, Lambda(List($a), Member($a, "value")))),
            Bind($opts,
              If(
                Call($isCall, $options),
                Call($positional, $options),
                List()
              )
            ),
            Bind($names, Await(Call(Member($Promise, "all"), Map($opts, $sayOf)))),
            If(
              And(Call($isCall, $kind), Equals(Member($kind, "head"), "NoCommonKind")),
              Return(
                Add(
                  Add("I couldn't find ", Call(Member($names, "join"), " and ")),
                  " as two of the same kind of thing, so I can't compare them yet."
                )
              ),
              Undefined()
            ),
            Bind($kinds, If(Call($isCall, $kind), Call($positional, $kind), List())),
            Bind($out, List()),
            If(
              Length($kinds),
              Call(
                Member($out, "push"),
                Call(
                  $sentence,
                  Add("Both are kinds of ", Await(Call($sayOf, Index($kinds, Subtract(Length($kinds), 1)))))
                )
              ),
              Undefined()
            ),
            Bind($wants, List()),
            ForOf(
              $r,
              $rest,
              Sequence(
                If(
                  Or(Not(Call($isCall, $r)), NotEquals(Member($r, "head"), "IfYouWant")),
                  Continue(),
                  Undefined()
                ),
                Bind(List($option, $reasons), Call($positional, $r)),
                Bind($why, List()),
                ForOf(
                  $x,
                  If(
                    Call($isCall, $reasons),
                    Call(Member(Call($positional, $reasons), "slice"), 0, 2),
                    List()
                  ),
                  Sequence(
                    If(Not(Call($isCall, $x)), Continue(), Undefined()),
                    Bind(List($p, Spread($vs)), Call($positional, $x)),
                    Bind($WAY,
                      Object(
                        More = "a higher ",
                        Less = "a lower ",
                        Earlier = "an earlier ",
                        Later = "a later "
                      )
                    ),
                    If(
                      Index($WAY, Member($x, "head")),
                      Call(Member($why, "push"), Add(Index($WAY, Member($x, "head")), $p)),
                      Call(
                        Member($why, "push"),
                        Add(If(Equals(TypeOf($p), "string"), Add($p, " "), ""), Call(Member($vs, "join"), " or "))
                      )
                    )
                  )
                ),
                If(
                  Length($why),
                  Call(
                    Member($wants, "push"),
                    Add(
                      Add(Add("if you want ", Call(Member($why, "join"), " and ")), ", "),
                      Await(Call($sayOf, $option))
                    )
                  ),
                  Undefined()
                )
              )
            ),
            If(
              Length($wants),
              Call(Member($out, "push"), Call($sentence, Call(Member($wants, "join"), "; "))),
              Undefined()
            ),
            Bind($lean,
              Call(Member($rest, "find"), Lambda(List($r), And(Call($isCall, $r), Equals(Member($r, "head"), "Leans"))))
            ),
            If(
              $lean,
              Call(
                Member($out, "push"),
                Call(
                  $sentence,
                  Add(Await(Call($sayOf, Index(Call($positional, $lean), 0))), " is the better known of the two")
                )
              ),
              Undefined()
            ),
            Return(Or(Call(Member($out, "join"), " "), Call($sentence, Call(Member($names, "join"), " or "))))
          )
        )
      )
    )
  )
)

